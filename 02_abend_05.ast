astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_tnn_000001",ch="tnn"},
},
ja={
{
name={"Empleada"},
"“Gracias por venir.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",id=1,file="s-chime"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm024"},
{"text"},
text={
ja={
{
"Salgo de la farmacia. Pensé que los tendrían acá, pero...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que hay que ordenarlo... Bueh, es de esperarse. Sería más bien raro que\ntuvieran esas cosas en existencia todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Después de salir de la farmacia, camino por el centro comercial de Sakuragahara\nmientras jalo la bicicleta.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no tienen, supongo que tendré que darme por vencido.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_yum_000366",ch="yum"},
},
ja={
{
name={"???"},
"“¿Te darás por vencido?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_rna_000229",ch="rna"},
},
ja={
{
name={"???"},
"“¿Qué estabas buscando?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Estas voces...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes dos...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"¿Será que estas dos tenían actividades de club hoy también?",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Hikawa y Kawachino, vestidas ambas en uniforme, estaban paradas detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_rna_000230",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y bien? ¿Qué es lo que piensas dar por vencido? Según pudimos ver, saliste de\nla farmacia...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000367",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tratándose de senpai, seguro vino a comprar drogas.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué clase de senpai se supone que soy?! En primer lugar, en las farmacias no\nvenden drogas.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000368",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pensé que te habías dado por vencido al darte cuenta de que no vendían...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más idiota que sea alguien se daría cuenta antes de ir a comprar, ¿no? De\nque no hay forma de que en una farmacia vendan productos ilegales...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000369",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahora que lo dices, tienes razón. Realmente lo siento. Parece que te subestimé\ndemasiado, senpai. Pues, parece que así de bajo es tu intelecto.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué tanto me estás subestimando...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000370",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Algo que se pueda comprar en la farmacia, y que senpai podría pensar en\ncomprar... Ah, ya veo, así que compraste algo orientado a promover una alegre\nplanificación familiar, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué estás diciendo? ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000371",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Que qué? ¿Acaso viniste a comprar condones? ¿Eso fue lo que preguntaste?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No estaba preguntando de nuevo!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000372",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kusanagi-senpai, eres como un semental en calor, así que debes necesitarlo,\n¿no? Rina, no te le llegues a acercar. Además de embarazar\nviolará.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué además de dejarme embarazada me va a violar?... Se supone que es al\nrevés...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000373",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad? Pareciera que de solo tocar a senpai podría quedar embarazada.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que acaso sudo semen?!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=500},
{"se",file="se9010",vol=50,id=1},
{"fg",ch="里奈",size="z2",time=500,sync=1,mx=-40,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0100",face="b0011",head="rna_z2b",lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0012",head="rna_z2b",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000231",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Ehm... Creo que no hace falta realizar esta clase de conversaciones con esa\nvoz tan alta en este lugar tan concurrido... D-Dejando eso de lado, ¿qué era\nlo que estabas buscando?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Necesito material para una pintura.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0008",head="rna_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000232",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si necesitas material para una pintura, ¿entonces no deberías ir a la tienda de\ninstrumentos de pintura?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienen mucho de eso allá.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0001",head="rna_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000233",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No lo tienen en la tienda de instrumentos de pintura?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000374",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Químicos?...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Vaya que te diste cuenta.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000375",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, bueno, yo también suelo ordenar frecuentemente químicos en esa farmacia...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, ¿tú también compras material para pintura en esa farmacia? Eres toda una\nfanática acérrima.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000376",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? Yo no compro material de pintura en la farmacia. ¿Es que acaso se puede\ncomprar material de pintura en una farmacia?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Acaso no ordenas disolvente para pinturas de óleo de la farmacia? De los\nfuertes...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000377",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, lo que yo compro en la farmacia es etanol y metanol para combate, entre\notros químicos que no puedo mencionar con voz muy alta.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, entiendo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Y eso que le dije al principio que había ido a comprar 'material de pintura'.\nRealmente no está escuchando nada de lo que digo...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000234",ch="rna"},
},
ja={
{
name={"Rina"},
"“En fin, nosotras dos vamos a la tienda de instrumentos de pintura. ¿Quieres que\npreguntemos si tienen lo que necesitas, senpai?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Van a la tienda de instrumentos de pintura? Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, me da un poco de fastidio ir hasta allá... ¿Será que te puedo\npedir el favor?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000235",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, me parece que esa es la forma apropiada de usar a una hermanita.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"¿Eso crees? Las hermanitas reales de todo el mundo no son tan prácticas ni\nútiles.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"excall",file="02_abend_05a",cond="f.rinroute==1"},
{"excall",file="02_abend_05a",cond="f.makroute==1"},
{"excall",file="02_abend_05a",cond="f.shzroute==1"},
{"excall",file="02_abend_ze04",cond="f.rnaroute==1"},
{"text"},
linkback="block_00044",
},
label = {
top={block="block_00000",label=1},
},
}
