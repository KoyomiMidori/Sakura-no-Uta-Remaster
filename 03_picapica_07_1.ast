astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",id=1,lv=1,sync=1,path=":cg/"},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*lanza respiro*... vaya, vaya...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Me da la impresión de que la sed de sangre de las chicas que se quedan\nesperándome frente al portón principal después de clases todos los días va\nhaciéndose más fuerte con cada día que pasa.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Ser famoso trae sus pros y sus contras... Aunque me da la sensación de que\nmi fama no me ha traído ningún pro aún.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Al asegurarme de que no había rastro ya de alguna chica tras mí, me dirijo a\nQuimera.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Sería terrible que alguna me siguiera y terminara causándole problemas a los\nNatsume después... Aunque, no sería bueno tampoco causarle problemas a\nQuimera.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Cuando vivía solo solía venir de vez en cuando a Quimera a comer, pero\núltimamente ha pasado en convertirse por completo en mi lugar de descanso y\nrelajación.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",id=2,lv=2,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_chm_000001",ch="chm"},
},
ja={
{
name={"Hombre"},
"“Bien, vendré de nuevo entonces. Ah, esta es mi tarjeta.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002965",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se moleste. Por más que venga, no tengo intención alguna de venderlos.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"mwact",act="うんうん",time=200},
{"text"},
text={
vo={
{"vo",file="man_chm_000002",ch="chm"},
},
ja={
{
name={"Hombre"},
"“Vamos, vamos, puede ser que cambies de opinión en algún momento, ¿no? Me retiro\nentonces, disculpa la molestia.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"El hombre cuarentón que salió de Quimera le dio de manera forzada una tarjeta a\nToritani, ataviada de maid, y se fue.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"El hombre no mostró ni un poco de culpabilidad por su actitud, a pesar de la\nexpresión absolutamente amarga de Toritani.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"... ¿Es que acaso la está invitando a algún grupo religioso o algo por el\nestilo?... No, ciertamente Toritani mencionó algo de 'vender'.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002966",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Toritani se da cuenta de mi presencia. Levanto ligeramente mi mano para\nsaludarla.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Sería todo un lío que las mujeres de hace un rato llegaran a encontrarme, así\nque decidí, por los momentos, entrar a Quimera.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",file="se2225",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quería ese señor?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0015",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002967",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, es de alguna tienda de antigüedades. Vio las fotos del catálogo y me vino a\ndecir que quería los jarrones que quedan.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Los jarrones que quedan? Ahh, sí, dijiste que habías hecho 4, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002968",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Tomé la temática de 'La Luna y las Estrellas' de Mucha, así que son 4\njarrones.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Incluso aquellos sin mucho interés en las artes sabrían de qué se trata al ver\nlos jarrones.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Alfons Mucha, elogiado como el 'Maestro de la Belle Époque'. Su obra de 'La\nLuna y las Estrellas' está bastante unida al estilo Art Nouveau.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"'La Estrella de la Tarde', 'La Luna', 'La Estrella de la Mañana' y la 'Estrella\nPolar' conforman la temática de 'La Luna y las Estrellas', la cual fue la\núltima serie de paneles decorativos que Mucha creó.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mucha, eh...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002969",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijiste que te interesaba Lalique, Gallé, y... ¿habías dicho que Daum también?\n¿Te gusta bastante el Art Nouveau?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002970",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmmm, no tanto...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002971",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente me interesan, pero mis gustos se inclinan más por el trabajo con\ncosas de más volumen, más masivas...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002972",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las obras de esa época son algo fáciles de imitar. Bueno, en realidad no lo\nson, pero dan esa impresión de que quizás podrías lograrlo...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002973",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En la parte superior de cada uno de los jarrones dibujé la tenue imagen de una\nmujer y un patrón de flores en calado usando una técnica parecida al\n'Hotarude'. Lo hice, en parte, para ocultar de alguna forma el hecho de que\nhabía dejado dos capas en la parte inferior.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002974",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno, es solo una 'imitación' de la técnica. En realidad está bastante\nalejada de la verdadera... Por cierto, el verdadero Hotarude se aplica\noriginalmente a la porcelana, pero yo la empleé en arcilla.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera un momento, ¿qué es el Hotarude?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002975",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, siempre me has parecido que lo sabes todo en lo que al arte respecta, así\nque pensé que no hacía falta la explicación...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, conozco un poco, pero quisiera aprovechar la oportunidad para saber en\ndetalle qué es.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002976",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, entonces comenzaré de nuevo, ahora por la explicación. El 'Hotarude' es\nuna técnica en la cual, después de haberle aplicado el calado al material y\nhaber realizado el bizcochado, se rellenan los huecos del calado con esmalte\ncerámico transparente para luego darles la segunda cocción.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002977",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las partes caladas se vuelven semitransparentes, y al recibir luz brillan. De\nahí se hizo la analogía con las luciérnagas (Hotaru) y se le empezó a llamar\na la técnica Hotarude. O algo así fue.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002978",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay varias teorías respecto al origen de la técnica, aunque entre las obras\ncreadas en base a ella las piezas de porcelana de la época Ming son\nrelativamente famosas, supongo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002979",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por cierto, en Japón, durante la era Meiji, se crearon varias piezas\nelaboradas con un alto grado de detalle y que llegaron a ser presentadas en\n1893 en la Exposición Universal de Chicago, donde recibieron muy buenas\nopiniones.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002980",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bueno, la cuestión es que usé las cuatro estrellas de Mucha para aplicar ese\npatrón calado semitransparente.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002981",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quise reproducirlas de la manera más fiel posible a la obra verdadera, pero mi\nnivel de técnica no fue suficiente para que salieran bien, así que les\nagregué varios detalles y arreglos adicionales.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002982",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El jarrón que salió publicado con fotografía en el catálogo estaba basado en\n'La Luna'. En el caso de 'La Luna', puse la silueta de una mujer y las flores\nusadas en el marco en calado.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La tenue y brillante silueta de la mujer, y el truco del silbido del viento,\neh... No es de sorprenderse que se formaran rumores respecto a esa pieza, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002983",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... Pensé que quizás sería algo divertido que la gente se sorprendiera al\nverla. Pero, ahora que esa idea se llevó el precio de la obra a la\nestratosfera, las cosas son distintas.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, respecto al jarrón. Sé que te molestó bastante que te lo compraran\nde manera engañosa, pero si tanto te desagrada que esté en manos de otro,\n¿por qué no la compras de vuelta?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002984",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... Me encantaría comprarlo de vuelta, pero... Gracias a las historias\nque te dije que le achacaron a la obra, su precio alcanzó un valor que está\nun tanto fuera de mi alcance.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002985",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quieres ver?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",x2=0,x=345,lv=4,id=9},
{"text"},
delay={
[500]={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",x=345,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"Toritani abrió una computadora portátil que estaba en un rincón de la barra, y\nme muestra un sitio web de antigüedades.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002986",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya precio, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"A pesar de ser solo un precio de referencia, es realmente alto. Solo contar la\ncantidad de ceros de la cifra daba escalofríos.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las historias y los mitos siempre encantan a los demás. Pero...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Es difícil justificar este precio basándonos solo en historias y mitos.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Toritani dice que lo que hizo fue nada más una imitación, y que se trata de un\nfracaso como obra para ella, pero...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"La temática que eligió, la afinidad con la técnica del Hotarude y el grado de\nperfección mostrado. No se puede negar el encanto único que desprende esta\nobra.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=8,lv=8,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000019",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Makoto-san, me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002987",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro, buen trabajo hoy. Gracias por quedarte siempre hasta tan tarde.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_bit_000020",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“No hay de qué～ Bueno bueno, me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Al pasar las 10 de la noche, la muchacha de medio tiempo del turno de la noche\nse va.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy se marchó algo temprano, eh.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002988",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que irá con sus amigos al karaoke.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A esta hora?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002989",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Justamente por tratarse de esta hora es que va, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Dependiendo del día de la semana, hay veces que vienen clientes en la noche\ntambién, pero Quimera estaba en silencio hoy.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",mode=-2},
{"se",file="se2225",id=1},
{"text"},
text={
ja={
{
"... Y justo cuando pensaba eso, entró un cliente.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="霧乃",size="z1",mx=40,mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Es la clienta que suele venir frecuentemente.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002990",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienvenida, puede sentarse donde desee.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000015",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“G-Gracias.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",mode=-2},
{"se",file="se3214",id=1},
{"text"},
text={
ja={
{
"La clienta le sonríe a Toritani y toma un asiento. Le pongo un ojo encima,\nprocurando no parecer muy maleducado.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"... Sí, se parecen.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Toritani.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Me acerco a Toritani, quien estaba preparando café, y le hablo en voz baja por\nencima de la barra.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002991",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sabes cómo se llama esa mujer?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002992",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Su nombre? No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Toritani, ¿me das unos caramelos? Te los pagaré.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0009",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002993",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me importa, pero... No estarás tratando de meter las narices de nuevo en\nalgún otro asunto raro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy haciendo nada raro, ni tampoco malo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002994",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mientes. Se te está frunciendo el ceño.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Veo de reojo a la clienta mientras hablamos.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Ha estado desde hace un rato con la mirada echada hacia abajo y con sus manos\nposadas ligeramente sobre su pecho. A veces alza su cara, pero... su\nexpresión es adolorida.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0015",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0012",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002995",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Por Dios, no voy a cobrarte por unos simples caramelos. Espera un\nmomento, iré a llevarle el café antes.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani puso el café recién servido en la bandeja y se lo lleva a la clienta.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="table1",id=9,lv=9,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="chair1",id=1,lv=1,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="霧乃",size="z2",zoom=80,mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",x=-224,y=80,lv=5,id=9,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",zoom=80,mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0003",head="mak_z2d",x=345,y=-110,lv=5,id=6},
{"fgact",ch="真琴",act="うなづく",lv=5,id=6},
{"se",file="se_koton",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002996",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpe la espera.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0002",head="kir_z2a",x=-224,y=80,lv=5,id=9,zoom=80},
},
},
text={
vo={
{"vo",file="fem_krd_000016",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“G-Gracias...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"La clienta le sonríe a Toritani, pero su sonrisa es forzada y poco natural.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Toritani parece haberse dado cuenta de que la clienta no se veía bien, y la\nobserva con una mirada de cierta preocupación.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"... Hay una cara que se me viene a la mente cuando veo a esa mujer.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Quizás por lo muy diferentes que se ven sus expresiones es que a primera vista\nno se parecen... pero, realmente se asemejan.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Y se parece a...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",x=345,y=-110,lv=5,id=6,zoom=80},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002997",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Siéntase cómoda tanto como quiera y disfrute de su café, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=345,y=-110,lv=5,id=6,zoom=80},
{"text"},
text={
ja={
{
"Toritani le da esas palabras de consideración a la clienta y se da la vuelta.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bgm",stop=1,time=1000},
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x2=345,x=680,y=-110,lv=5,id=6,zoom=80},
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",x=-224,y=80,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="fem_krd_000017",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“¡E-Este, Toritani-san!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=680,y=-110,lv=5,id=6,zoom=80},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002998",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="霧乃",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",y2=80,x=-224,y=30,lv=5,id=9,zoom=80},
{"se",id=1,file="se3466"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"*gachaa*",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0007",head="kir_z2a",x=-224,y=30,lv=5,id=9,zoom=80},
{"fgact",ch="霧乃",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000018",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“¡¡---!!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0013",head="mak_z2d",x=680,y=-110,lv=5,id=6,zoom=80},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002999",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah--”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"La clienta, quien extendió su mano y trató de levantarse, pegó su mano con la\ntaza de café y la tumbó.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0006",head="kir_z2a",x=-224,y=30,lv=5,id=9,zoom=80},
{"fg",ch="霧乃",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0006",head="kir_z2a",y2=30,x=-224,y=-80,lv=5,id=9,zoom=80},
{"fgact",ch="霧乃",act="いいえ",lv=5,id=9},
{"se",file="se3214",id=1},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="fem_krd_000019",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Ah, ahhh... ¡Perdóname!...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",x=680,y=-110,lv=5,id=6,zoom=80},
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",x2=680,x=345,y=-110,lv=5,id=6,zoom=80},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0012",head="mak_z2d",x=345,y=-110,lv=5,id=6,zoom=80},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0910",face="d0012",head="mak_z2d",x=345,y=-110,lv=5,id=6,zoom=80},
},
},
text={
vo={
{"vo",file="fem_mkd_003000",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se preocupe. ¿No le cayó café encima? Kusanagi, disculpa el abuso, tráeme el\ntrapo que está allí――”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=-224,y=-80,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="fem_krd_000020",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“P-Perdóname... perdóname... Uhh...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",file="se9010",id=1},
{"fg",ch="霧乃",my=40,mode=-1,lv=5,id=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",x=345,y=-110,lv=5,id=6,zoom=80},
{"text"},
text={
ja={
{
"La clienta, quien se alejó de la silla tambaleándose, cae sentada con las\npiernas sobre el piso, cubriéndose la cara con las manos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-580,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003001",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Señora.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_krd_000021",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Perdóname... yo, siempre... realmente, soy...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Toritani se acerca silenciosamente a la clienta, y pone sus manos sobre sus\ntemblorosos hombros suavemente, para no exaltarla.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003002",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todo está bien... Vayamos a la barra, le prepararé otra bebida.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_krd_000022",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Pero yo... Toritani-san, yo... No tengo tanto valor como persona como para\nmerecer tu amabilidad...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003003",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Señora...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Tomo el trapo y me voy acercando a las dos. Limpio el café de la mesa, y reviso\nsi no cayó sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podría entender que esté fuera de casa a estas horas si fuera por trabajo, pero\nno por esto. ¿No está su hija esperándola sola en casa?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000023",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“C-Cómo...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_krd_000024",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“A-Ahh... sí, recuerdo que hablé un poco contigo antes... Sí, tengo una hija,\npero...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La ha visto trayendo caramelos a casa recientemente?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0007",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000025",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Eh, ¿por qué... sabes eso?...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una niña con problemas en la pierna, que requiere rehabilitación.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",lv=5,id=9},
{"fgact",ch="霧乃",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000026",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Eh, c-cómo.... Eh, ¿por... qué?...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003004",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Toritani se pone de brazos cruzados, retorciendo un poco su rostro. Esa\nexpresión dice 'Así que sí tenías las narices de lleno en algo raro'.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imaginé... Estuve sospechando que se trataba de eso.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"La clienta me observa con una cara de miedo, entrando en un ligero estado de\npánico ante mi comentario.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Usted es la madre de Nei Onda. Y...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",time=100,file="black",path=":bg/"},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",y=30,lv=4,id=9,sync=0},
{"extrans",time=300},
{"ex",time=300,func="wait"},
{"bg",time=200,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“También la madre de Kei.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="霧乃",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003005",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",lv=4,id=9},
{"fgact",ch="霧乃",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000027",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"La clienta estaba visiblemente conmocionada. Y a su lado, Toritani se pone de\npie, con una expresión estupefacta.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="霧乃",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003006",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿C-Cómo?...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Toritani me ve a mí y a la clienta, y prosigue sus palabras aun con una cara de\nasombro.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003007",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo... es que sabes... que esta mujer es la madre de Kei, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0007",head="kir_z1a",x=345,lv=4,id=9},
{"fgact",ch="霧乃",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000028",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“¡¡---!!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"La clienta observa a Toritani con una expresión de susto. Aunque en mi caso, no\nhubo ni susto, ni sorpresa.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000029",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“¿P-Por... qué... lo sabes?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿También te habías dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003008",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Era difícil no hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fgact",ch="霧乃",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_krd_000030",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“E-Esto, eh...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Con una expresión de haber perdido por completo los estribos, la clienta nos\nobserva a Toritani y a mí mutuamente. Se nota que no logra entender en lo\nabsoluto lo que sucede.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
ja={
{
"Después de asentir, Toritani lanza un largo suspiro.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003009",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, ¿será que hablamos en la barra?... Creo que esta charla va a extenderse\npor un buen rato, así que cerraré el local ya.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"se",file="se2225",id=1},
{"fg",ch="真琴",size="z1",time=500,mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Toritani cierra el local y vuelve a la barra. Mientras tanto, preparo café.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me tomé el atrevimiento de preparar el café mientras no estabas.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003010",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, no importa... además, huele bien.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000031",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"La clienta... No, ¿quizás debería llamarle madre de Nei? ¿O madre de Kei?",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Ella estaba ahora con una expresión empequeñecida, y a pesar de su ya pequeño\ncuerpo, se veía más pequeña aun sentada en la barra.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003011",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Podría comenzar por decirnos su nombre?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿no sabes su nombre?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003012",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No fue por haberla conocido hace tiempo que te diste cuenta que era la madre\nde Kei... o algo así?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003013",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, claro que no. Fue solo hace un tiempo que la vi por primera vez... Aquella\nvez que estaba repartiendo los folletos. Por eso yo también quisiera saber su\nnombre.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000032",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Kirino.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000033",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Me llamo Kirino Onda...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"La mujer dice su nombre, con una tenue y casi imperceptible voz.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Desde hace rato estuvo sosteniendo su delgado pecho con una desesperada\nexpresión, casi a punto de caer en llanto en cualquier momento.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003014",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Onda-san, cuéntanos, por favor. No importa si es poco lo que puedas decirnos.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000034",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Aún con la cabeza echada hacia abajo, Kirino-san comenzó a hablar poco a poco.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Kirino-san comenzó presentándose de nuevo, indicando que era la madre de Nei y\ntambién de Kei.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Cuando aún era solo una muchacha menor de veinte años, el ex-esposo de la\ndirectora y jefe actual de la familia Nakamura, Shoichi Nakamura, la violó. Y\nde esa relación dio a luz a Kei.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"La razón por la cual Kirino-san no conoció a Toritani es porque, después de dar\na luz a Kei, recibió una compensación en dinero para que se alejara de los\nNakamura, posteriormente marchándose de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003015",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, por eso es que nunca llegamos a cruzarnos.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000035",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí. Firmé un documento según el cual se me prohíbe acercarme a la familia\nNakamura. Realmente fue doloroso para mí separarme de Kei. Pero ahora...\npienso que quizás fue lo mejor.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000036",ch="krd"},
},
ja={
{
name={"Kirino"},
"“La compañía en la cual estuve trabajando como oficinista era una filial del\ngrupo Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_krd_000037",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Si me oponía en algo, me quitarían mi trabajo... Peor aun, no tendría manera de\nseguir viviendo de manera normal... Tenía miedo de que eso sucediera, y\nacepté todo lo que me decían, así que terminé dando a luz a Kei...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000038",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Amaba a Kei, por supuesto. Pero no sabía qué hacer. Estaba desesperada y\nperdida en medio de la nada, con un niño recién nacido en mis brazos...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0010",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000039",ch="krd"},
},
ja={
{
name={"Kirino"},
"“En ese momento, esa señora... La señora de Nakamura me ayudó bastante.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"La señora de Nakamura... Se refiere a la directora.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000040",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Habían muchas cosas duras y severas escritas en los documentos, y llegó a\nreferirse al dinero que me dieron como 'dinero de separación'. Pero también\nme ayudó a conseguir un nuevo lugar para vivir y un nuevo trabajo... No me\nbastan las palabras para agradecerle por lo que hizo por mí.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero entonces, ¿por qué volvió de nuevo a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000041",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Kirino-san bajó la cabeza, y agarró fuertemente su falda con sus dos manos.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000042",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Pasaron más de 10 años desde que me fui de Yumihari... Justo cuando creí que\npor fin había alcanzado algo de estabilidad en mi vida, sucedieron varias\ncosas y tuve que alejarme de allí también... Y sentí algo de nostalgia por mi\npueblo natal, así que volví...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_krd_000044",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Por supuesto, no quería causarle molestias a Kei ni a la señora. Y procuré no\nacercarme de ninguna manera a los dos.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000045_n",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Tengo ahora a Nei conmigo... No hemos tenido una vida fácil, pero quería\nesforzarme junto a ella y vivir lo mejor posible.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_krd_000046",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Y a pesar de eso...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Los labios de Kirino-san tiemblan, mientras una expresión dolorosa se cierne\nsobre su rostro.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y entonces Nei sufrió de esa herida, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
ja={
{
"Kirino-san asiente en silencio.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"La razón por la cual Nei sufrió de esa herida fue por una pelea entre niños. No\nsuena tan grave si lo ponemos solo como una 'pelea', pero en realidad fue un\ncaso de acoso, y del violento.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Como resultado, Nei sufrió de una herida tan severa que requiere ahora de\nrehabilitación. Para una madre soltera sin amigos o familiares a quienes\nrecurrir, fue un golpe emocional y económico bastante fuerte.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Aun así, existe la posibilidad que de asistir a rehabilitación, Nei vuelva a\ncaminar como antes. Kirino-san comenzó a trabajar desesperadamente, mucho más\nque antes.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Sin embargo, las cosas no terminaron ahí.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"La madre del niño que le causó la herida a Nei comenzó a amenazar a Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003016",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, ¿amenazar?... ¿Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0004",head="kir_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000047",ch="krd"},
},
ja={
{
name={"Kirino"},
"“El niño de la otra persona también sufrió de una herida... Una muy pequeña,\ncasi un rasguño, pero igualmente salió herido. Y ahora dice que es\nresponsabilidad mía...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Y no conformándose con enojarse con ella, la madre del niño que le causó la\nherida a Nei le exigió algo totalmente ilógico a Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"La amenazó y le demandó una enorme cantidad de dinero. Y por supuesto,\nKirino-san no tiene manera de pagar ese monto.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000048",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Me gritó mientras un montón de hombres me rodeaban, a pesar de que sabía que se\ntrataba de una amenaza. Tenía tanto miedo... No tengo familiares, ni tampoco\nnadie quien me pudiera ayudar... Al hablar con la policía, me dijeron que las\ncosas se pondrían peor, y...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Kirino-san se cubre la cara.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_krd_000049",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Realmente no sabía qué hacer...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003017",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kirino-san...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Kirino-san levanta la cara al escuchar la voz de Toritani, y sonríe sin fuerza\nalguna.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000050",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Fue entonces que te conocí, Toritani-san... Aquel día. En aquel momento que\ncontemplaba estupefacta la ciudad, tan cansada que ni siquiera la idea de\nacabar con mi vida se me cruzaba por la mente...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003018",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo recuerdo. Me dio la sensación de que algo realmente no estaba bien, y no\nfui capaz de hacerme la vista gorda.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0010",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000051",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Desde aquel entonces, este local y la taza de café que me sirven acá se han\nvuelto mi único sosiego. No podría estar más agradecida contigo... Eres la\nsegunda persona a la cual le debo la vida.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000052",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Y aun así... no... no puedo hacerlo. No puedo engañarte...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003019",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Engañarme? ¿A mí?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000053",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí... Fue algo que sucedió hace un tiempo...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"La mujer que amenazó a Kirino-san se presentó un cierto día ante ella, con un\nrostro altivo.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="麗華",size="z1",mode=3,resize=1,path=":fg/rei/z1/",file="rei_z1a0000",face="a0001",head="rei_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"――'Se me hizo conocido tu nombre por un momento, y parece que no me\nequivoqué'.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"La mujer averiguó que Kirino-san era la madre de Kei, y la obligó a robar las\npinturas de Kei que están en la casa de la familia Toritani.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"'Usa a Makoto Toritani'. Eso fue lo que dijo la mujer.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Di que eres la madre de Kei, que tienes una hija que requiere de\nrehabilitación, y que estás urgida de dinero. Haz que se compadezca de ti'.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Parece que tanto madre como hija Toritani no se llevan bien. De ser así, la\nhija no dudará en robar de su madre las pinturas de Kei, o de engañarla y\ntomarlas de alguna manera'.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Tengo a una excelente abogada de mi lado, no te preocupes'. Parece que eso fue\nlo que dijo.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003020",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pero qué locura...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Toritani susurró eso con una cara más atónita que enfadada.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pero tampoco hay razón para que Kirino-san mienta acá. Muy seguramente sí\nle dijeron eso.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Fue en ese momento que Kirino-san supo, por primera vez, que la jovencita que\nle había brindado la taza de café era Makoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003021",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000054",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Realmente lo siento... De verdad, siempre estoy causándole molestias a todas\nustedes...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003022",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah... claro. La persona que administra los cuadros de Kei en la casa Toritani\nes mi madre... Saki Toritani. Supongo que la persona que te amenazó también\nte contó eso...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000055",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí. Me contó que mientras estuve fuera de la ciudad, la señora hizo algo\nbastante descabellado y el señor Nakamura se divorció de ella.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003023",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Se divorció de ella?... No tengo razón alguna para ponerme de lado de esa\nmujer, pero ¿acaso no fue ella la que pidió el divorcio?...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fgact",ch="霧乃",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000056",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Ah, tienes razón. Disculpa la falta de respeto... Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0012",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003024",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, no, no tienes por qué disculparte, por favor. Ehmm... Kirino-san, ya\nentendí en buena parte la situación en la cual estás metida.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000057",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_krd_000058",ch="krd"},
},
ja={
{
name={"Kirino"},
"“E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003025",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Hay algún otro problema?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_krd_000059",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Ah, no, no es eso, solo que... hay algo que me causa un poco de curiosidad.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003026",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_krd_000060",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Esto... ¿Cómo es que los dos se enteraron que yo era la madre de Kei?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003027",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, sí... A mí también me pareció curioso eso. Kusanagi, ¿cómo es que\ndescubriste que Kirino-san era la madre de Kei?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... En primer lugar, me he encontrado ya varias veces con Nei, la hija de\nKirino-san, y esta se parece un poco a Kei cuando era pequeño...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las expresiones de Kei y Kirino-san son tan diferentes que al principio no me\ndi cuenta. Fue luego de verla con más frecuencia que me pareció que Kirino-san\nse parecía más a Kei que a Nei...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue imposible discernirlos únicamente por la cara, pero cosas como la línea de\nsus hombros... la forma de sus orejas, y creo que también los dedos se\nparecían un poco, así que bueno... Menos mal que Kei salió parecido a su\nmadre.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fgact",ch="霧乃",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000061",ch="krd"},
},
ja={
{
name={"Kirino"},
"“J-Jaa...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003028",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Bueno, supongo que en mi caso también fue algo parecido.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo eso?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003029",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... pues sí.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_krd_000062",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Ya veo... Realmente son asombrosos los dos...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003030",ch="mkd"},
},
ja={
{
name={"Makoto y Naoya"},
"“No tanto.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Oh, parece que dijimos lo mismo al unísono. Toritani se quedó en silencio, con\nuna cara un tanto apenada.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="霧乃",mode=-1,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",x2=-345,x=0,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto te desagrada decir lo mismo que yo en el mismo preciso instante?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0011",head="mak_z1b",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003031",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es que me desagrade, pero es vergonzoso, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que se te hace vergonzoso...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0910",face="d0007",head="mak_z1d",x=0,lv=4,id=5},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003032",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No hace falta que repitas justo esa parte!... Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003033",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, ya entendí lo que sucede. Vengan ustedes dos, vamos a salir.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿yo también?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003034",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No vienes?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Iré.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_krd_000063",ch="krd"},
},
ja={
{
name={"Kirino"},
"“E-Esto... ¿A dónde vamos?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0027",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_003035",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A dónde, eh... Tú sí sabes, ¿no es así, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A donde la directora.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_07_2"},
{"text"},
linkback="block_00246",
},
label = {
top={block="block_00000",label=1},
},
}
