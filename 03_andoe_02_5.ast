astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_com_f02_05",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="man_kid_000654",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ehhh, lo dices en serio? ¿El viejo Nakamura fue a donde los Natsume con un\nguardaespaldas~?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mi padre reaccionó a los sucesos de hoy sin ninguna muestra de preocupación en\nsu rostro.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así mismo. Aunque había dicho guardia, no guardaespaldas.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000655",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es lo mismo, es lo mismo. Era un tipo con un horrible traje negro, ¿no? Joder,\n¿es que no están conscientes de que los tiempos han cambiado? Aunque bueno,\nya no pueden hacer tanto desastre como antes.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000656",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y? ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El vejete me lanzó un golpe, pero no es nada. No podría decir lo mismo si\nhubiese sido el hombre de negro.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000179",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eh? Naoya, ¿te golpearon?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo un poco, un roce. Aunque sí pude darle una buena patada, así que\nquedamos a mano.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000657",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Oye, oye, quizás no sean tan peligrosos como antes, pero evita pelear con los\nguardaespaldas.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Intentaré no meterme en nada así la próxima vez.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, eso no importa. Quiero que me expliques ya la relación que hay entre\nlos Nakamura, Kuzu y tú. Y cómo ha sucedido todo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000658",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mmmm, sí...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Mi padre observa a Kuzu.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Su expresión no cambió en absoluto.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_kid_000659",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A ver, ¿qué tanto era que sabías?...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo poco que sé es que tú y la abuela se metieron con la familia que llevaba el\ncontrol de esta zona desde hace un buen tiempo. Con los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000660",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo, sí. Me tardaría demasiado de contarlo todo, así que te explicaré nada\nmás lo importante. Aunque bueno, aun así resulta bastante larga la\nhistoria...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000661",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Al parecer la historia de los Nakamura se remonta a una gran familia feudal de\nhace un milenio. Además de ser los dueños de un largo feudo, tenían también\nfuertes conexiones con políticos y gente de la administración.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000662",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Son una familia con una ascendencia de personajes históricos. No es nada\nextraño que tengan hilos sobre la administración.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y eso duró hasta que terminó la guerra, según he escuchado.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000663",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, justo después de que terminó la guerra, alguien comenzó a dirigir el manejo\nde cargamentos del puerto Yumihari. Después de todo era una nueva época,\nhabía un torrente de cargamentos viniendo del extranjero.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_kid_000664",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los únicos dispuestos a meterse en esas labores tan fuertes después de la\nguerra no eran precisamente gente de buena calaña. Solo alguien con una\npersonalidad fuerte y audaz podría lograr organizar a toda esa masa.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000665",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y esa audaz y fuerte persona resultó ser una mujer.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000666",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kotoko Natsume. Es decir, mi abuela.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000667",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kotoko Natsume se hizo una fortuna manejando los cargamentos que pasaban por el\npuerto Yumihari. No estamos tan lejos de Tokio, y la inmensa cantidad de\ncargamentos del extranjero que llegaron la volvieron rica. Luego llegó a\nmeterse también en el negocio de los shows y eventos.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese no era trabajo de persona decente para esos tiempos. En pocas palabras, era\nuna yakuza.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kid_000668",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cuando era un niño, los Natsume eran una bandada de gente audaz y capaz de\ncualquier cosa.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000669",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero hubo un grupo de gente que no veía con buen ojo eso. Uno de ellos era\nShoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_kid_000670",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No podían pasar de alto a los Natsume, quienes les robaron el dominio de\nYumihari tras el caos de la guerra.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000671",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero los Nakamura eran, a fin de cuentas, una prestigiosa familia con raíces\nque llegaban a la era Kamakura. El trabajo sucio no era precisamente su\nespecialidad.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_kid_000672",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso intentaron apoderarse del mundo bajo de Yumihari, con el apoyo a sus\nespaldas de un enorme grupo de yakuzas de la región de Kanto.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000673",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero las cosas no salieron como lo esperaba. La familia Natsume no retrocedió\nni un solo paso, lo cual terminó desencadenando una guerra.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_kid_000674",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bueh, a final de cuentas una guerra de yakuzas.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_kid_000675",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ambos grupos terminaron perdiendo. No, bueno, en realidad la opinión más\npopular es que los Natsume, habiendo aguantado la presión de semejante\norganización, habrían sido los victoriosos. En fin, terminaron en un acuerdo\nde paz.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero el acuerdo de paz se rompió unos años después, y la guerra comenzó una vez\nmás.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y el detonante fue nada más ni nada menos que el nieto de Kotoko Natsume,\nKenichiro Kusanagi. Es decir, fuiste tú quien inició de nuevo esa guerra.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000676",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No puedo objetar nada si lo dices de esa manera. Pero no lo hice simplemente\npor querer hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mamá me contó muy bien eso. Sé que desataste la guerra para salvar a las\nmuchachas cautivas en la residencia Kootoba.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_kid_000677",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ehh, escucha, quien realmente llevó eso a una guerra fue la abuela Natsume. Yo\nsolo quería rescatar a Mizuna, quien vivía allí.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, está bien.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000678",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mizuna era una muchacha muy curiosa.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_kid_000679",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo era solo un profesor de tiempo parcial, ella era una alumna de Yumihari. En\nun caso normal no hubiésemos pasado de ser un simple profesor y alumna.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_kid_000680",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero desde el momento en que la conocí, sentí algo curioso en ella.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kid_000681",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sentí que sus ojos siempre veían algo a lo lejos...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000682",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Una vez le pregunté, ¿qué ves?, y me respondió que estaba pensando en la cena.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no estaba mintiendo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000683",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal vez decía la verdad. Pero Mizuna pasó toda su vida siempre ocultando muchos\nde sus sentimientos... Estoy seguro de que siempre tenía mucho en su cabeza.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000684",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿What is mind? No matter.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_kid_000685",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿What is matter? Never mind.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es la frase que repites todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000686",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿La frase que siempre repito? No, quien realmente originó esa frase fue Mizuna,\ncuando me preguntó eso. Yo solo repito lo que ella me dijo.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000687",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿What is mind? ¿Qué es la mente? No matter. Materia no es.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_kid_000688",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿What is matter? ¿Qué es la materia? Never mind. Jamás mente.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿What is mind? ¿Qué es la mente?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No matter. Eso no importa.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿What is matter? ¿Qué es la materia?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Never mind. Olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_kid_000689",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahora es que entiendo por qué estaba tan fascinada con ese juego de palabras en\ninglés.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_kid_000690",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero por más que sepa la razón, esas palabras nunca se despegaron de mi cabeza.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000691",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es por eso que al aceptar la muerte de Mizuna fue que finalmente pude pintar\nese cuadro...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cerezos recostados...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000692",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, creo que desvié el tema. No es momento aún para hablar de eso. En fin,\nmuchas cosas de Mizuna me llamaron la atención cuando la conocí, así que\nestuve siguiéndola por varios días.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo un acosador por definición, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000693",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que no te cansas de buscar comentarios irónicos, ehhh. Fue por lo que\nsucedió con Saki que me llamó la atención.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo que sucedió con Saki?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000694",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Olvida eso, lo de Saki es asunto mío. Fue en ese momento que me enteré de algo.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_kid_000695",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo que conocemos ahora como la residencia Natsume era justamente el lugar donde\nvivía Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="man_kid_000696",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa mansión la tenían los Nakamura para alojar a los hijos de sus amantes.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000697",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los Nakamura le llamaban 'Umoreginoya'. Respecto al nombre, es un viejo término\nque le daban a las casas donde vivían los hijos de las amantes de algún\nhombre.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que hubieses causado una guerra si solamente se tratara de eso.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000698",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Exactamente. En ese caso no habría hecho nada. -Cada familia tiene sus\ncircunstancias- hubiese pensado, y hubiera dejado las cosas hasta allí.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000699",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero no fue así. El Umoreginoya -o residencia Kootoba- no era solo eso.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000700",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los Nakamura han estado atados, desde hace un largo tiempo, a una cierta\nleyenda.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_kid_000701",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y gracias a esa leyenda es que han mantenido su estatus como familia de poder\ndurante todo un milenio. O eso creían ellos.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La leyenda de Hakuki. O también conocida como la leyenda de la sacerdotisa\ntragasueños.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000702",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa misma. La muchacha que tragaba sueños en la tan famosa leyenda de los\ncerezos milenarios. Esa es Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000703",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los Nakamura hicieron contacto por primera vez con una raza de sacerdotisas\nconocida como Housoushi durante la era Kamakura. Y a partir de ahí se\nmezclaron.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_kid_000704",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por eso es que aún corre la sangre de los Housoushi en la familia Nakamura. Y\nde vez en cuando nace de ahí otra Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_kid_000705",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tener una Hakuki hará prosperar a la familia. Esa idea los ha poseído por todo\nun milenio.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_kid_000706",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso es que los Nakamura temen que su sangre se diluya con la de otros y\nse pierda.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más que no lo quieran, la ley prohíbe el matrimonio desde el primer al\ntercer grado de consanguinidad.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000707",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y para eso, la Umoreginoya.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Usaban a sus amantes, para procrear nuevas amantes.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_kid_000708",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, toda una locura. Procrean muchachas de sus amantes, las impregnan, procrean\nnuevas amantes, y así. Las hacen practicar relaciones incestuosas para\nmantener la sangre de los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000709",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Están completamente desquiciados...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto esfuerzo por no diluir su sangre, ¿todo por Hakuki?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000710",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="man_kid_000711",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Están convencidos de que mientras la sangre de los Housoushi no se diluya, una\nnueva Hakuki nacerá cada ciertas generaciones.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongamos que Hakuki exista, ¿de qué manera podría hacer que una familia\nprospere? Se supone que Hakuki 'traga' los sueños de las personas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me cuesta creer que una familia pueda prosperar solo por poder tragar los\nsueños de las personas.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_kid_000712",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los sueños son fragmentos del subconsciente. Poder ver el subconsciente de las\npersonas es un poder increíble, ¿no te parece? Aunque bueno, lo de poder ver\nel futuro viendo los sueños de los demás es algo difícil de creer.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible ver el futuro?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000713",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Llegué a escuchar a Shoichi Nakamura hablando apasionadamente de eso hace\ntiempo, con la abuela Natsume. Aunque la abuela no le dio importancia\nalguna.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero crees que sea posible?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000714",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué voy a saber yo?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Cómo que no sabes? Esta muchacha, Kuzu, es una tragasueños, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000715",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ah? ¿Cómo es que sabes eso?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Basta pasar una noche con ella para saberlo. No come ni duerme.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000716",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuzu, ¿no estás comiendo?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000180",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“E-Eh, yo...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No ha comido nada.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000717",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Diablos, qué desobediente eres, muchacha.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000181",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000718",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No le des a tragar sueños. Trátala, en la medida de lo posible, como una\npersona normal.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo dije yo, pero no parece querer obedecer.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000719",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“... Tch.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_kid_000720",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Maldita sea, si tan solo hubiese hecho bien las cosas...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hubieses hecho todo bien, ¿Kuzu no hubiera tenido que seguir tragando sueños?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000721",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000182",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡E-Eso no es cierto!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000722",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuzu, has estado intentando preservar tu poder tragasueños para protegerme,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000183",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Protegerte?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_kid_000723",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal cual. Esta muchacha es Hakuki. La única que han tenido en todo un siglo. Y\nlo que más desean los Nakamura ahora.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo, ya veo lo que sucede.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que sé, la abuela Natsume y tú le arrebataron a los Nakamura esa\nresidencia y a sus ocupantes. Con el poder del dinero.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000724",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De solo escuchar eso, cualquiera pensaría que se trata de tráfico de humanos.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa sería la manera más simple de ponerlo. Pero era necesario para salvarlas.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lograron salvar a casi todas las muchachas de la Kootoba. Pero no pudieron\ncomprar a Kuzu, quien también era Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y con más razón, la única Hakuki que han tenido en un siglo. No conozco la\nextensión de su poder, pero de lo que dices, ella es lo que más desean ahora,\nsupongo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="man_kid_000725",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y te pidieron un monto de dinero mucho más grande al que pidieron por las otras\nmuchachas.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No en vano, se trata de Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun después de que mamá muriera, seguiste reuniendo dinero. Es ahora que por\nfin sé por qué.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Necesitabas muchísimo dinero para poder liberar a Kuzu. Considerando eso, todo\nconcuerda.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000726",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fuh, vaya que te pareces a ella... Qué perspicacia, eh. No creí que llegaras a\nenterarte de todo eso solo con dejarte a Kuzu un día.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me veas la cara de tonto, averiguar eso no era nada difícil.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000727",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si bien le dije a Kuzu que no se acercara a la casa de los Natsume, no pensé\nque irías tú en su lugar.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que si querías encubrir a Kuzu de algo, era muy probable que fuera\nalgo relacionado a esa casa.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000728",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jaa, qué complicado esto.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Kenichiro puso su mano en su frente.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo complicado?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_kid_000729",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ah? Soy tu padre, por si no lo recuerdas.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000730",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los Nakamura son una familia absolutamente terrorífica. No en vano yo también\nllegué a sufrir horrendas represalias de ellos.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_kid_000731",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cualquiera que se meta con los Nakamura tiene la posibilidad de no salir con\nvida.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo digo de una vez, si vas a venir con ese tipo de charlas, puedes parar ya.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="man_kid_000732",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Parar? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suponiendo que no hubieses podido salvarla y sufriera a manos de los Nakamura,\ny luego intentaras revelarme eso, ahí sí te hubiera golpeado.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000733",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No creo que pudieras. Ya estaría muerto para cuando te enteraras.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces te ganarías mi rencor.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pusiste en la espalda de tu hijo la carga de todo lo que no pudiste hacer tú.\nEso es lo que verdaderamente caracteriza a un Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería extraño pensar que lo hicieras, pero si estás dudando de lo que haces,\ndéjame decirte que estás bien equivocado.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, arrepentido de meterme en esto? ¿Es en serio? Kenichiro Kusanagi jamás\nintentaría dárselas del bueno y decir semejante estupidez, ni siquiera al borde de la\nmuerte.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000734",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kukukuh, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya pasaste tu tiempo útil. Ahora que delegaste tu tarea a tu hijo simplemente\nquédate tranquilo en cama y observa.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000735",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya firmeza con que dices eso, eh. Te lo advierto, pasé más de diez años en\nesto y aun así no pude resolver nada.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que te hayas tomado más de diez años y no hayas podido resolverlo no significa\nque tu hijo no pueda hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000736",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Es que piensas resolverlo todo tú?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Además, apenas acabo de entender la seriedad del asunto. Lo que menos\ntengo ahora es un plan.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000737",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está bien, dejaré esto en tus manos entonces.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, mi padre me dio una tarjeta.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay con esta tarjeta?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000738",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es un viejo conocido. Seguramente podrá ayudarte en algo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fundación Moore, curador, Marty Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“He escuchado este nombre antes. Marty Fridmann, el famoso curador. También he\nescuchado malos rumores de él.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_kid_000739",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y falsos no son. No es la clase de tipo que querrías de enemigo, pero sí de\naliado. Aunque solo se mueve por dinero.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por dinero?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000740",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Si se trata de algo donde pueda salir dinero, estoy seguro de que será\nun buen aliado.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dinero, eh. Ya veo, eso explica la infinidad de malos rumores.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000741",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Su buen ojo y el poder de su lengua no son mentira, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que su buen ojo y su persuasiva lengua tienen la aprobación del mismísimo\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000742",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal cual. Pero si te descuidas, te hará tropezar en el peor momento. Esa es la\nclase de hombre que Fridmann es.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tú lo dices, pues entonces... probablemente sea cierto.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_nur_000013",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Disculpen, ya casi es hora.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000743",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, ahora que recuerdo las visitas familiares pueden ser a cualquier hora, pero\nlas que no son hasta las cinco.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Kuzu, quien se había quedado callada hasta ahora, asintió.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000184",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me puedo regresar sola.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta, ya hablamos todo lo que debíamos hablar.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000744",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te encargo a Kuzu hoy también. Eres el único a quien puedo pedirle esto.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000745",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, otra cosa que olvidaba.\nSolo suponiendo...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_kid_000746",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si Kuzu llegara a ponerse en peligro al tragar tus sueños, dale agua.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En peligro? ¿De qué manera?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="man_kid_000747",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo sé. Aunque al parecer puede llegar a sufrir de ataques al tragar\npesadillas. En ese caso, dale agua y haz que escupa el sueño.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo, está bien.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000748",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El agua normal de chorro sirve para diluir esos sueños. No olvides ese detalle.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000185",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Si llega a pasar, eso yo misma beberé mi agua, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_kid_000749",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hazlo, por favor.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Procuraré no olvidarlo. Aunque bueno, quisiera evitar que eso ocurra en primer\nlugar.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_kid_000750",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero sí, soy yo quien está a cargo de cuidarla. Me encargaré de advertirle.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000751",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te la encargo.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000752",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Debo decirlo... para haber pasado tanto tiempo solo, vaya que te convertiste en\nun hombre fuerte.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000753",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Nada, solo que nunca pude actuar como un padre normal contigo...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entre lo que dijiste hace un rato y ahora, te estás contradiciendo.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000754",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Adaptarse a cualquier situación, ese es uno de mis principios.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Primera vez que escucho de ese principio tuyo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_kid_000755",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Porque es primera vez que lo menciono.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cómo te encanta tomarme el pelo.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no creas que me crié solo.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias a ti, a mamá y a los Natsume es que pude llegar a ser lo que soy ahora.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie es capaz de criarse por su cuenta...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_kid_000756",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Kenichiro lanzó una pequeña sonrisa.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"se",id=1,file="gatya"},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg066a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000186",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya, ¿de verdad está bien que hagas esto? Kenichiro dijo que podría ser\npeligroso.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hay alguien que ha pasado su vida haciendo cosas peligrosas, es ese viejo. No\nte preocupes, no soy tan descuidado como él.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000187",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eso espero...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000188",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero quiero que me prometas algo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000189",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“De que pase lo que pase, en caso de sentirte en peligro, huyas.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajaja... de todo lo que podías decir me dices eso.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000190",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué te da risa?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no creas que me estoy burlando de ti. Solo que recuerdo haber escuchado a\nmi madre diciéndole lo mismo al viejo.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000191",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Mizuna-san?...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Prométeme que pase lo que pase, si llegas a sentirte en peligro huirás,\nle dijo.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000192",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero Kenichiro no mantuvo su promesa.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que no.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000193",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Y tú, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Descuida. Soy más gallina que mi padre, no haré ninguna locura.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000194",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Espero, que así sea...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, ya está bien. Vayamos a casa.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000195",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"bgm",stop=1,time=1000},
{"se",file="se9012",vol=50,id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,time=500,id=1},
{"excall",file="03_andoe_02_6"},
{"text"},
linkback="block_00214",
},
label = {
top={block="block_00000",label=1},
},
}
