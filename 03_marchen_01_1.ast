astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c08_01",path=":ev/ev_eye_c08/",set="ev_eye_c08"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"eval",exp="g.start_mar=1"},
{"text"},
text={
ja={
{
"Hoy me vine sola al colegio.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Parece que Rina tenía algo pendiente por hacer, y se marchó temprano al\ncolegio. Pero...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_yum_002483",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué no llegará aún?...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Espero en el salón.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Pero todavía no escucho esa voz que tanto quiero escuchar. Solo ruido a mi\nalrededor.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_yum_002484",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué le habrá pasado?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",id=1,file="se_school_chime"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002485",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡¿?!",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Suena la campana.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Comienzan las clases.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Rina jamás llegaría tarde.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Al menos no sin razón alguna.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"¿Sin razón?",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_002486",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",id=1,file="se_sliding_door"},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"bgm",file="bgm106"},
{"text"},
text={
ja={
{
"Salgo disparada del salón.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"text"},
text={
ja={
{
"Me cruzo con el profesor en el pasillo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_kys_000001",ch="kys"},
},
ja={
{
name={"Profesor"},
"“E-Eh, Kawachino, ya voy a comenzar la clase.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_yum_002487",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Me regresaré a casa ya!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_kys_000002",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡¿A-A casa?! ¡E-Espera un momento!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"La voz del profesor se va alejando.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Corro.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"No sé dónde podría estar.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Pero tengo un mal presentimiento.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Uno muy, muy malo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Llego a la entrada, aún todavía en mis uwabaki. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000748",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_yum_002488",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaaa...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Me topé con Rina.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Corro a acercármele. Tengo la cara cubierta de lágrimas.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_yum_002489",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pero qué sucedió? ¿Por qué tienes el uniforme tan sucio? ¡Y tienes la cara\nroja también!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000749",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy bien, estoy bien. No me pasó nada realmente grave.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000750",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo que importa es esto. Toma...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Rina me da la mochila que cargaba en sus manos.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000751",ch="rna"},
},
ja={
{
name={"Rina"},
"“Logré que me la regresaran.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_yum_002490",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡E-Esas perras!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",mode=-2},
{"bg",x=-760,y=-480,speed=200,sync=0,file="zbg044a",path=":bg/",x2=-960,y2=-480,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="里奈",size="z2",speed=200,sync=0,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",x2=-200,x=0,lv=5,id=9},
{"se",file="se9010",vol=70,id=1},
{"quake"},
{"text"},
text={
ja={
{
"Apenas intenté salir corriendo Rina me tomó de la mano.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0006",head="rna_z2a",x=0,lv=5,id=9},
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000752",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no vas a ir. Hice un trato con ellas...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_yum_002491",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿U-Un trato?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000753",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fui a explicarles por qué mentiste.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000754",ch="rna"},
},
ja={
{
name={"Rina"},
"“Les expliqué que lo hiciste por mí, para que pudiera hablar con Kusanagi-\nsenpai como antes...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_yum_002492",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Fuiste a decirles eso? ¿A ese colegio de tontos e idiotas?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x=0,lv=5,id=9},
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000755",ch="rna"},
},
ja={
{
name={"Rina"},
"“No deberías llamarles así. Nos perdonaron en cuanto les expliqué con detalle\ntodo. Son buenas, razonables personas.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_yum_002493",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡P-Pero, tu mejilla está roja! ¡Y tienes el uniforme sucio!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0009",head="rna_z2d",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000756",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿esto? Si se ensució es porque soy una debilucha. Si hubieras estado en mi\nlugar probablemente solo hubieras terminado con la mejilla un poco sonrojada\ny ya.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002494",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué quieres decir?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000757",ch="rna"},
},
ja={
{
name={"Rina"},
"“La muchacha comprendió bien la situación, pero, me dijo que igual necesitaba\nuna compensación.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000758",ch="rna"},
},
ja={
{
name={"Rina"},
"“Al principio me pidió que la dejara pelear contigo una vez más. Y yo le\nexpliqué lo más delicadamente posible lo terrible que sería para ella hacer\neso...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_yum_002495",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Delicadamente? Seguramente la dejaste sin argumentos. Tú eres mucho más\ninteligente que todas ellas.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x=0,lv=5,id=9},
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000759",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no. Yo misma fui la causa de todo esto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000760",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y entendieron muy bien que si se trataba de cobrar compensación, era mejor\ngolpearme a mí. La culpable de todo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_yum_002496",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“T-Te... golpeó...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002497",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡V-Voy a matarla!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"se",file="se9004",id=1},
{"fg",mode=-2,sync=0},
{"bg",x=-560,y=-480,speed=300,file="zbg044a",path=":bg/",x2=-760,y2=-480,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",x=0,lv=5,id=9,sync=0},
{"extrans",time=0},
{"fg",ch="里奈",speed=300,mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",x2=0,x=200,lv=5,id=9},
{"ex",time=0,func="wait"},
{"se",stop=1,id=1,time=500},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0005",head="rna_z2a",x=200,lv=5,id=9},
{"fg",ch="里奈",speed=150,mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0005",head="rna_z2a",x2=200,x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",time=150,lv=5,id=9},
{"se",vol=70,id=2,file="se_hand_pan1"},
{"text"},
text={
ja={
{
"Rina vuelve a agarrarme del brazo.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000761",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡E-Espera, no es justo que te desquites con ella! ¡¡Fui yo quien le propuso\nhacer eso!!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002498",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pero aun así--!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000762",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quedó algo sorprendida. No podía creer que una muchacha como yo pudiera\nproponerle eso...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000763",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me elogió, me dijo que tenía agallas, y que eso le agradaba. Lo saldó todo con\nun solo golpe.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_yum_002499",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Rina! ¡No puedes hacer eso! ¡No puedes exponerte de esa forma solo por mí!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000764",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me entrometí demasiado?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002500",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es eso, pero aun así, ¡no puedo aguantar que hagas esas cosas!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_002501",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡La voy a matar! ¡No voy a perdonarle que te golpeara!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000765",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, ¿recuerdas que estuve un buen tiempo enfadada contigo?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_002502",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000766",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo recuerdas, ¿verdad? Que me enfadé por las cosas que le dijiste a\nKusanagi-senpai. Y de cómo te ganaste intencionalmente el odio de todas.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000767",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es muy desagradable cuando una de las personas que más quieres se expone al\npeligro por ti, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_002503",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso no...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000768",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No te parece entonces que es igual para ambas?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_yum_002504",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, en mi caso...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000769",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es lo mismo. Es exactamente lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017",head="rna_z2a",x="＠-200",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000770",ch="rna"},
},
ja={
{
name={"Rina"},
"“Además, fue de esa forma que ella y yo decidimos ajustar cuentas. ¿Piensas\narruinar eso ahora, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_yum_002505",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No es que quiera eso, solo que...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000771",ch="rna"},
},
ja={
{
name={"Rina"},
"“El uniforme se me ensució porque me desplomé al suelo de ese único golpe... La\nmuchacha se quedó algo pasmada al verme caer. Me dijo que me había golpeado\ncon la mitad de la fuerza que usó contigo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_yum_002506",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Eso era inevitable! ¡Rina, tú--!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0015",head="rna_z2a",x="＠-200",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000772",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no es excusa. Creo que debería ejercitarme un poco más, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_yum_002507",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, tu enfermedad...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000773",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, ya estoy curada. Creo. El doctor me dijo que estaba en buenas condiciones.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_yum_002508",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es bueno que el doctor te haya dicho eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=200,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000774",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Es algo bueno.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",x="＠-200",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000775",ch="rna"},
},
ja={
{
name={"Rina"},
"“En fin, eso no importa. Yuumi, ¿no quieres saltarte la clase?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_002509",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Saltarnos la clase?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",x="＠-200",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000776",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Vamos, no está mal hacerlo de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_002510",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No tengo problema alguno, para nada...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="あくび",lv=4,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000777",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ng, ngh~ Ya se siente como otoño~”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_yum_002511",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Parece que este año no se extendió mucho el calor...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0016",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000778",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ah, Yuumi-san, ¿me permite un momento?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_yum_002512",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mm? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="zev_com_e01_01",x=-530,y=460,path=":ev/ev_com_e01/",set="ev_com_e01",ax=1920,ay=1080,bx=-960,by=-540},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002513",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uhh.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"¡¿P-Pero qué es esto?!",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Alguna... ¿alguna vez me ha pasado esto antes?",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"¡Ella, ella está, sobre mis, sobre mis piernas!",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_e01_01",path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000779",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah~, se siente realmente bien acostarse sobre tus piernas, Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_002514",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿E-En serio? Me alegro...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rna_000780",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm~? ¿Por qué apartas la vista?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_002515",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No la estoy apartando.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rna_000781",ch="rna"},
},
ja={
{
name={"Rina"},
"“La estás apartando.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_yum_002516",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Mi mirada se cruza con la de Rina.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002517",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"No puedo con esto.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rna_000782",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y otra vez la apartas.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_yum_002518",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_000783",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa. Tengo que admitirlo, me dio bastante miedo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_yum_002519",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Te refieres a cuando fuiste al colegio de idiotas?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rna_000784",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya te lo dije hace un rato, no las llames así.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_000785",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero sí, me estaba muriendo del miedo. No suelo verme en ese tipo de\nsituaciones.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_yum_002520",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Obviamente no. Rina, no debes meterte en esa clase de asuntos peligrosos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_rna_000786",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero has llegado a vivir situaciones más terribles, ¿no es así, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_yum_002521",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-En mi caso no hay problema... Desde hace tiempo estoy acostumbrada a eso...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rna_000787",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no cambia el hecho de que sean situaciones de miedo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_000788",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me contaron acerca de la pelea que tuvieron. De cómo te enfrentaste sola contra\nvarias. Me quedé anonadada.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rna_000789",ch="rna"},
},
ja={
{
name={"Rina"},
"“Volví a entrar en cuenta de lo fuerte que eres. Aun sin tu manada al lado.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_002522",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Manada?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rna_000790",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, manada. La imagen que tengo de ti es la de la líder de una manada cazadora.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_002523",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, hablas de cuando éramos niñas...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rna_000791",ch="rna"},
},
ja={
{
name={"Rina"},
"“Todavía tengo impresa esa imagen de ti. Pero aun estando sola eres fuerte.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_002524",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es que lo sea, realmente...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_000792",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues si no lo eres entonces no te metas en asuntos tan peligrosos. Te prohíbo\nque vuelvas a hacerlo, ¿te queda claro?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_yum_002525",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rna_000793",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muy bien. Buena niña, buena niña.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_e01_02",sync=0,face=1,time=400,path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
ja={
{
"Rina acaricia mis mejillas.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_002526",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_rna_000794",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tus mejillas se sienten muy bien. Son suavecitas...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Todavía con sus manos en mis mejillas, Rina acercó su cara a la mía.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_002527",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rna_000795",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_002528",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Estás acercando mucho tu cara...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rna_000796",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Para verte bien...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Su cara está a pocos centímetros de distancia.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Creo que jamás había estado en una situación así.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_e01_03",sync=0,face=1,time=400,path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002529",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_e01_03",sync=0,face=1,time=400,path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000797",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm? ¿Por qué cierras los ojos?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002530",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*agita la cabeza a los lados*",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Muevo la cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rna_000798",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué estás tratando de decirme?...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_yum_002531",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No puedo... contenerme, después de verte así.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rna_000799",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No puedes contenerte?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_002532",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_rna_000800",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es en serio, Yuumi? ¿Es que alguna vez has tenido que contenerte conmigo?...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_002533",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, es que...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_e01_02",sync=0,face=1,time=400,path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
ja={
{
"Abro los ojos.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Y frente a mí estaba la sonrisa de Rina.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Ahh, no puedo más...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"No puedo aguantarlo...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_002534",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina... perdóname.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rna_000801",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_002535",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No puedo más... N-No puedo contenerme...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_000802",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Vas a decirme ya qué es lo que no puedes contener?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_002536",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Puedo... ¿Puedo, besarte?... Solo, solo será una vez, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_002537",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo una vez. Y dejaré de insistir de una buena vez después de esto...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rna_000803",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Cierro los ojos.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Mis latidos sonaban muy fuerte.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Me acerqué lentamente, y la besé.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"'Conque así se sienten los labios de otra persona', pensé.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002538",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rna_000804",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bg",file="ev_com_e01_04",path=":ev/ev_com_e01/",set="ev_com_e01"},
{"bgm",file="bgm033"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002539",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_rna_000805",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué lloras?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_002540",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No sé.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rna_000806",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No lo sabes?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_yum_002541",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no lo sé. Pero no puedo dejar de llorar.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rna_000807",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_yum_002542",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿seguirás siendo mi amiga mañana cuando te vea?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rna_000808",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tu amiga?... No lo sé...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_002543",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me lo supuse. Nadie en su sano juicio le pediría un beso a su propia amiga.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_rna_000809",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pero qué andas diciendo?... ¿Se te ha olvidado la cantidad de vulgaridades que\nhasta el día de hoy me has pedido día tras día?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_002544",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, las recuerdo bien. Pero, siempre han sido cosas absurdas... que terminan\npor pasar en broma...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_yum_002545",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y besar a alguien mientras lloras, no es ninguna broma... así que...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rna_000810",ch="rna"},
},
ja={
{
name={"Rina"},
"“Claro. Sí, tal vez no sea muy bueno eso de besar mientras lloras...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_yum_002546",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... está mal.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rna_000811",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Puedo darte una orden, entonces?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_yum_002547",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Una orden?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rna_000812",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Te daré una orden.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rna_000813",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi Kawachino, te ordeno lo siguiente.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_yum_002548",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rna_000814",ch="rna"},
},
ja={
{
name={"Rina"},
"“No llores.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rna_000815",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sonríe. Y bésame.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_002549",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rna_000816",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No puedes hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_002550",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? D-De que puedo, puedo. Pero...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_002551",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pue, do?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rna_000817",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es una orden. No es cuestión de que puedas o no.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_002552",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Puedo... besarte de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_000818",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Pero solo si sonríes. De lo contrario, no seré más tu amiga.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_002553",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso no me gustaría.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rna_000819",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sonríe entonces.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_002554",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rna_000820",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien. Bésame ahora, lenta y cariñosamente.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_yum_002555",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Junto una vez más mis labios con los de Rina.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"La beso, con una sonrisa en la cara.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Y a pesar de eso, las lágrimas no paran de correr por mi mejilla.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Por más esfuerzo que ponga para sonreír, no puedo pararlas.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bg",file="ev_com_e01_04",path=":ev/ev_com_e01/",set="ev_com_e01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000821",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estás llorando.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_yum_002556",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo siento, Rina, perdóname...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rna_000822",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedo hacer más nada. Lo prometido es deuda...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z2",my=40,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2c0100",face="c0001",head="rna_z2c",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rina se pone de pie.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_yum_002557",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Espera, Rina!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rna_000823",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_yum_002558",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad... dejarás de ser mi amiga?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000824",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_yum_002559",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, por favor.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_002560",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sé, que tengo muchos defectos... pero, pero seré una buena chica.\nCumpliré con todo lo que me pidas.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_yum_002561",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dejaré de decir cosas tontas.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_002562",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y tampoco diré más chistes vulgares...\nTe lo ruego, déjame seguir a tu lado.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000825",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm, sí...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Rina se da la vuelta.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0002",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000826",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puedes quedarte por siempre a mi lado.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_002563",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0016",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000827",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ser amigas no tiene que ser la única razón para estar juntas. Aunque seamos\nchicas las dos.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_002564",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿E-Eso significa que--?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000828",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi~, sonríe.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0003",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000829",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa que tengas que forzar la sonrisa, pero hazlo.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_yum_002565",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh, ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000830",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muy bien. Te ves linda cuando sonríes, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000831",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nadie sabe eso.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000832",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo yo, probablemente.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Tras decir eso, Rina me abrazó.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000833",ch="rna"},
},
ja={
{
name={"Rina"},
"“El señor lobo creyó haberse devorado por completo a la niña... y sin embargo,\nfue el señor lobo quien estaba siendo devorado por su veneno.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000834",ch="rna"},
},
ja={
{
name={"Rina"},
"“El señor lobo dejó de moverse y respirar... Y entonces, de su cuerpo nació otra\nseta.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000835",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una frágil muchacha.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000836",ch="rna"},
},
ja={
{
name={"Rina"},
"“La seta recién nacida era una tierna y linda muchacha, vestida con una piel de\nlobo.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000837",ch="rna"},
},
ja={
{
name={"Rina"},
"“La amanita convirtió al señor lobo en una simple y frágil muchacha, que de lobo\nsolo tenía la piel que llevaba encima, cuentan...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_yum_002566",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué... es eso?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000838",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es un relato de hace mucho, mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0016",head="rna_z2d",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000839",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, ¿nos vamos a clases ya?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_yum_002567",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Fue un rato bastante misterioso.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Desde ese día, Rina ha estado sentándose en el puesto frente a mí en el salón,\nasí como siempre lo hace.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Y eso se me hace bastante raro.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"¿En qué estará pensando?",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Estando detrás de ella no puedo examinar la expresión en su cara.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Me daba miedo eso. Pero también me mataba de ternura.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"¿Amanita? ¿Una seta venenosa? ¿A qué se referirá con eso?...",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"¿Y que hay con de lo del señor lobo?...",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"¿Caperucita Roja?",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"No puede ser. En el cuento no hay ninguna seta venenosa.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_yum_002568",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Venenosa...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rna_000840",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Venenosa...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_yum_002569",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Rina respondió vagamente a mi comentario, sin voltear.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_marchen_01_2"},
{"text"},
linkback="block_00239",
},
label = {
top={block="block_00000",label=1},
},
}
