astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003b",path=":bg/",sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=-345,lv=4,id=5,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="man_ked_000349",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero Aneki, el mismo Naoya dijo que no hacía falta lucirnos tanto con una\nfiesta de bienvenida o algo así...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0018",head="aix_z1h",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000185",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota, hoy es el día en que nuestra familia recibirá a un nuevo integrante.\n¿Acaso no es obvio que es buena idea hacer una fiesta de bienvenida para que\ntodos en la familia estén conscientes de eso?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000350",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero eso de comida casera...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0018",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000186",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No entiendes nada! ¡Son en estos momentos especiales donde la comida casera\nhecha con el corazón debe adornar la mesa!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, no sé cómo reaccionar a esas palabras tan típicas de un primer día de\ncasados.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000187",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡K-Kusanagi! ¡N-No digas eso de primer día de casados! ¡A-Además, también está\neso! ¡La comida de la familia Natsume está compuesta en un 50 % de cariño y\ncompasión!”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Un 50 % de cariño...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"¿Será que el 50 % restante está hecho de ese 530000 % que Kei mencionó?...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000351",ch="ked"},
},
ja={
{
name={"Kei"},
"“Está bien, entiendo. Pero si vamos a ser nosotros los que vamos a auspiciar la\nreunión de bienvenida, entonces Naoya no podrá hacer nada, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000188",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué Naoya debería tener que hacer algo?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000352",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esto... ehm. Eso, sí, eso.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",mode=-2,sync=0},
{"bg",y=120,x=-570,zoom=80,file="zbg003b",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0012",head="kei_z2a",lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Kei me pide ayuda con los ojos. Es su expresión de que ya no puede más.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Este idiota ya no puede persuadir más a su hermana. Debe tener la cabeza vuelta\nun pudín.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",mode=-2,sync=0},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"bg",file="bg003b",path=":bg/",sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, ¿podrías dejarme preparar la comida hoy?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0013",head="aix_z1h",lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000189",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues de ahora en adelante seré su huésped, así que quisiera preparar la\ncomida...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0008",head="aix_z1h",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000190",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no, no. Hoy eres el invitado principal. Y además, en principio todo fue por\nculpa de Kei.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí, pero... no está de más que lo haga de vez en cuando, ¿no? No está mal\nque pruebes la comida de tu alumno.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uno de tus alumnos quiere preparar comida para ti, no está de más que lo\nescuches, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000191",ch="aid"},
},
ja={
{
name={"Ai"},
"“U-Umu... Si me dices eso... es difícil decir que no...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, de igual forma ya terminé casi todos los preparativos de la comida. Lo\núnico que falta es cocinarla.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000192",ch="aid"},
},
ja={
{
name={"Ai"},
"Espera, ¿en qué momento?",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Usé la cocina un momento mientras estabas afuera. A diferencia de mi casa,\nhabía un gran surtido de ingredientes, así que me divertí bastante.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000193",ch="aid"},
},
ja={
{
name={"Ai"},
"“Umu, si ya terminaste los preparativos entonces no puedo reclamar nada.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso mismo, permíteme preparar la comida hoy, por favor.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x2=0,x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000353",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí! ¡A mí también me parece buena idea eso! ¡La comida de Naoya es la más\nmasculina que hay!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000194",ch="aid"},
},
ja={
{
name={"Ai"},
"“Muh, siento algo estratégico y conspirativo detrás de todo esto, pero... bueno,\nestá bien, supongo que hoy aceptaré tu gesto de amabilidad, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acéptala, por favor...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",id=1,file="se2308"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000002",ch="szd"},
},
ja={
{
name={"???"},
"“... Ya llegué.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Una voz suena de la entrada, anunciando su regreso a casa. No era una voz muy\nfuerte, pero era bastante clara.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000354",ch="ked"},
},
ja={
{
name={"Kei"},
"“Oh, regresó en muy buen momento, casi como en una novela familiar.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000195",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, vamos a presentártela... Shizuku, ¿podrías venir un momento a la\ncocina?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Ai-sensei alza la voz y lanza un llamado, con el mismo tono que usaría para\nllamar a un alumno a la sala de profesores.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",id=1,file="se0836"},
{"text"},
text={
ja={
{
"Y como respondiendo a esa voz, se puede escuchar el sonido de las pantuflas\ndando pasos.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Y entonces, el sonido de los pasos se detuvo justamente en la entrada de la\nsala.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_ked_000355",ch="ked"},
},
ja={
{
name={"Kei"},
"“Este es Naoya Kusanagi. Es mi mejor amigo, y en el futuro será mi rival en la\nlucha por la conquista de las dos mitades de la tierra.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Dios santo, quisiera que no me presentaras con la cabeza aún llena de\nfantasías. Y mientras pensaba eso, volteé mi cara para ver a la segunda hija\nde la familia Natsume.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bgm",stop=1,time=0},
{"se",id=1,file="se2340"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a07_02",path=":ev/ev_com_a07/",set="ev_com_a07",sync=0},
{"extrans",rule=179,time=200},
{"ex",time=200,func="wait"},
{"bg",rule=179,time=200,file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003b",path=":bg/",sync=0},
{"extrans",time=1000,sync=1},
{"bgm",file="bgm038"},
{"fg",ch="雫",size="z1",time=700,sync=1,mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, esto, ¡sí! Ehh...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"user",mode="conf",ch="雫"},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000005",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mucho gusto, me llamo Shizuku Natsume.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_szd_000006",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"¿Quién eres tú?",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Una frase muy naturalmente usada al momento de conocer a alguien por primera\nvez.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y-Yo? P-Pues, sí. Sí, mi nombre es Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bgm",stop=1,time=500},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0210",face="a0013",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_szd_000007",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿T-Tú?! ¡¿Tú eres Naoya Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ahh, sí...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0200",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000008",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes dos, ¿de verdad le explicaron bien todo?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_ked_000356",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esto... Vamos, Shizuku... Es Naoya Kusanagi, ya te había hablado varias veces\nde él, ¿no? A partir de hoy comenzará a vivir acá.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0200",face="a0012",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000009",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Desde hoy?!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu hermanita parece estar completamente sorprendida. ¿De verdad le contaste que\nyo comenzaría a vivir acá?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000196",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu, escucha, Shizuku, tus bromas son bastante difíciles de entender, así que\nno es buena idea que se las hagas a desconocidos.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",mode=-1,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000010",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, disculpa, solo fue una broma...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000357",ch="ked"},
},
ja={
{
name={"Kei"},
"“A-Ajajaja... Shizuku es una hermanita así de jocosa.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"¿Jocosa?... ¿De qué diccionario sacaste esa palabra?...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿ya sabías que yo vendría acá?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000011b",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto, lo sé. Por eso sé un poco de ti, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un poco, eh... Pues, sí, supongo que es obvio.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0200",face="b0001",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000012_n",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya Kusanagi... Estatura, 181 centímetros, peso, 69 kilos... Tercer año en el\ncolegio Yumihari... Literatura moderna, 75 puntos, literatura antigua, 50\npuntos, inglés, 80 puntos...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qu--?! ¡¿Cómo es que sabes eso?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0200",face="b0003",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000013",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, lo siento, solo fue una broma...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me refiero a la broma! ¡Me refiero al hecho de que acertaste en todo!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000358",ch="ked"},
},
ja={
{
name={"Kei"},
"“A-Ajajaja... ¿Ves? Shizuku es una hermanita bastante jocosa. ¿Qué tal? Es\nhermosa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Realmente todas ustedes, las tres hermanas, son hermosas, eh...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000359",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya... Si sigues con esos comentarios tan crueles, terminaré llorando en\ncualquier momento.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x2=-345,x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000015",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Una vez más, es un placer conocerte, soy Shizuku Natsume. Siempre escucho tus\nhistorias de mis hermanos.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, igualmente, me llamo Naoya Kusanagi. A partir de hoy comenzaré a vivir en\nesta casa. Ehm, tu nombre... ¿Debería llamarte Shizuku-san?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000016",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me puedes llamar Shizuku. Siéntete como en tu propia casa.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, más que sentirme en casa, de ahora en adelante viviré acá, así que...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"se",file="se3130",id=1},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0200",face="a0013",head="shz_z2a",x=0,lv=5,id=5},
{"fgact",ch="雫",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000017",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿De ahora en adelante?!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Otra broma más?...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0200",face="a0001",head="shz_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000018",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0200",face="a0002",head="shz_z2a",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000019",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Creo que después de tantas bromas ya pudimos romper bastante el hielo. Espero\nque podamos llevarnos muy bien de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, igualmente.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"Después de hacer una ligera reverencia, Shizuku trató de salir de la sala sin\nhacer sonar sus pasos.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"msgoff"},
{"fg",ch="雫",size="z1",sync=1,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x=0,lv=4,id=9},
{"fg",ch="雫",speed=1000,mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x2=0,x=570,lv=4,id=9},
{"fg",ch="藍",size="z1",mx=-40,mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000197",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ahh, Shizuku, espera un minuto. Hoy vamos a hacer una fiesta de bienvenida para\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"se",file="se9010",id=1},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x2=570,x=345,lv=4,id=9},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0001",head="shz_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000020",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hay algo en lo que deba ayudar?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="藍",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="いいえ",lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000360",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No, no hay! ¡No hace falta que lo hagas! ¡Parece que Naoya quiere hacerlo todo\nél solo!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_szd_000021",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kusanagi-san, ¿eres bueno cocinando?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sé cocinar un poco.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000361",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eso no es cierto. ¡Naoya es un maestro, solo basta con que mueva el cuchillo\npara que la ciudad se alborote!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Eso se escucha con un sentido totalmente distinto...",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Shizuku. No hace falta que tú tampoco me llames por 'san'.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000022",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Si eso dices, entonces cambiaré de nuevo a Naoya.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así está bien.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, yo me encargaré de todo hoy, así que baja cuando termine de cocinar,\nShizuku.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0003",head="shz_z1a",x=345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0200",face="a0002",head="shz_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000023",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien. Avísame cuando termines de cocinar, por favor. Tengo muchas ganas de\nprobar tu comida.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro. Voy a darte de comer algo bastante bueno.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0200",face="b0017",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000024",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jii~”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2d0200",face="d0003",head="shz_z2d",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2d0200",face="d0004",head="shz_z2d",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000025",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, no puedo esperar a comer tu comida. Da todo lo súper duper mejor de ti.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, yo me encargo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",ch="雫",size="z2",time=400,mode=3,path=":fg/shz/z2/",file="shz_z2a0200",face="a0002",head="shz_z2a",lv=5,id=9},
{"se",file="se9002",vol=30,id=1},
{"ex",time=300,func="wait"},
{"fg",ch="雫",time=500,sync=1,mx=40,mode=-1,lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Después de decir eso, Shizuku salió de la sala caminando con bastante gracia.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=0,lv=4,id=9},
{"bgm",file="bgm017"},
{"text"},
text={
vo={
{"vo",file="man_ked_000362",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pareciera que estuvieras acostumbrado a tratar a Shizuku, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Es la primera vez que la veo.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000363",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De veras? Yo me quedé bastante desconcertado con la reacción de Shizuku al\nprincipio. Comparado conmigo, te adaptas bien rápido.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tratar con una bestia rara como tú me ha dotado de las habilidades\nnecesarias para tratar con cualquier persona.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=0,lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000364",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué dices?! ¡Yo no soy ninguna bestia rara!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=5},
{"fgact",ch="藍",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000198",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, vamos, cálmate. En fin, hora de comenzar los preparativos de la fiesta.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0400",face="b0002",head="shz_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm006"},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000199",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya la comida está lista, ¿será que comenzamos con la fiesta de bienvenida de\nKusanagi?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",mode=-2},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",y2=900,y=0,lv=5,id=9},
{"fgact",ch="圭",act="ウゴウゴ",size=50,lv=5,id=9},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",file="se2362",id=1},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="man_ked_000365",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Iyahhooo!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya, ya, mucho escándalo haces así que no lances esos chillidos tan raros.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0004",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000366",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué? Y eso que expresé mi saludo de bienvenida mediante ese grito.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"¿Es que acaso eres un cavernícola?",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Junto con la puesta del sol terminé de arreglar mi mudanza, y tal como lo\nanunció Ai, la cena de ese día tomó, de una u otra manera, la forma de un\nfestín de bienvenida.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000367",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Buen prove~!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="圭",sync=1,mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x2=0,x=-210,y=0,lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
[100]={
{"se",file="se9031",id=1},
},
[300]={
{"se",file="se9031",id=2},
},
},
text={
ja={
{
"Encima de la mesa estaban servidos todos los platillos que se me ocurrieron.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Bueno, personalmente, se podría decir que la presentación de los platos es\nbastante lujosa... O al menos eso creo.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Supongo que valió la pena el esfuerzo...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="圭",sync=1,mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x2=-210,x=210,y=0,lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
[100]={
{"se",file="se9031",id=1},
},
[300]={
{"se",file="se9031",id=2},
},
},
text={
ja={
{
"En mi boca se separa el pollo del tenedor, y se desliza suave y fluidamente por\nencima de mi lengua, y a medida que muevo mi mandíbula, se extiende por mi\nboca el jugo de la carne mezclado con el sabor de los condimentos.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Muy pocas veces he preparado porciones de medio pollo frito, pero el sabor\nsalió justo como lo tenía previsto.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x2=210,x=345,y=0,lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0013",head="aix_z1h",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0003",head="aix_z1h",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000200",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ohhh, Kusanagi, eres excelente en la cocina. Me dejaste sorprendida.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",x=345,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000368",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro que sí, por algo es mi rival.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000201",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siento mucho haberte hecho preparar casi todo, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No importa, me gusta cocinar, así que no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0014",head="kei_z1b",x=345,y=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",x=345,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000369",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hay que ver que la comida que Naoya prepara es suculenta. Ah, cierto, Naoya,\n¿qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Paté. De hígado de pollo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x=345,y=0,lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000370",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! ¡Paté! ¡Tu especialidad, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",x=345,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000371",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Y qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Risotto. Algo marino, al estilo de los piratas del mar, o algo así.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000202",ch="aid"},
},
ja={
{
name={"Ai"},
"“Realmente es delicioso. No solamente eres bueno pintando, también eres bueno\ncocinando. De verdad que puedes hacer cualquier cosa.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es algo tan exagerado. Todas las recetas las saqué de internet. Casi\ntodos han sido platillos que investigué y desarrollé por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000203",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pero no es increíble que puedas preparar todo esto sin haber aprendido de\nnadie?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera se puede volver capaz de hacer esto si pasa un largo tiempo\ncocinando por su cuenta. Las personas pueden aprender a hacer cualquier cosa\ncuando lo necesitan.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000204",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cuando lo necesitan, eh.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0014",head="kei_z1b",x=345,y=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000372",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aneki, ¿no sería buena idea que aprendieras a cocinar con Naoya? ¡Es todo un\ngenio!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0018",head="aix_z1f",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000205",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cállate. O eso quisiera decir, pero, quizás te pida que me enseñes cuando tenga\nalgo de tiempo libre...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no es la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Aun diciendo eso, me siento un tanto orgulloso de mí mismo al ver cómo\nlos miembros de la familia Natsume se llevan a la boca con tanto gusto la\ncomida que preparé.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Pero bueno, se podría decir que el hecho de que se regocijen tanto con\nplatillos de mi nivel quiere decir que los Natsume han estado sufriendo\nbastante con la comida que han estado llevando a su mesa hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Vaya que han sufrido hasta ahora...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0400",face="b0015",head="shz_z2b",lv=5,id=6},
{"text"},
text={
ja={
{
"Al voltear mi mirada hacia un lado, vi que Shizuku también estaba comiendo.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku... ¿Qué tal está? ¿No tienes ningún reclamo con el sabor?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0400",face="b0008",head="shz_z2b",lv=5,id=6},
{"text"},
text={
ja={
{
"Al escuchar mi pregunta, Shizuku paró de mover los palillos que sostenía en su\nmano y movió sus ojos, decorados con sus largas cejas, en mi dirección.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0400",face="b0019",head="shz_z2b",lv=5,id=6},
{"fgact",ch="雫",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000026",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Mientras movía repetidamente su boca, estaba derramando lágrimas.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡¿Estás llorando?! ¿N-No te gustó?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0400",face="b0020",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000027",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eshtá muy buenooo...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... Qué alivio. ¿Pero por qué lloras? Me asustaste.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0400",face="a0019",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000028",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es que...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso también fue una broma?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fgact",ch="雫",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000029",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000373",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajaja, Shizuku tiene la costumbre de llorar cuando come cosas ricas.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es una costumbre?!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_ked_000374",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no, bueno, probablemente.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo digas a la ligera...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0400",face="b0020",head="shz_z2b",lv=5,id=6},
{"fgact",ch="雫",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000030",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uguh... Delicioso... Delishioso...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Aún inexpresiva, y mientras seguía derramando lágrimas, Shizuku se llevó de\nnuevo el pollo a la boca. Mueve su pequeña boca en cortos movimientos de una\nmanera bastante tierna.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0400",face="b0019",head="shz_z1b",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues qué alivio, parece que le gustó.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000375",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, parece que también le agradaste a la quisquillosa Shizuku, eh, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000376",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Qué bien, ¿verdad, Shizuku?!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"msgoff"},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0400",face="a0005",head="shz_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=200},
{"fg",ch="雫",time=300,mode=3,path=":fg/shz/z1/",file="shz_z1a0400",face="a0005",head="shz_z1a",x2=-345,x=150,lv=4,id=5},
{"ex",time=0,func="wait"},
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",id=1,file="se1528"},
{"bg",file="閃光小",id=9,lv=9,rule=105,time=50,path=":cg/battle/",set="battle"},
{"ex",time=0,func="wait"},
{"ex",time=0,func="wait"},
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0300",face="b0022",head="kei_z2b",lv=5,id=6,sync=0},
{"extrans",time=200},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000377",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pero qué mala, me golpeó!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué piensas lograr haciendo que la quisquillosa Shizuku te odie?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0400",face="a0008",head="shz_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, de igual manera me alegra que te guste comer lo que preparé. Me gusta\ncocinar para los demás.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000031",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y en fin, se cumplió la promesa.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x=-345,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000378",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahh, ¡parece que tenemos nuevo cocinero en la casa Natsume, ehhh!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, planeo seguir haciéndolo mientras me quede acá.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000379",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? Naoya, estás extrañamente dócil.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo quedarme acá y simplemente tragar comida. Debería por lo menos\nencargarme de eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",x=345,lv=4,id=6},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0009",head="aix_z1h",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000206",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué estás diciendo? Todo fue culpa de Kei al haber inundado tu casa.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no estaré tanto tiempo tampoco. Déjame por lo menos preparar la comida.\nEso sí, prepara tú los ingredientes, porque no tengo dinero.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0002",head="kei_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000380",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es, ya Naoya lo está diciendo.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000207",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu... por Dios, parece que de veras quieres que Kusanagi cocine de ahora en\nadelante, eh... No me queda de otra, está bien, hagamos eso.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",x=-570,lv=4,id=3},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=9},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0400",face="a0002",head="shz_z1a",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así, entonces les causaré molestias por un cierto tiempo mientras\npermanezca en esta casa. Kei... Ai... y, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0400",face="a0003",head="shz_z1a",x=570,lv=4,id=4},
{"fgact",ch="雫",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000032",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",x=-570,lv=4,id=3},
{"fgact",ch="圭",act="うんうん",time=80,size=50,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_ked_000381",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uohhhhhh! ¡Esto está en fuego hoy! ¡Como no tienen idea! ¡Y a un nivel\ndestructivo!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ¿Sí? Haces mucho escándalo, así que cállate.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",mode=-2},
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z2",my=40,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",lv=5,id=3},
{"fgact",ch="圭",act="quake",size=30,lv=5,id=3},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_ked_000382",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uohhhhh! ¿Crees que puedo permanecer en silencio ahora~?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=586,speed=100000,file="zbg005k",path=":bg/",x2=960,y2=586,x=580,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué prepararé mañana?...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Al bañarme mientras pensaba en lo que prepararía mañana y luego regresar a mi\nhabitación, el reloj ya estaba marcando las 11.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Era aún un poco temprano para dormir, aunque hoy castigué bastante mi cuerpo\nmoviéndome con lo de la mudanza, así que sentía cómo el sueño se apoderaba\npoco a poco de él.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Recorro lentamente con mis ojos el interior de mi habitación.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Desde hoy, esta habitación se volverá el centro de mi vida diaria.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, la verdad es que no tengo intención de quedarme tanto tiempo...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Una vez se termine de arreglar mi apartamento, volveré a mi vida normal.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Aún con el cabello medio mojado, me tumbé sobre el futón.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Al echar los ojos al techo, pude ver los complicados trazos del grano de la\nmadera. Incluso en eso podía sentir el 'cambio de ambiente'.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Hasta el día de ayer, cada vez que me iba a dormir, veía, sin falta alguna, un\nblanco e inorgánico techo.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Al levantarme despacio, extendí mi mano hacia el estante... y tomé lentamente\nel álbum.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Detrás de esta foto...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Despegué la foto de joven Misakura.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Y de abajo salió un viejo sobre.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"¿Cómo estás en estos momentos? ¿Qué estás haciendo?",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Eso estaba escrito en la carta.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cómo estás...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estuve haciendo en el momento en que recibí esta carta?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Si llegara a encontrarme de nuevo con Rin... ¿qué debería decirle?",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, llegué a hablar de esto con papá también.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Y me dijo que, siempre era posible que nos volviéramos a ver de nuevo…",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Aunque es posible que después de decir 'Tiempo sin verte' no me salgan más\npalabras.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Pero aun así, si llegara a verla de nuevo... debo recibirla con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Una sonrisa normal, natural...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"¿Podré hacerlo?",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo remedio alguno...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Alzo mi mano derecha hacia el techo.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en apariencia se ve bastante normal...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Agarro el aire con esa mano.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Mi mano derecha se movió a mi voluntad.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Aunque sea para agarrar el aire, mi mano derecha no presenta ningún problema.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
