astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000982",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, yo me encargaré de llevar esto de vuelta...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Junto con la moto?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_aid_000983",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo digo justamente porque tengo la moto acá. Este enorme bolso que llevo\nsiempre es el bolso de la motocicleta, puedes meter todo lo que quieras aquí.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... sí, ya me parecía que era algo grande para un bolso común...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_aid_000984",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues ya sabes, llámame siempre que quieras ir de compras. Puedo conseguir un\nbolso aún más grande, si lo necesitas.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tampoco voy a comprar tanto. No va a entrar todo en el refrigerador.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_aid_000985",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_aid_000986",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, me iré ya entonces.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, nos vemos en un rato.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_aid_000987",ch="aid"},
},
ja={
{
name={"Ai"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Ai usa todo el peso de su diminuto cuerpo para dar una patada y encender la\nmotocicleta.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué forma tan latosa de encender el motor.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_aid_000988",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quizás luzca tedioso por lo ligera que soy, pero todas las motos viejas son\nasí.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Igual de estruendosa que siempre, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_aid_000989",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo es, pero este ruido me recuerda a muchas cosas. Por eso es que no me puedo\ndespegar de ella.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas cosas, eh...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_aid_000990",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"En cuestión de segundos, Ai desapareció en el horizonte.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Compras con Ai, eh. No es algo que haga muy frecuentemente...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Aunque no voy a negar que esta salida de la rutina fue divertida...",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"Vierto el an de cebolla y jengibre sobre el arroz frito que Ai preparó.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La cebolla y el jengibre están entre los ingredientes más nutritivos que hay.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Por cierto, agregué también ajo como ingrediente secreto, así que tenemos a\ntres grandes componentes nutritivos.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, le llevaré esto a Kei.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000991",ch="aid"},
},
ja={
{
name={"Ai"},
"“Te lo agradezco.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Siempre que se concentra en la pintura no vendrá a comer aunque lo llames. Es\nmás rápido llevarle la comida.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"El viejo era así también.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",file="se9002",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehhh, Kei.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Me pongo frente a la puerta del depósito y lo llamo.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"No contesta.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy a abriiir, ¿está bieeen?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Alzo la voz y abro la puerta del depósito.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se2264"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei? ¿Estás dormido?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Kei no suelta ni la más mínima reacción.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está dormido... Santo cielo, por lo menos intenta dormir en tu habitación...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Me le acerco. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="圭",size="z1",my=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"se",file="se3130",id=1},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="man_ked_001079",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwah! ¡M-Me asustaste!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-El que se asustó fui yo. ¿Por qué gritas de repente?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",file="ev_com_i02_01",path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001080",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, es que escuchaba música.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Era que estabas escuchando música?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_ked_001081",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, es muy importante para mí aumentar mi concentración con música.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmmmph.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"A pesar de lo que dijo, la canción que se escuchaba de sus audífonos tirados a\nun lado era terriblemente escandalosa.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedes concentrarte con esa canción tan ruidosa?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_ked_001082",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es lo que escucho.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Personalmente, te recomendaría mejor música clásica.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_i02_02",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001083",ch="ked"},
},
ja={
{
name={"Kei"},
"“No me sirve, más que concentrarme lo que hace es darme sueño.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La 'sinfonía del destino' de Beethoven no te dará sueño.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_i02_03",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001084",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cuál era esa?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La que dice '¡Tatatataaan!'”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_i02_01",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_001085",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahh, esa. No sé, ese tipo de canciones suelen tornarse más tranquilas en el\nintermedio.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, toma un tono más tranquilo a partir del segundo movimiento...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_ked_001086",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo sabía, esa música no hace buena química conmigo.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de música escuchas usualmente?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_i02_04",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001087",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Oh, te da curiosidad? Aunque ya debes saber qué género es, ¿no? Mods, y eso.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mops? ¿Tiene algo que ver con mopas o algo así?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_001088",ch="ked"},
},
ja={
{
name={"Kei"},
"“No, se llama Mods.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_i02_06",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001089",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es un movimiento cultural donde la gente monta Vespas como la mía, Lambrettas y\notras motos súper guays.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? ¿Por qué la música está relacionada con esas motos?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_i02_04",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_001090",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, tomará algo de tiempo explicarlo... ahhh, pero si tanto quieres saber de\nla cultura Mods, entonces te enseñaré.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo hagas. No me interesa.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001091",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡El Mods es genial!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Música y motocicletas, déjame adivinar. Es como los Yokohama Ginb*e para los\nBosozoku. O lo que es Kishid*n para los malandrines, o algo así.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_ked_001092",ch="ked"},
},
ja={
{
name={"Kei"},
"“No, no es así, y no conozco ninguna de las dos, pero estoy seguro de que no es\nlo mismo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo puedes decir que no es lo mismo si no conoces ninguna de las dos? ¡Es lo\nmismo! Fin, se acabó esta discusión.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_001093",ch="ked"},
},
ja={
{
name={"Kei"},
"“Muh~, Naoya, ¿no tienes alguna banda o género que te guste?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No que yo sepa, la verdad. Tampoco puedo tocar ningún instrumento, además.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_i02_01",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001094",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo tampoco sé tocar ningún instrumento.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_ked_001095",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué tal el Punk entonces? 'The Jam' es genial, sí. ¡Mod Revival!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_i02_04",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jam? ¿Como mermelada en inglés?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_i02_07",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001096",ch="ked"},
},
ja={
{
name={"Kei"},
"“No es jam, es el Jam.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchacho, solo escuchas bandas con nombres raros.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001097",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No son raros! Eres tú quien no tiene nada de interés por la escena musical.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La escena musical, eh. Tienes razón, interés no tengo...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Ahora que recuerdo, el viejo también solía escuchar canciones parecidas y con\nbastante volumen en el garaje en Nueva York...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"¿Será que los artistas prefieren el ruido?...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que a ustedes los artistas les gusta esas canciones tan ruidosas? Como\nestas de Velvet... Velvet algo.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_i02_08",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001098",ch="ked"},
},
ja={
{
name={"Kei"},
"“'The Velvet Underground'. ¡Pero qué buenas canciones te escuchas!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no los he escuchado mucho en realidad.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_i02_03",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001099",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Velvet Underground la impulsó Andy Warhol, el tipo famoso del Pop Art, ¿no? Eso\nes lo único que sé.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cubierta de uno de sus álbumes es famosa también, el del plátano que Warhol\ndiseñó.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_i02_06",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001100",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, muchas bandas de Rock han tenido las cubiertas de sus álbumes diseñadas por\nartistas. Sonic Youth usó la vela de Gerhard Richter, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A Gerhard Richter sí lo conozco. Es un artista de Alemania Oriental, famoso\ntambién por su récord de obra más cara subastada por un artista vivo. No sé\nqué es eso de Sonic lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_i02_07",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="おじぎ"},
{"text"},
text={
vo={
{"vo",file="man_ked_001101",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... realmente no te interesa el Rock, parece.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que no... al viejo le gustaba la música escandalosa, así que supongo que\nyo tomé el gusto por la música tranquila.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_i02_09",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001102",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué música escuchaba Kenichiro-san? ¿Mods o algo parecido?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que no sé qué es eso de Mods. Habían varios álbumes parecidos\ntirados por el taller, así que tal vez sí.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001103",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, ya veo, las cubiertas eran parecidas. ¿Será que entonces sí los escuchaba?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_ked_001104",ch="ked"},
},
ja={
{
name={"Kei"},
"“Un taller dentro de un garaje en Chelsea, Nueva York... Esa música pega muy\nbien con ese lugar.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Pues sí, combinan muy bien, me parece.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dijiste una vez que Kenichiro no era la gran cosa y ahora sales con eso? ¿Qué\nte pasa?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_i02_07",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_001105",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pues, ¿cómo no podría considerar a alguien tan genial como mi héroe?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Tu héroe? ¿Él?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001106",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pero nosotros algún día nos convertiremos en artistas aún más geniales,\n¿verdad? Por eso es que no debemos darnos por vencido hasta superarlo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no, mi plan a futuro es convertirme en un trabajador público.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_i02_11",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_001107",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿T-Trabajador público?!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quiero un trabajo estable.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001108",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eh~ E-Escucharte decir eso me hizo verte como un perdedor, solo por un\ninstante.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y de qué manera me has estado viendo? Siempre he sido eso.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_ked_001109",ch="ked"},
},
ja={
{
name={"Kei"},
"“No, eso no es verdad. ¡Sé que algún día te convertirás en un gran artista!\n¡Tengo toda la seguridad!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toda la seguridad, eh...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"La verdad es que en mi estado actual no le llego ni a los pies a Kei...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, en fin, come ya. Se va a enfriar.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_i02_11",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001110",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, casi lo olvidaba. A comer.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=300000,file="zbg009a",path=":bg/",x2=960,y2=-586,x=0,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Kei se atiborra de arroz frito.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="man_ked_001111",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué bueno, qué rico esta esto. Ah~, definitivamente tu comida es la mejor,\nNaoya. Si tan solo alguno de los Natsume tuviera un poco de ese talento...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? Ese arroz frito lo preparó Ai.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_ked_001112",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, vamos, no me mientas~ No hay forma de que nee-chan pueda preparar algo\nasí.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"... Sí lo hizo.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"¿Por qué dice eso? ¿Es que Kei no sabe que Ai cocina muy bien cuando se trata\nde arroz frito?",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es problema tuyo si me crees o no. Pero no miento, Ai sí sabe cocinar.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_ked_001113",ch="ked"},
},
ja={
{
name={"Kei"},
"“No te creo. La primera vez que vine a esta casa ella me preparó arroz frito, y\nlo que había en el plato estaba casi todo carbonizado...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
".....",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Ah, claro. Ai no perfeccionó el arroz frito apenas mi padre le enseñó.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Después de esos años de aprendizaje, el primer platillo que le preparó a Kei era\npracticamente carbón. Le tomó unos años más para perfeccionarlo, al\nparecer...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Eso explica ese sabor...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_i02_01",path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001114",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por cierto... ah~”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah~? ¿Qué intentas decir?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_i02_07",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001115",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no... está bien, olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Es raro verte titubear.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_i02_09",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001116",ch="ked"},
},
ja={
{
name={"Kei"},
"“Incluso yo tengo mis momentos.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? No tengo muchos recuerdos de ti haciendo eso...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_i02_02",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001117",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo que quiero decir, es que... no me di cuenta de lo que pasaba, hasta que vi\nesos cuadros...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esos cuadros?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_ked_001118",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí. Para ser sincero, todo, tooodo este tiempo, he estado temiendo algo... Por\neso he estado siendo algo agresivo en mis palabras.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="man_ked_001119",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sé cuándo, pero en algún momento... pareciera que intentaste comenzar a\nvivir resguardando tu mano derecha.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Oculto de inmediato mi mano derecha.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Resguardar?... ¿P-Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="man_ked_001120",ch="ked"},
},
ja={
{
name={"Kei"},
"“No tengo razón en particular. Y además, ya no importa. ¿Sabes? Apenas vi esos\ncuadros, me di cuenta.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esos cuadros? ¿Cuáles?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="man_ked_001121",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me di cuenta de que eres un genio. Y por eso pondré todo mi sudor y sangre en\neste cuadro.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_ked_001122",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quizá no sea bueno que diga esto, pero... la verdad es que me importa un\nbledo la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="man_ked_001123",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me da pena con Makoto, pero realmente no me interesa conseguir algún premio o\nreconocimiento en la exposición.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te interese o no, ¿cómo crees que podrías ganar algo? Es como si un estudiante\nde preparatoria ganara el premio Nobel, o la medalla Fields.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="ev_com_i02_03",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001124",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿En serio? A mí no me parece.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_i02_02",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001125",ch="ked"},
},
ja={
{
name={"Kei"},
"“Después de haber visto eso...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_ked_001126",ch="ked"},
},
ja={
{
name={"Kei"},
"“La verdad, es que solo me gustaría que tuvieras una excusa para pintar. No\nimporta cuál.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"No pude decir más nada.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Sé muy bien lo que Kei está intentando decir.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Probablemente dice lo que dice después de haber visto los seis cuadros del\nSakura Nanasouzu.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Pero esos cuadros no son más que una falsificación.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"No es obra propia mía.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"La elaboración también fue una farsa.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Usé un artilugio para fabricar esos cuadros.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_i02_01",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001127",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué la cara seria?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_i02_02",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001128",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hace falta que pienses tanto. Son solo ideas mías, y no tengo intención de\nforzarte a hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bg",file="ev_com_i02_12",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001129",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero seguiré esperándote tanto como haga falta. Así que no tiene que\nser ahora.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_i02_06",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001130",ch="ked"},
},
ja={
{
name={"Kei"},
"“Solo quiero pintar contigo. Nada más.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_ked_001131",ch="ked"},
},
ja={
{
name={"Kei"},
"“No importa cuándo sea.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001132",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero somos genios los dos, si llegáramos a competir amistosamente entre los dos\ntal vez y terminamos convirtiéndonos en artistas internacionales. ¿Qué se\npuede hacer con tanto talento, eh? Jajajaja.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es tan fácil.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_i02_01",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001133",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro que sí. Nosotros podemos lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_i02_09",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“He seguido a mi padre durante toda mi vida. Nunca llegó a ser un artista\npopular. Su genialidad era indiscutible, pero aun así el mundo no lo\nreconocía.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kenichiro Kusanagi llegó a su más grande punto de inflexión con la muerte de su\namada esposa. Fue entonces que logró completar 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue esa inimaginable desesperanza lo que le llevó a crear una obra casi divina.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo más preciado, lo más valioso en su vida fue Mizuna Kusanagi. Esa es la única\nrazón por la cual Kenichiro Kusanagi se convirtió en artista.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es irónico. Fue cuando perdió ese gran motivo y quedó solo con el arte\ncomo su herramienta que finalmente se convirtió en un artista de renombre\ninternacional.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El arte es cruel.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los sueños devoran a las personas, formando la semilla del arte y haciéndola\nmadurar.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez esa fruta madura está, cae al suelo solo para refrescar a las personas.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estos saborean y elogian el dulzor de la misma, sin saber realmente de dónde\nviene.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esa Exposición Moore en la que están ustedes tan enfrascados, funciona\nexactamente así.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_i02_12",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001134",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, lo sé. Sé que no es tan fácil...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso insisto, que aun compitiendo los dos, no ocurrirá tan fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001135",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quizás no sea fácil, pero imposible no es, ¿o sí?...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, imposible no es...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_ked_001136",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Entonces sí podemos!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Poder... eh.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Solté una amarga sonrisa.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Sí, tal vez tú sí...'",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Para mí sí es imposible...'",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Quise decir eso, pero no pude.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bg",file="ev_com_i02_09",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001137",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, tal vez Kenichiro-san tuvo que perder a alguien tan importante como\nMizuna-san para llegar a la cima por primera vez.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001138",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero juntos los dos, podremos lograrlo sin llegar a eso.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh, eres el único que conozco capaz de decir semejantes ridiculeces...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="man_ked_001139",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, tal vez sea ridículo. Pero no puedes pretender lograr algo tan\nridículamente difícil dándotelas de sabelotodo.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. A veces dices cosas parecidas, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, para lograr algo tan estúpidamente difícil quizás sea mejor ser uno mismo\nestúpido también...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Kei posee un talento único como artista.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Sí, tal vez ese talento lo lleve a los círculos más privilegiados del mundo del\narte.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Quizás incluso algún día llegue a recibir el más grande de los premios que hay\nen el mundo.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Pero será él, y no yo.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Yo perdí mis alas.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"No puedo volar sobre el lienzo como él lo hace.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Lo sé muy bien.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Golondrina, golondrinita. Se acerca el frío, frío invierno. Debes irte ya a\nEgipto...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bg",file="ev_com_i02_03",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001140",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001141",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué, qué pasa? ¿Me estás invitando a un viaje de graduación o algo así? Pero\nlos Natsume somos pobres. ¡Ya veo, así que estás tras el premio en metálico\nde la Exposición Moore!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jajajajaja! ¡De ninguna forma me iría de viaje con alguien tan escandaloso\ncomo tú! Ten por seguro que te sacaría de la lista de invitados.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001142",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡¿Por qué dices esas crueldades, Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, es lo mismo de siempre. No me prestes tanta atención.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_com_i02_07",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001143",ch="ked"},
},
ja={
{
name={"Kei"},
"“Puedes tratarme con cariño de vez en cuando, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en tus sueños.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001144",ch="ked"},
},
ja={
{
name={"Kei"},
"*Tch.*",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cima del mundo, eh... Un sueño algo absurdo, pero no está nada mal.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"bg",file="ev_com_i02_09",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie se imaginaba que el viejo, cuando era todavía profesor a tiempo parcial,\nse convertiría en un artista de fama internacional.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque obviamente él tenía toda la intención de llegar a serlo.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bg",file="ev_com_i02_10",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001145",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así era Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que no me desagradan esos comentarios tuyos.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="man_ked_001146",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo sé. Sé cómo eres.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Kei se echó a reír.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="man_ked_001147",ch="ked"},
},
ja={
{
name={"Kei"},
"“A veces desviarse sirve para avanzar hacia adelante.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="man_ked_001148",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quiero decir, que a veces necesitas echarte hacia atrás para conseguir la\nfuerza para ir hacia adelante.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_com_i02_01",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Kei me dio un disco.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_ked_001149",ch="ked"},
},
ja={
{
name={"Kei"},
"“Canciones que te recomiendo escuchar. Sunflower es genial.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Girasoles...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no soy muy fanático de las canciones estruendosas, pero le daré una\nprobada.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="man_ked_001150",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, escúchalas. Son de mis canciones favoritas. 'The Modfather', ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="ev_com_i02_11",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001151",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Qué reacción tan sobria!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya, ya, me llevaré el plato cuando termines, come rápido.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"bg",file="ev_com_i02_05",sync=0,face=1,time=400,path=":ev/ev_com_i02/",set="ev_com_i02"},
{"text"},
text={
vo={
{"vo",file="man_ked_001152",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Comer con apuro no es bueno para la salud!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé, deja de decir tonterías y come.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="man_ked_001153",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero no son tonteríaaas...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Kei se traga lo que queda del arroz frito.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="05_the_happy_prince_01_4"},
{"text"},
linkback="block_00226",
},
label = {
top={block="block_00000",label=1},
},
}
