astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_spring",time=2000,speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Finalmente llegó el día decisivo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Todo terminó de manera muy sencilla como para realmente poder llamarle\n'negociaciones'.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Probablemente Fridmann tenía todo ya planificado.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Y agregado a eso, ninguno de esos tipos tienen ojo para la pintura.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Fue mucho más difícil mostrarle los cuadros al juicioso Fridmann que al propio\nShoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Y nada se compara a lo nervioso que me sentí cuando se las mostré a Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Al parecer los Nakamura llevaron a unos cuantos comerciantes especializados en\narte, pero ninguno emitió objeción alguna.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"No niego que el acabado de los cuadros ayudó, pero más efecto tuvo que la firma\ny el sello de Kenichiro Kusanagi fueran auténticos.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"La compra se concretó rápidamente.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Luego de eso, se negoció la custodia de Kuzu.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"La compra sumó un total de 1500 millones, 600 de ellos de los seis cuadros, y\n900 de ellos de la fortuna de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"La deuda quedó saldada con esta compra, y Kuzu quedó en libertad.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg033a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_frd_000148",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué pasa, Naoya? A pesar de que todo salió bien no te ves muy contento.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así me veo?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000149",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así te ves...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",file="se9051",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Fridmann encendió un cigarro.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000150",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Te sientes culpable ahora?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000151",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En lo que al mundo del arte concierne, que alguien compre una obra auténtica o\nle hagan comprar una falsificación depende enteramente de la habilidad de esa\npersona. Eso es lo que implica adquirir una obra.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo creo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que Shoichi Nakamura se quede sin hacer nada cuando descubra que esos\ncuadros solo son una falsificación. Pero sí tienes razón, en los negocios de\narte se necesita estar preparado para lo peor, y él debe estarlo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000152",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“De igual manera gran parte de la colección de cuadros que tiene son obras\nfalsas. No tiene ojo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aun con todo el equipo de expertos que trajo?",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000153",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Solo lo hizo esta vez, obviamente. Probablemente le pareció que el negocio de\nobtener seis de los siete cuadros del Nanasouzu era demasiado bueno como para\nser cierto, y prefirió pedir ayuda a conocedores.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000154",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Cambiando de tema, ¿de verdad estás conforme con esto?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con qué?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000155",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Con hacer pasar esos cuadros como obra de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que sí, para eso los pinté.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000156",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Para eso? ¿Para qué exactamente?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no es obvio? Para salvar a Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000157",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Kuzu, eh... Sí, ahora que lo recuerdo Kenichiro también estuvo trabajando en\nNueva York para salvarla...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así parece. Y fui yo quien terminó heredando todo eso.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000158",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Heredar, eh... está bien, dejémoslo así.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué rebuscado, eh. ¿Qué intentas decir?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000159",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No, tienes razón. Heredaste una fortuna de varios cientos de millones, y\ntambién una gran deuda. Que justamente acabas de saldar.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun no, ¿lo olvidas?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000160",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, ciertamente. Iré a pedir la firma oficial como albacea.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya lo habías mencionado. ¿A qué hora?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000161",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En un principio debió haber sido después de la muerte de Kenichiro Kusanagi,\naunque este me pidió que elaborara los documentos de la sucesión lo más\nrápido posible.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse. No habrá garantía de seguridad alguna para Kuzu mientras no\nabandone la herencia.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000162",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“La fortuna de 900 millones que Kenichiro posee, y los seis cuadros valorados en\n600 millones. Juntando estos dos se saldará la deuda de 1500 millones que\nKenichiro tenía con los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000163",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Esos fueron los términos que establecimos con Shoichi Nakamura. Aunque, sí,\nhubo algunos excedentes por parte de los cuadros.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excedentes, eh... Bueno saber eso.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000164",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Prepararé varias copias de los documentos, revísalos previo a la reunión. En\nunos días pediré tu firma para la donación.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Varias copias? ¿No que era una sola página?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000165",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, varias copias. Tendrás también la voluntad sobre la parte de Akashi.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces Akashi debería venir también.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000166",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Obviamente no puedo hacer eso. Por si se te olvidaba, es la sucesión de la\nherencia de Kenichiro Kusanagi. Eres tú quien debe decidir eso.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000167",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque de igual forma no quedará ni un centavo para ustedes...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="フリッドマン",size="z2",mode=3,resize=1,path=":fg/fri/z2/",file="fri_z2b0000",face="b0010",head="fri_z2b",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann, ¿acabas de decir algo o fue mi imaginación?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2b0000",face="b0001",head="fri_z2b",lv=5,id=9},
{"fgact",ch="フリッドマン",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2b0000",face="b0011",head="fri_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000168",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No es nada. Aunque, quisiera preguntarte algo. ¿Leiste bien lo que había\nescrito?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En dónde?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0001",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000169",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En el juramento de venta hecho con los Nakamura. Aquel del cual encargué a\nAkashi.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi se lo dio directamente a Shoichi Nakamura, no tenía forma de leerlo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0008",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000170",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pues deberías revisar una de las páginas del juramento entonces. Tengo una\ncopia por si la necesitas.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0003",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000171",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tiene escrito el porcentaje exacto que la Fundación Moore recibirá de este\nnegocio.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Espera un momento! ¡¿Cómo es que la Fundación Moore va a recibir algo del\nnegocio?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000172",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Creo que mencioné con mucha claridad, desde un principio, que es la Fundación\nMoore la que se ha encargado de apoyar a Kenichiro Kusanagi. Es ridículo\npensar que aceptaríamos una venta sin beneficio alguno para nosotros.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--- Espera, ¿cómo hiciste que el dinero fuera a la fundación?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000173",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Los documentos de la venta indican que las obras auténticas que obtuvimos de\nlos Nakamura fueron vendidas con mediación mía. Solo ajusté un poco el margen\nde ganancia de la venta.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"A eso se refería cuando mencionó que los excedentes que recibiríamos de los\nseis cuadros no sería en dinero, sino en obras...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0003",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000174",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No te preocupes. Si quieres dinero podrías abandonar a la muchacha y recibir la\nherencia. De esa manera podrás obtener fácilmente 1500 millones.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Maldito imbécil... Jamás me imaginé que usarías esa clase de truquitos...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000175",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Truquitos? Siempre, y digo siempre, debes leer el contenido de un contrato al\nhacer un negocio. Es una de las reglas más básicas al participar en negocios.\nY con más razón debes hacerlo cuando se trata de un juramento.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-En ningún momento tuve la oportunidad de leerlo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000176",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso no es excusa. Un juramento es un juramento.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000177",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Al momento de tomar tu firma para la donación pediré tu confirmación tres\nveces. De si realmente abandonarás o no la herencia.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000178",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tres veces son suficiente para que te decidas...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo tres veces?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000179",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aún tienes tiempo para pensarlo. Quedan varios días para la firma del contrato.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000180",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Mm? Vaya, pero qué tarde es ya. Tengo que dirigirme a mi próximo trabajo.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera! ¡Fridmann, bastardo!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000181",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Métete esto en la cabeza, y no lo olvides. Yo no hago nada que no dé dinero.\nTen más cuidado la próxima...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9004",id=1},
{"fg",ch="フリッドマン",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Fridmann se fue sin mediar más palabra.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000738",ch="wtd"},
},
ja={
{
name={"???"},
"“Jaa, nos han engañado por completo, vaya que sí~”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero q--, ¿estabas ahí?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="明石",size="z1",mx=-40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000739",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tanto esfuerzo invertido en ese negocio millonario y ni un centavo, nyaaah.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad piensas quedarte sin hacer nada?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000740",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué más podría hacer? ¿O prefieres mejor recibir la herencia y dividirla\nconmigo?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera un segundo. Suponiendo que reciba la herencia, ¿qué razón tengo\npara compartirla contigo?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000741",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Amigo mío, nosotros somos ya como compañeros de guerra, o debería decir más\nbien, hermanos, ¿o no~? De hoy en adelante puedes llamarme hermano y adorarme\ncomo tal.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de juego macabro es ese?...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000742",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vamos, ¿juego macabro? No podría haber mayor felicidad para alguien que tener\nun hermano tan confiable y preparado como yo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien confiable y preparado no firmaría un juramento sin siquiera leerlo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000743",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Guh... es que, estaba escrito en inglés.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debiste haberlo leído, idiota, así fuese usando un traductor en línea.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000744",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es que... era un fastidio leer todo eso.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, fuiste un completo idiota por no revisar ese juramento de antemano.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000745",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Tú tampoco lo hiciste!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo ni siquiera llegué a poner mis ojos sobre él!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000746",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Pues la culpa la tienes tú por no intentar hacerlo!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y cómo iba a verlo?! ¡Fuiste tú quien le dio el juramento directamente a\nShoichi Nakamura!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000747",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Un pintor de tu calibre debería ser capaz de leer eso usando poderes psíquicos.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo es que ahora soy un psíquico?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000748",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vamos, eso no importa ya. Si bien no pude ganar dinero, sí pude ganar algo más.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ganar algo más?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000749",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí. Todo este tiempo he estado haciendo experimentos pero nunca tuve éxito,\nnyaaah. Pero gracias a tu idea de ajustar la fuerza con los resortes ya sé\nbien qué hacer.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te inspiraste en mi idea con los resortes? ¿Qué piensas hacer?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000750",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Nada, nada de nadita. Yo soy un buen ciudadano, sí señor~”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000751",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Akashi se traga sus palabras.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aunque, qué?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000752",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Esos seis cuadros, realmente eran impactantes... Yo también quisiera crear\ncerezos así.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cerezos? ¿Qué, es que tu próxima obra será de cerezos?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000753",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso no importa ahora. En fin, todo salió bien. Final feliz, sí.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Fiuu*, si tú lo dices...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000754",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Uhm, bien, ahora sí me despido.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame preguntártelo una vez más, ¿estás seguro de que no necesitas el dinero?\nQuizás haya alguna forma de sacarle dinero a Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque va a ser bastante complicado, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000755",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ese dinerillo no significa nada para una personalidad de mi calibre. No\nnecesito ni un centavo, nada de nada.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso dirás ahora, pero estoy seguro de que te arrepentirás después.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000756",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y tú no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Aun metiéndonos en un enredo de tanto dinero, no ganamos ni un centavo.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Pero ambos somos idiotas de raíz. Somos más libres así, sin dinero.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Aunque, probablemente el arrepentimiento me carcomerá después...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente somos unos idiotas, eh.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000757",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y ahora es que te das cuenta? Idiotas no, grandes idiotas. Idiotas sin remedio\nalguno.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000758",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por eso es que nos juntamos para esto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin duda alguna.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La próxima vez que nos veamos será después de las vacaciones de invierno,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000759",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Uhm, así es. Tercer período.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Por ahí nos vemos, Akashi.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000760",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sí, por ahí nos vemos, muchachos Yama Yamamoto de Yamato! ¡Adiós!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bgm",stop=1,time=1000},
{"fg",ch="明石",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Akashi se fue.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"¿Los muchachos Yama Yamamoto?... Solo estoy yo...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_uni_c08_01",path=":ev/ev_uni_c08/",set="ev_uni_c08"},
{"bgm",file="bgm022"},
{"text"},
text={
ja={
{
"El viejo vivió unos tres meses más tras ese día.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Vivió hasta el último momento con bastante energía.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Su testamento decía lo siguiente:",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Díganle a todos que mi vida fue de tristeza y sufrimiento, así no tendrán nada\nde qué preocuparse.'",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"'¡Júbilo y alegría a mi muerte! ¡Despídanme con sonrisas!'",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Sí, esa ridiculez fue su última voluntad.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Aunque bueno, hay que decir que fue un final muy a su estilo.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Comienza abril.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Y su entierro fue realizado.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"En medio del bosque de cerezos, el viejo se convirtió en huesos.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"La muerte de ese hombre, que alguna vez llegó a plasmar esa extraordinaria\nimagen de los cerezos, llegó a su fin en una ordinaria ceremonia funeraria.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Aunque quizás por haber plasmado tales extraordinarios cerezos es que merecía\nconvertirse en cenizas en medio de ordinarios y verdaderos cerezos.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Por un momento me pareció que sería una muy infantil venganza de mi parte, pero\npensándolo bien, también es la mayor muestra de respeto y admiración que\npodía darle.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Nadie más que los genios merecen descansar eternamente en algo tan ordinario y\nuniversal como lo es el suelo de la tierra.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Ese día, mientras el funeral se realizaba en medio de los cerezos, no solté ni\nuna sola lágrima.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Pasé todo ese día con una tranquilidad descomunal.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y es que realmente no lo amaba tanto como padre... o al menos eso quisiera\ndecir, pero... me estaría mintiendo.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Ese día, cuando dijo que mis cuadros eran sus 'epitafios'.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Ese día, cuando puso su sello sobre la serie de los seis cuadros.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Lloré como un niño.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Epitafios... Eso es muy de él.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Y para decir la verdad, creo que esas palabras salvaron a mi obra.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Es normal desear la salvación de la creación propia.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Probablemente casi todos los que han creado algo desean eso.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"En ese sentido, podría decir que fui un pintor con mucha suerte.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Y por eso es que pude despedirme de mi padre, sin resentimiento alguno, bajo\nlos cerezos...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Fue así que me despedí del último pariente que me quedaba de la familia\nKusanagi...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Los cerezos estaban realmente hermosos ese día.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="black",path=":bg/"},
{"ex",time=2000,func="wait"},
{"text"},
text={
ja={
{
"Y en lo que respecta a la sucesión de la herencia...",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"El acto formal se realizó unos días después de que culminaran las negociaciones\ncon los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_a04_01",path=":ev/ev_com_a04/",set="ev_com_a04"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo aceptar este dinero...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La relación que el señor Kenichiro Kusanagi y yo tuvimos no fue tan cercana\ncomo para yo poder recibirlo...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_kna_000002",ch="kna"},
},
ja={
{
name={"Persona involucrada"},
"“¿Que no fue cercana?...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_knb_000002",ch="knb"},
},
ja={
{
name={"Persona involucrada"},
"“Naoya-kun, ¿acaso el señor Kusanagi no es tu padre?... ¿A qué viene esto?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Todos se quedaron observándome perplejos.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Es de esperarse.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Soy el único pariente de aquel famoso artista de renombre internacional. Y\nacabo de decir que no aceptaré su fortuna...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Solo una sola persona, el hombre que tengo frente a mí ahora, me observó con\nuna mirada perspicaz.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Obviamente ese hombre es Fridmann.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_frd_000182",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Su relación no fue cercana?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Por supuesto, se supone que 'en este momento' Fridmann y yo no nos conocemos,\nni nos hemos visto antes.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Todo esto fue un teatro armado por nosotros dos.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_frd_000183",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué quiere decir con que la relación entre los dos no fue lo suficientemente\ncercana?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El señor Kenichiro Kusanagi y yo no somos nada... eso es lo que quiero decir...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_frd_000184",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿No son nada?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, y por dicha razón no puedo aceptar este dinero.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"El silencio se esfumó del lugar.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Pude darme cuenta de como todas las personas que estaban adentro estaban ahora\nalteradas.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"¿Cómo no alterarse?...",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Aunque la única manera que tengo ahora de salvar a Kuzu es abandonando la\nherencia.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Sonará estúpido volver a decirlo, pero es así.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_frd_000185",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Fridmann dijo eso, con una pequeña sonrisilla dibujada en su cara.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_a04_02",sync=0,face=1,time=400,path=":ev/ev_com_a04/",set="ev_com_a04"},
{"text"},
text={
ja={
{
"¡Espera, espera un momento, imbécil!",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"¡Dijiste que me preguntarías tres veces!",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_frd_000186",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bg",file="ev_com_a04_03",sync=0,face=1,time=400,path=":ev/ev_com_a04/",set="ev_com_a04"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada... Solo que no puedo contener mi sorpresa. Primera vez\nque veo a alguien tan poco dispuesto a cumplir sus promesas...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_frd_000187",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Soy de mente pragmática, ¿sabes? Me pareció que era suficiente con preguntar\nuna sola vez. ¿O quieres que sigamos con el teatro tal como lo planeamos?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta. Pasa solamente que a los japoneses nos encanta disfrutar del\nregusto al experimentar algo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_frd_000188",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Vaya, ya veo. Pues si tanto quieres disfrutar de ese regusto podrías firmar y\nhacerlo fuera de esta oficina, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso haré...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Marty Fridmann.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"¡Maldito pragmático de mierda, no entiendes ni una pizca de las delicadas\ntradiciones de Japón!",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_frd_000189",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Bien, firme acá, Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Termino de poner mi firma.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_a04_01",sync=0,face=1,time=400,path=":ev/ev_com_a04/",set="ev_com_a04"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con esto se ha acabado todo vínculo que podía haber entre Kenichiro Kusanagi y\nyo...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que les ruego que no me busquen más...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_frd_000190",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, puede que no te busquemos más. Al menos en lo que concierne a Kenichiro\nKusanagi...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_a04_04",sync=0,face=1,time=400,path=":ev/ev_com_a04/",set="ev_com_a04"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que no estás entendiendo, no te atrevas a buscarme de nuevo, bastardo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_frd_000191",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Donde sea que haya dinero estaré yo.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues espero no estar ahí, maldito animal económico!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_frd_000192",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Si no me falla la memoria, ese derogatorio se lo dieron a los japoneses.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero te queda perfecto a ti.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_frd_000193",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ya veo. Aunque creo que lo tomaré mejor como un cumplido...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jamás en mi vida volveré a meterme en algún negocio contigo, imbécil!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Después de dejar esas agresivas palabras salí de la oficina.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y fue de esa manera que rechacé la herencia de la fortuna.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Akashi tampoco pudo obtener recompensa alguna por su ayuda.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"El único que se benefició fue Fridmann al tomar los enormes excedentes que\nquedaron de la venta de las obras auténticas cedidas por los Nakamura...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"No, creo que me equivoqué ahí.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"El único que salió perdiendo fue Akashi...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“He vuelto~”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000421",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Bienvenido de vuelta, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Kuzu me recibe al entrar.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuzu, ¿podemos sentarnos un rato a hablar?",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="du",lv=4,id=9},
{"se",file="se9010",vol=70,id=1},
{"text"},
text={
ja={
{
"Y entonces, Kuzu se sentó en plena entrada.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, no, acá no. Vayamos a la sala.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000422",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¿No? Pensé que me pedirías una felación en esta posición.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Cómo me crees capaz de pedirte semejante bestialidad apenas regresando a casa?",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000423",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Llevas un buen tiempo sin venir a casa... y pensé que tendrías muchas ganas\nacumuladas.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"No tengo energía alguna para eso. No dormí casi nada en todo este tiempo.\nAdemás, más de una vez fuiste a tragarte mis sueños mientras dormía...",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000424",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Lo sé, pero aun así...",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"En fin, vayamos a la sala. Allá podremos hablar con calma.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Llevo a Kuzu a la sala.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"se",file="se9002",vol=40,id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-340,file="zbg023b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"se",stop=1,id=1,time=500},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0001",head="shz_z2a",lv=5,id=9},
{"se",file="se9010",id=2},
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuzu.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000425",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¿Sí?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Kuzu se sienta sobre el sofá.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya todo terminó.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0012",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000426",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¿Todo terminó?",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, ya los Nakamura no vendrán más por ti.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000427",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¿Eh? ¿Cómo?",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, digamos que organicé un poco la fortuna del viejo, y reuní el dinero\nnecesario. En fin, pude obtener tu libertad.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esta es la carta de garantía.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"se",file="se2497",vol=40,id=1},
{"text"},
text={
ja={
{
"Le doy una hoja de papel a Kuzu.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Lo obtuve al momento de sellar el contrato de venta con los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"La carta indicaba, básicamente, que jamás volverían a ponerle una mano encima.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Aunque, el nombre escrito no era precisamente 'Kuzu'... Pero bueno, no podía\nhacer nada. Estaba escrito el nombre que ella misma ha estado ocultando. Hice\nlo posible por no verlo.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000428",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"P-Pero, se supone que la fortuna de Kenichiro no alcanzaba para...",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, no, sí alcanzó, por eso tengo esta carta. Eres libre ahora.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000429",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Soy libre...",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, y ya no hace falta que te ocultes o que sigas usando nombres falsos. Ahora\npuedes vivir con tu verdadero nombre, en donde realmente deberías estar.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"A partir de hoy eres libre.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000430",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"P-Pero, Naoya.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya te lo dije, lo único que hice fue reorganizar la fortuna. Sí, no pude\nrecibir la herencia, pero ya tenía planeado no recibirla de igual manera.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000431",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Naoya... Naoya, yo, no tengo manera alguna de pagarte de vuelta.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Recuerdas lo que te pedí hace un tiempo? Quiero que pruebes mi comida.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000432",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Sí, lo sé, pero eso no es nada suficiente.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"Para mí sí lo es. Cuando todo se calme y puedas lograr regresar a tu vida de\nantes, ven a verme.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"Te prepararé algo delicioso.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000433",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Bueno... está bien.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"Me pregunto qué cara pondrás ese día.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000434",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"No lo sé. En este momento mi ser está muy cercano a Hakuki. Así que la variedad\nen mis expresiones y sentimientos es muy pobre.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo. Pues bueno, esperaré con ansias entonces el día en que puedas volver a\ntener una vida normal.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0002",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000435",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"Sí. Pero, ten por seguro que te regresaré este favor. Así me tarde varios años\nen hacerlo.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"Tonta, si piensas hacerlo con dinero mejor no lo hagas. Y además, soy yo quien\nrealmente... debe darte las gracias.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000436",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¿Eres tú, quien realmente debe dar las gracias?",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así es. Tengo que darte las gracias por haberme dado esta oportunidad. Si no\nfuera por todo esto no hubiese podido crear esos cuadros.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esa espléndida confusión de epitafios...",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"Gracias a esto fue que pude crear esa obra...",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"Supongo que en ese sentido, tendría que darle las gracias también a ese\ndetestable Shoichi Nakamura. Por supuesto, a Akashi también, e incluso al\nbastardo de Fridmann...",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"Gracias a ellos pude vivir ese maravilloso instante...",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c50_01",path=":ev/ev_uni_c50/",set="ev_uni_c50",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"'Fantasía de un día de cerezos' se la dediqué a mi madre.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_f04_14",path=":ev/ev_com_f04/",set="ev_com_f04",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Y por otro lado, a pesar de que 'Sakura Nanasouzu' fue creada como una\nfalsificación, mi padre me dijo 'estos serán mis epitafios'.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Ese día.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Ese día, obtuve una sensación de plenitud en esa creación que jamás había\nexperimentado.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Como ese instante.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Jamás habrá otro.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-340,file="zbg023b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"Por eso soy yo quien debe agradecerte.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por haberme otorgado el mejor de los momentos con mi viejo...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ni cientos, ni miles de millones de yenes podrían valer por ese maravilloso\nmomento...",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sabes muy bien de lo que hablo, verdad, Kuzu?",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Y entonces, puse mi mano sobre su hombro.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0019",head="shz_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Las lágrimas no paraban de brotar de sus ojos.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Claro...",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Kuzu también lo amaba... así como yo...",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, lo olvidaba... tengo que darte esto también.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Le doy una vieja caja de madera de paulonia a Kuzu.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000799",ch="szd"},
},
ja={
{
name={"Kuzu"},
"¿Esto es?",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"No lo sé, el viejo me pidió que te lo diera. Dijo que serviría para romper por\ncompleto el vínculo entre tú y los Nakamura...",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000800",ch="szd"},
},
ja={
{
name={"Kuzu"},
"Eso significa que...",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Kuzu aprieta la caja de paulonia. Y entonces de adentro se escuchó el leve\ntintineo de unas campanas Kagura.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0019",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",time=100,size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000801",ch="szd"},
},
ja={
{
name={"Kuzu"},
"Siempre... siempre soy yo, la que recibe los favores...",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Kuzu vuelve a entrar en llanto.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"se",file="se9010",vol=40,id=1},
{"text"},
text={
ja={
{
"Tomo su cabeza y la abrazo con cariño.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Lloró, como nunca lo había hecho antes.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_03_1"},
{"text"},
linkback="block_00286",
},
label = {
top={block="block_00000",label=1},
},
}
