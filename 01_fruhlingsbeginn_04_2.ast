},
},
text={
vo={
{"vo",file="man_ked_000756",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No es ningún homosexual! ¡Es otro idiota que me confundió con una mujer!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fgact",ch="トーマス",act="停止",lv=5,id=6},
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0200",face="a0009",head="tho_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000006",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Oh~, no pensé que de verdad existieran los 'otoko no ko' tan vistos en los\njuegos y anime de Japón. No podía esperar menos del país de los HENTAI,\nJapón. Esto es MARRRAVILLOSO, DESU.”",
{"rt2"},
},
},
},
linkback="block_00099",
