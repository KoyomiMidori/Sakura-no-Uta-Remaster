astver = 2.0
astname = "ast"
ast = {
block_00000={
{"se",file="se2308",id=1},
{"bg",file="bluesky_winter",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000144",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmmm. ¿Qué piensas, Kusanaagi?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerca de qué?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"bg",time=500,file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm008"},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Después de clases, justo en el instante en que abrí la puerta de la sala de\narte, un idiota viene a preguntarme algo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Qué tipo tan enérgico y fuerte. A pesar de todo el daño que le infligieron\nayer, está ahora comiendo un ochazuke después de clases como si nada.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000145",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Respecto al asunto de la reciente tendencia de reevaluación respecto a mí que\nse ha venido expandiendo a nivel internacional.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000146",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“*suu*, *suu*... Puhaa...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000147",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Personalmente, pienso que debería ir aprovechando de manera adecuada la opinión\ninternacional a mi favor...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida eso, ¿no se supone que deberías estar estudiando en tu casa?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000148",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Estudio en mi casa. Sin embargo, en estos momentos estoy acá para comer. No hay\nnada misterioso en eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya es bastante misterioso de por sí que vengas a la sala de arte del colegio\nnada más a comer ochazuke. Y además, ¿no es eso un ochazuke de tonkatsu?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000149",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Los ochazuke de tonkatsu saben bien, y por eso estoy comiéndolo. ¿TI E NES\nalgún problema con eso?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, ya veo. Parece que fue un error haber tratado de preguntarte.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000150",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sin embargo... nadie debe saber que los tonkatsu saben buenísimos al mezclarlos\ncon ochazuke... ¡Y menos alguien de tu talla, Kusanagi! ¡No creas que te voy\na dar!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me hace falta...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"El idiota come mientras sigue murmullando cosas sin sentido como siempre. Por\nahora, tomo un asiento.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000151",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y bien, como te decía, respecto a mi reevaluación internacional.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún vas a seguir con eso?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, ¿qué es eso de reevaluación?... ¿Es que hubo alguna época en la que\ntuviste fama a nivel internacional?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000152",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No sabías?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000153",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No sabías que quedé de tercer lugar en la maratón del año pasado?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso sacaste nuevos records de tiempo mundial en la maratón del año\npasado?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000154",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, una serie de eventos trágicamente dramáticos se dieron lugar a nivel\ninternacional. También murieron muchas personas.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está bueno ese tonkatsu en ochazuke?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000155",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, está de rechupete. ¡El tonkatsu en ochazuke sabe a tonkatsu, así que es una\ncomida muy buena!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces disfruta tu tonkatsu sin pensar en nada más. ¡Me fastidias!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000156",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmph, no hace falta que una masa idiotizada como tú me lo diga, ya yo estoy\nsaboreando mi comida comenzando por los ingredientes. Los ingredientes\nlimpian y purifican todas mis vísceras.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te pongas a limpiarte las vísceras con un simple tonkatsu en ochazuke...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="明石",size="z1",ex02="b0098",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000157",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmph, no tiene caso hablar contigo.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no tiene caso. Así que no me hables, idiota.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000158",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es un desperdicio gastar mi tiempo hablando contigo.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Es toda una agonía tener que quedarme a solas con este idiota.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Toritani dijo que hoy habría algo importante, y por eso nos pidió que\nesperáramos en la sala de arte...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"¿Qué estará planeando hacer hoy?",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000159",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Kusanagiii?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿No se supone que no tenía caso que hablaras conmigo?! ¡No me hableeess!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="明石",size="z1",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",loop=-1,time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000160",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Auch, auch. ¿Pero qué pasa, estás pasando por tu época rebelde?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fgact",ch="明石",act="停止",lv=4,id=9},
{"bgm",stop=1,time=1000},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000641",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, vaya, hoy estás algo violento, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que lo estoy. Por tu culpa no pude disfrutar en libertad la tarde después\nde clases, y de paso tuve que quedarme a solas con este tonto.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",file="bgm030"},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000346",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Akashi-senpai. Lo siento bastante por lo de ayer.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000642",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace falta que te disculpes. Akashi tuvo 100 % de la culpa.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_wtd_000161",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué quieres decir con 100 %? En este mundo no hay nada al 100 % absoluto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000347",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, me parece que tuve gran parte de la culpa al respecto. Simplemente pude\nhaberlo esquivado...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, hubiera sido más peligroso si no hubieras podido esquivarlo adecuadamente.\nAdemás, Akashi no sufrió casi daño.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_wtd_000162",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso es perfectamente obvio. No soy tan frágil como para sufrir daño del\nlanzamiento de una chica.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"¿Pero qué está diciendo? El mismo que se desmayó cuando lo lanzaron.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_wtd_000163",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y bien? ¿Eres estudiante de nuevo ingreso?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fgact",ch="稟",act="いいえ",size=4,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000348",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, fui transferida a este colegio, y a partir de este año comienzo el tercer\naño.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_wtd_000164",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmm, y bien, ¿eres una nueva integrante del club?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0013",head="mak_z1a",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000643",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡NO! ¡NO! ¡¿No voy a dejar que lo hagas, está bien?! ¡No voy a permitir que\notra más de las nuevas integrantes renuncie al club por tú andar levantando\nfaldas o haciendo cosas de ese estilo!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000165",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué estás diciendo? No hay manera de que yo haga algo como eso.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000644",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El año lo hiciste, ¿recuerdas? Lo hiciste y gran parte de los nuevos\nintegrantes renunciaron, ¿no recuerdas? Si no recuerdas, ¿quizás\ndebería hacer que lo recuerdes?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000166",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“N-No, creo que acabo de recordarlo, no hace falta.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"se",file="se2308",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=300},
{"msgoff"},
{"fg",ch="里奈",size="z1",mx=40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0200",face="d0002",head="rna_z1d",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rna_000070",ch="rna"},
},
ja={
{
name={"Rina"},
"“Buenas tardes.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_yum_000099",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0002",head="rna_z1d",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000750",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso... Bien, ¿será que comenzamos con las actividades de hoy?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000645",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Espera, antes de eso, tengo algo que decirles hoy.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_ked_000751",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Algo que decirnos?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos habías pedido que nos reuniéramos para darnos un anuncio importante, ¿qué\npaso ahora? ¿Es que acaso Akashi volvió a cometer alguna nueva fechoría?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000167",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Yo no he hecho nada! ¡Soy inocente! ¡Totalmente inocente!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000646",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tú! ¡No te asustes sin razón alguna! Además, mis anuncios importantes no son\nsiempre referentes a las fechorías de Akashi. En primer lugar, no recuerdo\nhaberlo llamado a él.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es verdad eso?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_wtd_000168",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque no me convoquen asisto de igual manera. Soy todo un integrante ejemplar.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"¿No te da pena decir eso?",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000647",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bueno, para proseguir, también le pedí a Akashi-senpai que viniera, a pesar\nde que debería estar encerrado en su casa estudiando, y no quiero quitarles\nmucho tiempo, así que iré directo al grano.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000648",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es respecto a la búsqueda de nuevos integrantes para el club.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ya conseguimos un buen número de nuevos integrantes, ¿no debería haber\nterminado ya la búsqueda?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000649",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo también pensaba eso, pero hay un detalle que me llama la atención.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un detalle que te llama la atención?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000650",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno, en fin, después les explicaré. Thomas, entra.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Thomas?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bgm",stop=1,time=300},
{"user",mode="conf",ch="トーマス"},
{"se",file="se2308",id=1},
{"msgoff"},
{"fg",ch="トーマス",size="z1",time=600,sync=1,mx=40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",lv=4,id=9},
{"ex",time=100,func="wait"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000001",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH~, ¿es este aquel celestial escenario conocido como el Cielo~?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",file="bgm012"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién es este tipo?...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_ked_000752",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es un extranjero.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Un extranjero? ¿Esto?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_ked_000753",ch="ked"},
},
ja={
{
name={"Kei"},
"“Su cara es distinta a la de un japonés. Es un extranjero.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Distinta a la de un japonés... Me da la impresión de que también es distinta a\nla de un humano.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="トーマス",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000169",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Tú, maldito! ¡¿Quién eres?!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Akashi se para de repente frente al hombre que acababa de entrar. ¿Será que\nalgo estimuló alguno de sus instintos latentes?",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0003",head="tho_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000002",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",mode=-2},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0017",head="kei_z2a",x=-500,lv=5,id=5},
{"fg",ch="トーマス",size="z2",mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0200",face="a0008",head="tho_z2a",x=500,lv=5,id=6},
{"fgact",ch="トーマス",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000003",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Oh~, pero si es la FANTASTIC maravilla internacional conocida como Yamato\nNadeshiko.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0013",head="kei_z2a",x=-500,lv=5,id=5},
{"fgact",ch="圭",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000754",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000170",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Eh, pero es que vas a ignorarme?! ¡Devuélvete allí! ¡Imbécil extranjero!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"El intento de extranjero ignoró por completo a Akashi y está ahora hablándole a\nKei. Aunque su aspecto luce algo extraño.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0200",face="a0001",head="tho_z2a",x=500,lv=5,id=6},
{"fgact",ch="トーマス",act="いいえ",loop=-1,time=300,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000004",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Desde que te vi hace poco, he estado loco y ansioso por volver a verte de\nnuevo.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",x=-500,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000755",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Hace poco? ¿De qué estás hablando? Yo no te conozco.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fgact",ch="トーマス",act="停止",lv=5,id=6},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000651",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un estudiante de intercambio de Francia, se llama Takizawa Thomas Nagel\nJunpe.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acaba de referirse a sí mismo como 'Wai'. ¿De verdad esta cosa vino de Francia?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000652",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Así es, es un nuevo integrante que vino de Francia! Eso fue lo que me dijo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Todo eso fue declarado por él mismo?! Por lo menos pregúntale a los\nprofesores si de verdad viene de Francia.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000653",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Sinceramente, así venga de Francia o haya nacido del suelo, no me importa.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te importa?...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000654",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay algo más importante que la cuestión de si es o no de Francia, y por eso lo\ntraje.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Más importante?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",mode=-2},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0012",head="kei_z2a",x=-500,lv=5,id=5},
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0200",face="a0008",head="tho_z2a",x=500,lv=5,id=6},
{"fgact",ch="トーマス",act="いいえ",loop=-1,time=300,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000005",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Hoy llevas esa ropa? Hmm~, no está nada mal, pero me parece que te queda mejor\nla ropa que llevabas hace poco. Los trajes femeninos son los mejores para ti~”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"El extranjero se quedó pegado a Kei.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Otro homosexual más?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
