astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="nightsky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"se",file="se2225",id=1},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000009",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“¡Toritani-saaa～n!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Justo al entrar a la tienda, la muchacha de medio tiempo estaba acercándose\ntrotando hacia Toritani.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002197",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_bit_000010",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“La chica del turno de la noche llamó de repente, dijo que no podría\nvenir...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002198",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entendido, gracias.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_bit_000011",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“¿Qué hacemos? Está difícil pedirle a alguien que venga ahora mismo, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002199",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te preocupes. Últimamente no han venido muchos clientes en la noche, y\nademás estoy yo acá. Iré un momento a cambiarme, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Llamo a Toritani antes de que entrara al fondo del local y la detengo.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te ayudo? No tengo mucho que hacer, después de todo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002200",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No tienes mucho que hacer? Escucha... Se supone que tienes que estudiar y\nhacer otras cosas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo es por hoy, así que no hay problema, ¿no? ¿No tienes un delantal o algo\nasí? Con un delantal negro de cafetería puedo dar la apariencia de ser\nempleado.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Al preguntarle a la muchacha de medio tiempo, esta me comenta que en el fondo\nhay, así que nos dirigimos juntos al cuarto de empleados.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002201",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esperen, esperen, esperen! ¡No voy a permitir que sigan haciendo lo que\nquieran mientras me ignoran!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_bit_000012",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Eh~, pero está diciendo que nos ayudará, deberías dejar las reservas y\naprovechar la oportunidad~”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, así es~”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002202",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002203",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te pagaré por todas las horas que trabajes, así que registra tu hora de\nentrada.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Toritani, aun con una expresión malhumorada en su rostro, accedió sin más qué\ndecir.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Seguramente llegó a la conclusión de que no sería muy buena idea venir a sacar\nla misma charla de siempre de las deudas y los préstamos frente a la muchacha\nde medio tiempo. Muy bien, buena chica.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le aviso a Ai que llegaré algo tarde, y entro a trabajar.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo se fue al acabarse su turno. Después de eso,\nToritani se encargó de la cocina y yo de atender las mesas. No hacemos mal\nequipo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002204",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi~, ¿podrías llevarle esto a la clienta que acaba de llegar?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",mode=-2},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Pongo el café sobre la bandeja y lo llevo.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"La clienta que acaba de llegar... Aun no he recibido ninguna orden... ¿Será que\nes una clienta asidua?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"se",stop=1,time=500,id=1},
{"fg",ch="霧乃",size="z2",mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0002",head="kir_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquí tiene su orden de café.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Pongo la taza de café enfrente de la mujer que se sienta siempre acá. Es una\nclienta frecuente, que suele venir periódicamente.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0003",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000002",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Oh, vaya, así que hoy estás trabajando acá.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sucedió un pequeño percance, y bueno...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Jamás nos habíamos hablado antes, pero nos conocemos las caras. Quizás por eso\nes que podemos charlar ahora con algo de naturalidad.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0002",head="kir_z2a",lv=5,id=9},
{"fgact",ch="霧乃",act="du",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000003",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La mujer baja la cabeza en señal de agradecimiento, aun ante un simple empleado\nprovisional como yo, y comienza a tomar del café. Es una mujer delgada, de\ngestos delicados y con aspecto amable.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0003",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000004",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“El café de este local es siempre delicioso.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la jefa de empleados es muy buena en lo que hace.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0010",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000005",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Es esa muchacha, ¿verdad? Esa amable y muy trabajadora jovencita de hermosa\nsonrisa.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Aunque me parece que está trabajando demasiado.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0002",head="kir_z2a",lv=5,id=9},
{"fgact",ch="霧乃",act="うなづく",time=100,size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000006",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Fufu, si tiene personas a su alrededor que se preocupan por ella, entonces\nseguramente está bien.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"A diferencia de las cadenas, son muchos los clientes que vienen a este tipo de\nlocales individuales para disfrutar de una buena conversación con los\nempleados.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, esta clienta también platica frecuentemente con\nToritani.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Tiene un aspecto amable, pero también algo triste.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Quizás venga siempre a este local buscando conversación con alguien.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0010",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000007",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Fue gracias a que esa muchacha me habló que comencé a venir acá.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"La clienta comienza a hablar mientras observa el café moviéndose dentro de su\ntaza.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000008",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“No podré olvidar jamás el sabor de aquella taza de café que me regaló esa\nvez... Realmente estoy agradecida con ella. Pero...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000009",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“La verdad es que yo no debería estar aquí...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000010",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“De verdad... soy un fracaso como madre... lo fui hace tiempo, y lo sigo siendo\naún.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"No es bueno andar conectando todo lo que sé con otras cosas. Pero esta\nmujer... ¿No se parece un poco a la niña de hace un rato?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, disculpe.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0011",head="kir_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000011",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Eh, ¿puedo ayudarte en algo?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bgm",stop=1,time=100},
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0007",head="kir_z2a",lv=5,id=9},
{"fgact",ch="霧乃",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000012",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"La clienta alza sorprendida su cara, y su pacífica expresión cambia\nsúbitamente.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Disculpe?...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"se",file="se3214",id=1},
{"bgm",file="bgm108"},
{"fg",ch="霧乃",size="z1",my=40,mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"La clienta se para de repente frente a mí mientras yo permanecía con una\nexpresión de sospecha.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_krd_000013",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“L-Lo siento... recordé, que debía hacer algo...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="霧乃",mx=-40,mode=-1,lv=4,id=9},
{"se",file="se2225",id=1},
{"text"},
text={
ja={
{
"Al dejar unas cuantas monedas sobre la mesa, la mujer bajó la cabeza en señal\nde agradecimiento y salió frenéticamente del local.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Frente al local había un automóvil negro parado que hasta hace rato no estaba.\nSe me hizo parecido al vehículo de la mujer con la cual la directora estuvo\nhablando hace poco.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Justo al yo salir de Quimera el vehículo comenzó a acelerar. En el asiento de\ncopiloto estaba la clienta, mientras que en el asiento de piloto estaba la\nmujer que estuvo hablando con la directora.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Ya es la segunda vez que veo a esa mujer... Ya es demasiado como para llamarle\ncoincidencia, y esto me está empezando a llamar la atención.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Me grabo rápidamente en mi cabeza el número de la placa y regreso de inmediato\na Quimera.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002205",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Toritani, quien hasta hace poco estaba en la cocina, no se dio cuenta de mi\nconversación con la clienta, ni tampoco de la presencia del automóvil que\nestaba parado frente a Quimera.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo fui a ver algo que me causaba curiosidad.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Mientras digo eso tomo un bolígrafo que había en la barra y copio el número de\nla placa del coche en la parte vacía de la factura.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Toritani arruga la frente al verme haciendo eso.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002206",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi... No estarás tratando de meter las narices en algún otro asunto raro\npor ahí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún no sé si lo haré.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002207",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que aún no lo sabes?...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No miento, realmente no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Me dirijo a la mesa donde aquella clienta estaba sentada hasta hace un rato.\nLas monedas seguían allí.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Pensé que Toritani metería las monedas en la caja. Sin embargo, las insertó en\nun enorme frasco de vidrio que estaba sobre la barra.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"El frasco tenía una nutrida cantidad de monedas adentro.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, eso es...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002208",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, ¿esto? Me he cansado de decirle que la taza de café va de mi parte, y aun\nasí, desde que le invité aquella primera taza ha estado pagando todas las\ndemás, así que ahora estoy guardando el dinero acá.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002209",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya le he explicado una y otra vez que lo que le estoy sirviendo son las mismas\nmuestras de café que has probado tú también, pero igual no me presta\natención...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es cierto lo de que le invitaste a una taza de café?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002210",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... bueno.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Toritani ve al vacío, con una mirada un tanto nostálgica.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"msgoff"},
{"bg",file="zbluesky_summer",style="gray",speed=180000,id=9,lv=9,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002211",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me parece que aquel día todavía seguían las vacaciones de primavera. Yo estaba\nrepartiendo folletos frente a la estación.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Panfletos? ¿Panfletos de este local?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002212",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, buscaba atraer más clientes. En los panfletos escribí 'valido para un café\ngratis'. Por supuesto, tuve la autorización de la dueña.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"colortone",style="gray"},
{"bg",y=-550,x=150,file="zbg013f",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="霧乃",size="z2",mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002213",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La señora tenía... un rostro realmente triste, y estaba algo pasmada... Por más\nbuses que vinieran, se quedaba sentada en el banco de la parada, sin ponerse\nde pie...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002214",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A pesar de que era primavera y de que habían personas a su alrededor, su rostro\nera el mismo que tendría alguien abandonado en un páramo desierto, y me dio\nuna mala sensación.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una mala sensación?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002215",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. En fin... no pude dejarla pasar de largo. Tenía una cara terrible cuando la\nvi. Y además, dicen que incluso el más casual de los encuentros puede ser\nobra del destino, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mx=-40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0910",face="a0003",head="mak_z2a",x=-345,lv=5,id=5},
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0007",head="kir_z2a",lv=5,id=9},
{"fg",ch="霧乃",speed=500,mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0007",head="kir_z2a",x2=0,x=345,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0004",head="mak_z2a",x=-345,lv=5,id=5},
{"fgact",ch="真琴",act="うなづく",lv=5,id=5},
},
vl02={
{"bg",style="gray",time=1000,file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",ch="真琴",size="z1",style="gray",time=1000,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",style="gray",time=1000,mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002216",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le entregué un panfleto, hablé un poco con ella y me la traje a Quimera. Tenía\nel panfleto especial con ella, así que tampoco es que precisamente le brindé\nel café.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"msgoff"},
{"colortone",style="reset"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=5,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre te la pasas diciendo que soy un entrometido, aunque tú no te quedas\natrás, eh.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002217",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues... no lo voy a negar, al menos en este caso.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002218",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, no podía dejarla sola, y para ser sincera, no quería sentirme mal\ndespués por no haber hecho nada.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002219",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No actúo tanto por bondad como lo haces tú.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como yo?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002220",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto. Siempre estás metiendo demasiado el hocico en los asuntos de los\ndemás, y conociendo a mucha gente en el proceso. Realmente eres todo un caso.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees que sea así?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo es!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque sí, bueno, puedo entender que esa mujer te llamara la atención.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Quizás ella misma esté absolutamente inconsciente al respecto, pero sabe usar\nmuy bien su debilidad para atraer la atención de los demás.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"No hay bondad ni maldad en eso. Si lo ponemos de esta forma, se podría decir\nque es su manera propia de sobrevivir en este cruel y duro mundo.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Si eso en realidad le está sirviendo para sobrevivir o no, es otra cuestión.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002222",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te dijo algo?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, dijo que no debía estar acá.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002223",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002224",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes algo, Kusanagi? A mi parecer, sacrificarse por alguien no es algo que\ncualquiera pueda hacer.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002225",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es algo que requiere de bastante fuerza, y según yo pienso, aquellos que no\nposeen esa fuerza no pueden, de ninguna forma, intentar eso.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002226",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si personas así llegaran a intentar eso, todo terminaría en una simple\ndependencia, en autocomplacencia... o quizás en la propia ruina. Y lo mismo\npuede sucederle a una madre con sus hijos...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que ambos terminarían hundiéndose juntos?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="du",lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002227",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo... No estoy segura, pero me parece que esa señora tiene un hijo. No\nme ha contado mucho, pero parece que está criándolo ella sola.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, también dijo que era un fracaso como madre.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",size=5,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002228",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Parece que realmente tienes algo en ti que hace a los demás querer\nrevelar sus debilidades, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te refieres a lo del cuento del héroe?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="du",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002229",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Eso mismo.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002230",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... La carga económica y psicológica que tiene como madre soltera es grande. Y\nademás, está cargando con otro gran problema que desconozco.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002231",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De no ser así, no pondría esa cara de ninguna forma.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"El rostro de Toritani se ensombrece.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Lo que Toritani está recordando ahora es, seguramente, la desesperanzada\nexpresión que tenía aquella mujer cuando decidió hablarle sin pensarlo dos\nveces.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002232",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La vida de esa señora sigue, y seguirá. Y es por eso mismo que necesita por lo\nmenos un momento en el día para tomarse aunque sea una taza de café.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002233",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... A pesar de que su niño esté esperando en algún lugar, solitariamente, su\nregreso.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002234",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sinceramente, no sé qué sería lo correcto o no en este caso. Por mi parte, lo\nque suelo hacer generalmente termina mal.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002235",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y es por eso que no me parece que lo que está haciendo esté bien. Pero, aun\nasí, quiero que se relaje junto a una taza de café.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me parece que eso es lo mejor. Y además...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su hijo debe entender eso muy bien. Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002236",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002237",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero un niño que deba tragarse todos sus deseos por entender el sufrimiento de\nsu madre es, seguramente, infeliz.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Pero, dar un paso temprano a la adultez para ayudar a un ser\nquerido para uno no es algo tan infeliz, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002238",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=5},
{"fgact",ch="真琴",act="うなづく",lv=5,id=5},
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Toritani coloca una taza de café sobre la barra.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0003",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002239",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí está el café de hoy.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0002",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002240",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dime qué quieres comer. Lo contaré como parte de la comida de los empleados,\nasí que puedo preparar lo que quieras.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un gyuudon, entonces.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0016",head="mak_z2d",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002241",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sabía que pedirías eso.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"se",file="se9052",id=1},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Toritani puso un enorme bol de gyuudon tamaño especial frente a mí.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002242",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay mucho espacio en el fondo, si te quitas el delantal puedes comer aquí.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_002243",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y otra cosa, el café de hoy no es de las muestras que siempre manda la dueña,\nson granos de nuestra colección. Ah, pero igual quisiera tu opinión.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Del gyuudon?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002244",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Del café.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre es lo mismo... Lo único que te puedo decir es si está bueno o no.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0028",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002245",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No importa, me conformo con eso.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002246",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bébelo, dame tu opinión y regresa rápido a casa. Hay personas esperándote, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y dejarte sola a ti?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002247",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy bien así. Me siento en paz estando sola.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te ataca la soledad?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002248",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Pero esta soledad es también parte de lo que elegí para mí.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres fuerte...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002249",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Verdad que lo soy? Así que...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002250",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Respecto a lo del tema del héroe...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002251",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa con eso?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un héroe es capaz de escuchar los clamores de alguien en necesidad. Y por más\nlejos que esté esa persona, ese héroe volará a ayudarla.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso dijiste, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=5},
{"fgact",ch="真琴",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002252",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí, eso dije.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Últimamente he estado recordando con frecuencia lo que me has dicho.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que piense en eso las 24 horas del día. Solo que... de alguna forma, me\npareció que estabas a punto de decir 'no te preocupes por mí' de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002253",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijiste que no era momento de estar pendiente de ti. De que no era bueno,\npuesto que acabarías haciéndote falsas ilusiones.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo creo que eso no es ninguna ilusión.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002254",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Toritani dio un pequeño suspiro, y luego susurra, silenciosamente, como si\nestuviera hablándose a sí misma.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002255",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me gusta mucho la manera en que a pesar de ni saber lo que dices llegas a tu\nsupuesta respuesta correcta, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002256",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002257",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dame caramelos.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Al verme con las manos extendidas, Toritani puso una expresión un tanto\nexasperada y cansada. Me dio tantos caramelos que por poco se me caen de las\nmanos.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg005c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Tal como lo pensaba.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"se",file="se2497",vol=50,id=1},
{"text"},
text={
ja={
{
"Le echo una ojeada a las copias de los documentos que tengo en mis manos. Lo\nque era hasta ahora solo una idea pasó a convertirse en certeza.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Con 'documentos' me refiero a unos anuarios empresariales que le pedí a Ai.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Los anuarios empresariales muestran el capital y el número de empleados de\nvarias empresas, así como las tendencias en logros empresariales y ránkings\npor campo empresarial. Así que no están nada mal como para averiguar\nrápidamente la información pública de cualquier empresa.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Las copias que tengo en mis manos no son solo del anuario de este año.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Le pedí a Ai copias del anuario de este año, así como de los años previos y\nposteriores a cuando Kenichiro Kusanagi entró como profesor al colegio\nYumihari, así como una copia del año en el cual la directora se apropió del\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"A pesar de ser una familia de un nivel tal que fueron capaces de arreglar un\nacuerdo matrimonial con la familia Nakamura, al ver esto puedo entender cómo\nes que no se me vino nada a la mente cuando escuché el apellido 'Toritani'.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Toritani. Son una compañía de comercio que se ha mantenido desde la era Meiji\nhasta el día de hoy.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"No tienen la omnipresencia ni la vistosidad que podrían tener las grandes\ncorporaciones de comercio general, pero han llevado una administración rígida\ny segura, y a veces algo atrevida. De no ser así, no habrían sobrevivido hasta\nahora.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Al día de hoy no es ni la sombra de lo que era antes.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Me parece más bien increíble que no hayan entrado en bancarrota. Es difícil\npoder llevar un negocio en esta región con la bota de los Nakamura encima.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_04_1"},
{"text"},
linkback="block_00178",
},
label = {
top={block="block_00000",label=1},
},
}
