astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"se",id=1,file="se2924"},
{"ex",time=600,func="wait"},
{"text"},
text={
vo={
{"vo",file="man_snp_000001",ch="snp"},
},
ja={
{
name={"Padre"},
"“Pase...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con permiso...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",id=1,file="gatya"},
{"cgdel",id=-1},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm106"},
{"text"},
text={
vo={
{"vo",file="man_snp_000002",ch="snp"},
},
ja={
{
name={"Padre"},
"“¿Tú eres?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gusto en conocerlo, soy Naoya Kusanagi, estudiante de tercer año del colegio\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_snp_000003",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ahh, ¿un alumno de Yumihari? Kusanagi-kun... Ehm, ¿alguna vez nos hemos visto?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, me parece que es la primera vez.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_snp_000004",ch="snp"},
},
ja={
{
name={"Padre"},
"“Hmm, ya veo... Ajajaja, creo que tanto tiempo viviendo hospitalizado me ha\nchiflado un poco. Me dio la sensación de que nos habíamos visto ya en alguna\nparte... Ajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Tanto tiempo viviendo hospitalizado...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"A pesar de decir eso, la clara manera de hablar del padre hacía parecer eso\nmentira.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_snp_000005",ch="snp"},
},
ja={
{
name={"Padre"},
"“Disculpa el abuso de tomarte tú tiempo, aun cuando ni siquiera nos conocemos...\nAunque dejando eso de lado, viniste por algo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... ehm...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_snp_000006",ch="snp"},
},
ja={
{
name={"Padre"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"El padre Masada observa mi cara fijamente.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Y entonces, susurró, como si lo hubiera entendido todo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_snp_000007",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ah, claro... así que de eso se trata...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_snp_000008",ch="snp"},
},
ja={
{
name={"Padre"},
"“No, solo que creí que mi larga estancia en el hospital me había terminado de\ndañar la cabeza, pero al parecer no fue así...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quiere decir?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_snp_000009",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ah, no es nada, son solo cuestiones mías. Y bien, ¿a que se debe tu visita?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Padre, ¿conoce usted a las hermanas Akashi?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_snp_000010",ch="snp"},
},
ja={
{
name={"Padre"},
"“Por supuesto. Komaki Akashi-san y Kosachi Akashi-san. Ambas me han estado\nayudado bastante.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué relación tienen con usted, padre?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_snp_000011",ch="snp"},
},
ja={
{
name={"Padre"},
"“Son unas muchachas muy amables. Han estado encargándose de la iglesia del\ncolegio durante mi hospitalización... Aun cuando yo debí haber dejado la\niglesia ya...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Su hospitalización es muy larga?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_snp_000012",ch="snp"},
},
ja={
{
name={"Padre"},
"“Pues sí. No sé cuándo pueda ser dado de alta. La verdad es que, en principio,\nno puedo dejar desocupada la iglesia por siempre...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su operación...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_snp_000013",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ajaja, así que estás enterado. Mi tercera operación está planificada para\nmañana...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso escuché...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las hermanas Akashi... saben eso, ¿cierto?...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_snp_000014",ch="snp"},
},
ja={
{
name={"Padre"},
"“Sí, saben que esta será mi tercera operación...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"El padre Masada está mucho más delgado a como se veía en sus fotos en la\niglesia.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Son pocas las enfermedades en las cuales el paciente adelgaza de esta manera, y\nque además se vea obligado a recibir varias operaciones...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Probablemente es la misma enfermedad que papá...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_snp_000015",ch="snp"},
},
ja={
{
name={"Padre"},
"“Los pronósticos no son muy buenos. Aunque bueno, parece que por mi edad, su\navance ha resultado lento, pero... por el otro lado, también está la\nposibilidad de que se alargue.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es prueba de lo fuerte y enérgico que está usted. No cualquiera aguantaría\ntantas operaciones con su edad...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy completamente seguro de que mejorará con la próxima operación.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_snp_000016",ch="snp"},
},
ja={
{
name={"Padre"},
"“Fufufu... eres muy amable. Aunque sí, creer que de verdad en la próxima\noperación mejoraré es lo que me he ayudado a resistir hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, le deseo éxito y bastante fuerza.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_snp_000017",ch="snp"},
},
ja={
{
name={"Padre"},
"“Y bien, no solo viniste por eso, ¿no? ¿Qué viniste a preguntarme?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoce usted a un hombre llamado Wataru Akashi? Es el hermano mayor de las\nhermanas Akashi.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_snp_000018",ch="snp"},
},
ja={
{
name={"Padre"},
"“Sí, por supuesto. Es el jefe del club de arte. Ah, ahora que lo recuerdo, ya\ndebe estar graduado...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, aún no se ha graduado.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_snp_000019",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ohhh, ¿de verdad?... Aunque bueno, no es de extrañarse, al parecer ha\nalborotado el colegio numerosas veces. Tiene toda una larga vida por delante,\nno está de más desviarse un poco antes de seguir emprendiendo el camino, ¿no\nte parece?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí... Se podría decir eso también...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_snp_000020",ch="snp"},
},
ja={
{
name={"Padre"},
"“Solía platicar muy a menudo con él acerca de arquitectura. Sus conocimientos en\nel arte eran bastante profundos, me divertía bastante. Yo también aprendí\nmucho con él.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, él es de esos que se ensimisma e investiga todo lo que le provoca interés.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"cgdel",id=-1},
{"bg",time=1000,file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="man_snp_000021",ch="snp"},
},
ja={
{
name={"Padre"},
"“Hay algo que debo darte... Lo siento, ¿podrías pasarme la carpeta que está en\nese estante?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Al decir eso, el padre señaló una gruesa carpeta que estaba en el estante al\nlado de la cama.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_snp_000022",ch="snp"},
},
ja={
{
name={"Padre"},
"“Tenía que darte esto. En mi testamento preparé todo para que llegara a tus\nmanos cuando yo muriera, pero quería entregártelo personalmente, de ser\nposible, así que realmente me alegra poder hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedo ver lo que hay adentro?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_snp_000023",ch="snp"},
},
ja={
{
name={"Padre"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Tomo la gruesa carpeta en mis manos. Parece que hay una gran cantidad de\ndocumentos adentro, pues está bien pesada.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",y=20,speed=80000,file="zbg067a",path=":bg/",x2=230,y2=20,x=-50,ax=1920,ay=1126,bx=-960,by=-586},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Mis ojos se quedan clavados en las primeras páginas.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_snp_000024",ch="snp"},
},
ja={
{
name={"Padre"},
"“Sí, por supuesto, esa herencia te pertenece a ti.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Akashi tomó una copia de esto?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_snp_000025",ch="snp"},
},
ja={
{
name={"Padre"},
"“Realmente lo siento. Me pidió el favor muy insistentemente. Aun cuando en\nprimer lugar debí haber discutido eso antes contigo...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, se equivoca. Para ese entonces papá aún seguía vivo. Seguramente papá le\ndijo a usted que hiciera lo que quisiera con estas ilustraciones y planos de\ndiseño...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pudo regresárselos a papá mientras aún seguía con vida, ni tampoco pudo\ndármelos a mí...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_snp_000026",ch="snp"},
},
ja={
{
name={"Padre"},
"“Jajaja... Eres tan brillante como tu padre.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que de verdad esa obra aún estaba incompleta...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_snp_000027",ch="snp"},
},
ja={
{
name={"Padre"},
"“Así parece. Cuando regresó a Japón dijo que en algún momento la terminaría,\npero... ya eso se volvió imposible...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál fue la reacción de Akashi al ver esto?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_snp_000028",ch="snp"},
},
ja={
{
name={"Padre"},
"“Estaba muy emocionado. Silenciosamente, sí, pero con toda certeza... Justo como\nestás tú ahora...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_snp_000029",ch="snp"},
},
ja={
{
name={"Padre"},
"“Tengo muchas cosas que debo contarte.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, disculpe, pero no pienso quedarme a escucharle.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_snp_000030",ch="snp"},
},
ja={
{
name={"Padre"},
"“P-Pero, tu padre...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tiene algo que decirme, entonces volveré a visitarlo después de su\noperación. En ese momento me encantaría escucharle. Escuchar las historias de\nmi padre, Kenichiro Kusanagi, y de usted, señor padre...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_snp_000031",ch="snp"},
},
ja={
{
name={"Padre"},
"“Kukuku... me has ganado una. Me has obligado ahora a regresar con vida de mi\npróxima operación, pase lo que pase...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Komaki y Kosachi también están esforzándose bastante, teniendo fe\nen ello... Padre, espero que pueda darlo todo en su operación. Le deseo\nsuerte.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="man_snp_000032",ch="snp"},
},
ja={
{
name={"Padre"},
"“Te pareces...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A papá?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_snp_000033",ch="snp"},
},
ja={
{
name={"Padre"},
"“Realmente fue toda mi culpa el no poder haber asistido a su funeral...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Considerando su enfermedad, era inevitable eso.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ambos estuvieron en el mismo hospital, así que me imagino que habrán\nhablado varias veces, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_snp_000034",ch="snp"},
},
ja={
{
name={"Padre"},
"“Sí, varias veces pude hablar con él. Aunque no esperábamos reencontrarnos\nhospitalizados ambos, en la misma clínica... jajaja.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con toda seguridad usted se mejorará, padre. Por eso mismo no pudo asistir al\nfuneral de papá, me imagino.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tratándose de él, seguramente le estará pidiendo 'Venga a mi tumba con sus\npropios pies', donde quiera que esté ahora.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_snp_000035",ch="snp"},
},
ja={
{
name={"Padre"},
"“Ajajaja... Tratándose de él, no es nada descabellado pensar eso...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, le agradezco por esto. Le daré muy buen uso.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_snp_000036",ch="snp"},
},
ja={
{
name={"Padre"},
"“Naoya Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_snp_000037",ch="snp"},
},
ja={
{
name={"Padre"},
"“Gracias. Me esforzaré mañana.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, mejórese, por favor.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bgm",stop=1,time=1000},
{"se",id=1,file="gatya"},
{"bg",file="black",path=":bg/"},
{"bg",file="bg066a",path=":bg/"},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Ya lo había previsto en parte, pero...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Vuelvo a echarle un ojo a la parte de la herencia de Kenichiro Kusanagi que\nrecibí del padre.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está muy bien pensado esto... pero...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Ciertamente, es imposible terminarla solo con esto.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Faltan aún muchas cosas.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Realmente estaba incompleta, en el más puro sentido de la palabra. Incluso el\nmismo Kenichiro Kusanagi hubiera requerido de una gran cantidad de documentos\npara terminar esto.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Incluso si se tratara de él, hubiera necesitado una enorme cantidad de tiempo\npara terminar esta obra.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Y en realidad, no solo el plano de diseño final, sino también varios diseños\nfallidos e ideas adicionales están incluidas en esta carpeta.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Se pueden observar rastros de como incluso en la etapa final de diseño estuvo\nindeciso entre diversas ideas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una labor que le llegó a causar trabajo hasta a el mismo Kenichiro...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suponiendo que hubiera que terminar toda esta labor en un solo día...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Entonces los preparativos preliminares para ello deberían ser bastante\nminuciosos, detallados, y llevados a cabo con mucha cautela.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Si no se trata del diseñador, Kenichiro Kusanagi, sino de alguien más quien\nestá tratando de terminar todo esto en un solo día, entonces...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... La razón por la cual él retrasó su graduación... Parece que no era\nsolo por la operación del padre...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Es bastante descabellado pensar que él sea capaz de hacer algo solo por caridad\no benevolencia...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque el padre no hubiera sido hospitalizado, quizás hubiera retrasado su\ngraduación de igual manera... Él es esa clase de hombre...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000138",ch="ksd"},
},
ja={
{
name={"???"},
"“¡Eh! ¡¿Qué haces tú aquí?!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000127",ch="kmd"},
},
ja={
{
name={"???"},
"“Oh, vaya, pero si es Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="小沙智",size="z1",mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0100",face="a0012",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las hermanas Akashi...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0006",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000139",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Tú! ¿Qué haces aquí? ¡Ah! ¡Entonces sí tienes los ojos puestos en Komaki! Ya\nse me hacía que estabas pululando mucho a los alrededores de Komaki. ¡Así que\nrealmente eres su stalker!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000128",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Te equivocas, Kosachi-chan.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0007",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000140",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡¿Cómo puedes decir que estoy equivocada?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000129",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Estuviste visitando al padre, ¿verdad? Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000130",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es para que me agradezcas, realmente. Simplemente fui porque tenía algo que\nhacer...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000131",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Claro que sí. Estoy segura de que el padre se alegró bastante.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Escucha, Komaki.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0007",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000141",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Pero q--! ¡¿Por qué estás llamando a Komaki por su nombre, y además sin usar\nhonorífico?!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres que haga? Todas ustedes son Akashi...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0012",head="kom_z1a",x=345,lv=4,id=6},
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000132",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya tengo una buena idea de cuál es la relación entre Akashi y el padre...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, hay una última pregunta que quiero hacerte.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0008",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000133",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Cuál es esa pregunta?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kosachi me contó... me contó que cuando eran pequeñas, el padre te salvó.\nEmocionalmente...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000134",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí. Sin duda alguna, el padre me salvó.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podrías hablarme... acerca de la relación entre ustedes y el padre?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000142",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“K-Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000135",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Estará abierta la azotea?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debería estar abierta... puesto que hace tiempo un cierto idiota iba con\nfrecuencia a fumar allí...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0013",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000136",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Un cierto idiota?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, solo hablaba solo. La azotea en verano es bastante calurosa, te vas a\nsecar.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bgm",stop=1,time=1000},
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bg065a",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000137",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Waah, hace muy buen clima... No creo que me seque con este viento tan\nplácido... Realmente se siente muy bien.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace bastante sombra en las horas tempranas de la mañana...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Subimos todos juntos a la azotea del pabellón viejo del Hospital General\nYumihari.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Es la primera vez que entro acá, aunque en la azotea habían unas enormes\nparedes triangulares que servían de cubierta contra el sol.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Cada una tenía un enorme vidrio insertado adentro, y se me hizo similar a la\ncapilla de una iglesia.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso quiere decir, que si llegara a pasar la luz por acá...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000138",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo pensé que desde esta ventana se puede ver muy bien el colegio\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000139",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí. De acá se puede ver con bastante detalle el colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"El colegio Yumihari está del lado de la pared, así que a través de estos\nenormes vidrios se puede ver.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Komaki camina por el borde de la azotea.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000140",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“En la temporada de floración, se pueden contemplar las flores de cerezo de la\ncolina de Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. Aunque no es exagerado decir que casi todo el pabellón viejo de\neste hospital está construido sobre la colina de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Seguramente las flores de cerezo que se pueden ver desde acá son hermosas.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000141",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Aunque en la colina de Yumihari no se pueden ver flores de cerezo en pleno\nverano...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería anormal si florecieran cerezos en pleno verano...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000142",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Están las jugatsuzakura, las fuyuzakura, las shikizakura, las kobukuzakura...\nHay cerezos que florecen en estaciones distintas, y no por eso es raro.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás he escuchado de que florezcan cerezos sobre la colina de Yumihari en otra\nestación que no sea la primavera.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0016",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000143",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Tienes razón. Las jugatsuzakura, las fuyuzakura, shikizakura, kobukuzakura...\nDe lo que sé, jamás se han sembrado esas especies de cerezo por acá. Ni\ntampoco crecen naturalmente, o al menos no he escuchado nada al respecto...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces los cerezos que florezcan en verano estarían fuera de temporada...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000144",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí... supongo, que no hay cerezos que florezcan en verano...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0008",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000147",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Kusanagi-san, tú tampoco me creerías aunque te dijera que he visto los cerezos\nmilenarios, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las has visto?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000150",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí... He visto las flores de cerezo de verano.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que has visto los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0011",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000149",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No lo crees, ¿verdad?... Nadie en su normal juicio lo haría...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién sabe...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay cosas que se ven, aunque no queramos creer en ellas...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0012",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000148",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has visto alguna vez al sol elevándose por el este?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0005",head="kom_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000154",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, lo he visto. ¿A qué viene eso?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El sol se eleva a lo más alto, y luego se hunde en el cielo del oeste... Le da\nvueltas a estas tierras.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En todo momento observamos eso, pero, nadie pensaría que el Sol gira alrededor\nde la Tierra al ver eso, ¿no? Todos sabemos que la Tierra gira alrededor del\nSol.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="小沙智",size="z1",mx=-40,mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0005",head="kom_z1a",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000143",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No entiendo, ¿qué es lo que quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que vemos no es necesariamente lo que es. No necesariamente lo que vemos es\nla realidad como tal.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que no tengo razón alguna para negar el hecho de que hayas visto\neso. No sé si esos son los cerezos milenarios que vienen de las leyendas de\nYumihari o no, pero viste unas flores de cerezo enigmáticas, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000155",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Jaja... Dices algo completamente opuesto al padre.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue lo que dijo el padre?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0005",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000156",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Porque me has visto has creído? Dichosos los que no vieron, y sin embargo\ncreyeron.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conozco eso, ¿es de la biblia?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000157",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero vaya que lo conoces. Es el capítulo 20, versículo 29 del Evangelio de\nJuan. Es un versículo que relata parte de la resurrección de Cristo.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que lo conozca realmente, sino que lo único que un padre podría decir son\npalabras de la Biblia, ¿no?... Lo siento, pero de la Biblia no sé nada, así\nque no sé de qué tratan realmente esas palabras.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000158",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Es el relato del momento en que una persona llamada Tomás insistió en que no\ncreería en la resurrección de Cristo hasta que lo viera a él junto con las\nmarcas de la crucifixión.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, habla de la diferencia de aquellos que no 'creen' hasta no ver con sus\nojos y comprobar la verdad, y de aquellos que creen en la resurrección de\nJesús a partir de su fe...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000159",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Lo has entendido muy bien.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el momento en que viste los cerezos milenarios... ¿el padre te contó esa\nhistoria?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0010",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000144",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Nadie le creyó. Y peor aún, todos comenzaron a llamar 'mentirosa' a Komaki.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000160",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ajaja, también me pasa por insistir en que vi lo que vi. Pude haberme\nretractado al ver cómo los demás decían que no era posible y simplemente\ndecir que no vi nada...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0006",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000145",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Pero Komaki dijo que los había visto. Dijo que había visto unos cerezos que\nflorecieron en una noche de verano...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por eso comenzaron a acosarte y tratarte mal?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000161",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No me acosaron, pero...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0011",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000146",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“La tildaron de mentirosa...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0002",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000147_n",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“En aquellos momentos, lo que el padre nos dijo fue...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0003",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000148",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Creer en un milagro no significa verlo, ni escucharlo, ni estar allí o tener\nprueba certera de ello, es simplemente creer.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque sería ridículo creer en cualquier cosa, eh...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000149",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000162",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Espera, Kosachi-chan. Es tal cual.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000150",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Komaki.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0006",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000163",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Creer no significa ver, ni escuchar, ni estar en el lugar o corroborar algo de\nalguna forma... Es simplemente creer.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0007",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000164",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero eso no implica creer en cualquier cosa. No se trata de creer ciegamente,\nsolo para dejar de pensar. Creer para dejar de pensar es simplemente pereza.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creer en lo que está más allá de las palabras, en aquello que está más allá de\nlo descriptible con las palabras. ¿Es a eso lo que llaman fe?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000165",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, es más o menos así.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero el padre no creyó en tus palabras con la misma fe con la que cree en las\npalabras de Dios, ¿no? Si fuera así, entonces el 'capítulo 20, versículo 29\ndel Evangelio de Juan' estaría un poco desacertado.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000166",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000167",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“La verdad, no lo sé. No soy buena entendiendo lo complicado. Ciertamente, es\nmuy diferente creer en los milagros de Dios a creer en las palabras de una\nniña como lo era yo. Incluso yo misma puedo entender que, sin duda alguna,\nesas dos cosas son totalmente distintas.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0006",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000168",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero... pero... aun así, el padre nos otorgó esas palabras a nosotras dos.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco entiendo mucho la parte complicada del asunto. Lo único que puedo decir\nde mi parte, es que a final de cuentas, el hecho de que las personas crean en\nalgo no viene de una 'deducción' o una 'inducción', ni tampoco de alguna\n'evidencia' o 'refutación'.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las personas no conocen lo que es 'dudar' desde el momento en que nacen. De\nninguna manera alguien que no sepa 'dudar' puede 'creer'... Las personas\naprenden a 'dudar' por primera vez cuando aprenden a 'creer'.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El acto de creer nunca viene acompañado de ninguna certeza absoluta.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000169",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ajaja... lo que dices tú es mucho más difícil, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón... Traté de concluirlo todo de forma ingeniosa, pero fallé\nestrepitosamente en el intento...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Del hecho de creer en Dios a creer en tus palabras hay un gran brecha... pero,\nprobablemente son lo mismo. Probablemente son lo mismo, aun siendo\ndiferentes...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000170",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0015",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000151",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No entiendo nada...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000171",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No te preocupes. Lo que dijo Kusanagi-san fue tan complicado que yo tampoco\nentiendo nada ahora.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni yo.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0006",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000152",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡¿Pero qué pretendes hablando algo que ni entiendes?! ¡No hables tanto de algo\nque ni tú entiendes! ¡Sin querer me puse pensativa yo también!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, vamos. Pensar es algo bueno. A medida que piensas y dudas más es que\ndeberías poder entender lo que realmente es 'creer'.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="いいえ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000153",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Q-Qué dices?... Esas palabras tan sugestivamente profundas, las dijiste por\ndecirlas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién sabe...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, si siguen perdiendo el tiempo acá se les va a pasar la hora de las\nvisitas matutinas.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0017",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000154",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Fuiste tú quien nos tuvo aquí, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí. Fui yo quien las mantuvo aquí. Y con toda la responsabilidad que tengo\npor ello y siento ahora, les diré esto.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="小沙智",size="z2",mode=3,resize=1,path=":fg/kos/z2/",file="kos_z2a0100",face="a0012",head="kos_z2a",x=-345,lv=5,id=5},
{"fg",ch="小牧",size="z2",mode=3,resize=1,path=":fg/kom/z2/",file="kom_z2a0100",face="a0012",head="kom_z2a",x=345,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“VÁYANSE YA A DONDE EL PADRE.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z2/",file="kos_z2a0100",face="a0006",head="kos_z2a",x=-345,lv=5,id=5},
{"fgact",ch="小沙智",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000155",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡¿Pero qué te crees?!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0004",head="kom_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000172",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Vamos, vamos, Kusanagi-san tiene razón. Nos tenemos que apurar.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z2/",file="kos_z2a0100",face="a0008",head="kos_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000156",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡K-Komaki, tú también!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0003",head="kom_z2a",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0001",head="kom_z2a",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000173",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Kusanagi-san, muchísimas gracias. Y... te ruego por tu favor.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada por lo que me tengas que pedir favor...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0012",head="kom_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000174",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo simplemente haré aquello en lo que creo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0004",head="kom_z2a",x=345,lv=5,id=6},
{"fgact",ch="小牧",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000175",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z2/",file="kos_z2a0100",face="a0013",head="kos_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000157",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Esp-- ¿pero qué significa eso? ¿Porque solo tú pareces haber entendido,\nKomaki?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0003",head="kom_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000176",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Vamos, vamos, Kosachi-chan.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"se",file="se9012",id=1},
{"fg",ch="小牧",mx=-40,mode=-1,lv=5,id=6},
{"fg",ch="小沙智",mx=-40,mode=-1,lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Al conocer la duda, es que las personas pueden creer...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Y por creer, y querer creer, es que las personas dudan...",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso se trata, supongo...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bgm",stop=1,time=1000},
{"excall",file="02_abend_13_1",cond="f.rinroute==1"},
{"excall",file="02_abend_13_1",cond="f.rnaroute==1"},
{"excall",file="02_abend_13_1",cond="f.shzroute==1"},
{"excall",file="02_abend_pi06",cond="f.makroute==1"},
{"text"},
linkback="block_00230",
},
label = {
top={block="block_00000",label=1},
},
}
