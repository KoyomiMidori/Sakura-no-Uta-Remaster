astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg048g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se9045",id=1,vol=20,loop=1},
{"text"},
text={
ja={
{
"Tomo mis clases de la tarde.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El sonido de la tiza golpeando la pizarra, los lápices corriendo por los\ncuadernos y unos cuantos tosidos aclarando la garganta. Este colegio reúne\nuna gran cantidad de estudiantes de personalidad y carácter únicos. Pero\nigualmente, todos le prestan atención a las clases diligentemente.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"De repente, me doy cuenta de una pequeña sombra que se mueve al rabillo de mi\nojo, y volteo a ver por la ventana hacia afuera.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"... Esa es...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe, necesito ir al baño.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",stop=1,id=1,time=500},
{"se",file="se2308",id=2},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",zone="0x000000",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Hay algo de humo de cigarro elevándose en la azotea. Me acerco a la silueta de\nesa persona, parada allí.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"fg",ch="紗希",size="z1",time=1000,mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"ex",time=300,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000,sync=1},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"bgm",file="bgm002"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000056",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya, pero qué casualidad.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenas tardes...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000057",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué sucede? ¿Por qué estás acá en plena hora de clases?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me escapé.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000058",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Parece que perdió todas las ganas de tomarme el pelo después de mi respuesta\ntan descarada.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que usted fuma.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000059",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Algún problema con eso?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no realmente...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se puede ver muy bien desde acá la obra, ¿no le parece?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000060",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No estaba viéndola?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000061",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, lo estaba.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Uh.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Traté de llevarla a que dijera algo. Por supuesto, lo hice porque pensé que no\nrespondería tan fácilmente.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Sin embargo, la directora lo admitió con facilidad. De que estaba viendo esa\npintura...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000062",ch="htd"},
},
ja={
{
name={"Directora"},
"“Esa obra me salvó el puesto como directora...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Su puesto?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000063",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, y por eso tengo que agradecerte. Gracias.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé por qué, pero no parece ser un agradecimiento del cual debería\nregocijarme mucho, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000064",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Así te parece? Quizás sí deberías.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000065",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me cuesta algo responder a ese por qué, pero bueno... Siempre es conveniente\nvenderle favores a aquellas personas con poder. A eso me refiero.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"La máxima autoridad de un ente educativo se refiere a sí misma ahora como 'una\npersona con poder'...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Pero vaya, qué cosas...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me agrada mucho eso...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000066",ch="htd"},
},
ja={
{
name={"Directora"},
"“Eres joven, eh.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues comparado con una señora como usted, sí.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0012",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000067",ch="htd"},
},
ja={
{
name={"Directora"},
"“A una directora no se le dice 'una señora como usted'. Voy a expulsarte,\nmuchacho.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad cree que pueda expulsarme por una razón tan absurda? Es ridículo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000068",ch="htd"},
},
ja={
{
name={"Directora"},
"“Por eso te digo que eres un jovencito. Puedo hacerlo, solo con proponérmelo...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000069",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y con más facilidad aun, tratándose de alguien que solo vela por sus propios\nintereses como yo.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se preocupa por ocultar nada, puedo ver.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000070",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Así te parece?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pareciera estar incluso divirtiéndose.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000071",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Ya veo. ¿Crees tener buen ojo para ver a los demás?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Por lo general solo vivo de ideas y ocurrencias.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000072",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Pretendes que yo crea eso?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy bueno tirándome los faroles.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000073",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Jeje.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad parece estar divirtiéndose.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000074",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, siento que llevo tiempo sin hablar de esta forma con alguien.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Siempre está en lo mismo de lo que mencionó aquella vez en la dirección?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000075",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, así es. Aquella vez estabas realmente agitado. Aunque hoy pareces estar más\nsereno.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que aquella vez, sí.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En aquel momento, usted mencionó que los adultos son astutos y maliciosos. No\nlo voy a negar, en aquel momento yo pensé lo mismo... pero...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las personas maliciosas no se toman la molestia de llamarse a sí mismos como\ntal... ¿Me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000076",ch="htd"},
},
ja={
{
name={"Directora"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esas palabras... ¿No fueron esas palabras una expresión de confianza a su\nmanera? Después de haber tenido que doblegar forzosamente nuestras\nintenciones, aquellas del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"La directora suelta lentamente el humo de su boca y mete el cigarro en un\ncenicero portátil, aplastándolo.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000077",ch="htd"},
},
ja={
{
name={"Directora"},
"“Digamos que estás parcialmente correcto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo parcialmente?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000078",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, aunque es acertado lo que dices. No me sorprende que lo sea, viniendo de\nalguien que ha vivido en medio de conflictos entre adultos desde niño.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"¿Desde niño...? ¿La directora conoce mi historia previa a mi ingreso al\ncolegio?...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"¿Qué hago? ¿Trato de seguir pisando terreno? Aunque, pareciera ser un anzuelo\ndemasiado obvio.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"No lo sé. Me faltan más elementos para poder saber bien qué decisión tomar.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Así que por los momentos, me guardo la duda que me surgió en la cabeza y\nprosigo con la conversación.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Le parezco un joven sin inocencia alguna?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",size=10,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000079",ch="htd"},
},
ja={
{
name={"Directora"},
"“No, no me refiero a eso. Pero, para serte sincera, me preocupas.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000080",ch="htd"},
},
ja={
{
name={"Directora"},
"“A mi parecer, no era nada necesario que conocieras tanto el mundo de los\nadultos a esta edad. Aún eres un estudiante.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0009",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000081",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Aunque sí, supongo que la misma vida permitió eso...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Voy pisando más terreno, prudentemente, buscando por más en esas palabras que\nmuy obviamente me insinúan algo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... De lo que estoy escuchando, pareciera usted saber bastante, ¿o me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000082",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sé unas cuantas cosas. Pero lo mismo se podría decir de ti, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"se",file="se9051",id=1},
{"text"},
text={
ja={
{
"La directora le prende fuego a un nuevo cigarro. Después de aspirar lentamente,\ndespide el humo hacia el cielo, haciendo ese sonido característico al\nexhalar.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000083",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y bien, ¿qué viniste a preguntarme? Estaba casi segura que venías a revisar las\nrespuestas que tenías ya elaboradas de tu parte.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000084",ch="htd"},
},
ja={
{
name={"Directora"},
"“Por ejemplo, acerca de este colegio, acerca de mí, de tu padre y de ese mural.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="紗希",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="紗希",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2b0000",face="b0001",head="sak_z2b",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_htd_000085",ch="htd"},
},
ja={
{
name={"Directora"},
"“O por ejemplo, acerca de como siendo directora de este colegio, tengo el\napellido Toritani.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Señora directora, usted es la madre de Toritani, ¿cierto? Fue hace poco que lo\nsupe.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000086",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me sorprende que no lo supieras sino hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000087",ch="htd"},
},
ja={
{
name={"Directora"},
"“Toritani es el apellido de mi familia. Al casarme, me volví Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"La directora tira su mirada un tanto a la lejanía.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2b0000",face="b0010",head="sak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000088",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí... Fue hace 18 años.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Hace 18 años... Se refiere a la época en la cual Kenichiro Kusanagi realizó la\ngran reforma de aquella iglesia.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2b0000",face="b0002",head="sak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000089",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sabes que el colegio Yumihari era originalmente de la familia Nakamura, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, conozco un poco al respecto...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2b0000",face="b0009",head="sak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000090",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Sabías algo? Este colegio lo asalté y se lo arrebaté a los Nakamura.\nEliminándolos de su propio territorio...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Después de eso se divorció?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000091",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí. Si no lo hubiera hecho, mi hija hubiera terminado como Makoto Nakamura.\n¿Tal vez te hubieras dado cuenta de varias cosas de haber sido así?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sabría decirle. Parece que soy un poco torpe, y además, Nakamura es un\napellido bastante común. No es raro verlo por ahí.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0010",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0011",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000092",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sería difícil considerarlo simplemente de 'común' teniendo a alguien de ese\napellido justamente en este colegio. De alguna u otra forma terminarías\nconectándola con 'ese' Nakamura. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000093",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y además, más aún tratándose de alguien como tú, con el apellido Kusanagi. Tu\nfamilia y los Nakamura tienen una relación bastante intrincada, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un poco...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2b0000",face="b0009",head="sak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000094",ch="htd"},
},
ja={
{
name={"Directora"},
"“Un poco, eh...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2b0000",face="b0002",head="sak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000095",ch="htd"},
},
ja={
{
name={"Directora"},
"“Oh, vaya.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Me doy cuenta de que la mirada de la directora se dirije a mis espaldas y\nvolteo.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani estaba viniendo directamente hacia acá.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_htd_000096",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya, vaya.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Toritani ignora el susurro de la directora, y me habla.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",file="se9004",id=1},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=0,lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001928",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Volvamos. Estamos en hora de clases.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_htd_000097",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué es lo que sucede? ¿No te agrada la idea de que la directora hable con uno\nde sus estudiantes, Toritani-san?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0006",head="mak_z2a",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
delay={
[1000]={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=0,lv=5,id=9},
},
},
text={
ja={
{
"Los hombros de Toritani se sobresaltaron ligeramente. Desliza su mirada\nlentamente hacia la directora, y responde con una voz serena.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001929",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Procure dar usted el ejemplo como directora que es, Directora Toritani. Estamos\nen plena hora de clases.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Lo dijo de una forma calmada... no, tampoco. Podría decirse que fría. Demasiado\nfría como para ser una conversación entre madre e hija.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000098",ch="htd"},
},
ja={
{
name={"Directora"},
"“Fuu, está bien, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"La directora levanta ligeramente sus manos. Ante ese jocoso 'manos arriba',\nToritani frunció muy ligera, pero claramente, su ceño.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001930",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Espera.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",mode=-2},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Al agarrar mi muñeca, Toritani sale caminando a pasos grandes de la azotea,\ncasi como arrastrándome.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Al voltear de reojo a ver a la directora, esta movió su mano hacia los lados,\ncon pequeños movimientos.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"... Pensé en lo sencillo que podría ser fingir no haber visto nada, aun cuando\nlos labios de la directora se movieron ligeramente, todavía con su cigarro en\nla boca.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="black",path=":bg/"},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Toritani va caminando con fuerza. Sin decir nada, y sin soltarme.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Comencé a pensar en lo suave que era la mano de Toritani agarrando mi muñeca.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="bg047a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2c0100",face="c0001",head="mak_z2c",lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001931",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001932",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, la mano.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fgact",ch="真琴",act="びっくり",lv=5,id=6},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001933",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Ah!!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0013",head="mak_z1a",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani se detiene de repente, soltando mi muñeca y alejando su mano,\nalterada, como si por fin mi voz la hubiera alcanzado.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001934",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Perdóname! ¿Te dolió?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"La cara de Toritani, disculpándose ahora conmigo mientras me sobo suavemente la\nmano, no parece tener muy buen aspecto. No sé cómo debería reaccionar ante\nesa cara...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no duele...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001935",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Menos mal...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Toritani se muestra aliviada. Una sensación indescriptible me azota ante esa\nexpresión de alivio.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Es igual al momento en que surgió el tema de modelar desnuda.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"En mi caso, más bien se me subieron los ánimos y no he podido pararme en el\nmismo terreno que Toritani. No he considerado con seriedad su propuesta.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Eso me trae algo de incomodidad.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Aun cuando no hace falta que se tome todo tan a serio, tan a pecho...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Sin embargo, no me parece bien del todo compartir los mismos sentimientos de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Así que, por los momentos... digo lo que se me vino a la mente.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No dolió, más bien se sintió suave, o mejor dicho, se sintió bien...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001936",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿O-Otra vez... con eso?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Al dar mi más honesta apreciación, Toritani se conmociona.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y disculpa que venga de nuevo con 'eso', aunque bueno, de 'eso' va el tema.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001937",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"La mirada de Toritani se desvía a los lados.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001938",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Hay un cosquilloso silencio ahora, distinto a ese imponente y violento silencio\nque había mientras me trajo agarrado de la muñeca hasta acá.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001939",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¡Ahh, rayos!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Toritani baja la cabeza ligeramente, y se desordena violentamente el flequillo.\nSu cara, oculta ahora por sus delgados brazos, estaba un tanto enrojecida.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011h",head="mak_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001940",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No sé de qué forma interpretar todo lo que haces.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008h",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011h",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001941",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A pesar de siempre fingir desinterés y poner una cara de no importarte nada,\nsiempre metes el hocico en todo aquello en lo que no quiero que te metas...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010h",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001942",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y aun así, eres tan evasivo... No sé si realmente te das cuenta o no de lo\nmucho que me altero... Esa manera de actuar tuya es muy desagradable.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017h",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001943",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tienes algún problema, puedes hablar conmigo para ayudarte a resolverlo. Aun\nasí como me ves, me considero a mí mismo como un hombre útil.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001944",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"La expresión de Toritani va calmándose poco a poco. Me dio lástima ver cómo el\nrojo de sus mejillas también iba diluyéndose.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001945",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso ya lo sé, desde hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001946",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero... no pasa nada. De verdad. Y es que--”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001947",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya absolutamente todo se acabó.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001948",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O tal vez, debería decir mejor que ya todo se había acabado antes de empezar.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001949",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nada sucedió. Nada comenzó. Y por eso, quizás decir que ya todo se acabó no sea\nmuy preciso.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=6},
{"text"},
text={
ja={
{
"Toritani me ve fijamente.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001950",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Es esa misma mirada', pensé. Pense que era esa misma expresión con la cual\nestuvo observando ese 'algo más' mientras tenía sus ojos puestos sobre el\nmural.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Esta vez, esa mirada me atraviesa a mí, observando algo tras mí.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Sin embargo, esa mirada es claramente distinta a la que tuvo mientras veía el\nmural. Es una mirada más pura, y más hermosa.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001951",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí, creo que todo está bien.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Toritani murmura sola, como si hubiera llegado a una conclusión por sí sola.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001952",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya se acabó. Para mí, eso es lo más importante.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0016",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001953",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa que te diga cosas tan extrañas, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente no me importa. Y además, esa es también una forma de hablar\nacerca de tus problemas, ¿no? Si tenerme aquí escuchándote te aligera el peso\nsobre tus hombros, con eso me es suficiente.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001954",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hablar de mis problemas... Sí, tienes razón. Si a pesar de no solucionar nada\nlogro sentirme aliviada, entonces quizás solo hablar de ello sea una\nsolución.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001955",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que contraje una nueva deuda contigo.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjate ya de eso.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001956",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué terca, eh.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001957",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es mi manera de vivir.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu manera de vivir, eh...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001958",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Además, ya está bien de que hablemos de mí. Más importante que eso\nahora...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"El rostro de Toritani toma súbitamente una expresión grave. Con un tinte de\nseriedad distinto al que ha mostrado hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001959",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te acerques a ella. Es peligrosa.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad lo es?... No me parece tanto, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001960",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La realidad es que ella usó al club de arte. Y te usó a ti también.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Toritani responde de manera áspera eso. Lo que dice es cierto. Tanto que no\nencuentro palabras para refutarle eso.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001961",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya estoy harta de que esa mujer siga tratando de usarte a ti y al club de arte,\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"No hay nadie en la sala del club de arte después de clases.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"No tenía nada qué hacer en particular. Pero, quizás por costumbre es que vine\nsin pensármelo mucho.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003611",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, Rin, ¿qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003612",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, cierto... Creo que debería contarte también a ti...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tienes alguna duda puedes preguntarme. ¿Es acerca del paisaje que estás\ndibujando?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003613",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, se trata de Kei-kun...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei? ¿Qué pasó con Kei? Espera, no me digas que se metió en problemas de\nnuevo.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003614",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-kun no es de la clase de chicos que se la pasa armando esa clase de\nproblemas.... Aunque, supongo que eres tú mejor que nadie quien lo sabe,\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm, sí. Y bien, ¿qué sucedió con Kei?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003615",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, cierto, cierto. Esto... Kei-kun está dormido, en el salón.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"¿Kei está dormido en el salón?... Me da la impresión de que siempre está\ndormido, pero es extraño que esté durmiendo incluso después de clases.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003616",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan estaba en el horno escalonado y le avisé. Me dijo que Kei-kun viene\nsiempre al colegio en motocicleta, y que sería peligroso que se durmiera\nmientras maneja, así que me pidió que lo dejara durmiendo.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa fue una decisión razonable.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003617",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Mako-chan dijo que iría a ver después cómo estaba.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Pobre de nuestra jefa, eh. Tener que estar pendiente incluso de las\nsiestas de los miembros del club... Disculpa por ponerte a hacer esto, Rin.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003618",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tienes por qué disculparte, no me importa.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así... Eres de las que siempre está atenta hasta el más mínimo de los\ndetalles, la verdad es que me preocupa que hayas terminado en un mal lugar,\ncon toda esta tropa de desconsiderados... O no, tal vez me preocupo\ndemasiado.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Rin es mucho más fuerte y firme de lo que su apariencia da a creer, y siempre\nda su opinión de manera clara.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003619",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Quizás no lo parezca, pero estoy llevando todo bastante bien.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, en fin, no tienes por qué reservarte tanto conmigo, ¿bien?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003620",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo mismo te digo a ti, Nao-kun. Puedes pedirme lo que quieras.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno, si hay algo que quieras preguntar solo dime.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"A pesar de que le di prioridad a Rin para que hiciera lo que quisiera, aún hay\nmuchas cosas que no sabe. No quiero estropearle el encanto de la pintura a\nRin respondiendo siempre de inmediato a todas sus preguntas.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003621",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, gracias.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003622",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... ¿Sabes? Hay algo que quisiera preguntarte.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Podría entonces ahora...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003623",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, podría ser en otro momento. Dejémoslo para la próxima vez.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"msgoff"},
{"se",file="se9012",vol=70,id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003624",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Asegurate de responderme cuando llegue el momento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm? S-Sí... está bien.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003625",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vale. Nos vemos después, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"se",file="se1279",id=1},
{"fg",ch="稟",mx=40,mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Rin sale de la sala de arte con pasos ligeros.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Vaya forma tan rara de hacer énfasis en algo...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Rin se tomó la molestia de venir a avisarme, asi que creo que iré a ver cómo\nestá Kei...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001962",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Me topé con Toritani a mitad del pasillo que da hacia el salón de clases.\nCoincidencia... no lo creo.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Seguramente esperó a acabar con algunas de sus labores para venir a ver a Kei\ntras recibir la noticia de Rin.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Hablo con Toritani mientras caminamos.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que Kei se quedó dormido.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001963",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por lo general siempre se despierta cuando termina la hora de tutoría y se va,\ndebe haber tenido bastante sueño esta vez.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, en la mañana también se durmió de repente, como si\nalguien le hubiera pasado un interruptor.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001964",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Se comió la cena de ayer?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se comió la cena y las rosquillas que le llevaste.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001965",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo... Pero, hace lo mismo todos los días, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001966",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, desde que comenzó el nuevo período siempre se queda dormido en clases.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No hace lo mismo siempre?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001967",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nunca se queda dormido en clases. Siempre está despierto.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio? ¿Y aun así tiene esas catastróficas calificaciones?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001968",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es que se la pasa dibujando.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahh, así que es eso.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001969",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei siempre está dibujando y pintando. Nunca para.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Nunca para...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Después de susurrar eso, veo a Toritani mientras caminaba a mi lado.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001970",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo pensé que siempre estás pendiente de él.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Toritani me ve por un breve momento, y luego se encoge ligeramente de hombros.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001971",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Porque soy la jefa del club de arte. Y por eso mismo también tengo los ojos\nbien puestos sobre ti.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece. Tanto que ayer y hoy te saliste de clases solo para ir a buscarme.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001972",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Así es.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Toritani comienza a elevar la velocidad con la que camina.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Fue ahí que me di cuenta.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Desde hace un rato he estado caminando a mi ritmo sin prestar mucha atención.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Sin embargo, Toritani, cuya altura y longitud entre paso son muy distintos a\nlos míos, estaba caminando a la misma velocidad que yo.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Incluso en aquellos días que regresamos juntos, Toritani nunca me ha pedido que\ncamine más lento, o algo por el estilo.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Y a pesar de eso, no parece estar caminando muy frenéticamente. Lo hace de\nmanera firme y digna.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001973",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Has estado asistiendo bien a Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijo que quería pintar un paisaje, así que estoy dejando que haga básicamente\nlo que quiera.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001974",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tomé en cuenta tu consejo también. Es como tú misma lo dijiste. Si se trata\nde una obra para la Exposición Moore, entonces ya va siendo la hora de que\ncomience a desarrollar su propia pintura.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001975",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Es raro que respondas así, sin ir al grano.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001976",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Ciertamente fui yo quien le recomendó pintar un paisaje. Pero, pensé que\ntú le ayudarías, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001977",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Deberías estar un poco más consciente de que Rin-chan necesita de ti.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin es mucho más fuerte de lo que tú crees, y siempre tiene a la vista aquello\nque debe hacer.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001978",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo niego, pero... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Toritani se pone la mano de forma ligera sobre la frente, como quejándose.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001979",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sé que no tienes mucho interés por ti mismo, pero no deberías excederte\ntampoco.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001980",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es lo que no te gusta de ella? Aun con lo linda que es.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada que no me guste de ella.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001981",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-- No me esperaba esa respuesta.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, en este momento me llamas más la atención tú.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012h",head="mak_z2a",lv=5,id=6},
{"fgact",ch="真琴",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001982",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh--”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así mismo. Pareces estar muy ocupada con tu trabajo, y no pareces tampoco\nllevártela muy bien con tu madre.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0016",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0015",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001983",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ahh... claro... te referías, a eso...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No solo Kei es el único que no come. Tú tampoco lo estás haciendo.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001984",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Consumo a diario las calorías y nutrientes necesarios. No tienes por qué\npreocuparte por mí, ya te lo he dicho, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0006",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001985",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal si dejas de preocuparte por mí y comienzas a preocuparte más por ti?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por mí? Yo no tengo nada de qué preocuparme. Mis días son de paz y\ntranquilidad.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001986",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y qué piensas presentar para la Exposición Moore, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pienso presentar nada.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0015",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001987",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Otra vez de nuevo con eso?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, otra vez de nuevo con eso.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001988",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿No... pintarás?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Toritani se detiene. Fue justo en el descanso de las escaleras.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"... Recuerdo lo que sucedió anoche.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Recuerdo las palabras de Toritani, quien llegó al punto de preguntarme si\npintaría en caso de que se desnudara. Esas palabras que ella misma tachó de\ninjustas. La seriedad en sus palabras y en su expresión.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Tengo que darle una respuesta a la determinación de Toritani.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es... No pintaré nada.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"bgm",stop=1,time=500},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_001045",ch="ked"},
},
ja={
{
name={"???"},
"“¡¡Yo sí lo haré!!”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Ambos levantamos nuestras caras ante esas repentino y fuerte grito.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",mode=-2},
{"bg",y=300,speed=300,sync=0,file="zbg047b",path=":bg/",x2=-760,y2=300,x=-960,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="圭",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0100",face="a0005",head="kei_z2a",x2=200,x=0,lv=5,id=9},
{"se",file="se9010",id=1},
{"bgm",file="bgm108"},
{"text"},
text={
ja={
{
"Kei estaba parado de forma imponente sobre las escaleras.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001989",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kei! ¡¿Por qué estás tan empapado?!”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Toritani suelta una voz de sorpresa.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Kei estaba mojado de pies a cabeza. Las gotas que caían sin parar de todo su\ncuerpo formaban charcos en el piso.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0004",head="kei_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001046",ch="ked"},
},
ja={
{
name={"Kei"},
"“No aguantaba el sueño, así que traté de despertarme de alguna forma.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0005",head="kei_z2a",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0009",head="kei_z2a",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001047",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¡Pero eso es lo que menos importa ahora!! Yo, yo――”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Kei dio un fuerte paso hacia adelante, enojado, sin parecer estar consciente\nsiquiera de que tiene las escaleras por delante.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Eh, Kei! ¡Tienes escaleras por delante!”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0007",head="kei_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001048",ch="ked"},
},
ja={
{
name={"Kei"},
"“--??!!”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="圭",my=40,mode=-1,lv=5,id=9},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"El cuerpo de Kei flota en el vacío, suavemente.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Mis piernas reaccionaron antes de que mi cabeza pudiera procesar algo, justo en\nese mismo instante en que Kei literalmente terminó saltando sobre las\nescaleras al resbalarse con el charco que se había formado en el suelo.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001990",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡Kei!!!”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"se",id=1,file="se3356"},
{"bg",y=-550,x=-800,speed=300,time=0,sync=0,file="zbg047b",path=":bg/",x2=-500,y2=-550,ax=1920,ay=1126,bx=-960,by=-586},
{"quake",size=10},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Me pegué la espalda contra el suelo del descanso de las escaleras, y por un\ninstante se me fue el aire. A pesar de eso, en ningún momento solté a los dos\nque tenía ahora entre mis brazos.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"En ese instante en que la espalda de esa pequeña, frágil y delgada chica se\ndesplegó completamente en mi campo de visión, sostuve el cuerpo cayendo de\nlos dos sin pensármelo dos veces.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Abracé a Toritani, quien a su vez había sostenido a Kei tras correr antes que\nyo a alcanzarlo.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Toritani sostiene a Kei en sus brazos y le habla.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0110",face="a0009",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001991",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Kei? ¿Kei? ¿Estás bien?...”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="man_ked_001049",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Kei estaba dormido. Seguramente se desmayó del impacto al caer, y acabó por\ndormirse.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0015",head="mak_z2a",lv=5,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001992",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué alivio...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
"En el momento en que se dio cuenta de que Kei solo estaba dormido, un respiro\nde alivio se escapó de Toritani, y junto con él, toda la tensión de su cuerpo\nse esfumó.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es bueno saber que estamos todos bien.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0008",head="mak_z2a",lv=5,id=6},
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001993",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, de verdad...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0013",head="mak_z2d",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001994",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--!”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"El rostro de Toritani se congela, soltando sus manos de Kei y volteando, casi\ncomo si tratara de hacer girar la mitad de su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
"¿¿¿Eh, q-qué sucede???",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0008",head="mak_z2d",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001995",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Kusanagi, tú...!!”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Las puntas de los dedos de Toritani se extienden a alcanzar mi brazo derecho y\nse detienen justo antes de tocarlo. Nuestras miradas se cruzan, estando ahora\na una distancia de pocos centímetros.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0015",head="mak_z2d",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0010",head="mak_z2d",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001996",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Los pequeños labios que tengo frente a mí se abren y se cierran, tratando de\ndecir algo. Los rosados labios de Toritani tiemblan un poco, y sin embargo,\nni siquiera su aliento se siente.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Toda la tensión que se desborda de Toritani hace que el interior de mi boca\nvaya secándose.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001997",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"La tensión se calmó inesperadamente. Toritani agita su cabeza a los lados, y\nsusurra, algo cabizbaja.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001998",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Llevemos a Kei a la enfermería.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al levantar a Kei, Toritani acaricia su cabello.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Nos dirigimos a la enfermería, en total silencio los dos.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="真琴",speed=8000,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x2=0,x=1000,lv=4,id=6},
{"bgm",stop=1,time=1000},
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_02_3"},
{"text"},
linkback="block_00322",
},
label = {
top={block="block_00000",label=1},
},
}
