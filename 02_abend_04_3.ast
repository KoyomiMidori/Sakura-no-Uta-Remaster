astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",rule="083r",vague=40,file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",id=1,file="se1193"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El lado trasero de la mansión, el cual fue un terreno desocupado por varios\naños, estaba ahora totalmente rodeado de una cerca de hierro, ya habiendo\ncomenzado las labores de construcción.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"De adentro resonaba un estruendoso ruido de construcción.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ver, a ver... La compañía de construcción es... y...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Observo el cartel pegado sobre la cerca.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"En el cartel estaba detallado, para informarle a las personas ajenas a la obra,\nel permiso de construcción junto con el responsable de la obra, y además el\nimpreso con la forma de establecimiento de relación de seguro laboral, la\ncual marcaba la duración de la obra, entre otros detalles.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que van a construir un conjunto de apartamentos acá... La obra comenzó en\nabril... Justamente después de aquel día comenzó...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Abril... La época en la cual pude entrar acá, cuando aún era un terreno\ndesocupado.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=280000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no podré entrar más acá...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, menos mal que esparcí acá los pétalos de flor de cerezo que estaban\nadheridos a ese álbum...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"La compañía encargada de la venta de los lotes es famosa. La compañía de\nconstrucción también. Sin embargo, el nombre del dueño original del terreno\nno está.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Supongo que no hay razón para dejar este terreno desocupado por siempre...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya fue suficiente que dejaran este terreno inmóvil por tanto tiempo...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Miro al cielo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Un alto edificio de 14 pisos.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Los habitantes de los primeros pisos de mi edificio seguramente pasarán un muy\nmal rato. No les va a llegar tanto sol como antes.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué suerte que mi apartamento queda en los pisos más altos...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Del interior de la cerca de acero se puede escuchar el estruendoso ruido de los\ntubos de metal rodando alrededor.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Deben estar rodando los andamios o algo así.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso no pueden trabajar con más delicadeza?...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_sud_000001",ch="sud"},
},
ja={
{
name={"???"},
"“Qué escándalo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"¿Desde cuándo habrá estado parada allí?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Al darme cuenta, había una muchacha parada a mi lado.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_sud_000002",ch="sud"},
},
ja={
{
name={"???"},
"“No puedo dormir en paz...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"¿No puede dormir en paz?",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"¿Será alguna vecina?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Me da la impresión de haberla visto antes.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Si vive en el vecindario, entonces quizás es que no puede dormir la siesta con\nel ruido de esta construcción.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Aunque, realmente lleva tremenda pinta.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"¿Por qué lleva un vestido así de grueso en pleno verano?...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Bueh, igualmente tengo entre mis conocidos a un idiota que viste con abrigo en\nmedio del verano, así que quizás esta muchacha también sea de ese tipo de\npersonas...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_sud_000003",ch="sud"},
},
ja={
{
name={"???"},
"“¿No piensas lo mismo?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"De repente, la desconocida y muy extravagantemente vestida chica busca mi\naprobación.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000004",ch="sud"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Me está viendo.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... Sí, creo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_sud_000005",ch="sud"},
},
ja={
{
name={"???"},
"“¿Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
"¡EH! ¡¿Pero qué haces siguiéndole la conversación!",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Eso grité en mi mente, pero no puedo permitirme ir más allá de eso.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"No debo intercambiar palabras descontroladamente con esta clase de personas\nsospechosas.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"En base a mi propia experiencia, puedo decir que relacionarse con esta clase de\npersonas indispuestas y además incapaces de percibir el ambiente del lugar no\ntrae nada bueno.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Como Akashi, o Kei, o ese misterioso intento de extranjero, Thomas...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Si lo vemos del otro lado... Estoy rodeado por demasiados vínculos. Vínculos\nnada buenos.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"(No debo relacionarme más con personas extrañas)",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Me saco una sonrisa de la manga y le respondo para salir del paso, y entonces\ntraté de marcharme de ese lugar.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000006",ch="sud"},
},
ja={
{
name={"???"},
"“¿Qué haces riéndote como un bobo? ¡Te acabo de hacer una pregunta! ¿Quién eres\ntú?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Aún mientras trataba de escapar de ese lugar con una sonrisa, la muchacha me\ninterroga con una mirada penetrante.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Siento que, de alguna manera, los aires alrededor me dicen que no puedo\nquedarme sin responderle nada...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Por los momentos, decidí tratar con ella procurando que no se enardeciera\ndemasiado...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, yo vivo por este vecindario, y, bueno, así son las cosas... Hasta luego.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000007",ch="sud"},
},
ja={
{
name={"???"},
"“Ya veo, entonces eso quiere decir que compartes la misma voluntad que yo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, ¿por qué dices eso?...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000008",ch="sud"},
},
ja={
{
name={"???"},
"“Pues, si vives en este vecindario, entonces no debes aguantar el ruido. ¿Me\nequivoco?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a decir que te equivocas, pero...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000009",ch="sud"},
},
ja={
{
name={"???"},
"“De ser así, toma esto entonces...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"se",file="se1296",id=1},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0000",face="a0002",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"La muchacha, ignorando por completo mis palabras, me dio una palanca.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... esto es...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000010",ch="sud"},
},
ja={
{
name={"???"},
"“Es una cosa parecida a una palanca...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no me parece algo parecido a una palanca, sino una palanca como tal...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0006",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000011",ch="sud"},
},
ja={
{
name={"???"},
"“¡¿Pero qué estás diciendo?! Ninguna palanca tiene un diseño tan lindo como\neste.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Al decir eso, me di cuenta de que en la punta de la palanca que la muchacha\nhabía señalado con los dedos había una cara dibujada con marcador.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0016",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000012",ch="sud"},
},
ja={
{
name={"???"},
"“¿Aún viéndolo no sabes qué es? Es un conejito. Tiene sus orejas y todo. Es muy\nlindo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Orejas?... Ciertamente, la punta de la palanca está dividida en dos lados,\npero... ¿No son como que un poco cortas para ser las orejas de un conejo?\nDiría que más bien parecen las de un zorro.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fgact",ch="吹",act="icon",lv=5,id=9,icon="icon02z2",x=80,y=-550},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="stopicon",lv=5,id=9},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0002",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000013",ch="sud"},
},
ja={
{
name={"???"},
"“¿Un fénec? Ya veo... tienes buen gusto. Bien, asumamos entonces que no se trata\nde un conejito, sino de un fénec.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"¿Que 'asumamos? No me jodas. Y además, yo dije zorro, no fénec...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0016",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000014",ch="sud"},
},
ja={
{
name={"???"},
"“En fin, si abres la cerca a la fuerza con esta cosa que parece una palanca,\nentonces podríamos destruirla.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podríamos destruirla... ¡Pero qué demonios dices!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000015",ch="sud"},
},
ja={
{
name={"???"},
"“¿Qué sucede? ¿Por qué alzas la voz? ¿Tienes alguna duda?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me vengas a decir con esa cara tan extrañada '¿Tienes alguna duda?'. ¡Dudas\nes lo único que tengo ahora! ¿Por qué se supone que yo debo destruir la cerca\ndel sitio de construcción?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000016",ch="sud"},
},
ja={
{
name={"???"},
"“¿Será porque compartimos el mismo destino?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué debo de un momento para otro compartir el mismo destino con una\npersona que no conozco?!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000017",ch="sud"},
},
ja={
{
name={"???"},
"“Pues hace un momento dijiste que compartíamos la misma voluntad...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien lo dijo. Yo nunca te di mi aprobación.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000018",ch="sud"},
},
ja={
{
name={"???"},
"“Pero se supone que tampoco lo negaste. El silencio es la prueba de tu\naprobación.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0010",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000019",ch="sud"},
},
ja={
{
name={"???"},
"“Ya veo, ¿entonces desde qué momento habrán surgido discrepancias entre los dos?\nMe parece que probablemente fue desde la discrepancia entre el conejito y el\nfénec... Pero, en ese caso también intervinió tu opinión...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Esa no es la causa del conflicto!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000020",ch="sud"},
},
ja={
{
name={"???"},
"“¿Entonces de dónde surgió la discrepancia? Parecía ser que estábamos\ncompletamente sintonizados el uno con el otro hasta ahora...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡De ninguna manera estábamos sintonizados! Jaa...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Demonios.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"No debo andar relacionándome con una chica tan sospechosa como esta. A pesar de\nque traté de huir, involucrándome lo menos posible con ella...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Al darme cuenta, e independientemente de la razón, ¿no estoy ahora hablando\ndemasiado con ella?",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"No estamos exactamente sintonizados el uno con el otro, pero es un hecho que\nnuestra conversación está fluyendo.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Esto no está bien.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-100,file="zbg027a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, creo que me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0017",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000021",ch="sud"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Me doy la vuelta. Traté de marcharme de ese lugar, casi pegando la carrera.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"se",file="se0744",id=1},
{"bg",y=-100,x=-960,speed=400,file="zbg027a",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",speed=400,mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",x2=0,x=-800,lv=5,id=9,sync=0},
{"extrans",time=0},
{"ex",time=400,func="wait"},
{"se",stop=1,id=1,time=500},
{"se",file="se3130",id=2},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0005",head="sui_z2a",x=-800,lv=5,id=9},
{"fg",ch="吹",speed=200,mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0005",head="sui_z2a",x2=-800,x=0,lv=5,id=9},
{"quake"},
{"ex",time=0,func="wait"},
{"se",stop=1,id=2,time=500},
{"se",file="se9015",id=3},
{"bg",time=100,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡Eh, waaAAAAH!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"msgoff"},
{"se",id=1,file="se2271"},
{"bg",file="battle_007r",id=8,lv=8,rule=106,time=100,sync=1,path=":cg/battle/",set="battle"},
{"ex",time=150,func="wait"},
{"se",file="se_kick3",id=2},
{"bg",file="閃光中",id=9,lv=9,path=":cg/battle/",set="battle",sync=0},
{"quake",size=10},
{"extrans",rule=105,time=150},
{"text"},
text={
ja={
{
"'Gatsu'. Un sonido parecido al del concreto rompiéndose.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Me salvé por un pelo. La palanca estaba clavada en el lugar donde yo estaba\nparado hace un instante.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",rule="083r",vague=40,file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm039"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esto es demasiado peligroso! ¡¿Por qué me estás atacando con la palanca?!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="吹",size="z1",my=40,mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="吹",act="うんうん",time=200,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000022",ch="sud"},
},
ja={
{
name={"???"},
"“No es una palanca, es una cosa que parece una palanca. Observa nada más, un\nfénec, un fénec.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un fénec?... La tinta del marcador se despegó con ese ataque...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000023",ch="sud"},
},
ja={
{
name={"???"},
"“¡¿Ahhh?!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"La muchacha que estaba frente a mí puso una casa de total asombro.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0020",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000024",ch="sud"},
},
ja={
{
name={"???"},
"“Uh... Uhh...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Y después, comenzó a soltar un gemido de dolor...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Parece estar bastante triste. O más bien, está muy triste.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"No sé qué está pasando, pero esta podría ser mi oportunidad. Justo cuando traté\nde huir sigilosamente del lugar...",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000025",ch="sud"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fgact",ch="吹",act="いいえ",size=5,lv=4,id=9},
{"se",file="se1296",id=1},
{"text"},
text={
ja={
{
"La muchacha metió su mano en su ropa, registrando algo. Y luego, saca un\nmarcador.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"se",id=1,file="mc_op"},
{"se",id=2,file="wipe1"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000026",ch="sud"},
},
ja={
{
name={"???"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",stop=1,id=1,time=500},
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
"Y por alguna razón, sonríe satisfecha.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0000",face="a0003",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0004",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うんうん",time=250,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000027",ch="sud"},
},
ja={
{
name={"???"},
"“¡Mira! Un fénec, un fénec.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"La muchacha blande frente a mí la palanca con el fénec redibujado. Ciertamente,\nla punta de la palanca, redibujada ahora de manera más consciente, tenía\nahora más aspecto de fénec que antes.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Pero aun así, una palanca es un arma letal. A cualquiera le daría terror que se\nla mostraran de esta manera.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Sintiendo un ligero miedo por la muchacha que tenía frente a mis ojos, decidí\ncambiar de estrategia.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien. Está bien. Ya entendí.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Le respondo con amabilidad, tratando de calmarla.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Una lunática con un arma cortante. Esta muchacha con su cosa que parece una\npalanca.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Es peligroso excitar mucho a esta clase de gente. La única opción viable es no\ndarle mucha atención a su conversación, sin aceptar o rechazarle nada, y\nescapar de este lugar.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Esa es la mejor opción.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ahora, baja esa cosa que parece una palanca. Me da miedo que me muevas esa\ncosa frente a mis narices.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000028",ch="sud"},
},
ja={
{
name={"???"},
"“Así que lograste entender mi verdadera intención. De ser así, debemos destruir\nentonces esa cerca con esta cosa que parece una palanca. Debemos acabar con\nesa construcción tan ruidosa...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, entiendo lo que quieres decir, pero ¿realmente te parece bien hacer\neso? Es un problema bastante abrumador.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000029",ch="sud"},
},
ja={
{
name={"???"},
"“¿Un problema abrumador?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Cada vez que golpee la cerca con esa cosa que parece una palanca, ese\ntierno y lindo fénec se irá raspando.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000030",ch="sud"},
},
ja={
{
name={"???"},
"“¡¿Ahh?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"La muchacha que estaba frente a mí puso una casa de total asombro.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Puso la misma cara que hace un rato, así que probablemente este es su nivel más\nalto de asombro.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"¿Bajo qué percepción de valores decide y actúa? Esta muchacha...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si a pesar de eso estás de acuerdo, entonces podría destruir la cerca con esa\ncosa que parece una palanca, pero... ¿realmente no te importa?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000031",ch="sud"},
},
ja={
{
name={"???"},
"“Kuh... p-pues...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si a pesar de eso estás de acuerdo, entonces dámela, destruiré la cerca con esa\ncosa que parece una palanca.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0021",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000032",ch="sud"},
},
ja={
{
name={"???"},
"“Uwaan. ¡N-No!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
text={
ja={
{
"Al tratar de arrebatarle la cosa que parece una palanca, la muchacha abrazó la\ncosa que parece una palanca, para que no se la quitara.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No quieres?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0005",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うんうん",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000033",ch="sud"},
},
ja={
{
name={"???"},
"*koku*, *koku*.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"La muchacha asiente fuertemente.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de malo te parece hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0018",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うんうん",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000034",ch="sud"},
},
ja={
{
name={"???"},
"*koku*, *koku*.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"La muchacha vuelve a asentir fuertemente.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías simplemente redibujar esa cosa una y otra vez y ya...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",time=300,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000035",ch="sud"},
},
ja={
{
name={"???"},
"“¡Si le sigues llamando 'esa cosa' me enojaré! Se podría decir que este fénec\ntiene un acabado bastante hermoso, y... es muy lindo. Lindo... Ahh, tan\nlindo...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Y al decir eso, la muchacha se extasió mientras abrazaba la palanca.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Son muchas las cosas que no logro entender.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000036",ch="sud"},
},
ja={
{
name={"???"},
"“Además, sería muy triste lastimar de repente a este pequeño, aun cuando\nfinalmente se le dio forma.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si fuiste tú quien lo lastimó de repente.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000037",ch="sud"},
},
ja={
{
name={"???"},
"“Sí... Por eso estoy bastante arrepentida de lo que hice. No volveré jamás a\ntratar de hacer algo que pueda lastimar a este pequeño.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, arrepiéntete más bien de haber tratado de matarme con la palanca.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000038",ch="sud"},
},
ja={
{
name={"???"},
"“Esa es una calumnia. Eso fue simplemente para intimidarte, no tenía intención\nalguna de matarte.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Intimidarme?! ¡Eso no fue ninguna intimidación! ¡Si no lo hubiera esquivado\nme hubiera golpeado!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000039",ch="sud"},
},
ja={
{
name={"???"},
"“Pues dicen que incluso a un maestro del pincel como Kobo, el río se lo puede\nllevar...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué tragedia debe ser eso para Kobo-Daishi, eh... Hasta su pincel se lo llevó\nel río...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000040",ch="sud"},
},
ja={
{
name={"???"},
"“Sí, y por eso se piensa que eso fue un accidente.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si realmente fuera un accidente entonces serías culpable de un crimen de\nnegligencia grave!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, si llegamos a destruir la cerca y encima de eso pisamos el lugar de\nconstrucción, estaríamos incurriendo en daño a la propiedad e intrusión a un\nlugar de construcción. Eso es un crimen también.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000041",ch="sud"},
},
ja={
{
name={"???"},
"“Un crimen... eso no es bueno...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Ese 'No es bueno...' es justamente lo que estabas tratando de hacer.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ¿y bien? ¿Qué es lo que haces en este lugar?...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000042",ch="sud"},
},
ja={
{
name={"???"},
"“¿Hacer de qué?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿qué haces en este lugar con una palanca?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000043",ch="sud"},
},
ja={
{
name={"???"},
"“Esta cosa que parece una palanca la conseguí casualmente allí y la agarré.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Al decir eso, señaló con sus dedos el lado externo del sitio de construcción.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Probablemente uno de los obreros que trabaja acá la sacó afuera y la dejó a un\nlado de la vía, olvidándose de ella.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué agarraste esa cosa?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0000",face="a0016",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うんうん",time=300,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000044",ch="sud"},
},
ja={
{
name={"???"},
"“Vamos, mira, un fénec, un fénec.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, al principio era un conejo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0002",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0004",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000045",ch="sud"},
},
ja={
{
name={"???"},
"“Al principio era solo una palanca. Yo la volví linda. Me parece que quizás sea\nuna obra maestra. ¿No piensas lo mismo al ver este fénec?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Pero qué muchacha tan loca... Parece que me he topado con una personita\nbastante tediosa.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vives por esta zona? ¿Cómo es tu nombre?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0012",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000046",ch="sud"},
},
ja={
{
name={"???"},
"“¿Nombre?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué pones esa cara de misterio? Nombre. Tu nombre.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0011",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000047",ch="sud"},
},
ja={
{
name={"???"},
"“Mi nombre es... esto...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"se",file="se1296",id=1},
{"fgact",ch="吹",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
ja={
{
"La muchacha comenzó a escudriñar su ropa, como si estuviera buscando algo.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000048",ch="sud"},
},
ja={
{
name={"???"},
"“Mi nombre es... esto, ¿Olympia?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es cierto. Acabas de leer la etiqueta que está cosida a tu ropa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0008",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000049",ch="sud"},
},
ja={
{
name={"¿Olympia?"},
"“Pero, normalmente el nombre debería estar siempre escrito en la ropa...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni que fuera un uniforme de gimnasia o un traje de baño, tu nombre no está\nescrito en tu ropa. Y previo a eso, ¿cómo es que no sabes tu propio nombre?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000050",ch="sud"},
},
ja={
{
name={"¿Olympia?"},
"“¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que 'por qué será'?... Tú...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"En un principio creí que estaba ocultando su nombre, pero... Será posible que\nesta muchacha...",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"¿No sabe su nombre?",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Tampoco sabe bien lo que estaba haciendo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Espera, será que tú...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000051",ch="sud"},
},
ja={
{
name={"¿Olympia?"},
"“Ya me acordé. Es Sui.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡NO LO OLVIDES!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"user",mode="conf",ch="吹"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="吹",act="うんうん",time=300,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000052",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Lo siento! En señal de disculpas, te mostraré el fénec más de lo normal. Mira,\nun fénec, un fénec.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Sui volvió a mover rápidamente la punta de la palanca frente a mí.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás desde hace rato has estado mostrándome esa palanca una y otra vez para\ncalmarme, pero... no me calma en nada que me hagas eso. Solo me irrita.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000053",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Uh?! ¿Aun con lo lindo que es?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000054",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eres una bestia cruel...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué se supone que soy una bestia cruel?!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_sud_000055",ch="sud"},
},
ja={
{
name={"Sui"},
"“Irritarse viendo a un fénec tan lindo como este no es algo propio de una\npersona. Probablemente sea propio de una bestia.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hay razón alguna para que alguien que anda blandiendo esa cosa de un lado a\notro tratando de entrar a la fuerza a un sitio de construcción me diga que no\nsoy una persona!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000056",ch="sud"},
},
ja={
{
name={"Sui"},
"“Entonces eres una bestia, tanto así que aquellos seres más despreciables que\nlas personas te podrían decir que eres más despreciable que una persona.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿ESTÁS ADMITIENDO AHORA QUE TÚ TAMBIÉN ERES MÁS DESPRECIABLE\nQUE UNA PERSONA?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000057",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Eso es un sofisma!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Claro que no lo es!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Ahh, estoy comenzando a olvidar lo que estaba hablando. Nos hemos salido\ndemasiado del tema principal.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien... ¿Qué estabas haciendo?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000058",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Hacer qué?...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Vas a pretender que lo olvidaste todo de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_sud_000059",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es que hacía mucho ruido...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero es que de verdad viniste a asaltar el sitio de construcción porque se te\nhacía escandaloso?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000060",ch="sud"},
},
ja={
{
name={"Sui"},
"“No es eso... Vine a verlo casualmente...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Hacía mucho ruido, así que vino a verlo casualmente...",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Es una razón bien descabellada, aunque bueno, si es por eso yo tampoco puedo\ndecir mucho.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Pues, yo también vine acá por mera casualidad...",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque este lugar era un terreno desocupado hasta hace poco...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000061",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Un terreno desocupado?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no había nada. Se podría decir que nada más era un terreno vacío...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000062",ch="sud"},
},
ja={
{
name={"Sui"},
"“No hay nada...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, qué más da. En fin, no vuelvas a recoger esas cosas tan peligrosas.\nTírala por algún lado y vete a tu casa. Si algún policía llega a interrogarte\npodrían arrestarte.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000063",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿La cosa peligrosa que recogí? ¡¿Jaa?! ¡Te refieres a ti! ¡¿Verdad?!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La palanca, la palanca! ¡¿Además, porque según tú tú me recogiste?!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000064",ch="sud"},
},
ja={
{
name={"Sui"},
"“No entiendo muy bien por qué esto es peligroso.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres tú lo que no logro entender yo. Eso de 'algo que parece una palanca' es\nsiempre el símbolo de un crimen según los noticieros.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000065",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es un fénec. Un fénec. Es tan lindo que no tiene ni un poquito de peligrosidad.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa mente tuya que piensa que esa cosa no tiene ni un poquito de peligrosidad\nya es bastante peligrosa.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000066",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero si es lindo...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, ya entendí. En fin, esconde esa cosa que parece una palanca... No se\nla muestres mucho a las demás personas.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000067",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué te estás sorprendiendo?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000068",ch="sud"},
},
ja={
{
name={"Sui"},
"“Porque es la primera vez que me das una advertencia con sentido...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues me parece que llevo todo este rato advirtiéndote lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0018",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000069",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ciertamente, si llego a mostrar esta cosita tan linda con tanta impudicia,\nalguien podría atacarme...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Por ahora, quisiera saber a qué se refiere con 'con tanta impudicia'... Supongo\nque habrá querido decir 'con tanta imprudencia'...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Luego de eso, me despedí de aquella rara muchacha y me dispuse a cumplir mi\nobjetivo original, dirigiéndome al nuevo supermercado.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Estaba más lejos de lo que creía, pero tenía una gran variedad de productos, y\nademás habían muchas cosas baratas.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Todo bien hasta la parte en que compré y salí del super.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Todo iba bien hasta ahí.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"El problema es que...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cuántas horas llevo caminando desde aquel entonces?!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Traté de regresar a la estación de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Con toda certeza debí haber estado caminando hacia esa dirección, pero por más\nque caminara no divisaba la estación, y más bien el paisaje alrededor fue\ncambiando a uno que no se me hacía conocido.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Pensé por un momento, '¿Me habré perdido?', pero aun así me puse de terco y\nseguí caminando.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Aproximadamente 1 hora después de ese momento.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"El sol estaba ya poniéndose, y el hielo que estaba enfriando el pescado se\nhabía derretido por completo.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De seguir así se va a poner malo el pescado. No, espera, ese no es el problema,\nes capaz que si anochece ni siquiera pueda regresar a casa...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué debería hacer?...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ununuh...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Ya habiendo alcanzado este punto, no puedo seguir cargando con la vergüenza. Al\ncoger mi teléfono celular, revisé algunos nombres de mi agenda de contactos.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo que hacer el sacrificio... El problema es a quién llamar ahora...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"En el caso de Kei, tiene su motocicleta.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Si esto es todavía parte de Yumihari, entonces no se tardará tanto en venir.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"El problema es si su capacidad de entendimiento será suficiente como para que\npueda ubicarme...",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Y de verdad, mis explicaciones no son de las mejores.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"La siguiente opción es Toritani.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Esta opción es bastante viable, pues tiene bastante madera.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Es espabilada, y además perspicaz.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Quizás, si llego a informarle de mi situación, se burlará, pero igualmente me\nsalvará de alguna forma decidiendo correctamente lo que hay que hacer.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
