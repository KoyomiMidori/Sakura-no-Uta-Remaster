},
block_00094={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000869",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿E-Estas molesta?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien raro verte así de asustada, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rna_001196",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuuh. Tú tampoco pareces estar muy consciente de tus alrededores, senpai.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Y-Yo? ¿A-A qué te refieres exactamente?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000870",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, la campana, la campana.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001197",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ya lo sé!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_001198",ch="rna"},
},
ja={
{
name={"Rina"},
"“Santo Dios... Yuumi... A veces no sé qué es lo que realmente quieres. Si una\ncosa, o la otra...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una cosa o la otra?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rna_001199",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No era contigo! En fin, me voy ya, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0012",head="yum_z2a",lv=5,id=5},
{"fgact",ch="優美",act="いいえ",lv=5,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000871",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Wa, wawah, espera...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-140,x=310,file="zbg048g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Mientras yo le prestaba atención a la clase en completo silencio, Yuumi estuvo\ntodo el tiempo observándome inquietamente.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Tomo el cuaderno, tratando de ignorarla.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",y=-140,x=310,file="zbg048g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0005",head="yum_z2a",lv=5,id=5,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="優美",act="びっくり",time=200,lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="びっくり",time=200,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000872",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Mm! ¡¡Mmm!!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Yuumi me hace señas sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"¿Qué estará tratando de hacer? No está diciendo nada, pero me distrae.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rna_001200",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Al observar con cuidado, me doy cuenta de que Yuumi estaba apuntando hacia el\notro lado de la ventana.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"(¿Qué será?...)",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Al observar por la ventana veo a Kusanagi-senpai caminando por el patio.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0017",head="yum_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000873",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué estará haciendo?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Yuumi me habla en voz baja, enrollando su cuaderno y usándolo como una especie\nde megáfono.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_001201",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pues, quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0008",head="yum_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000874",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No te da curiosidad saber?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rna_001202",ch="rna"},
},
ja={
{
name={"Rina"},
"*mira fijamente*",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Observo con desdeño a Yuumi.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0009",head="yum_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000875",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De nuevo viéndome así. Rina, ¿por qué estás tan enfadada?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_rna_001203",ch="rna"},
},
ja={
{
name={"Rina"},
"“No pienso contarle nada de nada a muchachas que hacen cosas innecesarias.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0010",head="yum_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000876",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muh...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"bg",file="bg048g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="優美",size="z1",my=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0012",head="yum_z1a",lv=4,id=5},
{"se",file="se3214",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000877",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Profesor, disculpe!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_kys_000003",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Eh? ¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000878",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Las pantis de Rina se empaparon repentinamente de flujo vaginal, así que\nla llevaré a la enfermería!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001204",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Q-Qué rayos?! ¡Yuumi, para ya con las estupideces!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="man_kys_000004",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿A-A qué te refieres exactamente?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0006",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0018",head="yum_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000879",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Profesor, a una muchacha no se le puede preguntar eso!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kys_000005",ch="kys"},
},
ja={
{
name={"Profesor"},
"“C-Cierto...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000880",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Bien, gracias por la comprensión!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_rna_001205",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Cuál comprensión?!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0016",head="yum_z2a",lv=5,id=5},
{"fgact",ch="優美",act="うなづく",lv=5,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Yuumi me jala fuertemente de la mano.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rna_001206",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y-Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0002",head="yum_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000881",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, vamos.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rna_001207",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿I-Ir a dónde?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se1279",id=1},
{"text"},
text={
ja={
{
"Nos salimos del salón.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",lv=4,id=5},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001208",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Yuumi! ¡Escucha lo que voy a--!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000882",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Perdóname, Rina. Estás enojada por lo de esta mañana, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rna_001209",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Lo de esta mañana?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000883",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por haber abrazado a Kusanagi-senpai. ¡A pesar de ser una broma en ningún\nmomento me paré a pensar en cómo te podrías sentir de hacer yo eso!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_rna_001210",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Fuuh.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_rna_001211",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cómo me podría sentir... eh.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Yuumi está confundiendo completamente las cosas.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Seguramente no entiende lo que va a pasar ahora, después de la tontería que\nhizo esta mañana.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Muy típico de ella.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_001212",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, evita hacerle ese tipo de cosas a Kusanagi-senpai por un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0012",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000884",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por un tiempo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_rna_001213",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. ¿Te ha quedado claro, señorita?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000885",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí... Si tú lo dices, así lo haré, Rina...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_001214",ch="rna"},
},
ja={
{
name={"Rina"},
"“Santo cielo.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"La popularidad que tiene Kusanagi-senpai ahora es casi comparable a la de\nalguna estrella de novelas o un cantante.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Después de lo que Yuumi hizo, es muy difícil de creer que no se ganara la\nenemistad de alguna de las chicas en el lugar.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Realmente no ha cambiado nada. Sigue siendo la misma de hace tiempo...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000886",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Ya no estás enojada por lo de esta mañana?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rna_001215",ch="rna"},
},
ja={
{
name={"Rina"},
"“Digamos que lo de esta mañana ya quedó atrás, pero... ¡¿Vas a explicarme que\ndemonios fue eso de hace un momento?!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000887",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lo de hace un momento?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_rna_001216",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡La excusa que usaste para salir del salón!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000888",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, es una de mis fantasías.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001217",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pues no andes por ahí gritando a toda voz tus fantasías dentro del salón!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000889",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Perdóname... No se me ocurrió ninguna otra excusa para sacarte del salón de\nimprevisto...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rna_001218",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Esas cosas no se dicen! ¡Así no se te ocurra más nada, no se dicen!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000890",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rna_001219",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dios...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0011",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000891",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿será que estás bastante enojada por eso también?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_rna_001220",ch="rna"},
},
ja={
{
name={"Rina"},
"“Será que, no. Cualquiera se enojaría por eso, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000892",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Será entonces que no vas a perdonarme por lo de hace un rato?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_rna_001221",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si fuera la clase de persona incapaz de no hacerlo no me juntaría contigo.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0002",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000893",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Me perdonas?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rna_001222",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Con una condición! Jamás vuelvas a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000894",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo volveré a hacer.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"select",label="label01",text="select"},
{"select",label="label02",exp="f.yum=f.yum+1",text="select"},
{"select",name="select03_01_1",mode="sys"},
{"text"},
select={
ja={
"Yuumi está tratando de reprimir sus propios deseos.",
"Considerando cómo debe sentirse...",
{"rt2"},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Yuumi está tratando de reprimir sus propios deseos.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"excall",label="join"},
{"text"},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Considerando cómo debe sentirse, no soy capaz de decirle cosas muy fuertes.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"excall",label="join"},
{"text"},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Por lo general siempre se comporta en el salón. Es raro que haga esa clase de\ncosas.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Ella jamás da a revelar su rostro auténtico en el salón. Ese que muestra en el\nclub de arte.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Fue por eso que muchos de los alumnos se quedaron perplejos ante el suceso,\nseguramente. ¿Qué fue lo que la llevó a hacer todo esto?...",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001223",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, ¿de qué se trata todo esto entonces?... ¿Por qué tuvimos que salirnos del\nsalón en medio de la clase?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000895",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vayamos a donde está Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rna_001224",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A donde Kusanagi-senpai?... Uhmm, la verdad, creo que sería mejor no\nencontrarnos con él en otro sitio distinto al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0012",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000896",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_001225",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai es como una especie de ídolo musical ahora, hay algo a su alrededor\nahora que hace difícil acercársele.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000897",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No tienes de qué preocuparte, Rina! ¡Tu también eres tan linda como una idol!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rna_001226",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, está bien, entiendo. Eres la única capaz de halagarme de esa forma.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000898",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Claro que no...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001227",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque, bueno, no voy a negar que me llama la atención saber qué hace Senpai\ncaminando solo por el patio...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rna_001228",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya el mural se culminó, ¿qué habrá ido a hacer entonces?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0002",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000899",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, vayamos a donde está y preguntémosle directamente. Hacerlo ahora en\nmedio de clases es lo mejor en caso de que no pueda hablar con los demás\nalrededor.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rna_001229",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, quizás sea buena idea...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="優美",speed=3000,mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0002",head="yum_z1a",x2=0,x=-1000,lv=4,id=5},
{"bgm",stop=1,time=1000},
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",file="bluesky_winter",id=9,lv=9,rule="083r",sync=1,vague=40,path=":cg/"},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_yum_000900",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué se supone que hace fuera del salón alguien que tuvo que recibir clases\nsuplementarias en verano por haber reprobado?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rna_001230",ch="rna"},
},
ja={
{
name={"Rina"},
"“Escaparse de clases es malo, senpai.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, eran ustedes dos. No es la gran cosa, simplemente quise venir a revisar\nalgo.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rna_001231",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Revisar algo?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cosas mías, no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_rna_001232",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora que lo recuerdo, el mural estuvo cubierto con una lona durante todo lo\nque quedó de las vacaciones. Fue apenas hace unos días que la retiraron.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rna_001233",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongo que por eso no tuviste la oportunidad de verlo con cuidado.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tuve una el día del campamento.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rna_001234",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ese día tuviste que limpiar la piscina, cocinar y estudiar. Además, luego en la\nnoche fuimos a ver los fuegos artificiales. No había forma de que pudieras\nverlo con calma.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si con eso no bastaba comenzó el alboroto con el mural al terminar las\nvacaciones.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rna_001235",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, parece que incluso en las horas de descanso muchos se agolpan acá para\nverlo. 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_yum_000901",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, así que te saliste de clases simplemente para contemplar esto.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, a eso vine.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, me pregunto por qué la directora habrá esperado justamente a que\ncomenzara el nuevo período para mostrar la obra. Si es por reunir a los\nmedios le hubiera convenido más hacerlo durante las vacaciones...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rna_001236",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién sabe? Quizás quería mostrársela primero a sus propios estudiantes. De\nvenir mucha gente de los medios los alumnos no podrían verla.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me parece que sea la clase de persona capaz de hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rna_001237",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees? La directora es muy amable.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0016",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces a la directora?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rna_001238",ch="rna"},
},
ja={
{
name={"Rina"},
"“No exactamente. Pero me la encuentro con frecuencia en la azotea.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En la azotea?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rna_001239",ch="rna"},
},
ja={
{
name={"Rina"},
"“He estado pintando en la azotea desde que comenzaron las vacaciones de verano,\npara preparar la obra que presentaré en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has estado trabajando en ella desde verano?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_rna_001240",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, aunque bueno, digamos que lo de la Exposición Moore es solo una excusa.\nPinto allí simplemente porque hay algo en ese lugar que quiero pintar...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rna_001241",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es por eso que he tenido varias oportunidades de encontrármela.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_rna_001242",ch="rna"},
},
ja={
{
name={"Rina"},
"“La directora suele venir a fumar a la azotea.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, no sabía.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_rna_001243",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tienes buenas relaciones con la directora, senpai?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0016",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos? ¿De verdad eres capaz de creer que esa señora y yo nos\nllevamos bien?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rna_001244",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No? La directora parecía saber bastante de ti...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo... es que sabe de mí?...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_rna_001245",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, la verdad es que no sé. Pero de tanto tiempo conociéndote sé que\nsueles meterte en los asuntos de mucha gente, senpai, así que no sería nada\nraro.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rna_001246",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás la directora y tú tengan algún vínculo, de algún lugar. Nadie sabe.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=6},
{"fgact",ch="直哉",act="いいえ",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, a esa señora no la conozco de ningún lado.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_rna_001247",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_yum_000902",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahhh, ahora que lo recuerdo, la directora mencionó algo de que haría lo posible\npara expulsar a Naoya Kusanagi antes de que terminara este período.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0007",head="nao_z1a",lv=4,id=6},
{"fgact",ch="直哉",act="びっくり",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es en serio eso?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rna_001248",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está mintiendo. La directora nunca llegó a hablarnos de sus asuntos privados.\nSolemos ir a la azotea a pintar, y a veces nos encontramos con ella, solo\neso.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es la directora?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rna_001249",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es una buena persona. Y además tiene bastante estilo.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000903",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se ve muy bien con un cigarro en mano. Esa sonrisa cínica que muestra a veces\nme excita...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿'Me excita'?...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000904",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es preciosa, muy de mi tipo.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino, no me digas que ves con ojos lujuriosos a esa señora...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0015",head="yum_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000905",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues sí, supongo que el pequeñín Kusanagi no es capaz de comprender los\nencantos de esa gran mujer. Pero tranquilo, nada te impide que sigas\ncomplaciendo tus oídos con los excitados y aduladores balbuceos de tus\nfanáticas aún en pañales.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo había olvidado ya. Gracias por esa, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0013",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000906",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿D-De qué me estás agradeciendo?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que eran toda una molestia. Venían y venían sin parar, no se\nacercaban mucho pero tampoco se alejaban. Quería gritarles algo, pero así\ncomo estaban no podía.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000907",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Jaa! ¡Imbécil, esta es la única oportunidad que tendrás en tu vida para ser\npopular con las mujeres, deberías dejar de decir eso y simplemente\ndisfrutarlo!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jaa! Pues siento contradecirte. ¡Mi alta popularidad con las mujeres viene\ndesde el primer período!”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000908",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cuántas veces tendré que repetirte que eran asesinas que habían venido por ti?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000909",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues qué más da, un torpe e insensible como tú jamás entenderá el verdadero\nvalor de las chicas, así que no pierdas tu tiempo y ve y cómete a alguna\nzorra por ahí.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, soy un idiota que no sabe distinguir una chica verdaderamente buena,\npero aun a pesar de eso tengo todo el derecho a elegir.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000910",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debe haber alguna chica que te guste entre toda esa manada de fieras.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues déjame decirte que en primer lugar, no me gustan las mujeres que hacen ese\ntipo de cosas.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000911",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Aún virgen y pretendes sacar tu orgullo acá?!”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Justamente por ser virgen todavía es que me aguanto con mi orgullo!”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000912",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y qué tanto tratas de aguantar? Deberías aprovechar de que tienes un pe*e y\nfollarte a toda mujer que se te acerque.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo por el hecho de tener un pe*e todos los hombres hicieran eso este país\nsería una nación de criminales.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000913",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eso dices? No tengo pe*e, así que no entiendo muy bien cómo piensan los\nhombres, pero si tuviera uno me gustaría metérselo a alguien.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y crees que yo no? Yo también quiero meterlo, demonios.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000914",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si tanto quieres meterlo entonces podrías metérselo a alguna mujerzuela por\nahí.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Solo se lo meteré a la mujer que me robe el corazón! ¡Una vagina para toda la\nvida! ¡Ese es mi ideal a seguir, y también la razón por la cual sigo siendo\nun maldito virgen!”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000915",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uwah, ¿no te da pena decir eso?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa para nada, por más vergonzoso que sea. ¡Y además, no hay ninguna\nrazón para que estés tan pendiente de mi virginidad!”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_rna_001250",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... tiene razón.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",mode=-2},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Volviendo al tema, no pensé que ustedes dos conocieran a la directora.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_rna_001251",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tampoco es que la conocemos, simplemente nos la hemos encontrado casualmente en\nla azotea unas cuantas veces.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_rna_001252",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y ahora que recuerdo, aun antes de que se culminara el mural se la pasaba\nviendo con frecuencia la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_yum_000916",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, siempre parecía estar viéndola.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_rna_001253",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Será que quizás tiene algún fuerte apego con ella?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"bgm",stop=1,time=2000},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Aunque, sí me da la impresión de que algo pasó con esta iglesia hace\ntiempo...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001254",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cuál es la temática de este mural?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La temática?... Probablemente los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_rna_001255",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, no sé realmente qué tenía Kenichiro Kusanagi en mente, pero para\nAkashi fue esa la temática.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en su caso, más que simplemente adoptar la temática, intentó reproducir\nlos cerezos milenarios en el mural.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_rna_001256",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Reproducirlos?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Supongo que habrá tenido sus razones para crear una obra que diera la\nilusión de que realmente existen.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_yum_000917",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Una obra que le diera vida a los cerezos milenarios?...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0014",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso mismo. Es eso lo que me llama un tanto la atención.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_rna_001257",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué exactamente te llama la atención?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen que aquellas obras creadas con fervor y corazón poseen el mismo poder que\naquello que buscan reproducir.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_rna_001258",ch="rna"},
},
ja={
{
name={"Rina"},
"“Como la historia de la pintura que cobró vida cuando le dibujaron los ojos,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. 'Garyou Tensei'.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Existe un mito de un pintor que vivió en el territorio de Liang durante la era\nNanbokucho, cuyo nombre era Cho So You. La historia trata de cómo el dragón\nque pintaba se escapó de su pintura al dibujarle ojos.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La gente a su alrededor no paraba de insistirle en que le agregara ojos al\ndragón. Sin más opción, Cho accedió. Y en el instante en que lo hizo, el\ndragón saltó de la pintura y rompió el techo, emprendiendo vuelo hacia los\ncielos.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Percibo algo similar en estos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0014",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y me da algo de mala espina.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_rna_001259",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mala espina?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque bueno, nada extraño puede ocurrir de esta pintura de por sí. Pero,\nsi los sentimientos puestos en ella llegaran a resonar con los cerezos\nmilenarios...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_rna_001260",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cada vez que hablas de la leyenda de los cerezos milenarios lo haces como si de\nverdad existieran, senpai.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0016",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como si de verdad existieran? No me hagas reír, Hikawa. No hay cosa que yo\nodie más que esa clase de cuentos esotéricos.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_yum_000918",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Realmente odias todo lo que tenga que ver con los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=6},
{"fgact",ch="直哉",act="うなづく",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, los odio.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿no deberían irse ya de vuelta a la clase? Supongo que salieron porque\nme vieron afuera, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como pueden ver, no fue por gran cosa que salí.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_001261",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así parece. Bien, ¿nos vamos de vuelta, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_yum_000919",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_zypressen_01_2"},
{"text"},
linkback="block_00289",
},
label = {
top={block="block_00000",label=1},
label01={block="block_00171",label=1},
label02={block="block_00173",label=1},
join={block="block_00175",label=1},
},
}
