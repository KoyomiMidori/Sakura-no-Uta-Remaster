},
},
text={
vo={
{"vo",file="fem_yum_000859",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hienas, tal cual lo dije. No lo voy a volver a repetir, lárguense de acá...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
