},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rna_001188",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué será que siempre haces estas cosas?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0012",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000863",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rna_001189",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
