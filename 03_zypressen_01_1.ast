},
block_00078={
{"fg",mode=-2},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=6},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001190",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Senpai, aléjate ya de Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0005",head="nao_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Es ella la que está agarrándome, no puedo hacer nada!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rna_001191",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Apártense ya!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Separo a los dos.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001192",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, dime...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0011",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000864",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿P-Por qué... tienes esa cara tan terrorífica, Rina?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué demonios está pasando? De repente vino Kawachino a abrazarme, no\nentiendo absolutamente nada.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rna_001193",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además dijo frente a todos que le gustabas.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0012",head="yum_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0015",head="yum_z1a",lv=4,id=5},
{"fgact",ch="優美",act="うんうん",time=200,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000865",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Uegh, uagh... Decirle a Kusanagi-senpai que me gusta hace que se me pudra\nla boca, así sea de mentiritas.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“K-Kawachino, ¿vienes a hacer lo que te viene en gana y ahora me faltas el\nrespeto?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000866",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lo que se me vino en gana? Dispersé a todas esas arpías que vinieron a atentar\ncontra tu vida, senpai. Deberías agradecerme.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a seguir con eso?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
