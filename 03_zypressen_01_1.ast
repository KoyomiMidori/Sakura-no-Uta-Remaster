astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c11_01",path=":ev/ev_eye_c11/",set="ev_eye_c11"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm030"},
{"eval",exp="g.start_zyp=1"},
{"text"},
text={
ja={
{
"Apenas nos acercamos a la colina de Yumenouki, Yuumi y yo nos encontramos con\nun gran grupo de gente.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El grupo parecía estar persiguiendo lentamente algo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"bg",file="cg_zbg041a",id=9,lv=9,speed=300000,path=":cg/",x2=800,y2=0,x=-400,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_jka_000021",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Oye, oye, ¿no es ese Naoya Kusanagi? El chico del que tanto hablan ahora.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000023",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Ah, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000010",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“Increíble, creo que es hasta más guapo que en la TV.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_rna_001172",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000837",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pasa algo, Rina?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rna_001173",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000838",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¡Pero si es Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_rna_001174",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, parece que Kusanagi-senpai está en camino al colegio.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000839",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Excelente, tenemos a senpai en la mira. ¡Acabemos con él para elevar un poco\nlos ánimos!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001175",ch="rna"},
},
ja={
{
name={"Rina"},
"“No entiendo nada de lo que acabas de decir.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_rna_001176",ch="rna"},
},
ja={
{
name={"Rina"},
"“En primer lugar, no puedes ni pensar en hacer eso. No ahora que se culminó 'Las\nhuellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000840",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué no? No veo ninguna relación causal entre esa obra y que no podamos\natacarlo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_rna_001177",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si es por eso, ¿entonces por qué se supone que tenemos que atacar a\nKusanagi-senpai en plena mañana? No hay ninguna causa para eso, en principio.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000841",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, para animar la mañana...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_rna_001178",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedes hacer eso solo para elevar los ánimos.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_rna_001179",ch="rna"},
},
ja={
{
name={"Rina"},
"“En fin, solo mira... Toda la cantidad de gente que hay tras senpai...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",mode=-2},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000022",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Wah, wah, es tal como salía en la tele.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000024",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Kyah~”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Una enorme cantidad de colegialas estaba siguiendo a Kusanagi-senpai por\ndetrás, en filas.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000842",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué hace esa manada de mujeres ahí? ¿Vinieron todas a matarlo?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rna_001180",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no, no son como tú. Allí no hay nadie capaz de hacerle daño a\nKusanagi-senpai. Son todas sus fans.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000843",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Fans? ¿Ehhh? ¿En el primer período tenía también tantas?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rna_001181",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se supone que a la luz pública Kusanagi-senpai quedó como el hombre que culminó\nla obra póstuma de su padre, 'Las huellas de los cerezos', ¿no recuerdas? Han\nestado hablando de eso todos los días en la TV, no hay lugar en el país donde\nno conozcan su rostro ahora.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000844",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hummm. Pero, tampoco es para que se agolpen de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rna_001182",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno, senpai es alto y guapo, ¿no? Además, es hijo de un artista de renombre\ninternacional, y si con eso no bastaba, es un genio que culminó la obra\npóstuma de su padre. Sería más bien raro que no cogiera popularidad.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000845",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mmmm, pero fue Akashi-senpai quien dirigió esa obra. Y nosotros, el club de\narte, quienes la culminaron.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rna_001183",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lamentablemente esa realidad no existe para los medios y la gente...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000846",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_001184",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que bueno, creo que es mejor por ahora tener algo de consideración y no\nhablarle a Kusanagi-senpai fuera de las horas del club.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000847",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"se",id=1,file="se_walk_fast"},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Yuumi comienza, de repente, a caminar rápidamente.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_rna_001185",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Y-Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Yuumi se le acerca a la espalda a Kusanagi-senpai. Y entonces, sin aviso\nalguno--",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0004",head="yum_z2a",x=-345,lv=5,id=5},
{"fg",ch="直哉",size="z2",mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000848",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Naoya-senpa～i♪”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0007",head="nao_z2a",x=345,lv=5,id=6},
{"fgact",ch="直哉",act="びっくり",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Uohh?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",ch="優美",speed=300,mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0004",head="yum_z2a",x2=-345,x=0,lv=5,id=5},
{"bg",time=300,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Abrazó al mismísimo Naoya Kusanagi por detrás.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001186",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Y-Yuumi?!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Q-Qué, qué es lo que pasa?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"mwact",act="rlr"},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000849",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Naoya～ senpa～i♪, buenos días～”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"bg",file="zbg038a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0004",head="yum_z2a",x=-345,lv=5,id=5},
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0006",head="nao_z2a",x=345,lv=5,id=6},
{"fg",ch="直哉",speed=500,mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0006",head="nao_z2a",x2=345,x=500,lv=5,id=6},
{"se",file="se3130",vol=70,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué mierda tramas, imbécil? ¿Por qué me abrazas de la nada? ¿D-Dinero? ¿Es\neso lo que quieres?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0009",head="yum_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000850",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿D-Dinero?...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0016",head="nao_z2a",x=500,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, volviste a tu forma de hablar de siempre.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0018",head="yum_z2b",x=-345,lv=5,id=5},
{"fgact",ch="優美",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000851",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0004",head="yum_z2a",x=-345,lv=5,id=5},
{"fgact",ch="優美",act="びっくり",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0003",head="yum_z2a",x=-345,lv=5,id=5},
{"fgact",ch="優美",act="うんうん",time=200,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000852",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Ahaa*☆, ¿pero qué estás diciendo, senpai? Yo no quiero dinero alguno～。 Si\nhay algo que quiero, es a ti. Me gustas demasiado.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0011",head="nao_z2a",x=500,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Yo? ¿A ti?”",
{"rt2"},
},
},
},
