},
block_00055={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0006",head="nao_z2a",x=500,lv=5,id=6},
{"fgact",ch="直哉",act="びっくり",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kawachino, nosotros no estamos saliendo!”",
