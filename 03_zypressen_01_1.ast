{"vo",file="fem_yum_000857",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Yuumi observa con ferocidad a Kusanagi-senpai.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Y parece estar además tocándolo con la punta de una de sus armas ocultas, por\ndetrás del bolso.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Lo está amenazando...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",x=500,lv=5,id=6},
{"fgact",ch="直哉",act="おじぎ",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Auh...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0016",head="yum_z2a",x=0,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0004",head="yum_z2a",x=0,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000858",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Ven? No lo niega en lo absoluto. Bien, pequeñas hienas, ahora que conocen la\nverdad, ¿podrían esfumarse de aquí?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
