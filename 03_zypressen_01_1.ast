{"text"},
text={
vo={
{"vo",file="fem_yum_000853",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es～”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0005",head="nao_z2a",x=500,lv=5,id=6},
{"fgact",ch="直哉",act="びっくり",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué diablos estás diciendo? ¿Es dinero lo que quieres, después de todo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0019",head="yum_z2a",x=-210,lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="びっくり",lv=5,id=5},
},
vl02={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0011i",head="yum_z2a",x=-210,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000854",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahn, pero qué cruel eres, insistiendo con eso de dinero, dinero. ¿Dónde quedó\ntodo el vigor de anoche?...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000023",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡¿Quién rayos es esta mujer?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"se",id=1,file="se_kyupin"},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2b0100",face="b0016",head="yum_z2b",x=-210,lv=5,id=5},
{"fgact",ch="優美",act="びっくり",lv=5,id=5},
{"fgact",ch="優美",act="icon",y=-500,lv=5,id=5,icon="icon11z2",x=50},
{"text"},
text={
vo={
{"vo",file="fem_yum_000855",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Tal como puedes ver, nada más ni nada menos que la novia de Naoya-senpai!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000025",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Eh? K-Kusanagi-senpai, ¿tenías novia?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0007",head="nao_z2a",x=500,lv=5,id=6},
{"fgact",ch="直哉",act="いいえ",lv=5,id=6},
{"text"},
