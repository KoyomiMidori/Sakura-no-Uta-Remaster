astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"¿Por qué?",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"¿Por qué no viene?",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"¿Por qué Kei no viene?",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Fridmann se marcha al hombro del escenario.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"¿Qué está pasando?",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"No entiendo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Me paro de mi silla y persigo rápidamente a Fridmann.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1b0000",face="b0009",head="fri_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué está pasando? ¿No es que llegará tarde, sino que no vendrá?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún sigue la ceremonia, ¿no? Además queda la fiesta de celebración.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_frd_000331",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No, Kei Natsume no vendrá.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues te estoy preguntando qué significa eso!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0008",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000332",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Hay alguien a quien debo comunicarle antes la noticia...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La noticia?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="フリッドマン",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Fridmann baja del hombro del escenario a los asientos.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Y con marcha apresurada llegó al asiento de Ai.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000333",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tengo algo que comunicarle, Ai Natsume.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Le habla a Ai.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001282",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_frd_000334",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es normal que se sorprenda. Este es el número del hospital.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
"¿Hospital?",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"¿Qué quiere decir con hospital?",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"¿Por qué ha salido la palabra hospital en esa conversación?",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Ai se apresura a llamar.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"se",file="se1343",sync=1,id=1},
{"se",file="se3434",id=1},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001283",ch="aid"},
},
ja={
{
name={"Ai"},
"“B-Buenas tardes, mi nombre es Ai Natsume, hay un paciente con ustedes llamado\nKei Natsume...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"¿Paciente?",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"¿Qué quiere decir con eso?",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001284",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... sí... sí...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q-Qué ha sucedido, Fridmann?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_frd_000335",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Lo mismo quisiera saber yo...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000336",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Kei Natsume no venía, así que entre todo el personal comenzamos a buscarlo de\ntodas las maneras posibles...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_frd_000337",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fue entonces que nos enteramos que había sido llevado a un hospital.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Hospital?! ¡¿Qué está pasando?!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0020",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001285",ch="aid"},
},
ja={
{
name={"Ai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",file="se2766",id=1},
{"text"},
text={
ja={
{
"Ai se desmorona de rodillas al suelo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿A-Ai?!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_aid_001286",ch="aid"},
},
ja={
{
name={"Ai"},
"“K-Keiii...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_frd_000338",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡Damn it!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Fridmann soltó un grito de furia que jamás le había escuchado antes.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c60_01",time=2000,path=":ev/ev_uni_c60/",set="ev_uni_c60"},
{"bgm",file="bgm002"},
{"text"},
text={
ja={
{
"Este cuadro lo pinté con un estilo muy ilusorio.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Pues pensé que mientras más tinte fantástico le diera, más clara se haría la\nmuerte realista.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Una infinidad de mariposas cruzando el mar.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Sus aleteos van dirigidos a alguna tierra lejana.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Nadie sabe adónde.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Lo único que se sabe es que frente a ese ilusorio paisaje se encuentra el\ntranslúcido mar, de donde surge un remolino entre olas.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"El mar está retratado de manera realista y gráfica.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Esto insinúa la muerte, y por lo tanto decidí pintarlo de manera que resaltara.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Es solo un instrumento para transmitirle tal sentimiento a las personas.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Es solo un cuadro para adentrar al espectador en ese mundo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y a pesar de eso.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="zev_uni_c62_01",zoom=70,speed=120000,path=":ev/ev_uni_c62/",set="ev_uni_c62",x2=0,y2=620,x=0,y=947,ax=1920,ay=2125,bx=-960,by=-1585},
{"text"},
text={
ja={
{
"Siento que me adentré y me perdí en mi propio cuadro.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Ese mundo de sensación ligera. Es como si deambulara allí.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Sale humo del crematorio.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Ya he visto este panorama una vez en este mismo año.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Pero la situación es distinta a aquella vez.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"La muerte de Kenichiro Kusanagi fue una muerte asumida y aceptada.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y para asumirla, el viejo y yo intercambiamos palabras incontables veces, y\nllegamos a hablar incluso sin palabras.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"'Una espléndida confusión de epitafios.'",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Esa fue la ceremonia que hicimos para tal fin.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Kei Natsume salió de su casa en su motocicleta.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Debió haber tomado la carretera nacional, pasar a la autopista y venir a la\nciudad.\nDebió.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Pero no pudo siquiera salir de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Todo sucedió en una vía que conocemos muy bien.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"La intersección nacional de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Al parecer, una niña saltó a la vía de imprevisto.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Al ver eso, Kei decidió instantaneamente interponer su motocicleta para cambiar\nla dirección del camión que venía.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"No fue un problema mecánico.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"El mismo Kei decidió chocar su motocicleta.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Por supuesto, él saltó de la misma.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"La motocicleta impactó con el camión.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"El camión se paró, habiéndose llevado la moto en sus ruedas frontales, y la\nniña se salvó.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Y él no sufrió herida alguna.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Solo tenía un pequeño rasguño que se hizo al saltar.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"El Kei que yo vi――",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_uni_c62_01",y=520,time=2000,path=":ev/ev_uni_c62/",set="ev_uni_c62",ax=960,ay=1062,bx=0,by=-522},
{"text"},
text={
ja={
{
"No parecía tener herida alguna,\nera solo como si hubiese perdido su alma.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Y parecía,\nque esa alma, regresaría fácilmente.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"No solo yo.\nTodos pensaron lo mismo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Pero,\nel doctor anunció sin piedad alguna su muerte.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Jamás podrá volver a pararse,\nni correr,",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"ni reír,\nni pintar――",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"¿Cómo puede ser?",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"No tiene ni una sola herida encima.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Da la impresión de que con una cachetada podrías despertarlo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"De hecho, eso fue lo que Ai hizo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Pero, no es así.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"La verdad es que,",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"por más que le llamemos,\nque gritemos,\nque le peguemos,",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"que lo abracemos...\nél no se moverá.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Su mano,\nestaba fría.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"¿En serio tenemos que despedirnos de esta forma?",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Sin indicio,\nni rastro alguno.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Vamos, solo tiene los ojos cerrados.\nSolo tiene las manos un poco frías, demonios.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"¿Me estás diciendo,\nque ya no podré verlo jamás?",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"¿Ya,\nno podremos caminar juntos de nuevo?",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"¿Ya,\nno podremos pintar juntos de nuevo?",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"¿Semejante ridiculez es...\nposible?",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Ganaste un premio de renombre internacional.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"El Airain Otarie de Moore, ¿sabes? Es un premio grandísimo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Todos los artistas se mueren por conseguirlo, pero está en tal lugar que así te\ngastes toda la vida, podrías no alcanzarlo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Así me pasó a mí.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Yo fui uno de tantos que no lograron alcanzarlo.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"¿Pero sabes?\nCuando terminé el cuadro pensé en secreto,no debe haber cuadro\nmejor que este.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Aun teniéndote de oponente, tenía seguridad de que yo estaba por encima.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Hasta ver aquel cuadro.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Dos girasoles.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Solo dos girasoles floreciendo.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Es la temática más aburrida que podrías tomar.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Y aun así, no hay nadie que pueda pintar semejante cuadro con esa temática.\nNi siquiera mi viejo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"El único en este planeta que puede pintar algo así,\neres tú.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Ya todos reconocieron eso,\nya te convertiste en un artista de nivel internacional.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Vamos, mierda,\nya llegaste a donde querías llegar.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Vamos, sonríe.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Te lo ruego, sonríe, alégrate, celebra.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Eres un genio,\nya lo reconocieron.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Ya el mundo te reconoció como uno.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Así que... por favor... sonríe...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"El humo se eleva.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Como las mariposas que pinté.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Bellas, irreales.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Pero la realidad que yacía debajo era evidente, y terriblemente clara.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Las mariposas no sonríen.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Solo vuelan, y se marchan.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"A un lugar inalcanzable.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Las mariposas se van, sin sonreír.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Toritani se desmoronó en lágrimas.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Shizuku estaba fuera de sí.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Akashi estaba furioso.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Rin no vino al funeral.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Kei... ¿Sabes algo?",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Me quedé parado,\nsin hacer nada, ni llorar, ni enfadarme.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Eran tantos sentimientos acumulados que ni siquiera sabía cuál era el más\nintenso de todos.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Ah,",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"la realidad es clara.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"La realidad es",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"terriblemente translúcida,\nsin fondo.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bgm",stop=1,time=2000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No recuerdo más de lo que sucedió después.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Al recuperar la consciencia, me encontré con una cálida sensación\nenvolviéndome.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Era la sensación de Ai abrazándome en lágrimas.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="ev_com_i08_01",time=2000,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"bgm",file="bgm035"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001287",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota... ¿Qué estás haciendo?...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que... qué?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Al observar con cuidado, me di cuenta que la camisa de Ai estaba manchada de\nsangre.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai... ¿Te heriste?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_001288",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pero qué estupidez dices? Eres tú el que está herido.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Me toco la cara.\nSentí algo protuberante, seguido por algo húmedo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me... golpeé la cabeza?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001289",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Yo qué sé?! ¡Apenas regresé, estaba la habitación hecha un desastre, y una\nbotella de alcohol tirada en el suelo! Y... te encontré, tirado en el suelo,\nbañado en sangre...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_aid_001290",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué... demonios haces?...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo?...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Veo a mi lado y me encuentro con una botella con licor ámbar en el suelo.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es... la valiosa botella de licor... que Wakata me dio...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"¿Me la tomé? ¿Me la tomé toda?",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001291",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Idiota! ¡¿Si es tan valioso el licor por qué te lo tragas de esa manera?!\n¿Por qué... te la bebiste al punto de perder el control?...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001292",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo, me... me preocupé bastante... Te lo ruego, no me traigas más tristeza de la\nque tengo ya...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Perdí, el control? Ah, lo siento. Limpiaré todo ya...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_i08_03",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001293",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tonto...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Ai me abraza.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Si sigues abrazándome así no podré limpiar.\nVamos, mira que hay vidrio regado en el suelo, Shizuku podría lastimarse.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001294",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué eres así?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué me estás preguntando?... Ya está, perdón por haberme puesto a beber y\nperder el control. Realmente me siento mal, ten por seguro que limpiaré y\npagaré lo que rompí.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_i08_01",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001295",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Por qué?! ¡¿Por qué eres así?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás enojada?... Ya te dije que limpiaré...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001296",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué incluso en estos momentos intentas ser fuerte?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy intentando ser fuerte...\nAlguien así no se pondría a beber alcohol de esta forma, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo juro, solo bebí y perdí el control... De verdad, lo siento...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_aid_001297",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mentiras... Lo único que sale tu boca son mentiras...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_i08_03",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001298",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo, yo te he estado viendo desde que naciste, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_aid_001299",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cuando Mizuna nee-sama te dio a luz, yo... te cargué...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_aid_001300",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para ser sincera, me sentí frustrada...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_i08_04",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001301",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eras el hijo de las dos personas que tanto quise, Mizuna nee-sama y\nKenichiro...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_aid_001302",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sentí envidia de ti... y también muchísimo amor...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_aid_001303",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso me sentí realmente feliz cuando pudimos volver a vivir juntos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_aid_001304",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ustedes me hicieron feliz como nunca.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_aid_001305",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei, Shizuku, y tú... No duró ni un año, pero... realmente fui feliz...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_i08_03",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001306",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso mismo, yo también sé...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_aid_001307",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sé cómo se sintieron ambos respecto a ese premio. Kei y tú...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001308",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nosotros también nos sentimos tristes. Estamos tristes, es obvio.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_aid_001309",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero lo que hubo entre Kei y tú no fue solo eso.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_aid_001310",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tu tristeza y la relación entre los dos,\nno se trata de simplemente haber perdido un ser querido.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_aid_001311",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo que hubo entre Kei y tú no fue simplemente eso.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_aid_001312",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y aun así, te empeñas en intentar ocultar incluso eso.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_aid_001313",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es que tienes que hacerte el fuerte en este momento?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_aid_001314",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué aun en esta situación no intentas apoyarte en mí?...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_aid_001315",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué... intentas cargar con todo solo?...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_i08_03",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001316",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja... De verdad, es una historia tremendamente ridícula... Tanto que ni\nganas me dan de contarla.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo absurda que es...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_i08_04",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001317",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quiero que me cuentes... esa historia ridícula... Quiero que me hables de\nella...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... pero te advierto, realmente es estúpido.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así, así como me ves,\nme sentía feliz estando junto a Kei.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estando con él me hacía sentir como si todavía fuese un pintor.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no, yo no podía pintar absolutamente nada...\npero aun así, él decía que yo era su rival.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una locura, ¿verdad? Llevaba seis años sin pintar nada.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aun así... decía que yo era su rival. A mí, a un tipo como yo...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001318",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso mismo seguiste pintando a escondidas, ¿o no?...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí pintaba, pero solo practicando.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Practiqué, sí. Hasta entonces podía volar con libertad, y por más que perdiera\ntoda la fuerza, la idea de no poder volver a volar me aterrorizaba.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso practiqué diligentemente con mi mano izquierda...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es práctica, después de todo. No es lo mismo a invertir tu propia sangre y\nsudor para crear algo.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pude estar a la altura de las expectativas de Kei...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se enfadaba conmigo por no pintar.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero eso no fue más que amabilidad de su parte.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él me estaba esperando, y se enojaba porque quería que llegara rápido a él.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y me confié de esa amabilidad suya...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso, por eso yo también sentía.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sentía levemente que quizá algún día podría volver a pintar como antes.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que con el tiempo podría volver a pintar como antes... Tenía esa ridícula\nilusión.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo con estar con él sentía que podría volver a ser como antes...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre se la pasaba repitiendo como un loro que él y yo éramos genios,\npero――”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que hacía yo era llamarlo idiota, tonto. Pero...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también pensaba lo mismo...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veía el día en que pintaríamos como iguales,\ntal vez como artistas triunfando por el mundo.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sonará como a fantasías de niño, pero...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, era ese sueño lo que me mantenía a flote...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso que él decía...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo de convertirnos en artistas de renombre internacional.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso era lo que yo quería.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y me sentía tranquilo cuando me lo decía.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué hice yo? He tenido tanto tiempo desde que lo conocí y nunca llegué a\npintar nada.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuvo esperándome todo, todo, todo este tiempo...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a pesar de eso... yo no hice nada...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_aid_001319",ch="aid"},
},
ja={
{
name={"Ai"},
"“Claro que no. Cumpliste con lo que te pidió.\nEse cuadro fue hermoso.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero Kei no pudo verlo!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi obra maestra, el cuadro que pinté para nuestro duelo.\nNi siquiera pude mostrárselo...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que quedó fue la realidad de que no pude alcanzarlo...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cuadro al cual le puso tanto esfuerzo.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llegó a un lugar muchísimo más lejano que yo...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_aid_001320",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Y qué podías hacer?... No es que estuvieses perdiendo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_aid_001321",ch="aid"},
},
ja={
{
name={"Ai"},
"“Todo lo hiciste para proteger a varios...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y debería usar eso como excusa para disculparme por no haber pintado?!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_aid_001322",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esa mano derecha tuya sirvió de sacrificio para salvar a muchos...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_aid_001323",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo lo sé...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No debí haberlos salvado entonces?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_aid_001324",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será que no debí haber salvado a Rin aquella vez?\n¿Será que no debí haber usado lo poco que me quedaba de fuerza por Rina?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso no debí haber ocultado lo de mi brazo derecho?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que tomé la decisión equivocada?!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldita sea...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que todo lo que pensé que estaba bien en su momento era en realidad un gran\nerror?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Debí haberme evitado toda esa ridícula bondad y mejor cuidar mi mano derecha?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si eso hubiera hecho, habría pintado con Kei.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Habría sido un verdadero rival para él.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo habría hecho esperar.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Dime, Ai!\n¡¿Es que, es que las elecciones que tomé no fueron las correctas?!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que, es que yo... es que tiré a la basura mi sueño por mis propias\nacciones?! ¡¡Respóndeme, Ai!!”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Dime algo! Aiii...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_aid_001325",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tu sueño... era caminar el sendero de la pintura junto a Kei...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_aid_001326",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y llegar, a la cima de ese mundo...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, él me inspiraba. No tenía prueba alguna de eso, pero estaba seguro que en\nel futuro ambos llegaríamos a lo más alto del mundo artístico.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa era la visión de los dos de la que él siempre hablaba.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y yo siempre le respondía despectivamente, como si fuese un tonto. Pero...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En realidad, yo también tenía el mismo sueño que él.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei... Keiii...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_aid_001327",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya, ¿de verdad crees que todas tus decisiones fueron equivocadas?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_aid_001328",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad piensas que no debiste salvar a Rin? No, no solo eso, tú siempre has\nsido así. Siempre perdiendo algo por el bien de otro.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"bg",file="ev_com_i08_04",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001329",ch="aid"},
},
ja={
{
name={"Ai"},
"“Realmente eres un hombre impresionante... Eso no es algo que cualquiera pueda\nhacer.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_aid_001330",ch="aid"},
},
ja={
{
name={"Ai"},
"“Le acabas de llamar a eso, bondad ridícula...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_aid_001331",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero a nadie se le ocurriría intentar salvar a alguien a costa de uno propio\nsolo por bondad.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_aid_001332",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y no solo a costa de tu mano derecha... Tu herencia también...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Pero por todo eso terminé aplastando el sueño de Kei!!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei me veía como un rival a mí, y aun hasta el final no pude hacer lo que debía\npor él.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pude hacer nada digno de un verdadero rival.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_aid_001333",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entonces.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_aid_001334",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Dices que por eso has estado equivocado?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_aid_001335",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es que fue un error haber salvado a todos los que salvaste?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"select",file="05_the_happy_prince_08b_1",text="select"},
{"select",label="label02",text="select"},
{"select",name="select05_07_1",mode="sys"},
{"text"},
select={
ja={
"Sí, todo fue un error.",
"No lo sé.",
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, por eso te pregunto, Ai.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que he estado equivocado?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai! ¡Respóndeme!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_aid_001338",ch="aid"},
},
ja={
{
name={"Ai"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_aid_001339",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso... solo tú lo puedes decidir...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="fem_aid_001340",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es fácil saber si tus decisiones pasadas estuvieron erradas. Quizá incluso\nnunca lo sepas, y terminen atormentándote toda tu vida...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_aid_001341",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y eres tú quien debe decidir eso.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="fem_aid_001342",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si lo ves como un error, error será.\nPero si aún te parece que no lo es, quisiera que me dieras tiempo para responder.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"bg",file="ev_com_i08_05",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001343",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro me salvó a mí, y por eso le estoy agradecida.\nMe dolería si algún día me dijeran que sufrió por eso.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_aid_001344",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y creo, probablemente, que aquellos a quienes salvaste piensan igual.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_aid_001345",ch="aid"},
},
ja={
{
name={"Ai"},
"“A mí también me duele que digas que todo fue un error. Ni siquiera sé cómo\npodría disculparme, pues Shizuku, mi hermana, tú...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001346",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdí el control por un momento.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo creer que intenté interrogarte si mis decisiones fueron o no\ncorrectas...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo mismo debo encargarme de mis propias decisiones. No hay de otra.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no soy el único que intentó salvar a otros a costa de uno mismo.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo y la abuela Natsume también hicieron lo mismo. Perdieron casi todo\npara salvar a esta familia.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aquí estoy yo quejándome, como si fuese el único que ha perdido algo...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué estúpido he sido.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que puedo pintar...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque ya no tenga mi mano derecha, ni pueda pintar algo al nivel de una\nexposición... Todavía puedo seguir pintando...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así sea chatarra.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así ya no pueda llegar al nivel de Kei...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso ya no importa...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que pintar, para mí, ya no es más parte de ese sueño que teníamos los\ndos...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="fem_aid_001347",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, no es que lo haya resuelto todo ya en mi mente, ni he aceptado lo\nque ha pasado aún.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... al menos ya puedo ponerme de pie.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta hace un rato todo estaba vertiginoso, deforme.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era como tener un abismo debajo.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ya no...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me he recuperado. Todavía no logro organizar nada en mi cabeza.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero por lo menos ya puedo ponerme de pie...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, Ai.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando sienta que no pueda caminar, creo que te pediré que me sostengas.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya... no tengo la seguridad de poder avanzar por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="fem_aid_001348",ch="aid"},
},
ja={
{
name={"Ai"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, Ai... Quédate a mi lado... acá, juntos, en la residencia Natsume...”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"bg",file="ev_com_i08_04",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001349",ch="aid"},
},
ja={
{
name={"Ai"},
"“Comprendo, está bien.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando seas tú quien no pueda avanzar, yo te sostendré...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
vo={
{"vo",file="fem_aid_001350",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué cálidas son tus piernas...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"bg",file="ev_com_i08_05",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001351",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, me trae recuerdos del pasado...”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuando era niño?... Eso fue hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"bg",file="ev_com_i08_04",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001352",ch="aid"},
},
ja={
{
name={"Ai"},
"“Parece que no podrá regresar a casa por un tiempo.\nEl shock fue fuerte... Está fuera de sí ahora.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="fem_aid_001353",ch="aid"},
},
ja={
{
name={"Ai"},
"“El señor Fridmann está cuidándola.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_aid_001354",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_aid_001355",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hay por qué.”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"bg",file="ev_com_i08_05",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
ja={
{
"Ai sonrió.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Jamás había visto una sonrisa tan triste en ella.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"bgm",stop=1,time=2000},
{"bg",time=2000,file="black",path=":bg/"},
{"ex",time=2000,func="wait"},
{"text"},
text={
ja={
{
"Al final del año, las noticias no paraban de reportar acerca del joven\ngalardonado con uno de los más grandes premios artísticos y su repentina\nmuerte.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"Tenía más cobertura que las propias noticias de farándula.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"Como cosa obvia, los medios vinieron todos los días a hacer preguntas, pero no\nllegamos a salir de casa.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
"No teníamos las ganas.",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"En otro día de tantos, se anunció la culminación de la selección final y la\nentrega de los tres grandes premios de la Exposición Moore.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"No sé cuándo se realizó.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Me dio por encender el televisor y apareció la transmisión.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"El lugar era en Nueva York.\nProbablemente era la ceremonia de entrega del Platine Épaulard.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"El presentador del canal tenía una voz muy emocionada.",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"A pesar de eso, me quedé viendo indiferente, sin mucho interés.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
"Fue entonces que apareció aquel cuadro.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
"Tenía de nombre 'Una espléndida confusión de epitafios'.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"El público se quedó en silencio.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"No, era más bien como si se hubiese congelado.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Más que emoción, el estremecimiento parecía haberse apoderado del lugar.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
"Vi el cuadro, y de cierta forma supe de qué se trataba.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
"Ah, claro... Sí, tal vez...",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"Fridmann apareció en la televisión con una breve transmisión.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="man_frd_000339",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Me siento alegre de poder hacer entrega del Platine Épaulard.”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
vo={
{"vo",file="man_frd_000340",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Una artista como ninguna ha habido. La más despiadada y fiel a la estética.\nSu nombre quedará escrito con pavor en la historia.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"bg",file="zev_com_i09_01",speed=120000,path=":ev/ev_com_i09/",set="ev_com_i09",x2=50,y2=-140,x=410,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Había una muchacha parada a su lado.",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
"Una cara conocida.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"Esa que Kenichiro Kusanagi calificó de genio.",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"De cuya técnica hablaba como algo mágico, inhumano. Como si tuviera a Dios\nadentro.",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"La personificación de la estética.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"bg",file="ev_com_i09_01",time=2000,path=":ev/ev_com_i09/",set="ev_com_i09"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Mi amiga de la infancia.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
"Una terriblemente honesta, amable, e inteligente chica.",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
"Esa imagen he tenido de ella desde hace tiempo.",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
"Alguien que no parecía pertenecer a ese mundo.",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"Pero sus ojos eran distintos a aquellos de la Rin que conocí.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
"En sus cálidos ojos había algo de locura oculta.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
"La maldición de la estética.",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Así lo denominó Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
"Desconozco la razón.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Pero la genio puso pies de nuevo en nuestro mundo.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="05_the_happy_prince_08_1"},
{"text"},
linkback="block_00361",
},
label = {
top={block="block_00000",label=1},
label02={block="block_00270",label=1},
},
}
