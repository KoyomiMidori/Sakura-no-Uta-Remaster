astver = 2.0
astname = "ast"
ast = {
block_00000={
{"fg",mode=-2,sync=0},
{"bg",file="bg050a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm030"},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000223",ch="rnd"},
},
ja={
{
name={"Rin"},
"“I-Increíble... ¿Hay otra sala de arte dentro de la sala de arte en este\ncolegio?...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0003",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-570,lv=4,id=3},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000463",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta es la verdadera sala de arte... O, más bien, el lugar donde Kusanagi pasa\nel tiempo. La verdad es que es el atelier del profesor, pero el mismo\nprofesor no tiene mucha motivación para trabajar, así que por lo general está\nlibre para nuestro uso.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000464",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes? En esta sala hay un desván. ¿Quieres verlo?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000224",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un desván?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000465",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, creo que es raro ver un atelier con desván en otros colegios, ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",time=500,mx=-40,mode=-1,lv=4,id=3},
{"fg",ch="稟",time=500,mx=-40,mode=-1,lv=4,id=9},
{"fg",ch="圭",time=500,mx=-40,mode=-1,lv=4,id=4},
{"ex",time=300,func="wait"},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"ex",time=500,func="wait"},
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",time=500,mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-570,lv=4,id=3},
{"fg",ch="稟",size="z1",time=500,mx=-40,mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"fg",ch="圭",size="z1",time=500,mx=-40,mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=570,lv=4,id=4},
{"ex",time=300,func="wait"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000225",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay bastantes instrumentos acá... Y también hay bastantes lienzos...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000466",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son las pinturas que han dejado todos los miembros que han pasado por el club\nde arte. No las tengo registradas por completo, pero... realmente hay\nbastantes, eh.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0019",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="man_ked_000654",ch="ked"},
},
ja={
{
name={"Kei"},
"“Bueh, ninguno de esos pintores nos llegan a los pies a Naoya y a mí. No creo\nque puedan con nosotros, aunque se vengan con montañas de pinturas.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás haya alguna pintura de Kenichiro Kusanagi. ¿Crees poder ganarle a eso?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=570,lv=4,id=4},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_000655",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"msgoff"},
{"ex",time=100,func="wait"},
{"se",file="se9003",id=1},
{"fg",ch="圭",mx=1280,mode=-1,lv=4,id=4},
{"ex",time=500,func="wait"},
{"se",file="se9006",id=2},
{"ex",time=100,func="wait"},
{"se",file="se1107",id=3},
{"cgact",stage="bg051",act="びっくり"},
{"ex",time=500,func="wait"},
{"cgact",stage="bg051",act="いいえ"},
{"ex",time=1000,func="wait"},
{"se",stop=1,id=2,time=500},
{"se",stop=1,id=3,time=500},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x2=-570,x=-345,lv=4,id=3},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0015",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000467",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Ya no hay. Para eso sí me tomé el trabajo de averiguar.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Toritani responde un tanto irritada. Para ella, esa es la reacción más natural.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Toritani dijo 'no las tengo registradas por completo'. Aunque no sea por\ncompleto, debe haber revisado ya qué clase de pinturas hay en general.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000226",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kenichiro Kusanagi? Esto, te refieres al padre de Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000468",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, Kenichiro Kusanagi es egresado de este colegio. Y fue, aunque solo por un\ncorto tiempo, profesor de arte de este mismo colegio también.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wakata es el que más sabe de eso.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000227",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wakata-san es...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000469",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal vez aún no sepas quién es, Rin-chan. Es el profesor de arte de nuestro\ncolegio. Según parece que fue alumno de Kenichiro Kusanagi cuando aún era\nprofesor.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000228",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, y-ya veo. Es increíble tener como profesor de arte a alguien que haya\nrecibido clases de alguien tan famoso.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000470",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si es por eso, Kusanagi es el hijo de ese alguien tan famoso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La fama de Kenichiro era nada más la dudosa fama de estafador que tenía, ¿no?\nEs bastante sospechoso hoy en día que un artista termine siendo famoso.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000471",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No eres nada sincero contigo mismo, eh. Además, ¿no acabas de sugerir hace un\nmomento que ni tú ni Kei podrían ganarle a una de las pinturas de Kenichiro\nKusanagi?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ciertamente, aun con esa manera de ser que tenía, era un profesional...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"fg",ch="圭",size="z1",my=40,mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="man_ked_000656",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sea quien sea el oponente no voy a perder. ¡De ninguna manera!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De dónde sale toda esa confianza tuya?...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Las pinturas que él hacía cuando tenía nuestra misma edad eran de otro nivel.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Sus habilidades básicas de dibujo y diseño eran, sin duda alguna,\nincreíblemente altas.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Y su habilidad de expresión también...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000472",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué la cara complicada? ¿Qué? ¿Estabas pensando en si podrías ganarle a tu\npapá?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000473",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo dices puras mentiras, estuviste recordando las pinturas de Kusanagi\nKenichiro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000474",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, en lo que respecta a las pinturas que hizo cuando tenía nuestra misma\nedad... Realmente eran terriblemente excepcionales. Da miedo pensar de que\nera capaz de pintar esa clase de obras a esa edad...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las has visto?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Se supone que ninguna de las obras que pintó antes de volverse profesional\nfueron publicadas.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Aunque, habían algunas que habían quedado en mi casa...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000475",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás no lo sepas, pero la verdad es que estaban enterradas en esta montaña de\npinturas. Las obras de Kenichiro Kusanagi de cuando era aún un estudiante del\ncolegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero acabas de decir que no habían.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000476",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dije que YA no hay, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000657",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=3},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000477",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No miento. Fui yo quien las encontró. Las encontré 3 meses después de haber\ningresado al club. ¿No será que tengo un gran talento para cazar tesoros?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000658",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué es eso? ¿No son esas grandes noticias? ¿Por qué no se formó ningún\nescándalo al respecto?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000478",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Porque el profesor Wakata contactó directamente a Kenichiro Kusanagi y se las\nenvió a Nueva York. Así que no sucedió nada.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hubiera sido después de su muerte si se hubiera formado un gran alboroto,\npues Wakata y Kenichiro eran buenos amigos.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No le informó tampoco al colegio? Si lo hubiera hecho, por lo menos se\nhubieran formado rumores al respecto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0008",head="mak_z1d",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000479",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, a lo mejor. ¿Aunque, tal vez no quería crear mucho tumulto con el asunto?\nTerminó mandándolas en absoluto secreto.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Toritani dice eso sin ningún tapujo. Y pensar que si eso hubiera salido a la\nluz, ella misma habría sido la beneficiada...",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000659",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No recibiste ninguna recompensa? Encontraste varias de las pinturas de\nKenichiro Kusanagi, algo debieron haberte dado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000480",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Si es por recompensas, me dejaron cuidar de las obras por unas semanas.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000660",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Solo cuidarlas?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000481",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Quería investigar qué clase de obras había pintado Kenichiro Kusanagi\ncuando tenía nuestra misma edad, así que todos los días me quedaba\nobservándolas, detenidamente y sin parar.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Cuáles fueron los resultados de tu investigación?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=3},
{"fgact",ch="真琴",act="いいえ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000482",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, ciertamente, los genios están en otro lugar totalmente distinto. No pude\ndejar de sentirme nunca admirada y cautivada por lo que vi, pero no encontré\nnada que me sirviera de referencia para mí misma.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000661",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Así de increíbles son las obras de Kenichiro Kusanagi que fueron incluso\ncapaces de volver humilde a la tan engreída Makoto?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-345,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0027",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000483",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, realmente son increíbles. También descubrí otras cosas más... En\nparticular, la razón por la cual las posteriores pinturas de Kenichiro\nKusanagi tenían ese manejo tan excepcional del pincel...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
ja={
{
"Al decir eso, Toritani observó de reojo mi mano derecha.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Escondo mi mano derecha de una manera poco natural.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000662",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cómo era? Averiguaste de qué manera manejaba el pincel en sus obras, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000484",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, no es nada que sea de tu incumbencia, Kei.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000663",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué demonios?! ¡¿Por qué no es de mi incumbencia?! ¡¿Es porque estás\nburlándote de mí?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es por eso. Tu técnica no necesita la técnica de Kenichiro Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000664",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué rayos quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000485",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Debes pintar de manera libre, sin preocuparte por las pinturas de los demás.\nEres un autoproclamado genio, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000665",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cómo que autoproclamado? Yo soy un genio. Y Naoya Kusanagi también lo es. Y un\ngenio de tal magnitud que no se queda detrás de Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues debes tener alguna otra cosa en lugar de ojos como para decir eso...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000666",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡Tu tampoco te sientes con ganas de perder, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-345,lv=4,id=3},
{"fgact",ch="真琴",act="うんうん",size=5,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000486",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje, ciertamente. Ese es el ímpetu que necesito de ustedes en este club. Por\ncierto, Rin-chan, ¿tienes experiencia previa pintando?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000229",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, solo un poco de las clases en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000487",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Te gusta pintar? ¿O no?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000230",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me gusta tanto que consideré entrar al club de arte. O, al menos eso quisiera\ndecir, pero...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000231",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, para ser sincera, aún no sé con certeza si me gusta o no. Nunca me he\npuesto a pintar seriamente antes.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000488",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eres bastante seria, eh. Pero, a mi parecer no tienes por qué complicarte mucho\nrespecto a eso.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000232",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, por ahora me esforzaré y trataré de pintar.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0004",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000489",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Lo mejor es comenzar tratando de pintar algo.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Toritani levantó un lienzo completamente nuevo.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000490",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, esté será el lienzo de la primera pintura en óleo de Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Toritani le da un lienzo nuevo a Rin.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Y Rin lo recibió.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bgm",stop=1,time=1000},
{"fg",mode=-2},
{"bg",file="ev_com_a22_01",rule=139,vague=40,path=":ev/ev_com_a22/",set="ev_com_a22"},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000233",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm... Esto es...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_ked_000667",ch="ked"},
},
ja={
{
name={"Kei"},
"“Carboncillo. Le llaman carboncillo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000234",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Carboncillo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Rin observa el carboncillo que Kei le dio.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_ked_000668",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000236",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_ked_000669",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué sucede? Te quedaste en silencio apenas agarraste el carboncillo...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000237",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000491",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei, ayúdame a ajustar la posición entre el caballete y el objeto para que ella\nno tenga que mover su cara...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_ked_000670",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ouh!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Los dos arreglamos todo apresuradamente para Rin. Una vez revisé lentamente el\ncaballete y el objeto...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes dos, muévanse un poco...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="black",path=":bg/"},
{"se",file="se3402",id=1},
{"ex",time=1000,func="wait"},
{"bg",file="ev_com_a22_02",path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tal así?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000238",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, así está bien.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes que preocuparte de pensar nada innecesario, dibuja como quieras\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000239",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por otro lado, ¿estás bien con eso? Hay lápices también.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000240",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, e-estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, entonces comienza dibujando algo por ahora.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Rin sigue moviendo el carboncillo entre sus dedos, como si no supiera qué\nhacer.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000492",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Vaya, pero si te está quedando bien el papel de profesor! ¡Desde la destreza\narreglando los instrumentos hasta las indicaciones, todo!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No basta con que simplemente me quede bien el papel...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_com_a22_03",sync=0,face=1,time=400,path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000241",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000242",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hnn...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"se",id=1,file="se2131"},
{"bg",file="ev_com_a22_05",path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000243",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A-Are? ¿Arere?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás aplicando mucha fuerza.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sostenlo de una manera más suave.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_a22_03",path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000244",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hnn... ugh... nn.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000493",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O-Oye... Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa, Toritani?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000494",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será que Rin-chan es... torpe?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí. A juzgar por lo que veo, lo es.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",id=1,file="se2131"},
{"bg",file="ev_com_a22_05",sync=0,face=1,time=400,path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000245",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento. Volví a romperlo de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes. Los carboncillos son suplementos desechables. Por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Saco unos cuantos lápices de la caja de lápices.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Tomé unos cuantos lápices que elegí de entre todo el surtido y se los doy a\nRin.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ahora, usa estos lápices. El filo de la punta y el tono deberían ser los\napropiadas para la fuerza que aplicas con tu mano al dibujar.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000246",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_a22_06",path=":ev/ev_com_a22/",set="ev_com_a22"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000495",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Me había parecido que era torpe, pero su dibujo es bastante preciso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000496",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmm. Kusanagi, pareciera que hubieras sabido desde un principio que su forma de\ndibujar cambiaría al darle un lápiz.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es que lo supiera. Simplemente se notaba a simple vista que no sabía\nmanejar bien el carboncillo.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000497",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Ciertamente, el carboncillo es algo difícil de usar para los novatos...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Si realmente ser un principiante fuera la causa, no habría problema...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Sin embargo, el carboncillo es carbón como tal. Evoca a algo que ha sido\nquemado o incendiado...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg049c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",mode=-2,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000247",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Ya el sol cayó bastante.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000671",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ajajaja, eso es porque ambos estaban bastante concentrados! Tanto Rin- chan\ncomo Naoya...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ver, muéstrame.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000248",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, realmente es terrible, pero... aquí está.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_ked_000672",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿A ver?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000498",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo también quiero ver.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_ked_000673",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No está bien como para ser el dibujo de una principiante?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000499",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Está muy bien dibujado.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Ciertamente, dibujó muy bien.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Era algo de ese nivel.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, aquel hombre había dicho esto.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_f02_01",path=":ev/ev_com_f02/",set="ev_com_f02",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_kid_001010_n",ch="kid"},
},
ja={
{
"'Aunque llegues a encontrarte de nuevo con Rin, no tienes nada de que temer.\nSeguramente ella será la misma chica mansa y pacífica que conoces.'",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg049c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",mode=-2,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Supongo que es obvio...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000249",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ¿n-no está bien?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000500",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que qué cosa? Cualquiera se sentiría mal si lo observaran con esa cara tan\ncomplicada que llevas ahora. Y bien, Kusanagi-sensei, ¿qué piensas respecto a\neste dibujo?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está nada mal. Está muy bien dibujado.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000250",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien dibujado.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000251",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué alivio.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000674",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Qué bien, ¿no?! ¡Bien, hora de arreglar todo para irnos!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Estoy exhausto...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0019",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000675",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De verdad? Pero pareciste estar divirtiéndote.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente estoy cansado. Fuu.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Caigo sobre el asiento tras soltar un suspiro.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000252",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000676",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hay ningún problema. Naoya lo dice de esa forma, pero él es de los tipos que\nno hace de ninguna manera nada que no le guste.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No trates de interpretar lo que los demás sienten. No es mentira lo de que\nestoy cansado.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="圭",mode=-1,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0028",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000501",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero te divertiste, ¿no? No hay ningún problema entonces.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Asumiendo que de verdad haya sido así, es más fácil hacerle creer a ella que\nestá en deuda conmigo fingiendo estar cansado y fatigado. Así que no necesito\nde sus insolentes interpretaciones.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000253",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hace falta que hagas eso, igualmente estoy bastante agradecida. De ser\nposible, quisiera agradecerte de alguna otra manera...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000502",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah~, no hace falta que hagas eso. ¡Kusanagi se divirtió, así que no hay ninguna\ndeuda!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0004",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000503",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan, acepta la amabilidad de Kusanagi sin reserva alguna. ¡Esta es una\norden de la jefa! ¿Entendiste? ¡Una orden!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000254",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿U-Una orden? Ah, s-sí... está bien. Aceptaré su amabilidad y procuraré pensar\neso.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Primero uno y ahora otro, hacen lo que se les viene en gana...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000047",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mmm, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Kawachino, quien estuvo observándome todo el tiempo sin haber pintado nada,\ncomenzó a hablar de repente.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000504",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede? ¿Kawachino-san?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000048",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, simplemente pensé que Naoya Kusanagi también le enseña a los demás...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000505",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues incluso él es capaz de por lo menos enseñarle a los demás, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000049",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Por alguna razón, Kawachino observa a Hikawa.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Hikawa asiente ligeramente con la cabeza.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000050",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuu... Bueno, si está de acuerdo, entonces supongo que no hay nada que se pueda\nhacer...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000506",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De qué están hablando?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. En fin, Kawachino, también te enseñaré a ti.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000051",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A mí?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pienso tomar ningún discípulo, pero sí puedo enseñarle las nociones básicas\nde las pinturas de óleo a novatos.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000052",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Después de soltar un suspiro, Kawachino sonrió ligeramente.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000053",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. De ser así, me gustaría que le enseñaras a una novata como yo también.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000507",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no nos vamos ya cerrarán el colegio.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Vámonos ya.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000677",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, hora de regresar. Rin-chan, deberías apurarte tú también.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Toritani se quedó en la sala de arte para hacer un último chequeo y cerrar las\npuertas y ventanas.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Dejamos a Toritani en la sala y nos fuimos.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"bgm",stop=1,time=1000},
{"excall",file="01_fruhlingsbeginn_02_6"},
{"text"},
linkback="block_00185",
},
label = {
top={block="block_00000",label=1},
},
}
