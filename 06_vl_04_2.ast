astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Agh!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_skr_000289",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Quédese quieto, por favor!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"bg",file="ev_com_j05_01",path=":ev/ev_com_j05/",set="ev_com_j05"},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000290",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Esto le pasa por no ir a la enfermería.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, aunque tampoco me parece muy adecuado tener mi cabeza sobre las piernas\nde una estudiante mientras me desinfecta la herida.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_skr_000291",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor, todavía está desorientado! ¿No sería mejor que fuese a un hospital?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, estoy bien. Solo fue una concusión. No era como para desmayarme, y ya estoy\nmejor.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_skr_000292",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Bien dice eso, pero hace un rato estuvo a punto de caerse por las escaleras\ncuando intentó pararse!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo pasa que... Eh...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_skr_000293",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Cielo santo, qué insensato usted, intentado golpear a alguien tan grande.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo creas, él no era tan fuerte antes...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Salvo, eso sí, que él nunca llegó a lanzar un golpe antes...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Su cuerpo es enorme. Así no tenga buenos reflejos, un movimiento de sus enormes\nbrazos basta para mandarte a volar...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Definitivamente, me confié...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"bg",file="ev_com_j05_02",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000294",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué se disculpa?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por meterte en semejante ridiculez...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_j05_01",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000295",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡De ridículo no tiene nada!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejé que te tomara del brazo.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",file="ev_com_j05_03",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000296",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero usted intentó salvarme.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y terminé golpeado en el suelo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si no bastaba con eso, ahora te tengo atendiéndome... Quizá sea mucho decir\nridículo, pero sí te metí en un problema que no era el tuyo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_j05_04",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000297",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Eso no es cierto. A-Además, todo sucedió porque usted intentó salvarme...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero mira nada más cómo terminé.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_j05_03",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000298",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Aun así, usted me salvó!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué patético...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_j05_02",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000299",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Patético, qué?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo. ¿Acaso no soy patético?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",file="ev_com_j05_01",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000300",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Eso no es verdad! ¡Usted no es patético!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al contrario...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"No fui capaz de proteger la obra.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"No fui capaz de decir nada.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"No fui capaz de salvar a Sakizaki-kun.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"¿Qué otro adjetivo me podrían dar más que patético?",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"¿En qué momento me convertí en semejante inútil?...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"se",file="se9010",id=1},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_skr_000301",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Mire nada más, las contusiones se están hinchando ahora. Hay que desinfectarle\ny aplicarle una compresa.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Sakizaki-kun enfría mi cabeza con una toalla.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Qué patético me debo ver.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El poder del mote, eh...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_j05_05",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000302",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿A-Acaso se creyó eso de verdad?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada... Solo que... noté que de cierta forma su convicción no ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",file="ev_com_j05_02",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000303",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Convicción?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él se la pasaba obsesionado con las chicas. Probablemente su definición de\néxito es ser popular con las mujeres.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá parezca indecente ante los demás, pero es impresionante que haya logrado\ntodo eso solo por querer ser popular con el sexo opuesto.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_j05_01",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000304",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“S-Si es por eso, déjeme recordarle que usted también lo es...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuántas veces tengo que repetirte que eso no es verdad?...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_skr_000305",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Claro que sí! Y si no me cree, yo puedo probarle muy bien lo mucho que las\nchicas que gustan de usted lo quieren.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Después de decir tal locura, Sakizaki-kun se pone roja.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_j05_06",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000306",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Jaa?! Ah, no es lo que usted cree...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja... Tranquila, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, con esta cantidad de estudiantes podrían haber una o dos muchachas\nprendadas de mí.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_skr_000307",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No me refiero a eso. ¡Hay una muchacha que realmente lo ama a usted!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Pues, gracias por decirme...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_j05_07",sync=0,face=1,time=400,path=":ev/ev_com_j05/",set="ev_com_j05"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000308",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“E-Ella, siempre está pendiente de usted... Siempre, ha estado viéndolo, de\nlejos y de cerca...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Esa muchacha es...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_skr_000309",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Si usted lo pide, esa muchacha haría lo que sea... para probar que...\n¡Profesor, ¿que hace alejando la vista?! ¡¿Me está escuchando?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_htd_000325",ch="htd"},
},
ja={
{
name={"???"},
"“Cuánto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=500},
{"fg",ch="紗希",size="z1",mx=40,mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",x=345,lv=4,id=6},
{"se",file="se9010",vol=70,id=1},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Directora...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0012",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000310",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿L-La directora?! W-Wa, wawawawah.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000326",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sakizaki-san, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000311",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Ah, shí!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000327",ch="htd"},
},
ja={
{
name={"Directora"},
"“Si mi reloj no se equivoca, ya es hora de entrar a clases.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0012",head="sku_z1b",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000312",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Ah, no, sí, l-lololo, lo siento mucho!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000328",ch="htd"},
},
ja={
{
name={"Directora"},
"“Profesor Kusanagi, si bien usted fue contratado a tiempo parcial, no amonestar\na una estudiante que intenta saltarse clases es--”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",x=345,lv=4,id=6},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000313",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Discúlpeme, la culpa la tengo yo! ¡El profesor no ha hecho nada malo!¡Me iré a\nclases de inmediato, ahora mismo!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0010",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000314",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Con permiso!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"se",file="se1135",id=1},
{"fg",ch="桜子",mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Sakizaki-kun bajó las escaleras corriendo.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="紗希",speed=500,mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",x2=345,x=0,lv=4,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me pongo de pie lentamente.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Había usted regresado a la ciudad?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000329",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, me llamaron y regresé de inmediato. ¿Acaso los interrumpí?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué habla?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000330",ch="htd"},
},
ja={
{
name={"Directora"},
"“Los vi muy románticos.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo, con una estudiante? Absurdo.\nTodavía quedaba tiempo, ¿qué necesidad había de mandar a Sakizaki-kun afuera?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000331",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tienes razón. Aunque, no me convenía tener a una alumna acá.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que la echó afuera...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",x=0,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_htd_000332",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es.\nSería muy mal ejemplo para ella ver a la directora fumando acá, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",id=1,file="se3469"},
{"bg",file="ev_com_j01_02",path=":ev/ev_com_j01/",set="ev_com_j01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_htd_000333",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya, no te veo muy alegre.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, como puede ver, no estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_htd_000334",ch="htd"},
},
ja={
{
name={"Directora"},
"“Escuché del dichoso grupo de arte. ¿Bourbagi, es que se llama?\nMe contaron que uno de sus miembros es egresado de nuestro colegio.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es por eso?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_htd_000335",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escuché que posiblemente aceptarían ese graffiti como obra oficial.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_htd_000336",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues sí, quién sabe.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_htd_000337",ch="htd"},
},
ja={
{
name={"Directora"},
"“Les informé que deberíamos darnos un tiempo para ver qué pasaba. Pero ahora que\nregreso, me cuentan que posiblemente la aceptarán.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente. Usted no tiene completa potestad en esto...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_htd_000338",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Acaso no es obvio? Si bien logré botar a los Nakamura del colegio, la\nsituación es que ahora estoy bajo el mando de los inversionistas del colegio.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fueron entonces los patrocinadores quienes dieron el visto bueno?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_htd_000339",ch="htd"},
},
ja={
{
name={"Directora"},
"“Probablemente. Los patrocinadores decidieron dejar el anuncio oficial para el\nmejor momento, y todo sin que yo me enterara.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_htd_000340",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Y bien?\n¿No tienes más nada que preguntarme?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No en particular.\nAunque sí me daba curiosidad saber qué pensaba usted al respecto.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_htd_000341",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pienso que podría funcionar.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_htd_000342",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bourbagi como grupo es una estrella en ascenso, y uno de sus miembros se graduó\nen nuestro colegio. No sé cómo reaccionará la Fundación Moore, pero la\nmayoría piensa que esto podría generar dinero.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin duda alguna darán buenos comentarios al respecto. Ya me puedo imaginar qué\ndirán.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A Kenichiro Kusanagi le encantaban los alborotos artísticos, esa clase de\nincidentes le hubiesen contentado. Si bien queda la duda de si hay o no\nnovedad artística en esa cosa, su motivación no es completamente opuesta a la\ndel señor Kusanagi, dirán.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sagrado se convierte en mundano al ser profanado, y de ahí es que es\nrealmente sagrado. Kenichiro Kusanagi solía decir eso, y además...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa clase de acciones no se oponen a su forma de pensar.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_htd_000343",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque probablemente su valor artístico será bastante discutido.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguramente.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué piensan hacer con la obra?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_htd_000344",ch="htd"},
},
ja={
{
name={"Directora"},
"“Seguramente llamaran a los medios y lo mostrarán como un suceso. Total, no es\nmás que un graffiti.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y después de eso lo revelarán como obra de Bourbagi.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_htd_000345",ch="htd"},
},
ja={
{
name={"Directora"},
"“Eso le da más sensacionalismo al asunto.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sensacionalismo, eh...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_htd_000346",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya eres un adulto, sabes muy bien de lo que hablo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me parece...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que además tendrá usted encima la presión de sus patrocinadores.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_htd_000347",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, casi se me olvidaba. Profesor Naoya, ¿recuerdas eso?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_htd_000348",ch="htd"},
},
ja={
{
name={"Directora"},
"“No es la gran cosa, solo que 'Las huellas de los cerezos' todavía no estaba\ncompleta como mural cuando ustedes la pintaron.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_htd_000349",ch="htd"},
},
ja={
{
name={"Directora"},
"“La goma que usaron como pintura se iba a derretir fácilmente con el calor, así\nque unos días después llamé a unos especialistas para que fijaran la pintura.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue por eso que la cubrieron con lona, ¿verdad? Para protegerla del calor y\npara realizar las labores.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_htd_000350",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Murales así requieren, además de pintar, fijar la pintura. Es ahí\ncuando realmente tienes un mural.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Los procesos de elaboración del mural...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Yo sabía que era necesario fijar la pintura como labor adicional.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Sin embargo, ¿por qué la directora habrá traído de repente, justo ahora, el\ntema de la fijación de la pintura?",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Observo a la directora.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Está mirando el cielo.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"cgdel",id=-1},
{"bg",file="ev_com_j01_02",path=":ev/ev_com_j01/",set="ev_com_j01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiera aclarar algo. El dueño de este colegio no es una sola persona,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_htd_000351",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es, no es uno solo. Recibimos patrocinio de varios adinerados. Como\ndirectiva tenemos a tres consejeros y a un jefe de directiva.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En ese grupo se encuentra el hospital general de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_htd_000352",ch="htd"},
},
ja={
{
name={"Directora"},
"“Oh, vaya, así que lo sabías.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo habían contado antes...\nAdemás, el hospital queda al lado del colegio.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_htd_000353",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo. Aunque esa ha sido una pregunta curiosa.¿Por qué de los cuatro\ninversionistas que hay solo preguntaste por ese?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por nada en particular...Solo que, me preguntaba qué pensará el hospital de\neste incidente.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_htd_000354",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ni idea. No lo sé, pero probablemente Inoue-san lo acepte. El encargado del\nhospital.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_htd_000355",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sucede que el mural se ve muy bien desde el viejo pabellón.\nSi bien ya no lo es, el viejo pabellón era muy popular cuando todavía estudiabas acá.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Se ve muy bien...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg065a",path=":bg/",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Recuerdo lo que vi en la azotea de aquel viejo pabellón.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se ve... muy bien?...Sí, la pared de la iglesia se debe ver muy bien desde ese\nángulo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"cgdel",id=-1},
{"bg",file="ev_com_j01_02",path=":ev/ev_com_j01/",set="ev_com_j01"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000356",ch="htd"},
},
ja={
{
name={"Directora"},
"“No has cambiado en nada, Naoya-kun.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué se refiere?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_htd_000357",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pretendes estar calmado... pero tu mirada es aguda.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es solo que mi vista no está muy buena.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_htd_000358",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Tan joven y ya con problemas de la vista?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_htd_000359",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues te he visto murmurando con los ojos puestos en la iglesia y el hospital.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será su imaginación?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_htd_000360",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Te parece? ¿Pues entonces por qué me preguntaste de repente si el hospital\ngeneral de Yumihari estaba entre los dueños?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no sé.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_htd_000361",ch="htd"},
},
ja={
{
name={"Directora"},
"“Fuh, qué testarudo. Aunque tu predicción no está errada.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_htd_000362",ch="htd"},
},
ja={
{
name={"Directora"},
"“El hospital intentará aprovecharse de este incidente.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_htd_000363",ch="htd"},
},
ja={
{
name={"Directora"},
"“En particular el director. Es todo un fanático del arte moderno.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_htd_000364",ch="htd"},
},
ja={
{
name={"Directora"},
"“También puede ser porque el hospital aumentó sus ganancias con el incidente que\nustedes provocaron...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_htd_000365",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque la propuesta le llegó primero al consejero Murayama, y no al señor\nInoue.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué eso?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_htd_000366",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tiene que ser casualidad.Probablemente algún contacto suyo.Es difícil creer que\nlo hizo todo solo.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El consejero Inoue pertenece al hospital general de Yumihari, ¿cierto? ¿Qué hay\ndel consejero Murayama?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_htd_000367",ch="htd"},
},
ja={
{
name={"Directora"},
"“Construcción. Es un contratista general.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Contratista general, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_htd_000368",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Por eso creo que fue una de sus conexiones.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_htd_000369",ch="htd"},
},
ja={
{
name={"Directora"},
"“El consejero Inoue es fanático del arte moderno, pero probablemente no le\ngustará que lo hayan dejado por fuera en esto.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso cree?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_htd_000370",ch="htd"},
},
ja={
{
name={"Directora"},
"“Lo más importante para un millonario es el honor.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Honor?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_htd_000371",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Los millonarios no se preocupan tanto por el dinero como la gente\nnormal. Probablemente tienen tanto que les da igual ganar o perder un poco.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_htd_000372",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pero odian con toda el alma que les manchen su honor. Eso jamás lo olvidan, por\nmás pequeño que haya sido la mancha.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_htd_000373",ch="htd"},
},
ja={
{
name={"Directora"},
"“Probablemente el consejero Inoue no vea con muy buen ojo esto. ¡¿Por qué no\nconsultaron conmigo primero?!, estará pensando.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuándo se presentará el graffiti de Bourbagi a los medios?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_htd_000374",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bourbagi ya explicó todo lo necesario, y además no hace falta llevar esto a la\npolicía. Seguramente se mezclarán los intereses de Bourbagi, los dueños y la\nFundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algunos días, quizá?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_htd_000375",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, unos cuantos días.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Apago mi cigarro.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"La directora hace lo mismo.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000376",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me voy ya. Yo también ando algo ocupada.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000377",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues bueno, te veo. Trata de no andar tan deprimido por ahí.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Directora.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000378",ch="htd"},
},
ja={
{
name={"Directora"},
"“... ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Discúlpeme por las molestias ocasionadas!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000379",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Molestias? Pero si esta vez no has hecho nada.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ahora...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000380",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Puh.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fgact",ch="紗希",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000381",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ajajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_htd_000382",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, nada, nada. Solo ten en mente que los medios vendrán en pocos días. Tres\ndías, diría.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000383",ch="htd"},
},
ja={
{
name={"Directora"},
"“Te lo advierto, el mismísimo Kenichiro Kusanagi se tardó un buen tiempo con el\ndiseño.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000384",ch="htd"},
},
ja={
{
name={"Directora"},
"“Akashi-kun se tardó unos cuantos años con los preparativos.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero Bourbagi lo hizo todo en una sola noche.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000385",ch="htd"},
},
ja={
{
name={"Directora"},
"“Porque tuvieron el apoyo de la constructora. Fue por el apoyo del consejero\nMurayama que lograron terminar en un día.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo suponía. Ningún artista podría terminar un mural en un día.\nFue al escuchar que el consejero Murayama trabaja en construcción que todo me cobró sentido.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000386",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, probablemente metieron maquinaria pesada la noche anterior.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque pensándolo de esa forma, quizá no fue casualidad que lo hicieran\nmientras usted estaba fuera de la ciudad.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000387",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tampoco puedo levantar tantas sospechas contra las mismas personas que nos\ncontribuyen financieramente.\nAsumamos que fue mera coincidencia.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tiene razón.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="紗希",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="紗希",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_htd_000388",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Crees poder lograrlo?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lograrlo? ¿De qué habla? Yo solo estaba disculpándome con usted...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=6},
{"fgact",ch="紗希",act="うんうん",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000389",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ajajajajaja, increíble. Definitivamente, eres increíble.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0002",head="sak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000390",ch="htd"},
},
ja={
{
name={"Directora"},
"“Déjame recordarte que yo no sé absolutamente nada de lo que vas a hacer, eh～”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agradezco su entendimiento.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=6},
{"fgact",ch="紗希",act="うんうん",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000391",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ajajaja, ustedes los Kusanagi son realmente entretenidos.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"se",file="se9004",id=1},
{"fg",ch="紗希",mx=40,mode=-1,lv=5,id=6},
{"text"},
text={
ja={
{
"La directora se va por las escaleras, riéndose.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debería reflejarse...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Todavía en la azotea, tomé tres objetos en mi campo de visión y los uno como\ntres puntos en mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"El posicionamiento entre los tres es factor decisivo.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debería funcionar...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"En teoría...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Sin embargo, la teoría y la práctica no siempre coinciden.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué extraño esto.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Lo que estoy a punto de hacer es, muy probablemente, algo imposible.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Medio año. Al menos un mes necesitaría.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"No, un mes es poco.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"En fin, hacer esto en menos de tres días es absolutamente imposible.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Estoy a punto de emprender una labor irrealizable.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Y a pesar de eso...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_skr_000315",ch="skr"},
},
ja={
{
name={"???"},
"“Lo veo sonriente...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z2",mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0200",face="a0002",head="sku_z2a",lv=5,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al regresar en mí me encuentro con una muchacha parada enfrente.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Owah? ¿S-Sakizaki-kun? ¿Q-Qué haces acá? ¿Te saltaste tu clase?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000316",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Pero qué está diciendo?... Ya las clases terminaron. ¿Acaso no escuchó la\ncampana?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=5},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000317",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Fuh... ¿Qué estuvo haciendo durante toda esta hora, profesor?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? N-Nada...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0002",head="sku_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000318",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Nada... eh...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Sakizaki-kun se apoya sobre la baranda, justo a mi lado.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_skr_000319",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor, usted... tenía una gran sonrisa.\nUna que jamás había visto antes...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será que me cogiste recordando el pasado?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001",head="sku_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000320",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Recordando el pasado?... Me pareció que era algo distinto.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0009",head="sku_z2b",lv=5,id=5},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0002",head="sku_z2b",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000321",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Dios, y pensar que hace una hora estaba usted tan decaído...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso preferías verme así?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fgact",ch="桜子",act="いいえ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0003",head="sku_z2b",lv=5,id=5},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000322",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, lo prefiero alegre.\nAunque me hubiese gustado verlo triste un ratito más...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0002",head="sku_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000323",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Me di cuenta que los hombres tristes pueden ser lindos también...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De qué estás hablando?!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0003",head="sku_z2b",lv=5,id=5},
{"fgact",ch="桜子",act="うんうん",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000324",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Yo qué sé!”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"se",file="se9004",id=1},
{"fg",ch="桜子",mx=40,mode=-1,lv=5,id=5},
{"text"},
text={
ja={
{
"Sakizaki-kun se dirige hacia las escaleras, riéndose.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_skr_000325",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pensé en venir a animarlo un poco, pero parece que perdí mi tiempo!\nMe voy ya.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_skr_000326",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Solo recuerde esto, profesor! ¡Yo estoy de su lado!”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Sakizaki-kun gritó eso, para luego desaparecer entre las escaleras.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entendí nada...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"No logro comprender la manera de pensar de las jovencitas de hoy en día...",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más importante que eso ahora...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"No me queda casi tiempo para ejecutar el plan.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Al terminar con mi única clase del día, me fui del colegio de inmediato.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_05_1"},
{"text"},
linkback="block_00246",
},
label = {
top={block="block_00000",label=1},
},
}
