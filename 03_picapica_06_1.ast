astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
"*cling* *clong*... *clang* *clong*...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Terminan las clases de la mañana.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Algunos se van al comedor, otros comen sus almuerzos, mientras que otros van a\nla cantina... Todos comienzan el receso del mediodía a su propia manera.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Saco mi almuerzo de la mochila y me piro del salón.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg060a",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Me detengo. No hay nadie alrededor del horno escalonado.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Si no está aquí, entonces...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se1279",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002753",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Toritani estaba viendo fijamente una libreta de dibujo abierta, sentada frente\na una de las mesas del salón de arte.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Esta levantó sus ojos y me vio al escuchar el sonido de la puerta abrirse, pero\njusto después devolvió hacia abajo su mirada.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tratando de idear algo?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002754",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no es eso... Estoy con otra cosa en este momento.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"En la libreta de dibujo había el bosquejo de un jarrón.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"El dibujo que tenía impreso el jarrón era una urraca. La misma que esa pintura\nde óleo en Quimera...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es el jarrón que la dueña fabricó?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002755",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es. Dibujé solo lo que recordaba de ella, así que no están muy bien\ndescritas las partes más detalladas, y me he inventado algunas otras partes\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es idéntico al de la pintura de Quimera y al ukiyo-e que la directora pintó. Y\nno solo eso, sino que además está coloreada con ese mismo pincel\nimpresionista que el de la pintura en óleo de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002756",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Toritani deja su mirada clavada sobre la libreta de dibujo mientras apoya su\ncara sobre su brazo puesto sobre la mesa.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002757",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Recuerdas que te comenté algo extraño cuando fuimos juntos a la casa de la\nfamilia Toritani? De que llegué a entrar una vez a la habitación de esa\nmujer... De la directora.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo recuerdo. Aunque no me parece tanto una historia extraña.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002758",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002759",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era aún una niña pequeña cuando entré en aquella habitación. Pero, a pesar de\neso, pude entender cuán valioso era todo lo que había allí adentro.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002760",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Habían muchísimas cosas maravillosas. No sé qué valor monetario podrían tener,\npero, sé que tienen un gran valor artístico... Entre ellas estaba este\njarrón.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002761",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ese momento estaba enfrascada en otra cosa, y no me fijé casi en el interior\nde la habitación.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002762",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero ahora que lo recuerdo bien, puedo entender ahora la enorme magnitud de\ntodas aquellas cosas que habían adentro.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, la directora mencionó que al momento de graduarse le\nofrecieron un puesto como curadora en un museo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002763",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... En ese entonces tenía un excelente ojo artístico y una habilidad para ver\nlo mejor del arte de la época. Y seguramente aún no ha perdido eso.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002764",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Un paisaje de blanca nieve, el panorama de un pueblo rural en invierno, y una\nurraca...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002765",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El cuadro que adorna a Quimera fue copiado en ese jarrón. Y para lograr eso, la\ndueña se atrevió a ir a un lugar tan lejano como lo es Limoges...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002766",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para fabricarlo, usó materiales locales y empleó las técnicas que predominaban\nen ese entonces...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002767",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Usó un método en el cual se emplea una mezcla de arcilla líquida, conocida como\n'engobe', y óxidos metálicos que producen color al momento de la cocción, el\ncual permite pintar y dibujar sobre piezas de terracota y fayenza... Le\nllaman 'decoración con engobe'.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002768",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los trabajadores de los talleres de esa época lo idearon para poder emplear\nnuevas estructuras artísticas tomadas de las corrientes impresionistas, así\ncomo para poder utilizar las mismas técnicas de coloración empleadas en las\npinturas. 'Para nosotros esto es como si un pintor dibujara sobre su lienzo'.\nDe esa forma lo describieron.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Emplear las pinturas de los impresionistas sin cambiar absolutamente nada...\n¿Es eso posible?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002769",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo es. Es tedioso, y es necesario ajustar adecuadamente la cocción, así\ncomo conocer muy bien las propiedades de los pigmentos a usar, pero no se ha\nperdido por completo la técnica. Y de hecho, yo también creé algo parecido\nuna vez.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿llegaste a hacer algo parecido?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002770",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue con una técnica que estuvo de moda en aquel entonces, no fue una pieza de\ncerámica como tal. Trabajé con vidrio, usando eso que llaman 'Pate de verre'.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Pate de verre...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Pate de verre significa 'Pasta de vidrio' en francés. Es más fácil entenderlo\npor su nombre en inglés, 'Paste of glass'.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"El método consiste en hacer, primero, la forma de la pieza con arcilla, para\nluego fabricar un molde con esa misma forma empleando yeso resistente al\ncalor. Se llena el molde con vidrio finamente machacado, el cual se derrite y\ntoma la forma del molde con el calor del horno.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Se debe desmantelar el molde de yeso para poder sacar el producto resultante de\nvidrio, y después se requiere pulirlo por un buen rato, así que el método no\nsirve para producción en masa, y toma mucho tiempo y trabajo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Dicen que fue desarrollado en Mesopotamia, pero es lógico que haya terminado\nconvirtiéndose una técnica de vidrio para artistas cuando resurgió en el\nsiglo XIX.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Sin embargo, en su caso todas las labores que preceden a la inserción al horno\npueden ser realizadas a temperatura ambiente, y es más seguro que el método\ndel vidrio soplado, así que no es raro encontrar todavía talleres de Pate de\nverre.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Para una alfarera como Toritani, tanto crear la forma básica con arcilla así\ncomo los demás otros pasos son parte de su especialidad.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002771",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En aquel momento, entre tanto investigar me dieron algo de ganas de fabricar\nalgo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si con solo 'algo de ganas' llegaste a hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002772",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este colegio está muy bien equipado, no solo en lo que respecta al horno\nescalonado, sino también a los implementos para pulir y todos los demás\nutensilios, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002773",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El 'Pate de verre' es mucho más seguro que el vidrio soplado. Así que por lo\ndemás, es solo cuestión de ganas y perseverancia, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una cuestión de ganas y perseverancia, eh...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002774",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, me dieron ganas de hacerlo como parte de mi aprendizaje con los esmaltes\ncerámicos. Aunque sí, creo que me alejé un poco... en buena proporción, del\ntema original.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En buena proporción? Te desviaste demasiado.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002775",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tanto. El feldespato usado en el esmalte se derrite y se vuelve vidrioso al\nmomento de la cocción. La pieza de cerámica es cubierta con esa capa\nvidriosa, logrando que se haga difícil el paso del agua a través de ella.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en eso tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002776",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno... reconozco que sí me sobrepasé un poco. Terminé por crear unas\nobras fallidas, o quizás más bien debería llamarles 'productos\naccidentales'...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Productos accidentales? ¿De vidrio?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002777",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Aunque sí llegué a crear lámparas aromáticas y lamparillas de noche usando\nla técnica del 'Pate de verre'.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es lo mismo entonces...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002778",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no lo son. Todas esas piezas eran imitaciones del estilo Lalique. Esos\n'productos accidentales' no fueron de vidrio, sino de cerámica.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002779",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para mí, fueron un fracaso... aunque, tal vez se podría decir que fueron una\ncreación fortuita... En cierta forma son muy interesantes como creación, y no\nniego que llegué a sentirme orgullosa de mí misma cuando las hice.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002780",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque creo que lo realmente interesante fue el esmalte cerámico que usé...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002781",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero... Sí, creo que realmente fueron, y son todavía un fracaso para mí.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿esas piezas que mencionas tienen que ver algo con la misma pieza que\nla abogada esa mencionó? Comentó algo de que estaba listado en el\ncatálogo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0024",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002782",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh, p-pues, sí.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002783",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Esas piezas fueron una creación fallida... Realmente solo la hice por\ndiversión, no pensé que las cosas terminarían de esta manera...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué demonios fue lo que pasó?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002784",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mn... todo sucedió cuando aún apenas estaba comenzando con la alfarería...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002785",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé que, así como las pinturas, sería mucho más rápido y sencillo aprender\nlas distintas técnicas existentes imitando otras obras, así que fui\ncopiándome de varias obras famosas y creando mis propias piezas.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002786",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace un momento te mencioné a Lalique, pero también tomé interés por el\nmodernismo (Art Nouveau) y por las piezas cerámicas de Gallé, así que traté\nde imitar varias de sus piezas...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002787",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ese momento usé un material que la dueña me envió, y por muy mera casualidad\nterminé creando un esmalte cerámico bastante particular. Luego, usé ese mismo\nesmalte para crear 4 jarrones modernistas.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002788",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Comparados al jarrón de la dueña, lo único que tenían de modernista era su\napariencia. Pero, de igual manera resultaron ser muy buenas piezas. Supongo\nque fue el resultado de usar todo lo que tenía en mi arsenal.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002789",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero debido a que utilicé ese esmalte tan especial, no hay forma alguna de\nvolver a reproducirlos. Para mí, una pieza que no sea reproducible por mera\ntécnica es una creación fallida.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002790",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque sí, si solo fuera eso no hubiera tanto problema... Pero, cuando mencioné\nla parte de 'diversión' hace un momento, me refería a que...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002791",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A que incluí un peculiar mecanismo en esos jarrones.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mecanismo?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002792",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Conoces el fenómeno del silbido del viento? Cuando el viento pasa por huecos o\naberturas producidos naturalmente, produce un sonido similar al de un pito.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es el mismo principio que aplica cuando un viento muy fuerte atraviesa las\naberturas de las ventanas y se escucha un silbido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002793",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Exactamente. Tomé ese mismo fenómeno... y lo reproduje en los jarrones.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002794",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le abrí unos huecos difíciles de ver desde afuera... Hice una capa doble en la\ncircunferencia de la base, y entre esas dos capas incluí un mecanismo\nbastante sencillo...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002795",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por cosa inesperada, cuando el viento atraviesa a los jarrones adecuadamente,\nproducen un sonido similar al de los sollozos de una mujer...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, tú...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002796",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que eras la clase de chica capaz de hacer esa clase de bromas tan\nridículas?... Creo que mejoró la impresión que tenía de ti.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002797",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me alegra ni un poco que tu impresión acerca de mí mejore por semejantes\ncosas... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Toritani suelta un suspiro, sosteniendo ligeramente su frente con su mano.\nVamos, realmente se escucha divertido...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002798",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El viejo imbécil ese que comercia con arte antiguo se interesó por mis\njarrones, y vino a pedirme prestado uno de ellos solo por 'un momentito'. Se\nlo presté y terminó vendiéndolo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002799",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me envió un enorme monto de dinero por la venta, pero ese no es el problema.\nTraté de recuperar el jarrón, pero no pude.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002800",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias al silbido del viento, empezaron a achacarle historias raras, y en cierto momento\nlos rumores trajeron más rumores. Que si había el espíritu de una mujer sollozando\ncontenido adentro, o que al tenerlo en tus manos acabarías en la bancarrota...\nTerminó ganándose el titulo de obra maldecida... Por Dios, cualquiera que lo vea\nse daría cuenta que se trata de una pieza reciente...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002801",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun si lograra acabar con todas esas historias raras, no quiero tener una obra\nfallida mía rondando por ahí afuera, así que quisiera hacer algo al\nrespecto...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, quizás para ti sea una obra fallida, pero no lo es para aquellas\npersonas que la aprecian. ¿No está bien con que lo dejes así?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0018",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002802",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No quiero.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002803",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás me hubiera contenido un poco si la obra hubiese sido publicada bajo el\nnombre de Makoto Toritani, pero... en el catálogo aparece fabricada por nada\nmás ni nada menos que por Hakushuu Usagiko.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002804",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y sin conformarse con eso, aquel idiota puso 'Usagiko' en el nombre de\ndestinatario al mandar el catálogo... Estoy absolutamente segura de lo que\nestá haciendo a propósito.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002805",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Yo quiero aportarle al mundo piezas reproducibles, que puedan ser\nproducidas en masa. Eso es lo que deseo hacer con mis obras. Y esa cosa está\nen un extremo completamente opuesto a esa idea...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002806",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa cosa se escapó de mis manos y se convirtió en una pieza de arte sin que yo\ndeseara que así fuera. Y es por eso que no puedo permitir más esto.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002807",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero llevarle a las personas productos que cualquiera pueda tener en sus\nmanos con tan solo quererlo. Y por eso es que no puedo, de ninguna manera,\ntener esa cosa circulando por ahí con el nombre de 'Conejo de luna', Hakushuu\nUsagiko.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm012"},
{"text"},
text={
ja={
{
"Después de clases――",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002808",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Procuraremos salir sin que te encuentren.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es la gran cosa, vamos...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002809",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Idiota, ¿es que no se te viene a la mente nada cuando ves esa cantidad de\nalumnas reunidas frente al portón de la entrada?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Frente al portón? Ah, sí, hay unas cuantas... ¿Qué están haciendo ahí?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002810",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo dije, vinieron por ti.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué ridiculez, es imposible que esa cantidad de mujeres estén esperándome a mí.\nY en primer lugar, casi todas son de otros colegios.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002811",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vienen después de clases justamente por ser de otros colegios...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002812",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El efecto del programa de TV de hace unos días ha sido impresionante... No\npensé que llegaran a aumentar tanto en número de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jga_000001",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¡Ah! ¡¿No es ese Naoya Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000001",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¿Eh? ¿Dónde, dónde? ¡Ah, sí! Kyaah.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002813",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tonto, ¿que no te lo dije?! ¡Corre!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"se",file="se0744s",id=1},
{"text"},
text={
ja={
{
"Toritani comenzó a correr, así que yo también lo hago.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_jga_000002",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¡Ah! ¡Está huyendo! ¡Y hay una mujer bien rara con él!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bgm",stop=1,time=500},
{"cgdel",id=-1},
{"bg",x=0,y=0,zoom=50,speed=35000,file="zbg041b",path=":bg/",z2=100,x2=300,y2=300,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0007",head="mak_z2b",x=210,lv=5,id=8,sync=0},
{"extrans",time=500},
{"bgm",file="bgm015"},
{"se",file="se0744",id=1,loop=1},
{"fgact",ch="真琴",act="びっくり",loop=-1,size=8,time=150,lv=5,id=8},
{"cgact",stage="zbg041",act="びっくり",loop=-1,size=5,time=200},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002814",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es que ahora soy la mujer rara?!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No les prestes atención, corramos.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0006",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002815",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo estoy haciendo! ¡Con todas mi fuerzas!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh, en serio?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0011",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002816",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa, jaa, jaa.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"se",stop=1,id=1,time=500},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jgb_000002",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¡No subestimen las piernas del club de atletismo!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Están corriendo hacia nosotros muy rápido.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0007",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002817",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, rayos! Kusanagi, déjame aquí y huye tú. Yo no soy el objetivo, así que no\nimporta.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero estaban hablando de ti también, ¿no irán a hacerte nada?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0018",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002818",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad eres tan idiota? ¿Es que acaso no conoces mi capacidad para discutir\ny debatir? ¡Puedo salir de cualquier situación usando solo mi boca!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente... Ahora que lo mencionas, así pareciera, pero...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"¿Qué tanto pesará Toritani?",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Es más alta que Ai, así que debe ser más pesada que ella.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Pero en caso de no extenderse tanto la persecución, ¿quizás pueda lograrlo?...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0005",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002819",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué haces quedándote viéndome? ¡Vete ya!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002820",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Voy a cogerte!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0014",head="mak_z2b",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002821",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿C-Co, cogerme?!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Toritani se detiene por completo.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Cargo a Toritani y la cojo en mis brazos, así como lo hice una vez con Ai.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002822",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hii--”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"cgdel",id=-1},
{"bg",time=100,rule=280,file="black",path=":bg/",vague=40},
{"se",file="se3130",id=1},
{"bg",file="ev_com_b05_01",rule=280,time=100,vague=40,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hables, vas a morderte la lengua.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002823",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Espera, no vas a poder!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy bien. Si hay algo en lo que tengo plena confianza es en mi fuerza física.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002824",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dirás eso, pero tu brazo derecho no tiene casi fuerza, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_b05_02",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002825",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Toritani se tapa la boca con las manos.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Para Toritani, el tema de mi brazo es un tabú. Tanto así que apenas se dio\ncuenta de lo que dijo se tapó la boca.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Pero Toritani... No tienes necesidad de angustiarte por eso.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es cierto. Mi brazo derecho no tiene tanta fuerza, pero para alguien de tu\npeso puedo resolver de igual manera. Voy a correr.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002826",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Ehhh?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",file="se2271",id=1},
{"quake"},
{"bg",file="zev_com_b05_02",zoom=70,x=350,y=130,speed=200,time=0,sync=0,z2=50,path=":ev/ev_com_b05/",set="ev_com_b05",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bg",lv=8,id=8,file="line2",time=400,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"ex",time=0,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
ja={
{
"Bajo corriendo la colina Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_jga_000003",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¡Ehhh! ¡¿Pero qué está haciendo--?! ¡Está cargándola en sus brazos!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000003",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¡¿Es que acaso Naoya Kusanagi-kun está saliendo con esa mujer?!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="zev_com_b05_03",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_b05/",set="ev_com_b05",ax=1920,ay=1080,bx=-960,by=-540,x=350,y=130},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002827",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No! ¡N-No estamos s-saliendo, ni nada de eso--!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Te dije que no hablaras!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="zev_com_b05_04",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_b05/",set="ev_com_b05",ax=1920,ay=1080,bx=-960,by=-540,x=350,y=130},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002828",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero, pero, si no digo nada entonces a partir de mañana todos comenzarán a\nmalinterpretar nuestra relación, eso te molestaría, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002829",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué no? A cualquiera le molestaría, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es molestia para ti?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="zev_com_b05_01",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_b05/",set="ev_com_b05",ax=1920,ay=1080,bx=-960,by=-540,x=350,y=130},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002830",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿P-Para mí? A-A mí... no me molesta, pero...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002831",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pero, Kusanagi, hay muchas muchachas enamoradas de ti, y... pensé, que sería\nalgo desagradable, entristecerlas...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Basta con que les expliquemos y ya, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002832",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es que acaso crees que podrás hacerlo? En primer lugar, nadie será capaz de\nvenir y preguntarnos eso cara a cara después de escuchar los rumores.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Vaya, qué lío.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="zev_com_b05_05",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_b05/",set="ev_com_b05",ax=1920,ay=1080,bx=-960,by=-540,x=350,y=130},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002833",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Lío? Estoy segura de que no es ningún lío para ti. A juzgar por esa forma de\ndecirlo, realmente no te importa mucho, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no me importa mucho, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_b05_06",time=500,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002834",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Por qué?! ¡¿Por qué no te importa?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque creo que me conviene más que todos malinterpreten las cosas.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002835",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa? ¿Qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quise decir nada en especial. Simplemente me desagrada tener a este gentío\npersiguiéndome, así que quizás me convenga más que todas crean que tengo\nnovia.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002836",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bájame! ¡No puedo soportar la idea de que todos piensen algo falso de mí por\nesa razón tan absurda!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh--, ¿absurda? Para mí es bastante importante, créeme. Y sería divertido que\nte comportaras como si fueras mi novia, Toritani. Así solo sea para darle\nveracidad al malentendido.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_b05_04",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002837",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué rayos? ¿Por qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es por nada, solo eso.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002838",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Escucha, ¿es que acaso no te molesta que los demás piensen que soy tu novia?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería? Eres preciosa, no me importaría.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_b05_01",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002839",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, solo sería por un malentendido, ¿no? En ningún momento he creído que\npuedas volverte mía, al menos ahora. Sé que estás poniendo todo tu tiempo y\nenergía en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_b05_04",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002840",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pues, estoy concentrada en eso ahora, pero...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, un escalón! Cuidado con la boca.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_b05_01",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002841",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",file="ev_com_b05_02",sync=0,face=1,time=400,path=":ev/ev_com_b05/",set="ev_com_b05"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002842",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡---!!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Toritani se tapa la boca con sus manos. Su gesto es absolutamente cómico.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, de aquí en adelante siguen escalones, así que cierra la boca.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002843",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm, nggh.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Toritani asintió con su boca cerrada.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa. Observa, ya nos alejamos bastante de ellas.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002844",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“I-Increíble... Escapaste de ese grupo de chicas mientras me cargabas...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si esa muchacha del club de atletismo fuera de verdad la gran cosa hubiera sido\nimposible huir, eso sí... A juzgar por su velocidad, seguramente no es\ntitular de equipo.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿nos vamos a Quimera?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Parece que no han llegado al punto de venir a agolparse hasta Quimera. Todavía\nles falta investigar más.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002845",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera... Bájame antes.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Bajo a Toritani.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=8},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002846",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Realmente estar contigo es un peligro para mi corazón, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta clase de persecuciones no son nada para ti, ¿no? ¿Cómo es que la misma\nmujer que fue capaz de enfrentarse cara a cara con Akashi, Komaki y Kosachi\nviene a decirme eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002847",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No es eso!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es entonces?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002848",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Ya te dije... Lo de, que, l-los demás, malentiendan, nuestra relación...\nuh... Y-Y eso...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, realmente no me importa. Es mucho mejor eso a que me anden persiguiendo\ntodos los días después de clases como sucedió hace un rato.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002849",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡U-Uno no puede comenzar una relación con alguien p-por ese tipo de razones!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé. Y sé además que no tienes tiempo para eso en este momento.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_002850",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... A-Así es... No tengo tiempo para eso ahora...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_002851",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por eso mismo es que esa clase de malentendidos me ponen en aprietos. ¡Y tú,\nKusanagi, deja de decir ridiculeces y ocúpate a partir de ahora de huir todos\nlos días de tus chicas!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm, bueno, a partir de mañana comenzaré a regresar por la ruta alterna que me\nenseñaste. La vez pasada no me encontré con nadie, se ve que realmente la\nelegiste muy bien. Te lo agradezco.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002852",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pues... sí, así es... Me parece bien que lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002853",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás una chica sola no sea capaz de mucho, pero nadie puede medir lo que son\ncapaces de hacer cuando están en grupo. Ten cuidado.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, tal como lo dije hace un rato, pienso que sería divertido que actuaras\ncomo si fueras mi novia. No está nada mal la propuesta, pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009h",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002854",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muh... De nuevo con ese tema.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si realmente me pides que no lo haga porque quieres concentrarte en la\nExposición Moore, entonces no lo diré más.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0010h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002855",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002856",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Lo pensaré.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002857",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Sea que tomes esa ruta tan larga o simplemente huyas corriendo de todas\nesas chicas, eso podría afectar tu desempeño al estudiar para las pruebas de\ningreso... y todo eso...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015h",head="mak_z1d",lv=4,id=8},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002858",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Jaa.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002859",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vamos a Quimera?... Creo que de repente se me vino todo el cansancio encima...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"De la cocina de Quimera se siente un olor ligeramente dulce.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Poco después, Toritani trajo algo sobre la bandeja.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002860",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿tienes un momento?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002861",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa que te interrumpa, ¿pero podrías probar esto? El café es gratis por\nprobarlo, así que no te preocupes por pagar.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Lo cual quiere decir que el café no es el de las muestras de siempre. ¿Será?",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que por lo general, cuando haces esto siempre terminas pagando los platillos\nde tu propio salario... No tienes por qué estar tan pendiente de mí tampoco.\nPodrías darme un trato menos considerado, no me importaría.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002862",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estas galletas salieron mal, y no quiero engordar, así que estoy tratando de\ndártelas a ti ahora bajo la excusa de 'probarlas'. ¿No es esto algo\nsuficientemente desconsiderado ya?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, veamos qué hay acá.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=8},
{"fgact",ch="真琴",act="うなづく",lv=5,id=8},
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Toritani coloca una taza de café y un pequeño plato con galletas en la mesa.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"El plato combina con la taza de café. Sus suaves curvas encierran una discreta\npero certera belleza. Probablemente fue fabricada por ella también.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues por más que la vea no encuentro qué es lo que salió mal en esta galleta.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",lv=5,id=8},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_002863",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Voltéala. ¿Ves que está quemada acá?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente se horneó un poco de más...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=8},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=8},
{"fgact",ch="真琴",act="うなづく",lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_002864",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está quemada. Y por eso salió mal. Así que el café es la compensación por darte\nalgo malo. Vamos, no digas más y come.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien... Aunque a mi parecer se ven buenas...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Que me obligue a comer unas galletas que según ella 'están quemadas' justamente\nen el momento que me da algo de hambre no me parece para nada un trato\ndesconsiderado, la verdad.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Tomo una galleta con mis dedos. Está aún ligeramente cálida.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que hay adentro de estas galletas es... ¿Caramelo derretido?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fgact",ch="真琴",act="うなづく",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002865",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Machaqué finamente caramelo, lo vertí en los huecos que les abrí a las\ngalletas y las metí al horno.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002866",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El caramelo derretido y esparcido por la galleta parece un vidrio de color, así\nque le llaman galletas vitral.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ya veo. Ciertamente, el rosado traslúcido del caramelo se asemeja a un vitral.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002867",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún no están completamente reposadas, así que quizás la textura esté un poco\nsuave, pero ya por eso no puedo hacer mucho.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes, el caramelo se me pega un poco a los dientes, pero la galleta\nesta crujiente, y no muy dulce. Está sabrosa.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",lv=5,id=8},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_002868",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias. Sé que si algo sabe bien para ti entonces le gustará a los demás.\nAunque, sí, tienes razón... si el caramelo se pega a los dientes...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay algún problema con que se pegue a los dientes?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002869",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, es que...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",mode=-1,lv=5,id=8},
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"La puerta de Quimera se abre, y dos muchachas vestidas en un uniforme que suelo\nver todos los días entran.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"msgoff"},
{"fg",ch="小沙智",size="z1",mx=40,mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="小牧",size="z1",mx=40,mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Vaya, pero si son Komaki y Kosachi.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="真琴",size="z1",mx=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002870",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Komaki, Kosachi, bienvenidas. Apenas acabo de hornearlas, cuando terminen de\nenfriarse por completo se las pondré en una bolsa, ¿podrían esperar un\nmomento?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=0,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000190",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Claro, y muchas gracias siempre por el favor. Aunque hoy vinimos también a\ncontribuir con las ventas del local, así que si no te molesta, ¿podrías\ndarnos el menú?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_002871",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?... Ahh, ¿es por lo de aquella vez? Eso no fue culpa de ustedes, no tienen\npor qué tomarse la molestia.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-570,lv=4,id=5},
},
vl02={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0010",head="kos_z1a",x=-570,lv=4,id=5},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000180",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No podemos dejar las cosas así, como si nada. La verdad es que nos hubiera\ngustado venir antes, pero hemos estado ocupadas con los asuntos de inicio de\nperíodo, y-- Ah, creo que estoy dando muchas excusas, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",x=0,lv=4,id=6},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0009",head="kom_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000191",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Discúlpanos por lo que sucedió aquel día. Trajimos un obsequio para\ncompensarte... aunque, supongo que sería algo exagerado llamarlo así, pero\nacéptalo de todas maneras, por favor.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Ambas bajan sus cabezas en señal de disculpas, ofreciendo una caja de cartón\nenvuelta en papel para envolver.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002872",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Aunque, realmente yo también tuve parte de la culpa...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Toritani pone un rostro algo apenado, aunque no parece tratar de rechazar el\nobsequio.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada de lo que están hablando, ¿qué es lo que sucedió?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0008",head="kom_z1a",x=0,lv=4,id=6},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000192",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Hace unos días, en la sesión pasada de la escuela dominical...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0013",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002873",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah--, esp--, no hace falta, no lo digas!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0013",head="kom_z1a",x=0,lv=4,id=6},
{"fgact",ch="小牧",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0008",head="kom_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000193",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿No? De ser así...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, cuéntame todo lo que pasó. Por favor.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
"Kosachi y Komaki se ven a las caras por un corto instante de tiempo.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Después de que las gemelas se lanzaron unas cuantas miradas, me contaron lo que\nsucedió.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"bgm",stop=1,time=1000},
{"bg",time=1000,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
"Parece que cuando el tiempo le sobra, Toritani prepara golosinas para los niños\nque vienen a la escuela dominical.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"De hecho, las galletas vitral que hizo son para la próxima sesión de la\nescuela.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Al parecer, el día que Toritani llegó a entregar las golosinas encontró a unos\nniños peleando, así que los regañó a todos, por igual.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Después de eso, las madres de un grupo de esos niños se enfadaron fuertemente\ncon ella.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Sin embargo, Toritani no retrocedió ni un solo paso, avasallando con argumentos\nválidos a las madres. A lo cual, una de ellas le dio una fuerte cachetada.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000194",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“... Y eso fue lo que sucedió.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es terrible.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0011",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000181",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Son de esos que llaman 'padres monstruo'. Nosotras tampoco sabemos muy bien qué\nhacer con ellas... Creo que debimos haberles reclamado con más severidad.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Kosachi echó de reojo su mirada a alguien.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Eran dos mujeres jóvenes, clientas asiduas de Quimera. El movimiento del\nrabillo de los ojos de ambas fue la prueba tácita de que estuvieron evitando\nla mirada de Kosachi todo este tiempo.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_jrc_000002",ch="jrc"},
},
ja={
{
name={"Cliente C"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_jrd_000002",ch="jrd"},
},
ja={
{
name={"Cliente D"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Son jóvenes, aunque no tanto como para ser estudiantes, ni tampoco parecieran\nlaborar. Diría que son unas jóvenes madres pasando una elegante tarde en un\ncafé.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"... Probablemente estuvieron presentes en la escena que ocurrió en la escuela\ndominical. Seguramente por eso Kosachi las vio con ironía.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002874",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De esa clase de personas hay en todos lados, no hay necesidad de preocuparse. Y\nademás, le devolví la cachetada.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se la devolviste?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0018",head="mak_z1a",lv=4,id=4},
{"fgact",ch="真琴",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002875",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Acaso no es obvio? ¿Te parezco alguien capaz de sentarse a llorar mientras los\notros hacen lo que les viene en gana?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no me pareces...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_002876",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Terminé más bien armando un escándalo y poniéndolas a ustedes en una mala\nsituación. ¿No les ha venido con más quejas desde entonces?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x2=0,x=-345,lv=4,id=4},
{"fg",ch="小牧",size="z1",mx=40,mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0008",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000195",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Por cosa rara, no...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",x=-345,lv=4,id=4},
{"fgact",ch="真琴",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002877",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",mode=-1,lv=4,id=4},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000182",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Para resumir la información que he estado escuchando casualmente por ahí y por\nallá, parece que esa madre y su hijo son unos buscapleitos con bastante fama.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Buscapleitos a donde quiera que van?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0015",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000183",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Sí. El niño ha lastimado a otros, o los obliga a salirse de la escuela por\nmedio de acoso... Y le echa la culpa de todo lo que hace a los otros niños...\nHace lo que le da la gana.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0010",head="kom_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000196",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Los otros padres se hacen la vista gorda, todo para no terminar como víctimas\ntambién... Ha sido un problema bastante complicado de manejar.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sea lo que sea que suceda con los padres, ya es un problema de por sí que\nustedes tres también estén sufriendo el acoso de esa madre y su niño. No voy\na permitir que vuelva a suceder eso de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002878",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué... estás diciendo?...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno, digamos que dependiendo de la respuesta de Toritani, los dos\ncomencemos una relación.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002879",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Espera un momento!”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero me dijiste que lo pensarías, ¿no? ¿O es que acaso hablabas de otra cosa?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0003",head="kos_z1a",x=-570,lv=4,id=3},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000197",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Los dos se volvieron novios?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0007",head="mak_z1d",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0006",head="mak_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002880",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡N-No!! ¡¡¡No es nada de eso!!! ¡¡¿¿Y tú, Kusanagi, por qué te pones a\ncomentar eso en público??!!”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=570,lv=4,id=4},
{"fgact",ch="小牧",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_kmd_000198",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Vamos, no tienes por qué alterarte tanto... Ya desde hace tiempo los dos\nparecían una pareja, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0016",head="kos_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_ksd_000184",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Pues más que novios... Ya parecen marido y mujer.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="小沙智",mode=-1,lv=4,id=3},
{"fg",ch="小牧",mode=-1,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0010h",head="mak_z1d",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002881",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡～～～～～～～～--!!”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Ante los comentarios de Komaki y Kosachi, Toritani se sonroja hasta más no\npoder y se queda en silencio.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Es realmente entretenido ver cómo Toritani, quien no titubea ni un poco al\nconfrontar a tipos como Akashi, se agite tanto ante temas de romance y amor.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Aunque bueno, para ser sincero, se me hace bastante linda.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Sí, quizás esté de más decirlo de nuevo, pero Toritani es una muchacha\nrealmente tierna.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Aunque, por otro lado... Acabo de escuchar algo que me llamó la atención.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"El niño revoltoso de la escuela dominical y su madre... Quizás sea buena idea\ntenerlos en mente.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_06_2"},
{"text"},
linkback="block_00295",
},
label = {
top={block="block_00000",label=1},
},
}
