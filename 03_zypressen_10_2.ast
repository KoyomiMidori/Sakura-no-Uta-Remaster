astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg063c",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002203",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquí me despido yo.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002177",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Cierto que llegas más rápido a casa yendo por el lado del templo.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo cual quiere decir que tú y yo tomamos el mismo camino?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002178",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Pensé que Kawachino vendría con algún otro comentario de mal gusto, pero estaba\nmuy tranquila.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002179",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, estaremos acá hasta que ya no podamos verte.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0003",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002204",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno. Los veo después, y no peleen.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002180",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tranquila, no lo haremos.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Nos vemos, Hikawa. Que descanses.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002205",ch="rna"},
},
ja={
{
name={"Rina"},
"“Que descansen.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002181",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ve con cuidado.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002206",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",file="se9004",id=1},
{"fg",ch="里奈",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Hikawa desaparece.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
"Y entonces, Kawachino y yo nos quedamos solos en el templo de Hakuki, ya de\nnoche.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nos vamos ya? Tú también vas con dirección a Sakuragahara, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",stop=1,time=3000},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0010",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002182",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",file="ev_com_d08_01",path=":ev/ev_com_d08/",set="ev_com_d08"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Kawachino me mira fijamente.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Son incontables las veces que Kawachino se me ha quedando viendo con fijeza.\nPero la expresión que llevaba ahora era totalmente distinta.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"No era una cara de enojo.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Más bien parecía estar a punto de llorar.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_yum_002183",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué sigues con esta tontería, senpai?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tontería? ¿Te refieres a la cita?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_yum_002184",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En parte, pero no solo eso.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú me dirás. Ya casi no te acosan las colegialas de afuera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_yum_002185",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, bueno, solo escucho ahora murmullos a donde voy, cuando mucho.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es tontería alguna entonces, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_yum_002186",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El hecho de que intentes ayudarme es una tontería en sí.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso dices? Yo no lo creo.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_yum_002187",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No veo la razón.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué manera debería contestar a eso...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_yum_002188",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Otra vez haciéndote el tonto...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que me esté haciendo el tonto.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_002189",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa. Kusanagi-san, ¿sabes? Yo...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_yum_002190",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, debería referirme como nosotras. Hemos estado teniendo sueños relacionados\na los cerezos milenarios, todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nosotras?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_yum_002191",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina y yo. Hemos estado teniendo el mismo sueño.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... El mismo sueño...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_yum_002192",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La historia del amor entre Hakuki y Yoshisada Nakamura... A pesar de los\nsentimientos del uno por el otro, el destino se opuso a unirlos.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conozco la historia, la he investigado antes.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_yum_002193",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero la historia que conoces es distinta a la del sueño que vimos.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_yum_002194",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Probablemente Rina y yo somos las únicas personas en el planeta que la conocen.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_yum_002195",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿'Entiendo'? ¿Eso te sirvió de explicación?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mostrar sueños? Es totalmente posible. Los cerezos milenarios tienen poder\npara eso y más.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_yum_002196",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Nos quedamos viendo cara a cara, en silencio.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_yum_002197",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Esta farsa se acaba ya!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_yum_002198",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es Rina quien me gusta, no tú.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_yum_002199",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y el día de hoy fue toda una agonía.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_yum_002200",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Odio cada minuto, cada segundo que paso contigo...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_yum_002201",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quisiera que simplemente te desaparecieras del mapa.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo que decir que me duele un poco que me digas todo eso...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_yum_002202",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sufre...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_002203",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y ódiame. Por favor...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_002204",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De lo contrario, yo...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_002205",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina... Rina se estuvo divirtiendo bastante hoy.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_002206",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se veía radiante, y viva, mucho más que cuando está conmigo...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_002207",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me provocas celos...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_002208",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tanto que la amo, tanto que siento por ella...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_yum_002209",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hasta el punto en que incluso podría hacer lo que sea por ella...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_002210",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero todo eso se va al piso ante ti...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_yum_002211",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mis sentimientos se vuelven nada cuando tú estás.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_yum_002212",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre lo resuelves todo de la mejor manera.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_yum_002213",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así eso implique sacrificarte por tu parte.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_yum_002214",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eres capaz de hacer lo que sea por Rina.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_d08_02",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002215",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cómo? ¿Cómo puedes ser tan valiente, tan audaz, tan genial?...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_yum_002216",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ayudas a los demás, así pierdas algo a cambio.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_yum_002217",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Te llevas toda la carga, todo el dolor.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_yum_002218",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cómo voy a ganarle a alguien así?...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás poniendo en un pedestal que no me corresponde.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_d08_01",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002219",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Me va a decir eso la misma persona que le dedicó lo poco que le quedaba de\nmano a una mujer?!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_yum_002220",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Le diste ese último pedazo de vida de artista a una muchacha a la que apenas\nhabías conocido!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_yum_002221",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Diste tu brazo derecho, el brazo del genio! ¡Por un mural que solo duró una\nnoche!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_d08_02",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002222",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dime... ¿Cómo puedo competir con alguien así?...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_002223",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Amo a Rina...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_yum_002224",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tan fuerte, tan intensamente, que la siento como si fuese parte de mí misma...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_002225",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_yum_002226",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso, tengo fantasías. De que quizás las dos fuimos, en una vida pasada,\ndos amantes que no pudieron consumar su amor...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=500},
{"se",id=1,file="se_wind1"},
{"bg",time=300,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En ese instante, la atmósfera alrededor cambió.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_yum_002227",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Un viento sopla.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Un viento ajeno a esta época.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Este particular aroma es...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Una brisa de primavera.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="zev_com_d08_03",zoom=80,speed=100000,path=":ev/ev_com_d08/",set="ev_com_d08",x2=570,y2=140,x=120,y=230,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm105"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_002228",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Kawachino se queda sin palabras.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Arrastrados por el viento, los pétalos de cerezo que vi aquel día tapaban\nnuestra vista ahora.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo suponía...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Y tras los pétalos que cubrían mi vista, vi...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Un enorme árbol de cerezos erigido sobre el Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_d08_03",path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes... de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_yum_002229",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estos son...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_yum_002230",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los cerezos del árbol donde Yoshisada y Hakuki pasaron sus últimos momentos...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que te sabes bien la historia. Ah, claro, lo viste en el sueño...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay varias versiones, pero la más confiable es la de que los Nakamura y\nHousoushi, atemorizados del rencor y el odio que pudo haber quedado en el\nlugar, erigieron un templo en el lugar donde los dos murieron.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A diferencia de las versiones usuales, esta dice que ambos fueron asesinados\nacá, donde fue construido el templo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_002231",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hakuki no fue asesinada...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_d08_04",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002232",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Abrió su corazón, expulsando todos los demás corazones que había tragado, y\nmurió.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? No sé qué fue lo que realmente sucedió, pero bueno. De igual\nmanera, esto que ves acá son los cerezos milenarios. Los verdaderos...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y el hecho de que estén floreciendo ahora, significa que...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los sentimientos de alguien florecieron...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_yum_002233",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los sentimientos de alguien florecieron?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos milenarios florecen al resonar con los sentimientos de alguien. Los\nsentimientos del pasado impregnados en ellos están resonando con los de\nalguien más... Alguien, que está aquí ahora...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_002234",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa persona es...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen que te hace recordar el pasado, como si fueran recuerdos una vida pasada.\nPero en realidad es solo producto de la resonancia.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son particularmente sensibles a la sensación de pérdida, cuando te arrebatan\nalgo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La tristeza de cuando alguien te arrebata la persona que tanto amas. O la\ntristeza al perder un hijo, o tus padres... Reaccionan fuertemente ante esa\nclase de sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_002235",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si es así...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_002236",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Creo que... los sentimientos impregnados en los cerezos, están reaccionando\ncon los míos...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_002237",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tanto Rina como yo vimos sueños. Es de esa resonancia de la que hablas,\nseguramente.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fueron entonces tus sentimientos los que hicieron florecer a los cerezos\nmilenarios...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_yum_002238",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y Rina?...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_002239",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina me dijo que también ha tenido los mismos sueños.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_002240",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sus sentimientos podrían haberlos hecho florecer, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez. Pero me parece que no.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente florecieron para cumplir tu deseo.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_002241",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué... piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aparecieron justo en el momento en que mencionaste la palabra 'vida pasada'.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“-Esto lo he vivido. Es mi vida pasada-. La resonancia con los cerezos llega a\nsu punto máximo cuando llegas a pensar eso...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien los hizo florecer.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_002242",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo... los hice florecer...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. Así que deberías alegrarte, tal vez. Esto es una especie de milagro.\nAunque quizás no uno del cual los demás puedan alegrarse...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_002243",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los demás no pueden alegrarse?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así mismo. Los cerezos milenarios resuenan gracias a todas aquellas personas\ncuyos sentimientos nunca llegaron a ningún lugar. Es esa resonancia la que\ncumple los deseos.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_yum_002244",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo sé. Pero quisiera que me digas por qué crees que eso no puede alegrar a los\ndemás.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace un buen tiempo llegué a presenciar a los cerezos milenarios floreciendo...\ny no salió nada bueno. Destrozó por completo a una familia.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue ahí que me di cuenta de que cosas terribles ocurren cuando los deseos de\nlas personas se cumplen a como dé lugar, como si nada. Y me di cuenta de la\npeor manera.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Le destroza la vida a muchos...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_002245",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Un milagro que destroza la vida de muchos...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás creí que llegaría a ver dos milagros mientras siguiera con vida...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este mundo se fundamenta en principios. Cuando alteras esos principios y\ncumples el deseo de alguien, siempre surgirá una distorsión en algún otro\nlugar.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Poniéndolo de manera simple, la felicidad de alguien siempre será compensada\ncon la infelicidad de otra persona.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En realidad no es tan simple, pero... a final de cuentas, así resulta.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cumplir deseos de manera milagrosa solo es posible cuando, de alguna forma,\nalteras esos principios...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_002246",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo... Entonces, quizás el poder de estos cerezos me pueda ayudar a\nconseguir el amor de Rina.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué manera resultaría, pero un milagro podría cumplir eso. O si lo\nllamamos de otra forma, el poder de los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_002247",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Convirtiéndome en un hombre, por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, aunque... más que milagro, se escucha más como un simple cambio de\nsexo...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_002248",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Quizás Rina se convierta al lesbianismo!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una posibilidad...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay toda la posibilidad de que se enamore de ti si llegara a convertirse en\nlesbiana.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_d08_05",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002249",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... También está la alternativa... de que mueras.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Kawachino dijo eso con un débil tono.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si Rina siente algo por mí, entonces esa es otra posibilidad.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy un estorbo para tu deseo, después de todo.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_002250",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina está loca por ti, Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, de hecho me rechazó.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_d08_03",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002251",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me dijo no como tal, pero su reacción no fue realmente buena.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_yum_002252",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_d08_04",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002253",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué te le confesaste, senpai?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque me gusta.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_yum_002254",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Pero por qué justo ahora?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La respuesta a esa pregunta es tan estúpida como lo sería preguntar por qué los\ncerezos milenarios florecieron justo ahora.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque fue justo hace poco que me di cuenta que me gustaba. Por eso le confesé\nlo que sentía.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que lo dije antes, pero quiero una vagina para toda la vida. Es mi ideal.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_002255",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa manera de referirte a Rina es demasiado vulgar.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me lo vas a decir tú?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, solo pienso dedicarle mi vida a una única mujer.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es lógico que te preguntes por qué ahora. Y lo único que puedo decir es que me\ntomó tiempo.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_yum_002256",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué te empeñas tanto en buscar una única mujer para todo el resto de tu\nvida?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Pero mi abuela solía decir que los Kusanagi somos fieles de por vida.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi madre no paró de agradecerle a mi padre por su inquebrantable amor y\nfidelidad.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias a ese fuerte amor, mi madre pudo irse en paz, diciendo antes de morir lo\nmaravillosa que fue su vida.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El amor que tenía por mi madre era enorme... Fueron cortas sus palabras, pero\nsuficientes como para penetrar mi pecho.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kenichiro Kusanagi llegó a meterse en muchas cosas, y hacer muchas otras. Pero\nsi hay algo casi seguro, es que mi madre fue la única mujer a la que amó.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto... que tal vez le faltó algo de amor por su hijo. Así de tanto la quería.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que, a pesar de su corta vida, creo que mi madre vivió muy feliz.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue al ver lo feliz que fue mi madre que decidí dedicar mi vida a amar a una\nsola mujer.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_002257",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero... te rechazaron.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_002258",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué harás con los sentimientos que tienes por ella entonces?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los ocultaré.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Amo a Hikawa, y quiero que sea feliz. Es lo único que puedo hacer si su\nfelicidad no está conmigo.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es realmente una pena, y me duele, pero... la amo, y por eso mismo debo ocultar\nestos sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_yum_002259",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Un amor oculto solo muestra falta de coraje.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo lo que dices. Pero el amor es complicado, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llegas a sentir deseo por esa persona, pero también deseo por su felicidad.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es indescriptible la felicidad cuando estos dos sentimientos coinciden... pero\nlas cosas no suelen ir tan bien.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El amor siempre es egoísta.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos hace pensar que nuestro amor le hará bien a esa persona.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo cual no es así.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedes enfrascarte en tus propios sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_002260",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues se supone que el amor es algo que se construye entre dos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que no sirve amar solo.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_d08_06",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002261",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina te ama, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_yum_002262",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mejor que nadie lo sé yo, quien ha estado más tiempo junto a ella.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez sea así...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero creo que Hikawa también te ama a ti.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_002263",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me cabe duda...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_002264",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Supongo que eso quiere decir que somos rivales románticos...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A lo mejor. Y creo que es porque, por más sorprendente que suene, nos\nparecemos...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_002265",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Nosotros dos? ¿D-De qué manera?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también eres una buena altruista.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres una lesbiana tranquila y mansa, siempre al servicio de Rina.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces me sacas algo de quicio, pero igualmente me agradas.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_002266",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_yum_002267",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te cansas de hablar de más, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_002268",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... deberías morirte...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso matar puedes, si así lo deseas. Podría valer la pena. Sería increíble\npoder acabar con alguien que odias sin que la policía te persiga por eso.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_002269",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo dices como si no fuera tu problema...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que soy parte del problema, pero... no puedo hacer nada al respecto.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie es capaz de detener el milagro que estos cerezos provocan cuando\nflorecen.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podría decir que solo la misma creadora de esta maldición podría detener ese\nmilagro. Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero eso sería sobrescribir un milagro con otro... Solo terminaría\ndistorsionando las cosas de una manera aún peor...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es muy buena idea intentar limpiar un 'milagro' con otro.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debo, eso sí, acotar que esas palabras no son mías...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_yum_002270",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo. Así que por eso no mostrarás resistencia alguna a este milagro.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Resistencia alguna?... Lo dices como si realmente fueras a matarme... Pero\ndéjame decirte algo, de ninguna manera quiero terminar muerto. Preferiría que\ntu deseo se cumpliera de una manera más pacífica.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",file="ev_com_d08_07",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002271",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jamás. Te odio. Tanto que hasta quisiera matarte...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_yum_002272",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Soy una homosexual. Y por ser eso es que la amo.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_d08_08",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002273",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un poema palíndromo...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_yum_002274",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es ingenioso, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_yum_002275",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El sonido del barco arrastrando las olas, viento en popa, es tan agradable que\nme hace sentir que la noche es eterna, e inesperadamente me quita el sueño.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_yum_002276",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Claro, así es. Es cuando el sueño comienza a hacerse eterno que despiertas.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_yum_002277",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La primera vez que escuché el poema no tenía ni idea de lo que hablaba.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_yum_002278",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si te sientes tan cómodo que la noche se te hace eterna, ¿por qué\ndespertarías?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_yum_002279",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero resulta que en realidad va de la otra manera. Son los sueños que se hacen\neternos de los que terminas despertando.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_yum_002280",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dejas de soñar cuando todo parece ir bien.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_yum_002281",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Encaja muy bien conmigo este poema.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_yum_002282",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es ella a quien más amo...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_yum_002283",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre he querido ser algo más para ella... siempre...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_yum_002284",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero mi deseo de que sea feliz ha sido más fuerte.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_yum_002285",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y... en algún momento comencé a desear por tu felicidad también.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La mía también?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_002286",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Por eso es que te odio!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_yum_002287",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A medida que te conozco más, más quiero que seas feliz.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_yum_002288",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se supone que eres mi rival. Mi rival en el amor, que tanta ventaja me lleva...\nY aun así...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_yum_002289",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Cada vez que veía tus cuadros, y veía cómo pintabas, algo dentro de mí deseaba\nque fueras feliz...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_yum_002290",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso no puedo. Es imposible.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_002291",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre ha sido imposible...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_yum_002292",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No tengo forma alguna de ganarte.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_002293",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues te amé como artista...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_yum_002294",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y amé tus pinturas.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_002295",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso... es que no necesito ningún milagro.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_002296",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sabes? El que se enamora, pierde... La batalla, y también la guerra...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"msgoff"},
{"colortone",inter=3,ssize=3,style="raster"},
{"se",id=1,file="se_yuumi_clash"},
{"bg",file="zev_com_d08_08",id=2,lv=2,zoom=51,alpha=255,time=300,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_09",id=3,lv=3,zoom=51,alpha=255,time=300,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_08",id=4,lv=4,zoom=52,alpha=100,time=500,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_09",id=5,lv=5,zoom=52,alpha=100,time=500,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_08",id=6,lv=6,zoom=53,alpha=64,time=800,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_09",id=7,lv=7,zoom=53,alpha=64,time=800,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_08",id=8,lv=8,zoom=55,alpha=32,time=1000,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_d08_09",id=9,lv=9,zoom=55,alpha=32,time=1000,path=":ev/ev_com_d08/",z2=50,set="ev_com_d08",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"ex",time=0,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"colortone",style="raster",ease="out"},
{"bg",file="ev_com_d08_09",path=":ev/ev_com_d08/",set="ev_com_d08",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm107"},
{"text"},
text={
ja={
{
"Un estridente sonido se escuchó alrededor. Como si algo se rompiera.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Un agudo ruido resonó en ese suave mundo de pastel.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Y entonces, los cerezos se esparcieron.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Como si chispas fueran...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_002297",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Realmente amas a Rina?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_yum_002298",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿La harás feliz?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ten toda la seguridad.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bg",file="ev_com_d08_10",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002299",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Demonios... Es injusto. ¿Por qué los hombres pueden decir esas cosas con tanta\nfacilidad?... Mierda...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Yuumi dice eso mientras llora.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_yum_002300",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De ser así, mi deseo es que los dos sean felices. Por eso es que no necesito el\nmilagro de ningún cerezo mágico.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_yum_002301",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Con que ambos puedan estar juntos de manera normal, de forma natural, me basta.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"bg",file="ev_com_d08_11",sync=0,face=1,time=400,path=":ev/ev_com_d08/",set="ev_com_d08"},
{"text"},
text={
ja={
{
"Los cerezos se habían dispersado dejando una estela de color a su paso.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Y ahora, no había rastro alguno de ellos.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_yum_002302",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No me malinterpretes! ¡Reconozco tu talento como artista, pero aún te odio\ncomo persona!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_yum_002303",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Eres simplemente repulsivo! ¡Y vaya que odio a los hombres, pero tú te ganas\nel número uno en mi medidor de odio!”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_yum_002304",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina... sal ya.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063c",path=":bg/",sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000,sync=1},
{"se",file="se9004",id=1},
{"fg",ch="里奈",size="z1",time=500,mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Al Kawachino mencionar a Hikawa, esta salió de la parte trasera del templo.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002305",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya escuchaste todo, Rina... ¿Aun así sigues pensando en dejarlo a él y venirte\nconmigo?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Hikawa estaba llorando.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0020",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002207",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo siento, Yuumi... Perdóname...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_rna_002208",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo... la verdad es que yo, cuando éramos niñas...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002306",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo sé, Rina. No me soportabas de niña, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002209",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002307",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fue por eso que te juntaste conmigo.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002308",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por toda la vitalidad que yo tenía...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0020",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002210",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Esa vitalidad se me hacía insoportable, pero en realidad simplemente\nquería hacerla mía.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_rna_002211",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso es que te despojé de tus colmillos, y te convertí en una muchacha como\ncualquier otra...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002212",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eras un lobo hecho de coraje, noble. Y aun así, yo...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002309",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Un lobo? ¿Yo? Bueno, supongo que mi salvajismo es similar al de un lobo, eso\nsí.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002310",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, aun si realmente fui un lobo de niña y ahora solo una simple muchacha,\neso no necesariamente es tu culpa.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002311",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo que verdaderamente me hizo una simple muchacha fueron mis características\nsexuales secundarias.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002312",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De niña pasé a muchacha, y de muchacha a mujer... Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002313",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El tiempo me convirtió en una mujer más.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002314",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y sabes algo? Cuando peleé, no pude evitar darme cuenta de que solo soy una\ndébil, frágil mujer.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002315",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sentí el dolor en mis manos al golpear, y sentí como si estuviera acabando con\nmi propio cuerpo entre cada impacto...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002316",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Peleaba, y pensaba, 'ah, soy solo una simple mujer'.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002317",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así seguiste atenta de mí. Me volví aburrida, poco interesante, pero\naun así me diste amor...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002318",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nunca dejé de aferrarme a eso, Rina. Nunca.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002319",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya no soy el noble y osado lobo que tanto te fascinaba. Solo una simple chica.\nY aun así, seguiste tratándome con cariño...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=0,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002320",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me dejé llevar por eso.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002321",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero... ya no más.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002322",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya me diste suficiente amor.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=0,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002323",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Bien, normies! ¡Dense sus votos ahora y acá, ante los cerezos milenarios!”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0005",head="yum_z1a",x=0,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002324",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yuumi Kawachino!”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0006",head="yum_z1a",x=0,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002325",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué pasa, Naoya Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gracias!”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=0,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002326",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No hace falta que lo digas, idiota!”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
vo={
{"vo",file="fem_rna_002213",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="優美",speed=500,mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Hikawa se acerca lentamente a Kawachino.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0020",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002214",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gracias, Yuumi... De verdad, gracias.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002327",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Para ya, soy yo la que debería darte las gracias...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002328",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre piensas demasiado las cosas. Que no seas honesta con lo que sientes es\nde cobardes.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002329",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En eso deberías aprender un poco de mí... Siempre he sido abierta a mis más\nbajos deseos, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002215",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no es verdad, Yuumi. Son muchas las veces que has aguantado por mí.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0009",head="rna_z1e",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002330",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nunca me he aguantado, ni me he reprimido. Todo este tiempo he seguido diciendo\nlo mismo.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002331",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Que me gustas. Que me encantas.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002332",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso somos distintas.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002333",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Has ocultado tu amor todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002334",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre, desde el principio.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002335",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por eso es que quizás, pienso yo, te sentiste aliviada cuando Rin-senpai\nregresó.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002336",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya no tengo que aguantar más. Ahora tengo una excusa para dejarlo todo y darme\npor vencida...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002337",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si me rompen el corazón, no tendré que aguantar más. Será la excusa para darme\nfinalmente por vencida. Eso habrás pensado.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002338",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Planeaste todo por tu cuenta e intentaste hacer que te rompieran el corazón.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002339",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero no puedo aguantar verte así...”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002340",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Necesito verte junto a la persona que realmente amas.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0020",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002216",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002341",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No pongas esa cara tan deprimente! Estoy celebrando que por fin los dos se\nunirán como pareja.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002342",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y creo que soy la persona que más celebra, y celebrará la unión de los dos.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002343",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque... porque soy yo la que más te quiere, y más que nadie... y también soy la\nque mejor sabe que Naoya Kusanagi es el hombre indicado para ti.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002344",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cómo esperas que no celebre esto?”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0019",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002217",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0019",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002345",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya te dije que no lloraras...”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Hikawa estaba rompiendo en llanto.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"Pero Kawachino no se quedaba atrás.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002346",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Las dos personas que tanto quiero por fin darán su primer paso juntos! ¿Cómo\npodría estar triste por eso?”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0020",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002218",ch="rna"},
},
ja={
{
name={"Rina"},
"“G-Gracias...”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002347",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Bien, Kusanagi! ¡Aquí tienes, la mejor de todas las damiselas!”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con gusto la recibo...”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",time=500,sync=1,mode=-2},
{"fg",ch="里奈",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0000",face="a0019",head="rna_z2a",lv=5,id=5},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Hikawa se aleja de Kawachino, y ahora viene caminando hasta acá.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Y llega lenta, lentamente, para finalmente ponerse justo frente a mí.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0020",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002219",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san, me...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0008j",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002220",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me gustas.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002221",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre, siempre me has gustado.”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0019",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002222",ch="rna"},
},
ja={
{
name={"Rina"},
"“Todo este tiempo...”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tú a mí.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0008j",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002348",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"Kawachino voltea y nos da la espalda.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_yum_002349",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, mis ojos...”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_yum_002350",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No soy capaz de quedarme a verlos. Así que...”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_yum_002351",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Al menos dense un beso de compromiso.”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_yum_002352",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aquí murieron Hakuki y Yoshisada. Dos que se amaron, pero que nunca pudieron\nestar juntos.”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_yum_002353",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Llegaron a los extremos de mostrarme esos raros sueños para cumplir mi deseo.”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
vo={
{"vo",file="fem_yum_002354",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así de sedientos están de amor.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_yum_002355",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así que probablemente reciban con gusto la unión de los dos.”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
vo={
{"vo",file="fem_yum_002356",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo muéstrenles.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="fem_yum_002357",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Cómo los dos... declaran su amor. Y prometen... que serán felices juntos.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"La espalda de Kawachino estaba temblando fuertemente.",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"Su voz, llorosa.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0020",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002223",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Pero no me detuve, y puse mi mano sobre la mejilla de Hikawa.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002224",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa...”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
"Intenté acercar delicadamente su cara...",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"Pero Hikawa movió su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0010j",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="いいえ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0000",face="a0002j",head="rna_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_002225",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estamos declarando nuestro amor. ¿Puedes llamarme Rina?”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, claro...”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Suelto una forzada sonrisa.",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rina cierra sus ojos.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"Y con un beso, nos unimos como pareja.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Aquí, donde los cerezos milenarios florecieron.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_11"},
{"text"},
linkback="block_00363",
},
label = {
top={block="block_00000",label=1},
},
}
