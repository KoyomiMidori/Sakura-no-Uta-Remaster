astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Al día siguiente, Sakizaki-kun estaba como de costumbre.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Kuriyama-kun tampoco vino a preguntarme nada.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Era un día como cualquier otro.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Y di mis clases como de costumbre.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",id=-1},
{"bg",file="ev_com_j01_01",path=":ev/ev_com_j01/",set="ev_com_j01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Humo se esparce entre la infinidad del cielo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"El humo del cigarro se esfuma entre lo azul.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"El invierno estaba terminando.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Estábamos en los primeros días de marzo.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Ya se acercaba la primavera.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Estamos en esa temporada en la cual el sol del mediodía se siente bien en la\npiel.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu... Qué bueno este cigarro...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Desde la azotea puedo ver a los estudiantes de tercer año dirigiéndose a la\nsala de profesores.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"No logro alcanzar a ver la expresión en sus caras, pero van trotando,\nvisiblemente alegres.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Universidad, instituto, trabajo. A lo que hayan aspirado, deben haber recibido\nbuenas noticias.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Me alegro por ustedes.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Susurré eso dentro de mi cabeza, a pesar de no conocerlos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Apago el cigarro en mi cenicero portátil.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, ya terminé por hoy. Supongo que regresaré algo temprano...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_j02_05",rule=139,vague=40,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000082",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Diablos, deja de invitarme a cada rato.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú eres el único a quien puedo invitar a salir a cada rato.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_j02_21",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000083",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Qué hay hoy? ¿Te pasó algo bueno?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al contrario. Quizá me despidan del colegio.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_j02_22",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000084",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, al parecer hice enojar a uno de la directiva. Al consejero Murayama.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000085",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿A un consejero? Estás bromeando, ¿verdad? ¿Cómo podría un simple profesor a\ntiempo parcial hacer enojar a alguien de la directiva?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo qué sé. Así que bueno, invítame algo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_j02_05",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000086",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No quiero. Además, tú cuenta de ahorros está más inflada que la mía.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero podría terminar desempleado en abril.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",file="ev_com_j02_04",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000087",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Je, ya veo. Bueno, ¡dos Hoppy, por favor!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, y unas dos copas de sake caliente para mí.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_j02_41",rule=139,vague=40,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",file="se9052",id=1},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000070",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Oh, oh? ¿Por qué tanto alcohol hoy?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, Nonomi-kun. Sucede que hoy Katagai pagará.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_ktg_000088",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Por qué se supone que ahora voy a pagar yo?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_j02_39",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000071",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Lo veo de buen humor.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? ¿Así parezco?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000072",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Sí. ¿Irritado, pero de buen humor, debería decir?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, qué list, eh. Me das miedo.\nPues sí, la idea de acabar en la calle me pone así.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_j02_41",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000073",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000074",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Vi la obra de luz, por televisión.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_ktg_000089",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Qué obra?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"A pesar de la cantidad de medios que se agolparon, la falta del factor\n'incidente' enfrió su interés rápidamente.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Hubieron unas cuantas críticas contra el colegio y la metodología de Bourbagi.\nRespecto a la obra como tal, fueron muy pocos los reportajes.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sin embargo, en los canales locales mostraron una y otra vez el momento en que\nla pintura y la proyección de luz se fusionaron.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Puedo decir que al menos, la impresión de la gente de la ciudad no fue mala.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_j02_39",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000075",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Esa obra la hizo usted, ¿verdad? Fue asombrosa.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No fui yo. Fue el grupo Bourbagi.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_j02_44",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000076",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ah, cierto. Así dice la versión oficial.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_j02_45",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000077",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Aunque,la gran mayoría de los alumnos saben ya que usted fue el autor.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Si siguen esparciéndose los rumores, mi despido podría ser aún más\ninminente...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_ktg_000090",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Qué? ¿Entonces lo de hoy es para celebrar eso?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso no escuchas? Podrían despedirme.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_ktg_000091",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No estoy entendiendo muy bien. Bueh, qué más da. ¡Salud!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Salud.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"se",id=1,file="se1282"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Glup*, *glup*, *glup*, *glup*... *Pwah*, ¡qué bueno esto! ¡El Hoppy de este\nlocal es delicioso! ¡Nada que ver con esos locales de puro shochu y Hoppy sin\nmezclar! ¡La mezcla de acá es sabrosa! Casi como cerveza.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_j02_39",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000078",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Por qué no pedir cerveza entonces?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_ktg_000092",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Concuerdo con Nono-chan.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? ¿Puedo?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_ktg_000093",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ni creas que te las voy a pagar.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no seas tacaño.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_ktg_000094",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Yo no soy tacaño...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ver los aperitivos... ¿Qué hay esta temporada?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_j02_41",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000079",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Que le parece algo de tataki de caballa?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se escucha delicioso.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nonomi-kun! Trae algo de ese tataki de caballa, y también calamar seco... Ah,\ntienes heshiko también, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_ktg_000095",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Hombre, estás pidiendo puros aperitivos fríos. Y yo tengo frío.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién te manda a pedir Hoppy? Yo tengo sake caliente.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_ktg_000096",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, demonios, bueno. ¡Nonomi-chan! ¡Imo shochu mezclado con agua caliente, por\nfavor! ¡Y con umeboshi!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_j02_39",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000080",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Entendido!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",file="se9012",id=1},
{"bg",file="ev_com_j02_23",sync=1,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿por qué no pides sake caliente?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_ktg_000097",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No se me da muy bien el sake. Te lo puedes quedar todo tú...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="man_ktg_000098",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, por cierto, ¿conoces una serie porno llamada PON? Salen chicas otaku\norinando. La descubrí recientemente.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí. No soy muy conocedor del porno, pero tengo entendido que es de estilo\nunderground. Lluvias doradas de chicas otaku, y eso.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_ktg_000099",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues parece que el director es un senpai de tu club de arte.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Hablas en serio? ¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_ktg_000100",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ese extraño senpai tuyo llamado Akashi. El que voló un día frente al colegio.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, Akashi~ Así que anda de director de películas porno.\nNo me sorprende nada~”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque ya sabía que no podría terminar como matón... Director porno, eh... Y\nademás, de lluvias doradas amateur...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_ktg_000101",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues parece que es todo un pro. Ha llevado a chicas otaku realmente lindas a\nhacer escenas de orina.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pro?...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_ktg_000102",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ha convencido a actrices que normalmente no harían esa clase de escenas\nalocadas. Y dicen que es un experto negociador.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Experto negociador?... ¿Qué método usa para negociar?...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_j02_36",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000103",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Tiene una licencia del amor, la cual usa para pedirles insistentemente.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Licencia del amor...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, el idiota ese estudiaba algo relacionado a eso.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y en qué consiste esa licencia del amor?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000104",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Al parecer se postra en el suelo pidiéndoles que actúen.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se postra en el suelo?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_j02_36",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000105",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sí, se queda plantado en el suelo todo el rato.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Postrado en el suelo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_ktg_000106",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Al principio siempre le rechazan, pero el insiste e insiste postrado en el\nsuelo, sin parar.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_ktg_000107",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Cuentan que con eso logra que todas accedan. Es increíble, todo un experto.\nUn genio.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un... genio? ¿A eso... le llamas genio?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"¿Y qué demonios es una licencia del amor?",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000108",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sí. Por cierto, también ha producido películas normales.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_ktg_000109",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Es más que todo cine independiente, aunque tienen buena fama.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Así que anda produciendo películas...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_ktg_000110",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Me vi una y debo decir que son muy buenas. Te impactan, describen muy bien el\nsufrimiento de las personas.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, vaya. Ha hecho también dramas... ¿De qué va la película?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ktg_000111",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues, a una madre de familia le crece un pe*e, y la familia sufre por eso.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",rule=216,time=300,sync=0,file="black",path=":bg/"},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"ex",time=500,func="wait"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000112",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Kusanagi, no te caigas. ¿Estás bien? ¿Ya te embriagaste?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"se",file="se0897s",id=1},
{"bg",file="ev_com_j02_38",path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es nada. Katagai... escucha, ¿estás hablando en serio?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000113",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“En serio, muy en serio. Me cautivó bastante. La última escena donde corta su\nmiembro con una tegatana mientras llora, Dios...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con una tegatana?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Creo que mejor no toco más el tema...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_j02_35",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000114",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Y bien? ¿Qué te ha pasado?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada... No ha pasado nada...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_j02_34",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000115",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Nada, eh...\nSolo alguien como yo, a quien realmente no le pasa nada, podría decir eso.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quiero decir, ¿qué me podría pasar? No soy empleado formal, no tengo novia, y\nahora podría terminar en la calle...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_j02_37",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000116",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Idiota... A eso me refiero cuando pregunto por si pasa algo...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo, algo, ¿qué significa algo? No entiendo bien...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_ktg_000117",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Si sigues haciéndote el tonto, no voy a invitarte nada.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Me pagarás los tragos?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000118",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues, ¿por qué no?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_ktg_000119",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Mi viejo amigo sigue brillando ahora de la misma forma que antes. Hay que\nbrindar por eso, así deba pagar yo.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Brillar?... ¿Recuerdas cuántos años tienes, Katagai?...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_ktg_000120",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Es que acaso los viejos no tenemos derecho a brillar también?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaría terrible.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_j02_39",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000081",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Eso no es cierto. Tomen, esto va por parte de la casa.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"se",file="se9049",id=1},
{"text"},
text={
ja={
{
"Nonomi-kun nos sirve té de cúrcuma.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_j02_40",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000082",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“No está bien que beba tan rápido. Vaya con más calma.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_ktg_000121",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Así es. ¡Ten cuidado!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Katagai se bebe de una sentada el té de cúrcuma que Nonomi-kun había traído.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000122",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Pwah! ¡Bebí bastante! ¡Iré un momento al baño!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, bueno.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Katagai se va al baño.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_j02_26",rule=139,vague=40,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000083",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Uiiin, qué cansancio, qué cansancio.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"se",file="se9010",id=1},
{"bg",file="ev_com_j02_28",path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
ja={
{
"Nonomi-kun se estira y se sienta en nuestra mesa.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás en medio de tu turno, ¿no? ¿Está bien que te sientes con nosotros?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000084",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ya atendí todos los pedidos, no hay problema. Kusanagi-san, ha estado bebiendo\ndesde que llegó, va a desmayarse.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, ahora tengo a una empleada de medio tiempo de un pub preocupándose por\nmí. Estoy mal, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_j02_29",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000085",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Me preocupo por usted como estudiante. Si sigue bebiendo de esa forma no se\nsentirá muy bien mañana.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces debe ser peor. ¿Tener a una estudiante preocupándose por mi forma\nde beber? Dios.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_j02_28",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000086",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿El licor lo tiene mal?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te parece?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Nonomi-kun gira su cabeza.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000087",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000088",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Nonomi no bebe alcohol, y nunca ha tenido que beber para calmar algún\nsentimiento. Así que no sé si usted está mal o alegre.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="ev_com_j02_29",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000089",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Por qué los adultos beben?Porque tristemente cuando nos volvemos adultos, solo\nel alcohol nos embriaga.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000090",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pero el niño no necesita beber. Solo jugar le basta para embriagarse...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién dijo eso?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000091",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“No lo sé. Lo encontré en internet.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_j02_28",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000092",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Debe ser complicado para usted.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Complicado?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="ev_com_j02_29",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000093",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Trabajar en un bar me ha enseñado que el mundo de los adultos es muy, muy\ncomplicado.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni tanto. El mundo era también complicado de joven.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_j02_28",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000094",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, o al menos eso creo.\nCuando trabajas de profesor tienes la oportunidad de observar muy bien a la población joven.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa microsociedad llamada colegio es más compleja de lo que parece.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso siempre pienso, ah, los jóvenes de hoy en día también la tienen\ndifícil.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000095",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Sí, la vida del estudiante tampoco es tan fácil.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000096",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Aunque, en nuestro mundo, la moral, la fuerza y la inteligencia son más\nsencillas que la del mundo de los adultos.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000097",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“El chico popular de la clase. El inteligente, con buenas calificaciones. Y el\nlíder, bueno en los deportes. Nuestro mundo es más sencillo que el de los\nadultos.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_j02_29",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000098",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Conseguir buenas calificaciones y entrar a la universidad que queremos, eso es\nlo único que define nuestro futuro.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_j02_28",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000099",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Las definiciones de moral, fuerza e inteligencia que nos dan son muy claras.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000100",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Por eso podemos brillar. De hecho, creo que solo el hecho de ser joven nos hace\nbrillar a veces.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_j02_31",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000101",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Por eso me parece estupendo que los adultos brillen también.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000102",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Brillar en este mundo tan complicado me parece increíble.Al menos a mí me\nparece fascinante que un hombre pueda lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un adulto brillando... Me imagino a alguien con muchos collares y joyas. No\nme gusta mucho eso.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bg",file="ev_com_j02_29",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000103",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Otra vez con sus bromas...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000104",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Aunque es típico de usted, sí...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000105",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Trabajando acá he tenido la oportunidad de observar a muchos adultos.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000106",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pero son pocas las personas como usted, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estás diciendo que soy único? Eso no suena mucho a elogio.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_j02_31",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000107",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Sí es un elogio! Vivir de esa manera para uno mismo me parece genial.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vivir para uno mismo? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000108",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Sí. Usted siempre está ocultándolo todo, pretendiendo ser inofensivo.Pero a mi\nparecer, usted es muy egocéntrico, y además avasallador.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000109",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“A mí me encanta la versión de 'Las huellas de los cerezos' de Naoya Kusanagi.\n¡Mucho más que la de Bourbagi y la de Kenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué idioteces dices? Los mismos reportajes lo han dicho, ese mural es obra de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_j02_30",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000110",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Si el estilo de sus obras fuese un poco más discreto, quizá me hubiese creído\nlo que dicen en televisión.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000111",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Aunque bueno, supongo que todo artista es egocéntrico.\nAsí no estén conscientes de eso, sus obras destilan partes de su ego.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",file="ev_com_j02_28",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000112",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“El filósofo Ludwig Wittgenstein llegó a decir esto una vez.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000113",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Cuando el genio es delgado, puede verse la inteligencia.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000114",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Qué se puede ver entonces de un verdadero genio?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000115",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Por cierto, él también llegó a decir esto.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bg",file="ev_com_j02_31",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000116",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Genio es talento practicado con coraje!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_j02_27",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000117",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Si bien no pareciera, todos están siempre con los ojos sobre usted, profesor.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"mwact",act="びっくり",size=5},
{"bg",file="ev_com_j02_30",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000118",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Oh oh, Katagai-san está por volver! ¡Bueno, regresaré a trabajar!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"se",file="se9012",id=1},
{"bg",sync=1,file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Katagai regresa y Nonomi-kun vuelve al trabajo.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"bg",file="ev_com_j02_37",path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000123",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Estuviste hablando con Nono-chan mientras yo estaba en el baño, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hablamos.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_j02_34",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000124",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Diablos, ¿y me dices lolicon a mí?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso hablar con ella me hace un lolicon?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_ktg_000125",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Fiuu...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_com_j02_33",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000126",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, jovencitas...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a venir de nuevo con tus perversiones criminales?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_j02_35",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000127",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No es eso. Solo que siendo joven todo es tan simple. Es sencillamente\nmaravilloso.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuve hablando acerca de eso con Nonomi-kun.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_ktg_000128",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Todo es tan claro, y esforzarse en algo es realmente fácil.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como si supieras tanto de eso... Nosotros dos somos ejemplo en carne y hueso de\nlo que pasa cuando alguien no se esfuerza de joven.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000129",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Tal vez. ¡Aunque pude ir a una buena universidad, e incluso entré al posgrado!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cual abandonaste.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_j02_37",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000130",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sí, porque decidí emprender un viaje espiritual.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_com_j02_33",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000131",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No puedes pretender vivir toda tu vida haciendo decisiones inteligentes...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas, nada hay de malo en vivir inteligentemente.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_j02_34",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000132",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Estás en lo correcto.\nPero ¿qué tiene de divertido andar diciendo siempre lo correcto?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez... Aunque ir en un viaje de iluminación espiritual tampoco tiene nada\nde inteligente.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_ktg_000133",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Vivir inteligentemente, eh...Nada que ver con mi vida, definitivamente...",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bg",file="ev_com_j02_35",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000134",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Aunque, has estado trabajando duro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que hay de ti?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000135",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Yo también trabajo duro. De lo contrario no podría mantenerme.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es de suponerse.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"bg",file="ev_com_j02_33",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000136",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Los adultos siempre trabajan duro, así no brillen.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para mantenerse, para vivir.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_com_j02_35",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000137",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“De llenos, intentando sobrevivir...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_ktg_000138",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Otro shochu, por favor!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000139",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Para mí también!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"bg",file="ev_com_j02_25",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000119",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Otro más? ¿De verdad pueden seguir tomando?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000140",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No te preocupes. ¡Hoy es día para beber!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_nnd_000120",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Cielo santo. No me haré responsable de ninguna resaca.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"se",file="se9012",id=1},
{"bg",file="ev_com_j02_23",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que de joven todo es simple...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000141",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando entras en la adultez la cantidad de cosas tediosas aumenta\nexponencialmente...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="man_ktg_000142",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pero también hay muchas cosas divertidas. Puedes beber alcohol, puedes fumar,\npuedes ir con prostitutas, comprar todas las golosinas, juguetes y\nvideojuegos que quieras.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="man_ktg_000143",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Al convertirte en adulto puedes hacer lo que te da la gana.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Discrepo con lo de las prostitutas, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"bg",file="ev_com_j02_36",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000144",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Vamos, no digas eso. ¿No quieres ir conmigo esta noche?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me basta con el alcohol.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",file="ev_com_j02_38",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000145",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues bebe entonces, y deja que el alcohol se lleve lo bueno y lo malo.\nEmbriagate de esa sensación que te llega hasta el estómago.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="man_ktg_000146",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Después de todo, no está mal hacerlo de vez en cuando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tú invitas, eh!”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000147",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Tenlo por seguro!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"De joven todo es simple...",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Fuerza, moral, y muchas otras cosas.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Y todo va complicándose a medida que se acerca la adultez.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"¿Será verdad eso?",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Aunque tiene algo de sentido.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"¿Me divertí hoy?",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"¿Estuve triste?",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"¿Animado?",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"¿O irritado?",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Es tan complicado lo que siento que no logro dilucidar qué es.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_07_2"},
{"text"},
linkback="block_00244",
},
