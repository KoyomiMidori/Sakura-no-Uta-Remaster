astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm029"},
{"se",id=1,file="se0888"},
{"text"},
text={
ja={
{
"Salgo de la casa de Rin.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024c",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Me hubiera gustado estar con ella toda la noche, pero regresé en dirección a\nKootoha, y además ayer también me quedé afuera. Creo que ya debería regresar\na la casa Natsume de una buena vez.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Y además...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta acelerar las cosas. Podemos ir acumulando el tiempo que pasamos\njuntos poco a poco...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Además, de ahora en adelante seguiremos juntos, por siempre.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Al bajar por las escaleras del apartamento de Rin, había la silueta de una\npersona.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=800,y=-420,zone="0x000000",file="zbg024c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0001",head="mtt_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Esa silueta es de...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Sí, era de esperarse. Nunca llegó a mostrarse, pero según parecen las cosas, él\ntambién está en esta ciudad. O más bien, quizás la razón por la cual no\napareció hasta ahora es porque estuvo procurando no hacerlo.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Al ver esa silueta, de cierta forma lo entendí todo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9004",id=1},
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg024c",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiempo sin verle, señor...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024c",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_mtt_000001",ch="mtt"},
},
ja={
{
name={"???"},
"“Ya veo, así que eras tú...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, Naoya Kusanagi. Es usted el padre de Rin Misakura-san, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000002",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, así es. Tiempo sin verte, eh... Aunque no sé si tengo aún el derecho a\ndecir eso...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, me alegro de volver a verle.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000003",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Según veo, parece que saliste del apartamento de Rin...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin-san y yo estamos en una relación.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000004",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000005",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, últimamente han estado juntos todo este tiempo. Ya estaba sospechando\nligeramente que quizás se trataba de eso.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000006",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Aunque desde pequeña siempre ha estado encantada contigo, así que debe estar\nrealmente alegre ahora...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, la verdad. Ella es una chica muy buena, quizás demasiado para mí.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000007",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Después de quedarse en silencio por un rato, el padre de Rin abrió la boca,\nmientras soltaba una sonrisa amarga.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000008",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Me pregunto qué diría un padre normal en estos momentos.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000009",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Tantas posibilidades que habrían si fuéramos una familia normal. Pudiera\nhaberte recibido gritando y quejándome, así como podría haberte invitado a\nentrar a la casa y formar parte de la familia.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000010",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sin embargo, ni siquiera ese derecho tengo ahora.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es verdad.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000011",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Rin sigue... sintiendo rencor por mí aún?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Me quedo en silencio, sin contestar.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Sin embargo, mi silencio no indica negación.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"No es más que un pesimista silencio, de aquellos que surgen cuando no se quiere\nreconocer algo.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000012",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ya veo, mejor así. Pase lo que pase, debo seguir siendo odiado por ella.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en ningún momento ha dicho de manera explicita que--”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000013",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Es lo mismo. Sé que no me ha perdonado aún, además...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me... Me parece absurdo que usted deba seguir siendo odiado por ella.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000014",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Eso crees? Juraba que tú también estabas de acuerdo con ello, todo este\ntiempo, desde aquel día...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque solo hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000015",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Eres tú quien está siendo absurdo ahora. No puedo evitar sentirme curioso por\nsaber por qué no me odias. En un principio, debiste haber sido tú, y no Rin,\nquien realmente terminara sintiendo rencor por mí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dice?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000016",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fui yo quien te despojó de tu brillante futuro.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se equivoca.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000017",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No, fui yo quien robó de tu futuro...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me agrada esa forma en la que usted lo está poniendo todo. En ningún momento\nhe sentido que me despojaron de nada. Sinceramente, me irrita que trate de\nhacerse ideas a su propia conveniencia solo para agrandar su sensación de\nculpabilidad por mí.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000018",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fufu, veo que sigues igual de terco, e igual de bondadoso además...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy bondadoso.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo soy quien decide mi propio futuro... No, diría más bien que soy yo quien\ndebe aceptar mi propio futuro. Usted no tiene derecho ni razón alguna para\ncomentar nada al respecto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, nada de lo que estoy diciendo ahora lo digo para confortarlo a usted.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo... hice mía a Rin.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000019",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso mismo, la razón por cual trato de proteger a Rin ahora no es por\nsimple bondad. Si estoy diciéndole ahora que usted no es culpable de nada, es\nporque quiero hacer feliz a Rin.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Querer cuidar de lo mío no es ninguna bondad. Es simplemente parte de mi ego.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que no siento, ni sentiré rencor por usted... no, más importante\nque eso, no quiero que Rin sienta rencor por usted.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de todo esto, quisiera que las cosas dejaran de ser como están ahora...\ny de ser posible, me gustaría que Rin y usted se reconcilien.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0003",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000020",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿No eres tú quien mejor lo sabe?... Lo que implicaría que Rin y yo nos\nreconciliemos.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto que lo sé.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0004",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000021",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Aún sabiéndolo, eres capaz de seguir diciendo esa clase de crueldades?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0003",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000022",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“A veces hay pasados de los que tenemos que deshacernos. Si deshacerse de ese\npasado es la mejor elección para la felicidad de sus hijos, es propio de un\npadre querer acabar con ese pasado.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también estuve perdido, sin saber qué hacer hasta hace unos días.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad no siempre hace a las personas felices... y por eso, esta verdad debe\npermanecer fuera de la luz. Así lo pensaba.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0001",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000023",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Así es. Es una verdad que debe ser oculta.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ya no lo pienso de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoce el nombre de una mujer llamada 'Sui'?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000024",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“... Por supuesto que lo conozco.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"El padre de Rin contesta, como si eso fuera lo más obvio del mundo.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay entonces de 'Olympia'?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000025",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Olympia? No, no lo recue-- Ah, no, claro, ese nombre...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo conoce?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000026",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, acabo de recordarlo. Sin embargo, ¿por qué preguntas de repente por ese\nnombre ahora?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada en especial, simplemente quería confirmar algo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000027",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Confirmar?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy viviendo de nuevo una experiencia enigmática.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000028",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Una experiencia... enigmática?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conoce los cerezos milenarios, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000029",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, los conozco. Aunque, no sabía nada en lo absoluto de ellos hasta ese\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000030",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Tal como lo debes saber, todos los detalles se los pregunté a tu padre, el\nseñor Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente, ese sueño está continuando aún.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000031",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿El sueño está continuando?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000032",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Podrías explicarme qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es tal como lo acabo de decir.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Señor Misakura. Suponiendo que existiera un sueño del cual no se pudiera\ndespertar, ¿qué cree usted que sería eso?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000033",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Un sueño sin despertar... Eso no tendría diferencia alguna de la realidad, ¿no\nte parece? Más bien, se podría decir incluso que un sueño sin despertar sería\nla misma realidad.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, yo también pienso de la misma forma. Si no se puede despertar, entonces eso\ndebería ser la realidad.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los sueños son sueños porque podemos despertar de ellos.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que, la realidad que ha continuado desde aquel día en que\nflorecieron los cerezos, podría terminar convirtiéndose en un sueño, en caso\nde despertar.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La relación que Rin y usted han tenido hasta ahora, podría terminar siendo solo\nun cuento más de ese sueño.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000034",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Pero qué ridiculez... Esta es la realidad. No es ningún sueño.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Esta es la realidad. Sin embargo, es posible que tal vez esa realidad\nsea la continuación de ese sueño.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000035",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Que la realidad sea la continuación del sueño...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si esa es la palabra más indicada para este caso. Aunque, es posible que\nel sueño que ha seguido desde aquel día, esté acercándose ya a su final...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esté haciéndolo por medio de esa realidad, llamada 'despertar'...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000036",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fuu. Soy ateo, te lo digo. No creo en lo absoluto en cuentos religiosos.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000037",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Y, a pesar de eso, me he topado ya una y otra vez con fenómenos extrañamente\nmisteriosos...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000038",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿A qué se deberá todo eso?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé... Aunque, el hecho de que lo haya visto con sus ojos no implica que\neso sea así. Es posible que aquello que consideramos misterioso, sea en\nrealidad parte de nuestro día a día, de algo totalmente comprensible.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por otro lado, es posible que nuestro rutinario día a día, sea parte de algún\nfenómeno misterioso...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000039",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No se puede negar que eres hijo de artista, eh. Todo lo que dices ahora es\ncomplicado... Es... filosófico.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. No es ni filosófico, ni artístico, ni nada por el estilo. Si no logró\nentenderme, entonces eso es porque mi explicación no fue lo suficientemente\nelaborada.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, me parece que aquello que las personas sienten al presenciar un\nfenómeno inexplicable, es importante.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son muchas las explicaciones que se pueden dar para esa clase de fenómenos.\n¿Qué era eso, por qué sucedió, y para qué? Diría que tanto del aspecto\nreligioso como del lógico se pueden encontrar explicaciones.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, todos deberían saberlo... De que, las explicaciones no son lo más\nimportante al momento que una persona presencia un fenómeno inexplicable...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo importante es aquello que esa persona siente en ese momento... A mí parecer,\neso es lo esencial.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000040",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que, por más que se le den explicaciones a esos fenómenos, de igual forma\nlas personas se quedarán una y otra vez paralizadas de nuevo ante esos\nenigmas...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Porque me has visto has creído? Dichosos los que no vieron, y sin embargo\ncreyeron.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000041",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿La biblia?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece. La frase me la enseñó una amiga.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Posiblemente, el hecho de haber o no visto no tenga nada que ver. Y si\nagregamos aún más, es capaz que el saber qué fue eso, y qué clase de fenómeno\nfue, tampoco...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo importante es, lo que uno sintió, pensó y creyó en ese momento... Así lo\npienso yo.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000042",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, ciertamente. Yo también pienso igual.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde el momento en que aquellos cerezos florecieron, usted creyó que eso era\nlo correcto. Aunque se tratara todo de una farsa, creyó que eso sería un acto\nde compasión.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... yo también creía lo mismo, hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ya no. Los sueños son sueños cuando se despierta de ellos de\nmanera debida. Los sueños sin despertar ya no son sueños. A los sueños se les\ndebe dar el despertar que corresponde.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000043",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Es por eso que estás buscando el despertar?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así pareciera estar siendo yo guiado ahora...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000044",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Guiado, eh... No hay nada con un tono más religioso y sospechoso que eso.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pienso lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, me parece que hay ciertas ocasiones en las que las personas lo ven\nde esa forma.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000045",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Una guía... Ya veo, el destino, eh...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000046",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Escucha, Kusanagi-ku-- no, Naoya-kun.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000047",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fuiste tú quien salvó a Rin. Y a pesar de eso, fui yo quien robó tu futuro.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se equivoca. Eso lo hice bajo mi propia voluntad. Y se lo diré una vez más, esa\nmanera de poner las cosas me saca de mis casillas.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000048",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, tienes razón. Estás en lo cierto.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000049",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Quizás esté fuera de toda razón decir esto ahora, pero ¿podría pedirte un\nfavor?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="稟父親",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟父親",size="z2",ex03="a0097",time=500,sync=1,mode=3,resize=1,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0003",head="mtt_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_mtt_000050",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Podría golpearte?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Abro ampliamente las piernas. Tomo algo de postura, bajando las caderas.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0004",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000051",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“... Voy entonces. ¿Podrías apretar los dientes?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, cuando quiera.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0003",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000052",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Hgh.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se1038"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"Un seco sonido resuena en plena noche por la zona residencial.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Era el tipo de escena en la que alguien consideraría llamar a la policia de\nllegar a presenciarla.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Sin embargo, y muy tristemente, no hubo nada de dolor en ese puñetazo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Solo un ligero ardor, con más ruido que dolor, penetró por mi mejilla.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024c",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_mtt_000053",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Bien, golpéame ahora a mí.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0005",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000054",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Por qué? Eres tú quien más que nadie debería tener el derecho de golpearme.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Si llego a golpearlo ahora, es probable que le disloque el hueso de la\nmandíbula, o en otro caso, hay la posibilidad de que sufra de una fractura de\ncráneo con el impacto al caer sobre el suelo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no quisiera acabar tras las rejas por homicidio preterintencional.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000055",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace tiempo estabas más gordo y fornido, viejo. No eras la clase de hombre\ncapaz de dar esa clase de puñetacitos.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000056",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pretendiste pasarme factura por haberme quedado con tu hija con ese golpe, ¿no?\nMe golpeaste porque estás dispuesto a dejarlo todo en mis manos, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000057",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, así es... Y sin embargo, no tengo siquiera valor como para recibir un\npuño de vuelta tuyo...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No soy capaz de golpear a alguien de puñetazos tan\ndébiles. Tiene primero que comer, engordar un poco y darle poder a esos\npuños, por lo menos lo suficiente como para dejarme tirado en el suelo...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000058",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Naoya-kun...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acabo de hacer mía a su hija. Muy barato resultó ese puño tan enclenque, diría\nyo, pero igual lo tomaré como cuenta saldada por ahora.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que Rin es y será mía, de ahora en adelante. Ya no le pertenece a usted.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000059",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No tengo forma de responderte...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si llega a recobrar suficiente fuerza como para mandarme de un golpe por\nel aire, entonces le regresaré a Rin.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000060",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Naoya-kun...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llega a recobrar tanta fuerza y espíritu como para poder hacer eso, en ese\nmomento usted debería ser capaz de proteger de nuevo a Rin, como su padre...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin necesita a su padre. Ahora que su madre no está, más que nunca usted\ndebería servirle de apoyo a ella. Así debió haber sido, en un principio.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, de llegar a recobrar la fuerza como para hacer eso, le regresaré a\nRin.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000061",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Jajaja... Pero qué tipo tan excéntrico eres, de verdad. En primer lugar, la\nfuerza de los puños no es la misma fuerza que un padre necesita para proteger\na su hija, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una cuestión de espíritu. En estos momentos, usted es un pendejo. No hay\nforma de que pueda proteger a una hija de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000062",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Vaya que eres bueno provocando, eh. De verdad que eres un excéntrico.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pueees, señor Misakura, diría que usted también es bastante excéntrico.\nNormalmente nadie le diría de repente a otra persona 'déjame golpearte'.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000063",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No podía evitarlo, Rin es y seguirá siendo mi amada hija. No podía contener las\nganas de golpear al hombre que se apropió de ella. En primer lugar, ¿qué\nestuviste haciendo todo este rato en el apartamento de mi hija?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues aquello que harían dos jóvenes a solas, y debajo de un mismo techo. Lo\ndemás se lo dejo a su imaginación.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000064",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fuu... y lo dices sin vergüenza ni tapujo alguno... Me quito el sombrero ante\nesa actitud tuya.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque Rin es mía ahora.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000065",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, está bien, ya entiendo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Al decir eso, el padre de Rin sacó un abultado sobre de su bolsillo.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0001",head="mtt_z2a",lv=5,id=9},
{"fgact",ch="稟父親",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_mtt_000066",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Quédate con esto.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es este sobre?... ¿Puedo abrirlo?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0004",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000067",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, no me importa...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Al abrir ese grueso sobre, de adentro salen una gran cantidad de fotografías.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estas son... fotografías... Espere...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0001",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000068",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Probablemente, eso es lo que ustedes deben buscar.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0004",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000069",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No sé por qué, pero por cosa extraña me dio por traer estas fotografías acá.\nVaya qué cosa tan misteriosa, eh.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟父親",size="z2",ex03="a0097",mode=3,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0001",head="mtt_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000070",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sui... Llevaba un buen rato sin escuchar ese nombre de la boca de otra persona.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000071",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Bien, creo que yo también me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000072",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“A partir de mañana comenzaré a tomar proteína después del trabajo e iré al\ngimnasio a entrenar, todo para prepararme para nuestro próximo encuentro.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espere, no tiene que hacer tanto tampoco... Basta con que comience a comer\nde manera normal...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000073",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Se supone que debo ser capaz de dejarte desmayado en el suelo a punta de\ngolpes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espere, se equivoca, eso no es precisamente lo que pretendía que usted\nhiciera. Digo, la verdad es que a mí tampoco me gusta el dolor.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000074",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ajaja, solo bromeaba. Pero, tienes razón en lo que dices. Lo perdí todo en\naquel momento, y ahora ando en este cuerpo tan frágil y debilucho. Tengo que\nprocurar comer un poco más.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que lo tiene que hacer. Si no come bien no vivirá por mucho. Y\nademás es malo para la salud no hacerlo, terminará muriendo fácilmente como\nmis padres.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000075",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Pero qué muchacho tan enigmático eres, eh. No parecieras ser mucho menor a mí,\nla verdad...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es así, eso solo prueba que su tiempo se ha quedado parado por completo,\nseñor Misakura. Yo no soy más que un impertinente niñeto de mierda.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000076",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Jajaja, está bien, procuraré hacerlo entonces. En fin, me retiro por hoy.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="稟父親",speed=500,sync=1,mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",ex03="a0097",head="mtt_z1a",x2=0,x=-680,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",x=-680,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000077",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ah, cierto, respecto a la protección al hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No hay problema por eso.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",x=-680,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000078",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No hace falta que se preocupen por eso.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qué carajos?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",x=-680,lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000079",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ajaja, solo bromeaba. Pero, prométeme solo esto, por favor. No importa con que\nsea solo por ahora, haz feliz a Rin, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No será solo por ahora. La haré feliz por el resto de nuestras vidas.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0002",head="mtt_z1a",x=-680,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000080",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Fuu, estaba esperando que me dijeras eso. Te lo agradezco, Naoya-kun...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟父親",mx=-40,mode=-1,lv=4,id=9},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"El padre de Rin se fue después de eso.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Seguramente no vino hoy acá por mera casualidad.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Probablemente se la ha pasado viniendo todas las noches, después del trabajo,\npara quedarse parado frente al apartamento de ella.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"De su amada hija.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Solo mediante un falso rencor es que ha podido protegerla.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Lo único que puede hacer es velar por ella, de lejos.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Y ahora, a mi parecer, seguir haciendo eso no es lo correcto.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Sea lo que pase, yo protegeré a Rin.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Seguramente llegará de nuevo a aquel cruel destino. Y cuando llegue ese\nmomento, esta vez sí la salvaré, de verdad, de la forma que debió haberse\nhecho.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien... creo que debería ir-- ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-960,y=-410,zone="0x000000",file="zbg024c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0001",head="kan_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Hay la sombra de una persona detrás del poste telefónico.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién está ahí?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
delay={
[500]={
{"fg",ch="香奈",mx=1280,mode=-1,lv=5,id=9},
{"se",file="se0744s",id=1},
},
},
text={
ja={
{
"La persona que estaba allí comienza a correr.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bgm",file="bgm015"},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"se",file="se0744",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=100,file="zbg030c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"cgact",stage="zbg030",y=100,act="びっくり",loop=-1,size=5,time=200},
{"text"},
text={
ja={
{
"Comienzo a perseguir esa sombra. Pude alcanzarla y atraparla más fácilmente de\nlo que esperaba.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"msgoff"},
{"se",stop=1,id=1,time=500},
{"se",file="se3130",id=2},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",y=30,zone="0x000000",speed=300,file="zbg030c",path=":bg/",x2=390,y2=30,x=190,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="香奈",size="z2",speed=300,mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0001",head="kan_z2a",x2=200,x=0,lv=5,id=9,sync=0},
{"extrans",time=100},
{"quake"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg030c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Per-, ¿tú?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000109",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ajaja, Naoya-kun, buenas noches para ti.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Que estabas haciendo allí hace un momento?!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000110",ch="knd"},
},
ja={
{
name={"Kana"},
"“N-No estaba haciendo nada.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estuviste escuchando a escondidas? Imbécil, ¿escuchaste toda nuestra\nconversación?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000111",ch="knd"},
},
ja={
{
name={"Kana"},
"“Para nada, para nada, simplemente llegué acá por pura coincidencia... No tenía\nintención alguna de esconderme.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Menos mal... Entonces no llegaste a escuchar la parte acerca de que la madre de\nRin era en realidad un hombre, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0009",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000112",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Ehhh? ¿La mamá de Rin era un hombre? ¿Pero, no es eso raro? La persona con la\nque estabas hablando era un hombre, Naoya-kun. No hay forma de que dos\nhombres puedan procrear, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, entonces por lo menos llegaste a escuchar tanto como para saber que ese\nhombre era el padre de Rin, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000113",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué tanto llegaste a escuchar?!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000114",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ejeje, perdóname, ¿sí, Naoya-kun?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Perdonar qué?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000115",ch="knd"},
},
ja={
{
name={"Kana"},
"“No te dejes agarrar por la policía, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"quake"},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0021",head="kan_z2a",lv=5,id=9},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"fgact",ch="香奈",act="いいえ",loop=-1,size=15,time=280,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000116",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡KYAAAAAAaaahh! ¡Un pervertido, un pervertido está tratando de violarme! ¡Me\nvan a violaaaar!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fgact",ch="香奈",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qu--?!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0020",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000117",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Iyaaah, aléjateeeeeee!”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esp--, e-eh...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mna_000001",ch="mna"},
},
ja={
{
name={"Oficinista A"},
"“¡Eh, tú! ¡¿Qué mierda estás haciendo?!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mnb_000001",ch="mnb"},
},
ja={
{
name={"Oficinista B"},
"“¡Y en una zona residencial!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿EEEHHH?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000118",ch="knd"},
},
ja={
{
name={"Kana"},
"“Bien, me retiro entonces～”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="香奈",mx=-40,mode=-1,lv=5,id=9},
{"se",file="se0744s",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, tú!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mna_000002",ch="mna"},
},
ja={
{
name={"Oficinista A"},
"“¡¿Pretendes huir ahora, maldito depravado?!”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mnb_000002",ch="mnb"},
},
ja={
{
name={"Oficinista B"},
"“Acabo de llamar al 110, la policía viene en camino.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡¿EEEHHH?!”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Esperen un segundo!”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mna_000003",ch="mna"},
},
ja={
{
name={"Oficinista A"},
"“¡Quédate quieto y ríndete de una vez!”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"msgoff"},
