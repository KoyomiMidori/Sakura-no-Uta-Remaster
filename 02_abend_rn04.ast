astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"se",id=1,file="se2554"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero quién viene a estas horas de la mañana...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Solo han pasado unos pocos minutos de haber despertado, así que mi cabeza aún\nestá algo nublada. La aguja del reloj estaba por marcar las 7 AM.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién podría venir a visitar la casa Natsume a esta hora?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Todos los Natsume son absoluta y terriblemente débiles a las mañanas,\nobviamente no hay rastro de que alguien haya ido a atender la puerta.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué lata...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
"Por los momentos abro la entrada, y grito a través del portón.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién es~?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000822",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, soy Misakura...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Los engranajes de la cabeza se me paran por unos segundos.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"¿Eh? ¿Rin?",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"¿Por qué Rin está viniendo a estas tempranas horas de la mañana a la casa\nNatsume?",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
"Abro el horriblemente pesado portón de la casa Natsume.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000823",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Por qué vienes tan temprano?...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000824",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Esto, vine a preparar la comida.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿A preparar la comida?!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Ante esa extraña y absurda oferta, hago entrar rápidamente a Rin a la casa.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué pretendes?!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000825",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡L-Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú... ¿Formas parte de alguna conspiración en mi contra viniendo a prepararme\nla comida? ¿Es alguna treta, alguna estratagema? ¡¿Bajo las órdenes de quién\nestás tratándome con tanta amabilidad?!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000826",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Esto... ¿No lo acordamos anoche?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acordar... anoche?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Algo que acordamos anoche.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso acordamos algo?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000827",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Lo hicimos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Mi mañana comenzó con la tensión baja.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Aún algo adormilado, indago en mis recuerdos.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahora que lo recuerdo, yo había dicho eso...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000828",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Me asusté.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Umuh, ya recordé bastante... Ciertamente me da la sensación de haber acordado\neso con Rin.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Aunque sinceramente, no pensé que de verdad llegaría a venir.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Quizás por cortesía, o no sé muy bien, pero en fin, pensé que solo lo dijo por\ndecir.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm011"},
{"se",id=1,file="se1049"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000829",ch="rnd"},
},
ja={
{
name={"Rin"},
"♪～.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Rin está parada ahora dentro de la cocina.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Anoche también pude verla parada allí, pero realmente su forma de moverse y\nactuar en la cocina es muy diestra.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"se",stop=1,time=500,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000830",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm, el katsuobushi en arakezuri está...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, si es por el dashi hay dashi en polvo. No tenemos katsuobushi en arakezuri.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000831",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, entendido. Esto, el dashi en polvo está...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Me cuelo por detrás y saco el dashi en polvo del estante.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000832",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está en este estante. Aunque está un poco difícil de alcanzar con tu altura,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000833",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012j",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000834",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Ja? Sí. Esto... Wah, wawah, ¡va a derramarse!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Rin se apresura y baja el fuego.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000835",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fuh, estuvo cerca, estuvo cerca.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, de verdad eres bastante hábil, eh.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000836",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si fuera tan hábil no hubiera peligro de que se me derramara nada.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso fue porque yo vine a hablarte, ¿no? Hasta entonces estuviste bastante\natenta.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000837",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues quizás...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a ser una muy buena esposa.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012i",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000838",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, con tanta habilidad para la cocina como la tienes lo serás.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000839",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, ese tipo de líneas tan mortales tuyas estremecen, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso de línea mortal?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000840",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es nada. Vamos, Nao-kun, ve a despertar a los demás. Yo me encargaré de\nservir todo mientras tanto.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000841",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias por el favor.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002i",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000842",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Una buena esposa...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"¿Por qué Rin habrá estado todo el rato con los ojos humedecidos?...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"También da la impresión de que su forma de hablar está un poco más torpe de lo\nusual...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Y, pareciera tener las mejillas sonrojadas también.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿tienes fiebre o algo así?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012i",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002i",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000843",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Eh? Ah, no, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Está bien entonces, supongo...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0110",face="b0003i",head="rin_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000844",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Mira nada más, así de enérgica estoy~”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Al decir eso, Rin hace una pose flexionando los brazos.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Aunque, obviamente los brazos de Rin no tienen nada...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que esa pose no indica mucho si estás bien o no...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001i",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002i",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000845",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, s-sí, tienes razón... Ah, olvida eso y ve a despertar a los demás, por\nfavor. Rápido, rápido.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"se",file="se9002",id=1},
{"bg",file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Nao-kun desaparece.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000846",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fuu, al fin se fue...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008i",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009i",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000847",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que estaría bien al levantarme en la mañana, pero realmente me late tan\nrápido el corazón al estar los dos solos. No estoy nada bien...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010i",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000848",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aun habiendo liberado tanta tensión ayer para no verme tan atormentada hoy...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008i",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009i",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000849",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente no hay problema si es mientras cocino, pero... Pero, no puedo\naguantar el roce de piel.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000850",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De rodearme por atrás de repente de esa manera... por un momento pensé que me\nabrazaría...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000851",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, no, no, esto está mal! ¡Si me imagino ese tipo de cosas volverá a suceder\nlo mismo que ayer!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005i",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000852",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debo tomar un poco más de cuidado a partir de ahora.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002i",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009i",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000853",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero realmente se me sobresalta el corazón cuando me ataca por la espalda. Qué\ntan feliz sería si de verdad me abrazara por atrás...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004i",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002i",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000854",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja... Qué idiota soy. Aun cuando solo vino a coger algo del estante por mí,\nterminé haciéndome muchas expectativas.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"se",id=1,file="se2152"},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000855",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Wah! ¡Wawah! ¡Está vez si se derramó de verdad!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000856",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No es momento de andar yo imaginándome cosas raras!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
