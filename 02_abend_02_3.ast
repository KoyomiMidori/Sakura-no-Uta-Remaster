astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000,sync=1},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000451",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Hoy vuelvo a supervisar la pintura de Rin por primera vez después de un\nconsiderable tiempo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Entre los exámenes y el descanso por los exámenes, no ha tenido tiempo de\npintar.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Además, en principio, se supone que en esta época se debería estudiar bastante\npara los exámenes de ingreso a la universidad.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"El verano es justamente el punto decisivo de los exámenes de ingreso.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Aquellos como Rin y Toritani que han venido estudiando poco a poco todos los\ndías desde primer año no tienen mucho problema, pero para tipos como yo que\nlo único que han hecho hasta ahora es divertirse y perder el tiempo, no es\nprecisamente la mejor época para tratar de andar de ocioso.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Aunque de igual manera sigo haciéndolo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Pero bueno, aun así, he procurado estudiar algo más desde que comenzó este año.\nAunque, debo enfatizar que ese 'más' es relativo a lo que he estudiado los\naños pasados...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000452",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mm... nnn... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Rin batalla con el lienzo, pareciendo tener dificultades para pintar.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás haciendo?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000453",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, pensé en corregir esta parte, pero parece que se ha endurecido por\ncompleto...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Las pinturas en óleo tardan bastante en secarse. Se necesitan varios días para\nque se sequen por completo sobre el lienzo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Rin estuvo pintando casi todos los días hasta antes de los exámenes, pero en el\nperíodo de exámenes y descanso de exámenes, hasta el día de hoy, no llegó a\ntocar casi su pintura.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Parece que algunas partes estaban ya totalmente endurecidas.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tendré que arrancar esta parte por completo, ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000454",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, está bien.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, yo me encargaré entonces de despegar la parte endurecida.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Tomo en mano la solución removedora. Aquellas pinturas que no se disuelven con\naguarrás se pueden remover con esto.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si uso esto...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Después de aplicar el removedor, froto esa parte con un trapo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000455",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que no se despega.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué le pasa a esto? Por lo general la pintura debería caerse con el\nremovedor...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Traté de disolver una y otra vez la pintura con la solución removedora, pero no\nse despega en lo más mínimo.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Aunque es raro que no caiga, aun con removedor. ¿No será que esta pintura tiene\nalgún componente extraño?",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿dónde compraste esta pintura?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000456",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Esto, es la misma que me diste, Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"quake",size=3,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Ahh, las pinturas abandonadas en la sala de arte que reuní de manera\ndesordenada.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Rin ha estado pintando con estas pinturas de procedencia desconocida, mezcladas\nal azar (Aunque, ciertamente es mi culpa...).",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... bien.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ahora termina la pintura, sin preocuparte por esa parte.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000457",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? P-Pero se disolvió parcialmente, y ahora tiene baches y bultos encima...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema. No trates de tocar esa parte por hoy. Después me encargaré\nde hacer algo con esto.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000458",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... está bien. En fin, trataré de pintar lo que resta.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Rin toma el pincel de nuevo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000898",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jee, parece que ya te acostumbraste a usar la pintura, eh.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000459",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad? Pero, el cuadro no está resultando tan bueno.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000899",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? A mí me parece que tienes buen nivel.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000460",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me alegra que me digas eso, Mako-chan...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000900",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa, Kusanagi? ¿Por qué el rostro complicado?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo pensaba que a ti también te parece que la pintura de Rin tiene\nbuen nivel...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000901",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es. ¿No es así, acaso?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, así es, pero...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"'Tiene buen nivel'",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Ciertamente, así es, pero... también hay algo que está fuera de lugar.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Aunque no sé de dónde proviene exactamente esa sensación de que algo está\nfuera de lugar...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"¿Será simplemente porque 'así me lo dijeron'?",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_yum_000279",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kusanagi-senpai, ¿tienes un momento?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, también tengo que enseñarle a los demás, hablamos después.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000902",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, realmente no hay tanto de qué hablar respecto a ese tema...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Observo el reloj. Supongo que ya es hora de culminar por hoy.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000461",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ya es la hora?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya es hora de volver a casa. Tengo que preparar la cena también, además.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000462",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿La... cena?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me estoy alojando donde los Natsume. Estoy de huésped ahora, me daría pena\nno colaborar en nada, así que trato de cocinar, por lo menos.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000871",ch="ked"},
},
ja={
{
name={"Kei"},
"“No tienes que preocuparte tanto por eso. Aunque la comida de Naoya es realmente\nsabrosa, así que nos ha colaborado bastante en ese aspecto.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, es hora de irnos ya.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000903",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes razón. Creo que deberíamos dejarlo hasta acá ya.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000872",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, regresemos a casa.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000904",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, cierto! ¿Qué les parece si regresamos a casa juntos?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000873",ch="ked"},
},
ja={
{
name={"Kei"},
"“No está mal hacerlo de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000280",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero nosotras tomamos el tren con dirección contraria.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000463",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero todos tomamos el mismo camino hasta la estación, ¿no? ¿No les gustaría ir\njuntos?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000281",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, no sé. ¿Qué hacemos, Rina?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000228",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, creo que no es mala idea. Sería bueno cambiar un poco la rutina y regresar\ntodos juntos hoy, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se1666",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg019b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
"El tren parte de la plataforma de la estación Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Por supuesto, ni Kawachino ni Hikawa, quienes iban en la dirección contraria,\nestán ya.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Fuimos Rin, Toritani, y yo, y por cosa rara, Kei también, los que nos montamos\nen el tren.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Parece que la motocicleta de Kei está en mala condiciones, y hoy se vino en\ntren.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"se",stop=1,time=500,id=1},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000874",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué vamos a comer hoy?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, estaba pensando en un nikujaga de cerdo, ¿qué te parece?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000875",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Genial! ¡Nikujaga de cerdo! Me gusta.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000905",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmm, ¿el hecho de que digas 'nikujaga de cerdo' significa que también lo\npreparas con res a veces?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. La única diferencia entre usar res o cerdo es la presencia o la\nausencia del jengibre.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000906",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen que cada familia usa sus propios ingredientes al preparar nikujaga, ¿no?\n¡Nosotros usamos cerdo! ¡Nosotros res! Y así.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Qué desperdicio, con lo sabrosos que son ambos.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000876",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ambos son distintos, y ambos son buenos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000907",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, eres bueno en la cocina, ¿cierto? ¿Sueles preparar platos lujosos y\nelaborados como lo hacen los hombres normalmente al cocinar?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Platos lujosos y elaborados? ¿Como lo hacen los hombres? ¿De qué rayos estás\nhablando? ¿No se supone que normalmente los platos de los hombres son\nrudimentarios y crudos?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000908",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para nada, eso es cosa del pasado.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000909",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Últimamente cada vez más hombres cocinan por hobby, ¿no? Parece que usan un\ndescabellado surtido de ingredientes y condimentos, y preparan platillos\nminuciosamente elaborados. Aunque bueno, eso es lo que dicen las revistas.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso lo hacen los que cocinan por hobby, pero yo no lo hago por eso. Simplemente\nllevo bastante tiempo cocinando para alimentarme, así que realmente no puedo\npreparar nada elaborado.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000877",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero puedes preparar paté, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es que el hígado es barato. ¿Cualquiera se aburriría comiendo hígado y\nnira salteada todos los días, no crees? Así que se muele y se hace paté con\neso.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, su afinidad con las cortezas de pan de ajo es excepcional. Si hay\nalgo que es absolutamente útil en los días en que no puedo comprar arroz es\nel paté de hígado de pollo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000910",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa manera de pensar va en dirección totalmente contraria al tono refinado que\ntiene la palabra paté.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000878",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahora que lo mencionas, no has preparado más paté desde que comenzaste a vivir\nen nuestra casa, ¿no? Últimamente ha sido pura comida japonesa.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque tengo arroz. Si no tengo que preocuparme por la afinidad de los\ningredientes con corteza de pan entonces me inclino naturalmente por la\ncocina japonesa.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000911",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, simplemente porque hasta ahora no tuve oportunidad de comerla.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x2=345,x=570,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="稟",size="z1",mx=-40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000464",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero la comida tradicional japonesa es bastante difícil. Por ejemplo, los\nplatos preparados por cocción.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen que los platos por cocción son difíciles, pero personalmente, no estoy\nmuy seguro. Me parece mucho más difícil preparar frituras.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=0,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000912",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, te entiendo muy bien. Cuando uno es pobre se siente renuente a usar mucho\naceite, y eso provoca que termines más bien fallando al prepararlas.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, cuando vives solo es mucho más económico comer frituras afuera. Así que\nmi experiencia preparándolas es poca.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=0,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000879",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero también nos preparas frituras a menudo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es también porque me dan ganas de comerlas. Cuando vivía solo no me gustaba\ngastar tanto aceite, así que no tenía muchas oportunidades de prepararlas.\nAhora que vivo con varias personas, puedo prepararlas cuando quiera.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000880",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo. Aunque no sabía que se te hacían difíciles, te quedan muy buenas.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es fácil ver buenas harinas para freír en el mercado últimamente. De esas que\ndejan las frituras crujientes. También me di cuenta recientemente de que si\nusas agua carbonatada en lugar de agua normal al preparar tempura, es fácil\ndarle buena pinta a la cubierta.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000465",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ¿eso no significa que eres bueno preparando frituras también?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no, no se le puede denominar de experto en frituras a alguien que usa\nharina para freír o agua carbonatada para la cubierta del tempura.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000466",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? A mí me parece que lo más importante es que a la persona que coma\nle guste la comida.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=0,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000913",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmm, agua carbonada para el tempura, eh. Lo probaré un día de estos. ¿No tienes\nalgo más? ¿Algún truco para los platos por cocción o algo así?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no hago nada especial. Simplemente sigo las básicas del\n'SaShiSuSeSo', y en el caso de cocer pescado, nunca lo dejo demasiado tiempo\na menos que esté preparando kanroni. Al hervir lo dejo en fuego alto y trato\nde cocinarlo lo más rápido posible. Aunque bueno, eso también es algo básico.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000881",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué son esas básicas del 'SaShiSuSeSo'?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000914",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es el orden en el cual se usan los condimentos. 'Sa' se refiere al azucar\n(satou), 'shi' para sal (shio), 'su' para vinagre (su), 'se' para aceite de\nsoya (shoyu), y 'so' es... ¿Qué representaba 'so'? ¿Salsa?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=570,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000467",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me parece que es miso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tendrías que agregarle salsa de repente al final? Vas a terminar con\nun sabor bastante desastroso así.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000915",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero es que normalmente no se le agrega miso a los platos cocidos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A los platos cocidos no, pero sí hay platillos a los cuales se les agrega.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000468",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque bueno, parece que únicamente es importante respetar el orden del azúcar\ny la sal. Lo demás depende del plato a preparar.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000469",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Aunque simplemente fue algo que escuché a medias.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000470",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que las partículas de azúcar son mucho más grandes que la de la sal, así\nque si se invierte el orden entonces se hace difícil que el sabor se adentre\nen la comida. Y además, la sal endurece los ingredientes, así que parece que\nes difícil darle dulzura al plato en ese caso...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=0,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000916",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jee, sabes bastante. Rin-chan también parece ser buena cocinando.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="いいえ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000471",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000917",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero cocinas, ¿no? Los obentou que siempre traes los preparas tú, ¿no es así?\nEsas enormes cajas dobles.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000472",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es, pero... Hmm, diría que es algo parecido al caso de Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000882",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Igual a Naoya? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0009",head="rin_z1b",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0010",head="rin_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000473",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también cocino para mí, o, digo... esto... ¿cómo podría ponerlo?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_ked_000883",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000474",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues vivo sola, así que tengo que cocinar todo por mi cuenta...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=570,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000884",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Por qué? ¿Por qué estás viviendo sola estando en tercer año y habiéndote\nmudado a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0011",head="rin_z1b",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000475",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es que...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0011",head="rin_z1b",x2=-570,x=-345,lv=4,id=3},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x2=0,x=345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000918",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmmm. Entonces tú también debes ser muy buena cocinando, ¿no, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Toritani ignora a Kei y continúa la conversación como si nada.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Una chica viviendo sola.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Si se muestra reacia a hablar de la razón, entonces es natural evitar ese tema.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"La perspicaz Toritani se dio cuenta rápidamente de eso.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="いいえ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000476",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso no es cierto, Mako-chan, no me pongas las cosas tan difíciles.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no aprendiste por tu cuenta, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000477",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, las básicas de la cocina me las enseñó mi abuela.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces tus comidas deben ser mejores que las mías. Es esencial aprender de\nalguien más.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000919",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces, ¿qué tal si vamos a cocinar hoy? ¡Por supuesto, Rin-chan cocinará\npara nosotros!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo cómo hiciste para llegar a la idea que describiste después de ese\n'entonces'. Además, no está bien hacer eso. Si Rin no prepara la cena su\npadre no tendrá nada que comer hoy, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000478",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no hay problema por eso. Nunca veo a mi papá, así que...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, y-ya veo...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Aún viviendo separados, pensé que por lo menos se veían. Pues, es probable que\nél esté viviendo en esta ciudad también...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000920",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, no hay problema, ¿no? Vayamos todos a la casa de los Natsume.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000479",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si vamos a la casa de Kei-kun, entonces me parece que hay que pedirle\npermiso a la profesora Ai primero.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_ked_000885",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, hace un momento le escribí y me respondió 'No hay problema'.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan pronto? Eres bien rápido mandando mensajes, eh...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_ked_000886",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Te parece?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Pensé que solo las chicas eran capaces de escribir mensajes tan rápidamente con\nel celular.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Aunque bueno, quizás sea un prejuicio de mi parte. Simplemente me da la\nimpresión de que los hombres son lentos al escribir.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000480",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, me alegraría bastante ir, pero ¿no se molestaría Kusanagi-kun por eso?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería ser una molestia para mí? No cocino por hobby. Si alguien más\nme prepara algo de comer, entonces comeré con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000921",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. ¿Por qué no aprovechas también y lo ayudas a estudiar?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso me ayudaría bastante.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000481",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A estudiar? ¿No te importa que sea yo quien te enseñe?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, ¿cómo vas a decir eso tú, la muchacha con las mayores\ncalificaciones nunca antes vistas en Yumihari desde su fundación?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000922",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que te irá muy bien en los exámenes de geografía, eh.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, no necesito ayuda con eso. No pienso incluir geografía en mi lista de\nmaterias para los exámenes de ingreso.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000482",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡También estudiarás Geografía!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero q-- ¡¿Es esta la misma Rin que nunca insiste en nada de su parte?!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000483",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que, de lo que pude ver hoy, me parece que la razón por la cual odias la\nGeografía es meramente por ser quisquilloso con las materias. Estoy segura de\nque podrás mejorar en poco tiempo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000923",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, concuerdo en eso. Me parece muy raro que alguien que sea capaz de producir\npinturas tan excepcionales no pueda leer un mapa que requiere de simple\npercepción espacial. ¿No usan acaso las dos la misma habilidad? Tanto\npinturas como mapas.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no siempre. Hay algunas personas que a pesar de saber pintar bien, tienen\nun terrible sentido de dirección.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000484",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás también hayan personas así, pero tú eres distinto, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás más estricta de lo normal, eh.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=3},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000485",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Pero ahora que tienes posibilidades de repetir el año, no puedo\nevitar serlo. Lo siento mucho, pero no puedo ceder en eso.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... geografía...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000887",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, ¿qué tiene de malo? Rin-chan te enseñará con bastante amabilidad.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fgact",ch="稟",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000486",ch="rnd"},
},
ja={
{
name={"Rin"},
"“También te guiaré a ti también, Kei-kun.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0019",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000888",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿A mí? Con geografía estoy bien, realmente...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=3},
{"fgact",ch="稟",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000487",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En tu caso serán todas las materias, Kei-kun.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0012",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000889",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ehh! ¡¿Todas las materias?!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_02_4"},
{"text"},
linkback="block_00176",
},
label = {
top={block="block_00000",label=1},
},
}
