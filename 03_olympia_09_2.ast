astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm029"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg042a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
"Después de que Rin terminó su hospitalización, fui al colegio junto a ella.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_jka_000014",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Oye, oye, ese es Kusanagi-kun, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000016",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Ah, sí, es él. ¿Quién es la mujer que tiene al lado?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_jka_000015",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Parece que es su novia.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000017",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿En serio? Me voy a morir del shock.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003319",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No les prestes atención.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Aprieto la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_jka_000016",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Pero se ven muy bien los dos, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_jka_000017",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Son casi tal cual el uno para el otro.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000018",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“No, no, eso no tiene nada que ver. Ahh, ¿es que acaso esa leyenda era mentira?\nLo de que Kusanagi-kun no salía con nadie.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000008",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000019",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿No conoces la leyenda? Desde que era un niño, todo tipo de muchachas han\nvenido a confesársele, y todas han sido rechazadas.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000020",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Y por eso Kusanagi-kun ha estado soltero todo, todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000021",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Así que se estableció la leyenda de que Kusanagi-kun no sale con ninguna chica.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_jka_000018",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¿Y cuál es el problema entonces? Mira nada más lo preciosa que es la novia que\nse consiguió.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000022",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Es por eso mismo que no puedo aceptarlo. Esa muchacha... es demasiado\npreciosa...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_jka_000019",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Parece que se llama Rin Misakura y es de tercer año. Realmente se ven muy bien los\ndos juntos, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003320",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No le des atención a lo que los demás digan o piensen.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003321",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"msgoff"},
{"fg",mode=-2},
{"se",file="se9004",id=1},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Vamos subiendo la colina Yumenouki juntos.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Y entonces, vemos a alguien vestido con el uniforme de otro colegio, no muy\nfamiliar, frente al portón de la entrada.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esa es...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg045e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000168",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Ehh? Rin-chan, así que aún sigues en este colegio.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Kana Nagayama apreció frente a nosotros como si nada, aún después de lo que\nsucedió.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",mode=-2},
{"bg",x=-960,y=-530,speed=200,sync=0,file="zbg045e",path=":bg/",x2=-760,y2=-530,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="稟",size="z2",speed=200,sync=0,mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0005",head="rin_z2a",x2=200,x=0,lv=5,id=9},
{"se",file="se3130",id=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"En ese mismo instante traté de levantar mi puño, pero Rin me contuvo, agarrando\nfuertemente mi brazo.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Con bastante fuerza.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Rin me observa a la cara, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",mode=-2,sync=0},
{"bg",file="bg045e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000169",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sabes, Rin-chan? De verdad pensé que ya no tenías ni cara para seguir viendo a\nKusanagi-kun, así que juraba que tampoco vendrías más al colegio Yumihari.\nPero viniste.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Kana Nagayama comienza a hablar, sin darle mucha atención a la expresión en\nnuestras caras.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama... desgraciada...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Rin mueve su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"¿Es que acaso pretende dejar que esta mujer siga diciendo lo que le viene en\ngana?",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No me creo capaz de aguantar eso.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Nagayama se da cuenta de como Rin está agarrando mi brazo ahora, y comienza\nhablar con un falso tono de sorpresa, claramente haciéndolo a propósito.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000170",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Vaya, y ahora andan agarraditos de las manos! ¿Dame el secreto, sí? ¿Cómo\nhaces para domar de esa forma a Kusanagi-kun? En mi caso, casi termino\ngolpeada por él.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000171",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, claro. Fue cuando saliste de la habitación del hospital, después de esa\nimpactante actuación. Fue después que le lloraste encima y te perdonó todo,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000172",ch="knd"},
},
ja={
{
name={"Kana"},
"“Seguramente te hiciste la víctima. 'Yo no sabía nada, yo no tengo la culpa.\n¡Ella habló mal de mí!'.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="香奈",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003322",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es. Después de eso, Nao-kun me persiguió.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0017",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000173",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Jaa? Pero si fuiste tú quien armó todo ese show para obligarlo a hacer eso,\n¿no? ¡Haciéndote la víctima, la pobre niña! ¡Era demasiado obvia esa\nactuación!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003323",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0017",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000174",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Ja? ¿Ahora lo reconoces? ¡Vaya, entonces ahora lo reconoces! Jaa,\ndefinitivamente eres especial. No tienes ni una pizca de culpabilidad, vaya\nsinvergüenza. Encima de no pagar por tu crimen, ahora pretendes hacerte la\nvíctima.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000175",ch="knd"},
},
ja={
{
name={"Kana"},
"“Realmente tus cualidades como persona son especiales. No tienes ni un poquito\nde culpabilidad, eh.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0015",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000176",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahhh, si se tratara de una chica normal como yo, no podría aguantar las ganas\nde morir de tanta culpabilidad.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003324",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Entonces en tu caso no podrías vivir con esa carga, Kana-chan...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000177",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Es que no es lo más obvio? ¿No estás consciente de que le robaste el brazo a ese\nhombre? Le quitaste su futuro. Le robaste todo, ese brillante futuro que todo\ngenio tiene prometido.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003325",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0017",head="kan_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000178",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿'Así es'? ¿Estás hablando en serio? Una persona normal no andaría por allí con\nesa cara tan impasible, ¿no? Ya la muerte ni siquiera basta como para saldar\nesa deuda.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003326",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo. No sé realmente que harías tú en mi caso, Kana-chan, pero yo no\nmoriré.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000179",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003327",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo me robé el talento de Nao-kun. No, robé muchas otras cosas también. Me\nparece que tienes mucha razón en lo que dices, Kana-chan.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003328",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pero sabes algo, Kana-chan? Si estoy viviendo ahora, es porque Nao-kun\nabandonó todo eso para salvar mi vida.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003329",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nada podría perdonarme que tire a la basura tan fácilmente la vida que Nao-kun\nme dio.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003330",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No puedo andar diciendo 'no puedo vivir' tan ligeramente. Sí, no tengo\npermitido huir de todo de esa manera tan simple y fácil.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003331",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y además...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bgm",stop=1,time=1000},
{"fg",mode=-2},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0002",head="rin_z2a",lv=5,id=6},
{"fgact",ch="稟",act="うなづく",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se aferra a mi brazo.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",file="bgm018"},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0003",head="rin_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0004",head="rin_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003332",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mi vida, mi cuerpo y mi corazón, son todos de él! De ahora en adelante usaré\nmi vida solo por el bien de Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000180",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0002",head="rin_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003333",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta es la vida que Nao-kun recogió del suelo y salvó para mí. Digas lo que\ndigas, yo cuidaré de esa vida, Kana-chan.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000181",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Estás mal de la cabeza? ¿Vas a interpretarlo todo ahora a tu conveniencia?\n¡Eres una criminal, compórtate por lo menos un poco como tal! Y en primer\nlugar, ¿qué piensas tú al respecto, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada en particular. Rin está en lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_knd_000182",ch="knd"},
},
ja={
{
name={"Kana"},
"“No, estás totalmente equivocado. Kusanagi-kun, tienes el cerebro lavado por\ncompleto. Digo, ¿es que así de estúpido eras, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0004",head="rin_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003334",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh, estooo.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Rin pone una enorme sonrisa de lado a lado.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003335",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cierto, casi se me olvidaba decirte esto. Kana-chan, crees que Nao-kun es el\núnico violento de los dos, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_knd_000183",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué demonios estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=50,func="wait"},
{"bg",file="battle_008",rule=040,time=100,id=1,lv=5,path=":cg/battle/",set="battle"},
{"se",id=1,file="se1615_z"},
{"ex",time=100,func="wait"},
{"text"},
text={
ja={
{
"Se escuchó el sonido del viento.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000184",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Hii!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Yo tampoco pude observar en detalle qué sucedió en ese instante.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Rin se acercó al pecho de Kana y extendió su puño hacia su nuez de Adán.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Toda esa serie de movimientos se asemejaba más a un arte marcial de combate que\nal judo.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Ahora a una distancia en la que sus dos narices podían casi tocarse, Rin dice,\ncon una sonrisa, lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003336",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Odio a esas personas que ponen de mal humor a Nao-kun... Las aborrezco. Y si\ntratas de decir algo de más, destrozaré esta parte tuya.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003337",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y si llego a hacerlo, te dolerá bastante. No podrás respirar, te ahogarás y\npodrías incluso hasta morir... Kana-chan...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"se",file="se1038",id=1},
{"text"},
text={
ja={
{
"Rin aprieta su puño lenta, pero firmemente contra la garganta de Kana.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg045e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0013",head="kan_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003338",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje, ¿debería aplastarla?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0020",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000185",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hii.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="香奈",my=40,mode=-1,lv=4,id=5},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"Nagayama se cae de piernas en ese mismo lugar.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"La voz de Rin, junto a esa sonrisa tan espeluznante... tuvo bastante impacto.\nAun si no se trata de Nagayama, cualquier otro hubiera terminado tumbado\nsobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003339",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Rin ve desde arriba a Nagayama y prosigue con sus palabras.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003340",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás estés malinterpretando ahora las cosas Kana-chan. Realmente estoy\nagradecida contigo.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003341",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tú me enseñaste la verdad, Kana-chan. Me hiciste recordar todo aquello de lo\nque estuve huyendo hasta ahora. Y por eso estoy agradecida contigo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003342",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Porque es esa misma verdad la que me otorgó esta fuerte voluntad...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_knd_000186",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Nagayama aparta su mirada de Rin.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"La pelea había llegado a su completo fin.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"se",file="se0744s",id=1},
{"text"},
text={
ja={
{
"Nagayama se retira rápidamente del lugar, sin decir nada, como si tratara de\nhuir.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=0,lv=4,id=6},
{"ex",time=0,func="wait"},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003343",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ahhh, me siento como nueva! Siempre he querido usar el judo para esta clase de\ncosas alguna vez, ajaja.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003344",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Me siento totalmente refrescada ahora!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"No, espera, eso no fue judo...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003345",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Nao-kun, ¿será que quedaste algo atemorizado de mí ahora?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Volteo mi cabeza a los lados con una forzada sonrisa.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nah, sé bien cómo eres. Preferiste darle una dosis de terror a Nagayama para\nque no volviera a decir esa clase de cosas, y además para evitar que yo\nactuara de forma violenta, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=0,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003346",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No! Lo hice porque quería hacerlo. Yo soy tan violenta y siniestra como lo\npuedes llegar a ser tú, Nao-kun. Desde pequeños hemos estado juntos, deberías\nsaberlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Rin se ríe.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Rin ha cambiado un poco comparado a cuando éramos niños, pero según recuerdo,\nnunca llegó a ser tan violenta...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-960,y=-586,speed=300000,file="zbg045e",path=":bg/",x2=960,y2=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"*zawa*, *zawa*.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"La gente alrededor comienza a hablar y cuchichear.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"No solo Nagayama, sino las personas alrededor deben estar algo agitadas\ntambién. Todos abren y cierran sus bocas sin poder decir mucho, con sus ojos\ntotalmente abiertos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Pensé, 'ah, deben haber quedado aterrados'...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_jka_000020",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Genial! ¡¿Desde cuándo Misakura-san puede moverse de esa manera?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000009",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“¡Se vio demasiado genial! ¡¿Vieron la forma en que intimidó a la otra\nmuchacha?! No cualquier muchacha podría decir eso, aun si se tratara del\nhombre al cual ama.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_nst_000025",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Misakura-san se vio genial! ¡Digo, se veía demasiado imponente!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Los aplausos y ovaciones retumban alrededor.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"¿Será este el típico ambiente escolar de Yumihari?",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Es el mismo colegio al cual asisten aquellos que se emocionaron al ver los\ngolpes de Ai.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Parece que toda esa discusión les dejó un gran impacto emocional, en el buen\nsentido.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"¿Pero qué tan descabellados son los estándares del colegio Yumihari? Por\nDios...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg045e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003347",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, esto... ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Rin responde a las ovaciones de todos con una sonrisa forzada.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Probablemente ni la propia Rin se esperaba esa reacción por parte de todos.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Puedo entender un poco las ganas que tuvieron de aplaudirla y aclamarla después\nde verla actuar de manera tan firme y recta.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Fue genial la manera en la que actuó, y yo también sentí que toda la carga que\ntenía contenida dentro se había aligerado.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Es realmente refrescante ver a alguien capaz de admitir y poner un pie de\nfrente ante lo que dice y piensa.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Las palabras 'rectitud' y 'nobleza' encajan perfectamente con la manera en la\nque actuó Rin.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Mientras que por otro lado, Nagayama pasó en solo corto instante a ocupar el\npuesto de 'mujer rechazada que vino a quejarse y molestar'.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Y ahora, Nagayama no es más ni menos que eso.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Jamás podré olvidarme de la cara que puso en ese momento.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Probablemente creía que Rin era solo una estudiante de honores de buenos\nmodales.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Sin embargo, Rin no es así. Rin es más terca, más fiel, y más fuerte que\ncualquiera.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"No es la clase de persona que pueda ser pisoteada y aplastada por alguien del\nnivel de Nagayama.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"msgoff"},
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bastante ha pasado desde entonces, eh...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Cosas buenas, cosas difíciles, cosas alegres, cosas tristes.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Desde que me reencontré con Rin, realmente han sucedido muchas cosas.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Y mientras estaba pensando eso, la puerta de la sala de arte se abre.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"se",file="se1279",id=1},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003348",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Parece que nos darán una bolsa para meter ese cuadro! Así que acompáñame, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tengo que ir yo también?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003349",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que no sé cuál bolsa es mejor en este caso...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, rayos, está bien. Vamos.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"se",file="se9012",id=1},
{"bgm",stop=1,time=2000},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Voy junto a Rin a buscar la bolsa.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Rin y Naoya habían salido de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"se",file="se1279",id=1},
{"text"},
text={
ja={
{
"Y apenas salen, otras dos sombras entran a la sala.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=300000,file="zbg049a",path=":bg/",x2=0,y2=586,x=-960,y=586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm043"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000556",ch="szd"},
},
ja={
{
name={"???"},
"“¿Es este el cuadro de Rin?...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_sud_000458",ch="sud"},
},
ja={
{
name={"???"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_szd_000557",ch="szd"},
},
ja={
{
name={"???"},
"“¿Qué tal te parece?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_sud_000459",ch="sud"},
},
ja={
{
name={"???"},
"“Es horrenda.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_szd_000558",ch="szd"},
},
ja={
{
name={"???"},
"“Me lo imagino. Para alguien como tú, debe ser normal pensar eso.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_sud_000460",ch="sud"},
},
ja={
{
name={"???"},
"“Sí. Pero creo que así está mejor.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_sud_000461",ch="sud"},
},
ja={
{
name={"???"},
"“Es una pintura horrenda, pero que tiene mucho, mucho valor.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_szd_000559",ch="szd"},
},
ja={
{
name={"???"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_sud_000462",ch="sud"},
},
ja={
{
name={"???"},
"“Sus recuerdos regresaron, pero aquello más grande que sus memorias no regresó.\nY por eso aún sigo existiendo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_szd_000559b",ch="szd"},
},
ja={
{
name={"???"},
"“Las cosas resultaron así porque Rin te preocupaba, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_sud_000464",ch="sud"},
},
ja={
{
name={"???"},
"“No lo sé muy bien...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_sud_000465",ch="sud"},
},
ja={
{
name={"???"},
"“Pero creo que no importa tanto que lo sepa o no...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_sud_000466",ch="sud"},
},
ja={
{
name={"???"},
"“El cuadro de los dos es horrendo, carece de toda habilidad, pero aun así, está\ncargado de felicidad.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_szd_000560",ch="szd"},
},
ja={
{
name={"???"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_szd_000561",ch="szd"},
},
ja={
{
name={"???"},
"“¿No te gustaría que nos fuéramos de nuevo a Nueva York a vivir las dos?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_sud_000467",ch="sud"},
},
ja={
{
name={"???"},
"“Ese lugar no me gusta, es muy frío. Si es por eso, déjame vivir contigo en la\ncasa de los Natsume, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_sud_000468",ch="sud"},
},
ja={
{
name={"???"},
"“Pues ya dentro de poco serás la única que podrá verme, muy seguramente.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_szd_000562",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Adquiriste forma gracias a los pétalos de los cerezos milenarios. Y gracias a\nlas obras de Kenichiro Kusanagi, las cuales buscaban imitar los cerezos\nmilenarios, ahora puedes ser reconocida por una buena cantidad de personas.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_sud_000469",ch="sud"},
},
ja={
{
name={"???"},
"“Sin embargo, las obras de Kenichiro están comenzando a pasar de moda, a\nvolverse ordinarias.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_szd_000563",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Se supone que en un principio, no fueron creadas como objetos de fe...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_sud_000470",ch="sud"},
},
ja={
{
name={"???"},
"“Sin embargo, hubo alguien que pintó esas obras con ese mismo sentimiento que se\ntiene al rezar. Y también hubieron personas que contemplaron y admiraron esas\nobras con ese mismo sentimiento. Y por eso, es que pude existir.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_szd_000564",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_sud_000471",ch="sud"},
},
ja={
{
name={"???"},
"“De igual forma, lo único que me importa es que Rin y Naoya sean felices. Eso\ntenías en mente al crearme, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_szd_000565",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... No voy a negar que al momento de crearte, tenía eso en mente...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_sud_000472",ch="sud"},
},
ja={
{
name={"???"},
"“Pero... ahora no.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_szd_000566",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te equivocas. Yo quiero que Naoya y Rin sean felices.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_sud_000473",ch="sud"},
},
ja={
{
name={"???"},
"“No estás siendo honesta.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_szd_000567",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez. Pero de igual forma, creo que así está bien.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_szd_000568",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Esos dos pueden amarse y quererse y ser felices todo lo que quieran!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_sud_000474",ch="sud"},
},
ja={
{
name={"???"},
"“Ya veo. Bien, ¿regresamos entonces?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_szd_000569",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... Sui...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_szd_000570",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Gloria, para la felicidad de los dos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_sud_000475",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
