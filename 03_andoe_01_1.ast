astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c07_01",path=":ev/ev_eye_c07/",set="ev_eye_c07"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"eval",exp="g.start_ani=1"},
{"text"},
text={
ja={
{
"Al terminar las vacaciones de verano, me había convertido en un héroe.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"msgoff"},
{"bg",file="cg_zbg041a",id=9,lv=9,speed=300000,path=":cg/",x2=800,y2=0,x=-400,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000051",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Kya~, es él, él! ¡Naoya Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000045",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Es en serio? Es guapísimo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000023",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“Lo vi, salió en la TV. Esa manera de tratar con los medios, parecía toda una\ncelebridad, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_jka_000052",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Tiene unos aires de genio solitario.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000046",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Increíble... Hizo esa iglesia en una sola noche, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"(¿Construir una iglesia en una sola noche?)",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"(¿Es que acaso me crees Toyotomi Hideyoshi?)",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_jka_000053",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Wa, wawah, miró hacia acá.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000047",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Waah, pero qué guapo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bluesky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Con el cielo de otoño a lo alto, el alboroto me sigue en el colegio, y en la\nciudad me ruegan por autógrafos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"La culminación de la obra póstuma 'Las huellas de los cerezos' atrajo con\nfuerza la atención de los medios.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"El hecho de que todo haya sucedido justamente medio año después de la muerte de\nKenichiro Kusanagi le dio más leña al fuego, y obviamente más aún también el\nhecho de que haya sido su hijo quien completara la obra.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Todo salió como esa directora lo planeó.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Parece que oleadas de personas y medios se han acercado a ver, no solo el\ncolegio Yumihari, sino también y por alguna razón, el cuadro que adorna el\nayuntamiento de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Mi única salvación es que, desde que inició el nuevo período y con la excusa de\nque se interrumpe el normal transcurso de las clases, las visitas de medios y\npersonas normales al colegio fueron limitadas a solo los domingos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Mientras esté dentro del colegio, no seré perseguido por los medios. Esa es mi\núnica salvación.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"¿Será eso una muestra de consideración por parte de esa directora?",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No, no me parece la clase de persona capaz de demostrar semejante amabilidad,\naunque...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se3130",vol=70,id=1},
{"quake"},
{"fg",ch="真琴",size="z2",my=40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0100",face="d0003",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001648",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué tal?! ¡Celebridad!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001649",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vaya? Estás de muy mal humor.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que lo estoy.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001650",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? ¿No habías dicho hace un tiempo que querías que te adularan? ¿No estás\nfeliz de que ahora te adulen como nunca antes?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Es que lo estoy disfrutando, estoy saboreando la fama. ¡Ja ja ja!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001651",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente no eres honesto, eh.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Honesto con qué?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001652",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Toritani voltea hacia un lado, apartando su vista.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Eres tú la que parece estar de mal humor.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001653",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa? ¿Por qué debería estarlo?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Simplemente así me pareció.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001654",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmph, pues sí, si de un día para otro apareciera ese batallón de mujeres, no\nsolo yo, sino también las otras...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No solo tú, qué?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001655",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé, no importa. ¿Y bien? ¿Es que andas metido en otro problema ahora?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Metido en otro problema? ¿Por qué debería?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001656",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que no es eso? ¿Le pusiste las manos encima a alguna de tus seguidoras\nentonces?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Sobre mis seguidoras? ¿De qué rayos estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001657",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Detrás. Detrás de ti.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",mode=-2},
{"fg",ch="直哉",size="z2",mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0016",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Detrás?...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"fg",ch="吹",size="z2",time=200,sync=1,my=40,mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",x=-680,lv=5,id=1},
{"se",file="se9032",id=1},
{"fg",ch="吹",time=200,sync=1,my=40,mode=-1,lv=5,id=1},
{"fg",ch="吹",size="z2",time=200,sync=1,my=40,mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",x=680,lv=5,id=2},
{"se",file="se9032",id=2},
{"fg",ch="吹",time=200,sync=1,my=40,mode=-1,lv=5,id=2},
{"fg",mode=-2,sync=0},
{"bg",speed=300,file="zbg041a",path=":bg/",x2=390,y2=30,x=590,y=30,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",speed=300,mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",x2=-200,x=0,lv=5,id=2,sync=0},
{"extrans",time=0,sync=0},
{"se",file="se3130",vol=70,id=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wah!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0002",head="sui_z2a",x=0,lv=5,id=2},
{"text"},
text={
vo={
{"vo",file="fem_sud_000204",ch="sud"},
},
ja={
{
name={"Sui"},
"“No hay nada de qué asustarse. ¡Sui no tiene intención alguna de atacar!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Obviamente que no, nadie en su sano juicio atacaría sin mediar palabra a otra\npersona. ¡¿Y qué haces apareciendo de repente detrás de uno?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001658",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Quién es? Pareciera ser de primer año.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se llama Sui. Ehm, su apellido es...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000205",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Y tú quien eres? Tratas con mucha confianza a Kusanagi Notsurugi-san, puedo\nver.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001659",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quién es Kusanagi Notsurugi-san?...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000206",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Él!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no, demonios! ¡¿No te dije ya que mi nombre es Naoya Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000207",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vaya, ¿de verdad?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero por qué pones esa cara de extrañeza?... ¿No te lo he dicho ya antes?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001660",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ya se conocían?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque solo de hace poco.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000208",ch="sud"},
},
ja={
{
name={"Sui"},
"“Así es. Y por cierto, ¿desde cuándo conoces tú a Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001661",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Desde que estábamos en primer año, así que... serían ya 2 años y un período\nescolar.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000209",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ya veo, entonces eres mi senpai! ¡Es un gusto conocerte!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Tenga más tiempo de conocerme o no, de igual forma Toritani es tu senpai...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿De qué hueco te apareciste, Sui?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="du",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000210",ch="sud"},
},
ja={
{
name={"Sui"},
"“Esa manera de comentar mi aparición es muy ruda y descortés de tu parte. ¡Sui\nha estado siguiéndote todo este tiempo a escondidas, Kusanagi-san!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No digas semejante cosa con esa cara tan fresca!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000211",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Cómo debería decirlo entonces?!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, el problema no está en cómo lo digas. Espera un momento, ¿por qué me\nhas estado siguiendo?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000212",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Quieres una razón?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da escalofríos que me persigan sin razón alguna.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000213",ch="sud"},
},
ja={
{
name={"Sui"},
"“Aunque, es un hecho que no tuve ninguna gran razón para hacerlo. Simplemente me\ntopé con una cara conocida y decidí perseguirla.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo por eso? Entonces no me seguías, solo querías saludar.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001662",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y? Sui-chan, ¿qué relación tienes con Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000214",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues, ¿cómo podría ponerlo? Digamos que compartimos el mismo destino...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, no vengas a decir cosas sin sentido ahora.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que vive cerca de mi casa, y en eso de encontrarnos casualmente varias\nveces nos conocimos.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno, así como lo escuchaste de ella, no es una seguidora ni nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000215",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Más que siguiéndolo, se podría decir que estoy poseyéndolo!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que acaso eres una especie de fantasma o demonio?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001663",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm. Sui-chan, ¿a qué club perteneces?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000216",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué a dónde pertenezco? ¿A dónde perteneceré? ¿Qué piensas, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me lo preguntes a mí.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0017",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000217",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es un misterio.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo es?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001664",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre rodeado de gente extraña, ¿no? Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluyéndote a ti...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001665",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No será entonces que atraes gente rara por ser tú raro?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso estás reconociendo que tú también eres rara?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001666",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues estoy un tanto consciente al respecto. Pero también hay muchachas lindas\ny normales entre tus conocidas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Muchachas lindas y normales?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001053",ch="rnd"},
},
ja={
{
name={"???"},
"“Buenos días, muchachos.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="吹",mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001667",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Como esta.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001054",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001668",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues nada realmente, simplemente hablábamos de lo normal y linda que eres,\nRin-chan.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",time=300,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x2=-345,x=0,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"se",file="se9010",id=1},
},
},
text={
vo={
{"vo",file="fem_rnd_001055",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Me alegra escuchar eso desde tan tempranas horas. Pero, Mako-chan,\n¡tú, también, tienes esto!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z2",my=40,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",x=-345,lv=5,id=5},
{"fg",ch="真琴",size="z2",my=40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014h",head="mak_z2a",x=345,lv=5,id=6},
{"se",file="se9032",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001669",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Unyoh!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fgact",ch="稟",act="うんうん",time=280,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",x=-345,lv=5,id=5},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001056",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, mira nada más, estos enormes pechos colgando y esta cinturita tan\ndelgada. ¡Esta muñeca erótica andante!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fgact",ch="真琴",act="びっくり",lv=5,id=6},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0014h",head="mak_z2b",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0022h",head="mak_z2b",x=345,lv=5,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001670",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esp--, wah, wawah, n-no me sobes el pecho.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=-345,lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001057",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quieres que lo haga abajo entonces?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0021h",head="mak_z2a",x=345,lv=5,id=6},
{"fgact",ch="真琴",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001671",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eh! ¡No metas tu mano dentro de mi falda!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",x=345,lv=4,id=6},
{"se",file="se3356",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Toritani esquiva con toda sus fuerzas y se aparta de Rin.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001058",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vaya, es una pena, solo faltaba un poquito más para llegar.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",x=345,lv=4,id=6},
},
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001672",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿'Vaya, es una pena'?! ¡¿Qué clase de mujer maniática intentaría meter sus\nmanos en las pantaletas de alguien a mitad de camino al colegio?!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"¿De verdad estaba tratando de hacerlo?...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001059",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Aquí, yo!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001673",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No infles el pecho con tanto orgullo!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001060",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Traté de dar a resaltar el hecho de que yo también tengo algo de\nbusto, pero... ¿quizás no funcionó?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001674",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Retiro lo dicho... Esta también es muy rara...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",time=210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001061",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es, así es, yo también soy rarita. Somos todos compañeros.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"No sé si es que Rin es fuerte o se adapta fácilmente, pero a medida que avanzan\nlos períodos escolares, los papeles de estas dos van intercambiándose poco a\npoco...",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001675",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios, esta muchacha... De todas las cosas que pudo hacer, vino a hacer\nesto...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001062",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que, ¿no es penoso que te digan de repente 'linda' a plena mañana? Nada más\ncon escuchar eso me dieron ganas de jugar a humillarte a más no poder,\nMako-chan.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001676",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No vengas a decir 'me dieron ganas' junto a esa frase tan impactante, y menos\ntan sonriente!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001063",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=0,lv=4,id=9},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000218",ch="sud"},
},
ja={
{
name={"Sui"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001064",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? Esta muchacha también es muy linda. ¿Mako-chan, Kusanagi-kun, es amiga de\nalguno de los dos?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=570,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",time=210,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001677",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, la acabo de conocer.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000219",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Yo soy Sui!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001065",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí. Yo soy Rin Misakura. Es un gusto.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000220",ch="sud"},
},
ja={
{
name={"Sui"},
"“Rin Misakura...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001066",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=0,lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0004",head="sui_z1a",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000221",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No, no sucede nada! ¡Rin Misakura, eres muy linda! ¡Me gustas! A partir de\nahora puedes adorarme como tu propia madre.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001067",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eh, sí... Gracias.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"¿Quién va a tratarte de madre con ese aspecto de niña?...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001678",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, te dijeron linda. Acaríciale los pechos.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-570,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001068",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Espera, eso lo hice porque se trataba de ti, Mako-chan. No puedo hacer lo\nmismo a alguien a quien apenas vengo conociendo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=570,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000222",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué es lo que sucede? ¿Rin, no quieres acariciar mis pechos?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=0,lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"se",file="se9031",id=1},
{"text"},
text={
ja={
{
"Sui infla su pecho y lo saca hacia afuera.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001069",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... Probablemente... estás malinterpretando las cosas. En realidad, no\ntengo esa clase de inclinaciones, y...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000223",ch="sud"},
},
ja={
{
name={"Sui"},
"“No sé muy bien qué pasa, ¿pero acaso no estuviste acariciando sus pechos con\nbastante vigor hace un rato? ¡Vamos, agarra los míos!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡De ese corpiño de niña pequeña no hay nada que agarrar!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0022",head="sui_z1a",x=0,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000224",ch="sud"},
},
ja={
{
name={"Sui"},
"“Unyoroh, ¡d-deja de desordenar mi cabello mientras agarras mi cabeza, por\nfavor!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hablas demasiado.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000225",ch="sud"},
},
ja={
{
name={"Sui"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"se",file="se9032",id=1},
{"fg",ch="吹",my=40,mode=-1,lv=4,id=9},
{"ex",time=50,func="wait"},
{"fg",ch="稟",time=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x2=-570,x=-345,lv=4,id=5},
{"fg",ch="真琴",time=500,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x2=570,x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Sui se escabulle de entre mis manos y se escapa.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_sud_000226",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Sui le dijo a Rin que podía acariciar sus pechos! ¡En ningún momento te dije a\nti que podías pasar tu mano por mi cabeza y revolverme el cabello!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué chillona... En fin, dejen ya el juego de manosearse entre sí. Gracias al\nshow que armaron ahora siento las miradas de los demás sobre nosotros...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001070",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Miradas? Ah...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001679",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Ya de por sí llaman la atención. Y obviamente será peor de manosearse los\npechos y el interior de las faldas.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Los alumnos que venían llegando al colegio estaban ahora parados,\nobservándonos.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001071",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ajaja...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001680",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin... Mira nada más, por tu culpa tenemos los ojos de todos encima...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001072",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"se",id=1,file="se1895"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001073",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah! ¡L-La campana!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0013",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001681",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No podemos llegar tarde por andar hablando aquí parados!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. En fin, tú también... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"En el lugar en el que se supone que estaba Sui hace un momento, ya no estaba.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y Sui?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_sud_000227",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Qué están haciendo?! ¡Llegarán tarde! ¿Es que acaso no les preocupa llegar a\ntiempo?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Al darme cuenta, ya ella estaba por la zona de las getabako.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“*whew*... tan rápida como siempre, eh...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001074",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble, realmente es muy rápida. Yo tampoco me di cuenta...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0006",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001682",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eso no importa ahora, nosotros también debemos apresurarnos!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sui.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Así que sí era una estudiante de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"¿De qué año será?...",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Hay algo de ella que me ha estado llamando la atención todo este tiempo.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"excall",file="03_andoe_01_2"},
{"text"},
linkback="block_00152",
},
label = {
top={block="block_00000",label=1},
},
}
