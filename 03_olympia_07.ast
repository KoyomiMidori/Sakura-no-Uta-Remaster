astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c04_01",path=":ev/ev_eye_c04/",set="ev_eye_c04"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg007a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"bgm",file="bgm018"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000534",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000535",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que realmente estás dispuesto a encontrar aquello que fue olvidado.\nNaoya...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Antes de ir al colegio, me acerqué a la habitación de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Por supuesto, para confirmar esas palabras, y――",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así lo decidí.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000536",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Después de bajar la cabeza por un momento, Shizuku comenzó a hablar.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000537",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ciertamente fue Rin quien me enseñó el significado de 'Olympia'.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin te lo enseñó? ¿No fuiste tú quien se lo dijo?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000538",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No fui yo. Fue Rin quien me contó la historia de la ópera de 'Los cuentos de\nHoffmann'.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000539",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Olympia es una muñeca mecánica idéntica a un humano. Y en ese momento me contó\ntambién que por eso, es que esa tienda se llamaba Olympia.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con 'esa tienda' te refieres al lugar donde se compró la ropa de Sui?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000540",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, la tienda donde se compró la ropa de esa pequeña.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿Rin te habló incluso acerca de esa tienda?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000541",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, nosotras éramos muy grandes amigas... Así que Rin me explicaba todo tipo de\ncosas...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conoces entonces dónde queda esa tienda, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Shizuku mueve su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000542",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aun si fuera así, no hay necesidad de que te lo diga.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Nosotros estamos buscando esa tienda.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000543",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si es por eso, ya Rin debe haberlo recordado todo...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dices que Rin?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000544",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Una vez se recuerda algo, todas las demás memorias se recordarán también, como\nsi estuvieran conectadas por una cadena.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000545",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así funcionan los recuerdos. No existe ninguna memoria absolutamente\nindependiente de las demás. Las memorias existen gracias a las otras\nmemorias, las cuales actúan como bisagras.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000546",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por eso, si tan solo un recuerdo regresa de nuevo a la mente de Rin, todos los\ndemás recuerdos deberían regresar a ella de una forma tan fluida, que incluso\nse preguntará por qué no llegó a recordarlo sino hasta ahora...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te refieres al instante en que recordó el nombre de su madre?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Shizuku asiente ligeramente.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000547",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque, Naoya... Te lo preguntaré una vez más. ¿Realmente fue esta una buena\nopción?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué preguntas eso?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000548",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estuviste callando esa verdad para proteger a Rin todo este tiempo. Lo\nmantuviste en secreto de todos los demás también...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000549",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La verdad que has venido escondiendo hasta ahora. La verdadera razón por la\ncual dejaste de pintar...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000550",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estás tratando de hacer que Rin recuerde una vez más la realidad que con tanto\nesfuerzo estuviste escondiendo hasta ahora...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Shizuku suelta un pequeño suspiro.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000551",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, si Rin llega a obtener la verdad, entonces probablemente serás el único\nque pueda protegerla en ese momento, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000552",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por eso, es que siempre haces lo correcto, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Shizuku sonríe.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alegra que me digas eso.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0010",head="shz_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000553",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo único que puedo decir de mi parte es eso. Probablemente, si llegas a\nencontrar a Rin y también a Sui hoy, podrás conocer el camino hacia esa\ntienda. A Olympia, la casa de las muñecas.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La casa de las muñecas...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000554",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin es tan importante para mí como lo eres tú también.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000555",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que, protege a Rin. Por favor.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. A toda costa.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Esta vez sí protegeré a Rin, como realmente debe ser.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"No solo su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Protegeré también su corazón.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"No fallaré.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bgm",stop=1,time=1500},
{"se",stop=1,id=-1,time=1500},
{"vostop",stop=1,time=1500},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1500,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000119",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fumufumu... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Mi susurro desaparece, como si fuera absorbido por un enorme silencio.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg052a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"La enormidad de la biblioteca del colegio Yumihari es famosa en la región.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Posee una masiva cantidad de volúmenes que supera incluso a las de una pequeña\nuniversidad. ¿Serán producto de su larga y antigua historia?...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000120",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahh, como me hubiera encantado entrar en este colegio tan famoso.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"El colegio Yumihari es un colegio prestigioso, famoso en esta región.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"El porcentaje de ingreso a la universidad de sus estudiantes es asombroso, pero\nincluso más increíble que eso es la cantidad de personalidades famosas que\nhan egresado de aquí.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Música, artes, literatura... Si pensamos en términos de aporte cultural, no hay\nningún otro colegio así en todo Japón.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Si tan solo mi familia hubiera gozado de una mejor situación económica, pudiera\nhaber recibido una mejor educación y probablemente incluso ingresar a este\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Este colegio Yumihari ha egresado a una gran cantidad de artistas.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Y por eso, es que desde pequeña he estado fascinada con este colegio.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zev_uni_c07_01",speed=300000,path=":ev/ev_uni_c07/",set="ev_uni_c07",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Desde hace bastante tiempo me ha gustado pintar.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"O diría más bien que la única gran habilidad que he tenido desde pequeña ha\nsido pintar. Nada más.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Siempre me la pasaba dibujando sola.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Tanto en casa como en el colegio. Aún después de clases, mientras todos estaban\njugando, yo me la pasaba dibujando sola.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Mi único amigo en los recesos del mediodía era mi cuaderno.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"El pequeño mundo dibujado en las esquinas del cuaderno.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Era mi único amigo, y mi todo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"En mi pequeño mundo, yo era omnipotente.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Todo aquello que surgiera en mi cabeza, podía llevarlo a la realidad tanto como\nquisiera por medio de mis dibujos.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Y por eso pensaba que algún día, este pequeño mundo que dibujaba crecería y\ncrecería, para llegar realmente en algún momento a envolver y tragar todo\neste mundo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Soy pequeña ahora, tanto como un insecto, pero algún día esta fantasía cubrirá\ntodo este mundo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Yo tengo talento.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Mis dibujos tienen historia y aventura.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Dentro de mí hay un mundo completo y perfecto.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Y yo puedo llevar ese mundo a su forma más perfecta.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Así era, hasta ese momento...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Hasta encontrarme con él.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"El hijo del genio pintor. Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Hasta ese entonces, tenía la seguridad de que todas aquellas cosas\npertenecientes a la realidad eran inferiores a mi fantasía.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Juraba que este mundo real no le llegaba ni a los pies a todo el compendio de\nmaravillosas cosas que hacían vida en mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Juraba que mi fantasía era superior a cualquier fantasía que pudiera existir en\neste mundo.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Pero todo resultó ser distinto.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Fue al conocer al genio por primera vez, que fui restregada en la cara lo pobre\ny aburrido que era mi mundo.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Sus pinceladas eran capaces de transformar incluso este monótono mundo real en\nun hermoso surtido de colores.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Realmente tenía el poder de cambiar al mundo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Mis pinturas solo brillaban, después de todo, dentro de mi propio mundo.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"No había comparación alguna.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"A pesar de eso, seguí pintando y dibujando.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Seguí creyendo en mi fantasía.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Quizás por suerte, es que con lo oscura, taciturna, escasa de amigos y mala\npara los estudios que era, tenía todo el tiempo del mundo para hacer eso.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Para alcanzar a Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Para alcanzar su lugar.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Hasta que llegó ese día...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Aún recuerdo la época en la cual Naoya Kusanagi dejó de pintar.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Fue en esa época en la cual pintó un cuadro de cerezos, y obtuvo un premio en\nuna famosa exhibición.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Estuvo rechazando las peticiones de entrevista de la prensa, luciendo\nclaramente fastidiado.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Unos meses después, dejó de tomar el pincel.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Por supuesto, nunca llegué a estar de acuerdo con eso.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Nunca, en todo, todo este tiempo, he podido estarlo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Pero, a la misma vez, también llegué a sentirme aliviada.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Aliviada de ver que incluso un genio de esa magnitud, no era más que una\npersona al quitarle el pincel.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Si el genio deja de dibujar, ya no es genio.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Su presencia se volvió algo ínfimo dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Sin embargo, él volvió a tomar el pincel.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Volvió a pintar de nuevo, después de tanto tiempo de haber dejado de hacerlo.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Y lo hizo en forma de esas falsificaciones...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Aunque nadie más lo sepa, yo sí lo sé.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Sé que esas pinturas son de Naoya Kusanagi. Y sé que él volvió a tomar el\npincel.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Y por eso es que volví a seguirle la pista.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Lo perseguí.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=300000,file="zbg052a",path=":bg/",x2=960,y2=-586,x=0,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Dicen que la biblioteca del colegio Yumihari posee el mayor número de volúmenes\nde toda la ciudad.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Dentro de ella también hay un rincón donde se reúnen las ediciones pasadas de\nlos periódicos locales.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_knd_000121",ch="knd"},
},
ja={
{
name={"Kana"},
"“Rin... Misakura...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Había llegado a la hipótesis de que fue ella la razón que llevo a Naoya\nKusanagi a dejar el pincel.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"No, no solo yo.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Mis compañeros de clases nunca llegaron a decir nada al respecto en público,\npero seguramente llegaron a percibirlo así.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Es posible que a diferencia de la muchacha sin amigos que era yo, mis\ncompañeros de ese entonces sí conocían la realidad del caso.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Los profesores de ese entonces trataban de ocultar algo.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Rin Misakura se ausentó del colegio, bajo supuestas circunstancias especiales\nde su familia.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"En ese mismo período, Naoya Kusanagi se ausentó también del colegio por mal\nestado de salud.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Ambos desaparecieron del salón en el mismo período.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Rin Misakura fue transferida, sin llegar a reincorporarse nunca.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Naoya Kusanagi volvió después al colegio, pero ya no pintaba más.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Muy pocas personas se dieron cuenta de eso, y solo yo llegué a fijarme en algo\nmuy importante.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"El brazo dominante de Naoya Kusanagi había cambiado.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"No, para ser más precisos, pasó de ser diestro a ambidiestro.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Ese gesto lo hacía ver como si estuviera protegiendo su brazo derecho de algo.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_knd_000122",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya casi...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"se",file="se2497",id=1},
{"text"},
delay={
[500]={
{"se",file="se2497",id=2},
},
},
text={
ja={
{
"Voy acercándome cada vez más a esa fecha en el rincón de los periódicos\nlocales.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"La fecha en la cual Naoya Kusanagi se reincorporó al colegio.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"La fecha en la cual Rin Misakura fue transferida.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Voy más atrás de esas fechas.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Y entonces, llegué finalmente a la fecha en la cual ambos comenzaron a\nausentarse del colegio.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg052a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0001",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_knd_000123",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000124",ch="knd"},
},
ja={
{
name={"Kana"},
"“Este incendio...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Me quedé afincada en ese artículo.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Y es que había dado con la verdad.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",stop=1,time=1500},
{"se",stop=1,id=-1,time=1500},
{"vostop",stop=1,time=1500},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1500,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"Ese día, Rin y yo no hablamos casi.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Ni siquiera cruzábamos nuestras miradas.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Quizás fue porque Rin estuvo casi todo el tiempo cabizbaja.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="eveningsky_spring01",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Después de clases, al pararnos Rin y yo frente al portón de la entrada, Sui\napareció rápidamente.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Sui vino a nosotros, y con una sonrisa mucho más adulta de lo normal...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_sud_000457",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bien, ¿nos vamos a buscar entonces?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Dijo eso.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Rin asintió suavemente y comenzó a caminar.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Rin comenzó a caminar con un andar despacio, casi como si estuviera trayendo y\njalando algo hacia ella.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Probablemente ese 'algo' es justamente, aquello que Rin había perdido...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg014b",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Ese local estaba en un lugar en un callejón un poco alejado del distrito\ncomercial de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Parecía una tienda de artículos generales, pero en el letrero estaba escrito\nclaramente...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"'La casa de las muñecas - Olympia'.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"En el letrero había algo que parecía una muñeca mecánica dibujada, como la de\nla ópera de 'Los cuentos de Hoffmann'. Probablemente esa es Olympia.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Los cuentos de Hoffmann' es, en palabras resumidas, una obra romántica. La\nhistoria trata de como el protagonista, Hoffmann, se enamora de todas las\ncosas a su alrededor, y de como termina con el corazón roto en todos esos\nromances.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"'Olympia' es el nombre del segundo acto de 'Los cuentos de Hoffmann'.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"En este acto, Hoffmann se enamora, sin darse cuenta de la realidad, de Olympia,\nquien era idéntica a un humano.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Sin embargo, no hay manera alguna de que el romance entre una muñeca y un\nhumano termine bien, y al final la relación de los dos se rompe.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"La seudorelación entre muñeca y humano.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Es justamente 'Olympia' lo que simboliza esa ruptura.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003085",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Después de observar el cartel de Olympia, Rin abre la puerta de la tienda.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"Al abrir esa puerta de estilo clásico, el sonido de las campanas resuena en el\ninterior.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"El exterior estaba comenzando a teñirse de amarillo. Sin embargo, el interior\nde la tienda, oculto por cortinas de profundo carmesí, estaba iluminado por\nla tenue luz azul de unas lámparas de vapor de mercurio, sin ningún rastro de\nla luz exterior.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"La tienda, que parecía una especie de sospechoso hueco subterráneo, gozaba de\nuna gran variedad de artículos bastante raros. Un enorme mapamundi. Unos\ncuantos cráneos de animales encerrados en vidrio. Animales disecados vestidos\ncon ropa occidental. Un telescopio de latón.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Y una enorme cantidad de muñecas antiguas.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"En el letrero estaba escrito 'La casa de las muñecas', pero parecía más bien un\npequeño museo con una selección de muestras bastante raras y curiosas.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_ots_000001",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Hola, ¿le puedo ayudar en algo?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Del fondo de la tienda apareció una mujer que parecía ser la tenedora.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_ots_000002",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Oh, vaya, pero cuánto tiempo sin verte, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003086",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Señora...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_ots_000003",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿No trajiste a tu mamá hoy?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003087",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A... mamá?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Al ver la expresión de Rin, a la mujer que parecía ser la tenedora de la tienda\nse le ensombrece el rostro.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_ots_000004",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“... Claro, ya veo. Perdóname, ¿sí? Ya has crecido bastante, así que ya debes\nhaberlo aceptado todo...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003088",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Aceptado?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_ots_000005",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿En qué te puedo ayudar hoy? ¿Viniste de nuevo a comprarle ropa a tu mamá...\nah, perdón, a esa muñeca?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003089",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ropa...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Rin toma en su mano la pequeña ropa que estaba colgada de unos minúsculos\nganchos.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003090",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta ropa es...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"La etiqueta del atuendo que tomó en su mano tenía escrito 'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Es exactamente la misma ropa que lleva Sui.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003091",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sui-chan?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="eveningsky_spring01",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Sui voltea.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Pero solo yo estaba ahí.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Sui no está.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Es lo mismo de siempre.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Desaparece, como si nunca hubiera existido desde un principio.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Sui ha estado apareciendo y desapareciendo siempre de esa manera hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_ots_000006",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Veo que aún llamas 'Sui-chan' a la muñeca, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Rin no contesta. Simplemente bajó ligeramente su cabeza.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es usted la tenedora de esta tienda?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_ots_000007",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Oh, vaya, ¿eres amigo de Rin? Mucho gusto, soy la encargada de la Casa de las\nmuñecas Olympia.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_ots_000008",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Me imagino que debe parecerte una tienda bastante extraña. En un principio era\nsolo una tienda de muñecas antiguas, pero de tanto colocar otras tantas cosas\nnos convertimos en una especie de tienda general de antigüedades.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_ots_000009",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Pero, tal como puedes verlo en el cartel, somos una tienda especializada en\nmuñecas antiguas. Rin-chan vino hace tiempo a esta tienda, trayendo una\nhermosa muñeca consigo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"La piel de Rin se veía más blanca de lo normal ante la azulada luz de la\nlámpara de mercurio.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_ots_000010",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“La muñeca se llamaba Sui-chan. Probablemente era algún recuerdo de su madre, o\nalgo por el estilo. Siempre la trataba con mucho cuidado y cariño, como si se\ntratara de su propia madre.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_ots_000011",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Siempre la llevaba en silla de ruedas, pero con lo pequeña que es esta tienda,\nsiempre le costaba entrar.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003092",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Llevar la muñeca... en silla de ruedas...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bgm",stop=1,time=500},
{"cgdel",id=-1},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",file="se9014",id=2},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=300,func="wait"},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=3},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",file="se9014",id=4},
{"bg",file="ev_com_c08_02",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=500,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"se",file="se9014",id=7},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003093",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso es...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Al recuperar un recuerdo, todos los demás recuerdos vuelven de forma sucesiva a\nmí.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Una gran avalancha de recuerdos reviven.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Y de tal manera, que se me hace casi misterioso el hecho de haberlos olvidados\nhasta ahora.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg014b",path=":bg/",sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_csa_000001",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“Bienvenida.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003094",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, quisiera comprar un vestido que se le vea bien a mi mamá...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_csa_000002",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“Vaya, pero qué niña tan buena eres. ¿Es un regalo para tu mamá? ¿Conoces su\ntalla?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003095",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Traje a mi mamá conmigo, así que... si no es molestia, quisiera que le tomaran\nlas medidas...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_csa_000003",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“¿Eh? ¿T-Tu mamá vino contigo? ¿Eh, d-dónde está?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003096",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... está sentada acá.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_csa_000004",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“¿S-Sentada dónde? ¿En esta silla de ruedas? Pero, esto es una muñeca...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_csb_000001",ch="csb"},
},
ja={
{
name={"Empleada B"},
"“¿Otra vez esa niña? No tienes por qué preocuparte por atenderla.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_csa_000005",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“¿Eh? Ah, sí, está bien.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_csb_000002",ch="csb"},
},
ja={
{
name={"Empleada B"},
"“Pequeña, escúchame bien. En esta tienda no vendemos ropa para muñecas. Con ese\ncuerpo tan pequeño, ni siquiera la ropa de niñas le servirá.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003097",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Pequeña? Ella no...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_csb_000003",ch="csb"},
},
ja={
{
name={"Empleada B"},
"“Vamos, vuelve al trabajo. No tienes por qué prestarle atención, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_csa_000006",ch="csa"},
},
ja={
{
name={"Empleada A"},
"“Ah, e-entendido...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003098",ch="rnd"},
},
ja={
{
name={"Rin"},
"“D-Disculpen un seg--”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="eveningsky_spring01",id=1,lv=5,path=":cg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Mamá solo tenía una prenda de ropa, así que pensé en comprarle más.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Pero en ninguna tienda quisieron atenderme.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Pensaba que se debía a que yo era una niña.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"cgdel",id=-1},
{"se",id=8,file="se_noise_long2"},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",file="se9014",id=2},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=300,func="wait"},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=3},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",file="se9014",id=4},
{"bg",file="ev_com_c08_02",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=500,func="wait"},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=5},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",file="se9014",id=6},
{"bg",file="ev_com_c08_02",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=1500,func="wait"},
{"se",stop=1,id=8,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="eveningsky_spring01",id=1,lv=5,path=":cg/",sync=0},
{"extrans",time=1000},
{"se",id=1,file="se2225"},
{"text"},
text={
vo={
{"vo",file="fem_ots_000012",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Oh, pero qué muñeca tan linda llevas.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003099",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No es una muñeca, es mi mamá!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_ots_000013",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿Eh? ¿D-De verdad? Pero qué linda es tu mamá...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003100",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, mi mamá es hermosa, y además famosa.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_ots_000014",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"colortone",style="reset"},
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003101",ch="rnd"},
},
ja={
{
"Sí, así sucedió todo...",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003102",ch="rnd"},
},
ja={
{
"Le compré una nueva prenda de ropa a mi mamá en esta tienda... Eso creía.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003103",ch="rnd"},
},
ja={
{
"Pero la realidad es distinta.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003104",ch="rnd"},
},
ja={
{
"Lo que yo estuve comprando fue... ropa para muñecas. La etiqueta de Olympia es\nla prueba de que es una prenda de ropa para muñecas fabricada a mano por esta\nmisma señora.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003105",ch="rnd"},
},
ja={
{
"¿Por qué... hice eso?...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg014b",path=":bg/",sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2c0100",face="c0001",head="rin_z2c",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm025"},
{"se",id=1,file="se2225"},
{"se",file="se0744s",id=2},
{"fg",ch="稟",mx=-40,mode=-1,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003106",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Rin?!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_ots_000015",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no sucede nada.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... gracias por lo que hizo en aquel momento.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_ots_000016",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿Eh? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por seguirle la corriente a Rin. Me imagino que esta clase de ropa no debe\nestar al alcance del monedero de una niña.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_ots_000017",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Pues... tal vez...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, normalmente a cualquiera le daría miedo ver a una niña comportándose\nde esa forma. Probablemente nadie la ayudó por eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_ots_000018",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Tal vez, pero... yo, tampoco llegué a tener hijos, y...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_ots_000019",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Y tal vez por eso, es que no pude dejar pasar por alto a esa niña...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_ots_000020",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“No sé cómo habrán sucedido las cosas, pero esa muchacha perdió a su madre,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_ots_000021",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“Y por eso, comenzó a creer que el recuerdo de su madre, la muñeca, era su\npropia madre...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_ots_000022",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“No conozco mucho en detalle, pero pude imaginarme eso aquella vez...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchísimas gracias. No solo por ese entonces, sino por hoy también.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_ots_000023",ch="ots"},
},
ja={
{
name={"Dueña de la tienda"},
"“¿Por hoy?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, muchas gracias por hoy!”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"msgoff"},
{"bg",file="zeveningsky_spring01",id=8,lv=8,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Después de bajar la cabeza y hacer una reverencia de agradecimiento frente a la\ntenedora, salí corriendo de la tienda.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Persigo a Rin. Creo saber a dónde va.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"No hay muchos lugares a los que pueda ir ahora.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Menos mal que me encontré con el padre de Rin aquella vez...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"No conocía la dirección de la nueva residencia del padre de Rin.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Ni la hubiera conocido, de no ser porque me dio su dirección junto a esas\nfotos...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Sin embargo, la ubicación de ese apartamento me pareció bastante obvia.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que el único lugar de donde se puede ver lo que quedó de esa mansión, es\nen ese edificio...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que el padre de Rin tampoco ha podido olvidarlo...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"A pesar de todo eso, el padre de Rin vendió ese terreno.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Vendió lo que quedó de esa mansión donde vivían los tres.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Y por eso, en ese terreno se está construyendo ahora un nuevo edificio.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Lo que quedaba antes, está ahora perdiéndose.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por eso es que Sui apareció en ese lugar?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Sí, es posible que sea eso.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Sin embargo, probablemente no es solo eso.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos pétalos...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Los pétalos de cerezos milenarios que estaban en el álbum.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Aquellos legendarios cerezos, que chupan los sueños.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Y les dan forma.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Si esos pétalos no hubieran sido esparcidos por ese terreno, entonces\nseguramente Sui no hubiera aparecido.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en aquel momento, solo pensé en regresarlos a ese terreno de tantos\nrecuerdos...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Quién podría imaginarse que algo así podría suceder solo con esos pétalos...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg028c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Encima de lo que quedó de la mansión de Rin, estaba ya casi culminado el nuevo\nedificio.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agh.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"¿Es que acaso Rin recordó incluso eso?",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"De ser así, ¿qué tendrá en mente respecto a las ruinas de la mansión?",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Corro de nuevo.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Finalmente llego a la entrada de mi edificio.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Me subo con premura en el elevador.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me bajo en un piso diferente al de siempre.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Y es que ahora no estoy tratando de ir a mi apartamento.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"se",id=1,file="se2554"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Disculpe! ¡Me tomaré el atrevimiento de entrar!”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Toco el timbre una sola vez y pongo mis manos sobre la manilla.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"se",id=1,file="gatya"},
{"text"},
text={
ja={
{
"Tal como lo pensé, la puerta no está cerrada con llave.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"En la entrada están tirados los zapatos de Rin.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"No me cabe duda alguna.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"bgm",stop=1,time=500},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg029c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm026"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000103",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y Rin?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000104",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Entró de repente a este apartamento, y...”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué sucedió?”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000105",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Allí, está...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"El padre de Rin señala con su dedo un rincón de la sala.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=800,file="zbg029c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2c0100",face="c0001",head="rin_z2c",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Y allí estaba Rin, de espaldas.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003107",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso... eso no, puede...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Y tras la mirada de Rin, estaba...",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",mode=-2},
{"bg",file="ev_com_c08_03",path=":ev/ev_com_c08/",set="ev_com_c08"},
{"text"},
text={
ja={
{
"Una silla de ruedas... y esa muñeca.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003108",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este vestido...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003109",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este vestido... es idéntico al que Sui-chan llevaba...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Rin aprieta con sus manos la ropa que estaba dispuesta doblada al lado de la\nmuñeca.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003110",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y... esta, es la ropa que le compré a mamá...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así lo supongo...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003111",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Acabo de recordarlo... yo...”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003112",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo... esto... es la ropa de mamá... Tomé la ropa que mamá tenía y la llevé a esa\ntienda, para que me hicieran ropa nueva...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003113",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ese uniforme también... Mamá era egresada del colegio Yumihari, así que...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003114",ch="rnd"},
},
ja={
{
name={"Rin"},
"“También, pedí que me hicieran ese uniforme...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003115",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es la ropa... que me hicieron...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003116",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué? ¿Por qué hice esto?”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003117",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Papá! ¡Dime!”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg029c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_mtt_000106",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0007",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003118",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No te quedes callado! ¡Dí algo!”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003119",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nao-kun, no te metas! ¡Estoy preguntándole a mi papá!”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003120",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En ese momento, no fue... a mamá a quien me robaste, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003121",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tiene que ser eso. Y es que es demasiado raro...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003122",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si no es así, entonces no encuentro forma de entender esto...”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"bg",time=500,file="black",path=":bg/"},
{"bg",file="ev_uni_c41_01",path=":ev/ev_uni_c41/",set="ev_uni_c41"},
{"text"},
text={
vo={
{"vo",file="man_mtt_000107",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No puedo permitir que sigan juntas las dos.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003123",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Por qué?! ¡Mamá ya no puede moverse!”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
vo={
{"vo",file="man_mtt_000108",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No, ese no es el problema. No pueden permanecer juntas por siempre. De hacer\neso, irás empeorando cada vez más.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003124",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué quieres decir con que empeoraré? Es mi madre, ¿por qué no debería\nacompañar a mi madre enferma?”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="man_mtt_000109",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Debí haber tomado esta decisión más pronto... No tiene caso seguir haciendo\nesto...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003125",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué es lo que no tiene caso? ¿Por qué? ¡No, no te lleves a mamá!”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="man_mtt_000110",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Perdóname, Rin...”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg029c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003126",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo... creía que esa muñeca era mi mamá... y por eso, es que me la quitaste...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003127",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es lo normal. Lo que cualquier padre haría...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003128",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y aun así, ¿por qué? ¿Por qué, no me dijiste eso?...”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003129",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué, no me dijiste... que era yo quien tenía la culpa?...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",mode=-2},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000111",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Tenía que ocultarlo...”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003130",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ocultarlo?”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000112",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Así es. Si no hubiera hecho eso, realmente hubieras terminado enloqueciendo...”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003131",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Yo, hubiera terminado... enloqueciendo?”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000113",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Si te hacía creer que fue tu mamá, y no esa muñeca, lo que robé de ti, entonces\nno surgiría ninguna incongruencia en tus recuerdos. Y por lo tanto, no\nrecordarías nada.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003132",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Recordar?”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
