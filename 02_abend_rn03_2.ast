{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mojarse?... ¿De qué están hablando?”",
{"rt2"},
},
