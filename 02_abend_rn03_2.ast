{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000771",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Shizuku-chan, eso de ver a escondidas es de mal gusto... Por lo menos dinos\nalgo...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",x=-345,lv=4,id=7},
