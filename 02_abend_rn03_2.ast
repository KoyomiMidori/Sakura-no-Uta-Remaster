},
},
text={
vo={
{"vo",file="fem_szd_000295",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si les dijera algo entonces ya no se podría decir que estaba espiando.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No espíes.”",
{"rt2"},
},
},
},
