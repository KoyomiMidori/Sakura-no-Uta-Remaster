},
},
text={
vo={
{"vo",file="fem_rnd_000773",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿E-Excitarme?! E-Esto... P-Pe, pero no tanto como para mojarme, creo. ¡E- En\nverdad, no estoy así de excitada!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=-345,lv=4,id=7},
{"text"},
