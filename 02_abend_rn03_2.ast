},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=125,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
