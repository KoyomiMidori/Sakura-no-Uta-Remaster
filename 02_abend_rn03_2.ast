},
},
text={
vo={
{"vo",file="fem_rnd_000770",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, vamos a quedarnos calladitas por un momento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien, Shizuku? ¿Por qué entraste de repente?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x2=125,x=345,lv=4,id=6},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0022",head="shz_z1a",x2=-215,x=-345,lv=4,id=7},
{"fgact",ch="雫",act="びっくり",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=7},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0016",head="shz_z1a",x=-345,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_szd_000294",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No fue de repente. Estuve espiándolos todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
