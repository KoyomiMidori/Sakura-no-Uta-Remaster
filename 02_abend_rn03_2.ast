{"fgact",ch="稟",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000778",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Con toda razón pongo esta voz también. Lo hiciste a propósito, ¿verdad? Dijiste\nesas cosas tan confusas e insinuantes a propósito, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
