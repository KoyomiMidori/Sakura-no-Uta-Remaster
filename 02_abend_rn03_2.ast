{"vo",file="fem_szd_000296",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, sería terrible que les robara su oportunidad de tener sexo si llegara a\nhablarles...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006j",head="rin_z1a",x=345,lv=4,id=6},
