linknext="block_00128",
},
block_00128={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0005",head="shz_z1b",lv=4,id=7},
