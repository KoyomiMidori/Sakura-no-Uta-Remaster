linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0012",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000304",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Oroh, Rin, qué voz de terror.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
