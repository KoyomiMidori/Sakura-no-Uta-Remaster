{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x2=-345,x=-395,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000779",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡NO. ES. TÁ. MO. JA. DO!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Rin intimida a Shizuku con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Incluso la propia Shizuku no pudo evitar sentirse un poco atemorizada, y\nretrocedió.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000780",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, ¿por qué todo el día de hoy habré tenido que escuchar ese tipo de\nconversaciones?...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000781",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aun cuando hasta ahora nunca había sucedido eso...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0012",head="shz_z1a",x=-395,lv=4,id=5},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0012",head="shz_z1a",x2=-395,x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0016",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000306",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Ese tipo de conversaciones todo el día? ¿Es que hablaron en otra parte de cómo\nte mojas tan rápido, Rin?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000782",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No me mojo tan rápido! ¡No digas esas cosas sin prueba alguna, por favor!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0016",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000307",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, alguien más aparte de mí te lo dijo también, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000783",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000308",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El hecho de que te digan lo mismo dos veces en un mismo día no significa otra\ncosa más que de verdad pareces verte de esa forma, Rin.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
vl03={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000784",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Pero jamás en mi vida me habían dicho eso antes! ¡Y por eso es que yo no\nsoy así!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000309",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No fue justamente porque Naoya no estaba involucrado las veces anteriores?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000785",ch="rnd"},
},
ja={
{
name={"Rin"},
"*escalofrío*",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000310",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te pones así porque Naoya entra en la ecuación.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000311",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, al sentir la piel de Naoya... tu corazón se acelera, la temperatura se\nincrementa rápidamente desde el núcleo de tu cuerpo, y como si ese calor\nrebozara a algún lugar, tu ya caliente――”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0014",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0014",head="rin_z1a",x2="345,405,285,415,275,395,295",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000786",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah~, wah~, wah~, ¡¿P-Pero qué estás diciendo?! ¡Eso no es cierto!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000312",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero hoy sucedió una situación similar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000787",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es que... casi nunca he tenido la oportunidad de hundir mi cara en el pecho\nde Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0016",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000313",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fumuh, entonces solo con eso basta para que te mojes por completo. Tus\npantaletas deben estar ahora inundadas.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000788",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No lo están!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-600,zoom=90,file="zbg009a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",x=210,lv=5,id=8,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z2",mx=-40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0016",head="shz_z2a",x=-210,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000314",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mmmm. Pero lo recuerdas al estar en casa y te masturbas pensando en ello, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Shizuku le susurra en el oído a Rin.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",x=210,lv=5,id=8},
{"fgact",ch="稟",act="びっくり",lv=5,id=8},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",x=210,lv=5,id=8},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=210,lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_rnd_000789",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No lo hago! ¡Yo no hago esa clase de cosas! ............... En la medida de\nlo posible.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",x=-210,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000315",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Cuando dices 'en la medida de lo posible', significa que a veces lo haces?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=210,lv=5,id=8},
{"fgact",ch="稟",act="びっくり",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000790",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002",head="shz_z2a",x=-210,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000316",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Crees poder aguantarte hoy?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=210,lv=5,id=8},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=210,lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_rnd_000791",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues... tal vez, no.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",x=-210,lv=5,id=7},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="du",lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_szd_000317",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Eres bastante honesta.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",x=210,lv=5,id=8},
{"fgact",ch="稟",act="びっくり",lv=5,id=8},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=210,lv=5,id=8},
},
},
text={
vo={
{"vo",file="fem_rnd_000792",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Tal vez! ¡Dije tal vez! ¡Simplemente no tengo la suficiente confianza de decir\n'No lo haré', pero, hasta ahora siempre estuve aguantando en la medida de lo\nposible!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",x=-210,lv=5,id=7},
{"fgact",ch="雫",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000318",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Cuando dices 'en la medida de lo posible' significa que lo has hecho varias\nveces hasta ahora?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0022j",head="rin_z2a",x=210,lv=5,id=8},
{"fgact",ch="稟",act="びっくり",lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000793",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pueees...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0016",head="shz_z2a",x=-210,lv=5,id=7},
{"fgact",ch="雫",act="rl",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000319",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Pues?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",x=210,lv=5,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000794",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Oigan... ustedes dos...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010j",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x2=0,x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000795",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0100",face="d0014j",head="rin_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000796",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿N-Nos has estado escuchando?!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Ya no es cuestión de si las escuché o no, me han tenido enfrente todo este\ntiempo...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000797",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Qué hago?! ¡Nao-kun me escuchó! ¡Lo escuchó todo!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"¿P-Pero de qué estás alterándote a este punto ahora?...",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000798",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun... l-las cosas no son como crees...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000799",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... No, creo que ya no puedo sacar ese tipo de excusas, ¿verdad?... Ajaja.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0021j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000800",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Uwaan! ¡Así soy yo! ¡Una mujer, un ser vivo que vive solo de delirios y\nfantasías! ¡Y aun con todo el esfuerzo que puse para que no se diera cuenta\nhasta el día de hoy!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000320",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay necesidad de ocultar nada.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0021j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000801",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí la hay! ¡Y es que Nao-kun se repugnará! ¡Quedará asqueado! ¡Quedará\ndecepcionado de tener una amiga de la infancia así!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000321",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso no es cierto. Puesto que Naoya es un pervertido.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué se supone que yo soy un pervertido?!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0022j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000802",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Lo ves?! Nao-kun es una persona normal, quedará decepcionado de tener una\namiga de la infancia así. ¡Una ilusión decepcionante!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000322",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No creo que se decepcione tanto.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000803",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que sí. El ideal de una amiga de la infancia es de una chica pura,\nserena, casta, como una dama...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Pues ciertamente hay bastante diferencia a como has sido desde que regresaste,\npero... conociéndote desde pequeña, sé que no es tan grande la brecha en\nrealidad.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"En primer lugar, cuando éramos aún unos niños ella llegó incluso a buscar\nbastantes revistas eróticas conmigo...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000804",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Estabas recordando cosas no muy buenas! ¡¿Verdad?! Es eso, ¡¿no?! ¡De lo que\nhacíamos cuando éramos niños! ¡De cómo buscábamos juntos revistas\npervertidas!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es un hecho que lo hacíamos...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0021j",head="rin_z1b",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0020j",head="rin_z1b",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000805",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Uwaan! ¡Uwaan! ¡Qué cruel! ¡Y aun con todo lo que me esforcé para mantener mi\nimagen de damisela pura hasta ahora! ¡Aún después de forzarme a hacerlo!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estuviste forzándote a hacerlo?...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0008j",head="rin_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0009j",head="rin_z1b",x=345,lv=4,id=6},
},
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0011j",head="rin_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000806",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uh~ Es que, es que, Nao-kun, nunca llegaste a enviarme ninguna carta, y cuando\nempecé a pensar en alguna posible razón, recordé lo que hacía cuando era\nniña, y...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es para tanto, realmente. Yo también me divertía haciéndolo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000807",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, eso sucedió cuando éramos niños. ¡Si lo hiciera ahora sería una persona\nmuy rara!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0016",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000323",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ohhh... Rin, ¿aún sigues merodeando entre las arboledas buscando revistas\neróticas?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005j",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000808",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No lo hago! ¡No hay forma de que aún siga haciendo eso!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000809",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo que, pensé que si Nao-kun llegara a arrastrar aún esa imagen mía del\npasado... se repugnaría.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000324",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad? Probablemente no sea así.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000325",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000326",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me he masturbado varias veces pensando en ti. ¿Odias a esa Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000327",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ve nada más, esta cara radiante de felicidad.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero q--! ¡¿Volviste a engañarme?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No te bastó con el asunto de las pantaletas de la vez pasada!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000810",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿El asunto de las pantis?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"El tono frenético y alterado que tenía la voz de Rin hasta ahora se torna ahora\nmucho más bajo.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, esto...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",mode=-2},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=6},
{"fg",ch="稟",my=40,mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000811",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué se refieren con el 'asunto de las pantis'?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_szd_000328",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cuando le dije a Naoya que le dejaría tomarme fotografías con su celular\nmostrando mis pantaletas, se alegró.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=6},
{"fgact",ch="稟",act="du",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000812",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ohhh... Kusanagi-kun... Así que has estado haciendo esa clase de cosas.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0018",head="rin_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000813",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te has grabado y fotografiado metiéndoselo a toda esa gran cantidad de\nmuchachas recién ingresadas, ¿verdad? Eres muy popular con las chicas,\nKusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, e-eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Espera, Rin, ¿no acabas de usar unas palabras un tanto impactantes?",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000814",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Rin se pone cabizbaja.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000815",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, solo que pensé que... no tengo derecho alguno a decir nada al respecto...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000816",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hoy me alteré al escuchar como Kei-kun dijo que tenías a todas las chicas en\nbandeja y te las comías...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me he comido a nadie!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000817",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No. No importa si sea verdad o no, la cuestión es que es extraño que yo trate\nde decir algo al respecto.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000818",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, no tengo remedio alguno, ¿verdad? Aun cuando se supone que solo soy\nuna amiga de la infancia...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000329",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso también incluye ser una amiga de la infancia.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000330",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ser amigos de la infancia implica saber todo de los dos, tanto los recuerdos\nhermosos de la niñez como los sucios.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="rl",lv=4,id=5},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku junta mi mano con la de Rin.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000819",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000331",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No tienes por qué forzar tanto las cosas. Puedes ser como eres normalmente,\nRin. Aún actuando normal eres una chica muy linda, y muy cariñosa y amable.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000820",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0016",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000332",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y? ¿No te corriste un poco ahora al sostener y apretar la mano de Naoya?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0007",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000821",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"¿Por qué tienes que traer el desastre de nuevo a este desenlace tan bueno y\nsentimental?...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_rn04"},
{"text"},
linkback="block_00236",
},
