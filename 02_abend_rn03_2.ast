{"fgact",ch="雫",act="うんうん",time=367,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000303",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad? Me equivoqué, me equivoqué.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
