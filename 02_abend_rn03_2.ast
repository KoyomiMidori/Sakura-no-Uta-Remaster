},
block_00119={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000297",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas eso con esa cara tan dudosa.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000298",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dejando eso de lado, Rin, ¿te excitaste al ver el pecho descubierto de Naoya?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",x=345,lv=4,id=6},
