{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0005",head="shz_z1a",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_szd_000300",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Un poquito?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006j",head="rin_z1a",x=345,lv=4,id=6},
