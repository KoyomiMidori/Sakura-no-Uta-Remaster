astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm031"},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0004",head="kei_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000175",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! ¡¿Ya está listo?! Aunque, tus comidas son bastante femeninas, eh,\nNaoya...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo que femeninas? ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",mode=-2,sync=0},
{"bg",zoom=110,speed=300,file="bg023c",path=":bg/",z2=100,ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z2",zoom=110,speed=300,mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0023",head="kei_z2b",y2=0,z2=100,y=30,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",file="se1437",id=1,vol=50},
{"fgact",ch="圭",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0021",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="man_ked_000176",ch="ked"},
},
ja={
{
name={"Kei"},
"“*fugafuga*, detente, vas a romperme la boca... eso duele...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",stop=1,id=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no me busques pelea...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0004",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0005",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="man_ked_000177",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pero es que la carne es tan suave! ¿No te faltó meterle algo más de espíritu?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es espíritu, es dinero lo que me falta...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_ked_000178",ch="ked"},
},
ja={
{
name={"Kei"},
"“Y además, el sabor es...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0019",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000179",ch="ked"},
},
ja={
{
name={"Kei"},
"“... ¡DELICIOSOOOOO!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_ked_000180",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué rayos? Esta carne de puerco está suave y muy buena.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, porque no es carne de puerco. Lo que hay adentro son cortezas de pan...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000181",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿E-Esto también? ¿Cortezas de pan?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Está hecho con cortezas de pan cuadrado unido con mostaza. Calenté\nlas cortezas de pan cuadrado y lo coloqué en capas con la mostaza, y luego lo\naplasté todo, así que el sabor y la textura se acercan al del puerco. Aunque\nbueno, haga lo que haga siempre será más suave que el puerco verdadero.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0001",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0002",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="man_ked_000182",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, está perfectamente bien. Me gusta más esto que la carne de puerco fibrosa.\n¿Oh? Este es ese misterioso okonomiyaki, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy le puse queso derretido y también le agregué salsa y mayonesa.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000183",ch="ked"},
},
ja={
{
name={"Kei"},
"“De verdad que esta vez no parece nada más que un okonomiyaki, eh.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0010",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000184",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
},
vl02={
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000185",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡QUÉ BUENOOOO! ¡Esto está buenísimo! ¿Qué es esto? El queso derretido y la\nsalsa de okonomiyaki combinan muy bien. Está delicioso.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bien...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Ya sin ganas de responder a lo que Kei decía, me quedé callado y probé un\npedazo del shougayaki que él preparó.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"El shougayaki... un tanto quemado que Kei preparó.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0001",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿?!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos es esto?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_ked_000186",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué está tan salado?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0004",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000187",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Salado? Es imposible. Lo preparé como siempre.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué manera lo preparaste?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0019",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0014",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000188",ch="ked"},
},
ja={
{
name={"Kei"},
"“Dejé reposar la carne de puerco en un tare hecho a base de salsa de soya,\nmirin, azúcar y jengibre, *ejem*.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La preparación es la usual... E-Espera... Ahora que lo recuerdo, dijiste que te\ntomaste 5 horas para los preparativos... Será posible que...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000189",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Así es! ¡Normalmente solo se deja reposar la carne en el tare por 10 minutos,\npero esta vez la dejé reposar por 5 horas! ¡Debería ser 50 veces más\ndeliciosa!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Idiota... es eso...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Es de lo más básico entre lo básico ajustar el sabor dependiendo del tiempo de\nreposo.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Si dejas algo que queda perfectamente bien con solo 10 minutos de reposo por 2\ndías enteros dentro de un contenedor plástico, pues es obvio que terminará\ncon este sabor.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0006",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000190",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Cómo que idiota?! Me voy a enojar.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... ¿Y bien, probaste el sabor?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0001",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="man_ked_000191",ch="ked"},
},
ja={
{
name={"Kei"},
"“No lo hice. Quería que fueras el primero en comerlo.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué repugnante.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0022",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000192",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Cómo que repugnante?! ¡Me voy a enojar!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien, está bien. En fin, come un poco de este shougayaki...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0004",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000193",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",file="se9010",id=1},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0019",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000194",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0008",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000195",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Está como que un poco salado, eh.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Un 'poco' se queda corto para describirlo!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0005",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0003",head="kei_z2b",y=30,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="man_ked_000196",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tampoco así... solo un poco. Vamos, vamos, Naoya, come bastante. Este\nshougayaki está lleno de mi amor y afecto.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha--”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bgm",stop=1,time=500},
{"se",id=1,file="se2554_n"},
{"bg",time=300,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Quién es?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, pero qué demonios...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás parado acá, imbécil?...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bgm",file="bgm008"},
{"msgoff"},
{"fg",ch="明石",size="z1",sync=1,mx=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000001",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Veo que no dejas de comportarte arrogantemente a pesar de ser solo un kouhai,\neh, Kusa~nagi~”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, Akashi-senpai, ¿a qué se debe tu presencia a estas horas en mi casa y\nqué viniste a hacer, maldito?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"user",mode="conf",ch="明石"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000002",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kusanagi... parece que acabas de preparar la comida, eh.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jo... ciertamente, así es. ¿Y por qué viniste acá entonces?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000003",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Me permitiré entrar por un momento...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"se",file="se9012",id=1},
{"quake",size=5,mode="mw"},
{"fg",ch="明石",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡O-Oye! ¡Espera! ¡Siempre que vienes no sucede nada bueno!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000197",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! ¡Akashi-senpai!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000004",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ohh! ¡Pero vaya lujo, tonkatsu! ¡Así que preparaste todo esto para rogar por mi\nvictoria en la batalla, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Con qué se supone que estás peleando?",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_ked_000198",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Este plato no es para eso! ¡Naoya y yo estamos en medio de una competición de\ncocina!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000005",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, y por eso es que me llamaron acá.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que llegaste a esa conclusión?...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000006",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Si hablamos de competiciones de cocina, es necesario un juez! ¡Y si hablamos\nde un juez de cocina, no hay nadie mejor que un gourmet como yo! ¡En pocas\npalabras, fui llamado acá porque me necesitaban!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_000199",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajaja, senpai, nadie te ha llamado.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei, tú no lo llamaste? ¿Entonces por qué este tipo está acá?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_ked_000200",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hace un rato, mientras andaba caminando, me encontré con el senpai, y entonces\nle dije que vendría a tu casa a preparar la comida. Viniste porque dije que\nprepararía la comida, ¿no? Pero qué senpai tan despreciable eres, eh.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
},
vl02={
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000007",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiota... *musha, musha*, no hay manera alguna de que tu comida pase por mi\ngarganta... *musha, musha*.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero qu--! ¡¿Qué estás comiendo, imbécil?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000008",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Es comida, y por eso como!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_ked_000201",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Senpai, qué malo eres! ¡¿Por qué no puedes comer mi comida?!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000009",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Porque no es comida!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0022",head="kei_z1b",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0006",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000202",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Muki~! ¡Qué humillación! ¡¿Cómo es que puedes decir que mi comida no es comida\nsi ni siquiera la has probado?!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_wtd_000010",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Una predicción basada en mi experiencia!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000203",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mi comida rompe y supera toda predicción posible!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que ese tipo de comida acarrea muchos problemas...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0019",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000204",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Aún tratándose de ti, no te perdonaré, senpai!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="圭",mx=-40,mode=-1,lv=4,id=9},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000011",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ajajajaja... qué repugnante, eh. No me abraces, Natsume.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000205",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No me digas repugnante! ¡Y no digas que te estoy abrazando! ¡Estoy cargando\npara golpearte!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh... ¿Pero qué demonios está sucediendo?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"mwact",act="うんうん",time=500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000012",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡*musha, musha*, ohh! ¡Kusanagi, veo que sigues siendo un talento en la cocina\ncomo siempre, eh! ¡Pero los genios se mueren bien rápido, así que C U Í D A T\nE!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué disparates andas diciendo? No me importa que comas, pero usa palillos.\nDeja de comer con las manos.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_wtd_000013",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohh, lo siento, perdóname~”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",id=1,file="se0897s"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¡No te limpies las manos con la alfombra!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"se",id=1,file="se2554_n"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ahh?! ¡¿Pero quién rayos es ahora?!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="gatya"},
{"fg",ch="真琴",size="z1",mx=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000052",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, entraré un momento.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué pasa, Toritani?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"se",file="se9023",id=1},
{"fg",ch="真琴",mx=-40,mode=-1,lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000053",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ahh! ¡Ex-jefe Akashi!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0007",head="kei_z1b",x=-345,lv=4,id=5,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm007"},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000206",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaah! ¿Qué, qué pasa? ¿Por qué Makoto está acá?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000014",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Nuh? ¡Pero vaya, si es Toritani!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fg",ch="明石",speed=800,mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x2=0,x=-345,lv=4,id=9},
{"mwact",act="うんうん",size=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000015",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Nujajajajajajaja! Bien, creo que me retiraré ya.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000054",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Akashi-senpai, ¿piensas huir de nuevo?!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"se",file="se9023",id=1},
{"fg",ch="明石",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh--! ¡Akashi! ¡¿A dónde piensas ir?! Ese es el balcón.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",stop=1,time=500,id=1},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0006",head="mak_z1d",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_000055",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No sirve de nada que trates de huir, ex-jefe! ¡Vendrás con nosotros!\n¡Kusanagi, protege el balcón!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué yo?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000056",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Te di un servicio especial de gyuudon, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"msgoff"},
{"fg",mode=-2},
{"se",file="se9023",id=1},
{"bg",y=30,speed=500,sync=0,file="zbg023c",path=":bg/",x2=760,y2=30,x=960,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="明石",size="z2",ex03="a0097",zoom=110,speed=500,sync=0,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0009",head="aka_z2a",x2=460,y2=-32,z2=80,x=0,y=0,lv=5,id=9},
{"ex",time=200,func="wait"},
{"bg",y=50,zoom=110,speed=500,file="zbg023c",path=":bg/",z2=100,x2=960,y2=30,x=1060,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="明石",size="z2",ex03="a0097",zoom=110,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0009",head="aka_z2a",x=0,y=0,lv=5,id=9,sync=0},
{"extrans",time=0},
{"quake"},
{"se",file="se3130",id=1},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000016",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Por qué apoyas a Toritani, Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé muy bien el por qué, pero por lo general siempre eres tú el culpable de\ntodo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fgact",ch="明石",act="ジャンプ",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000017",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No tengo la culpa de nada! ¡Yo soy el mensajero de la justicia! ¡¿Por qué no\npuedes entender eso?! ¡Kusanagiiii!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene caso alguno que hagas esa actuación tan dramática. Además, creo\nentender muy bien el principio básico de todas tus acciones. No voy a\naguantarme que rompas de nuevo el vidrio de mi balcón.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",x=0,y=0,lv=5,id=9,zoom=110},
{"fgact",ch="明石",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000018",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Gununuh...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"se",file="se3130",id=1},
{"bg",file="ev_com_a09_01",zoom=100,speed=200,time=200,z2=120,path=":ev/ev_com_a09/",set="ev_com_a09"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000057",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kusanagi, cubre la derecha! ¡Kei, la izquierda!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_ked_000207",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Y-Yo también?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, lo haré. Pero con esto ya estoy libre de la deuda del gyuudon.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_wtd_000019",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tch, no hay paso alguno...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_com_a09_02",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000058",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Senpai, no puedes hacer más nada. Vendrás con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000020",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ujajajajaja! ¡No voy a ir!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? Toritani, entraste de repente a mi casa y ahora sucede este gran\nalboroto... Debes tener una muy buena explicación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_a09_03",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000059",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este idiota ex-jefe, a pesar de haberse ya graduado, se gastó la parte del\npresupuesto del club que había reservado para hacer las reuniones de\nbienvenida para los nuevos miembros del club.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jo. Poniendo eso de lado, Akashi, ¿pudiste graduarte?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_wtd_000021",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, en el sentido estricto de la palabra, aún no.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, repites de año, y te gastas el dinero del club. Realmente no haces nada\nbueno, eh...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000022",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡A-Algo resolví con el dinero al final! ¡Originalmente debí haber incluso\nganado una buena tajada de dinero! ¡¿No es así, Kusanagiii?!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y yo qué sé, gran imbécil?! ¡No digas eso a estas alturas! ¡Saca esa excusa\nsolo cuando de verdad tengas el dinero en tus manos! ¡Siempre te gusta andar\nluciéndote demasiado!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="man_wtd_000023",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Pero si tú no puedes hablar de los demás! ¡¿Acaso no rechazaste recibir toda\nla suma completa?!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por mi parte no hay problema porque tenía esa intención desde el principio!\n¡Fuiste tú al que se le ocurrió que podría hacer bastante dinero y te metiste\nen eso!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000024",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Gununuh... ¡¿Así que el amigo de ayer es hoy mi enemigo?! ¡Kusanagiii!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",file="ev_com_a09_01",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000060",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No sé de qué rayos están hablando, pero no me importa el asunto de ninguna\ngran suma de dinero! ¡Estoy molesta por el tema del presupuesto del club!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_wtd_000025",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“R-Respecto... al presupuesto, eh, esto, simplemente tomé prestado el dinero,\n¡seguramente, quizás, tengo la intención de regresarlo!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_a09_03",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a09_01",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
},
},
text={
vo={
{"vo",file="fem_mkd_000061",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ja? ¿Lo tomaste prestado? ¡¿En qué demonios te lo gastaste?!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_wtd_000026",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“... Ehm... digamos, esto, esto, ¿en ahorros, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_a09_02",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000062",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Dónde?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"mwact",act="うんうん",time=800},
{"text"},
text={
vo={
{"vo",file="man_wtd_000027",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ehm, esto, en esa edificación, que está frente a la estación...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_a09_03",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000063",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y cómo se llama?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_wtd_000028",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Parlor Monkees.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_ked_000208",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Parlor Monkees?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_a09_01",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000064",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Cómo?! ¡No hay forma alguna de guardar ahorros en un local de pachinko! ¡Te\nvoy a matar!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="man_wtd_000029",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah, por supuesto que nooo, el dinero va a regresar...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_a09_03",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000065",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo es que puedes asegurar eso?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="man_wtd_000030",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Los pachinko son como un tipo de inversión... Aunque a veces la probabilidad no\nvaya a tu favor.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_ked_000209",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ja, no tiene remedio alguno.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_wtd_000031",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eres la persona menos indicada para decirme eso!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no tienes remedio alguno...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000032",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ahn, pero qué cruel eres tú también, Kusanagi-kuuun!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás hablando como un marica ahora?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_wtd_000033",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah, no, solo que, quizás si me comportaba de manera linda me apoyarías... Eso\npensé.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque trates de dártelas de chica linda, con ese aspecto que tienes solo\nlogras ser repugnante.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Por Dios...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Así como conozco gran parte de la verdad, así de ridículo me parece todo esto.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Ya te había dicho que aseguraras tu parte del dinero, imbécil...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="ev_com_a09_02",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000066",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún después de que, sin otra opción en mis manos, te presenté un trabajo para\nque pudieras reunir el dinero...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000034",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ngyaah~! ¡¿Presentarme un trabajo?! ¡¿Ese festival de hombres desnudos\nagarrándose y soltándose los pen*s?!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hombres desnudos?... Eso es...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_ked_000210",ch="ked"},
},
ja={
{
name={"Kei"},
"“Un festival de pen*s de hombres completamente desnudos... Prácticamente\nvendiste un humano a ese lugar... No podía esperar menos de ti, Makoto.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="ev_com_a09_04",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000067",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Pero qué rayos, comerciar con humanos?! ¡Todos ustedes están\nmalinterpretándolo todo!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a09_05",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
},
},
text={
vo={
{"vo",file="fem_mkd_000068",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Simplemente era un trabajo de medio tiempo en un baño público! N- Nadie está\nagarrándose ni soltándose nada.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un baño público, eh... ¿Hombres desnudos? Debes estar todo pegajoso, Akashi...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_wtd_000035",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No digas cosas tan tristes! ¡Basta con que trabajes allí para que te des\ncuenta! ¡¿Hay algún otro lugar en el mundo donde haya tanta aprobación de los\npen*s?!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie ha aprobado eso...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000036",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Si no está aprobado entonces por qué se la pasan todos con 'eso' colgando al\naire libre! ¡Si insisten en eso, imbéciles, díganme de algún otro lugar donde\nhayan tantas de esas 'cosas' colgando libremente por allí!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahora que lo mencionas... No se me ocurre ningún otro lugar.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_ked_000211",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero los baños públicos no son solo para hombres, así que me parece que no son\ncompletamente aprobatorios de los pen*s... Está la sección de mujeres\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_wtd_000037",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Esa es la conspiración! ¡Escúchame, Kei! ¡Fui engañado por eso!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_a09_01",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000069",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No es ninguna conspiración! ¡Al ex-jefe le prohibieron la entrada a cualquier\notro lugar excepto por el baño de hombres y las calderas por haber tratado de\nespiar el baño de mujeres!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_ked_000212",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué~? Senpai, ¡¿trataste de mirar a hurtadillas?! ¡Eres de lo peor!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_wtd_000038",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Para nada! ¡¿Espiar?! ¡Eso es para mujercitas! ¡Yo no hice eso! ¡¿Sabes lo que\nhice?! ¡Yo traté de entrar con todo orgullo y honor directamente al baño de\nmujeres!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es suficiente para que te impidan la entrada. Hay que ver la suerte que\ntuviste de que no te despidieran, eh...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_wtd_000039",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todo se debe a mi humano magnetismo innato.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000070",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Fue porque yo me disculpé! ¡Senpai idiota!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_wtd_000040",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ya veo! ¡Pero qué buen trabajo hiciste, eh, Toritani! ¡Te lo agradezco! ¡Bien,\ntengo otras cosas que hacer, así que me iré ya!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_a09_02",sync=0,face=1,time=400,path=":ev/ev_com_a09/",set="ev_com_a09",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000071",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No dejaré que huyas a ninguna parte.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja, listo, te tengo.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",file="se3130",id=1},
{"bg",file="zev_com_a09_02",zoom=60,x=190,y=100,speed=300,time=0,z2=50,path=":ev/ev_com_a09/",set="ev_com_a09",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000041",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Uwaah! ¡¿Qué haces, Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te tengo agarrado.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_wtd_000042",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque no siento nada justo ni correcto en lo que dices. Y además, si llego a\napoyarte es probable que la actual jefa del club de arte, Toritani, me\nasesine.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="zev_com_a09_06",sync=0,face=1,time=400,zoom=60,path=":ev/ev_com_a09/",set="ev_com_a09",ax=1920,ay=1080,bx=-960,by=-540,x=190,y=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000072",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sabia elección, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000043",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Tch, ¿a fin de cuenta terminas doblándote ante la ley, Kusanagi?! Quién diría\nque el Kusanagi que sirvió de mis pies y brazos cuando yo era el jefe del\nclub terminaría siendo mi enemigo. ¿Eso significa que ya no eres el Kusanagi\nde aquel entonces?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nunca he sido ni tus pies ni tus brazos, ni una sola vez. Y en primer lugar, yo\nni siquiera soy miembro del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_wtd_000044",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Ahh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya varias veces tú y Toritani me mantuvieron cautivo allí, pero nunca he\naccedido a unirme al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_wtd_000045",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Entonces por qué trabajaste tanto por mí? ¿Será que quedaste cautivado por mi\nmagnetismo innato y carisma masculino?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="zev_com_a09_03",sync=0,face=1,time=400,zoom=60,path=":ev/ev_com_a09/",set="ev_com_a09",ax=1920,ay=1080,bx=-960,by=-540,x=190,y=100},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿podrías dejarme darle una paliza a esto cuando lo amarremos? Tengo\nlas dos manos ocupadas en este momento.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000046",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿P O R Q U É ?!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="zev_com_a09_06",sync=0,face=1,time=400,zoom=60,path=":ev/ev_com_a09/",set="ev_com_a09",ax=1920,ay=1080,bx=-960,by=-540,x=190,y=100},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000073",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, Akashi-senpai, ya nadie va a ponerse de tu lado. Ríndete.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_wtd_000047",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuu, y eso que pensé resolverlo todo pacíficamente...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pacíficamente?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="zev_com_a09_01",sync=0,face=1,time=400,zoom=60,path=":ev/ev_com_a09/",set="ev_com_a09",ax=1920,ay=1080,bx=-960,by=-540,x=190,y=100},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000074",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ten cuidado, Kusanagi! ¡Akashi-senpai planea hacer algo!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo? ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"se",id=1,file="se1319"},
{"bg",file="ev_com_a09_07",time=300,path=":ev/ev_com_a09/",set="ev_com_a09"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwaah! ¿Qué rayos es esto?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000075",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿H-Humo?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_wtd_000048",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kukuku... Si hubieran mantenido las bocas cerradas y me hubieran dejado ir,\ntodo hubiera terminado sin haber lastimado a nadie...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Sin lastimar a nadie?! ¡¿Pero qué mierda planeas hacer, imbécil?!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000049",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Esto haré.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"se",file="se3356",id=1},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwaah!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000076",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Espera, detente ahí!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="man_wtd_000050",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ujajajajaja! ¡Hasta luego, muchachos Yama Yamamoto de Yamato!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",rule=105,time=200,file="white",path=":bg/"},
{"bgm",stop=1,time=500},
{"se",id=1,file="se1176_s"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000077",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"mwact",act="あくび",time=400},
{"text"},
text={
vo={
{"vo",file="man_wtd_000051",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¡Achúúúú!!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_com_a09_08",path=":ev/ev_com_a09/",set="ev_com_a09"},
{"text"},
text={
vo={
{"vo",file="man_ked_000213",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Naoya, no te preocupes! ¡Yo detuve la explosión!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="man_wtd_000052",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿E-Explosión?...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_ked_000214",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿No viste la cantidad de humo que el senpai estaba soltando?! Seguramente\nplaneaba detonarse a sí mismo.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000078",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Una explosión?... Pero por más que lo vea solo se trata de una bengala...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei... No va mucho al caso, pero ¿podrías cerrar el agua que sale de esa\nmanguera?... El piso está inundándose.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_ked_000215",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
