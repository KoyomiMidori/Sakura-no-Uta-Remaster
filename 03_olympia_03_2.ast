astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="zbluesky_winter",speed=240000,rule="083r",sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=1},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"Comenzamos a caminar la vía hacia el colegio.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El viento de otoño es agradable.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás de poco a poco, pero cada vez son más los días de frescor...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Ya el verano se acabó por completo, eh...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Y, mientras observaba con todo placer el cielo a la vez que pensaba eso...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"En ese instante, me di cuenta.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Observo a Rin.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Rin me ve y muestra una sonrisa. Debe haberse dado cuenta también.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"La incomodidad de hace un rato estaba ya desapareciendo.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Estamos volviendo a los mismos dos de siempre.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_sud_000312",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nada, simplemente te lo agradezco, Sui!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"fgact",ch="吹",act="icon",y=-450,lv=4,id=5,icon="icon12z1",x=50},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000313",ch="sud"},
},
ja={
{
name={"Sui"},
"“Uh... No pongas tus manos sobre mi cabeza mientras me agradeces. Sinceramente,\nse me hace desagradable.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001605",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, vamos, Sui-chan. Sus sentimientos de agradecimiento contigo no son\nmentira.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000314",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001606",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Gracias a la conversación tipo guión de comedia slapstick de Sui, pudimos\nrelajar nuestra tensión por completo...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000315",ch="sud"},
},
ja={
{
name={"Sui"},
"“Y bien, a fin de cuentas, Rin-san, ¿podría considerar que eres una esposa a\ndomicilio?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Buh!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001607",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja... no, te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000316",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es así? Pero, resumiendo la explicación de hace un rato, todas las mañanas vas\na buscar a Kusanagi-san, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001608",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad, es que no lo hago todos los días. Hoy fue la primera vez.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000317",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero lo harás de nuevo mañana, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001609",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, si Kusanagi-kun me lo permite, podría hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000318",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Te doy permiso! Sui te otorga permiso.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esp--! ¡¿Pero por qué andas tú dando ese permiso?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000319",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿No se lo permitirás entonces?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es cuestión de darle permiso o no. No hay ningún hombre que le moleste que\nsu amiga de la infancia le venga a buscar todas las mañanas...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000320",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Sí? ¡Pues, ya acabas de escuchar, Rin!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001610",ch="rnd"},
},
ja={
{
name={"Rin"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"msgoff"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="稟",speed=300,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"se",file="se3130",id=1},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0022",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"ex",time=100,func="wait"},
{"fg",mode=-2},
{"bg",id=9,lv=9,file="black",path=":bg/"},
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000321",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Nyyyooohh! ¿Q-Qué está pasandoooo?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Rin abraza de repente a Sui.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001611",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sui-chan, gracias, gracias, gracias, gracias!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_sud_000322",ch="sud"},
},
ja={
{
name={"Sui"},
"“Rin ha perdido todas las tuercas. Está ahora manoseando y desordenando mi ropa\ny mi cabello tanto como Kusanagi-san lo haceee～”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que manoseando, parece estar abrazándote, ¿no?... Y por eso es que la ropa\ny el cabello de Rin también se desordenó ahora.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="吹",size="z1",my=40,mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0022",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",my=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001612",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Jaa?! ¡L-Lo siento tanto!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000323",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ah, no, no es para tanto. No sé a que viene esto, pero no hay problema con que\nlo hagas, Rin. Aunque, quisiera que lo hicieras de forma más mesurada...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001613",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... lo siento, por todo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, puedes venir en las mañanas, pero solo si de verdad no tienes problema\nen hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001614",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. Si no te es molestia, iré tanto como quieras, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no lo es! Tonta.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000324",ch="sud"},
},
ja={
{
name={"Sui"},
"“Nada de lo que hagas representa una molestia para Kusanagi-san, Rin. Tienes la\ngarantía de Sui.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué demonios sirve tu garantía?...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000325",ch="sud"},
},
ja={
{
name={"Sui"},
"“Las garantías de Sui son garantías de calidad con el mismo nivel de los sellos\nde la Mond* Selection.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué mi forma de sentirme al respecto tiene que tener una garantía de\ncalidad al nivel de la Mond* Selection!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000326",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sea lo que sea, has recibido mi garantía. Qué bien, ¿verdad, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué me das palmadas en los hombros con esa cara triunfante?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000327",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Porque con esto se ha probado que Rin es tu esposa a domicilio!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se ha probado nada! Y además, no entiendes nada de lo que verdaderamente es\nuna esposa a domicilio, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000328",ch="sud"},
},
ja={
{
name={"Sui"},
"“Una esposa que va a atender a su marido a la casa. No hay ninguna equivocación\nen esto.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha... Sui... En primer lugar, comencemos por el hecho de que Rin no es mi\nesposa...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001615",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O-Oigan, ¿podríamos dejar este tema ya?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001616",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estamos atrayendo con bastante fuerza, las miradas de todas las personas\npasando por aquí...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Los estudiantes que van en su camino al colegio estaban observándonos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"No es de sorprenderse. De escucharse la palabra 'esposa a domicilio' viniendo\nde un grupo de chicos y chicas en uniforme, a cualquiera le llamaría la\natención.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Y más aún si consideramos el nivel de atención que he recibido últimamente...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Ciertamente, ya esta conversación llego a su fin...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000329",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Admites haber perdido?!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000330",ch="sud"},
},
ja={
{
name={"Sui"},
"“Terminaste la conversación por haber sido refutado. En pocas palabras, Sui ha\nganado.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no, demonios!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001617",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, déjemos esto así, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Incluso los oficinistas que van camino a trabajar están observándonos\nfijamente.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Sí... quizás alcé demasiado la voz...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Aunque Rin estuvo mostrando una sonrisa aquejada todo el rato, ante la\nconversación entre Sui y yo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Sui estuvo de excelente humor, de comienzo a fin.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Bueh, supongo que estas idas al colegio no están nada mal, eh...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Comenzamos a llegar a la misma colina de siempre.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"La colina Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuaaah... Pero qué buen clima hace, eh.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001618",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De verdad que sí.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La falta de sueño me tiene adormilado...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0015",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000331",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eres todo un debilucho. Se nota a leguas tu falta de espíritu.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es... soy un debilucho bueno para nada.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000332",ch="sud"},
},
ja={
{
name={"Sui"},
"“Esa clase de cosas no se deben admitir tan fácilmente. Más fuerza, más\nespíritu. ¡El estudio el deber y la vida del estudiante! Vamos, con energía y\nbuenos ánimos al colegio.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería bien espeluznante que hubiera un estudiante así...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001619",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No creo que lo sea tanto, aunque tal vez sí sea raro ver a alguien ir al\ncolegio con tanta energía de tan temprano.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Aunque a mi parecer, tú siempre asistes al colegio con bastante\nenergía desde temprano.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001620",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no. Yo también soy muy débil ante las mañanas.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Me parece que siempre andas con energía en las mañanas.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0019",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001621",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, es... por eso...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Rin trató de decir algo, pero a mitad de frase, cerró su boca.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? ¿No estuviste a punto de decir algo?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001622",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no... no era nada...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000333",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues, es difícil evitar que el corazón se entusiasme de poder ir al colegio con\nla persona que te gusta.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"fgact",ch="稟",act="icon",lv=4,id=6,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001623",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Esp--, S-Sui-chan!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000334",ch="sud"},
},
ja={
{
name={"Sui"},
"“Así que, Kusanagi-san, así sea a la fuerza, debes sacar ánimo y energías de\ndonde no tengas.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué, debería hacer eso?...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_ked_001038",ch="ked"},
},
ja={
{
name={"???"},
"“Donde yo esté, 100 veces alegría habrá, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al revés... la centésima fracción de una unidad de alegría.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="吹",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0019",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_001039",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, no te pongas penosito~ Sabes que me quieres y te mueres por mí.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh, siento que algo me está drenando la energía de forma violenta... No pude\npegar un sueño tampoco anoche, será que me regreso a casa ya...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001624",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No puedes hacer eso. Vayamos con alegría y energía.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si tú tampoco has dormido nada...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
