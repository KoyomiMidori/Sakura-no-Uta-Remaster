ja={
{
name={"Yuumi"},
"“Sí, la censura es fuerte y eso es frustrante, pero las historias son muy\nbuenas, así que sirven igual para jalársela.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0014",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"fgact",ch="里奈",act="icon",lv=4,id=6,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rna_000719",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Jalársela? ¡¿Qué significa eso?!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=-345,lv=4,id=10},
{"fgact",ch="優美",act="いいえ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=10},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_yum_000809",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No. No es nada. ¡En fin, váyamos ya, Rina! ¡A un lugar mejor que un manga\nerótico! ¡A nuestro sensual paraíso yuri-yuri!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000720",ch="rna"},
},
ja={
{
name={"Rina"},
"“L-La verdad es que se me han quitado casi todas las ganas de ir...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se va a empezar a poner el sol si siguen en eso. Ya estamos en otoño, los días\nse acaban rápido.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000721",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tienes razón... Bien, preparemos todo rápido entonces.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=-345,lv=4,id=10},
{"fgact",ch="優美",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_000810",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Sí, vayamos a nuestro jardín yuri, donde nuestras vag*nas florecerán!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0014",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000722",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¡¿Vas a salir ahora con palabras censuradas?!! ¡T-Te advierto que no pienso ir\na ese lugar!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=-345,lv=4,id=10},
{"fgact",ch="優美",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_yum_000811",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo era una broma. Una broma que de poder, me encantaría con toda mi alma\nconvertir en realidad, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="icon",lv=4,id=6,icon="icon12z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rna_000723",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uuuhh... ¿Por qué habré elegido de mejor amiga a esta muchacha?...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"se",file="se1279",id=1},
{"fg",ch="優美",mx=40,mode=-1,lv=4,id=10,sync=0},
{"fg",ch="里奈",mx=40,mode=-1,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Y mientras seguían con la misma discusión que tienen todos los días, ambas se\nfueron.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Quedamos solo yo, y Thomas, quien estaba ahora desmayado sobre el suelo...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo con Thomas... De verdad que esto no me gusta nada...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="トーマス",size="z1",my=40,mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_tmd_000119",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES. WATASHI TACHI NO HANAZONOOOooo...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0008",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000120",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡¡TRANSFORM!!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"se",file="se3130",id=1},
{"fg",ch="トーマス",my=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿¡¿EEEHHHH?!?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",x=-80,y=-810,zoom=120,file="zbg049a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="トーマス",size="z2",mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0100",face="a0002",head="tho_z2a",y=190,lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=300},
{"fgact",ch="トーマス",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000121",ch="tmd"},
},
ja={
{
name={"Thomas"},
"*gasagasagasa*...",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",file="se9031",id=1},
{"fg",ch="トーマス",mx=1280,mode=-1,lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿¡¿HIIIIIIIIiiiiiiiiiii?!?!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"se",file="se1279",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"No sé que rayos hizo, pero al parecer Thomas se transformó, y comenzó a raptar\npor el piso arrastrando las piernas y los pies, doblados de una forma que no\nparecía propia de un humano.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Y se veía completamente idéntico a... 'eso'.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué rayos, fue eso?...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Quedé yo solo...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por los momentos...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Le confisco los trajes de maid que al parecer planea usar con fines\ninescrupulosos en la búsqueda de nuevos integrantes del año que viene.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se disuelven con agua, así que no debe ser nada difícil deshacerme de ellos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Acabemos rápidamente con la semilla del mal... Con tal de evitar una tragedia\nel año que viene...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
