astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"se",id=1,file="se2308"},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001627",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay nadie...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Rin entró a la sala de arte mientras yo estaba solo, leyendo un manga.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Hasta hace poco estaban también Hikawa y Kawachino, pero salieron rápido\na pintar afuera. Y por cierto, Thomas fue tras ellas...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001628",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, ¿a esas dos?... Espero que Thomas-san no termine con ninguna herida...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada de qué preocuparse, supongo. La forma en que su cuerpo está hecha\nes bien rara, así que seguramente podrá aguantar la ráfaga de ataques de\nKawachino.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001629",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí?... ¿Qué hay de Kei-kun y Mako-chan?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei se fue de una vez a casa. Probablemente esté encerrado en el atelier. Por\nlo general, cuando va en serio con alguna obra se encierra allí.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001630",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y Mako-chan?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. En la Exposición Moore no hay ninguna categoría de alfarería, así que\nno tengo idea alguna de lo que está haciendo.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001631",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Realmente no hay nadie...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que a partir de ahora verás esto más a menudo. Cuando cada uno se\nconcentra en su obra se dispersan por completo. Además, la temática de la\nobra difiere entre cada uno.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001632",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo... En fin, yo también debería esforzarme un poco...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. ¿Qué piensas hacer hoy?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001633",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aún sigo practicando con dibujos del cuerpo humano.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, para el nivel que tienes, es mejor seguir dibujando varias cosas a\ntratar de concentrarte en una sola obra. Esa fue una sabia decisión.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001634",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Y, terminé un dibujo anoche después de volver a casa, así que quisiera que\nlo vieras, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Seguiste dibujando después de eso?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001635",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y gracias a eso no pude dormir casi. Estaba un poco inquieta y no lograba\ndormir, así que pude avanzar con los dibujos. Aunque, no mucho con los\nestudios...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"La verdad, juraba que no había dormido bien por pasarse toda la noche\nmasturbándose, pero pensándolo bien, eso es imposible. Rin no es como yo, no\nhay forma de que haga eso.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Creo que me imaginé cosas muy absurdas...",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abro el bloc de dibujos de Rin.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001636",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué te parece?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, están bien, pero... son puros dibujos de hombres, puedo ver.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001637",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, s-sí...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh... esto...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"De cierta forma, por algún lado, se parece a mí, pero...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001638",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ajajaja. S-Se parecen, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se parece a mí... creo. No, más bien soy yo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001639",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, sí. Mi objeto de dibujo eras tú, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedo entender en parte eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"En la colección de fotos para dibujar habían muchos otros modelos distintos a\nmí. No tenía por qué usarme a mí...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001640",ch="rnd"},
},
ja={
{
name={"Rin"},
"“V-Vamos, así está bien. E-En fin, no logro entender aún la parte de las manos.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las manos... sí, las manos son complicadas...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001641",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, por ejemplo, acá... Se supone que se dobla a partir de esta parte, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Rin me muestra su mano, mientras dobla la articulación metacarpofalangeal de su\ndedo.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ahí estás equivocada. Los principiantes suelen pensar siempre eso. Esa\nparte se llama el 'ligamento metacarpiano transverso superficial'.\nCiertamente, al observar la zona interior de la mano, el dedo pareciera\ndoblar desde esa línea, pero en realidad, la articulación metacarpofalangeal\nes...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Mientras explico eso, toco mi propia mano.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El dedo dobla debajo del ligamento metacarpiano. En pocas palabras, no debes\ndibujar los dedos doblándose desde la base, sino desde la parte superior de\nla palma de la mano.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001642",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Este es el ligamento metacarpiano?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, es acá.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"bg",file="ev_com_c05_01",path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
ja={
{
"Sin pensarlo, agarré y apreté la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001643",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, eh, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Retraigo mi mano.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001644",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tienes por qué disculparte. No tiene nada de raro que toques mi mano al\nenseñarme a dibujar manos...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tal vez, pero...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001645",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si los quiromantes se preocuparan por eso, no serían capaces de leer la mano de\nsus clientes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Sí, tienes la razón, pero...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Probablemente hace unas cuantas semanas, o no, por lo menos hace unos días,\npude haberlo asumido de esa forma.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Sin embargo, ya no puedo marcar esa distinción.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"En el pasado, desde aquel día, decidí tomar distancia de Rin, por su bien.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Y seguí haciéndolo después de reencontrarnos. Por como veo las cosas, siento\nque estuve cuidando de no sentir nada más por ella que se apartara de lo que\nes una 'amiga de la infancia'.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Y es que, que Rin y yo avancemos a una relación más allá de la actual,\nimplicaría que en algún momento surgirá un problema que no podremos evitar,\nde ninguna manera...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y por eso, estuve tomando cuidado.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Sin embargo, ahora como estoy, no soy capaz de apretar la mano de Rin con\nserenidad. No creo poder hacerlo...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Aun así.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",mode=-2},
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"bg",file="ev_com_c05_01",path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001646",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Aprieto la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, escucha con atención. Solo lo diré una vez.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001647",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para comenzar, los huesos de la mano――”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Finjo calma, actúo inmutable, como si nada pasara, y aprieto la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Palpo cada uno de los rincones de sus dedos y le enseño la estructura muscular\nde sus dedos, de manera de explicarle también la estructura de la mano.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Quizás por los nervios, es que forcé mucho la boca.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Será por eso entonces, que...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001648",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... se te rompió el labio...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Al lamer mis labios, siento el sabor de la sangre.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001649",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Toma, pañuelo... E-Esto, ¿te molesta si te limpio yo?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por favor, y disculpa.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001650",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Puedo, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_c05_02",path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
ja={
{
"Después de vacilar por un instante, Rin extendió su mano hacia mis labios.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La sensación de sus dedos a través del pañuelo acaricia mis labios.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001651",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="zev_com_c05_02",x=-410,y=-540,time=500,path=":ev/ev_com_c05/",set="ev_com_c05",ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Su otra mano la tenía apretada yo.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Durante todo ese rato, estuvimos agarrados de las manos.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_c05_02",time=500,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
ja={
{
"Un atardecer, con el cielo de otoño afuera.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Los rojos rayos del sol del atardecer entran por la ventana e iluminan a Rin.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"A pesar de que ya no es verano, las manos de los dos estaban totalmente\nhúmedas.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Pero aun así, ninguno de los dos soltó al otro.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Rin termina de limpiar mis labios.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001652",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si sigo frotando mucho el pañuelo, haré que tus labios se agrieten más...\n¿Q-Quieres que te ponga algo de bálsamo labial?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Bálsamo labial? Ahh, eso que usan para proteger los labios de la resequedad...\nLa verdad es que no me gustan mucho.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001653",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me lo imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_c05_01",sync=0,face=1,time=400,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
ja={
{
"Rin enrolla el pañuelo, luciendo algo desilusionada. No, también luce estar\nalgo más tranquila también...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Pero.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás no esté de más echarme de vez en cuando...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001654",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? S-Sí, así es. Estoy segura que se te rompieron los labios por tenerlos\nsecos...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Paso mis dedos por los músculos de su mano.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Se supone que era para enseñarle...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Pero, nuestros dedos estaban ahora tocándose entre sí.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Solo juntamos y enredamos nuestros dedos, mientras nos observamos...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_c05_03",sync=0,face=1,time=400,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001655",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-Te recomiendo este bálsamo... Es nuevo, así que no hay problema en que lo\nuses, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, de ser así, tendré que seguir usándolo hasta que se acabe.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001656",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pero qué dices? Acabo de comprarlo, así que no te lo daré, Nao-kun. Lo seguiré\nusando yo...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001657",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ¿podría aplicártelo yo?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sinceramente no creo poder acostumbrarme a los bálsamos labiales...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_com_c05_01",sync=0,face=1,time=400,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001658",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad?... Entonces, yo...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por favor...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001659",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_c05_04",sync=0,face=1,time=400,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"text"},
text={
ja={
{
"Al decir eso, Rin comenzó a aplicar bálsamo labial sobre mis labios resecos.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001660",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Solo la respiración de los dos resuena en este silencioso salón.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Como si ese fuera el único sonido ocupando este espacio iluminado por el sol\ndel atardecer.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001661",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001683",ch="mkd"},
},
ja={
{
name={"???"},
"“Qué pesado, qué pesado está esto... Vamos, muévete.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_tmd_000122_n",ch="tmd"},
},
ja={
{
name={"???"},
"“OHHH, NOOO.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",file="ev_com_c05_05",sync=0,face=1,time=400,path=":ev/ev_com_c05/",set="ev_com_c05"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mmm?!",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001662",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mx=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"se",id=1,file="se2308"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001684",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Oh? No hay nadie.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000123",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OHHH, NOOO, esto está pesado, DESU.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001685",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, pero qué chillón. Lo único que estuviste haciendo fue estorbar a Rina y a\nYuumi. Vamos, deja eso rápido y volvamos.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_tmd_000124",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Hay que ir de nuevo al horno? No me gusta ir allá, tía, hace bastante calor.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0005",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001686",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cállate y sígueme. El próximo terminará de cocerse en 2 horas.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000125",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OHHH, NOOO.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",mode=-2},
{"bg",file="ev_uni_c39_01",path=":ev/ev_uni_c39/",set="ev_uni_c39"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001663",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por qué será...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Por alguna razón, nos escondimos inmediatamente dentro de uno de los\ncasilleros.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"No sabemos por qué lo hicimos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"No estábamos haciendo nada indebido, y además, suponiendo que no fuera bueno\nestar agarrados de la mano, pudiéramos habernos soltado, y ya.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Sin embargo, no hicimos eso, y terminamos por escondernos dentro de uno de los\ncasilleros de artículos de limpieza que había cerca.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Por qué hicimos eso...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Es absurdo tratar de buscar una razón...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001664",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que ambos se irán después de dejar las piezas de cerámica...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de no haber nadie, es probable que lo hagan...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001665",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Si, no hay... nadie?...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Rin me ve.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Aún estamos agarrados de la mano.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Y es que, aún agarrados de las manos, la jalé para entrar a este casillero.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no hay nadie... se irán, ¿no crees?...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001666",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"Dentro de ese pequeño y angosto casillero.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Aparte de la sensación de nuestras manos agarradas, puedo sentir también el\ncalor de Rin.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001667",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Solo puedo escuchar la respiración y los latidos de Rin.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"No puedo ver muy bien la cara de Rin por lo oscuro que está, pero... gracias a\nla poca luz que entra, puedo darme cuenta de que sus ojos están humedecidos.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"En el momento en que observé esa brillante capa sobre sus ojos.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"――",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"¿Qué demonios estoy pensando?",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Al darme cuenta, estaba ahora abrazando a Rin por los hombros en plena\noscuridad, y la hice voltear hacia mí.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001668",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿N-Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"La relación entre Rin y yo estuvo truncada durante un largo tiempo.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Sin embargo, basta con que un solo engranaje vuelva a moverse, para que todo se\ndesborde afuera, como si del agua de una represa destruida se tratara.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Los borrosos sentimientos que tuve de niño, eran algo sin forma, ambiguos y\nconfusos.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Sin embargo, ya no es así.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Mis sentimientos por ella se vinieron convirtiendo en algo concreto, con forma.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001669",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te sucede algo? Me duele que me aprietes los hombros tan fuerte...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"La sensación del ahora caliente cuerpo de Rin se transmitía por la palma de mi\nmano.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"se",id=1,file="rn_kiss"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001670",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se1085_s"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0007",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"bgm",file="bgm103"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001671",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Q-Qué acabas de hacer, Nao-kun?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No pude controlarme...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001672",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿P-Por eso te pregunto que--”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te... besé.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001673",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Rin sostiene sus labios, completamente sonrojada.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Al recorrer con los ojos la sala de arte, ya no había nadie.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Ya Toritani y Thomas deben haber regresado al horno.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001674",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿M-Me... me besaste?...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0019",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001675",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué malo eres...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sé que fue de repente... pero, Rin, yo--”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0021",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001676",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No se trata de eso! ¡Ese fue mi primer beso!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo sé, lo sé, pero, Rin, yo--”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0021",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001677",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Por qué lo haces de repente a oscuras?! ¡¡¿Por qué el beso con el Nao- kun\nque tanto me gusta tiene que terminar de esa forma, de repente, como si fuera\nun ataque sorpresa?!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001678",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Qué cruel eres! ¡No pude disfrutarlo ni un poco! ¡Ni siquiera me di cuenta, o\nmás bien ni siquiera supe que lo habías hecho!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Ese es el problema?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001679",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Qué cruel eres diciéndolo de esa forma! ¡Para mí es un enorme problema!\n¡Acabo, acabo de besarme contigo, Nao-kun! Y aun así, no pude sentirlo en lo\nmás mínimo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, nos besamos...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001680",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Pero no lo sentí para nada!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, entonces... Rin...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001681",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abrazo a Rin por los hombros... Su cuerpo se encoge.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001682",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Sin embargo, Rin cierra lentamente sus ojos, sin ofrecer nada de resistencia.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Acerco mi cara lentamente a la suya.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Alcanzo la distancia en la que puedo sentir el aliento de Rin.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"El beso de hace un momento fue solo durante un instante, así que nos perdimos\nde muchas sensaciones.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"En medio del resplandeciente sol del atardecer, los dos nos besamos.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="rn_kiss"},
{"text"},
text={
ja={
{
"Nuestro segundo beso.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Pero, quizás, nuestro verdadero beso.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Este seguramente es el beso que marcará el inicio para nosotros dos.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0014j",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001683",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Wawawah, nos besamos.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque este es el segundo...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001684",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Un... beso...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001685",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001686",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Los besos son siempre así de cortos?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no lo sé muy bien, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001687",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se terminan tan rápido. Tus labios se alejan sin siquiera poder saber bien cómo\nse sienten...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“También hay besos largos...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001688",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solicito uno.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solicitar... eh...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="rn_kiss"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001689",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... mm...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Le doy un beso más largo que el anterior.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Aunque, solo un poco más largo.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tal? ¿Pudiste sentir mis labios esta vez?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001690",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... ya sé cómo se sienten...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0025",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001687",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Qué se supone que andan haciendo?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001691",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bgm",file="bgm031"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001688",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios, quizás tuvieron suerte de que Thomas no estuviera, pero aun así...\n¡Tengan más precaución la próxima!”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001692",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001689",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh... qué ajetreo, qué ajetreo...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿N-Nos habrá visto?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001693",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Creo que sí...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="eveningsky_summer",id=1,lv=1,sync=1,path=":cg/"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001694",ch="rnd"},
},
ja={
{
name={"Rin y Naoya"},
"“KYAAAAAAH.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=300,func="wait"},
{"bg",file="nightsky_spring",time=1500,id=2,lv=2,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
"Ese día, empacamos nuestras cosas rápidamente y regresamos sin dirigirnos una\nsola palabra.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Ya había pasado un muy buen tiempo desde que terminaron las clases, así que no\nhabía ya nadie acechando para emboscarme.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Aunque, por otro lado... me besé con Rin, eh...",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Estaba ahora en mi habitación, solo, sentado como un idiota.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Ya pasaron unas cuantas horas desde que sucedió eso, pero fue a partir de la\nnoche que mi cabeza comenzó a operar de nuevo con normalidad.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"se",id=1,file="se1531"},
{"text"},
text={
ja={
{
"Los rugidos de mi estómago me regresaron a la cordura.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, de verdad que no tengo remedio alguno...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"¿Tomar distancia de ella? Idiota...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"msgoff"},
{"bg",file="ev_com_a13_01",path=":ev/ev_com_a13/",set="ev_com_a13",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"En ese instante.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Probablemente, desde el instante en que estuve a solas con Rin, ya tenía el\nleve presentimiento de que las cosas terminarían así.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Y por eso, decidí ignorarla al principio.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Creí que aun así, de alguna forma podría haber frenado mis sentimientos,\npero... ¿Desde cuándo comenzó esto...?",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Ya no podía contener más mis sentimientos por Rin.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por los momentos, debería echarle una llamada a los Natsume...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Terminé regresando a mi apartamento inconscientemente.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Pero, esa fue la mejor opción. Si me hubiera quedado a solas con Rin hasta\nllegar a Kootoha, probablemente hubiera acabado besándola a la fuerza de\nnuevo.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"msgoff"},
{"se",file="se1343",id=1,sync=1},
{"se",file="se3434",id=2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, hola――”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Llamo por el teléfono a la casa Natsume.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Ai atiende el teléfono. Al avisarle que aún estoy en mi casa, esta me dice que\nordenarán comida de restaurante.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Le dije que dentro de poco regresaría a la casa Natsume.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Pero, Ai――",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_aid_000616",ch="aid"},
},
ja={
{
name={"Ai"},
"“No tienes que forzar tanto las cosas y regresar tan rápido. Ese apartamento es\ntu casa también, no lo olvides...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Me dijo eso.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"¿Será que se dio cuenta de algo?... No, espera, no me conviene mucho que lo\nhaga.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Por ahora, parece que también ordenó comida para mí.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"se",id=1,file="gatya"},
{"msgoff"},
{"bg",file="znightsky_spring",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así, tendré que prepararme para asumir toda la responsabilidad...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Probablemente las cosas terminen así.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Debo estar preparado para asumir toda la responsabilidad que esto conllevará.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Protegeré a Rin hasta el final. Y esta vez lo haré de verdad, pase lo que pase.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuuh...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, entonces...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Debemos ponernos el uno frente al otro...",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg027c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Antes de regresar a la casa de los Natsume, me paro en ese lugar.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú... ¿Estás de nuevo mirando?...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"bgm",file="bgm035"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000335",ch="sud"},
},
ja={
{
name={"Sui"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"De cierta manera, me pareció que estaría acá.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Un presentimiento, que se remonta al momento en que ella pintó sobre ese mural.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Me parece que estuve ocultando ese presentimiento dentro de mí todo este\ntiempo.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000336",ch="sud"},
},
ja={
{
name={"Sui"},
"“Estoy buscando algo...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso lo sé. ¿Qué estás buscando?”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000337",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo sé...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún sin saber qué debes buscar... ¿estás buscando?...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000338",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí... Aunque, al observar este lugar... siento que debo buscar algo...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al observar este lugar...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"El sitio de construcción a oscuras.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Como siempre, está rodeado por paredes de acero, y es casi imposible observar\nhacia adentro...",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres infiltrarte adentro?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0001",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",size=5,time=400,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Sui"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Sui mueve la cabeza a los lados, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000339",ch="sud"},
},
ja={
{
name={"Sui"},
"“Probablemente, no es acá...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te quedas viendo este lugar entonces?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000340",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Quizás, tal vez, por ser el primer lugar de todos?...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El primer lugar de todos...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0001",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000341",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. Todo comenzó acá... No, se podría decir que todo también terminó en este\nlugar...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comenzó, y terminó acá...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Hasta hace poco esto era solo un terreno desocupado.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Y a pesar de haberlo sido todo este tiempo, cuando menos me lo imaginé, la obra\nde construcción comenzó.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una búsqueda, de algo que no puedes recordar...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000342",ch="sud"},
},
ja={
{
name={"Sui"},
"“Lo cual significa que, tal vez... es una búsqueda sin mucha importancia...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000343",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Sui me observa.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Con una mirada distinta a la de siempre.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Como si sus ojos fueran――",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Claro, ahora que lo recuerdo, su nombre era――",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000344",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué sucede? ¿Por qué me observas tanto?... ¿Te has prendado de Sui?”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000345",ch="sud"},
},
ja={
{
name={"Sui"},
"“Me lo imaginaba... Buena respuesta.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Sui sonríe.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Sus aires alrededor son las de una adulta.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"A pesar de ser usualmente tan infantil...",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con buena respuesta?...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000346",ch="sud"},
},
ja={
{
name={"Sui"},
"“Una buena respuesta es una buena respuesta. Puedes pensar en ella como ese tipo\nde respuesta que hace feliz a los demás...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000347",ch="sud"},
},
ja={
{
name={"Sui"},
"“Kusanagi-san, ¿estás enamorado de Rin?”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buh--, ¿pero a qué diablos viene eso de repente?”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000348",ch="sud"},
},
ja={
{
name={"Sui"},
"“No me parece tan de repente. Sui debió haber insinuando eso durante todo el día\nde hoy.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Ciertamente, pero...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0001",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000349",ch="sud"},
},
ja={
{
name={"Sui"},
"“Aunque, supongo que esa fue una pregunta estúpida... Sui recordó un poco de\nalgo...”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Recordaste un poco de algo? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000350",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso es――”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso es?”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000351",ch="sud"},
},
ja={
{
name={"Sui"},
"“Un secreto.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Sui suelta una suave sonrisa.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"Una sonrisa, que jamás había mostrado antes...",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000352",ch="sud"},
},
ja={
{
name={"Sui"},
"“Muy bien, entonces... Sui se irá ya.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000353",ch="sud"},
},
ja={
{
name={"Sui"},
"“De permanecer tanto tiempo a estas altas horas de la noche junto a esta clase\nde bestia, la castidad de Sui estará en peligro.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A quién te refieres con bestia?...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000354",ch="sud"},
},
ja={
{
name={"Sui"},
"“De aquí, y ahora en adelante... ¿Estás dispuesto a emprender la búsqueda junto\na nosotras?”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"No dijo yo... sino 'nosotras'...",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"Eso solo puede significar una sola cosa.",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. La verdad es que no tengo ni ganas de meterme en eso... pero, en lo\nque respecta a Rin...”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000355",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es eso algo bueno?”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, no me parece que lo sea mucho, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000356",ch="sud"},
},
ja={
{
name={"Sui"},
"“Yo tampoco lo sé. Así que, tal vez por eso... es que no puedo recordar...”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A lo mejor...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000357",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es posible que aquello que olvidé, lo olvidé por tratarse de algo que debía ser\nolvidado...”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000358",ch="sud"},
},
ja={
{
name={"Sui"},
"“Como sí, aquello que está oculto ahora, hubiera sido oculto para evitar ser\nexpuesto ante los ojos de las personas...”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero a fin de cuentas, esa cosa oculta es importante, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ser importante, es que se ocultó...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000359",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, tienes razón. Si no fuera importante, se hubiera podido desechar, después\nde todo...”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, algo olvidado, de lo que no se pudo prescindir. Probablemente lo que busco\nes... algo importante.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000360",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=9},
{"se",file="se1135",id=1},
{"text"},
text={
ja={
{
"Sui echa a correr.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"Como si fuera a volar――",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"Sui lució, de repente, como una adulta.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"Sin embargo, no sentí eso tan fuera de lugar.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, ya había visto a Sui así antes...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"La primera vez que Sui vio a Rin, por encima de las escaleras.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"Tenía esos mismos aires de adultez que ahora.",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_szd_000507",ch="szd"},
},
ja={
{
name={"???"},
"“¿Vas a buscar?...”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"se",file="se9004",id=1},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah... Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0300",face="d0002",head="shz_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000508",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vine a buscarte.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai no me dijo ni una sola palabra respecto a que vendría alguien a buscarme.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000509",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, vine por decisión propia.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? ¿Había algo que te causaba curiosidad?”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000510",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué pretendes haciéndote el tonto ahora?...”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes toda la razón. Esa pregunta fue muy estúpida.”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí, ya me estaba oliendo algo raro. Tratándose de ti, seguramente sabes\nmás que yo, supongo...”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000511",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quién sabe...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es así, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000512",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso solo fue lo que tú decidiste. Así que, resulten como resulten las cosas,\nseguiré obedeciéndote.”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos quieres decir con obedecerme?...”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000513",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Se supone que así era la promesa.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso solo fue una propuesta arbitraria de tu parte...”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000514",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin es también una amiga muy preciada para mí. Dependiendo del caso, quizás\nincluso más que tú, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo supuse...”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0310",face="a0017",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000515",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nada de suponer. No interpretes las cosas a tu conveniencia.”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos dices?...”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000516",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Reitero que solo es 'dependiendo del caso'. Aún a pesar de eso, me parece que\nseguiré de tu lado...”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso me alegraría...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000517",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuu, lo dices con tanta simpleza...”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000518",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues sí, ¿quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000519",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin. Esta vez tienes la intención de cargar con todo tú solo, me imagino...”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... quisiera que me dejaras hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0017",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000520",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... No quiero.”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000521",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La verdad es que no quiero hacerlo... pero, no puedo oponerme a tus órdenes...\nY es que, así lo prometí...”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije, esa promesa la hiciste tú sola y sin mi consentimiento, es idea\ntuya...”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0017",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000522",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De cierta manera, eres una persona terriblemente cruel, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000523",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esa es tu crueldad...”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000524",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres demasiado amable...”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000525",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué tanto sufrimiento me hubiese ahorrado si de verdad no lo fueras...”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0310",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000526",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Padre e hijo, pueden morir condenados y maldecidos. No me importaría.”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás Kenichiro, pero... ¿yo también?”",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0010",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000527",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, por igual. Los dos son demasiado iguales...”",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000528",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya, Kuzu no volverá a aparecer ante ti.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000529",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000530",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que, regresemos ya. No todos los días tenemos comida de restaurante, hay\nque aprovechar antes de que se enfríe.”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que no has comido aún?”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000531",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, yo tampoco he comido. Y, creo que todos los demás están esperando por ti\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes también son demasiado amables...”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0016",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000532",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez. Vamos, vayamos a casa.”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000533",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque sea por hoy, regresemos a la casa de los Natsume, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="znightsky_spring",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Shizuku sonrió cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
"Mi crueldad es ser tan amable. Eso dijo Shizuku.",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
ja={
{
"Aunque eso va para todos ustedes también.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
"Hay veces que la amabilidad de todos ustedes me pone a sufrir tremendamente...",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
"Ai, Kei, Shizuku, Kenichiro Kusanagi, Kotoko Natsume... y Mamá. Mizuna\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
ja={
{
"Esa extraña y curiosa relación fue el producto de la amabilidad y bondad de\ntodos. Un algo inestable, y desequilibrado.",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
"Y sin embargo, Ai sigue aún tratando de proteger eso.",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
"Por eso, es que yo también――",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
