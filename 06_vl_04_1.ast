astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"bg",file="bg042a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",file="se0110",id=1,loop=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fwaaah, qué pereza tener clases a primera hora.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Subo la colina de Yumenouki con tal pereza que hasta un estudiante quedaría\navergonzado. Al llegar, alguien me llama gritando.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000248",ch="skr"},
},
ja={
{
name={"???"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",file="se0744",id=2},
{"text"},
text={
ja={
{
"Veo a Sakizaki-kun corriendo desde el colegio, con una terrible expresión en su\ncara.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"¿Qué ha pasado? ¿La hice enfadar de nuevo?\nO eso pensé, pero... A medida que se acercaba, la expresión en su rostro me\nhizo saber que no se trataba de eso.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Parecía estar a punto de estallar en lágrimas.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... ¿Sucede algo, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Sakizaki-kun llega y me jala de la mano, gritando.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"msgoff"},
{"fg",ch="桜子",size="z2",mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0200",face="a0009",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"se",file="se9019",id=2},
{"ex",time=200,func="wait"},
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0006",head="sku_z2b",lv=5,id=9},
{"ex",time=200,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000249",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Que si sucede algo?! ¡Ha sucedido algo terrible!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo terrible?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000250",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Debe venir a la iglesia!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fgact",ch="桜子",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000251",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Algo horrible ha pasado con el mural! ¡Con 'Las huellas de los cerezos'!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las huellas de los cerezos?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"¿Algo pasó con el mural? ¿Hoy en día, que nadie se inmuta a pararse para darle\nun vistazo?...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",stop=1,id=1,time=500},
{"se",file="se0744",id=2},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Por los momentos corrí a la iglesia, jalado de la mano por Sakizaki-kun.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
"Y llego al lugar de los hechos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué demonios pasó acá?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"se",file="se2340",id=1},
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zev_uni_c24_01",x=960,path=":ev/ev_uni_c24/",set="ev_uni_c24",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"bg",file="zev_uni_c64_01",x=960,time=1500,path=":ev/ev_uni_c64/",set="ev_uni_c64",ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=500,func="wait"},
{"bg",file="zev_uni_c64_01",zoom=50,x=0,speed=5000,time=0,z2=100,path=":ev/ev_uni_c64/",set="ev_uni_c64",x2=960,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm025"},
{"text"},
text={
ja={
{
"Una gran cantidad de pintura había sido esparcida sobre el mural. Se veía\nborrosa, como si la hubiesen extendido con una tabla o algo así.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_skr_000252",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Mire cómo lo han rayado!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rayado...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_uni_c64_01",sync=0,face=1,time=400,path=":ev/ev_uni_c64/",set="ev_uni_c64"},
{"text"},
text={
ja={
{
"No. No se trata de simples rayones.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Examino con cuidado al ahora cambiado mural.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No son solo rayones...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_skr_000253",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? Pero... si lo han rayado todo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Sí, parecían ser solo rayones.\nAsí de torpe lucía ese diseño.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Pero no eran solo rayones.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"La obra fue modificada, con un cierto contexto en mente.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"El tronco que Akashi había pintado también fue modificado.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La forma en que extendieron la pintura se asemeja a la de Gerhard Richter...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Además de eso, los cerezos tenían ahora un estilo cibernético, agregadas como\nsi fuese un dibujo de manga.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sakizaki-kun, esto... no es lo que parece.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_skr_000254",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Qué es entonces?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Hay un movimiento artístico que se basa en esta temática.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Arte moderno...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kys_000006",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡Ah! ¡Profesor Kusanagi! ¿Qué significa esto? ¡¿Otra de sus fechorías?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Vinieron corriendo varios profesores de la sala de profesores, quejándose.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_kys_000007",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡¿Que no?!\n¡Usted es el único capaz de hacer esta clase de cosas!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Los profesores me rodean. Es como si aquel día se estuviese repitiendo.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000255",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡El profesor Kusanagi no sería capaz de hacer esto! ¡Esto es vandalismo, es un\ncrimen!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_kys_000008",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Vandalismo? ¿Esto?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0006",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000256",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Acaso no lo ve? ¡Está lleno de rayones!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_kys_000009",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Rayones, eh...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"La reacción de los profesores ante las enfurecidas palabras de Sakizaki-kun\nfue débil.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_kys_000010",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Pues para gente sin conocimiento artístico como nosotros, el primer mural\ntambién fue una especie de graffiti.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000257",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿P-Pero qué está diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_kys_000011",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Pues, ante nuestros ojos es lo mismo.\nEs más, ¿cómo era que se llamaba este\nmural?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_kys_000012",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Ese es. Pasó lo mismo que cuando tú y tu club de arte pintaron esa cosa. Apenas\nllegué en la mañana me encuentro con el muro pintado... Lo mismo que ese día.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“....”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_kys_000013",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Profesor Kusanagi, ¿de verdad esta no ha sido otra de tus fechorías?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000258",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Qué barbaridades dice usted? ¿Por qué lo acusa a él?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_kys_000014",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Quizá no lo sepas, Sakizaki-kun, pero el día en que pintaron ese mural fue todo\nun desastre. Incluso se llamó a la policía por daño a la propiedad...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_skr_000259",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero yo escuché que este mural fue herencia de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_kys_000015",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Consecuentemente resultó así, sí.\nPero para nosotros, los profesores, fue simplemente vandalismo. Lo de ese día fue todo un alboroto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000260",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Consecuentemente? ¿A qué se refiere? Yo escuché que el colegio aprobó la obra.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. El profesor tiene toda la razón respecto al incidente.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_kys_000016",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Además, ¿Kenichiro Kusanagi?... Por más que me argumentes lo de su herencia,\nese nombre ya casi no se escucha.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0006",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000261",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿P-Pero de qué habla?! ¡E-Eso no es verdad! ¡Kenichiro Kusanagi sigue siendo\nun artista famoso!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_kys_000017",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Ah, sí? Pues no sé, aunque este mural ha perdido ya toda su popularidad.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_kys_000018",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Por ahí han estado pidiendo que regresen la pared a su estado original.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000262",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Y quién exactamente ha estado pidiendo eso?!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_kys_000019",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Yo no sé, son rumores.\nLa iglesia la usan en los días de descanso para matrimonios. ¿No habrán sido algunos de esos clientes?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000263",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No he escuchado de eso por ningún lado!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_kys_000020",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Y por qué una estudiante como tú tendría que enterarse de eso?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000264",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Se equivoca. En los panfletos de la ciudad aparece como lugar turístico. La\ngente lo conoce, estoy segura.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_kys_000021",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Sucede que siguen utilizando los mismos panfletos desde hace años.\nEn ese entonces sí era popular. El profesor Kusanagi también recibió atención por ser el hijo del famoso Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_kys_000022",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Pero a nadie hoy en día le interesa la obra culminada por el hijo de Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000265",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿C-Cómo se atreve?!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="man_kys_000023",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Sabes algo? Recuerdo muy bien que en tu club de arte estaba también Rin\nMisakura, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Asiento, sin mediar palabra alguna.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_kys_000024",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Debo decir que la directora no ha tenido buen ojo para el arte.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_kys_000025",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Si hubiese sido Rin Misakura y no usted quien dirigiera esa obra, profesor\nKusanagi, todo sería distinto ahora...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_kys_000026",ch="kys"},
},
ja={
{
name={"Profesor"},
"“No me importa si eres hijo de un artista de fama internacional. Pero la verdad\nes que al colegio no le sirve de nada una obra hecha por un simple profesor\nde tiempo parcial como tú.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000266",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿C-Cómo se atreve a decir eso?! Hay cosas que no se deben――”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Detengo a Sakizaki-kun.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Sakizaki-kun espera con cuidado por las palabras que irían a salir de mi boca.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Probablemente espera furia de mi parte.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Coincido con usted, profesor. Si esa obra estuviese bajo el nombre de Rin\nMisakura, todo sería diferente.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_kys_000027",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Eso es lo que digo. Todo un adulto ya, eh. Qué bueno que lo entiendas.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo gracias a su orientación y a la de los demás profesores.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000267",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, tranquila.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Fuerzo una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Las expresiones faciales de Sakizaki-kun se congelan al ver esa cara mía.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0006",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000268",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pare ya con eso, profesor! ¡Esto es vandalismo, daño a la propiedad!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_kys_000028",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Sí, tal vez, pero es necesario investigar primero.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0005",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000269",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pues entonces hay que llamar a la policía!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Detengo una vez más a Sakizaki-kun, y giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llamar a entes externos al colegio no es un asunto así de simple.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y en particular en este caso donde el culpable podría ser alumno de esta\ninstitución.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000270",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pero--!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kys_000029",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Sea lo que sea, este incidente se tratará una vez recibamos la opinión de la\ndirectora y la directiva.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_kys_000030",ch="kys"},
},
ja={
{
name={"Profesor"},
"“No es algo que se pueda decidir de una vez y con tanta ligereza...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde se encuentra la directora?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="man_kys_000031",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Está resolviendo asuntos afuera. No creo que regrese hoy.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_uni_c64_01",path=":ev/ev_uni_c64/",set="ev_uni_c64"},
{"text"},
text={
ja={
{
"Observo una vez más el mural rayado.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"La pintura esparcida daba la impresión de que algo horrible emanaba de los\ncerezos.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Luego estaba el tronco, ahora con un estilo cibernético.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"El tronco, emanando dicha horrible sustancia, ya no era un tronco natural, sino\nalgo artificial.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Los pétalos que en la obra original habían sido representados con las huellas\nde los niños estaban ahora emanando algo repulsivo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Cerezos mecánicos. Un árbol de cerezos que emanaba veneno.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Al fondo se podía ver, si bien un tanto borroso, la imagen de las casas que se\nvieron tras el gran terremoto.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El arte es provocación, eh...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"La obra donde las huellas de los niños se convertían en cerezos esparciéndose,\nera ahora una donde los cerezos esparcían una sustancia tóxica.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Era una provocación simplona.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Una representación que no podría describir de alguna otra forma más que\ninfantil.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Y sin embargo, esta representación infantil y agresiva es considerada como lo\ndebido para un género en particular.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Arte moderno...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"La historia del arte no es solo de los artistas.Alrededor del artista pululan\ntoda clase de personas.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Vendedores, curadores, críticos.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Aun suponiendo que en la actualidad el arte esté muerto, no es una opción\nviable tratarlo como tal.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Las máximas autoridades del mundo artístico no lo permitirían.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Así muriese el arte, la industria artística de hoy en día tendría que apoyarse\nen ese cadáver.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"No solo el arte. Se puede decir lo mismo de la literatura, e incluso de la\ncomposición musical.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"En el arte occidental hay muchas obras oponiéndose a la (salón) autoridad.\nSobre todo después del surgimiento del impresionismo.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Los pintores impresionistas de Francia no lograban ser reconocidos por dicha\nautoridad, y por eso muchos de sus cuadros terminaron en Estados Unidos.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Por esa razón el Museo Metropolitano de Arte y el Instituto de Arte de Chicago\nposeen tantos cuadros impresionistas que nada tienen que envidiarle a\nFrancia.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Desde el nacimiento del impresionismo, el arte ha seguido siendo sensacional, y\nagresivo contra la autoridad.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Pero innovar con nuevas representaciones artísticas se ha vuelto cada vez más\ndifícil.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Es poca la tierra que queda por arar donde todos los genios han dejado su\nhuella.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Todos lo saben.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"No existe ningún arte revolucionario.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Es fácil encontrar un caso similar en la música clásica.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Se dice que una vez, un amigo del famoso compositor del siglo XX, Schoenberg,\nle pregunto '¿Por qué compones únicamente música repleta de disonancias, tan\npoco delicada al oído?', y este respondió...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"'Yo también quisiera escribir con consonancia. Pero la historia me ha prohibido\nescribir música con acordes.'",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Dicho genio intentó patalear en el punto límite de la historia musical\noccidental cambiando la propia base musical con el dodecafonismo.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Schoenberg, al establecer su teoría, mencionó lo siguiente.'Con esto se\nasegurará la hegemonía de la música alemana por otros cien años.'",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Ya podrán saber que su teoría no llegó a convertirse en algo universal para la\ncomposición musical.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Y menos aun llegó a garantizarse la hegemonía de la música alemana. Después de\nél vino el jazz y el rock, representados por africanos y anglosajones, los\ncuales dejaron un mayor impacto.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Lo que nosotros creadores consideramos como 'innovador' no deja de ser más que\nun cadáver cubierto en huellas.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Sin embargo, la industria no puede vivir en ese estado.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"No habría problema si fuese una industria cualquiera. Pero se trata de la\nmajestuosa industria cultural del arte.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Y aunque eso 'innovador' en realidad carezca de sustancia, la industria debe\nasumir su misión cultural y sobrevivir.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"La Exposición Moore funciona también bajo esa premisa, manejada por una gran\ncantidad de inversionistas.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Algo nuevo, innovador, y alborotador.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Cosas nuevas, estilos nuevos. La industria del arte busca eso.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"De ahí que el arte llegó a pararse sobre un mundo invertido.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Si haces algo que nadie ha hecho, eso es arte.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"No una obra nueva, simplemente algo jamas antes hecho. Algo provocador.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Y en dicho circulo vicioso, lo infantil funciona.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Poniéndolo de forma optimista, 'niño' es sinónimo de destrucción, y de creación\nde lo nuevo.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Aunque, la gran mayoría de los 'niños' son solo adultos sin educación.Lo\npeligroso, lo insensato se convierte en arte.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"El arte moderno, como vanguardia del género, toma eso como algo positivo.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Actos sensacionales, ocurrencias, basadas en situaciones recientes.Tienes a\nproveedores que venden eso, y un mercado sin ética alguna, especulador.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="ev_com_i09_01",path=":ev/ev_com_i09/",set="ev_com_i09",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"'Esto tendría más valor si Rin Misakura lo hubiese dirigido', dijo el profesor.\nY tiene la razón.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"El arte moderno solo podría sobrevivir de eso.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Supongamos que la famosa Rin Misakura hubiese materializado el diseño del\ndifunto Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Solo eso bastaría para que el valor de esta obra se multiplicara.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Así fuese la misma obra, si la historia tras su creación cambia, su valor\ntambién.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Así funciona el arte.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000271",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No lo puedo creer! ¡No estoy de acuerdo con esto!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_kys_000032",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿No estás de acuerdo? Pues no puedo hacer mucho al respecto por una simple\nalumna, Sakizaki-kun.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El profesor tiene razón, Sakizaki-kun. Para ya.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000272",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero para mí esto que está pasando no es justo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, ya basta.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-500,speed=15000,file="zbg057a",path=":bg/",y2=-540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="香奈",size="z2",speed=15000,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0000",face="a0002",head="kan_z2a",y2=-304,y=-260,lv=5,id=9,sync=0},
{"bg",id=9,lv=9,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_knd_000802",ch="knd"},
},
ja={
{
name={"???"},
"“¿Puedo asumir que no hay problema alguno, entonces?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién ere--?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"cgdel",id=9,lv=5,time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_mym_000001",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Uhm, todo lo acordé con ellos.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kys_000033",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿C-Consejero Murayama?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000803",ch="knd"},
},
ja={
{
name={"Kana"},
"“La directora no se encontraba, así que le expliqué la situación al consejero\nMurayama.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_kys_000034",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Podría saber a qué se refiere?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_mym_000002",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Estoy pensando en coordinar todo para que esta obra sea aceptada.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_kys_000035",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿O-Obra? ¿Habla usted de este graffiti?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_mym_000003",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡Nada de graffiti! ¡Esto es una obra, hecha y derecha!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_mym_000004",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ellos son del grupo artístico Bourbagi. Tienen una extensa actividad artística\nde obras imprevistas. Aunque no niego que ese exceso les ha ganado\nmalentendidos...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000804",ch="knd"},
},
ja={
{
name={"Kana"},
"“Nosotros somos los responsables de esta obra. Tomamos la cotidianidad previa al\ngran terremoto descrita por el señor Kusanagi y la adaptamos a nuestra\ncotidianidad actual.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000805",ch="knd"},
},
ja={
{
name={"Kana"},
"“Su nombre es 'Cerezos, huellas en cenizas'. Nos parece que es una obra adecuada\na nuestra realidad.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_kys_000036",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Pero, consejero Murayama, se requiere también la autorización de la directora,\nademás de la directiva...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_mym_000005",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“No te preocupes, de eso me encargaré. En particular, estoy seguro que al\ndirector Inoue del hospital general de Yumihari le gustará esto.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"¿Del hospital general?",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_mym_000006",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Esta obra, en sus inicios, fue sensacional, y llamó mucho la atención. Pero el\nseñor Kusanagi es ya un artista del pasado, según los estándares actuales del\narte.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000806",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. No dudo de la grandeza del señor Kusanagi. Pero nuestra generación ha\nsurgido, y la batuta la lleva ahora Rin Misakura, quien también perteneció a\neste colegio.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_knd_000807",ch="knd"},
},
ja={
{
name={"Kana"},
"“El arte siempre debe ser moderno e innovador.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="man_mym_000007",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ya ella lo dijo todo. Habrán algunos de la directiva que se opondrán, pero ya\ntenemos un precedente con esta iglesia. 'Las huellas de los cerezos'...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Teniendo dicho precedente, quizá acepten esta vez también...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_mym_000008",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Tú eres?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000808",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es el hijo de Kenichiro Kusanagi, Naoya Kusanagi. Trabaja como profesor acá.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="man_mym_000009",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ah, perdóname la insolencia. No sabía que el hijo del señor Kusanagi trabajaba\nen nuestro colegio.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se preocupe. De igual manera yo renuncié a su herencia, y no poseo ningún\nderecho legal sobre 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="man_mym_000010",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“De igual forma imagino que no estarás muy complacido de que hayan tocado la\nobra de tu padre.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, si le soy sincero...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kys_000037",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡P-Profesor Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, no tengo nada que decir al respecto...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",mode=-2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000273",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_mym_000011",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Pues sí. No tienes autoridad alguna para objetar algo al respecto.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Así es.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000274",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",mode=-2},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, Nagayama, ¿a esto te referías con superar a Kenichiro Kusanagi?...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000809",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Lo tienes enfrente.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A esto le llamas superar a Kenichiro Kusanagi? Si te consideras al menos una\nartista de segunda debes conocer la diferencia de habilidad que hay entre él\ny tú, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000810",ch="knd"},
},
ja={
{
name={"Kana"},
"“Conozco bien esa diferencia. Pero no se trata de eso.\nNosotros matamos al fantasma. En ese sentido lo superamos.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Matar al fantasma?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000811",ch="knd"},
},
ja={
{
name={"Kana"},
"“Kenichiro Kusanagi causó un boom artístico en este país, sí. Pero ya no está, y\na pesar de eso su influencia sigue fuerte.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000812",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y a mi parecer, el mundo artístico japonés no debería seguir moviéndose junto a\nun fantasma del pasado.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000813",ch="knd"},
},
ja={
{
name={"Kana"},
"“Esta obra no busca superar su genialidad.\nBusca más bien darle la estocada final al fantasma que él representa, y de ahí superarlo.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Escucho la argumentación de Nagayama en silencio.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Contraargumentos tengo, y bastantes.Pero en mi posición actual no tengo\nautoridad alguna para decir algo.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",mode=-2},
{"fgf",frame="frame_1p",bg="black",cg=":cg/tho04",cgx=-100,cgy=-300,disp="出右",bgpx=":bg/",cgbx=-960,cgby=-540,mode=3},
{"text"},
text={
vo={
{"vo",file="man_tmd_000126",ch="tmd"},
},
ja={
{
name={"???"},
"“Hey, YOU, ¿te quedaste sin palabras, AH?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Apareció un hombre de alta estatura.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"msgoff"},
{"fgf",frame="frame_1p",disp="消",time=300,mode=-1},
{"ex",time=300,func="wait"},
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mx=-40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0000",face="a0009",head="tho_z1a",lv=4,id=9},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Thomas...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0001",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000127",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YESSS, Thomas aquí. Tiempo sin vernos, Naoya Kusanagi.\n¿Todavía pudriéndote acá?\nEn mi caso ha ocurrido todo lo contrario, DESU.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="man_mym_000012",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ah, sí, esté que está aca es Thomas-kun, egresado de Yumihari. ¿Lo ven? Es el\ngrupo de arte ideal para esta obra.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, veo que no has cambiado nada, Thomas.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="ジャンプ",time=500,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000128",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿AHHH? ¿No tienes nada en las cuencas de tus ojos? ¡Yo CHOUUU cambié! ¡Cambié\nbastante, DESU!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú? ¿Cambiaste?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0009",head="tho_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うんうん",time=400,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000129",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Yo, ahora soy super MOTE con las mujeres!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mote? ¿Popular con las mujeres?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0002",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うんうん",time=380,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000130",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YESSS. Como as del arte moderno cada día y cada semana me como a las nenas que\nse agolpan alrededor de mis senpais del arte. ¡Todos los días son de sexo,\nsexo, y dinero! ¡DESU!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0009",head="tho_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000131",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡No vayas a creer que soy el mismo debilucho de entonces!\nFufufu, ¿te entró miedito?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué debería temer?...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="quake",size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000132",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Tu rastreador de Ki está dañado, idiota.\n¡El MOTE es el poder supremo!\n¡Y mi poder ahora es tanto que podría destruir el mismo mundo, DESU!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Si es por eso, las idols, los cantantes de visual kei o los host triunfarían en\ndeportes de lucha...",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0009",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000133",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Y qué hay de YOU? ¿Mucho MOTE? ¿Mucho sexo?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, lamentablemente no he tenido tanta suerte como tú. Todo muy normal.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0004",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000134",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Normal? ¿Qué es normal? ¿Con cuántas chicas lo has hecho DESU KA?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y eso qué importa?...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="いいえ",size=10,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うなづく",size=10,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000135",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Claro que IMPORTA! ¡Hombre que no lo haya hecho con más de 10 nenas es virgen!\n¡Tú, contesta! ¡¿Con cuántas lo has hecho?! ¡Si no contestas, SHINE!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",mode=-2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000275",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No sea tan irrespetuoso! ¡El profesor no es como usted! ¡Él es una persona con\nvalores!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000136",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH, NO, pero miren que tenemos acá una colegiala, ¡UHAH! ¿SIGNATURE? ¿Quieres\nmi SIGNATURE?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0006",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000276",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No quiero nada de usted! ¡Y deje de insultar de esa manera al profesor!”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"se",file="se9010",id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Después de decir eso, Sakizaki-kun se escondió detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000137",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿P-Por qué te escondes detrás de Kusanagi?\n¿Jaa? E-Espera, ¿acaso YOU estás en una relación de mete y saca con esta nena?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000277",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"se",file="se3130",vol=70,id=1},
{"fg",mode=-2},
{"bg",speed=200,sync=0,file="zbg057a",path=":bg/",x2=390,y2=-310,x=590,y=-310,ax=1920,ay=1080,bx=-960,by=-540},
{"fg",ch="桜子",size="z2",speed=200,sync=0,mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008",head="sku_z2b",x=-500,lv=5,id=9},
{"fg",ch="トーマス",size="z2",speed=200,sync=0,mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0000",face="a0004",head="tho_z2a",x=500,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Sakizaki-kun intentó darle una cachetada a Thomas, pero este tomó su brazo.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fgact",ch="桜子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000278",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡A-Auch!...",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0009",head="tho_z2a",x=500,lv=5,id=6},
{"fgact",ch="トーマス",act="縦揺れ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000138",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“La violencia esta mal, mal, DESU. La comunicación debe hacerse en base a\nmasajes y no golpes, DESU. ¡Tocarnos es la mejor práctica para comunicarnos,\nDESU!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0009",head="sku_z2b",x=-500,lv=5,id=9},
{"fgact",ch="桜子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000279",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No, s-suélteme.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Thomas, para ya!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0007",head="tho_z2a",x=500,lv=5,id=6},
{"fgact",ch="トーマス",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000139",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Jaa? ¿Dijiste algo, verga flácida?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0009",head="tho_z2a",x=500,lv=5,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="縦揺れ",lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_tmd_000140",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Te conviene más estar conmigo que con ese imbécil. ¡Vamos, A COPULAR JUNTOS!”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fgact",ch="桜子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000280",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡S-Suélteme!”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fgact",ch="トーマス",act="うんうん",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000141",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Este verga flácida se volvió un completo idiota después de que un pendejo\nllamado Kei Natsume murió. Vamos, déjalo y ven con--”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Mi cabeza se quedó en blanco apenas escuché el nombre de Kei.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Alzo mi puño, y--",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"msgoff"},
{"fg",ch="桜子",mode=-1,lv=5,id=9},
{"fg",ch="トーマス",size="z2",mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0004",head="tho_z2a",x=500,lv=5,id=6},
{"fg",ch="トーマス",mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0004",head="tho_z2a",x2=500,x=0,lv=5,id=6},
{"fg",ch="トーマス",speed=150,mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0004",head="tho_z2a",y2="0,10",x=0,y=0,lv=5,id=6},
{"se",file="se9010",id=1},
{"ex",time=100,func="wait"},
{"se",stop=1,id=1,time=500},
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=100,func="wait"},
{"quake"},
{"se",id=2,file="se3462"},
{"bg",file="閃光大",id=1,lv=1,rule=105,time=100,sync=1,path=":cg/battle/",set="battle"},
{"bg",time=50,rule=105,sync=1,file="white",path=":bg/"},
{"ex",time=600,func="wait"},
{"bg",file="bluesky_winter",id=2,lv=2,time=1500,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"¿El cielo? Por alguna razón me pareció ver el cielo. Y al siguiente instante...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"se",id=1,file="se_zushaa"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guh!”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Algo me mandó volando por el aire, y caí.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0000",face="a0001",head="tho_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Thomas... Imbécil...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="man_tmd_000142",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Fuh, ¡ninguno de tus golpes va a llegarme, verga flácida!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="縦揺れ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_tmd_000143",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Renoir se volvió un maestro de maestros gracias a los pechos.\n¡Y yo, yo he ganado fuerza sobrehumana gracias al sexo!\n¡Los puños de un mediocre como tú jamás podrían alcanzarme, DESHO!”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0001",head="tho_z1a",lv=4,id=6},
{"fgact",ch="トーマス",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うなづく",lv=4,id=6},
},
vl02={
{"fgact",ch="トーマス",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_tmd_000144",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Sexo! ¡Dinero! ¡Violencia!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0002",head="tho_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_tmd_000145",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Mi mano derecha existe para conseguir todo eso...\nMi nombre es Thomas, fufufu.\n¿Ahora sí tienes miedo?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_knd_000814",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué andas diciendo? Te estabas muriendo del miedo antes de verlo... Ya te\nhabía dicho que con tu contextura solo necesitabas mover los brazos para\nganarle.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0005",head="tho_z1a",lv=4,id=6},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000146",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Te equivocas! ¡Este es el poder del MOTE! ¡Los hombres populares son CHIGAU!”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",mode=-2},
{"fg",ch="桜子",size="z2",mx=-40,mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008",head="sku_z2b",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_skr_000281",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Sakizaki-kun corre hacia mí.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0006",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000282",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesores, eso fue un acto de agresión!”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="man_kys_000038",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¿Acaso no fue el profesor Kusanagi quien alzó primero la mano?”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0007",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000283",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="man_mym_000013",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Pues yo diría que eso fue defensa propia...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000284",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡P-Pero el profesor intentó ayudarme!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pasa nada.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Tch, eso dolió.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Me limpio la sangre de la boca e intento ponerme de pie.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000285",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Fue gracias a que Sakizaki-kun me sostuvo que no me caí.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="man_tmd_000147",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Qué débil te has vuelto... Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="man_tmd_000148",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Verga flácida!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000286",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor, vayamos a la enfermería...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, estoy bie-- ¡Kuh!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000287",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Comienzo a caminar, intentando marcharme a un lugar donde pudiese estar solo.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Pero Sakizaki-kun me sigue.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me sigas...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000288",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No voy a dejarlo solo! ¡Pueden haberle causado hemorragia interna!”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Me dispongo a caminar...",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="man_mym_000014",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Qué acaba de pasar?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="man_kys_000039",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Ah, perdónelo, por favor, es todavía joven. En ciertos aspectos no difiere de\nun estudiante...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="man_mym_000015",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Hmph, ¿ese muchacho es profesor a tiempo parcial?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="man_kys_000040",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="man_mym_000016",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ya son las fechas de cambio de personal, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="man_kys_000041",ch="kys"},
},
ja={
{
name={"Profesor"},
"“A-Así es. Estamos en plena fecha de selección.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="man_mym_000017",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Hay bastante que considerar respecto a personal de ese estilo, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="man_kys_000042",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡Concuerdo con usted!”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000815",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="man_tmd_000149",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Pasa algo, Kana? ¿Por qué esa cara?...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000816",ch="knd"},
},
ja={
{
name={"Kana"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="man_tmd_000150",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Pena por él?”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000817",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="man_tmd_000151",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“A pesar de todo reconoces su habilidad, ¿DESHO?”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000818",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000819",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Solo yo, Thomas?\nBien. Consejero Murayama, ¿le importa si discutimos ahora\nnuestros próximos planes?”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="man_mym_000018",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Sí, vamos.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0001",head="tho_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000152",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Fuh, cómo le cuesta decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0006",head="tho_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000153",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Aunque bueno, habiendo tenido a ese verga flácida enfrente, no la culpo...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
