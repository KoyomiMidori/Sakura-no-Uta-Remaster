astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c04_01",path=":ev/ev_eye_c04/",set="ev_eye_c04"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024a",path=":bg/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm024"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, así que este es tu apartamento.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001190",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, no parece el lugar donde viviría una chica sola, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No hay problemas en lo que a seguridad respecta? Hay muchos peligros\ninvolucrados con que una muchacha joven viva sola, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001191",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay problema por eso. Un familiar mío es quien administra estos\napartamentos. Todo el piso de abajo es la casa del casero. Así que más que un\napartamento, es como una pensión, supongo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Lo cual quiere decir, que las circunstancias no se prestan para que ocurran\ncosas raras.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Aunque, de igual manera...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Igualmente estoy entrando a la habitación de una chica. No puedo evitar vacilar\nun poco.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001192",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,time=500,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001193",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, adelante, adelante.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, con permiso...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Atravieso la delgada puerta.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"cgdel",id=-1},
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"La habitación de Rin era tan monótona y simple, que no parecía una habitación\nnormal para una chica de su edad.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001194",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, es monótono el lugar, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, se parece a la habitación de Shizuku, así que no me causa tanta\nsorpresa...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001195",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tengo mesa para té tampoco. Considerando a los visitantes, tendré que\nconseguir una para la próxima...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, realmente no hace falta en mi caso.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Rin prepara el té y se sienta.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001196",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun, puedes sentarte también.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"bg",file="ev_com_c02_01",path=":ev/ev_com_c02/",set="ev_com_c02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Después de ver en dirección a Rin, aparté rápidamente mi vista.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001197",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Umuh, viviendo con los Natsume, no es nada raro verme envuelto en la situación\nde estar solo con una chica bajo el mismo techo, pero...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Quizás sí sería bueno tener una mesa para el té...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001198",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, esta vez tuvimos que poner el té en el suelo. Lo siento. Para la próxima\nconseguiré una.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"No es por eso.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Esta situación en la que estamos ahora, sentados de rodillas el uno frente al\notro, es...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"(Por lo general siempre la veo nada más en uniforme, eh...)",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"(Aunque, por otro lado...)",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"msgoff"},
{"bg",file="zev_com_c02_01",zoom=80,x=400,y=-320,time=0,speed=2000,z2=50,path=":ev/ev_com_c02/",set="ev_com_c02",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=2000,func="wait"},
{"se",file="se9010",id=1},
{"bg",file="zev_com_c02_01",zoom=50,x=0,y=0,time=0,speed=200,z2=80,path=":ev/ev_com_c02/",set="ev_com_c02",x2=400,y2=-320,ax=1920,ay=1080,bx=-960,by=-540},
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡No!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_c02_02",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001199",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, n-no, no es nada. Ehm... vives sola entonces, Rin.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001200",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es. Tal como lo puedes ver.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¿Pero qué estoy diciendo? Eso lo sabía ya desde hace un buen rato.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, ¿y tu padre?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_c02_03",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001201",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... ¿Mi padre?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"La hasta ahora alegre expresión de Rin se ensombreció bastante.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001202",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, conoces por lo menos cómo es mi papa de cara, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues, sí... Tu padre estaba también en Yumihari, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001203",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, vivimos separados.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001204",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aun cuando es el único que queda de mis padres... Realmente soy muy insensible,\n¿verdad? Dejando solo a mi padre...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, las cosas tampoco son así. Mi papá también estaba solo todo el tiempo. O\nbueno, en su caso debería decir más bien que me dejó solo a mí.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001205",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero Kenichiro Kusanagi-san y Mizuna Kusanagi-san se amaron, ¿no? Escuché que\nambos se unieron tras un fuerte romance...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en el caso de esos dos, ya nada más su primer encuentro comenzó de una\nmanera un tanto descabellada...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001206",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001207",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será que yo amo a mi padre?... ¿O... será que aún lo odio?...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Rin susurra eso, sin dirigir esa duda a nadie en particular.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Esa expresión no parecía estar negando la posibilidad de 'odiar' a su padre...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_c02_02",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001208",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, l-lo siento. ¿P-Pero qué estoy diciendo?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, bueno, sé que tú también has pasado por varias cosas...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001209",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Perdóname...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, está bien. Vale entonces, ¿comenzamos con la práctica de dibujo?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_c02_01",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001210",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Me da algo de pena con Rin, pero gracias a la conversación que acabamos de\ntener, logré calmarme un poco.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"O eso pensé, pero...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Lo que tengo frente a los ojos no ha cambiado en lo absoluto...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Y aún habiéndome calmado un poco, de verdad que no encuentro dónde posar mis\nojos.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_c02_04",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Um... Supongo que ya habrás entendido cómo funciona buena parte de la\nestructura anatómica del cuerpo con el mapa anatómico que te di, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001211",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, bueno... ¿tal vez?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún no logras aprenderla?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001212",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, teóricamente la entiendo, pero de acuerdo con lo que has dicho, solo eso no\nbasta, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, no se le puede tachar de útil a la teoría que no se puede usar en la\npráctica. Estamos buscando entender la anatomía del cuerpo humano con el fin\nde poder dibujar.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001213",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Mientras decía eso, Rin abre el mapa anatómico.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_c02_06",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001214",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tocar mi propio cuerpo mientras observo el mapa anatómico...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Rin hojea el mapa anatómico del cuerpo humano mientras toca y revisa los\nmúsculos de su propio brazo.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"(Tocar el cuerpo de uno mientras se observa el mapa anatómico)",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"(En este caso, el género no importa. Y es que tanto mujeres como hombres no\ntienen mucha diferencia en su estructura corporal)",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"(Lo importante es 'tocar mientras se ve')",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"(El acto de 'tocar mientras se ve' consiste en adaptar la información del tacto\na la vista)",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"(Para poder dibujar el cuerpo humano, no hay necesidad de aprenderse los\nnombres y los tipos de cada uno de los huesos y músculos. Eso le concierne a\nlos terapeutas y los médicos)",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"(Sin embargo, es necesario entender de qué manera los músculos sostienen a los\nhuesos y a partir de qué forma de estiramiento logran ejercer trabajo y\nmovimiento)",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"(Al tocar, se puede entender cómo se mueven los músculos. En pocas palabras, es\nposible convertir dentro de nuestros cerebros la estructura corporal médica\nobservada en los planos de disección en un objeto dinámico y con movimiento)",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"(Esta habilidad es sumamente importante para poder alcanzar un alto nivel de\ndiseño y dibujo)",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"(Por más que se vea algo superficialmente y se mueva el lápiz para dibujar, de\nno entender las funciones y propiedades que posee el objeto que vemos, el\ndiseño resultante será bastante frágil)",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"(El balance general, incluyendo contorno, así como el sombreado expresado por\nel lápiz. Esa clase de detalles son ciertamente importantes, pero percibir\nlos huesos, músculos e incluso la propia distribución de la grasa como\nmecanismos de movimiento del cuerpo es importante también)",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Eso fue todo lo que le expliqué a Rin.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Aunque a fin de cuentas, todo es un refrito de lo que Kenichiro Kusanagi decía.\nEs el método que me impartió cuando yo era un niño.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Sin embargo, se podría decir que este es el método más efectivo para dibujar\ncuerpos humanos.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Kenichiro no solo manejaba con maestría la estructura corporal de los humanos,\nsino también la de cualquier ser vivo.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Las obras de Kenichiro eran conocidas por ser rebosantes en detalles con\nbastante llamatismo, pero en realidad, su actitud ante las pinturas parecía,\nmás que la de un artista, aquella de un artesano.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos entonces, yo también me tocaré y me revisaré de igual forma, así que\nrepasemos. En primer lugar, el músculo que se extiende por detrás de las\norejas hacia la clavícula es el músculo esternocleidomastoideo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Mientras reviso el libro, sostengo mi mano sobre mi propio tendón. Y entonces\nRin hace lo mismo, sosteniendo su cuello con la suya.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001215",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es aquí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Y bueno, de esta forma se toca y se revisa el cuerpo propio mientras se observa\nel mapa anatómico.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Al mantener en mente los músculos y los huesos mediante el tacto, la imagen\nmental se hace bastante clara.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Y de tal manera, vamos tocando y revisando poco a poco nuestros cuerpos...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Aunque, a final de cuentas, hay un límite en esto.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y de esa forma va todo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_c02_07",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001216",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Muh.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001217",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que siempre dejas todo a medias.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A medias?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001218",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La estructura del cuerpo posee continuidad. Aunque los huesos y los músculos se\ndividan por partes, estos funcionan gracias a la continuidad. Eso fue lo que\ndijiste, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001219",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las partes en las que me enseñas con detalle las explicas con mucha amabilidad,\npero siento que cuando llegas a la parte del torso tu explicación se vuelve\nalgo tosca.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues es que...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Aunque la estructura muscular de la zona pectoral sea la misma, hay una parte\nmuy importante que es distinta entre los dos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"En particular en el caso de Rin...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"No puedo guiarla por esas dos y enormes colgantes partes suyas de la misma\nmanera que lo haría conmigo mismo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_c02_04",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues para decir las cosas como son... ehm, digamos...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001220",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Digamos?...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Los pechos, los pechos! ¡Son tus pechos!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_c02_03",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_c02_05",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
ja={
{
"Rin se sonroja como un tomate y cubre sus pechos con sus brazos.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Bueh, no es de sorprenderse. A cualquiera le avergonzaría que le señalaran algo\nasí.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001221",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-Esta es la causa?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el toque y textura de mi pecho y el tuyo son totalmente distintos...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_c02_10",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001222",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero ¿no habías dicho que no había diferencia en la estructura básica\ncorporal entre hombres mujeres?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. La única diferencia en la zona de los pechos es si hay o no\nglándula mamaria, pero básicamente hombres y mujeres son iguales.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001223",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La forma de acumular grasa también, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tanto hombre como mujeres acumulan grasa por debajo del músculo pectoral\nmayor.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para darte un ejemplo, parece que a los transexuales originalmente hombres les\ncrecen los pechos desde la misma región que las mujeres al inyectarse\nhormonas femeninas. Aunque esto es algo obvio.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001224",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿N-No significa eso entonces que hombres y mujeres son iguales?...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001225",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quiero que me enseñes.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero, los pechos--”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001226",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-Ni que fueras a tocar mis pechos, Nao-kun! N-No hay nada fuera de lo común\nen esto.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Pues, fuera de lo común no hay nada, pero...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Y en realidad, si fuera el caso de Kenichiro Kusanagi, el sí le enseñaría tanto\na hombres como mujeres tocándolos directamente, sin distinción. Y de hecho,\nparece que él ideó este método de enseñanza para poder enseñarle a las\nmujeres en específico...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001227",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, comencemos. ¿Por dónde debería comenzar a tocar? ¡No tengo ningún\nsentimiento indecente, así que no hay ningún problema!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Quizás no tengas ninguna idea indecente, pero en mi caso, no estoy muy seguro.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Aunque igualmente, no soy capaz de decir 'Tengo sentimientos indecentes por ti,\nasí que no puedo hacer esto'...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Sin ninguna otra opción, comienzo con la continuación de la explicación.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... Comenzando con el músculo pectoral mayor que te explique hace un\nmomento, este parte desde esta articulación del hombro――”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Prosigo la explicación de la estructura corporal mientras toco mi propia zona\npectoral.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Rin también comienza a deslizar suavemente sus manos sobre su zona pectoral...\no más bien, sobre la parte superior de sus pechos.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001228",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Acá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001229",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? ¿No es acá?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, sí! ¡E-Es ahí! Y bien, ahora...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La zona por debajo del músculo pectoral mayor está dura, ¿verdad? Esas son las\ncostillas. La parte terminal del músculo pectoral mayor acá es bastante\nimportante...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001230",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La parte terminal del músculo pectoral mayor... Esto, esto...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_c02_08",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"se",file="se9010",vol=70,id=1},
{"text"},
text={
ja={
{
"Para revisar la zona del músculo pectoral mayor oculta por sus pechos, Rin los\nlevanta.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"mwact",act="おじぎ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"... *traga saliva*",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"El escote de la ropa que lleva Rin está muy al descubierto.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Al levantar sus pechos, ese escote se pronuncia aún más.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Aún no habría tanto problema si solo fuera eso, pero...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Anda ahora en un vestido de una sola pieza, y me da la sensación de que el\nborde de su falda se subió ligeramente...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"No tanto como para que se vean las pantaletas, eso sí...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001231",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto es un poco difícil... Estas son las costillas, y...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="zev_com_c02_08",x=-180,y=-140,time=500,path=":ev/ev_com_c02/",set="ev_com_c02",ax=1920,ay=1080,bx=-960,by=-540},
{"se",id=1,file="se_poyon2"},
{"cgact",file="zev_com_c02_08",act="うんうん",time=300,x=-180,y=-140},
{"ex",time=1300,func="wait"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"A medida que Rin inspecciona su busto, sus pechos parecieran estar por salirse\ndel escote de su vestido, y sus pantis parecieran estar por mostrarse de\nentre su falda.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Esa sensación...",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Aunque en realidad, no hay forma de que sus pechos se escapen del escote, ni de\nque su ropa interior se vea...",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"¿De verdad?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"¿No parecieran estar a punto de salirse?",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001232",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es difícil encontrar el músculo pectoral mayor debido al pecho, pero aún puedo\ndistinguirlos...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Era tal la magnitud de esas mamas, que no podía evitar pensar eso...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_c02_08",time=500,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001233",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué tal?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿A-A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001234",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Pues, respecto a la explicación del músculo pectoral mayor...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, c-claro. Es difícil encontrar el músculo pectoral mayor, ¿verdad?...\nAjajaja.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001235",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es eso, sino que aquí se unen, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Al decir eso, Rin levanta sus pechos y trata de mostrarme.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"mwact",act="rl"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001236",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué, apartas la vista?...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"Mierda... Aun habiendo asistido a tantas sesiones de dibujo de desnudos... ¿Por\nqué ando alterándome ahora por solo esto?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"No puedo creer que de verdad estoy teniendo bajos sentimientos por alguien que\ncon toda honestidad y pureza, solo quiere aprender...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Debo desprender de mi mente toda idea mundana. Debo entrar en el dominio del\nno-yo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Como si un doctor observara a un paciente... Solo veo... de forma objetiva, y\nserena.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Me repito lo mismo una y otra vez, probando con una técnica de autosugestión.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Estoy bien.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"No tengo ningún sentimiento indecente.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"¡Sé fiel a la belleza estética!",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"¡De ninguna forma cometeré ningún tipo de error, ni hay manera de que lo haga!",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001237",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Rin me observa algo angustiada. ¡Pero, no tienes nada de qué angustiarte, Rin!",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, estás en lo correcto. Ese es el músculo pectoral mayor. Podría tocarte\ny revisarlo yo mismo, si quieres.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001238",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Eso es un poco...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Jajajaja. Solo bromeaba. Bien, ¿seguimos entonces?",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Rin sigue aún levantando sus pechos y frotándose.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ahora que he despejado todos los sentimientos bajos de mi mente,\nincluso esa vista no representa problema alguno para mí.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es más, podrías incluso desabotonar ese vestido tuyo para explicarte con mejor\ndetalle. ¡Ahora como estoy, podría incluso manosear tu cuerpo desnudo y\nexplicarte tu estructura corporal sin ningún problema!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001239",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿Qué estás murmurando?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ja? Ah, no es nada, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",file="ev_com_c02_09",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001240",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Me pareció escuchar unas cuantas palabras obscenas...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dices que escuchaste algo? Eso es ridículo. En estos momentos estoy en\nperfecta calma, en pleno y claro juicio.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En primer lugar, no hay forma de que alguien como yo que se la pasaba\ndibujando desnudos de pequeño venga a sentir cosas indecentes solo por el\ncuerpo de mi amiga de la infancia como tú lo eres!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mi mirada ahora es como la de un doctor observando a su paciente!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Aun viendo tu cuerpo, ni una sola partícula de impureza surge de mi corazón!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="ev_com_c02_11",sync=0,face=1,time=400,path=":ev/ev_com_c02/",set="ev_com_c02"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001241",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, ¿como un doctor con su paciente?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001242",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Debería entonces desabotonar mi vestido como lo sugieres, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001243",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes la mirada de un doctor, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Se me escapó todo de la boca?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001244",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo se escapó por tu boca. Aunque fue en un tono bajo.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001245",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque, habiendo dibujado desnudos desde pequeño, igualmente no sentirás nada\nfuera de lo normal, ¿verdad, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001246",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque no lo digas lo sé. Supongo que habrás tenido muchas oportunidades de\nhacer eso, y sobre todo, no hay forma de que con alguien como yo tú...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha, digamos que solo me hablaba a mí mismo, o más bien trataba de\nconvencerme...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001247",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De igual forma, a partir de ahora comenzaremos las lecciones de la parte\ninferior del cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿L-La parte inferior?!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001248",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, con esta falda que llevo ahora no puedo tocar bien la parte inferior de mi\ncuerpo.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001249",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me desabotonaré acá entonces. De esa manera será mucho más fácil de entender,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001250",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, aun viendo mi cuerpo no sentirás nada indecente, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"Uh... Siento que hice enojar un poco a Rin...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001251",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, claro. Nao-kun, dijiste que podías enseñarme tocándome directamente, así\nque desabotona mi vestido, por favor.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Tu vestido? ¿Desabotonar? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",my=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0017",head="rin_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se levanta y se para frente a mí.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001252",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Te encargo entonces.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que me encargas?...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001253",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes el corazón y la mente de un doctor, ¿verdad? ¿O es que acaso te\nequivocaste y pretendías decir más bien 'juguemos al doctor'?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Nuh. Lo está diciendo con un tono burlón hacia mí.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Después de todo, seguramente está convencida de que no puedo hacerlo y por ello\nlo dice.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Me subestimas Rin. Me estás subestimando.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Yo soy la clase de tipo que puede hacer esas cosas con facilidad.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... ¿Es que acaso pensaste que no podría hacerlo, Rin?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001254",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0013",head="rin_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, vamos a desabotonarte. Venga, venga.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001255",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O-Oye. No hace falta que muevas las manos de esa forma, el botón se puede abrir\nfácilmente.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin desabotona un botón.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001256",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ves? Así...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"¡No, no, yo no tengo ningún pensamiento indecente!",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, será que hacemos esto rápido entonces...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001257",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"El ímpetu que nos gobernaba a los dos se fue, y ahora estábamos tranquilos y\ndóciles.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Comienzo a desabotonar con manos temblorosas.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001258",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Los labios de Rin tiemblan.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Parece que no soy el único que está temblando.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"El segundo botón es desabotonado por acción de mis manos.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001259",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... está bien. Puedes seguir...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Sigo entonces con el próximo botón――",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_olympia_02_2"},
{"text"},
linkback="block_00237",
},
label = {
top={block="block_00000",label=1},
},
}
