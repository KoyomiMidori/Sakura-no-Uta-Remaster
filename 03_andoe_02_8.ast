astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"ex",time=2000,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y eso fue lo que pasó.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"bg",file="ev_com_f02_16",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"bgm",file="bgm003"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_kid_000757",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Pwajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Controla un poco la risa, convaleciente.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_kid_000758",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No puedo evitarlo, es demasiado cómico.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_kid_000759",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jajajaja, de verdad que lo es. Cómo me hubiera gustado estar ahí, jajaja.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"bg",file="ev_com_f02_12",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000760",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Agh!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo dije.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_kid_000761",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Pensé que se recuperaría de inmediato, pero mi padre siguió sosteniendo su\npecho con la mano por varios minutos.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así duele? ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bg",file="ev_com_f02_02",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000762",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"A pesar de lo que dice, parece estar bastante adolorido.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Por más que intente aparentar estar bien, ya los doctores le dijeron que no le\nqueda mucho de vida.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Debe ser un esfuerzo terrible para él entablar una simple conversación como\nahora.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres que llame a la enfermera?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000763",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No hace falta...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues pareciera que sí. No tienes por qué hacerte el duro estando en el\nhospital.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000764",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No es que me haga el duro, precisamente... Además, el dolor es la mejor prueba\nde que sigo con vida.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pretendes sacarte un chiste de eso?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000765",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No, estoy siendo muy serio. En algún momento lo entenderás tú también, en algún\npunto de la larga vida que te espera.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En mi larga vida? ¿No cuando esté enfermo?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000766",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No. Viviendo.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000767",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El sufrimiento es muy importante.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000768",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si no pudiera sentir nada--”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_kid_000769",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No sabría si estoy vivo o muerto.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kid_000770",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si duele es porque sigo intentando vivir.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_kid_000771",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si duele, es porque mi cuerpo quiere vivir.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_kid_000772",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Porque está oponiéndose.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_kid_000773",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Duele, porque está oponiéndose a su propia destrucción.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000774",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No intentes apartar la vista del dolor.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000775",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues eso justamente es vivir.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está de más que te tomes un analgésico igual, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_kid_000776",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Claro, nunca están de más. Y nunca está de más un analgésico en la vida para\ncalmar el sufrimiento...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llamaré entonces al doctor.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000777",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Déjalo así. Ya me dieron analgésicos esta mañana, así que probablemente no me\ndarán más.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000778",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que me toca aguantar un poco ahora...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si te duele entonces puede que te den algunos, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_kid_000779",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y fíjate, son buenísimos. Comencé a tener divertidas alucinaciones cada vez\nque los tomaba, y entre tanto pedir y pedir más, regularon mis dosis.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues parece que te divertiste bastante!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto hablar de que no ignore el dolor, y mira nada más... has estado jugando\ncon morfina.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000780",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues cuando tienes esta enfermedad lo único bueno que consigues son las\ninyecciones de morfina.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué pasó con la charla que me acabas de dar?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000781",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es solo parte de la revelación que he tenido.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_kid_000782",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que no lo olvides, es importante.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, está bien. Procuraré no olvidarlo.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000783",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bien.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De hecho, son contadas las veces que me has hecho estas charlas.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
delay={
vl01={
{"bg",file="ev_com_f02_12",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
},
},
text={
vo={
{"vo",file="man_kid_000784",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De verdad?... Agh...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de casi veinte minutos sosteniendo su propio pecho, Kenichiro logró\nrecuperarse.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_f02_01",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000785",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tengo que decirlo, Fridmann no pudo haber aparecido en mejor momento.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no me imaginé que vendría a la casa justamente en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_kid_000786",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Probablemente estuvo vigilándola.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Tanto tiempo libre tiene en sus manos?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000787",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No, no, seguramente le pagó a alguien para que lo hiciera. No es raro verlo\npagándole a indigentes para que le sirvan de informantes.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, lo de hoy...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000788",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me da la sensación de que Fridmann ha estado al tanto del asunto desde un\nprincipio.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay de Akashi?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000789",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No conozco a ningún Akashi. Aunque considerando que tenía un juramento escrito\nen inglés y que además tenía mi tarjeta, no cabe duda alguna de que Fridmann\nestá involucrado.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_kid_000790",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me llama la atención también el hecho de que se disfrazara y fingiera ser de\notra nacionalidad.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso no hay nada extraño, a veces se viste de forma rara. En primer lugar,\nsiempre lleva un abrigo encima del uniforme, lo cual ya es bastante\nextravagante. El disfraz de esta vez fue, probablemente, inspirado en su\nimagen de héroe.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000791",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mmmm, ya veo. Tal vez sea así entonces, aunque igual me huele a uno de los\nmaliciosos trucos de Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo entonces un simple estudiante y el curador de la Fundación Moore llegaron\na hacer contacto?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_kid_000792",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De eso sí no sé, pregúntale a ellos.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000793",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque definitivamente a Shoichi Nakamura no se le ha quitado lo idiota.\n¿Quién podría creerse semejante farsa?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que vi, me pareció que el vejete tiene una debilidad por personalidades\nde poder y autoridad.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000794",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De lo que conozco a Nakamura, nunca ha sido precisamente un tipo muy refinado,\naunque de lo que me cuentas parece que su cabeza se ha deteriorado más aún.\nSupongo que así de enorme será la presión que tiene encima.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, al parecer los números no van muy bien para la Farmaceútica Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000795",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No sé cómo funcionará eso adentro, pero no creo que les pueda ir muy bien\nteniendo a ese hombre al mando.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000796",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que sí me pude reír, pero ahora que lo pienso con calma... ¿Qué planeas\nhacer con la mentira que se inventó el tal Akashi?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí. Las dichosas siete obras no existen, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000797",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por supuesto que no existen. Ya una fue suficiente trabajo, hacer siete sería\nuna agonía.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero Nakamura está comenzando a creerse las mentiras de Akashi. Probablemente\nestá completamente convencido ya de que Akashi es un negociador de arte.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que quiero pedirte ahora--”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000798",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo haré.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he dicho nada aún.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000799",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me vas a pedir que me saque las otras seis obras de la manga, ¿no? Imposible,\nno, no. Solo me quedan seis meses de vida.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y eso qué importa? El dios del manga no paró de dibujar nunca, ni siquiera\nantes de morir.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez perdió la consciencia y al recobrarla lo primero que dijo fue 'denme\npapel y bolígrafo'.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000800",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso es eso y esto es esto.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000801",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Además, el dios del manga fue un verdadero genio. Yo soy algo más parecido a un\nestafador. De genio no soy nada.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así lograste engañar a todo el mundo con esa habilidad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000802",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues sí, como buen genio que soy.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo eres o no lo eres? Diablos.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000803",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Buen hijo de estafador eres... ¿Por qué no resolver todo como lo haría el hijo\nde un estafador?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios santo, ¿no podías ser más negligente?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000804",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Naoya, ¿sabes cuál es la profesión más antigua del mundo?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La prostitución.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kid_000805",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y cuál le sigue?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La falsificación.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000806",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que te has educado, eh.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El mismísimo Orson Welles llegó a decir 'la falsificación es tan antigua como\nel árbol de Edén'. Muchos falsificadores fenicios y sumerios llegaron a\nproducir falsificaciones de obras de la antigua Grecia.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_kid_000807",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No solo eso. Incluso entre los más grandes han habido algunos que se han\nmanchado las manos falsificando. Una de las más famosas historias es la del\nmismo Miguel Ángel que tanto admiras, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No la conozco.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_kid_000808",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Durante el Renacimiento, el joven Miguel Ángel creó una réplica de una estatua\nromana y la enterró en el jardín de Lorenzo de Médici, su mecenas, para\nllamar su atención.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000809",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“También llegó a fabricar réplicas de una gran cantidad de bocetos creados por\nmaestros de épocas pasadas. Llegó incluso al extremo de usar humo, pintarlas\no ensuciarlas para que fueran idénticas a las originales.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien con tanta habilidad como Miguel Ángel pudo haber creado piezas aun\nmejores que las originales, ¿no? ¿Por qué se dedicó a las falsificaciones?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000810",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Miguel Ángel fue un maestro de la falsificación. Existe la leyenda de que una\nvez tomó prestado una obra original, la falsificó e hizo pasar la\nfalsificación por original. Para quedarse con la verdadera.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo se ha visto en Oriente según los escritos. En fin, lo que quieres\ndecir es que hay una fuerte relación entre una obra original y su\nfalsificación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000811",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podrías darme entonces la combinación de colores para 'Cerezos recostados',\nviejo?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000812",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Oh? No me digas, no me digas, ¿es que te dieron ganas de falsificar las seis\nobras?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es imposible para mí. Ya no tengo esa mano derecha en la que tanto tiempo y\nesfuerzo invertiste.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000813",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jajaja, no pudiste decirlo mejor.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía te odio por haberme colocado esos expansores de entrenamiento para\npintar.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_kid_000814",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, no es secreto que para desarrollar una técnica maestra necesitas\nmuchísimo entrenamiento en las sombras, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y qué?! ¡En ninguna parte del mundo vas a encontrar a otro padre capaz de\ncolocarle expansores a un niño que apenas acaba de nacer!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000815",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es mejor hacerlo lo más temprano posible, desde el nacimiento. Las\ninvestigaciones más recientes han descubierto que el ambiente que rodea un\nniño influye más en su crecimiento que los genes. Por ejemplo, en sus\nmúsculos o reflejos motores.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees en eso? Espera unos años y verás que dirán todo lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué demonios vino eso? ¿Una parodia de Kyo*in no Hoshi?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000816",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, en parte sí.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es en serio?!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000817",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Conoces a Schumann, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el compositor que tanto te gusta.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_kid_000818",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue también un pianista. Se dice que se dañó permanentemente la mano intentando\nforzarse a practicar usando un dispositivo que jalaba sus dedos mediante una\npolea.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Se dañó la mano! ¡Dime entonces qué tienen de bueno esos dispositivos!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_kid_000819",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, pero parece que no es cierto eso.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene que ver Schumann entonces en esto?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000820",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Quiero decir, sí es cierto que en esa época existían esa clase de aparatos de\nentrenamiento. Han encontrado aparatos similares, y es muy posible que\nSchumann lo usara.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="man_kid_000821",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es inspirador pensar que varios de los artistas más famosos en la historia han\nusado ese tipo de aparatos, ¿no crees? Por eso mismo fue que pensé en\nconvertirte en un artista inspirador a ti también.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no tiene nada de inspirador.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000822",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero bien que te hicieron capaz de pintar buenos cuadros, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no lo niego. Aunque bueno, no sé si es mera casualidad o no, pero ahora\nperdí el control de mi mano dominante, igual que tu querido Schumann.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000823",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Piénsalo así, fue quizás por el entrenamiento con los expansores que no\nsufriste daño mayor.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego tampoco. Recuerdo que podía ganarle fácilmente a adultos en\nvencidas usando mi brazo derecho.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000824",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No me sorprende.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez si los hubiese usado en el brazo izquierdo, podría pintar con la mano\nizquierda también.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kid_000825",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Nah, solo funciona cuando eres todavía niño. Ya eres adulto y creciste, entrena\ncomo debe ser.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De que hago entrenamiento, lo hago. Aunque ese programa está más adaptado para\nun atleta que para un artista.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_kid_000826",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, el programa que te dejé. ¿Te ha estado funcionando?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, al menos en lo que me instruíste.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000827",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y bien? ¿Crees poder pintar con esa mano izquierda ahora entrenada?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tanto como para entrar en Geidai, quizás...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000828",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No compares el examen de admisión de Geidai con mis pinturas. ¡Soy un pintor de\nrenombre internacional!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso lo digo, no puedo. Ni siquiera alcanzo al nivel de Kei, menos aun al\ntuyo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000829",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y a pesar de eso preguntas por mi combinación de pigmentos?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kid_000830",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fufufufu, tanto decir que es imposible falsificarme, pero ya estás comenzando a\nhacer los preparativos. Qué buen hijo que me gasto.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En eso me parezco a ti.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000831",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está bien. Tengo la lista de pigmentos, solo pídesela a Fridmann y te la dará.\nFue con el apoyo de Fridmann y la Fundación Moore que 'Cerezos recostados'\nobtuvo el Platine Épaulard.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="man_kid_000832",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De ahí es que Fridmann ha estado manejando mis materiales desde el momento en\nque pensé esa obra.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tiene tus materiales? Me acabo de enterar. Eso cambia bastante las cosas.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000833",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ohhh, se te ven las ganas, eh. Así que piensas crear no una, sino seis\nfalsificaciones de la más grande obra de un artista internacionalmente\nfamoso.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo vuelvo a advertir, es una tarea casi imposible.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000834",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En pocas palabras, no tienes plan alguno aún.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Pero he aprendido una buena cantidad de pequeños trucos desde que perdí\nla mano.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_kid_000835",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Trucos?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay algunas cosas que descubrí al perder mi brazo derecho y volverme un tipo\nordinario. Cosas que genios como tú no saben.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000836",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué profundo eso. Dime qué es.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Reitero, no tengo un plan concreto aún.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000837",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues te veo confiado.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Es mucho más fácil crear algo falso que crear algo real.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si me pidieran algo original en mi estado actual lo rechazaría de inmediato, es\nsencillamente imposible. Pero creando algo falso lo único que queda es una\nmínima posibilidad de que me descubran, como mucho.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más detalles que tenga, una falsificación es una falsificación.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, si es a ese nivel, puedo llegar...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000838",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jejeje, está bien. Esperaré con ansias por verlas.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te hagas muchas expectativas. Estamos hablando de falsificar el cuadro que\nincluso alguien como tú se tomó años en culminar. 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy más joven que tú, y con mucha menos experiencia. Cualquiera con un poco de\nsentido común sabe que es imposible. La situación es desesperanzadora.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Con una sonrisa en su cara, Kenichiro me dijo lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000839",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jejeje, me gusta la mirada que pones en estos momentos. Tienes esa misma fuerte\nmirada que tenía tu madre.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000840",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Desde que te conozco siempre has sido un muchacho interesante. Te pareces a mí,\nsí, pero también tienes cosas que yo no tengo.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kid_000841",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Algo así como un fuego interno, ¿quizás? Es simplemente inmensurable.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000842",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El artista de los cerezos, eh... sí, tiene bastante sentido.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué rayos hablas?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000843",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De que eres un genio.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo he dicho, me estás poniendo muy alto en el pedestal.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000844",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sea lo que sea, no dudes en venir cuando tengas problemas. Quizás pueda\nayudarte.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No dudaré en hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"se",id=1,file="gatya"},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg066a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000257",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Ya terminaste de hablar con Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya terminé. ¿Por qué no entraste a hablar con él?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000258",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No quise molestarlos...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no eres ninguna molestia.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000259",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Cuando piensas en una obra tu cabeza se llena con eso, así como Kenichiro. No\nquiero interrumpir a los dos estando en ese estado.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Obra?... ¿Por qué pensaste en eso?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000260",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Me equivoco? Solo se me ocurrió...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, acertaste bastante.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0003",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000261",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me gustan las obras de Kenichiro. Y las tuyas también, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mis obras? Pero si no conoces ninguna.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000262",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eso no es cierto. Yo también estuve en Japón, hace mucho tiempo. Conozco tu\núltima obra.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mi última obra?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0003",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000263",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, 'Fantasía de un día de cerezos'. Es un cuadro fantástico. Y creo que ahora\nentiendo mejor lo que ese cuadro significa.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con que ahora entiendes?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000264",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No es nada. Vayamos ya a casa.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000265",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Bien, con esto se acaba la cena.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con el detalle de que tú no has comido.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000266",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, y por eso es que prepararé mi comida para esta noche.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000267",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Muy bien, Naoya, ¿de qué manera quieres que aumente tu deseo sexual para esta\nnoche?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Idiota, ya me he cansado de decirte de que no necesitas hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0015",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000268",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eso quiere decir que ni siquiera comida estás dispuesto a darme.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te permití que tragaras mis sueños, sí, ¿pero por qué sueños eróticos? ¡¿Qué\nnecesidad hay de que sean sueños eróticos?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0311",face="a0016",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000269",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Siempre es mejor comer algo delicioso!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que acaso son deliciosos los sueños eróticos?!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000270",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No precisamente deliciosos, pero son los más fáciles de tragar.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué los sueños eróticos son fáciles de tragar?...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000271",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Para ser más concretos, en realidad no son los más fáciles de tragar. Los más\nfáciles de tragar son tus sueños felices.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues te ruego que tomes esos.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000272",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Kuzu no tiene manera de saber de qué trata un sueño hasta tragarlo. En pocas\npalabras, debo tragar antes para saber.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo cual quiere decir?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000273",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“En mi estado actual, podría ser muy peligroso que trague una pesadilla.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000274",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No he perdido por completo mi corazón, aunque sí lo parezca. Quizás no sea muy\nexpresiva, pero tengo sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me he dado cuenta de eso. No lo muestras mucho en tu cara, pero sí los tienes.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000275",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La vez pasada te sonrojaste.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011j",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000276",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“A-Ah, aquella vez. Fue cuando hablamos de tus sueños eróticos, ¿verdad? No\npodía evitar sonrojarme...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010j",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000277",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡¿V-Vas a intentar jugar a humillarme ahora?! A-Aunque pensándolo bien, no\nestaría mal si eso te excita...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que esa pregunta se convierte en un juego de humillación?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005j",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0018j",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000278",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“P-Piénsalo por un momento. Fue un sueño erótico tan fuerte que no podrías\nevitar masturbarte. Y yo me tragué todo ese sueño.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? E-Eso quiere decir que--”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017j",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0018j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000279",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“N-No me masturbé... Lo que quiero decir es que había tanto deseo sexual que no\npodrías evitar masturbarte.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, a eso te referías...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005j",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000280",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Supongo que lo sabrás, pero esa es mi fuente de energía. Me parece un\ndesperdicio que la gastes de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010j",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000281",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“A-Aunque, debo admitir que, se siente muy... bien.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Muy extrañamente, Kuzu contestó de manera entrecortada, sonrojándose.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"E-Esto es...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000282",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Bien, bien, ¿qué tanto te habrás calentado con eso?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que todo fue una farsa?! ¡¿Podrías parar con esos cambios tan repentinos\nde humor?!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0018",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000283",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No es eso...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011j",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0006j",head="shz_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000284",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Si no decía eso, no podría aguantar la pena... Y-Y es que Kuzu también... uh...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es decir?...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000285",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Qué tal estuvo eso?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Otra farsa más?!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000286",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Puedes tomarlo como quieras. Me conformo con que puedas tener buenos sueños\neróticos, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Condenada súcubo!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000287",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Súcubo... súcubo...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te cansas de buscar lo que sea en el teléfono, eh...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000288",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Aún no entiendo muchas de las palabras usadas en japonés...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
