astver = 2.0
astname = "ast"
ast = {
block_00000={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",rule="083r",vague=40,file="bg066a",path=":bg/"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Me detengo en medio del camino hacia la recepción de la entrada.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="寧",size="z1",mode=3,resize=1,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000001",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Esa niña... Estaba ahí también cuando vine.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_nei_000002",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Su edad debe rondar entre los 5 o 6 años.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Tiene una serenidad en sí que me hace difícil creer que tiene esa edad. Y más\naún después de haber visto a los niños de la escuela dominical.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Está sentada con las piernas y los pies alineados correctamente. Justo a su\nlado hay una muleta apoyada.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Está sentada tranquilamente, con una mirada muy alejada de su infantil aspecto,\npuesta hacia el frente.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Tras esa mirada no hay nada. Solo la pared.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9012",id=1},
{"fg",ch="寧",size="z2",mode=3,resize=1,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
text={
ja={
{
"Me meto lentamente las manos en los bolsillos y camino casualmente. Me siento\nen la banqueta-sofá sin espaldar donde estaba ella sentada.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"La niña en el rincón derecho. Yo en el izquierdo.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Siento como mis dedos tocan algo dentro de mi bolsillo. Son los bekkoame que\nToritani me dio ayer.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya está por terminar la hora de las visitas.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000003",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La niña me ve de reojo, y luego vuelve a ver rápidamente hacia el frente.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000004",ch="nei"},
},
ja={
{
name={"???"},
"“Muchas gracias. No se preocupe.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Una tranquila y plana voz se escapa de la boca de la niña.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Sus palabras daban una sensación de madurez.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Y se escucharon como un rechazo también. Los caramelos dentro de mi bolsillo se\nmueven entre mis dedos, tocándolos.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El centro de rehabilitación de este hospital tiene un personal muy bueno.\n¿Maezono-san sigue trabajando aquí?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000005",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"La niña volvió su cabeza hacia mí. La mirada que me estaba dando ahora se\nasemejaba al silencio.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_nei_000006",ch="nei"},
},
ja={
{
name={"???"},
"“Maezono-san, sigue aquí.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Ni muy fuerte, ni muy débil. Un tanto plana, pero no carente de sentimiento\nalguno.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Así era su voz.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Llegué una vez a recibir su asistencia por un breve tiempo. Es algo\nescandalosa, pero es una persona muy buena y dedicada.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_nei_000007",ch="nei"},
},
ja={
{
name={"???"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás esperando a que te vengan a buscar?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fgact",ch="寧",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000008",ch="nei"},
},
ja={
{
name={"???"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Ojala que vengan pronto por ti, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_nei_000009",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="寧",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
ja={
{
"La niña agita su cabeza a los lados. Su tranquila voz vuelve a escaparse de su\nboca.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0005",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000010",ch="nei"},
},
ja={
{
name={"???"},
"“No sé cuándo vendrá.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está ocupada la persona que te viene a buscar?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000011",ch="nei"},
},
ja={
{
name={"???"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto... ¿Qué crees que tengo ahora en mi bolsillo?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"La niña inclina su cabeza en extrañeza. Supongo que mi súbita pregunta la dejó\ndesconcertada. Prosigo sin darle mucha atención a eso.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podría ser algo bueno. Podría ser algo malo. Podrían ser moneditas. Podrían ser\ncaramelos. Podrían ser botones. Podría ser la luna.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000012",ch="nei"},
},
ja={
{
name={"???"},
"“Dices... cosas raras.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no lo voy a negar. Y bien, ¿qué crees que tengo adentro?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000013",ch="nei"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"La niña piensa por un momento. En sus ojos se puede ver algo de titubeo.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_nei_000014",ch="nei"},
},
ja={
{
name={"???"},
"“... ¿Caramelos?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Correcto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Saco todos los bekkoame de mi bolsillo y se los doy a la niña.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estos son por hoy. Los demás son para mañana. No los comas cuando termines con\nel día de mañana, sino cuando llegues a lograrlo una sola vez.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es mucho más efectivo recibir recompensas rápidas y ocasionales, sin mucha\nespera.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000015",ch="nei"},
},
ja={
{
name={"???"},
"“¿Puedo quedármelos?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, acertaste a mi pregunta, así que son tuyos... Ahh... Ehm, ¿cómo te llamas?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000016",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Nei.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo soy Naoya. Nei, esos caramelos son tu justa y legítima recompensa. Tómalos.\nTe dije que estos serían para mañana, pero si quieres puedes comerlos todos\nahora.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000017",ch="nei"},
},
ja={
{
name={"Nei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"La infantil niña se me queda viendo fijamente. Vacila por un momento, y\ndespués, asintió con un rápido movimiento.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000018",ch="nei"},
},
ja={
{
name={"Nei"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay de qué.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fgact",ch="寧",act="おじぎ",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La joven niña abre el transparente envoltorio de un caramelo y se lo lleva a la\nboca. Un pequeño trazo de felicidad se dibuja en las esquinas de sus pequeños\nlabios.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Me quedo aliviado. Esta niña es bastante responsable y fuerte, pero, a pesar de\ntodo, sigue siendo una niña como cualquier otra.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bgm",stop=1,time=1000},
{"excall",file="02_abend_13_1"},
{"text"},
linkback="block_00060",
},
label = {
top={block="block_00000",label=1},
},
}
