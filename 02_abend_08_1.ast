astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c17_01",path=":ev/ev_uni_c17/",set="ev_uni_c17"},
{"text"},
text={
ja={
{
"Termino con las lecciones suplementarias de siempre.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"2 días más. Mis vacaciones de verano comenzarán en unos 2 días.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Abro la puerta de la sala de arte, de muy buen humor.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000264",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hoy llegaste temprano.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001210",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Parece que hoy no te encontraste ninguna distracción en el camino, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Toritani me observa.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001211",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Desde cuándo te interesa la arquitectura? Hasta ahora juraba que no te\ninteresaba, aunque parece que has estado investigando con bastante esmero...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"¿Habrá observado como me he acercado varias veces a la iglesia de Yumihari?...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001212",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y? ¿Te enteraste de algo?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0005",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001213",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, obviamente te hablo de――”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"bgm",file="bgm008"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000299",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Algún elemento de misterio?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001214",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Wah, A-Akashi-se--!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000300",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Por qué tanta sorpresa?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues cualquiera se asustaría si alguien se le apareciera por detrás de\nrepente.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000301",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por andar tú tapando la entrada me veo yo obligado a aparecer por detrás, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Ciertamente, fui yo quien estuvo bloqueando la entrada.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000302",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Los elementos de misterio son muy buenos. A mí me encanta resolver misterios.\n¿Qué clase de misterio andan resolviendo ustedes?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No estamos resolviendo ningún misterio...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000303",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001215",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En realidad sí.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Toritani observa con una mirada penetrante a Akashi.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001216",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estábamos tratando de resolver un misterio. Puesto que un cierto idiota por\nallí anda tramando algo absurdo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_wtd_000304",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohhh, eso no está nada bien, ciertamente. Los idiotas no traen nada bueno.\nSiempre hacen cosas innecesarias. Las estadísticas dicen que el 90 % de los\ncriminales son idiotas.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001217",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. El 90 % de los crímenes son realizados por idiotas... entonces el 10 %\nrestante son delitos de guante blanco, ¿tal vez?...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_wtd_000305",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tal vez sea así~, tal vez no~”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Toritani observa a Akashi, sin apartar en ningún momento su mirada.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Akashi sigue igual de bromista y despreocupado que siempre.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001218",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai. ¿Con qué fin estuviste buscando disolventes orgánicos\ncatalogados como químicos peligrosos?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",mode=-2},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000306",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Umuh! Esa es una muy buena pregunta. No podía esperar menos de mi subordinada,\ny además sucesora legítima del cargo de jefe del club de arte del colegio\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001219",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace faltan los halagos ni las adulaciones, explícame las razones, por\nfavor.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000307",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fui inspirado.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Inspirado?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000308",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Estaba un día leyendo un manga y, de repente, ¡vi cómo el uniforme de las\nchicas del manga se iban pulverizando! Desde ese momento comencé a buscar\nquímicos capaces de disolver uniformes sin acarrear ningún daño al cuerpo\nhumano.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tenías esa estúpida idea en mente?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000309",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, y he escuchado que la acetona se usa frecuentemente en la revitalización de\nla piel. ¡Se me ocurrió que de ir todo bien podría ser posible disolver los\nuniformes y además dotarle a las chicas de una piel suave y sedosa!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001220",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, ¿así que tenías ese ridículo plan en mente?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="明石",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000310",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Cómo que ridículo? Esto también es parte de mi actividad artística. ¡El arte\nde llevar lo visto en el mundo 2D a la realidad en 3D!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",mode=-2},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, me lo imagino. Thomas también fabricó un conjunto de prendas capaces de\ndisolverse para el evento para atraer nuevos integrantes, así que supongo que\nver eso también te pudo haber inspirado.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000311",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sin lugar a dudas! Y ciertamente, ese evento fue bastante impactante.\nCualquiera resultaría inspirado al ver eso. ¡Y es que el arte es una gran y\nenorme masa de inspiración! Wajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Observo a Toritani.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001222",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... nada...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"se",file="se1279",id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000858",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah! ¡Mako-chan!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"msgoff"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"ex",time=400,func="wait"},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se acerca corriendo de la puerta hacia Toritani, y le da algo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001223",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias. Ya veo, así que este es el mapa de la ruta de tren que usaremos para\nla ida al campamento. Yo me encargaré de comprar los boletos.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000859",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay buenos descuentos cuando se compran boletos para grandes grupos.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_rna_000265",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿No íbamos a movilizarnos usando los Seish*n 18 kippu?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001224",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay boletos expreso que se consiguen a buen precio en las tiendas de cupones si\nlos compras en grandes cantidades.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_yum_000563",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué alivio... Debo admitir que de verdad no me agradaba la idea de ir en tren\nnormal hasta Shimane...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001225",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno, nosotros también tenemos nuestros exámenes de ingreso a la\nuniversidad, así que debemos recortar el tiempo lo más posible.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0029",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001226",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ya Rin-chan llegó, creo que ya estamos todos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000090",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"¿Desde cuándo estuvo ahí?",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Thomas salió del pequeño espacio que hay entre las paredes. Frotando la punta\ndel lápiz, como siempre.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_000564",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que estabas acá, Takizawa? Juraba que no habías entrado aún a la sala y me\nhabía contentado un poco...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000091",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES. Soy un integrante de club ejemplar DESU. Cero retrasos, cero\ninasistencias, ese soy yo, DESU.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Cero retrasos, cero inasistencias, pero sin hacer nada más que frotar ese\nlápiz, eso sí...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",mode=-2},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=-570,lv=4,id=3},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=0,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001227",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, respecto a la fecha del campamento y tomando en cuenta los planes de\ntodos, la fecha más pronta que tenemos es el primero de agosto. Y, pensé en\ncomprar de una vez los boletos para esa fecha. ¿Algún problema al respecto?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000266",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongo que no hay problema, ¿no? Esperemos que haga buen clima ese día.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=570,lv=4,id=4},
{"fgact",ch="優美",act="うなづく",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000565",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes, ese día hará un excelente clima, de cualquier manera... Iremos\njuntas ese día... No hay manera alguna de que el Cielo no nos dé su\nbendición.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000267",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ehm... Yuumi, ¿no habías negado la existencia de Dios hace unos días?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000566",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Aunque no exista un Dios, existe un Cielo! No hay ningún problema, en caso de\nque haya el peligro de que llueva, le otorgaré todos los sacrificios que\nnecesite al Cielo para revertir eso...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No veas mi cara mientras dices eso!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000567",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estás demasiado sensible... En ningún momento estuve viendo tu cara,\nKusanagi-senpai. Simplemente estaba pensando en qué usaría como sacrificio...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Y yo te estoy preguntando la razón por la cual observas la cara de uno mientras\npiensas en qué ofrecerle de sacrificio al Cielo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",mode=-2},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000312",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Según el pronóstico semanal, ese día estará despejado. No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_rna_000268",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Akashi-senpai, no se supone que no ibas al campamento? ¿Por qué\naveriguaste entonces el pronóstico semanal del clima?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000313",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Porque soy un buen senpai y me puse a investigar pensando en ustedes.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_yum_000568",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No estarás pensando en venir? Con la excusa de una sorpresa o algo así.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000314",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No hay problema. Despreocúpense. Tengo un asunto que resolver ese día.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001228",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué asunto es ese? Akashi-senpai, tus asuntos están siempre vinculados a\ndesastres en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000860",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Desastres en el colegio?... ¿Qué es lo que Akashi-senpai ha venido haciendo\ndurante todo este tiempo?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001229",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahhh, quisiera explicártelo, Rin-chan, pero hay algunas cosas tan fuertes e\nintensas que no pueden ser descritas de la boca de una chica.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001230",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por ejemplo, trató una vez de volar con una muñeca inflable y terminó\nfracturándose...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000861",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿U-Una muñeca inflable?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",mode=-2},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000315",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso dolió bastante, eh... Pensé que acabaría muriendo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Espera, es que de verdad trataste de volar con una muñeca inflable? Pensé que\nsimplemente estaba metida dentro del montón de globos.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rna_000269",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que ya de por sí es descabellado que tenga esa clase de objeto con los\notros globos...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000316",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Para nada, para nada, todo navío tiene su diosa tallada en la proa, ¿no? Es\nnecesario una diosa para navegar por los cielos.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tu diosa es una muñeca inflable?... Por andar volando con esa diosa es que te\nfracturaste.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="明石",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000317",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Te estás metiendo con mi Love Pillow Kaga*i Hiraki-chan?!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé ni me importa el nombre de tu muñeca inflable...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",mode=-2},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000569",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahh, es la muñeca inflable imitación de un cierto anime, ¿cierto?...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que la conoces?!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000570",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, digamos, simplemente tengo como hobby ver todo tipo de artículos de\nimitación. ¿Algún problema con eso?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Es bastante triste que tomes esa actitud de '¿y qué?' al hablar de ese hobby...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=570,lv=4,id=4},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001231",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues menos mal, ¿no? Por tener algo con tan poca fuerza de flotabilidad como\nuna muñeca inflable dentro de los otros globos no sufriste de mayor problema.\nEn el caso contrario de haber volado demasiado pudiste haber desaparecido...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000270",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Hace tiempo, hubo una persona que amarró una gran cantidad de globos y\nvoló con ellos, pero luego terminó desapareciendo, así que hay que tener\ncuidado con eso.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_wtd_000318",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya, pero si conoces al señor de los globos. Aun con lo joven que eres.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000271",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque solo tenemos 3 años de diferencia en edad.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y para qué hiciste eso? ¿El señor de los globos te inspiró?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_wtd_000319",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues se podría decir eso.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Este tipo toma como inspiración temas realmente viejos, eh...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000272",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cambiando de tema, en el lugar del campamento hay una playa también, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",mode=-1,lv=4,id=4},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000862",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, la hay.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000273",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedo esperar por ir a verla~”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=1},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000571",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues sí, aunque en Yumihari también hay una playa...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000274",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero no es lugar para nadar, eso sí... Aunque hay personas que hacen\nWindsurfing.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000572",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Odio fuertemente el agua marina, aunque podré darle un gusto a mis ojos con\ntodos los trajes de baño que habrán, así que supongo que no está mal ir a la\nplaya.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000092",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES, Yuumi-chan en traje, traje, traje de baño~”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000573",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo no me pondré ningún traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Vas a entrar al mar sin llevar traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000574",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",id=1,file="se2192"},
{"fgact",ch="優美",act="うなづく",time=50,size=15,lv=5,id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guhaaa!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0100",face="b0006",head="yum_z2b",lv=5,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0005",head="yum_z2b",lv=5,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000575",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué clase de cosas estás imaginándote?! ¡Cuando digo que no me pondré traje\nde baño quiero decir que no entraré al mar! ¡Deja de imaginarte a otras\npersonas desnudas tan indiscriminadamente!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No... no es eso... No te imaginé entrando al mar desnuda ni nada de eso,\nsimplemente que por como eres siento que eres capaz de entrar con ropa al mar\nsin ningún problema...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"se",id=1,file="se2192"},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",lv=5,id=1},
{"fgact",ch="優美",act="うなづく",time=50,size=15,lv=5,id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guhaa!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2a0100",face="a0006",head="yum_z2a",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000576",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De igual manera estás siendo muy descortés. Tampoco soy tan insensata.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0005",head="rna_z1b",x=-570,lv=4,id=3},
{"fg",ch="優美",size="z1",lv=1,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=0,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000275",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eh~ ¿Yuumi, no vas a entrar al mar?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=0,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000577",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡A mí me basta con observarte a ti y a las demás muchachas en traje de baño!\n¡No tengo necesidad alguna de entrar yo!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0011",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000276",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero yo quiero entrar contigo al mar, Yuumi~”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=0,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000578",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jum, si me dices eso, me veré obligada a echarme un chapuzón en el mar...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000863",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, se me ocurrió algo. Vayamos a comprar los trajes de baño todas juntas.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-570,lv=4,id=3},
{"fgact",ch="里奈",act="うなづく",lv=4,id=3},
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=0,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000277",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa idea me gusta. Aunque, ¿no les gustaría ir de una vez al regresar? Al ser\nverano los centros comerciales trabajan hasta tarde.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000864",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo tengo el traje de baño reglamentario del colegio, así que sería bastante\noportuno para mí. Es el centro comercial que queda cerca del Parque Costero,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000865",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muy bien, ¿será que salimos temprano hoy y nos vamos todas juntas?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=0,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",lv=1,mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=0,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000579",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso me gusta... Elegir trajes de baño solo entre mujeres... Me excita.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000093",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES, nos vamos todos juntos, DESU.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"se",id=1,file="se2192"},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0017",head="yum_z1a",x=0,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",time=150,size=15,lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000094",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡OUCH!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000580",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No podrás venir de ninguna manera, Takizawa!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"msgoff"},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Después de que la charla se calmó y todos comenzaron a trabajar, Toritani se\nfue sola hacia la sala de preparativos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Parecía estar muy distante, aún durante la conversación del campamento.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",rule=139,vague=40,file="bg050a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No está en la sala de preparativos?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",id=1,file="se1107"},
{"text"},
text={
ja={
{
"Se escucha un sonido desde arriba.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"¿Está organizando el desván?",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Subo al desván.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",file="se9012",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=4,sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces? Se escuchó algo de ruido desde abajo...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001232",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal como lo ves, estoy organizando el desván.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías dejar eso para después, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001233",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo que después?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma dentro de poco ese montón de uwabakis, esa estufa y ese\nventilador desaparecerán, ¿no? Podrías dejarlo para cuando regreses del\ncampamento.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001234",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Si lo que dice Akashi-senpai es verdad, entonces todo esto debería ser\nretirado de acá en unos días, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001235",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Toritani reacciona a mis palabras con una mirada filosa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué hiciste esa especie de interrogatorio capcioso hace un rato?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001236",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Interrogatorio capcioso? Ahh, eso... sí. Tal vez lo haya sido, ¿quizás? ¿Te\ndesagradó?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo que no me pareció muy tipico de ti...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001237",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? ¿No fue más bien Akashi-senpai quien parecía estar distinto a\nsiempre?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001238",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se descuidó, y demasiado como para caer en esas preguntas capciosas tan\nbásicas... ¿No habrá tenido la cabeza ocupada en algún otro asunto?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001239",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ese hombre es un experto en engañar y mentirle a los demás, pero no es experto\nen ser engañado o mentido. De ser el mismo de siempre no caería en ese tipo\nde preguntas capciosas.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Preguntas capciosas.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="black",path=":bg/"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=4,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, me lo imagino. Thomas también fabricó un conjunto de prendas capaces de\ndisolverse para el evento para atraer nuevos integrantes, así que supongo que\nver eso también te pudo haber inspirado.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"cgdel",id=-1},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=4,sync=0},
{"extrans"},
{"text"},
text={
ja={
{
"Es raro que Toritani lance ese tipo de trampas.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Fue en marzo cuando Akashi estuvo buscando los compuestos químicos.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Y por supuesto, la búsqueda de nuevos integrantes se hizo en abril.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"El alboroto que se formó con los trajes disolubles al agua que Thomas fabricó\nsucedió mucho después de que Akashi estuviera buscando los químicos.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"No hay forma de que Akashi haya sido inspirado por eso. Pues en ese caso, la\ncausa antepondría a la consecuencia.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001240",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así como ves a Akashi-senpai, tiene una excelente memoria. Es imposible que se\ntropiece descuidadamente con una simple pregunta capciosa.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, eso del arte para disolver la ropa es mentira.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=4},
{"fgact",ch="真琴",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001241",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. 100 % mentira. Se le ocurrió en ese mismo momento. De no ser así, no\nhubiera cometido ese error tan grave.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001242",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai estuvo buscando varios disolventes potentes con un cierto\nobjetivo en mente. Y además, aún no ha cumplido ese objetivo. Creo que sería\nlógico pensar eso.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué crees que Akashi aún no ha logrado su objetivo?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001243",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa es una pregunta muy tonta. Deberías saberlo, Kusanagi. Akashi-senpai estuvo\nbuscando los disolventes durante marzo, y además...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Toritani señaló el montón de uwabakis que estaban dispuestos sobre el desván.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001244",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ese gran bulto de uwabakis.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001245",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además de la enorme estufa y el ventilador de uso industrial. Todo esto lo\nobtuvo durante los primeros días de abril.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una gran cantidad de uwabakis, derretibles al calor, y una enorme estufa. Y un\nventilador industrial para secar instantáneamente los objetos derretidos.\nTodo juntado para lograr un único y específico objetivo. Es lo único que se\nme viene a la mente.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=4},
{"fgact",ch="真琴",act="うなづく",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001246",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo. Excelente, Kusanagi. Ya te habías dado cuenta de que todo lo que\nAkashi- senpai reunió en abril es material de pintura para crear algo,\n¿no?...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ni siquiera hay prueba certera alguna de que todo eso es material para\npintar. En primer lugar, no tenemos idea alguna de lo que está tratando de\nhacer...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001247",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero sabes por lo menos 'dónde' es que planea hacerlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Además de eso, Akashi estaba muy pendiente del reporte semanal del clima.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"En conclusión, ya tenemos una muy buena idea del lugar y la fecha del plan.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque tu forma de actuar no ha sido de lo mejor tampoco, eh. La razón por la\ncual sabías que yo estaba investigando la iglesia es porque tú misma estabas\nenterada de que había algo particular en ella, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001248",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás parcialmente en lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001249",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo idea alguna de lo que hay en esa iglesia. Simplemente estuve\nsiguiéndole la pista a los movimientos de Akashi- senpai. Él también iba y\nvenía de la iglesia como tú, y en una de las veces que lo seguí, te vi\ncasualmente. Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que estuviste siguiéndolo. Te decidiste por el método más ortodoxo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001250",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no hay manera de que alguien como él caiga ante esos métodos tan\nfrontales. Seguramente se dio cuenta de que lo estaba siguiendo...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es bastante agudo... Tiene cierto instinto animal, o algo parecido...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001251",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai ha estado investigando esa iglesia desde hace un buen tiempo.\n¿Recuerdas la parte de los globos que salió en la conversación hace un rato?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo del vuelo que hizo con los globos y la muñeca inflable, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001252",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa muñeca inflable sirvió únicamente de adorno. Una simple farsa, muy típica\nde senpai, usada para esconder su verdadero objetivo. Y ese verdadero\nobjetivo era volar con los globos.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que de verdad quería cruzar el Pacífico volando con globos así como lo hizo\nel señor de los globos?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001253",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto que no. Ese vuelo lo hizo para observar la estructura completa de\nla iglesia. Sobre todo, la estructura superior, la cual es difícil de ver.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para observar?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001254",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Falló en el aterrizaje y se fracturó, pero parece que logró un tiempo de vuelo\nbastante largo. Según dicen, estuvo cerca de 1 hora flotando en el aire.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto tiempo así estuvo flotando en el aire?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001255",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que se armó el escándalo ese día. Si solo hubiera volado por unos\nminutos nadie lo hubiera visto. Parece que duró bastante arriba.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, según lo que me has dicho entonces, quieres decir que él fijó un ancla\npor algún lado y se mantuvo en una posición fija durante todo el vuelo.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, lo que dices no sirve de prueba para aseverar que él de verdad\nllenó de helio a la muñeca inflable y voló para ver la iglesia desde arriba.\nEs simplemente una posibilidad, nada más.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001256",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estoy diciendo esto sin prueba ninguna. Normalmente sería descabellado\npensar que alguien pudiera hacer eso, pero Akashi-senpai es capaz de eso y\nmás. Toma, observa esto...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"msgoff"},
{"se",file="se9012",vol=50,id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=4},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=4},
{"se",stop=1,id=1,time=500},
{"fgact",ch="真琴",act="うなづく",lv=5,id=4},
{"text"},
delay={
[100]={
{"se",file="se2497",vol=50,id=2},
},
},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001257",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son las fotos, dibujos y apuntes que Akashi-senpai tomó. También hizo un\nanálisis estructural detallado. Por eso te estoy diciendo que eso lo hizo\npara averiguar la estructura arquitectónica de la iglesia desde el cielo.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ciertamente, esto es...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Eran apuntes que claramente serían imposibles de obtener de no observar la\niglesia desde arriba. Esta es la prueba determinante de lo que dice Toritani.\nViendo esto, no cabe duda de que él voló para averiguar la estructura de la\niglesia.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... ¿por qué tienes las fotos que Akashi tomó?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0015",head="mak_z2d",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001258",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El colegio confiscó todas las cosas de Akashi-senpai. Y era lo más obvio,\ntenían que confiscarle todo después de haber formado ese alboroto.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿por qué tienes esto?...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0002",head="mak_z2b",lv=5,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0016",head="mak_z2b",lv=5,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001259",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, digamos. Dicen que solo una serpiente conoce el camino que otra serpiente\nsigue, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Ya veo, así que seguramente fue por Wakata...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Ya pasó una vez cuando Toritani había encontrado los bocetos de Kenichiro\nKusanagi. La verdad que me da la cierta sensación de que el mediador que\nactúa entre ella y Wakata es alguien distinto a un simple profesor o\nestudiante.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que llegaste a investigar todo eso. ¿Y bien? Sabiendo tanto,\n¿puedes predecir lo que Akashi planea hacer ahora?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001260",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Recuerdas lo que respondiste cuando te pregunté lo mismo hace poco?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0018",head="mak_z2a",lv=5,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001261",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'No, no es que tenga nada concluyente respecto al asunto, pero... En fin, ¿aún\nsigues sospechando que Akashi está tramando algo?'. Por Dios, ¿de verdad\nhablabas en serio cuando dijiste eso?... Ya deberías saber en buena parte lo\nque planea hacer, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, de verdad en aquel momento no tenía ninguna prueba decisiva. Realmente solo\nera un presentimiento...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001262",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues así estoy yo también ahora. Aún no tengo ninguna prueba concluyente para\nresponder eso... Solo que...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo que?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001263",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001264",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, en fin, no es momento de seguir con esta conversación inútil. Y es que\nen 3 días nos iremos de campamento.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001265",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No vas a ir?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A Kawachino no le gustará que yo vaya, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0003",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001266",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no es verdad. Le agradas bastante a Yuumi a pesar de como habla y\nactúa.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Le agrado a Kawachino? Deja las bromas, eso es imposible.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001267",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, supongo que es inevitable que lo veas de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001268",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero, Yuumi también quiere que vayamos todos juntos. Todos los miembros del\nclub de arte, juntos. Tanto tú como Kei, y por supuesto Akashi y Thomas\ntambién. Ella quiere ir con todo el club de campamento.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Todos juntos? No puede ser, eso es totalmente descabellado. En especial\nThomas, ella lo repudia por completo, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001269",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente no tienes ojos para observar a los demás, eh. Esa muchacha se\npreocupa bastante por el club. Ella entiende muy bien que el club de arte de\nYumihari está compuesto por todos, y no por unos pocos.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?... La verdad es que no entiendo nada al respecto, pero en fin,\nvayan ustedes y diviértanse.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001270",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Aún después de haberte dicho todo esto no piensas asistir? Qué corazón tan\nfrío tienes, eh.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa tener el corazón frío... Por lo menos tengo uno.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001271",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué clase de chiste malo fue ese?... Qué ridículo.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí. Ciertamente fue un chiste bien malo...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, bien...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001272",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vas de vuelta a la sala?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que sí. Tengo que ayudar a Rin y a Kawachino con sus pinturas.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001273",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, realmente eres malo mintiendo...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dijiste algo?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001274",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Yo? Nada. ¿No deberías irte ya? Aún siendo verano, si te quedas parado sin\nhacer nada la noche va a llegar. No hay forma de investigar bajo la\noscuridad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya veo, ya veo, todo lo ves, todo lo sabes, eh, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001275",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si de verdad pudiera saberlo todo tan fácilmente no habría sufrido tanto para\nllegar a averiguar esto... Por Dios... ¿Por qué no me di cuenta en abril?...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Toritani susurra eso, con un tono amargo.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うんうん",time=125,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001276",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, sí, que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_08_2"},
{"text"},
linkback="block_00233",
},
label = {
top={block="block_00000",label=1},
},
}
