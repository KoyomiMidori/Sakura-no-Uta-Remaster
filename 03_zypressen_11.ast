astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c09_01",path=":ev/ev_eye_c09/",set="ev_eye_c09"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ey.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002226",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sola hoy, eh.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002227",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Hace un rato vino Yuumi a decirme algo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A decirte algo?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0015",head="rna_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002228",ch="rna"},
},
ja={
{
name={"Rina"},
"“'¿Para qué quedarme si igual viene Kusanagi? Me da náuseas solo de tenerlo al\nlado, me iré ya'. Eso dijo.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... El odio que Kawachino me tiene no cambia, eh.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002229",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmm, no sé, la verdad. ¿Se le puede llamar odio a eso?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ella misma ha dicho que me odia.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002230",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo no confiaría mucho en lo que dice. Yuumi suele ceder mucho por los demás...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ceder por los demás... Ya no puedo negarlo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0015",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002231",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es algo peculiar la manera en que lo hace, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Cómo vas?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002232",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, creo que es mejor que lo veas con tus propios ojos.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Hikawa me muestra su cuadro.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Está quedando muy bien...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0003",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002233",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Gracias.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No piensas presentarla en la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002234",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? ¿No se enojará Toritani por eso?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002235",ch="rna"},
},
ja={
{
name={"Rina"},
"“No creo que Toritani-senpai sea capaz de hacer algo así.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, conociendo como es, no creo que te obligue a hacerlo...\nPero viendo lo bueno que está quedando esto, no estoy muy seguro de que desista fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002236",ch="rna"},
},
ja={
{
name={"Rina"},
"“Le diré que presentaré el año que viene, o sino el próximo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El año que viene o el próximo?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0003",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002237",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. De verdad quisiera pintar este paisaje en época de cerezos.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dirás lo contrario, pero realmente eres estricta con tus obras, Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002238",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muh.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2d0100",face="d0005",head="rna_z2d",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Hikawa pone su dedo sobre mis labios.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0017",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002239",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así no.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿A-Así no, qué?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0005",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002240",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, ayer confesaste tus sentimientos por mí, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0017",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002241",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A qué viene el 'Hikawa'? Se supone que deberías llamarme Rina. ¿O me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, claro. Espera, ¿era solo eso?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0005",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002242",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ayer sí me llamaste por mi nombre.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, es que estaba en plena declaración de amor...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0011",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002243",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaaa, así que solo planeabas hacerlo una sola vez... Es realmente una lástima.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Rina voltea su cabeza a un lado.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, por supuesto que, no... Rina.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002244",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué? ¿Por qué esa cara?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002i",head="rna_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002245",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, solo que... me da algo de pena, ahora que me llamas por mi nombre.\nAjaja.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien lo pidió.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002246",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Rina vuelve a hacer su cabeza a un lado. Ahora con sus orejas rojas como\ntomates.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Empiezo a sentirme algo apenado yo también.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013i",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002247",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? D-Dime.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, solo, me preguntaba si... realmente, soy el indicado para ti.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008i",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002248",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pero qué tonterías dices, Senpai? Soy yo la que debería preguntarse eso...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Ya te lo dije, eres la única mujer con la que quisiera\nestar, por eso te elegí a ti.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002i",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002249",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Pues, yo también siento lo mismo por ti... Desde aquel día, yo... he estado\nloca por ti...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Desde aquel día?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0016",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002250",ch="rna"},
},
ja={
{
name={"Rina"},
"“Desde el momento en que me dijiste aquellas palabras chuuni. ¿Debería\nrecordártelas?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no. Paso...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Lo que le dije al convertir el ciprés en cerezos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Ya me lo había recordado antes, ahora que lo pienso.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002251",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo no se me iba a sobresaltar el corazón después de que me dijeran algo así?\nY con tanta soltura...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero fue algo ridículo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002252",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás, pero ese dibujo fue hecho para mí. Eso lo hizo especial.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Eso crees?...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002253",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso creo. P-Por eso siempre digo que eres malicioso, e injusto.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A cada rato me lo dices.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0015",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002254",ch="rna"},
},
ja={
{
name={"Rina"},
"“Después de que alguien hace algo tan grande por ti, viene y te dice eso. No\npodría pensarlo de otra forma.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002255",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y más cuando ese alguien dedicó su última obra por ti... Es simplemente\nespecial.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿L-Lo es?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002256",ch="rna"},
},
ja={
{
name={"Rina"},
"“Era inevitable terminar enamorada después de que hicieras eso por mí. Más\nextraña me parece la razón por la cual tú me elegiste a mí.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya te lo dije una vez, ¿o no? La razón por la cual me enamoré de ti...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002257",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. La razón por la cual me cautivaste.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002258",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recuerdo habértelo dicho ya. Que amo como eres ahora.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002259",ch="rna"},
},
ja={
{
name={"Rina"},
"“L-Lo recuerdo. Pero...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",stop=1,time=1000},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002260",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Ambos nos quedamos en silencio.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Oye, Rina.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002261",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008i",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002262",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"msgoff"},
{"se",file="se0744",id=1},
{"fg",ch="里奈",time=300,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="里奈",size="z2",time=300,sync=1,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=9},
{"se",stop=1,id=1,time=500},
{"quake"},
{"quake",mode="mw"},
{"se",id=2,file="se3356"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Rina me abrazó.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002263",ch="rna"},
},
ja={
{
name={"Rina"},
"“T-Te di un abrazo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo estás haciendo...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002264",ch="rna"},
},
ja={
{
name={"Rina"},
"“Q-Quiero decir, somos pareja, ¿no? Puedo hacer este tipo de cosas, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002265",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Salir con alguien es algo asombroso. Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿I-Increíble? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002266",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-Digo, me parece asombroso que todo lo que quería hacer y no podía, puedo\nhacerlo ahora con tanta facilidad...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿es que siempre has querido hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002267",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero qué manera de decirlo. La diferencia está en poder o no poder.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002268",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre me has gustado, y estuve aguantando las ganas todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002269",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue de ese ambigua frontera de donde surgió lo de jugar a ser tu hermanita...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que es extraña esa frontera.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002270",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Sigue diciendo eso y me enojaré y te besaré!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno... cierra los ojos entonces.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0014i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002271",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh ¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No quieres?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002272",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que sí. La pregunta en sí es estúpida...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002273",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Pongo mis manos sobre sus hombros... Rina se pone de puntillas, estirándose un\npoco.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002274",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sin poner resistencia alguna, cerró sus ojos lentamente.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Acerco mi cara a la suya, poco a poco.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Y comienzo a sentir su aliento.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"se",id=1,file="se_chu"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002275",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te di un beso.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002276",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, Rina.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002277",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-Dígame, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No quisieras venir a mi casa hoy, o tal vez algún otro día? A mi apartamento\nen Sakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002278",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? P-Por supuesto que me encantaría, pero... ¿No te molestaría?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No sería la primera vez que vas a mi casa, además.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002279",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí, bueno, ciertamente solía ir con frecuencia cuando éramos niños...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010i",head="rna_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, esperaré a que termines de pintar.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008i",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",size=5,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002280",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, s-sí, está bien...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"ex",time=500,func="wait"},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002281",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",size=3,lv=4,id=9},
{"se",file="se2405",id=1},
{"ex",time=500,func="wait"},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002282",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002283",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No puedo seguir...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002284",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, solo que... ¿Cómo podría decirlo?... No logro concentrarme...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad? Pero si hasta hace un momento estabas pintando como si nada.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002285",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues hasta hace un momento no nos habíamos besado aún. Y además estaba sola.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Te estoy interrumpiendo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0013j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009j",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002286",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡P-Por supuesto que no! Si llegas a irte ahora mi conmoción no se limitará solo\na este cuadro...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vale...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002287",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siento que han estado ocurriendo muchas cosas que jamás soñé que ocurrirían.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Crees? Considerando que estamos en una relación, diría que no es tan\nextraño.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008j",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002288",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, sí, pero... aun así, se me hace raro.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002289",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-Digo, y solo por, por decir. A veces me pregunto, si, si realmente puedo\npedir más...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pedir más? ¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002290",ch="rna"},
},
ja={
{
name={"Rina"},
"“R-Recostarme contra ti, por, ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Recostarte?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002j",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002291",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, recostarme.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, si es por eso no tengo problema alguno...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002292",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Será que también puedo sentarme encima de tus piernas?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, no hay problema...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011j",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002293",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hay problema... Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Rina se me acerca aún más. Mis ojos notan su blanca piel, y siento el peso de\nsu tierno cuerpo ahora sobre mis muslos.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_com_d09_01",path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002294",ch="rna"},
},
ja={
{
name={"Rina"},
"“M-Me he recostado sobre ti.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, lo estás haciendo...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_002295",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se siente algo raro.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Rina reposa poco a poco su cuerpo sobre el mío.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_d09_02",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002296",ch="rna"},
},
ja={
{
name={"Rina"},
"“U-Uwaaa... Uwa, uwa, uwaaaa.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rna_002297",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, nada, solo que, la sensación de tu pecho es simplemente maravillosa...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_d09_01",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002298",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, realmente se siente bien estar en los brazos de un hombre robusto. Y estas\nmanos, solo con mover un poco estas manos...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Rina toma mis brazos y los lleva frente a ella, abrazándola.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_d09_03",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002299",ch="rna"},
},
ja={
{
name={"Rina"},
"“Waaa, waaa, y ahora me abrazas. La emoción, no puedo contener la emoción.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_d09_04",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002300",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre he querido que me abrazaras así, por detrás. Y ahora que se cumplió ese\ndeseo, siento que esto me encanta.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? De ser así...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Abrazo a Rina con aún más fuerza.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rna_002301",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwah, me has apretujado. Fue una fuerte apretujada.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo hice con esa intención.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bg",file="ev_com_d09_05",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002302",ch="rna"},
},
ja={
{
name={"Rina"},
"“Soy feliz.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. No creí que te contentarías haciendo esta clase de cosas...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_d09_06",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002303",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Muh! ¿Esta, clase, de cosas? ¡Cualquiera soñaría con tener a la persona que le\ngusta abrazándole por detrás!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"se",file="se9010",vol=50,id=1},
{"mwact",act="おじぎ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002304",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hm, hm.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Rina toma con fuerza mi brazo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_d09_04",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002305",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tus manos... Esto es maravilloso.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rna_002306",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedo creerlo. No puedo creer que estoy ahora en tus brazos.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rna_002307",ch="rna"},
},
ja={
{
name={"Rina"},
"“No se siente real.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? Yo sí lo siento.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rna_002308",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tus latidos.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rna_002309",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mis latidos? ¿Eh, e-en serio?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Siento tu calor, y tus latidos...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu calor y tus latidos me hacen entrar en cuenta que esto es real.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_d09_07",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002310",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajajaja, a-ahora que lo dices, creo que también siento algo de calor en mi\nespalda también. S-Solo de pensarlo así, me da algo de pena.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te da pena?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rna_002311",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero decir, es pena... pero pena, por tanta felicidad, y... me causa algo de\nvergüenza.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Abrazo a Rina por detrás.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_com_d09_05",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002312",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes, Kusanagi-san? Siempre me gustaste.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rna_002313",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero sentía que nunca podría tenerte...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rna_002314",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre estabas cerca a mí. Me hablabas, y me tratabas bien... Fue justamente\neso lo que me hizo verte como algo inalcanzable...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rna_002315",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mientras más cerca te tenía, más temía que no podría pedir más.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rna_002316",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso siento esto como un sueño.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como un sueño...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rna_002317",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Es como un sueño.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rna_002318",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las olas, golpeando con tan placentero ímpetu, eran tan agradables que la noche\nse me hacía eterna, e inesperadamente me quitan el sueño.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, aquel palíndromo.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rna_002319",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Y me da miedo de despertar de este sueño, y que esta felicidad se vaya.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese poema también tiene otro significado. 'Las olas golpeaban el buque a un\nritmo tan placentero que me hacía olvidar el paso de las horas, y la noche se\nme hacía tan larga que el amanecer pareciera no llegar jamás'.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La manera de ver los sueños depende de uno mismo. Quizás este tiempo de ensueño\nse acabará en algún momento, o tal vez seguirá, sin fin alguno. Lo que\ncaracteriza a este palíndromo es que puedes asumirlo de alguna de estas dos\nmaneras.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rna_002320",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sabía. Sí, ciertamente depende de uno mismo.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé tú, pero yo... pienso vivir este sueño hasta la muerte.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_d09_08",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002321",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"El rostro de Rina se pasma en asombro.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rna_002322",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Ehhh? ¿L-Lo dices en serio? Solo lo dijiste por decir, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rna_002323",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo de... hasta la muerte...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gusta la idea?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rna_002324",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo podría desagradarme? Y, a-además, lo que acabas de decir, podría\ninterpretarse también como una propuesta de matrimonio.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo puedes tomar de esa forma también.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002325",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm, dónde está, agh.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"De repente, Rina comenzó a buscar algo en los bolsillos de su falda.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rna_002326",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-Dilo una vez más. Por favor.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué me estás apuntando con tu teléfono?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rna_002327",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Grabaré esas palabras! ¡Así que dilo de nuevo, te lo ruego!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rna_002328",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Tomaré la grabación y la usaré como despertador, tono de llamada, tono de\nencendido del celular, timbre de la casa, sirenas y en bocinas!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que en tu lista hay unas cuantas cosas prácticamente irrealizables...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rna_002329",ch="rna"},
},
ja={
{
name={"Rina"},
"“Para nada, así de conmovedoras fueron tus palabras. ¡Bien, a grabar!”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“To-n-ta, obviamente no voy a grabar nada.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rna_002330",ch="rna"},
},
ja={
{
name={"Rina"},
"“*Gaaan*, ¿no te gusta que te graben?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo diré tantas veces como me lo pidas. Te amo, Rina. Cuidaré de ti y te haré\nfeliz mientras siga con vida.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002331",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si te pones a escuchar lo mismo las 24 horas del día te cansarás, eso es\nseguro.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_rna_002332",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no. Por cierto, grabé eso. Recibiré mi porción de felicidad\ntodos los días escuchándolo.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿no te dije que te lo diré tanto como quieras?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rna_002333",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Dilo tanto como puedas, aprovecharé de grabarte en cada ocasión!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a llenar la memoria de tu teléfono.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_rna_002334",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo mantendré conectado a un disco duro externo en todo momento, no hay problema\npor eso.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no le puedes llamar teléfono inteligente a eso.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",file="ev_com_d09_04",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002335",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tema aparte, ese 'te amo' y este abrazo tienen a Rina muy feliz en este\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Me contenta escuchar eso.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bg",file="ev_com_d09_07",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002336",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ufufu...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rna_002337",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, hoy podré ir a tu casa. Ya no puedo esperar.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vamos ya entonces? De ir muy tarde no podrás estar mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",file="ev_com_d09_04",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002338",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tienes razón, me gusta ese plan. Pero, pero pero...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"bg",file="ev_com_d09_07",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002339",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si nos tardamos quizás pueda perder el último tren.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu casa está algo lejos de la mía, pero no tanto como para no poder regresar\ncaminando.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, de pasar eso te acompañaré a casa.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rna_002340",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa también es una idea maravillosa, pero te haré caminar mucho.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta, si lo propongo es porque quiero hacerlo. Debe ser genial caminar juntos\nde noche, viendo las estrellas.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bg",file="ev_com_d09_08",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002341",ch="rna"},
},
ja={
{
name={"Rina"},
"～～～～",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Rina le da golpecitos a mi brazo.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_rna_002342",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Quieres matarme de felicidad?!”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie muere de felicidad.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_rna_002343",ch="rna"},
},
ja={
{
name={"Rina"},
"“Claro que sí. Tanta felicidad podría provocarme un shock y matarme.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás deba entonces racionarla.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"bg",file="ev_com_d09_04",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002344",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no me gustaría mucho eso.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Degusta entonces de la felicidad y evítate el shock.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La felicidad no te sabrá a nada a menos que tú misma procures degustarla.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_rna_002345",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Suenan profundas esas palabras. ¿Las leíste en algún lado?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Simplemente se me ocurrió después de ver la vida de alguien. Fue de ahí que\npensé que la felicidad debe degustarse...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_rna_002346",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Rina hunde su cara en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"bg",file="ev_com_d09_05",sync=0,face=1,time=400,path=":ev/ev_com_d09/",set="ev_com_d09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_rna_002347",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy degustando la felicidad. De esta manera.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que la puedas degustar mucho dentro de mis brazos.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_rna_002348",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo no? Estoy saboreándola como nunca ahora. Rina se siente feliz.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_rna_002349",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquel día me diste el valor para vivir.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_rna_002350",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y ahora, me has dado la felicidad de vivir.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_rna_002351",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gracias, por tanto.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_rna_002352",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que lo es. Todo esto que me has dado es preciado para mí. Y ahora\nquiero dar mi vida por ti, con todo lo que me has otorgado.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rna_002353",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé si pueda hacerte feliz. No sé si pueda permanecer con buena salud. Pero\nde igual forma, daré mi vida por ti.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hacerme feliz?... Se supone que eso lo debe decir el hombre, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_rna_002354",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa distinción de hombre y mujer ya no existe en estos tiempos. No sabré qué\nhacer con todo este amor que te tengo de permanecer tan pasiva.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_rna_002355",ch="rna"},
},
ja={
{
name={"Rina"},
"“Explotaré de tanto amor.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_rna_002356",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que recíbelo, por favor. Todo este amor que tengo por ti.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_rna_002357",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Esto... Kusanagi-san... ¿Puedo... besarte?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta, no hace falta que preguntes.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo cierra lentamente tus ojos cuando quieras un beso.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_rna_002358",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, pero entonces... no podré abrir los ojos de nuevo jamás.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?... ¿Es que en todo momento quieres que nos besemos?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_rna_002359",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Yo sí...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja... Entiendo, está bien, cierra los ojos solo cuando no aguantes las\nganas de besar entonces.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_rna_002360",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Rina cierra sus ojos.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Y mis labios tocan los suyos.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="fem_rna_002361",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nmm... *chuu*, ah... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Sin decir una sola palabra...",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Allí nos quedamos besándonos, una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="eveningsky_winter",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002362",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwaaah, cuánto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que sí. Pasa.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"cgdel",id=-1},
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Invito a Rina a pasar.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",size=3,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002363",ch="rna"},
},
ja={
{
name={"Rina"},
"～～",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Pero por alguna razón, no se movía de la entrada.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? ¿No vas a pasar?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002364",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Sí! ¡¿Cómo no lo haría?!”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002365",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo que estaba en un pequeño éxtasis.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Solo por pasar?”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002366",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno, quiero decir, es la primera vez que entro a tu casa como tu novia...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es la primera vez.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002367",ch="rna"},
},
ja={
{
name={"Rina"},
"“Llegué a entrar varias veces cuando era pequeña, pero ahora que somos adultos\nno había tenido la oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues claro, nadie podría dejar a una mujer joven entrar al apartamento de un\nhombre soltero.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002368",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Y justo ahora estoy a punto de entrar a ese apartamento. Tengo que\ndegustar este momento.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina, estás degustando demasiado de todo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002369",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa. Quiero saborear bastante, muchísimo.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002370",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues ahora, en este momento, soy feliz.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Bien, mi amada señorita...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Le extiendo mi mano.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bienvenida a mi humilde morada. No es tan espaciosa, pero bien que haré que te\nsientas como en casa.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002371",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡C-Con gusto!”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2d0100",face="d0012",head="rna_z2d",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rina toma mi mano.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La mano te tiembla un poco, ¿qué pasa? ¿Estás nerviosa?”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0008",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002372",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Estoy temblando por las cosas tan lindas que dices!”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, solo lo dije de una manera un tanto tonta.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0010",head="rna_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002373",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero te veías muy apuesto diciéndolas, ahí está lo malo. Contrólate un poco o\nme matarás.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás perdiendo el control...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"se",file="se9002",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,id=1,time=500},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002374",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mmm? Está muy arreglada la casa.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hubo alguien que la limpió por mí hace un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002375",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hmmm, una mujer, ¿o me equivoco?...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? P-Pues, sí, ¡pero no sucedió nada!”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002376",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, está bien. Sé que jamás harías algo así, y quizás suene repetitivo ya,\npero sé también que te has involucrado en los problemas de muchas personas...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad está bien?”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002377",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, confío en ti. Así que si llegas a traicionarme, cosas terribles podría\nsuceder...”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero créeme que jamás haría algo así.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002378",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo sé. Nunca he dejado de tener ojos para ti... Si hay algo que sé, es qué tipo\nde persona eres.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002379",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cuánta presencia podría tener alguien que se hace llamar tu hermanita?\nNinguna. Pero fue gracias a eso que pude permanecer a tu lado sin que se\nviera raro.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002380",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y gracias a eso, pude estar siempre cerca de ti, todo este tiempo...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002381",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso me siento algo agradecida de haber propuesto lo de 'hermanita' aquel\ndía.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002382",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás fue una opción mucho mejor a lo de convertirme en discípula...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002383",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hacerse llamar hermanita es convertirse en algo que es y no es. Es esa\nambigüedad lo que me hizo tan imperceptible.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Imperceptible? Alguien que se hace llamar y pasar por hermanita resalta\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002384",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es solo cuestión de nombre. En realidad creo que nunca me he comportado de\nmanera que resalte mucho. Siempre ha sido un juego.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002385",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre he sido buena para camuflarme entre todos... No sé si habrá sido\nconsciente o inconscientemente, pero terminé eligiendo el lugar donde podría\nestar a tu lado.”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002386",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me importara en que lugar tuviera que estar, con poder estar a tu lado era\nfeliz.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no tienes que preocuparte por eso. Quiero que estés conmigo.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012i",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002387",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002388",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, realmente no te da reparo decir cosas vergonzosas en los momentos más\nsensibles. Aunque ya lo había notado desde hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, digamos que parte de mí tiene una fuerte tendencia chuuni.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002389",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tendencia que produce comentarios que por lo general siempre me sacuden...”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002390",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahh, ¿qué debería hacer? Ya me gustabas bastante, pero ahora siento que estoy\nen caída libre. Fuuh... auuuh, auhh.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué las contorsiones y los quejidos?”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002391",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Es que, ahora que lo pienso, estoy ahora sola contigo, en tu casa...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ahora que lo piensas? Se supone que ya sabías que yo vivía solo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002392",ch="rna"},
},
ja={
{
name={"Rina"},
"“Q-Quiero decir, apenas acabo de recordarlo... Ahh, siento mi rostro algo\ncaliente. ¿P-Podría sentarme?”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"fg",mode=-2},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"Rina se sienta en el sofá de la sala.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="fem_rna_002393",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ejeje... por fin me senté.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que planeabas quedarte todo el rato parada?”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-580,x=-90,file="zbg023b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"cgact",stage="zbg023",y=120,act="うなづく"},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"Le sigo y me siento yo también en el sofá.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_rna_002394",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Muh, ahí no!”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
"Rina se para y se acerca a mí.",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"Y entonces, se sienta a mi lado.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0100",face="b0001",head="rna_z2b",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0017",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002395",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué te sientas en la parte más alejada del sofá?...”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es por ninguna razón en particular... Es solo costumbre, por lo general\ncuando recibo a huéspedes me siento acá...”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0004",head="rna_z2b",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002396",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Aunque me alegra que te sentaras acá. Esta parte es menos espaciosa,\npodemos estar más apretaditos.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"La parte del sofá en forma de L donde estaba sentado ahora solo tiene espacio\npara una persona. Teniendo a Rina acá también, definitivamente estamos\napretujados.",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0002",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002397",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"El aroma y la sensación de la piel de Rina me emboscan.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Hasta ahora me había hecho el impasible ante su sensación, pero... estoy ya al\nlímite.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0008",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002398",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Kusanagi, san?...”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
"Rina alza su cara y me ve de cerca... Es demasiado linda...",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Me dejo llevar por mi deseo y la abrazo.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002399",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah... gh... K-Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
"Sorprendiéndose por un momento, Rina me abrazó de vuelta con aún más fuerza.",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
vo={
{"vo",file="fem_rna_002400",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Tu pecho, se siente tan cálido...”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también siento tu calor...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Nos quedamos abrazados un rato. Y entonces, Rina cerró los ojos.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"Y nos besamos.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002401",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nmm... gh.”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
vo={
{"vo",file="fem_rna_002402",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm... fuuh... ngh, nm... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
vo={
{"vo",file="fem_rna_002403",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... whew... gh.”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_rna_002404",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... nnmm... mm, mm... ngh...”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
"Fue un largo, largo beso.",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
"Y a pesar de eso, sentía que cada vez quería más.",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"mwact",act="うんうん",time=300,size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002405",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... mm... *chuu*... Jaa... Está bien... Yo, también, quiero sentirte más,\nKusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
"Con sus ojos fuertemente cerrados, Rina abrió un poco su boca.",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
vo={
{"vo",file="fem_rna_002406",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh... Ah, mm... ¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"Entro dentro de ella con mi lengua, y la siento.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"mwact",act="うんうん",time=300,size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002407",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... *chuum*... ngh, *rero*... *jururu*... ngh...”",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
vo={
{"vo",file="fem_rna_002408",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... ngh...”",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Al alejarnos un poco, un hilo de saliva se formó entre los dos. Incitándonos a\nmás.",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
vo={
{"vo",file="fem_rna_002409",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... Jaa, jaa... haaaa.... ngh.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
vo={
{"vo",file="fem_rna_002410",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... Jaa... haauh...”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"Rina jadea. Pero aun así, sus manos no me dejan ir.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-580,x=-90,file="zbg023b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010j",head="rna_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina... ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002411",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... ¿Podemos... hacerlo, de nuevo?...”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002412",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... ngh...”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
"Volvemos a unir nuestros labios. Y ahora la lengua de Rina entra dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"mwact",act="うんうん",time=300,size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002413",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngah... Jaa, jaa... mm, nng... mm... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
"Nuestras lenguas se anudan una con la otra. Rina me toca más ahora, con menos\nrecelo.",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"mwact",act="うんうん",time=300,size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002414",ch="rna"},
},
ja={
{
name={"Rina"},
"“*Nmooch*, *chuu*... ngh, *rerorero*... ngh, *chuu*, *chuu*... *chuuu*...\n*rerorero*...”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
ja={
{
"Al chupar de su lengua, su saliva y aliento entraron dentro de mí. Nuestros\nlabios se rozan entre sí, buscando sentir más del otro.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina...”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002415",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah... ngh...”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
vo={
{"vo",file="fem_rna_002416",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, *chuu*, *rerorerorero*... Jaa, ngh, *chuuchuu*... *rero*, *rero*...”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
"Poco a poco, Rina comenzó a concentrar sus movimientos en la punta de su\nlengua.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002417",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh... *chuu*, *chuu*... *rerorero*... *chuuchuu*... *chuuuu*...”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
"La tierna sensación de su lengua hace que mi zona inferior reaccione.",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
ja={
{
"A mitad de la faena, dejo de besarla.",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-580,x=-90,file="zbg023b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010j",head="rna_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009j",head="rna_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002418",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nmm, mm... E-Eh... ¿Sucede... algo?”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
"Hasta hace poco, solo era como una hermana pequeña para mí.",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
ja={
{
"No sé si por orgullo o por querer mostrarme bien, pero siento que debo llevar\nla iniciativa y guiarla...",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
"Pero, de seguir así las cosas, creo que mis deseos carnales me harán perder el\ncontrol...",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
ja={
{
"Y por más intención que tenga de llevarla de la mano, acabaré vencido por mis\nimpulsos y tirándola a la cama.",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
ja={
{
"No puedo permitir eso.",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡A-Ah, sí! ¿N-No quieres quedarte a cenar hoy?”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002419",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Je? B-Bueno, me gustaría...”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bien, iré a preparar la comida entonces...”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002420",ch="rna"},
},
ja={
{
name={"Rina"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Rina me observa con una expresión fuera de sí, algo decepcionada.",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
"E-Era de esperarse... Después de cortar el beso de esa manera...",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"Pero no me siento muy seguro de poder controlarme.",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"Pude haberla herido de seguir besándonos, y eso me da miedo. Mi amada Rina...",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
ja={
{
"Por los momentos me puse a trabajar en la cocina.",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_12_1"},
{"text"},
linkback="block_00411",
},
label = {
top={block="block_00000",label=1},
},
}
