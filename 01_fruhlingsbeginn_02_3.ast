astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",rule=139,vague=40,file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Las clases de la tarde terminaron sin ningún inconveniente.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Las clases después del almuerzo se sienten relativamente cortas. Es aliviador\npensar que solo falta un poco para terminar.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, creo que me iré ya...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",id=1,file="se1279"},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"En el instante en que traté de salir al pasillo, alguien me agarró la mano.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Toritani-san...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0029",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000391",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué se debe que estés tratando de regresar tan rápidamente? Te mencioné en\nel almuerzo que aún no habíamos culminado la búsqueda de nuevos integrantes,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero como dijiste que cambiarías el método de búsqueda, pensé que ya no me\nnecesitarías...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000392",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya no necesitas llevar esmoquin, pero aun así me ayudarás. Una cabeza por\npersona. No terminarás hasta que me traigas a alguien.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso no capturé a Kawachino-san ayer?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000393",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y acaso no fui yo quien la llevó hasta la sala de arte? Además, apenas me la\nllevé te fuiste.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"¿Cómo es que se dio cuenta de que me fui justo después?",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero cualquiera pensaría que ya no hacía falta continuar después de agarrar a\ntantas personas, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000394",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Valoro más la calidad que la cantidad. En fin, ya sabes, debes traerme a una\npersona.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien. ¿Y? Si es una cabeza por persona, ¿a quién se supone que\ndebo asesinar?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000395",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pretendes hacer matando de verdad?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, es una metáfora, ¿no? Quisiste decir 'medio matar', ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000396",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro que no... ¿Es que acaso no podrías ser menos atento al escuchar a los\ndemás?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",file="se1279",id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000617",ch="ked"},
},
ja={
{
name={"Kei"},
"“Matar, matar... ¿Pero qué clase de conversación tan cruda están teniendo\nustedes dos?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",mode=-2},
{"fg",ch="中里",size="z2",ex04="a0096",my=40,mode=3,resize=1,path=":fg/nst/z2/",file="nst_z2a0000",face="a0002",head="nst_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_nst_000008",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Vengaaaaaa! ¡Kusanagiiiiiiii!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? ¿Ohh?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"se",id=1,file="se2192"},
{"fg",ch="中里",size="z2",ex04="a0096",mode=3,path=":fg/nst/z2/",file="nst_z2a0000",face="a0003",head="nst_z2a",lv=5,id=9},
{"fgact",ch="中里",act="quake",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_nst_000009",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Ugyah!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="中里",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/nst/z1/",file="nst_z1a0000",face="a0003",head="nst_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?... Alumno A, ¿por qué me atacas de repente? ¿No ves cómo terminé\npateándote sin querer?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fgact",ch="中里",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_nst_000010",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¿A-Alumno A?... N-No me llames así.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0001",head="nst_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_nst_000011",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Mi nombre es Nakasato...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bgm",stop=1,time=1000},
{"se",file="se_bafu",id=1},
{"fg",ch="中里",my=40,mode=-1,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_nst_000012",ch="nst"},
},
ja={
{
name={"Nakasato"},
"*se desmaya*.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bgm",file="bgm012"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=960,y=130,speed=80,file="zbg046a",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=80},
{"ex",time=80,func="wait"},
{"fg",ch="一宮",size="z2",ex04="a0096",my=40,mode=3,resize=1,path=":fg/itm/z2/",file="itm_z2a0000",face="a0001",head="itm_z2a",x=0,lv=5,id=10},
{"se",file="se3130",id=1},
{"quake"},
{"ex",time=80,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",x=-960,y=130,speed=80,file="zbg046a",path=":bg/",x2=960,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="一宮",size="z2",ex04="a0096",mode=3,path=":fg/itm/z2/",file="itm_z2a0000",face="a0001",head="itm_z2a",x=0,lv=5,id=10,sync=0},
{"fg",ch="一宮",speed=80,mode=3,path=":fg/itm/z2/",file="itm_z2a0000",face="a0001",ex04="a0096",head="itm_z2a",x2=0,x=-1920,lv=5,id=10,sync=0},
{"extrans",time=0},
{"ex",time=80,func="wait"},
{"fg",ch="東浪見",size="z2",ex04="a0096",my=40,mode=3,resize=1,path=":fg/trm/z2/",file="trm_z2a0000",face="a0001",head="trm_z2a",x=0,lv=5,id=11},
{"se",file="se3130",id=2},
{"quake"},
{"ex",time=80,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",x=300,y=130,speed=80,file="zbg046a",path=":bg/",x2=-960,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="東浪見",size="z2",ex04="a0096",mode=3,path=":fg/trm/z2/",file="trm_z2a0000",face="a0001",head="trm_z2a",x=0,lv=5,id=11,sync=0},
{"fg",ch="東浪見",speed=50,mode=3,path=":fg/trm/z2/",file="trm_z2a0000",face="a0001",ex04="a0096",head="trm_z2a",x2=0,x=1260,lv=5,id=11,sync=0},
{"extrans",time=0},
{"ex",time=80,func="wait"},
{"fg",ch="片貝",size="z2",ex04="a0096",my=40,mode=3,resize=1,path=":fg/kat/z2/",file="kat_z2a0000",face="a0001",head="kat_z2a",x=0,lv=5,id=12},
{"se",file="se3130",id=3},
{"quake"},
{"ex",time=80,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="一宮",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="片貝",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=0,lv=4,id=10,sync=0},
{"fg",ch="東浪見",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué demonios pasa?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_ked_000618",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué hiciste?... Naoya, estamos rodeados.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Al darme cuenta, no sé por qué, pero a nuestro alrededor había un gran grupo de\nalumnos rodeándonos.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa esto? Alumno B, C, y D nos tienen rodeados...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, B, C y D están con una actitud bastante hostil... Pareciera que en\ncualquier momento B, C y D podrían atacarnos...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fgact",ch="東浪見",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_trm_000001",ch="trm"},
},
ja={
{
name={"Torami","Alumno D"},
"“¡Deja de llamarnos de esa manera tan grosera!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_trm_000002",ch="trm"},
},
ja={
{
name={"Torami"},
"“¡Mi nombre es Torami!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_itm_000005",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¿Por qué hablas con ese tono monótono?... Realmente eres un tipo bastante\nsarcástico, eh, Kusanagi. Para comenzar, todos somos del mismo salón, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=-570,lv=4,id=3},
{"fgact",ch="一宮",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_itm_000006",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¡Yo soy Ichinomiya!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=0,lv=4,id=10},
{"fgact",ch="片貝",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ktg_000001",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“¡Y yo soy Katakai, del mismo salón!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Qué quieren de mí, B, C, y D?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0002",head="trm_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_trm_000003",ch="trm"},
},
ja={
{
name={"Torami"},
"“¡¿Vas a llamarnos de nuevo así?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fgact",ch="片貝",act="いいえ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ktg_000002",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Está bien, ya basta de que nos enfrasquemos entre nosotros. La conversación no\navanzará de esta manera.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0002",head="itm_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_itm_000007",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿D-Dónde escondiste a Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fgact",ch="一宮",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_itm_000008",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¡Traidor!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Traidor? No recuerdo haberme vuelto amigo de ustedes en ningún momento...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fgact",ch="一宮",act="いいえ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_itm_000009",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¡Cállate, cállate! ¡¿Qué puedes entender tú?!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ktg_000003",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Así es, yo pensaba que tú eras de los nuestros.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=0,lv=4,id=10},
{"fgact",ch="片貝",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ktg_000004",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¡De la asociación de hombres sin novia!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿te sirve si voy por ellos?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000397",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo he dicho varias veces, con 'una cabeza' quise decir que trajeras una\npersona al club.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=0,lv=4,id=10},
{"fgact",ch="片貝",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ktg_000005",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¡Nosotros sentíamos algo de admiración por ti, de como a pesar de ser apuesto y\npopular con las chicas, vivías en solemne soledad mientras acumulabas tantos\naños sin novia como años llevas de edad!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000398",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vaya? Kusanagi, te están halagando. Están diciendo que admiran lo apuesto y\nsolemnemente solitario que eres.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si quitaran justamente la parte en la que mencionan que nunca he tenido novia,\nentonces ciertamente sí se escucharía como un halago!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000399",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, da igual que no tengas novia. De igual manera te están halagando.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no da igual. Es lo mismo a que se burlen de mí.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",mode=-2},
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0001",head="nst_z1a",lv=4,id=9},
{"fgact",ch="中里",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_nst_000013",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“¡Hoy lo escuchamos todo de Rin-chan! ¡Todos nosotros!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué escucharon?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bgm",stop=1,time=500},
{"bg",file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="man_itm_000010",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Había escuchado que se conocían desde hace tiempo, pero eso es mentira,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000185",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no... es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_itm_000011",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000186",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace tiempo viví en esta ciudad, y ahora que me mudé, pues... personalmente,\nsiento más bien como si hubiera 'vuelto'.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_nst_000014",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Pero no eran tan buenos amigos, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000187",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, pues... por lo menos antes de mudarme, Kusanagi-kun se la llevaba muy bien\nconmigo...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_itm_000012",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿Acaso... ustedes dos son amigos de la infancia...?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000188",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues... Si Kusanagi-kun lo considerara así, entonces... me sentiría algo\nfeliz.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=-680,lv=4,id=1,sync=0},
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0003",head="nst_z1a",x=-210,lv=4,id=7,sync=0},
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=210,lv=4,id=8,sync=0},
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=680,lv=4,id=2,sync=0},
{"extrans",time=500},
{"bgm",file="bgm012"},
{"fgact",ch="中里",act="ジャンプ",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="man_nst_000015",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“¡¿Puedes entender cómo nos sentimos cuando nos dijo eso?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=210,lv=4,id=8},
{"fgact",ch="片貝",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="man_ktg_000006",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¡Te mataremos!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0002",head="trm_z1a",x=680,lv=4,id=2},
{"fgact",ch="東浪見",act="いいえ",size=30,time=100,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_trm_000004",ch="trm"},
},
ja={
{
name={"Torami"},
"“¡UOOOOHHHH!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="black",path=":bg/"},
{"msgon"},
{"quake",dir="h",size=9,time=300,mode="mw"},
{"quake",dir="v",size=9,time=300,mode="mw"},
{"quake",dir="r0",size=9,time=300,mode="mw"},
{"quake",dir="r1",size=9,time=300,mode="mw"},
{"se",id=1,file="se_battle"},
{"ex",time=5000,func="wait"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000400",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=-680,lv=4,id=1,sync=0},
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0001",head="nst_z1a",x=-210,lv=4,id=7,sync=0},
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=210,lv=4,id=8,sync=0},
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=680,lv=4,id=2,sync=0},
{"extrans",time=500},
{"ex",time=0,func="wait"},
{"fgact",ch="一宮",act="いいえ",lv=4,id=1},
{"fgact",ch="中里",act="いいえ",lv=4,id=7},
{"fgact",ch="片貝",act="いいえ",lv=4,id=8},
{"fgact",ch="東浪見",act="いいえ",lv=4,id=2},
{"ex",time=500,func="wait"},
{"se",file="se9013",id=1},
{"fg",ch="一宮",time=200,sync=1,my=40,mode=-1,lv=4,id=1},
{"fg",ch="東浪見",time=200,sync=1,my=40,mode=-1,lv=4,id=2},
{"fg",ch="中里",time=300,sync=1,my=40,mode=-1,lv=4,id=7},
{"fg",ch="片貝",time=300,sync=1,my=40,mode=-1,lv=4,id=8},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que me pasé de 1 cabeza y terminé recogiendo 4. Con esto cumplí ya mi\ncuota, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000401",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nadie dijo que mataras de verdad.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"se",file="se1894",id=1},
{"fg",mode=-2},
{"fg",ch="一宮",size="z1",my=40,mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0002",head="itm_z1a",x=-680,lv=4,id=1},
{"fg",ch="中里",size="z1",my=40,mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0002",head="nst_z1a",x=-210,lv=4,id=7},
{"fg",ch="片貝",size="z1",my=40,mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=210,lv=4,id=8},
{"fg",ch="東浪見",size="z1",my=40,mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0002",head="trm_z1a",x=680,lv=4,id=2},
{"quake",mode="mw"},
{"fgact",ch="一宮",act="びっくり",lv=4,id=1},
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"fgact",ch="片貝",act="びっくり",lv=4,id=8},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_trm_000005",ch="trm"},
{"vo",file="man_nst_000016",ch="nst"},
{"vo",file="man_itm_000013",ch="itm"},
{"vo",file="man_ktg_000007",ch="ktg"},
},
ja={
{
name={"Todos"},
"“¡Espera, no hemos muerto!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, hay que ver lo patéticos que son como personas, eh. Por eso es que\nreciben esos nombres tan poco elaborados como Alumno A, o B, o C, o D o lo\nque sea.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fgact",ch="一宮",act="ジャンプ",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="man_itm_000014",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¡Cállate! ¡No nos llames A ni B ni C ni D!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="片貝",act="いいえ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="man_ktg_000008",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¡Kusanagi! ¡No solo es eso! ¡Tu crimen no fue nada más eso! ¡Rin-chan dijo algo\nmás!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue lo que dijo?...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bgm",stop=1,time=500},
{"bg",file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="man_itm_000015",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Pero nunca hubo ese desenlace romántico que evoca la palabra 'amigos de la\ninfancia', ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000189",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Por supuesto que no! Si de esta posición de viejos conocidos pudiera pasar a\nexperimentar ese desenlace tan maravilloso, no me importaría morirme.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
