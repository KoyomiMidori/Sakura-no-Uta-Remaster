vo={
{"vo",file="man_trm_000006",ch="trm"},
},
ja={
{
name={"Torami"},
"“¡¿Puedes entender cómo nos sentimos cuando nos dijo esooo?!!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000402",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A nadie le importa cómo se sienten ustedes.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"quake",mode="mw"},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=2},
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0002",head="nst_z1a",x=-210,lv=4,id=7},
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0002",head="itm_z1a",x=-680,lv=4,id=1},
{"fgact",ch="一宮",act="びっくり",lv=4,id=1},
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=210,lv=4,id=8},
{"fgact",ch="片貝",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="man_trm_000007",ch="trm"},
{"vo",file="man_nst_000017",ch="nst"},
{"vo",file="man_itm_000016",ch="itm"},
{"vo",file="man_ktg_000009",ch="ktg"},
},
ja={
{
name={"Todos"},
"“¡¿Qué dices?!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000403",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A nadie le importa cómo se sienten ustedes, pero me acabo de dar cuenta de lo\nbajos y ruines que son al gritar en medio del pasillo y de manera tan bruta\nla confesión oculta por ella.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_itm_000017",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿Eh? ¿Nosotros somos bajos y ruines?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000404",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son de lo peor. ¿Cómo era que se llamaba esa chica, Rin? ¡De ninguna forma se\nsentirá bien si se llega a enterar de cómo ustedes gritaron y revelaron sus\nsentimientos ocultos que se le escaparon por accidente de la boca!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_trm_000008",ch="trm"},
},
ja={
{
name={"Torami"},
"“Uh, ahora que lo dices de esa manera, ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sentimientos ocultos?... Si así de fácil los revela entonces no son ocultos ni\nnada, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Toritani me ve fijamente. Un tanto perpleja, un tanto molesta. Ese tipo de cara\nllevaba.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Las palabras de Rin eran solo en broma, ¿no? De no ser así no hay\nmanera de que le revelara eso a unas personas que apenas acaba de conocer...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000405",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Acabo de decir que se le escaparon de su boca. Veo que no ha cambiado para nada\nlo lerdo que eres en lo que a los sentimientos de las chicas se refiere, eh.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Los estudiantes quedaron pasmados ante la dura realidad de que eran 'lo peor',\ny se fueron.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"El shock debe haber sido realmente grande. Lucían como si les hubieran chupado\nlas almas...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0200",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,sync=1,vague=40},
{"bgm",file="bgm030"},
{"ex",time=100,func="wait"},
{"fg",mode=-2,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000406",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que esa nueva estudiante es bastante popular, ¿no? Ciertamente, cuando\nse presentó me di cuenta de que era bastante linda, pero... no sabía que\nestuviera sucediendo eso.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún perteneciendo a su mismo salón, qué es lo que has estado viendo todo este\ntiempo? ¿No te diste cuenta de la cantidad de gente alrededor de ella?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000407",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me interesaba, así que no me había dado cuenta.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000619",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esa muchacha tiene una personalidad realmente buena. Y además trata muy bien a\ntodos. Totalmente diferente a cierta persona por allí.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000408",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Kei, por qué me observas a mí justo ahora?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000620",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-No es nada...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde hace tiempo ella siempre ha sido considerada con los demás.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000621",ch="ked"},
},
ja={
{
name={"Kei"},
"“No solamente es linda, parece que también es extraordinariamente inteligente.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000622",ch="ked"},
},
ja={
{
name={"Kei"},
"“Parece que el colegio al cual asistía antes es un famoso colegio preparatorio.\nDicen que su puntuación estándar es mayor a 100.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un colegio con puntuación estándar mayor a 100?... Es increíble que hayas\nentrado a este colegio con ese cerebro tuyo.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000623",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué el tema de la inteligencia de Rin-chan pasa ahora al tema de mi\ncerebro?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Por no entender eso es que me preocupa el estado de tu cabeza...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000409",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo quiero... Quiero eso.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000410",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ese potencial.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué potencial?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0004",head="mak_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000411",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tu amiga de la infancia. ¡Es hermosa y además talentosa, ¿no?! ¡¿Dónde más\npodría entrar si no es a nuestro club?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, justo ahora que pensé que habías vuelto a ser la misma animada Toritani\nde siempre, ahora dices algo completamente absurdo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000412",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad? Bueno, no cuesta nada preguntarle. Podríamos escuchar su opinión, y\nde ser posible quisiera tenerla de cualquier manera en nuestro club.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad no sé. Me parece que ella no pinta.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000413",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso da igual. Todo novato es bienvenido a nuestro club. Tenemos a dos genios de\nla pintura, ¿no? No habrá ningún problema si los dos se encargan de\nenseñarle.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Enseñarle a Rin a pintar? A pintar, eh...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000414",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué, por qué esa manera tan enredada de decir las cosas? ¿Tienes algún\nproblema?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que tenga algún problema, pero... Pues, hay varias cosas al respecto que\nme dejan pensante.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000415",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm. De igual forma, yo no soy miembro oficial del club. Al final toda la\ndecisión recae sobre ti, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000416",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Tienes algún problema? ¡Te estoy preguntando eso!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ningún problema.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, lo único que puedo decir es que ella es totalmente diferente al gran\ngrupo de mujeres de ayer, y también lo es a Kawachino y a Hikawa. Tal vez,\ntambién es diferente a Kei, a Akashi e incluso a ti. Y por supuesto, también\nlo es a mí.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque todo eso lo supe de manera indirecta.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000417",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De manera indirecta? ¿Quién te lo contó?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo jugaba. Olvídalo. Por ahora, y en lo que respecta a Rin Misakura, lo\núnico que te puedo recomendar es discutir bastante y decidir después de\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000418",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es lo que has querido decir ya desde hace rato?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues con querer decir algo... Sí, si puedo advertirles algo, es que la\nabrumadora diferencia en talento podría convertirse en la razón por la cual\nel lugar se desintegre...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0011",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000419",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo dije, nuestro club no es un lugar de tan alto nivel. ¿Acaso no te dije\nya que recibimos con todo gusto a novatos?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, de ser así no hay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"fgact",ch="圭",act="icon",lv=4,id=6,icon="icon03z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000624",ch="ked"},
},
ja={
{
name={"Kei"},
"“A mí me encantaría que Rin-chan entrara. Realmente es una muy buena chica.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000049",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sería genial. Misakura-senpai es verdaderamente una mujer ideal.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000042",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, tú también eres una chica bastante encantadora. Sí.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0008",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000050",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, pues, no sé cómo reaccionar si me dices eso con esa cara tan seria.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000043",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo bromeaba. En fin, si Rina ve con tan buenos ojos a esa chica, entonces\nquizás me interese un poco a mí también. Aunque, no importa qué tan\nencantadora chica aparezca frente a mí, mi corazón no cambiará.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0004",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000420",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bien, por ahora, comencemos la búsqueda de nuevos miembros!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=10000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"¿Con qué idea en mente Toritani habrá pensado de repente en meter a Rin en el\nclub de arte?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Pertenecen al mismo salón, debió haber visto ya a Rin todo este tiempo, y aun\nasí, ¿por qué ahora?...",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bgm",stop=1,time=500},
{"excall",file="01_fruhlingsbeginn_02_4"},
{"text"},
linkback="block_00137",
},
