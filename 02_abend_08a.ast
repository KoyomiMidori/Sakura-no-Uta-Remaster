{"extrans",time=0},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad no tienes problema?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000348",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay problema. Esta vez no me alteraré de aquella forma...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0003",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000349",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así como pude hacerlo contigo, creo que también puedo verla por primera vez a\nella también.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001323",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué hacen hablando tan secretamente?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿puedo traerme a Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001324",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa? ¿Qué clase de cosas le metiste en la cabeza a Shizuku-san para poder\nverla en traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué piensas que hice eso?!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001325",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te vi susurrándole algo al oido a Shizuku-san, así que pensé que la estabas\ninvitando a hacer cosas no muy buenas.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000350",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me encuentro bien. No cabe duda de que Naoya es un protagonista animal violador\nero-contaminado, pero mi voluntad no es tan débil como para dejarme llevar\npor sus ideas...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
