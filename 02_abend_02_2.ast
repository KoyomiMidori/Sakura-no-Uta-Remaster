astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm016"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000416",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, lo siento. De verdad, me siento muy apenada respecto a esto...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_ked_000864",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? Aneki, ¿por qué te disculpas con Naoya?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=0,lv=4,id=10},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x2=0,x=570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000857",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡En fin, aún diciendo eso, ambos pertenecen al grupo de reprobados, así que no\nhay mucha diferencia! ¡Vamos, resuelvan rápido esos problemas!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Piensa un poco en cómo me siento cuando me meten en el mismo saco que a Kei!\n¡Mis calificaciones de matemáticas y física para esta prueba fueron mayores a\nlas tuyas!”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000427",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Es eso cierto? Es algo inesperado de ti viniendo de una familia de artistas,\nKusanagi-kun. Así que eres bueno en ciencias.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque aun así, no pude ganarte ni en una sola materia, Rin. ¿Cómo es que\npuedes sacar esa cadena de máximas puntuaciones? Ni que estuviésemos\npresentando exámenes para niños...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000858",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Obtuviste la máxima puntuación en todo? Eso es increíble.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=570,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000417",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, todos los años Hirose siempre ha sido el número uno del colegio, pero eso\ncambió en los exámenes de final de período de este año. Los de tercer año\ntienen ahora entre sus filas al grupo de alumnos con mejores calificaciones\nque ha pisado Yumihari desde su fundación.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hirose? ¿Rin es más inteligente que ese genio?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=570,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="びっくり",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000428",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, es solo pura casualidad.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",x=0,lv=4,id=10},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=0,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000859",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, vaya, si no hubieran personas tan superiores como Rin-chan y Hirose\nentonces quizás yo hubiera podido llegar a ser la número uno del año, al\nmenos una vez...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=570,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000418",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, tú también te has esforzado bastante, Toritani. Sin embargo, ya están en\ntercer año, así que aún esforzándote es difícil obtener el primer lugar, pues\ntodos los demás también están esforzándose bastante con sus estudios.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh, qué lata, qué lata esta conversación de buenos estudiantes... Demonios,\npero qué tedioso...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=0,lv=4,id=10},
{"fgact",ch="真琴",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000860",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Los malos estudiantes deberían ponerse a resolver ya todos los problemas!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=570,lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000419",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajaja, pareces una profesora, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000861",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es que mientras no terminen no podremos comenzar con las actividades del club\nde arte.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000429",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero nosotras también nos dejamos llevar por las conversaciones banales de los\nmuchachos... Lo siento. Por ahora, deberíamos permanecer en silencio.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=570,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000420",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Bien, vamos ahora a avanzar a toda marcha! ¡Apúrense, ustedes dos!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... Al fin terminó...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000865",ch="ked"},
},
ja={
{
name={"Kei"},
"“Fue divertido, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso la estructura de tu cabeza está maltrecha?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000862",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bien, nos vamos a la sala del club ya! ¡Kusanagi, tú también vienes!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000863",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, pero estás bastante manso. Pensé que insistirías en regresar temprano por\nhaber venido al colegio durante plenas vacaciones de verano.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí así lo piensas, entonces sácate de la cabeza las ideas de llevarme a la\nfuerza a participar en el club.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000864",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hoy es un día especial. Tengo algo importante que decirles a todos, y por eso\nlos convoqué.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo importante que decirnos? ¿En esta época?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0003",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000865",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera, hoy planeaba pasarme por el club.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000866",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, claro! Ahora que lo recuerdo, ya la pintura en óleo de Rin-chan está por\ncompletarse...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así mismo...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000430",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento tanto por tomar tu tiempo.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues si no tuviera que asistir a las lecciones suplementarias no me pasaría\npor el club de ninguna forma. Solamente lo hago de paso, así que no te\npreocupes por eso.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000431",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si tan solo pudiera hacer algo para devolverte el favor.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000867",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, no te preocupes tanto por eso. Siempre eres demasiado considerada con\ntodo, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000432",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Pero, Mako-chan, tú también has hecho bastantes cosas por mí...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000868",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero a cambio de eso te he involucrado en varias cosas, por ejemplo, con lo que\npaso el día del evento para atraer nuevos integrantes.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000433",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso fue algo inevitable. No fue culpa tuya, Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="bluesky_spring",id=9,lv=9,time=500,path=":cg/"},
{"text"},
text={
ja={
{
"Rin y Toritani se volvieron mucho más cercanas desde aquel día.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Aunque bueno, tanto Rin como Toritani son sociables y se la llevan bien con los\ndemás, así que quizás sea algo obvio, pero ambas se tratan entre sí ahora\ncomo si fueran viejas amigas.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"cgdel",id=-1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="明石",size="z1",mx=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"bgm",file="bgm039"},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000258",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohh, pero si es el pelotón de las clases suplementarias. ¡Geh! ¡Este montón de\nidiotas!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"se",id=1,file="se2192"},
{"fgact",ch="明石",act="icon",lv=4,id=9,icon="icon09z1",x=50,y=-550},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="quake",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000259",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Auch. ¡¿Por qué me golpeas?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Qué por qué? Claramente fuiste tú quien comenzó provocándome.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000260",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Hmph! ¿No es acaso verdad? Además, yo no tuve que recibir ninguna clase\nsuplementaria esta vez. ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-570,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=0,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000869",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues no creo que tengas la necesidad de recibir clases suplementarias teniendo\nque recibir las mismas clases dos veces...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000256",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así que el asuntillo se trataba de clases suplementarias, eh, Kusanagi-\nsenpai...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000257",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por otro lado, Toritani-senpai. ¿Por qué nos convocaste a todos a que\nviniéramos acá?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Convocarnos a todos?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000216",ch="rna"},
},
ja={
{
name={"Rina"},
"“Había escuchado que Toritani-senpai tenía algo importante que discutir con\nnosotros hoy.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000261",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Y por eso es que vine yo también!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000870",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Nadie te ha llamado, senpai!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000262",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Pero igual les hice el favor de venir!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, habías dicho que tenías algo importante qué decirnos,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="トーマス",size="z1",mx=40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="おじぎ",time=500,size=20,lv=4,id=6},
},
vl02={
{"fgact",ch="トーマス",act="おじぎ",time=500,size=20,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_tmd_000041",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES. Algo respecto a las partes importantes DESU. Acerca de las muy, muy\nimportantes partes de una inocente chica.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mx=40,mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0005",head="yum_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000258",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"se",id=1,file="se2500"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000042",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Ah, mis ojos, mis ojos, ah, ah, ah.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Thomas trató de lanzar de manera discreta un comentario sexual, pero Kawachino\nse dio cuenta rápidamente y le impuso su soberano castigo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Últimamente, Kawachino ha estado llevando consigo un spray antibacterial de\nalcohol.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Su uso principal es para atacar a Thomas.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Por otra parte, el evento para atraer a nuevos integrantes terminó siendo todo\nun desastre, pero al final, este falso extranjero también acabó como un\nmiembro más de club de arte.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="cg_zev_uni_c19_base",id=1,lv=1,zoom=110,x=-1150,y=510,time=500,sync=1,path=":cg/cg_ev_uni_c19/",set="cg_ev_uni_c19",ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"El porcentaje de asistencia de Thomas como miembro del club de arte es bastante\nalto.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=5000},
{"text"},
text={
ja={
{
"Aunque desde que Thomas entró a este club, jamás lo he visto pintando algo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bgm",stop=1,time=500},
{"msgoff"},
{"cgdel",id=-1,time=0},
{"bgm",file="bgm007"},
{"bg",file="cg_zev_uni_c19_base",id=1,lv=1,zoom=50,speed=3000,time=0,sync=1,path=":cg/cg_ev_uni_c19/",z2=110,set="cg_ev_uni_c19",x2=-1150,y2=510,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bg",file="cg_zev_uni_c19_efe",id=2,lv=2,zoom=50,speed=3000,time=3000,sync=1,path=":cg/cg_ev_uni_c19/",z2=110,set="cg_ev_uni_c19",x2=-1150,y2=510,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Siempre anda con un lápiz frente al lienzo. Y, siempre se la pasa frotando\nhacia arriba y hacia abajo la punta de ese lápiz mientras observa a las\nchicas...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Siempre llega más temprano que todos los demás, y siempre es el último en\nsalir, haciendo siempre lo mismo.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Únicamente frotando la punta del lápiz, arriba y hacia abajo, abajo y hacia\narriba, y así...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"La gran mayoría de las personas no se dan cuenta del significado que se oculta\ntras esa gesto, así que no hacen nada, pero apenas la mirada de Thomas se\ndirige a Hikawa, Kawachino le rocía con spray.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Lo hacía por tanto, tanto rato, que desde que terminaron los exámenes de mitad\nde período comencé a golpearlo cada vez que lo veía haciendo ese acto tan\ndescabellado.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Siempre lo golpeaba cada vez que veía a las chicas, así que a partir de cierto\nmomento comenzó a frotar el lápiz mientras veía a Kei.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Ya a ese punto estaba harto, asqueado, e irritado, así que lo golpeé hasta más\nno poder.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Quizás por eso es que últimamente frota el lápiz a escondidas.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"¡HAGAN ALGO CON ESTE TIPO!",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000871",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡En fin! ¡Hoy tengo un anuncio importante que hacerles, y por eso los reuní a\ntodos!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-680,lv=4,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=7},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=210,lv=4,id=8},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=680,lv=4,id=2},
{"fgact",ch="圭",act="びっくり",lv=4,id=1},
{"fgact",ch="稟",act="びっくり",lv=4,id=7},
{"fgact",ch="里奈",act="びっくり",lv=4,id=8},
{"fgact",ch="優美",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000434",ch="rnd"},
{"vo",file="fem_rna_000217",ch="rna"},
{"vo",file="fem_yum_000259",ch="yum"},
{"vo",file="man_ked_000866",ch="ked"},
},
ja={
{
name={"Todos"},
"“¿Campamento?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, eso es bien raro. ¿No es la primera vez que alguien propone un campamento\nen el club de arte de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000872",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo soy la jefa este año, así que mi motivación es totalmente distinta a la de\nlos demás.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Motivación, eh. Tampoco es que vamos a competir al Koshien, ¿por qué hace falta\nun campamento? Además, somos de tercer año, tampoco tenemos tiempo para eso,\n¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000873",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por ser de tercer año es que se va a hacer. Este será nuestro último verano,\n¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El último verano, eh.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Tampoco es que vamos a competir al Koshien, y además, ¿no es acaso el verano el\npunto decisivo para los exámenes de admisión a las universidades?",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-570,lv=4,id=3},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000260",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y dónde se hará el campamento?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000874",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En Florencia.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000218",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero yo no tengo dinero para ir allá...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=570,lv=4,id=4},
{"fgact",ch="優美",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000261",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo tampoco tengo tanto dinero.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",mode=-1,lv=4,id=3},
{"fg",ch="優美",mode=-1,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000875",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se trata del dinero, se trata del corazón. ¡Es importante que nuestros\ncorazones quieran ir!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No podemos montarnos en el corazón para volar a Europa, ni tampoco podemos\nalojarnos o comprar con ese corazón.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000876",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahhh. Pero qué desagradable, eh. Dinero, dinero, dinero, dinero, ¡pule un poco\nese corazón tuyo!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pretendes decir? ¿Que si pulo mi corazón podré usarlo para ir a Europa, y\npodré alojarme y comprar con él?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",mode=-2},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0001",head="rin_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000877",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Así es! ¡¿Acaso no dicen que los milagros solo vienen a aquellos que creen en\nellos?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Esa manera de usar esa frase, en este contexto, es de lo peor...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quieres ir al extranjero podrías ir en el viaje de graduación, tan pronto\nculminen los exámenes de ingreso a la universidad.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, no le veo el propósito a un campamento. No hace falta que nos\npongamos a pintar en grupo, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000262",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Opino lo mismo que Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, por cosa rara coincidimos esta vez.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000263",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Kawachino chasquea la lengua, visiblemente desagradada. Eso es bastante cruel,\nen muchos sentidos.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000264",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aun cuando todos trabajan con obras de distintos estilos, no le veo el sentido\na cambiar de lugar y vivir todos juntos.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000219",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además, tampoco hay el dinero para eso.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000265",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No solo es un problema de dinero, tampoco entiendo por qué debemos realizar de\nmanera grupal la misma actividad creativa que invertimos para producir\nnuestras obras...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ked_000867",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eso creen? ¿No existe algo parecido ya? Como el pueblo de artistas de Arlés.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no resultó bien al final.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000435",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un pueblo de artistas? ¿Cuando dicen que no resultó bien, significa que\nalguien trató de hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hubo alguien llamado Gogh que trató de crear un pueblo de puros artistas. Y\nes que habían muchos artistas pobres para la época.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000436",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y entonces falló en la tarea?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gogh-san se cortó la oreja, todos acabaron aterrorizados y el plan se fue por\nel caño.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=7},
{"fgact",ch="稟",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000437",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah! ¿Con lo del Gogh-san que se cortó la oreja te refieres a ese Vincent van\nGogh?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De quién pensaste que se trataba?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0012",head="rin_z1b",lv=4,id=7},
{"fgact",ch="稟",act="いいえ",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000438",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es que pensé que se trataba de una persona distinta cuando usaste 'san'...\nPensé que era alguien con el sobrenombre de 'Gogh-san'...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000878",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se podría decir que tanto Montmartre como Montparnasse son, de cierta manera,\nlugares para la vida en comunidad de artistas. Justamente por tratarse de una\nactividad artística en soledad es que es importante también vivir en\ncomunidad.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_yum_000266",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad?... Sinceramente no lo entiendo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0004",head="tho_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000043",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“... ¿Un campamento?...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_ked_000868",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué sucede, Thomas?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0009",head="tho_z1a",lv=4,id=6},
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tmd_000044",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Tengo un lugar en mente donde se podría realizar el campamento.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000879",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Rechazado!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000045",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000880",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tus propuestas me dan miedo, no puedo aceptarlas! ¡Además, podrías estar\nplaneando algo de nuevo!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una decisión sabia.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0004",head="tho_z1a",x=0,lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0005",head="tho_z1a",x=0,lv=4,id=9},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000046",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Yo soy francés, y todo un buen francés. ¡Montmartre y Montparnasse, y además\nArlés también quedan en Francia! ¡Y aun así, ustedes! ¡¿Por qué me niegan de\nesa manera?!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"¿Francia? El idioma que usas parece de una región cercana de este país.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000881",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bien, ¿será entonces que nos llevarás a todos a Francia?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0009",head="tho_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000047",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Te advierto que será un viaje en crucero.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En crucero? ¿Tú pondrás el bote?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",x=0,lv=4,id=9},
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000048",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"se",id=1,file="se1296"},
{"text"},
text={
ja={
{
"Thomas comienza a registrar su mochila.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0002",head="tho_z1a",x=0,lv=4,id=9},
{"fgact",ch="トーマス",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="うなづく",lv=4,id=9},
},
vl02={
{"fgact",ch="トーマス",act="うなづく",lv=4,id=9},
},
vl03={
{"fgact",ch="トーマス",act="quake",time=200,size=10,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000049",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡YES! ¡YES! ¡YES! ¡YEEES!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Este intento de extranjero, realmente le encantan los movimientos de arriba\nhacia abajo, eh... Está ahora moviendo hacia arriba y hacia abajo el\ninflador, con todas sus fuerzas.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000882",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con un crucero... no te estarás refiriendo a ese bote de goma que estabas\nmostrando con tanto orgullo la vez pasada, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fgact",ch="トーマス",act="icon",lv=4,id=9,icon="icon09z1",x=50,y=-550},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0005",head="tho_z1a",x=0,lv=4,id=9},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000050",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Jaa? ¡¿TOURITANI, te gusta 'hacer eso' sin 'goma'?!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000883",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No he dicho ni una sola palabra al respecto!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"msgoff"},
{"fg",ch="真琴",size="z1",sync=1,mx=1280,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"se",id=1,file="se2192"},
{"fg",ch="トーマス",my=40,mode=-1,lv=4,id=9},
{"quake"},
{"ex",time=0,func="wait"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000051",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡OUCH!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa fue una excelente patada alta, pero si abres tanto las piernas se te verán\nlas pantis...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000884",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No las veas!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"No vayas a quejarte después entonces.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000263",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Bien, dejando las bromas hasta acá, propusiste eso con alguna idea en mente,\n¿no es así, Toritani?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000885",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco es que tenía una idea concreta...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000439",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La casa de la familia de mi padre queda en la prefectura de Shimane.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_wtd_000264",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Shimane? ¿El lugar donde está el Izumo-taisha?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000440",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es en Izumo, aunque... es un pueblo más viejo y con menos popularidad, pero\nel aire es muy limpio, y además el mar está bastante cerca.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_wtd_000265",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000441",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que quizás podríamos ir de campamento allá, y le propuse eso a Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La casa de la familia del padre de Rin...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="優美",size="z1",mx=40,mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000267",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No quisiera decir algo que parezca negativo frente a tus palabras, Rin-senpai,\npero... de igual forma, costará dinero el alojamiento. No podemos alojar toda\nesta cantidad de gente en la casa de la familia de Rin-senpai.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000442",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, si es por eso entonces no hay problema. Hay un lugar que antes era una\niglesia, pero ahora funciona como lugar de reunión, y dicen que se puede usar\ncomo campamento en caso de avisar con antelación.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que antes era una iglesia ahora es un lugar de reunión, eh. Un lugar un\ntanto raro.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000268",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Además, están los gastos de transportación...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=-345,x=-570,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0022",head="mak_z1a",x=0,lv=4,id=10},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x2=345,x=570,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000886",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Para eso podemos usar un boleto de viajes ilimitados por 1 día 'Seish*n 18\nkippu'!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000269",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Iríamos de aquí a la prefectura de Shimane en tren normal?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000887",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Según investigué, nos tomaría 16 horas.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000270",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“16 horas... (sin palabras).”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-570,lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000443",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si vamos todos juntos entonces quizás el viaje también sea divertido. Y\nademás, también hay mar y montañas por el lugar donde nos alojaremos, ah, y\nlos campos de girasoles también son hermosos.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000271",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Unuruh! Si Rin-senpai lo dice...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=570,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Girasoles? Ahora que lo mencionas, jamás he llegado a ver un campo de\ngirasoles.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_ked_000869",ch="ked"},
},
ja={
{
name={"Kei"},
"“Los girasoles crecen allí o allá, pero es raro ver un campo de girasoles como\ntal.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000888",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me parece que un tranquilo sitio campestre rodeado por girasoles sería perfecto\npara el campamento del club de arte. ¿Qué les parece a ustedes?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y a que se debió lo de Florencia al principio?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000889",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Simplemente mencioné el lugar al cual quiero ir.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"¿Nada más por eso? Cómo te gusta agitar el tema, eh.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000266",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Pues, a que no está nada mal! ¡Un campamento en medio de la naturaleza! Todo\nun escenario perfecto para nuestro club de arte.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_yum_000272",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpai, ¿tú también vienes?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000267",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿A qué se debe esa sensación de repulsión tuya tan obvia? No te preocupes,\ntengo unas cuantas cosas por hacer, así que no podré acompañarlos en su\ncampamento o lo que sea que sea.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rna_000220",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Akashi-senpai, ¿no vas a venir? Pensé que eras del tipo que más se\ncontentaría en asistir a esta clase de eventos.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000268",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, si es por el más contento en ir, está 'eso', ¿no?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000052",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡YEEES! ¡Campamento! ¡Acampar y copular se parecen un poco, pero son algo\nDISTINTOS!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="トーマス",size="z2",my=40,mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0100",face="a0001",head="tho_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000053",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡YEEES! ¡Copular!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"El intento de extranjero estaba en frenesí mientras decía cosas totalmente\ndisparatadas.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000444",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también he querido pintar alguna vez en medio de la naturaleza. Salir del\natelier, y sentir y tocar la naturaleza, como los pintores impresionistas...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000054",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡¿MMM?! ¡¿Sentir y tocar afuera?! YEEES, di eso... otra vez, por favor.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Thomas se para con fuerza.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"¿Quizás debería volver a darle unos cuantos golpes de nuevo?... Después de todo\nno va a resultar nada bueno de esto...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_tmd_000055",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Dí 'sentir y tocar afuera' de nuevo, por favor!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000445",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sentir y tocar afuera?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
delay={
vl01={
{"se",file="se2192",id=1},
{"quake",mode="mw"},
},
},
text={
vo={
{"vo",file="man_tmd_000056",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“S-Sentir y tocar afuera... Y-YEEES. Sentiré y tocaré afuera. Tocaré bastante.\nDi eso, POR FAVORSHI.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muere.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000446",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Q-Qué sucedió?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es nada. Sigan conversando.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000221",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai, ¿qué relación hay entre salir del atelier y pintar con los pintores\nimpresionistas?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000447",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... eso es...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000890",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fufufu, el establecimiento del impresionismo está bastante vinculado con la\ninvención de las pinturas de tubo. ¿Puedes inferir lo que quiere decir esto?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000222",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿La invención de las pinturas de tubo? Quieres decir que antes de la llegada\ndel impresionismo se usaba algo distinto a las pinturas de tubo, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000891",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. La pintura en tubo se inventó al comenzar el siglo 19, y al parecer, antes\nde eso se fabricaba la pintura mezclando pigmento con aceite secante, todo\ndentro del atelier.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000223",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, entonces el hecho de que se volviera posible llevar la pintura a las\nafueras en tubo, y por ende pintar afuera, está relacionado al\nestablecimiento del impresionismo.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000892",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás casi en lo cierto. Pero esa no fue la única razón. La otra grande razón\nfue la invención de la fotografía.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000893",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“También se puede agregar que la aparición de la pintura de tubo\ndesindividualizó las técnicas de ilustración realista.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000894",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Antes de la invención de las pinturas de tubo, el proceso de fabricación a\npartir de pigmento y aceite secante empleaba técnicas secretas distintas\ndependiendo del taller, pero la pintura de tubo unificó todo eso. Era de\nesperarse entonces la desindividualización.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_yum_000273",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quieres decir que un invento promovió la creación de un nuevo movimiento\nartístico?...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000895",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es, la invención de la pintura de tubo y de la fotografía cambió el rumbo\ndel arte.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000224",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, la pintura de tubo y la fotografía. Ciertamente, la invención de la\nfotografía implica que el valor de la pintura como objeto de descripción\nprecisa de la realidad baje.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000896",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo. Y en realidad, la aparición de la fotografía provocó que muchos\npintores realistas perdieran su trabajo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000225",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Así que la manera brusca y violenta de usar el pincel del impresionismo\ntenía ese significado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000448",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Plasmar lo observado con los ojos en la naturaleza, instante a instante, sobre\nel lienzo...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000449",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque esa frase no es mía, sino de Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000897",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me imaginé que se trataba de eso. En el momento en que te preguntaron te\ninquietaste un poco, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000450",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, no se podía esperar menos de ti, jefa. Tienes buen ojo para observar a\nlas personas.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000269",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De igual manera no está tan mal pintar en el campo, rodeados por la naturaleza.\nSi pueden ir todos, entonces sería bueno que lo hicieran. Aunque si Kawachino\nno le gusta, entonces podrían ir nada más las mujeres, ¿no creen?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_ked_000870",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Yo también quiero ir! ¡¿Sí, Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería ir yo también?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000270",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Si puedes ir deberías hacerlo. Tú también te gradúas este año, ¿no? El tiempo\nque les queda para reunirse y hacer algo está contado.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podría hacer lo mismo que tú y quedarme un año más.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000271",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De igual manera todos tus compañeros se graduarían, y eso no es nada fácil de\nasimilar. Solo se puede tener un último tercer año una vez. Y en tu caso,\neste año es ese año.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"A pesar de lo irónico que fui, me respondió de manera sensata.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000057",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“AFUERA, AFUERA, AFUERA, TOCAR, TOCAR, TOCAR, EYACULAR, EYACULAR,\nEYACULAR, EYACULAR, EYACULAR, EYACULAR, EYACULAR,\nEYACULAR, EYACULAR AFUERA, MMM, MM, QUÉ SUCIOOO, MM, MM,\nLUJURIOSO, EYACULAR AFUERAAA.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Thomas, quien estaba tumbado en el piso después de ser golpeado, estaba ahora\nretorciéndose en el suelo.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000058",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“MM, MM, MM, QUÉ SUCI O O O",
{"rt2"},
"Rin-chan... y Makoto-chan, y Rina-chan...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000274",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"se",id=1,file="se1437"},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0005",head="yum_z2a",lv=5,id=6},
{"fgact",ch="優美",act="おじぎ",lv=5,id=6},
{"text"},
text={
ja={
{
"Justo en el instante en que mencionó el nombre de Hikawa, Kawachino pisó con\nfuerza la cara de Thomas.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"se",stop=1,time=500,id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000059",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡MMMmm!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="man_tmd_000060",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“MM, MM, MMM... *biku*, *biku*, *bikuuuu*...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"En el momento en que Kawachino lo pisó, Thomas comenzó a convulsionar como un\npez sacado del agua.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0011",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000275",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Por cosa extraña, Kawachino se vio algo amilanada.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Aunque normalmente cualquiera en su lugar lo estaría también. Y es porque este\ndepravado se 'corrió' en el momento en que Kawachino lo piso... En el sentido\nsexual de la palabra...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"¿Qué tan contaminada está con sexo la cabeza de este intento de extranjero?...",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000276",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esto... q-qué hago con...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Kawachino me observa con una cara bastante angustiada. Jamás había visto a\nKawachino con esa cara.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Por ahora, le asiento con la cabeza.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo me encargo de lo demás, no te preocupes... Si una chica llegara a tocar eso\npodría quedar embarazada...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0010",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000277",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“M-Muchas gracias... P-Por hoy aceptaré tu favor...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000226",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa? ¿Sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0014",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"fgact",ch="優美",act="icon",lv=4,id=6,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000278",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No es nada. ¡No tienes nada de qué preocuparte, Rina!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fgact",ch="優美",act="停止",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes, simplemente se chorreó algo...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000227",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Chorreó algo?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, algo así...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Traigo un trapo.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de eso, parece que se decidió la fecha para el campamento.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"No tenía ganas de ir, así que en realidad no debería tener nada que ver\nconmigo, pero por alguna razón, se decidió poner la fecha para después de que\nKei y yo termináramos nuestras lecciones suplementarias.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"No voy a cansarme de repetirlo, no tengo ganas de ir.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"excall",file="02_abend_02_3"},
{"text"},
linkback="block_00228",
},
label = {
top={block="block_00000",label=1},
},
}
