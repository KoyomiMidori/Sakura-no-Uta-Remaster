astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",rule="083r",sync=1,vague=40},
{"fg",mode=-2,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm012"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000393",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Deshazte de eso, por favor.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_wtd_000272",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000394",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque obstruye demasiado. Además, Akashi-senpai, ya no eres el jefe de este\nclub, así que, según pienso yo, no tienes autoridad alguna para llenar el\narmario de la sala de preparativos con esta enorme cantidad de uwabakis.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000647",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tienes tampoco por qué enfadarte tanto...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000395",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No digas nada, Rin-senpai! ¡Si Rin-senpai hubiera dado un paso en falso\nhubiera terminado herida!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wtd_000273",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya dije que lo siento por eso, solo que tengo el presentimiento de que podré\nhacer un buen dinero con esto, así que lo dejé guardado.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000396",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cómo piensas hacer buen dinero con esta montaña de artículos defectuosos?\n¿Podrías tomarte la molestia de explicarme?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_wtd_000274",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Quizás sean defectuosos como lo dices, pero... eso depende también de la manera\nen que los uses.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000397",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hay muchas otras cosas aparte de estos uwabaki ocupando la sala de arte y que\nparecen ser tuyas, Akashi-senpai. Esta enorme estufa y este ventilador. El\nventilador, en particular, es de uso industrial, así que no se puede usar de\nmanera normal.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_wtd_000275",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, eso es porque tomé algo de chatarra de una fabrica, eh. Obviamente es de\nuso industrial.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000398",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Por qué traes chatarra acá?!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",size=20,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000648",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es que, esto, justo cuando estaba buscando algo en la sala de preparativos,\nun montón de uwabakis me cayeron, ah, pero pude esquivarlos al instante, así\nque no sufrí ninguna herida...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Al seguir la mirada de Rin, había una bolsa en el suelo repleta de uwabakis.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Es de seguro que cualquiera terminaría con una herida en caso de caerle esa\ncantidad de uwabakis. Sinceramente, si se hubiera tratado de otra persona que\nno fuera Rin, probablemente no hubiera podido esquivar eso.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Y, por otro lado...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué colores tan estrambóticos... ¿Es normal que vendan estos uwabaki? ¿Así de\neste color?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000649",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No habrá sido por eso que los compró a un precio tan extremadamente módico?\nHay puros colores raros que jamás había visto antes...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Aunque se podrían decir también que están algo desteñidos...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000245",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hmmm, más que desteñidos, pareciera eso...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000246",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, quiero decir, tienen cierta inclinación al washoku... Todos los colores acá\njuntados tienen una muy particular palidez en ellos.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Washoku...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Ciertamente, tienen cierto aire de washoku.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Por supuesto, 'washoku' no es un nombre formal. Simplemente es la forma con la\nque se denominan los colores tradicionales japoneses.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Sin embargo, así como la pintura evolucionó en el extranjero, en Japón también,\nde la misma manera, evolucionaron las pinturas japonesas y los ukiyoe.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Japón logró dar un gran paso hacia adelante, no solo en técnica, sino también\nen coloración. Y un paso que solo Japón sabría dar a su manera.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Dentro de esa evolución, este peculiar sentido de coloración, al cual se le\npodría tildar como único de Japón, comenzó a cobrar vida.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Los nombres de los washoku alcanzan más de 400.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Dependiendo de lo necesario que sea, los colores son detalladamente\ndistinguidos por sus nombres.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, washoku, eh... De ser así, entonces... Entonces, ehm...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000247",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ese que parece rosado es 'Tokinezumi'... No, tiene mucha saturación como para\nser 'Tokinezumi', así que me atrevería a decir que es 'Awabenifuji'. Y ese es\n'Hisuiiro'... no, ¿quizás 'Wakatakeiro, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sabes bastante.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000248",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, tampoco tanto. ¿No sabes tú más de pigmentos que yo, Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A los pigmentos no se les llama comúnmente de esa manera... Y además, no me sé\nlos nombres de cada uno de los washoku tampoco.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000249",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque, según lo que pude escuchar, los uwabaki no vinieron en colores washoku,\nsimplemente están desteñidos...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente están desteñidos, eh...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000399",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡En fin, deshazte de todo eso, por favor!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_wtd_000276",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya te lo dije, ya me disculpé por haberlos forzado todos adentro.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000400",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No estoy solicitando disculpas! ¡Tira todo esto ya!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_wtd_000277",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Espera un momentito nada más, por lo menos 5 días. ¡Solo 5 días y me encargaré\nde tirarlos!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006",head="yum_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000401",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No puedo esperar. Deshazte ya de ellos.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001122",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, vamos, Yuumi-chan. Es imposible deshacerse de esta cantidad de cosas\nahora mismo. No hay problema, démosle una semana de holgura.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000650",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, bueno, si los deja en el suelo por ahora no habrá riesgo de que se\ncaigan...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000402",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpais, son muy compasivas...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000278",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, pienso que podrían haber buenas cosas para ti si llegarás a tratarme tú\ntambién con amabilidad, Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_yum_000403",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ohhh... ¿Y qué clase de 'buenas cosas' podrían haber para mí en ese caso?\n¿Podría explicarme?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fgact",ch="明石",act="ジャンプ",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000279",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Esa voz de terror tuya me da miedo...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001123",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, Akashi-senpai, veo que tienes bastante apego con esos artículos\ndefectuosos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000280",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Artículos defectuosos? Fuh, pero qué idiotez has dicho, Toritani. Si es\ndefectuoso o no, eso depende únicamente de la persona que lo use.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_ked_000936",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, entonces serán completamente inútiles en manos tuyas, Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000281",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿PERO QUÉ DICES, AH?!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu. Fuera de tema, aun en vacaciones este lugar siempre anda bullicioso.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001124",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, aunque está también lo del asunto del campamento, así que los reuní de\nnuevo a todos.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hablas del plan ese de ir todos a quedarse en lo más remoto del campo en\nShimane?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001125",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, parece que ya procesaron nuestra reservación del lugar de reunión.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible quedarse a dormir allí?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001126",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que pueden alojar a todos los que estamos aquí sin mayor problema.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con eso de 'todos' no estarás incluyéndome a mí también en la cuenta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001127",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que no es obvio? ¡Asegurate de hacer espacio en tu agenda!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estás pidiendo que libre tiempo para el campamento del club de arte?...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"¿Por qué una persona ajena al club como yo tiene que hacer eso?...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_wtd_000282",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Bueh, es mejor que vayan todos, en la medida de lo posible. El pelotón Kusanagi\ny Natsume de las clases suplementarias también.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000937",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Puedo ir siempre y cuando sea después de terminar los exámenes de reparación!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001128",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Examenes de reparación? ¿Por qué tienes que presentar exámenes? Se supone que\nsolo son clases suplementarias, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por andar huyendo a cada rato a este idiota le agregaron exámenes de reparación\nen conjunto con sus clases suplementarias.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",lv=4,id=9},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001129",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es en serio?! ¡Pero si no los aprueba entonces estaría en serios aprietos!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-570,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000651",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No tienes de qué preocuparte! Te ayudaré a estudiar todo lo que necesites.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon04z1",x=25,y=-525},
},
},
text={
vo={
{"vo",file="man_ked_000938",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ueh... P-Pues, ciertamente, eso me sería de ayuda, pero...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0009",head="kei_z1a",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001130",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Será de ayuda, de gran ayuda! ¡Asegurate de estudiar con Rin-chan siempre que\ntengas tiempo libre! Sería una deshonra como jefa tener a 2 repitientes en el\nclub de arte.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, sinceramente Rin me ha ayudado bastante también asistiéndome con los\nestudios de vez en cuando. Ya me he vuelto capaz de entender los mapas\nademás.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="du",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000652",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya te lo había dicho, Kusanagi-kun, tú ya tenías esa habilidad antes.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y, así como ven, yo sí me estoy esforzando. Aunque no sé qué hay de Kei.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0006",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000939",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Yo también me estoy esforzando! Tan pronto termine mis exámenes de reparación,\nnos iremos todos de campamento.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien, Akashi? ¿De verdad no irás al campamento?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000283",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así como lo he dicho ya miles de veces, estoy ocupado. Apenas termine esto\ntengo que irme.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ocupado tú, eh...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estarás planeando?...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000284",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Planear nada, ya va siendo hora de que me despida de una vez por todas de este\ncolegio.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001131",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En esta época? ¿Eh? Akashi-senpai, ¿es que de veras podrás graduarte?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000285",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Digamos que sí.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rna_000250",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Puedes graduarte aún a este punto del año?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000286",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Es que no les dije ya que simplemente retrasé un poco mi graduación?...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es bueno que te gradúes, sí.\nAunque es imposible en tu caso...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000653",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si de verdad te gradúas entonces hay que celebrar.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000287",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah~, ah~, no hace falta que hagan eso. Quiero graduarme en tranquilidad, sin\nmucho barullo. Graduarme y liberarme... de esta dominación...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que te crees algún rockero chuuni diciendo eso?...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",rule=139,vague=40,file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿No tienes acetona?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=3},
{"fgact",ch="真琴",act="いいえ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001132",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Obviamente no tenemos esa clase de cosas acá. Usar acetona como disolvente de\npinturas de óleo es algo demasiado especializado, ¿no te parece? Quisiera\nsaber más bien por qué creíste que tendríamos algo así en este club de arte.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me contaron que Akashi estuvo buscando acetona a eso de marzo, así que juraba\nque tendrían algo en el club de arte...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001133",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Akashi-senpai estuvo buscando acetona? ... Buscando...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="いいえ",lv=4,id=3},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001134",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, no sucede nada.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001135",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pues ciertamente, si Akashi-senpai estuvo buscando eso, estoy segura de que\nlo habrá encontrado ya, pero en este club de arte no hay nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001136",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quisiera más bien preguntarte eso, ¿por qué Akashi-senpai estaba buscando algo\ncomo acetona?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé la razón, pero el viejito de la tienda de pinturas me dijo que no solo\nbuscaba acetona, sino todo tipo de disolventes orgánicos...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001137",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estaba buscando todo tipo de disolventes orgánicos? ¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No los recuerdo todos, pero eran puros disolventes que normalmente no se\nusarían en pinturas de óleo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001138",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmm, disolventes que no se usarían en pinturas de óleo, eh... Tengo más o menos\nla idea de todos los materiales que tenemos acá, y me parece que en este club\nde arte no tenemos ninguno.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Si así lo dice Toritani, entonces así debe ser.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Pero entonces, ¿con qué propósito estuvo Akashi buscando disolventes orgánicos\npotentes?",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Disolventes capaces incluso de disolver plástico y goma.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"¿Es que planea usarlos en otra cosa que no sea arte?",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"No es completamente descabellado, tratándose de él, pero hay algo todavía que\nno me encaja dentro de todo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001139",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa? ¿Por qué tan pensativo de repente?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001140",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te diste cuenta de algo respecto al plan de Akashi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es que tenga nada concluyente respecto al asunto, pero... En fin, ¿aún\nsigues sospechando que Akashi está tramando algo?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001141",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues tú también piensas lo mismo, ¿no? Hace rato trataste de sacarle algo de\nmanera bien directa...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque me ignoró sin tapujo alguno.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001142",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, me parece un hecho que Akashi-senpai está planeando algo. Sin embargo,\naún no sé qué...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No bastaría con que lo tortures como siempre y le hagas escupir la verdad?...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001143",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿pero es que no sabías? Son muy altas las posibilidades de obtener\ninformación incorrecta al torturar a alguien. El torturado simplemente\naportará la información que el torturador desea saber.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, no lo decía en serio...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=3},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001144",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Acetona, eh... Jamás he usado una solución removedora tan potente... Y además,\nen lo que concierne a marzo de este año, fue ya hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hubo algo en marzo de este año?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001145",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues ni idea, aunque creo que nada.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x2=0,x=-345,lv=4,id=3},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000404",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kusanagi-senpai, quisiera consultarte algo...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, sí, sí, ¿qué es?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg038b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"De regreso a casa, bajo por la colina de Yumenouki, solo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Me pareció haber visto la silueta de una persona por el camino a un lado de la\nvía.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es raro ver a alguien por el santuario...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Parece que esta colina, sobre la cual está construido el colegio Yumihari, fue\nobjeto de fe religiosa hace bastante tiempo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Cuentan las historias que hace bastante tiempo también hubo un gran templo\nerigido sobre el terreno donde están las edificaciones del colegio.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Lo único que queda ahora de eso es un pequeño santuario.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"En este santuario, construido sobre un terreno vinculado a los sueños por las\nleyendas tradicionales, se suelen ver las diversas siluetas de personas en\nlas épocas del Hatsuyume (sueño que se tiene la primera noche del año nuevo),\npero normalmente nadie se acerca acá.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Aún por esas épocas nunca me llamaban la atención las personas que venían acá.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"El problema, me parece, está en la forma que tenía esa silueta...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"se",file="se9004",id=1},
{"bg",zone="0x000000",file="bg063b",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con bastante seguridad me dio la impresión de que él entró acá...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000288",ch="wtd"},
},
ja={
{
name={"???"},
"“¿Con 'él' te referirás a mí, quizás?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi... ¿Por qué te tenías que esconder?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000289",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Porque me estabas siguiendo, nya~”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces pudiste haberte escondido hasta el final, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000290",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues también pensé en hacer eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensaste en hacer eso, pero ¿qué?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000291",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fumuh, quise confirmar algo por última vez.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Confirmar? ¿Confirmar qué?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fgact",ch="明石",act="びっくり",time=200,lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000292",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, ¿qué será? No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si fuiste tú quien mencionó lo de confirmar...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000293",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Parece que a este templo le llaman Templo Hakuki. Aunque no sé qué significa\nel nombre.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así parece.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000294",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Según dicen, parece que tiene cierta conexión con la leyenda de los cerezos\nmilenarios... la leyenda de los cerezos que florecen fuera de temporada en\nYumihari. ¿La conoces, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la conozco muy bien.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000295",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Será que de verdad existen los cerezos milenarios?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea... ¿Viniste a este templo para confirmar eso?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000296",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De ninguna forma, es imposible saber eso.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000297",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En fin...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"se",file="se9004",id=1},
{"fg",ch="明石",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Al decir eso, Akashi cruzó por mi lado y comenzó a caminar.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te vas ya?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_wtd_000298",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya va a anochecer. Los cuervos están graznando ya, así que debo irme ya, nya.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"La silueta de Akashi desapareció dentro del bosque de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Confirmar algo, eh.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"¿Qué habrá tenido que venir a confirmar en un santuario vinculado a los cerezos\nmilenarios?...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
