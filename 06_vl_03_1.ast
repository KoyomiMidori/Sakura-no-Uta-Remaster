astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"se",file="se9036",id=1,loop=1},
{"text"},
text={
ja={
{
"Las olas me mecen alrededor.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Tomo unas gotas en mis manos y las dejo caer.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Las gotas se dejan llevar por el viento hacia la playa.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Es prueba de que el viento está soplando fuertemente desde el mar a la playa.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Onshore...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"cgdel",id=-1},
{"bg",file="ev_uni_c63_01",path=":ev/ev_uni_c63/",set="ev_uni_c63"},
{"text"},
text={
ja={
{
"Las olas de esta época no son muy buenas.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"La inestabilidad atmosférica provoca fuertes vientos.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"En el surf, tener muchas olas no siempre es bueno.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"No hay forma de montar olas inmensas, de esas que caen estrepitosamente.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Vientos como los de hoy son algo duros para tipos sin tanta habilidad como yo.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Y con duro me refiero a...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"msgoff"},
{"se",stop=1,id=1,time=500},
{"se",id=2,file="se0799_s"},
{"bg",file="zev_uni_c63_01",zoom=70,y=-180,speed=2500,time=0,z2=50,path=":ev/ev_uni_c63/",set="ev_uni_c63",y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=1200,func="wait"},
{"cgact",file="zev_uni_c63_01",act="ジャンプ",time=500,size=50,y=-180,zoom=70},
{"ex",time=500,func="wait"},
{"bg",file="bluesky_winter",time=500,id=1,lv=5,path=":cg/"},
{"se",id=3,file="se_bashaa"},
{"quake"},
{"quake",mode="mw"},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*cof*, *cof*, ueeehh...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me muero. Esto me va a matar...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Y bueno, así como pueden ver, las olas empujadas por el viento me arrastran\nantes de poder siquiera montarlas.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Aunque alguien con la suficiente habilidad sí podría hacer algo acá...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... vámonos ya...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"cgdel",id=-1},
{"bg",file="bg016a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... Exceptuando la primera ola, todas las demás fueron terribles...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Aunque bueno, no está mal. Después de todo hago esto con una tabla encontrada\nen la basura, solo para ejercitarme un poco.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_ntd_000009",ch="ntd"},
},
ja={
{
name={"???"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Veo una cara conocida.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Si la memoria no me falla, ella es...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kuriyama-kun?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0007",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000010",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah, ¡s-sí!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Tiene una cuerda en su mano.\nY en el otro extremo de la cuerda había un delgado perro, el cual me estaba viendo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ¿es que estás paseando a tu perro?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0008",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000011",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vives cerca?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000012",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Tan inexpresiva que siempre.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues bueno, nos vemos...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",mode=-2},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Justo al intentar irme...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"quake"},
{"se",file="se3130",vol=70,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Uohhh?!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Siento algo pegarme en las rodillas por detrás, y por poco me caigo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q-Quién hizo eso?!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Volteo, pero no veo a nadie. Y al siguiente instante.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"quake"},
{"se",file="se3130",vol=70,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Uoohhh?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0012",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000013",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡N-No, Unagi!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿U-Unagi?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Al ver con cuidado, me doy cuento que el delgado perro de hace un momento me\nembistió, para luego atacarme en las piernas con sus patas frontales.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué le pasa?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0005",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000014",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡E-Está jugando!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Hummm, hummm,\nhummm.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Unagi, el perro que intentaba jugar conmigo, estaba por alguna razón atacándome\nmientras hacía sonar su nariz.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Vaya perro tan extraño, atacándome sonando como lo haría una víctima.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Hummm, hummm, hummm.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué raza de perro es esta? Es inglés, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0003",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000015",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah, es un galgo italiano.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es de Italia?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0002",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000016",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es un cachorro?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000017",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No, así como lo ve es un perro adulto.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Es realmente pequeño.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0003",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000018",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“En realidad es grande para ser un galgo.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Hummm, hummm, hummm.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué gruñe así?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0002",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000019",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Creo que quiere jugar.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. ¿Unagi, se llamaba? Vaya nombre.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0003",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000020",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Es que... cuando era un cachorro, su cara era como la de una anguila...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Y vaya gusto para los nombres.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ven, Unagi, ven!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Abababababa, ababababababa...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Unagi frota su nariz contra mis brazos.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Unagi, a diferencia de usar 'guau' o 'uhn' como un perro normal, usa 'Hummm,\nhummm' o 'Ababababa'.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Aba, ababababababa...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué perro tan curioso.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0003",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0002",head="nat_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000021",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Sí, son una raza curiosa. Les encanta jugar, y según son muy cariñosos.\nAunque en su cabecita solo tienen tanto cerebro como para dos tacitas, así que no son muy inteligentes.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Aba, aba, ababababababa... ¿Aba?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"El perro juega con mi mano.Sí, parece ser algo tonto...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fgact",ch="奈津子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000022",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No sabía que usted era un surfista, profesor Kusanagi. Increíble.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nah, simplemente floto en el mar, y de vez en cuando monto alguna ola.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000023",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿No es eso un surfista?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un verdadero surfista es capaz de dominar olas en cualquier condición. Tipos\ncomo yo no entran en esa categoría.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fgact",ch="奈津子",act="icon",lv=4,id=9,icon="icon02z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000024",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿Dominar olas?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="奈津子",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000025",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Es usted impresionante, profesor. Enseña arte, pero también es alto, y además\nbueno en los deportes...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Falsas impresiones. En realidad soy realmente malo en deportes de grupo. Solo\nhago deportes individuales.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000026",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000027",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Pero aun así está haciendo deporte a estas horas de la mañana...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás en algún club, Kuriyama-kun?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0008",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000028",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah, no, ninguno...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pues si entraras en algún club podrías hacer amigos, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0009",head="nat_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0008",head="nat_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000029",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Sí, tal vez.\nPero no encuentro nada que me guste hacer...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0009",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000030",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No quieres surfear?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0007",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0008",head="nat_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000031",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“N-No. Y-Yo jamás podría hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? No niego que hay personas que se han cortado el brazo o el torso con las\nquillas, o que se han golpeado la cabeza. Los cortes son particularmente\npeligrosos. Algunos incluso han chocado con tetrápodos y han muerto. Aunque\nes divertido.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0009",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000032",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Y-Yo prefiero las actividades culturales. No soy capaz de incurrir en algo tan\nterrorífico.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Terrorífico, eh...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, da miedo. A mí también, sobre todo cuando llega una ola grande.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0008",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000033",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“P-Pues entonces no intente meterme a hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero la emoción es importante.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0001",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000034",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿La emoción?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. No estaría mal comenzar por algo que no te de miedo, pero que te\nemocione, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes que ir al mar para conseguir olas. Podrías incluso encontrar algunas\ngrandes y emocionantes fuera de él.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿O será que odias eso de hacer algo emocionante?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0001",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000035",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“P-Por supuesto... que no...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0008h",head="nat_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000036",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“P-Por supuesto... Y-Y si es por estar emocionada, ya lo estoy...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo estás?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0012h",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000037",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡S-S-Se supone que en estas situaciones usted debería responder con un '¿qué\ndijiste?'!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, odio eso de darle vueltas al asunto, y además sí te escuché.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0009h",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000038",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“U-Uh... pero, lo dije en voz baja...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuriyama-san, tu voz en general es bajita, y pones al oyente a escuchar con\natención. Por eso te puedo escuchar, aun hablando en voz baja.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0001h",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000039",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Si hablaras un poco más fuerte sería más difícil escucharte al hablar en\nvoz baja.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0009",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000040",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Pero al final terminaría escuchándome...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y cuál es el problema?\nDeberías aprender un poco de tu perro.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Unagi"},
"“Hummm, hummm, hummm.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"El perro estaba ahora de mal humor por no jugar con él, sonándose\nconstantemente la nariz.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A diferencia de su dueña, este perro es insistente en lo que quiere.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000041",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Así son estos perritos...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Pues dicen que todo perro se parece a su dueño. Quizá tu perro se\nparece más a ti de lo que crees.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000042",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿A... mí?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Deberías ser más tajante en lo que quieres hacer, y decirlo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0010",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000043",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“En lo que quiero hacer...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, si no me cambio ya llegaré tarde al colegio.\nHoy también tengo clases desde la primera hora.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000044",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Sí, yo también debería regresar ya...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000045",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Cuelgo mi tabla en la Vespa 150 Standard.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"En estos años han creado ganchos con los que puedes colgar fácilmente tablas en\nbicicletas o scooters. Aunque...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya agallas tuvo Kei para insistir en seguir montando esta chatarra...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Para montar esta máquina debes estar preparado, al menos, para desmantelar el\nmotor.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Los motores de motocicletas son simples, fáciles de entender.Desmantelar una no\nes, por lo general, difícil.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Pero esta es una antigüedad producida entre 1960 y 1962. Es usual encontrar un\nlugar donde crees que entra un tornillo, y en realidad era un perno. Su\nestructura es realmente difícil de entender.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"La remodelé por completo, y está en muy buenas condiciones. Pero aun así da\nbastantes problemas.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios mío, el scooter se parece a él...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Enciendo el motor y me dirijo a casa con mi tabla.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"A baja velocidad, por supuesto.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",rule=139,vague=40,file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
"Los profesores de tiempo parcial, a diferencia de los profesores normales, no\nsuelen coincidir con los estudiantes.Es normal llegar tarde al colegio.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Y de ahí que la gran manada de estudiantes dirigiéndose al colegio se me\nparecía a un festival.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Siento que me voy a marear entre esta multitud...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Con los ojos puestos en la multitud de estudiantes, me dirijo a la sala de\nprofesores.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"se",file="se2766",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000034",ch="nnd"},
},
ja={
{
name={"???"},
"“¡Wah!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento. Tenía la cabeza ocupada en algo...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Entre tanto pensar tonterías choqué con una estudiante.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="ノノ未",size="z1",mode=3,resize=1,path=":fg/non/z1/",file="non_z1a0200",face="a0009",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0011",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000035",ch="nnd"},
},
ja={
{
name={"???"},
"“Ah, discúlpeme usted a mí por caminar sin ver al frente--”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"msgoff"},
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0014",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
{"se",file="se9031",id=1},
{"ex",time=300,func="wait"},
{"text"},
delay={
[300]={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0011",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="いいえ",size=5,lv=4,id=9},
{"se",file="se9010",id=2},
},
},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Repentinamente, y por alguna razón que desconozco, la muchacha con la que\nchoqué alejo su cara a un lado.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0015",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000036",ch="nnd"},
},
ja={
{
name={"???"},
"“Ah, no, no es nada... S-Solo que, se cayeron mis lentes...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lentes? ¿Ah, tus lentes? ¿Estos?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0009",head="non_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000037",ch="nnd"},
},
ja={
{
name={"???"},
"“Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"La muchacha se levanta de puntillas, intentando alcanzar los lentes de mis\nmanos.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y por reflejo, aleje mi mano.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Como resultado, la distancia entre los dos se acortó bastante.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="ノノ未",size="z2",mode=3,resize=1,path=":fg/non/z2/",file="non_z2b0200",face="b0011",head="non_z2b",lv=5,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="ノノ未",size="z2",mode=3,path=":fg/non/z2/",file="non_z2b0200",face="b0014",head="non_z2b",lv=5,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000038",ch="nnd"},
},
ja={
{
name={"???"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",file="se9031",id=1},
{"fg",ch="ノノ未",size="z1",my=40,mode=3,resize=1,path=":fg/non/z1/",file="non_z1b0200",face="b0011",head="non_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"La muchacha vuelve la cara nuevamente.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué vuelves la cara?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0015",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000039",ch="nnd"},
},
ja={
{
name={"???"},
"“¿L-Le parece? No lo estoy haciendo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah, no? Pues aquí tienes, tus lentes.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0011",head="non_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000040",ch="nnd"},
},
ja={
{
name={"???"},
"“¡Ah, muchas gracias!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Por los momentos, pongo los lentes en sus manos.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="ノノ未",size="z1",ex03="b0097",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0011",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La muchacha se coloca sus lentes y se despide con una incómoda sonrisa.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="ノノ未",size="z1",ex01="b0099",ex03="b0097",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0017",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000041",ch="nnd"},
},
ja={
{
name={"???"},
"“¡H-Hasta luego!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sabía... Te he visto en algún lado.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="ノノ未",size="z1",ex01="b0099",ex03="b0097",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0014",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",ex01="b0099",ex03="b0097",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0004",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000042",ch="nnd"},
},
ja={
{
name={"???"},
"“¿Eh? ¿P-Pero qué dice? S-Soy una estudiante como todos acá, obviamente me ha\nvisto en algún lado.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez, aunque...\n¡No! No, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah! ¡Tú!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="ノノ未",size="z1",ex03="b0097",mode=3,path=":fg/non/z1/",file="non_z1b0200",face="b0014",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
{"ex",time=200,func="wait"},
{"text"},
delay={
[200]={
{"fg",ch="ノノ未",size="z2",ex03="b0097",mx=40,mode=3,resize=1,path=":fg/non/z2/",file="non_z2b0200",face="b0006",head="non_z2b",lv=5,id=9},
{"se",file="se9032",id=1},
{"quake",mode="mw"},
},
},
text={
ja={
{
name={"Naoya"},
"*Mggg*",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Algo me tapa la boca.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="ノノ未",size="z2",ex01="b0099",ex03="b0097",mode=3,path=":fg/non/z2/",file="non_z2b0200",face="b0004",head="non_z2b",lv=5,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000043",ch="nnd"},
},
ja={
{
name={"???"},
"“¿Podría acompañarme a la azotea?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"*Mggg*",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"se",file="se9012",id=1},
{"fg",ch="ノノ未",speed=1000,mode=3,path=":fg/non/z2/",file="non_z2b0200",face="b0004",ex01="b0099",ex03="b0097",head="non_z2b",x2=0,x=-200,lv=5,id=9},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"ex",time=500,func="wait"},
{"se",file="se9038",id=2},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm031"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué diablos haces?! ¡¿Por qué me metiste un pañuelo en la boca?!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/non/z1/",file="non_z1a0200",face="a0005",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000044",ch="nnd"},
},
ja={
{
name={"???"},
"“Ibas a revelar mi identidad en voz alta, profesor.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo tu nombre. Nonomi-kun, ¿verdad? Del barrio de bares de Namidagawa.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0018",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000045",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Es justamente eso lo que no quiero que mencione en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0005",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000046",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Así como ya lo sabe, yo trabajo en ese barrio.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0006",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000047",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Si los profesores se enteran que trabajo ahí me expulsaran.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues te recuerdo que yo también soy un profesor...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0002",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000048",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pero usted no dirá nada, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué crees eso?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0016",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000049",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pues si llegara a decirlo, me encargaría de darle al colegio los detalles de\ntodas las veces que se ha emborrachado ahí--”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, no, no diré nada! ¡¿Cómo crees que lo haría?! ¡Ajajaja!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0004",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0003",head="non_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000050",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“No se preocupe, sé que aun así usted no diría nada. Y además, usted no parece\nmostrar interés por los demás...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto. Yo también soy un profesor, así como me ves.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0017",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000051",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Ah, sí? Pues a pesar de todas las clases que he tomado con usted nunca me\ndescubrió, a pesar de solo haberme puesto unos lentes encima.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es que, ehm, ¿conoces ese concepto psicológico de que cuando hay algo peculiar\nen alguien te distraes y no te das cuenta?... Es... algo así.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0015",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0017",head="non_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000052",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“No sé de qué habla. Además, da bastante qué pensar el hecho de que no supiera\nquién soy solo por llevar lentes.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Anchor link, es que le llaman?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0007",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000053",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Yo qué sé! ¡No me importa!\nY creo que el término que utilizó es de informática.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Entonces no es ese. ¿Cuál era?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0018",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0011",head="non_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000054",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡No lo sé y no me importa! Todo este tiempo estuve tranquila sabiendo que no se\nhabía dado cuenta, pero ahora...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que cambia la impresión de alguien cuando lleva gafas.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0017",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000055",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿No será porque no le importan los demás?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0010",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000056",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Cielo santo profesor, llevo diez años trabajando en ese bar, y usted nunca se\nha preocupado por saber de mí.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es verdad. ¡Ah, lo recordé! ¡Anchoring, creo que era!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0006",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000057",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡¿Por qué intenta cambiar el tema cuando estoy hablando de algo serio?!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es eso... Solo... intentaba explicar el porqué, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0018",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000058",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Esa razón no vale!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, disculpa que no me haya dado cuenta de que eras tú...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0015",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000059",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Fuh, hubiera preferido que no se diese cuenta...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, dijiste que llevas varios años trabajando ahí, ¿no? Eso significa\nque...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0005",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000060",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡He estado llevándole licor a su mesa desde pequeña!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás hablándome en serio?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0015",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000061",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Jaa, ¿es que no escuchó a Katakai-san cuando dijo que yo llevaba más años en\nese mundo que usted?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto tiempo lleva Katakai conociéndote y aun así te pidió que salieran? ¿Es\nacaso un lolicon ese tipo?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0005",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000062",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Qué falta de respeto con Nonomi. ¿Loli, yo? ¿Puede seguir diciendo lo mismo aun\ndespués de ver estos pechos?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="ノノ未",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/non/z2/",file="non_z2a0200",face="a0005",head="non_z2a",lv=5,id=9},
{"fgact",ch="ノノ未",act="うんうん",lv=5,id=9},
{"se",file="se9031",id=1},
{"text"},
text={
ja={
{
"Nonomi-kun se desabotona la zona del pecho de su camisa y aprieta sus pechos,\nacentuando su forma.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wawah, no tienes por qué mostrarlos de esa manera.\nNo hablaba de eso.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="ノノ未",size="z2",ex03="a0097",mode=3,path=":fg/non/z2/",file="non_z2a0200",face="a0012",head="non_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000063",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Oroh? ¿Es acaso verdad que usted es virgen, profesor?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-P-Por qué preguntas eso?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="ノノ未",size="z2",ex03="a0097",mode=3,path=":fg/non/z2/",file="non_z2a0200",face="a0008",head="non_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000064",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pues es que se agitó tanto solo con ver mi escote.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo profesor, tú alumna, ¿entiendes? ¿Cómo no podría agitarme? ¡Me podrían\ndespedir!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="ノノ未",size="z2",ex03="a0097",mode=3,path=":fg/non/z2/",file="non_z2a0200",face="a0004",head="non_z2a",lv=5,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000065",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ya veo, esa es una forma de verlo también.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es la forma normal de verlo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Por los momentos, acordamos no mencionar nada de lo que el uno o el otro ha\nhecho en Namidagawa.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"A partir de ahora, en el colegio seremos profesor y alumna.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"En Namidagawa, cliente y empleada.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"En eso quedamos.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Su nombre completo es Nonomi Hiiragi.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Yo mismo me sorprendo de no haberme enterado antes.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, vaya...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"cgdel",id=-1},
{"se",id=1,file="se1895"},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/non/z1/",file="non_z1a0200",face="a0002",head="non_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwah! ¡La campana!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0001",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000066",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ah, llegaremos tarde.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué haces ahí hablando con tanta calma?! ¡Apresurate tú también!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0002",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000067",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Sí, tiene razón, aunque es una pena. Siempre he querido hablar de esta forma\ncon usted, y ahora que tuve la oportunidad, se acabó muy rápido.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes hablar todo lo que quieras. ¡Total, es normal que un profesor y su\nalumna hablen!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0003",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000068",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿En serio? Pensé que tendría que seguir ignorándolo así como he hecho hasta\nahora.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Solo asegurate de respetar la relación profesor-alumno! ¡En fin, vamos ya!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="ノノ未",size="z1",ex03="a0097",mode=3,path=":fg/non/z1/",file="non_z1a0200",face="a0004",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000069",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"se",file="se9023",vol=70,id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Nos apresuramos a bajar por las escaleras de emergencia.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_03_2"},
{"text"},
linkback="block_00228",
},
label = {
top={block="block_00000",label=1},
},
}
