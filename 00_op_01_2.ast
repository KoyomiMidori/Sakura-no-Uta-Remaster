astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="zev_com_a03_07",x=960,y=-300,path=":ev/ev_com_a03/",set="ev_com_a03",ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm002"},
{"text"},
text={
vo={
{"vo",file="man_ked_000049",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Eh, Naoya, oye, Naoya!",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_ked_000050",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¿Q-Qué te pasó de repente?!",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, ahh, lo siento. Estuve recordando varias cosas...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_ked_000051",ch="ked"},
},
ja={
{
name={"Kei"},
"S-Soltaste bastante... Parece que realmente sí estás triste por la muerte de tu\npapá, ¿no?",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Lágrimas? ¿Solté lágrimas?",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_ked_000052",ch="ked"},
},
ja={
{
name={"Kei"},
"No, soltaste sangre por la nariz...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"bg",file="ev_com_a03_07",path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"A pesar de lo inerte que está mi corazón... mi cuerpo bota sangre, eh.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí... Quizás, mi cuerpo sea más sincero que mi corazón...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Por más indiferente que esté mi corazón... mi cuerpo recuerda lo que pasó en\naquel momento.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"(¡Debí haber recibido el dinero, aun si eso implicaba desnudarme y postrarme en\nel suelo frente a todos!)",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Eso es lo que grita mi cuerpo, soltando esa sangre.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero, hay momentos en los cuales los hombres no podemos hacer eso.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"Hay momentos en los que tenemos que resistir...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_ked_000053",ch="ked"},
},
ja={
{
name={"Kei"},
"N-Naoya... Eso es algo genial... ¡L-Los hombres no deben soltar lágrimas, sino\nsangre! ¡¿Verdad?!",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Fuh.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_000001",ch="aid"},
},
ja={
{
name={"???"},
"Chicos... ¿Hasta cuándo van a seguir con ese show?",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_a05_01",path=":ev/ev_com_a05/",set="ev_com_a05"},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿A-Ai?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_ked_000054",ch="ked"},
},
ja={
{
name={"Kei"},
"Aneki, ¿aún no te habías ido?",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"user",mode="conf",ch="藍"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000002",ch="aid"},
},
ja={
{
name={"Ai"},
"¿No te he dicho ya que debes llamarme Natsume-sensei afuera? Vaya que eres un\nhermanito con muy mala memoria.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000003",ch="aid"},
},
ja={
{
name={"Ai"},
"Dejando eso de lado, Kusanagi... Esto debe haber sido bastante difícil para ti,\n¿no?",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"La mujer que apareció al lado de Kei inclinó un poco su cabeza hacia mí,\nmoviendo su hermosa cabellera negra.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"No... Más bien, eres tú quien me ha ayudado bastante ya.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000004",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, no me refiero al funeral, sino al asunto del abandono de la herencia.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_ked_000055_n",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Qué rayos es eso?",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"¿Por qué Ai sabe de eso?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Se supone que solo un pequeño grupo de personas están enterados de ese\nasunto...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000005",ch="aid"},
},
ja={
{
name={"Ai"},
"Me sorprendí al principio cuando me contaron, pero después de pensármelo muy\nbien, me pareció que fue una elección bastante típica de ti.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿M-Muy típico de mí?... Sí, quizás...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Muy típico de mí, eh...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Aún a los ojos de Ai, me veo como ese tipo de persona...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Alguien con un noble espíritu, incorruptible por el dinero.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Sin ser influenciado ni atrapado por lo mundano, persiguiendo siempre mi propio\nsentido estético.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"¿Será que realmente ante los ojos de los demás me veo como ese tipo de persona?",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000006",ch="aid"},
},
ja={
{
name={"Ai"},
"Tratándose de ti, seguramente pensaste 'será algo genial' y lo dijiste. Y\nluego, llegaste a una situación en la cual no pudiste echarte para atrás,\n¿no?",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿QUÉ PRUEBAS TIENES PARA AFIRMAR ESO?",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-N-N-NO SÉ QUÉ QUIERES DECIR.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000007",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero si estás bastante alterado...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"N-N-NO ESTOY ALTERADA, VAYA QUE NO.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000008",ch="aid"},
},
ja={
{
name={"Ai"},
"No va al caso, pero ¿por qué estás hablando como un homosexual?...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"P-Porque dices cosas bastante absurdas...",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="ev_com_a05_05",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000009",ch="aid"},
},
ja={
{
name={"Ai"},
"Fuh... ¿Absurdas? Eres tú el absurdo. Nadie en su sano juicio haría eso...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_aid_000010",ch="aid"},
},
ja={
{
name={"Ai"},
"Aun así, he estado observándote ya durante todo este tiempo.",
{"rt2"},
"Tengo una buena idea de la razón por la cual hiciste eso...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000011",ch="aid"},
},
ja={
{
name={"Ai"},
"Sé por qué hiciste esa idiotez...",
{"rt2"},
"Incluso alguien tarda como yo puede darse cuenta de eso...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y-Ya te lo dije, ¿qué es lo que quieres decir?",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000012",ch="aid"},
},
ja={
{
name={"Ai"},
"Me refiero al abandono del derecho de sucesión de herencia. ¿Piensas hacerte el\ntonto aún a este punto?",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No pienso hacerme el tonto, no sé de verdad de qué estás hablándome...",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000013",ch="aid"},
},
ja={
{
name={"Ai"},
"Mmm, ya veo... Así que piensas insistir en hacerte el tonto.",
{"rt2"},
"Y yo que pensaba en enseñarte la manera de invalidar los documentos legales de\nabandono de la herencia...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="zev_com_a05_02",x=-380,y=210,zoom=70,time=0,speed=300,sync=0,z2=50,path=":ev/ev_com_a05/",set="ev_com_a05",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se3130",vol=60,id=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¿En serio? ¿Hablas en serio? ¡Debes estar mintiéndome, enséñame, por\nfavor! ¡Si es necesario me desnudaré, y me postraré en el piso también!",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="zev_com_a05_04",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_a05/",set="ev_com_a05",ax=1920,ay=1080,bx=-960,by=-540,x=-380,y=210},
{"text"},
text={
vo={
{"vo",file="fem_aid_000014",ch="aid"},
},
ja={
{
name={"Ai"},
"...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_ked_000056",ch="ked"},
},
ja={
{
name={"Kei"},
"...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="zev_com_a05_04",x=0,y=0,zoom=50,time=0,speed=200,sync=0,z2=70,path=":ev/ev_com_a05/",set="ev_com_a05",x2=-380,y2=210,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se3130",vol=60,id=1},
{"quake"},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Jaa!",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_a05_04",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000015",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso fue bastante desagradable...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_ked_000057",ch="ked"},
},
ja={
{
name={"Kei"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Espera, no, no quise decir eso, solo que, me gusta desnudarme, y...",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000058",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¿Eres un exhibicionista?!",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Así es!",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_a05_06",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000016",ch="aid"},
},
ja={
{
name={"Ai"},
"¡No digas ridiculeces solo para evadir la vergüenza! ¡Idiota! ¡Lo único que\nestás logrando es ponerte más entre la espada y la pared!",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero, si no lo hago, entonces... mierda, mierda...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_a05_05",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000017",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí querías el dinero, ¿verdad?...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, así es. La verdad es que quería ese dinero. Me moría por ese dinero...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_ked_000059",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Qué hay de ese dinero? ¿De qué están hablando con eso de abandono de herencia\ny todo eso?",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_aid_000018",ch="aid"},
},
ja={
{
name={"Ai"},
"Kusanagi rechazó toda la herencia de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_ked_000060",ch="ked"},
},
ja={
{
name={"Kei"},
"Ya veo... ¿Y bien? ¿De cuánto es esa fortuna?",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000019",ch="aid"},
},
ja={
{
name={"Ai"},
"Alrededor de 1500 millones de yenes.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_ked_000061",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Hablas en serio?",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"Fue un impulso...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_ked_000062",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Por qué hiciste esa ridiculez?",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya te lo dije, fue un impulso... Fue una decisión basada en la percepción\nestética japonesa, o en la visión ética, o, digamos, en el propio arte...\nFueron esa clase de refinadas y nobles cosas las que me hicieron vacilar...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000020",ch="aid"},
},
ja={
{
name={"Ai"},
"Cosas nobles y refinadas hicieron que titubearas al decidir, eh...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, así es. Pero ahora me he dado cuenta de lo importante que es el dinero...",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"El dinero pesa más que el alma y la vida. No tener dinero es lo mismo a no\ntener cabeza. El dinero mueve al mundo. El mundo no es más que el conjunto de\ntodo el dinero...",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_aid_000021",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues, eso no se parece en nada a lo que diría una persona con una percepción\nestética noble y refinada.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Eso da igual ahora! ¡El dinero es lo importante!",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_ked_000063",ch="ked"},
},
ja={
{
name={"Kei"},
"No digas esas cosas tan desesperadas, me pones triste... Además, Aneki dijo que\nharía algo para resolverlo todo, ¿no?...",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, tienes razón. Gracias, Ai. Ahora soy millonario... Puedo comprarlo y\ncontrolarlo todo con el dinero. Qué alivio, realmente, qué alivio.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_ked_000064",ch="ked"},
},
ja={
{
name={"Kei"},
"Qué bien, ¿verdad, Naoya?",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"Qué alivio, de verdad, qué aliviooo...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000022",ch="aid"},
},
ja={
{
name={"Ai"},
"Es mentira.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿ES MENTIRA?",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_aid_000023",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso era una mentira.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿ESO ERA UNA MENTIRA?",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000024",ch="aid"},
},
ja={
{
name={"Ai"},
"No conozco ninguna manera de invalidar el abandono de la herencia.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿NO CONOS, NI UNA ERA DE DAR EL BANDO DE LA UNA?",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000025",ch="aid"},
},
ja={
{
name={"Ai"},
"Deja de evadir la realidad... El dinero no volverá. Está bien que te la hayas\ndado de guapetón, pero no hay manera de que el dinero regrese después de que\nllegaste incluso a firmar los documentos...",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"NOHAYMANERADEQUEELDINEROREGRESEDESPUÉSDEQUELLEGASTEINCLUSO",
{"rt2"},
"AFIRMARLOSDOCUMENTOS...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"NOHAYMANERA.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_ked_000065",ch="ked"},
},
ja={
{
name={"Kei"},
"E-Esto... O-Oye, Naoya... Dejemos de evadir la realidad, ¿sí? No ganas nada\nhaciéndolo.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿RE... A... LI... DAD?",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_ked_000066",ch="ked"},
},
ja={
{
name={"Kei"},
"Sí. Parece que hagamos lo que hagamos, no hay manera de recuperar la fortuna.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"Realidad...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"se",file="se3130",vol=60,id=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿QUÉ?! ¡¿Me estás diciendo que no hay manera de recuperar la fortuna?!",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_a05_05",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000026",ch="aid"},
},
ja={
{
name={"Ai"},
"Te tardaste bastante en darte cuenta...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡En pocas palabras! ¡Ai, me engañaste, ¿verdad?!",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_000027",ch="aid"},
},
ja={
{
name={"Ai"},
"Idiota... En primer lugar, no hay forma de que una simple profesora como yo\nsepa la manera de hacer eso.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"Gununuh... Imbécil, jugaste con mi corazón...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000028",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso es porque insististe en hacerte el tonto. Ustedes dos siempre hacen lo\nimposible por lucirse y presumir, de verdad.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"Uhh, mi dinerooo... mi fortuna, un golpe de suerte tan repentino y grande como\nesa suma de dinero... Y pensar que me esforcé tanto por aumentar el monto\ntotal...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_a05_05",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000029",ch="aid"},
},
ja={
{
name={"Ai"},
"Tú mismo tienes la culpa de lo que sucedió...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ked_000067",ch="ked"},
},
ja={
{
name={"Kei"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kei...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_ked_000068",ch="ked"},
},
ja={
{
name={"Kei"},
"Eres un idiota.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡No quiero escuchar esas palabras de ti!",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000030",ch="aid"},
},
ja={
{
name={"Ai"},
"Vamos, ¿no está bien así? Esa decisión fue bastante de ti, Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"Gununuh, ¿vas a seguir diciéndolo? ¿Vas a seguir burlándote de mí, llamándome\nidiota?",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_aid_000031",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya te lo he dicho varias veces, llevo ya bastante tiempo observándote...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿Piensas decir entonces que por eso pudiste saber lo idiota que soy?!",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"se",file="se9010",vol=50,id=1},
{"bg",file="zev_com_a05_03",zoom=90,x=-510,y=430,speed=800,time=300,path=":ev/ev_com_a05/",set="ev_com_a05",x2=-430,y2=420,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_aid_000032",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues sí... Ya llevo rato conociéndote, así que sé muy bien lo estúpido que\neres.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_000033",ch="aid"},
},
ja={
{
name={"Ai"},
"Ustedes son bien tercos, eh...",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué llevas rato ya diciendo 'ustedes'?",
{"rt2"},
"C-Ciertamente, quizás soy algo terco en algunos aspectos, pero...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_aid_000034",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Algo?... Ustedes dos son terriblemente tercos, y también fanfarrones...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_aid_000035",ch="aid"},
},
ja={
{
name={"Ai"},
"A pesar de que, debo agradecerle a los dos tercos que son ustedes. O no, quizás\ndeba más bien disculparme...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué es eso?...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_aid_000036",ch="aid"},
},
ja={
{
name={"Ai"},
"Esta vez no pude hacer nada...",
{"rt2"},
"Realmente no sirvo de nada. ¿Qué es lo que he estado haciendo hasta ahora?...",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Idiota, se supone que tú no deberías saber eso...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="zev_com_a05_02",sync=0,face=1,time=400,zoom=90,path=":ev/ev_com_a05/",set="ev_com_a05",ax=1920,ay=1080,bx=-960,by=-540,x=-510,y=430},
{"text"},
text={
vo={
{"vo",file="fem_aid_000037",ch="aid"},
},
ja={
{
name={"Ai"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya no hay ningún problema, ¿no?",
{"rt2"},
"Si es así, entonces ya no hay nada más que se deba decir. Ya todo cambió y pasó\na ser nuevo ahora.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"No hay razón lo suficientemente buena como para exponer la verdadera cara de\naquellos que se hacen pasar por payasos.",
{"rt2"},
"No sé realmente qué tanto sudor acumuló en la labor, pero seguramente no tenía\nla más mínima intención de mostrar lo que sucedió en las sombras.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="zev_com_a05_01",sync=0,face=1,time=400,zoom=90,path=":ev/ev_com_a05/",set="ev_com_a05",ax=1920,ay=1080,bx=-960,by=-540,x=-510,y=430},
{"text"},
text={
vo={
{"vo",file="fem_aid_000038",ch="aid"},
},
ja={
{
name={"Ai"},
"Un payaso... ¿A eso se le podrá llamar payaso?...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, el payaso es el as en las cartas.",
{"rt2"},
"Por más difícil que sea la situación, es la labor del payaso revertirlo todo de\nun golpe.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_aid_000039",ch="aid"},
},
ja={
{
name={"Ai"},
"Si fuera un juego distinto, sería más bien una carta fatal.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, a veces es así, pero ese juego ya se acabó. Y el resultado del juego es\nesto.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_000040",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="zev_com_a05_05",sync=0,face=1,time=400,zoom=90,path=":ev/ev_com_a05/",set="ev_com_a05",ax=1920,ay=1080,bx=-960,by=-540,x=-510,y=430},
{"text"},
text={
vo={
{"vo",file="fem_aid_000041",ch="aid"},
},
ja={
{
name={"Ai"},
"No sé nada. Y por eso no puedo dar las gracias, ni tampoco disculparme...",
{"rt2"},
"A pesar de que esta deuda es impagable, aun si me tomara la vida entera\nsaldarla...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_000042",ch="aid"},
},
ja={
{
name={"Ai"},
"He sido la misma desde aquel momento...",
{"rt2"},
"Yo――",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ai...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_000069",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¡Uooohhh, esto es terrible!!",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"se",file="se3130",vol=50,id=1},
{"bg",file="ev_com_a05_04",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000043",ch="aid"},
},
ja={
{
name={"Ai"},
"Uwaah, me asustaste. ¿Q-Qué pasa, Kei?",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_ked_000070",ch="ked"},
},
ja={
{
name={"Kei"},
"Ah, no es la gran cosa, solo que...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000044",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Qué es lo que pasa?",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_ked_000071",ch="ked"},
},
ja={
{
name={"Kei"},
"De repente salió una niña de no sé dónde, y aun siendo una niña pequeña empezó\na dárselas de mujer mayor, así que no pude evitar gritar.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_a05_07",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000045",ch="aid"},
},
ja={
{
name={"Ai"},
"Ohhh... Kei.",
{"rt2"},
"¿La mala influencia de Kusanagi te contaminó esa lengua tuya?",
{"rt2"},
"Si haces ese tipo de cosas que no te quedan para nada, vas a morir...",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_ked_000072",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Pero, pero, eres tú la que tiene la culpa por interrumpirnos, Aneki! ¡Aún\nmientras Naoya y yo discutíamos algo sumamente importante!",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000046",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Algo sumamente importante?",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_ked_000073",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Sí! Aneki, fuiste tú la que me pidió que le hablara de eso, ¿o no?...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_aid_000047",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Hablarle de eso?... ¿Aún no has terminado de decírselo?",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_ked_000074",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¿Aún?! ¡Al momento de hacer las cosas hay muchas sutilezas que tomar en\ncuenta!",
{"rt2"},
"Esto no es nada sencillo.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_a05_05",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Y bien, ¿a qué se refieren con eso de hablarme algo?",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_ked_000075",ch="ked"},
},
ja={
{
name={"Kei"},
"Pues, no sé por dónde comenzar... Escucha, Naoya, no sé realmente cómo\nexplicártelo, pero... ehm...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Tan complicado es el asunto?",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_ked_000076",ch="ked"},
},
ja={
{
name={"Kei"},
"Mmm, no es complicado, pero, no sé cómo debería explicártelo, es bastante\ndifícil...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000048",ch="aid"},
},
ja={
{
name={"Ai"},
"Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sí?",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_aid_000049",ch="aid"},
},
ja={
{
name={"Ai"},
"Múdate a nuestra casa.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"El mundo se paró por cuestión de 3 segundos.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Jaa?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Nuestra casa? ¿De cuál casa hablas?",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_aid_000050",ch="aid"},
},
ja={
{
name={"Ai"},
"A la casa Natsume.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿La casa de los Natsume?",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_000051",ch="aid"},
},
ja={
{
name={"Ai"},
"Nuestra casa.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Nuestra casa?...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_aid_000052",ch="aid"},
},
ja={
{
name={"Ai"},
"La mansión de los Natsume en Kootoha. Tú también la conoces, ¿no?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Que si la conozco?... La mansión de los Natsume en Kootoha...",
{"rt2"},
"Oye, escucha, Ai...",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_ked_000077",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¿Ves?! ¡Aneki, no sabes ser nada sutil! ¡Eso fue demasiado directo! ¡¿No ves\nque Naoya está confundido ahora?!",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_a05_06",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000053",ch="aid"},
},
ja={
{
name={"Ai"},
"¡De igual manera, no trates de meterte, Kei!",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, esperen, esperen, no peleen.",
{"rt2"},
"Ehm, bien, en pocas palabras, ¿con 'múdate a nuestra casa' me estás pidiendo\nque me mude a la mansión de los Natsume en Kootoha con ustedes dos?",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000054",ch="aid"},
},
ja={
{
name={"Ai"},
"Así es...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quieres decir hoy mismo?",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000055",ch="aid"},
},
ja={
{
name={"Ai"},
"No me importaría que vinieras hoy mismo.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Desde hoy?... ¿Hasta cuándo?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_aid_000056",ch="aid"},
},
ja={
{
name={"Ai"},
"Hasta que te vuelvas un adulto capaz de valerte por ti mismo.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Un adulto capaz de valerse por mí mismo?...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_aid_000057",ch="aid"},
},
ja={
{
name={"Ai"},
"Estoy pidiéndote que vivamos todos juntos hasta que te gradúes.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"Escucha, Ai--",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000058",ch="aid"},
},
ja={
{
name={"Ai"},
"Conoces bien la mansión de los Natsume, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por supuesto... Sin embargo, Ai.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_aid_000059",ch="aid"},
},
ja={
{
name={"Ai"},
"Quizás te parezca demasiado apresurado... pero, esto te lo digo después de\nhaberlo pensado una y otra vez...",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Después de haberlo pensando una y otra vez?...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_aid_000060",ch="aid"},
},
ja={
{
name={"Ai"},
"En primer lugar, no tienes nada de dinero, ¿no?",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Sí, no tengo ni un centavo! ¡Tengo tan poco dinero que hasta da risa!",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000061",ch="aid"},
},
ja={
{
name={"Ai"},
"No tienes por qué enfatizar eso con tanto desespero...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_ked_000078",ch="ked"},
},
ja={
{
name={"Kei"},
"Entonces podríamos vivir juntos y ya, ¿no?",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ese no es el problema...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000062",ch="aid"},
},
ja={
{
name={"Ai"},
"Esa es razón suficiente para vivir juntos.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"Quizás tengas razón, pero...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_aid_000063",ch="aid"},
},
ja={
{
name={"Ai"},
"No voy a forzarte a que lo hagas...",
{"rt2"},
"'¡Sea lo que sea, múdate a vivir junto con nosotros!'",
{"rt2"},
"Eso es todo lo que puedo decir de mi parte.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vea por donde lo vea, eso que acabas de decir suena a algo bastante forzado...",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000064",ch="aid"},
},
ja={
{
name={"Ai"},
"Kusanagi, al igual que Kei, siempre te he visto como un hermanito de verdad.\nPor eso es que quisiera que viviéramos todos juntos...",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vivir todos juntos...",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_aid_000065",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, así es. Quiero que vivamos juntos, de nuevo, así como lo hicimos en aquella\népoca.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿En aquella época? Te fuiste bien atrás al pasado, eh...",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_aid_000066",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, no lo niego... Aunque, supongo que no recuerdas mucho de aquellos tiempos.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"En realidad, sí recuerdo algo...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Al escuchar mis palabras, Ai sonrió, un tanto alegre.",
{"rt2"},
"Esa sonrisa hizo que me sintiera un poco más relajado.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, realmente es una propuesta bastante encantadora, pero,",
{"rt2"},
"yo ya tengo mi casa.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pase lo que haya pasado, esa casa es importante para mí.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000067",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso lo sé. Lo entiendo... Entiendo lo que significa esa casa para ti... pero...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="man_ked_000079",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Eso, la mansión Natsume es enorme! ¡Tenemos varias habitaciones libres, y hay\nincluso un depósito que puedes usar como atelier! ¡Deberías poder vivir sin\nningún problema!",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, debo reconocer que aun con 1 o 2 huéspedes más se puede vivir sin estar\napretujados en esa mansión, pero...",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_ked_000080",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Entonces vivamos juntos!",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, son dos problemas distintos...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_ked_000081",ch="ked"},
},
ja={
{
name={"Kei"},
"Pero ahora que Kenichiro Kusanagi murió, te has quedado completamente solo,\n¿no?",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, ciertamente no me queda ningún familiar ya, pero llevo un buen tiempo\nviviendo solo.",
{"rt2"},
"Desde que mamá murió he estado siempre por mi cuenta...",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_ked_000082",ch="ked"},
},
ja={
{
name={"Kei"},
"Naoya... No me refiero a eso. Me refiero a algo más simple--",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, lo sé. Sé lo que quieres decir, Kei... pero, no...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"Lo siento... Esa invitación me alegra bastante, pero...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000068",ch="aid"},
},
ja={
{
name={"Ai"},
"...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Mmm?",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_com_a06_01",path=":ev/ev_com_a06/",set="ev_com_a06"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Ai agarró mi cabeza, y me abrazó.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Fue tan repentino que ni siquiera pude resistirme.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Pero qu--? ¿A-Ai?",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_aid_000069",ch="aid"},
},
ja={
{
name={"Ai"},
"Tienes razón. Quizás fui un poco egoísta...",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_aid_000070",ch="aid"},
},
ja={
{
name={"Ai"},
"Kusanagi, aún no lo has perdonado, ¿verdad?...",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"... ¿A él?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Pues, me da igual.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_aid_000071",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo. Bueno, supongo que era de esperarse...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Y-Ya te lo dije, me da igual, él y yo...",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_aid_000072",ch="aid"},
},
ja={
{
name={"Ai"},
"De ser posible, no odies tanto a Kenichiro-san, ¿sí?...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_aid_000073",ch="aid"},
},
ja={
{
name={"Ai"},
"Esto no es más que un deseo mío, pero no quiero que odies mucho a tu papá...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Nunca le han faltado mujeres que lo defiendan, eh...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_aid_000074",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Mujeres?",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"Mamá también... dijo lo mismo hasta el final.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_aid_000075",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaja... Ajajajajaja... Ya veo, ciertamente, se podría decir eso también...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Se podría decir? Por lo general son siempre mujeres quienes lo defienden...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_aid_000076",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo, ¿estás molesto porque él se quedó con tu mamá?",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"Claro que no, qué ridiculez.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y además, no sé qué malentendido tienes, pero yo no lo odio, y por lo tanto\ntampoco tengo nada por qué perdonarlo...",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por Dios... Y aun así, todos tratan de cubrir y proteger a ese hombre...",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_aid_000077",ch="aid"},
},
ja={
{
name={"Ai"},
"Con lo inexpresivo que eres siempre, se nota que estás molesto ahora.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"Claro que no...",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_aid_000078",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues él era bastante popular con las mujeres. Supongo que era inevitable.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_aid_000079",ch="aid"},
},
ja={
{
name={"Ai"},
"Aunque en ese sentido quizás debería ser un poco odiado...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿A qué sentido te refieres? No estoy entendiendo nada.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000080",ch="aid"},
},
ja={
{
name={"Ai"},
"Jajajaja, ¿no?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Realmente me parece que ha pasado bastante tiempo desde que Ai me abrazó por la\ncabeza por última vez.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Cuando era un niño, Ai me abrazaba frecuentemente, así como ahora.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Me parecía irritante que me tratara como a un niño, pero, sinceramente, también\nme sentía feliz...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Pues la única otra persona que me hacía lo mismo era mi difunta madre...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Ai está trabajando ahora de profesora en el colegio al cual asisto. Aunque Ai\nfue como una hermana mayor para mí cuando aún era niño.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Cuando, aún de niño, era un mocoso insolente, que a pesar de ser solo un crío\nno paraba de subestimar al mundo...",
{"rt2"},
"Solo ella me perdonó.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Desde aquel día...",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Solo Ai fue quien me perdonó, desde su corazón.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"Está bien, ya entendí, así que deja ya de abrazarme la cabeza...",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"se",file="se9010",id=1,vol=50},
{"se",file="se9010",vol=50,id=1},
{"bg",file="zev_com_a05_02",zoom=50,speed=500,time=500,z2=53,path=":ev/ev_com_a05/",set="ev_com_a05",ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_aid_000081",ch="aid"},
},
ja={
{
name={"Ai"},
"No te pongas tímido.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Cállate...",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"Además, vivir juntos significa...",
{"rt2"},
"vivir también bajo el mismo techo que Kei, ¿no?",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_ked_000083",ch="ked"},
},
ja={
{
name={"Kei"},
"Ah, cierto. No solo eso. Nuestra hermanita regresó.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Hermanita?",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_aid_000082",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, el mes pasado nuestra hermanita regresó a casa.",
{"rt2"},
"Así que ahora estamos viviendo los tres en la mansión Natsume.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, ya veo, una hermanita, eh, así que tenían una hermanita...",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_aid_000083",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues, así es la familia Natsume... Ajaja.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Ai sonríe, un poco incómoda.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Y cómo se llama esa hermanita?",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_aid_000084",ch="aid"},
},
ja={
{
name={"Ai"},
"Se llama Shizuku.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"Shizuku... Shizuku, eh...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="man_ked_000084",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Eh? ¿Qué pasa? Naoya, jamás has visto a Shizuku, ¿no?",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jamás.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="man_ked_000085",ch="ked"},
},
ja={
{
name={"Kei"},
"Ya veo. Pareciste por un momento haber comprendido algo al escuchar el nombre\nde Shizuku...",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, no, no es realmente nada. Simplemente pensé 'ah, así que así se llama'.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y bien, no hay manera de que Shizuku-san permita que una persona desconocida\ncomience a vivir en su casa, ¿no? No nos hemos ni siquiera conocido.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_aid_000085",ch="aid"},
},
ja={
{
name={"Ai"},
"Si es por eso, entonces no hay problema. Obviamente, también tengo el\nconsentimiento de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ahh, esa tonta. No permitas tan fácilmente que una persona a la que jamás has\nconocido viva debajo del mismo techo que tú...",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000086",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Eh? ¿Entonces sí conoces a Shizuku?",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"No la conozco. Ya dije que no nos conocemos.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="man_ked_000087",ch="ked"},
},
ja={
{
name={"Kei"},
"Vaya que reaccionas de maneras extrañas, eh.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000086",ch="aid"},
},
ja={
{
name={"Ai"},
"En fin, como puedes ver, en la casa Natsume estamos ya absolutamente preparados\npara recibirte.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"Fuu, ya veo.",
{"rt2"},
"Parece que así es, eh...",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="man_ked_000088",ch="ked"},
},
ja={
{
name={"Kei"},
"Supongo que no sabrás qué hacer aún después de esa proposición tan repentina...\nPiénsatelo bien.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, está bien. Está bien...",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"Aunque en fin, ya se acabó el día de hoy...",
{"rt2"},
"así que quiero descansar...",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="man_ked_000089",ch="ked"},
},
ja={
{
name={"Kei"},
"Sí, esa es buena idea...",
{"rt2"},
"Sea lo que sea, ya se acaba de terminar todo...",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_aid_000087",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí... Ya terminó todo. El funeral de él también...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"bg",file="ev_uni_c03_01",path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"text"},
text={
ja={
{
"Al decir eso, Ai miró hacia el cielo.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"E interpuesta entre su mirada, había una chimenea sobresaliendo de entre el\nbosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Aún está soltando humo.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"bgm",stop=1,time=8000},
{"text"},
text={
vo={
{"vo",file="fem_aid_000088",ch="aid"},
},
ja={
{
name={"Ai"},
"Todo acaba de terminar, así que quizás no importe esperar un poco más para\ncomenzar algo nuevo...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_aid_000089",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Verdad, Kenichiro?...",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="00_op_01_3"},
{"text"},
linkback="block_00271",
},
label = {
top={block="block_00000",label=1},
},
}
