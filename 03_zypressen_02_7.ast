astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001511",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así lo haré entonces.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_kya_000027",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Te lo agradezco.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_jka_000027",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“Ah, Hikawa-san, ¿estás libre hoy después de clases? Acompáñanos un rato de vez\nen cuando.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001512",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, debería. Pero hoy no puedo, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000028",ch="jkb"},
},
ja={
{
name={"Colegiala B"},
"“¡Vamos, Hikawa-san, siempre es lo mismo! Sal con nosotras un poco, así sea un\npoquito, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001513",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, no lo niego. Pero tengo club hoy también, perdónenme.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_jka_000028",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“Ah, club de arte, ¿no? No podrás entonces, supongo. He escuchado que en el club\nde arte solo entran los mejores de los mejores.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000029",ch="jkb"},
},
ja={
{
name={"Colegiala B"},
"“Sí, sí, yo también escuché lo mismo. Parece que más de treinta personas\naplicaron y solo admitieron a unas pocas.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001514",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que no fue exactamente eso...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_jka_000029",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“Pero ahí es donde está ese senpai, ¿no? Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001515",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000030",ch="jkb"},
},
ja={
{
name={"Colegiala B"},
"“Sí, lo vi, lo vi. Pero, Hikawa-san, desde que entraste al colegio has hablado\nvarias veces de manera muy amistosa con él, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001516",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, nos habíamos conocido ya antes.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_jka_000030",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“Ya veo. Pero con lo linda que eres seguramente harían buena pareja.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001517",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no, para nada.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_jka_000031",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“Por supuesto que sí. Eres la única chica con quien podría imaginármelo juntas.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000031",ch="jkb"},
},
ja={
{
name={"Colegiala B"},
"“Oigan, pero hace poco entró una chica nueva al tercer año, ¿no recuerdan? Dicen\nque es la amiga de la infancia de Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_jka_000032",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“¡¿Hablas en serio?! ¡Hikawa-san, no puedes dejar que te lo quiten!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001518",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esperen, senpai y yo realmente no tenemos ese tipo de relación, simplemente\nsomos viejos conocidos.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_jka_000033",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“¿Viejos conocidos? ¿Llevan tiempo de conocerse?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001519",ch="rna"},
},
ja={
{
name={"Rina"},
"“Más o menos seis años, creo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_jka_000034",ch="jka"},
},
ja={
{
name={"Colegiala A"},
"“¡Entonces tú lo conoces más que ella!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001520",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso creen? No lo sé, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Rina no ha cambiado nada desde entonces.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"La gente sigue agolpándose a su alrededor.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Dentro del salón sigue siendo la misma serena, calmada y gentil Rina de hace\naños.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Si Rin-senpai llegó a llamarme la atención es porque, sin duda alguna, se\nparece a Rina.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Ambas tienen un particular aura que atrae a las personas.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"Rina voltea a ver acá.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
"Y entonces, me sonríe.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Mientras que yo...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001713",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*signo de la paz*",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Le hago una seña de la paz con la mano.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Rina toma esa actitud juguetona y bromista solo cuando está a solas conmigo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"No. Me frustra un poco admitirlo, pero eso no es del todo cierto.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"También lo hace frente a Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No sé cuál es la verdadera Rina. La que está siempre rodeada por los demás, o\naquella que veo cuando está con él y conmigo.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Pero si algo es cierto es que soy la única que puede disfrutar de ambas.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Naoya Kusanagi no conoce a la Rina del salón.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"No sabe lo elegante que puede ser Rina Hikawa.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"No voy a hablarle de lo encantadora que es esta chica. No tengo ganas de que se\nentere.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_yum_001714",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahora que lo recuerdo, la primera vez que me encontré a Naoya Kusanagi en el\ncolegio no supe por un momento quién era...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Desde hace tiempo era ya un tipo de aspecto poco confiable, y lo sigue siendo.\nPero creció, y su voz se tornó grave.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Y, quizás solo fue impresión mía, pero parecía tener ahora un porte sereno y\ncalmado.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_yum_001715",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ese idiota... Aun si no fuera el hijo de Kenichiro Kusanagi seguiría siendo\npopular con las mujeres...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"No tiene mala pinta.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Y su manera de actuar tampoco es incómoda...",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Hay que reconocerlo, a medida que más tiempo se pasa con él, más te das cuenta\nde lo amable y atractivo que es.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_yum_001716",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh... Incluso yo admito que lo es...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Pero hay algo que sí no puedo aceptar.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"se",id=3,file="se_semi"},
{"bg",file="white",path=":bg/"},
{"text"},
text={
ja={
{
"La verdad es que yo también he estado teniendo sueños.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Probablemente los mismos que ella.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"¿Será eso un milagro?",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"¿O será, como Kusanagi lo describe, una maldición?",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Sea lo que sea...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_yum_001717",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Prefiero creer que es un milagro...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"se",stop=1,id=3,time=500},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"se",file="se9038",id=2},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0003",head="rna_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"se",file="se0110",id=1,loop=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001521",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Yuumi, disculpa la tardanza! Bien, ¿nos vamos a pintar?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_001718",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001522",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Uhm? ¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_001719",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No pasa nada, solo que me quedé pensando en algo...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001523",ch="rna"},
},
ja={
{
name={"Rina"},
"“De verdad, ¿qué pasa? Has estado todo el día en las nubes.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_001720",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es nada grave. Solo estaba pensando en ti.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0015",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001524",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Otra vez con eso?...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_yum_001721",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No creas que miento cuando digo que me gustas...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001525",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Pensé que me vería de vuelta con una expresión pasmada. Pero solo lanzó un\nsuspiro, y...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001526",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Me contestó eso.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"se",stop=1,id=1,time=500},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Rina siempre pone una cara triste en estos momentos.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Y yo sé cuál es la razón.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"El sentimiento que te surge cuando no puedes corresponder el amor de alguien.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"La tristeza de no poder corresponder ese afecto.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Conozco ese sentimiento.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Aquel día no aguantaba la incertidumbre de no saber qué hacer, y preferí\naclarar las cosas de una buena vez.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"'Me das ganas de vomitar'. Eso fue lo que le respondí cuando se me confesó.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Y era mentira.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Me parece un hombre apuesto.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Cuánto me hubiera gustado ser normal, como los demás.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Hubiera sido maravilloso si hubiese podido enamorarme de él.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Pero el amor y el odio no se someten a la lógica.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Por más buen hombre que sea, no puedo aceptarlo.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Y es que, por más que me agrade, eso no es amor.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Me gusta como amigo, pero soy incapaz de amarlo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Y lo mismo le sucede a Rina.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"La relación que llevamos Rina y yo es la misma que tuve con él cuando era una\nniña.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Eso lo sé.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
vo={
{"vo",file="fem_yum_001722",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina～”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",id=1,file="se_bafu"},
{"bg",file="ev_com_d03_01",path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001527",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa? ¿Y por qué estás acostándote sobre mis piernas?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_yum_001723",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Somos dos chicas, no hay ningún problema.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_d03_02",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001528",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ugh～ Eso solo funciona cuando la otra chica no oculta ninguna intención\nlasciva...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_001724",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, ¿y cuál es el problema? Si ya sabes que tengo esa intención entonces no\nhay nada que ocultar. Mis intenciones siempre han sido claras contigo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rna_001529",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_001725",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Es que no he demostrado aún lo suficientemente bien lo mucho que me\ngustas?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rna_001530",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, ya eso lo sé muy bien.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_yum_001726",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué es lo que no logras saber entonces?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rna_001531",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, qué importa...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",file="se9010",vol=30,id=1},
{"bg",file="ev_com_d03_03",path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
ja={
{
"Rina comienza a acariciar mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_d03_04",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001727",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Waah, hace tanto tiempo que no acariciabas mi cabeza de esta forma.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rna_001532",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongo...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_yum_001728",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, soy una lesbiana muy tranquila, no te haré nada malo. Para mí lo más\nimportante es tu felicidad.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_001533",ch="rna"},
},
ja={
{
name={"Rina"},
"“No digas esas cosas...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_d03_05",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001729",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rna_001534",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_001535",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, ¿acaso crees que soy una especie de autómata sin corazón?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_yum_001730",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No. Aunque hace tiempo sí lo pensaba...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_d03_06",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001536",ch="rna"},
},
ja={
{
name={"Rina"},
"“Señor lobo, señor lobo, Caperucita también tiene un corazón.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rna_001537",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que no crea que Caperucita se dejó comer sin pensárselo bien antes.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_d03_05",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001731",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_d03_06",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001538",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién sabe? No soy Caperucita roja, no puedo saber qué está pensando...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rna_001539",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es que, mi sombrilla es blanca...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_001732",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_d03_03",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001733",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Se te han seguido confesando muchos hombres, Rina?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rna_001540",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué cambio tan súbito de tema...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_001734",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es que siempre hablas de cosas muy complicadas, desde que te conozco. La verdad\nes que la vez que hablamos de noche en el parque cuando éramos niñas no\nentendí ni la mitad de lo que me dijiste.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rna_001541",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno, debo admitir que mis conversaciones suelen tornarse muy abstractas, y\nsin preámbulo alguno...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_001542",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero ¿podrías explicarme que tiene que ver el hecho de que no entiendas mis\ntemas de conversación con el hecho de que vengas a preguntarme ahora y de\nrepente si se me han confesado muchas personas?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_yum_001735",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es mentira. Yo lo sé. Solo desde que ingresaste a Yumihari se te han\nconfesado 16 veces, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rna_001543",ch="rna"},
},
ja={
{
name={"Rina"},
"“No llevo la cuenta...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_001736",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aun después de entrar a Yumihari no han dejado de venir hombres tras de ti,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_rna_001544",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué me preguntas eso?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_001737",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Te quiero mucho, Rina. Te quiero demasiado, y quisiera saber qué tanto los\ndemás quieren a la chica que tanto me gusta.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rna_001545",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué excusa tan rara.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_001738",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todos te aman, pero no eres de nadie.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_yum_001739",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No le perteneces a nadie por ahora, y por eso me alegra que día a día aumente\nmás la cantidad de hombres que has rechazado.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_d03_06",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001546",ch="rna"},
},
ja={
{
name={"Rina"},
"“No voy a hablar de eso con alguien capaz de decir esas cosas. Y además, la\nmanera en que lo dices es irrespetuosa con ellos.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_yum_001740",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Entonces sí se te han confesado.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_rna_001547",ch="rna"},
},
ja={
{
name={"Rina"},
"“En el hipotético caso de que existieran, quise decir.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001741",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rompecorazones～”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_d03_03",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001548",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tonta, tonta.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Rina acaricia mi cabeza, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_rna_001549",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No pintarás hoy?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_yum_001742",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pintar...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_001743",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿quieres terminar tu pintura?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_rna_001550",ch="rna"},
},
ja={
{
name={"Rina"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001744",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Va a ser de cipreses y cerezos?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rna_001551",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_yum_001745",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te gusta Kusanagi-senpai, Rina?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rna_001552",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Me gusta.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_yum_001746",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No entiendo por qué no se lo dices entonces.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_rna_001553",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo haré.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_001747",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué? No creo que te rechace.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_rna_001554",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los asuntos entre hombres y mujeres no son tan sencillos como para reducirlos a\nsimplemente enamorarse, confesarse y ya.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_001748",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero te gusta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rna_001555",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_001749",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es acaso porque vino Rin-senpai?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_001556",ch="rna"},
},
ja={
{
name={"Rina"},
"“De ninguna manera. Rin-senpai no tiene nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_001750",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Entonces...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Pensé en decir algo, pero preferí no hacerlo.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Y es que era algo excesivamente ridículo...",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_001557",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes algo, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_001751",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rna_001558",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre me ha gustado acariciar tu cabeza, desde pequeñas.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_001752",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿En serio? No sabía. ¿No te gustaría entonces probar a acariciar otras\npartes?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rna_001559",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no me hace falta.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_001753",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, no seas mala... Podrías acariciar mis pechos también.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bg",file="ev_com_d03_06",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001560",ch="rna"},
},
ja={
{
name={"Rina"},
"“No soy fanática de los pechos planos.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_001754",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gaaah. No puedo creer que me hayas dicho algo tan cruel.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_d03_03",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001561",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo bromeaba. Pero igual, me conformo con acariciar tu cabeza.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_001755",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Puedo entonces acariciar los tuyos? ¿Sí, sí?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_d03_02",sync=0,face=1,time=400,path=":ev/ev_com_d03/",set="ev_com_d03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001562",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué... se supone... que debería dejar que hagas eso?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_rna_001563",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿C-Cómo, es que llegamos a esto?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_d04_01",rule=139,vague=40,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001756",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No está mal, ¿no? Tú acaricias mi cabeza y yo hundo mi cara en tus pechos~”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rna_001564",ch="rna"},
},
ja={
{
name={"Rina"},
"“No le veo lo bueno a esto.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_001757",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es un buen trato, un gana-gana.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_rna_001565",ch="rna"},
},
ja={
{
name={"Rina"},
"“A mí no me parece...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_001758",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si realmente no te gusta entonces no lo haré...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_d04_02",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001566",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Después de quedarse viéndome por un momento...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Rina me apretujó.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_d04_03",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001759",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Están tan grandes y suavecitos.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rna_001567",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues sí, crecieron más de lo necesario...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_yum_001760",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así están bien. Y además, justo hace un rato criticaste mis pechos pequeños.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rna_001568",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso solo fue una broma. No me interesan los pechos de las chicas.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_yum_001761",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo sé. Pero ¿no te han dado ganas alguna vez de manosearle los pechos a\nRin-senpai?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rna_001569",ch="rna"},
},
ja={
{
name={"Rina"},
"“A-Ah, pues, en ese caso, creo que sí.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_001762",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Entonces sí tienes problemas con los pechos planos!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rna_001570",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no es por eso. Solo que, con lo grande que los tiene Rin-senpai pensé que,\naun si los tocara seguiría pasando por una broma...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_yum_001763",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Tratas de decir que en mi caso se sienten tan reales que no te atreverías a\ntocarlos?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rna_001571",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pueees, no es exactamente eso... ¿O tal vez sí?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_001764",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Has herido mis sentimientos. Y muy profundamente. ¿Puedo lamer tus pezones?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rna_001572",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bg",file="ev_com_d04_04",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001765",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pero, pero, me has herido de gravedad!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_001573",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pretendes con lamer mis pezones?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_com_d04_05",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001766",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Excitarme!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001574",ch="rna"},
},
ja={
{
name={"Rina"},
"“Escucha, eso ya no suena para nada a una simple broma.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_001767",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te parece? ¿Acaso no es algo normal que las mejores amigas se chupen los\npezones?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rna_001575",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jamás en mi vida he escuchado algo parecido.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_yum_001768",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdadー? ¿De verdad verdadー?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_d04_07",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001576",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Espera! ¡No desabroches mi sostén por encima de mi ropa!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_yum_001769",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jejejen, un virgencito no sería capaz de hacer esto.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001577",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me agradaría para nada un hombre capaz de desabrochar un sostén con tanta\nhabilidad, fuera virgen o no...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_com_d04_05",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001770",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tus pechos son más grandes que los de Rin-senpai, Rina.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rna_001578",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, no conozco sus medidas de busto...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_yum_001771",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Según mis estimaciones, Rin-senpai es 88, copa F, Toritani-senpai es 90, copa\nG. ¡Y tú, Rina, eres 92, copa G!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_com_d04_08",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001579",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwah, no conozco las medidas de las demás, pero las mías están muy acertadas.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_001772",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No en vano soy una lesbiana pervertida que le encanta tomar fotos a escondidas.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001580",ch="rna"},
},
ja={
{
name={"Rina"},
"“No entiendo de qué estás tan orgullosa...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_001773",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Puedo hundir mi cara en tus pechos sin el sujetador? ¿Sí, sí?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",file="ev_com_d04_07",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001581",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_001774",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo haré por encima de tu ropa, no te preocupes. Solo que teniendo tu sujetador\nde por medio no puedo sentirlos bien.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001582",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tendría que pasarlo por los brazos para quitármelo, no puedo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_001775",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y si lo deslizo un poquito?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rna_001583",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Deslizarlo un poco? Uhm, no sé.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_001776",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Desde que entré a este colegio me he comportado mucho mejor a como lo hacía\nantes, ¿verdad, verdad?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rna_001584",ch="rna"},
},
ja={
{
name={"Rina"},
"“Considerando lo que sucedió ayer, no estaría muy confiada de eso.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_001777",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kusanagi es mi enemigo, lo que le haya hecho no cuenta.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_yum_001778",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“He sido una buena niña, ¿no crees que me merezco una recompensa?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rna_001585",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya recompensa que pides...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_001586",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me das un segundo?...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"se",file="se0897s",id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rina me hizo a un lado y comenzó a mover sus manos dentro de su camisa.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rna_001587",ch="rna"},
},
ja={
{
name={"Rina"},
"“Listo, me quité el sujetador.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_001779",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿De veras?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rna_001588",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puedes hundir tu cara en mis pechos si quieres, pero prométeme que no volverás\na hacer algo parecido a lo de ayer. Y también prométeme contarme cuando\ntengas algún problema.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_yum_001780",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_com_d04_03",path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
ja={
{
"Hundo mi cuerpo en los senos de Rina.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_yum_001781",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Waaai, están acolchaditos. Mucho más que hace un rato.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rna_001589",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me alegro por eso.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"bg",file="ev_com_d04_09",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001782",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No puedo. Esto es irresistible.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_rna_001590",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_yum_001783",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es como un sofá que convierte a la gente en zombis perezosos...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001591",ch="rna"},
},
ja={
{
name={"Rina"},
"“Agradecería que no hables de mí como si fuera una silla humana...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_yum_001784",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahー, esto es increíbleー. Qué delicia, qué felicidadー.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rna_001592",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tan feliz te hace esto?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_yum_001785",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. En este momento soy la persona más feliz en este planeta.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_rna_001593",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Qué bueno, supongo...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"A veces Rina me deja juguetear con ella. Aunque siempre lo hace con una\nexpresión triste en su rostro.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Son momentos de 50 % felicidad, y 50 % de tristeza.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Así que no puedo bromear y disfrutar a pleno como siempre lo hago.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Aunque, debo admitir que también me gusta la expresión que tiene cuando pone\nesa cara. Creo que si solo fuera una simple chica alegre y optimista, no me\nhubiera enamorado de esta manera de ella.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Ahh, sus pechos son tan suaves y blandos.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Y su cara, su cara es tan linda.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Esa carita triste.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Soy yo la culpable de que ponga esa cara.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Incluso eso se me hace tierno.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Aun a pesar de estar poniéndola triste, y quizás, causándole dolor también. Soy\nun maldito gusano.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rna_001594",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es mi imaginación o estás tratando de buscar mis pezones?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_yum_001786",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, claro que no. No estoy usando mis dedos, ¿ves?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_rna_001595",ch="rna"},
},
ja={
{
name={"Rina"},
"“Con los labios.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_yum_001787",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, ¿qué problema hay con que chupe tus pezones por encima de la ropa?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"bg",file="ev_com_d04_07",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001596",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Por supuesto que lo hay, vas a dejarme la chaqueta cubierta de saliva!”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_001788",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No pasa nada. Por mi parte, tengo los calzones como un trapo mojado en este\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_rna_001597",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que sí pasa, bastante. ¡Y si eso es verdad ve a los lavabos y\nlímpiate!”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_001789",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ehー, solo era una pequeña bromitaー. Déjame disfrutar un poco más de esto,\n¿síー, síー?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001598",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nunca logro saber qué tanto hay de broma y qué tanto de verdad en lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_001790",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uhhm. Pues, ¿podrías mantenerlo en secreto?...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_rna_001599",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí quieres mantenerlo en secreto entonces no lo menciones tanto.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_yum_001791",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo es una broma.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_rna_001600",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero podría ser cierto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_yum_001792",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_yum_001793",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué tanta verdad crees que haya en lo que digo?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_rna_001601",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, nunca me he puesto a pensar mucho en el asunto... Aunque no hay que\nolvidar que te gusta también tomar fotografías de los demás sin permiso.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_001794",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Y hablando de eso, hice una dakimakura con tu foto, Rina.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_rna_001602",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es que acaso era verdad eso?...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_yum_001795",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, la hice. Usé varias de tus fotos.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_yum_001796",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sabes qué hago con ella? La pongo en la cama conmigo, y me le quedo viendo.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_yum_001797",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me quedo viéndole fijamente, sin pestañear. Y entonces, cuando llega el\nmomento, cierro mis ojos.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_yum_001798",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero es difícil. Cuesta hacer que vengas.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_rna_001603",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Que venga yo? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_yum_001799",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Lo hago varias veces.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_yum_001800",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y entre tantos intentos, me llega ese presentimiento... Y pienso, '¿Quizás\nahora sí?'.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rna_001604",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿La dakimakura se convierte en mí?!”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_yum_001801",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Es una hazaña que solo un amor como el mío podría lograr... Por lo general,\ndespués de que pasan tres horas es que finalmente llegas a mí.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"bg",file="ev_com_d04_08",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001605",ch="rna"},
},
ja={
{
name={"Rina"},
"“T-Tres horas...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_yum_001802",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y entonces, comienzo a conversar contigo.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_001803",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y al culminar, la habitación termina hecha un desastre con mis jugos.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_rna_001606",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues... vaya que tuvo un final bastante intenso esa conversación...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001804",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Crees que esto es una broma?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_rna_001607",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo sé, la verdad. Me da igual.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_001805",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me imaginé que dirías eso.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_yum_001806",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿puedo chupar tus pezones?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_rna_001608",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_yum_001807",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Bien, entiendo! ¿Puedo quitarte la ropa entonces?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"bg",file="ev_com_d04_07",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001609",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué se supone que debería someterme a esa clase de juegos sexuales\ncontigo? Estamos en la azotea, por si lo olvidas.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_yum_001808",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quiero sentirlas directamente...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"bg",file="ev_com_d04_06",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001610",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, se acabó esto ya.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_yum_001809",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Perdóname, solo déjame disfrutarlos un poco más.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="fem_yum_001810",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esto es de lo mejor... ¿Por qué será que las chicas son así de suaves?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_rna_001611",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo somos. Tú también lo eres, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="fem_yum_001811",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Dices eso aun después de haberme llamado pecho plano?”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
vo={
{"vo",file="fem_rna_001612",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los senos no son la única parte suave de las mujeres.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_yum_001812",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? N-No serán los rollos de mi panza, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_rna_001613",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no. Me refiero a tu aroma, y lo demás.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_yum_001813",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mi aroma? Pero si no uso ningún perfume.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="fem_rna_001614",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tus coletas son tan largas que se siente con fuerza el aroma del enjuague. Creo\nque incluso más que yo, que tengo trenzas.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_yum_001814",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_rna_001615",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. ¿No te habías dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_yum_001815",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, en ningún momento.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="fem_rna_001616",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además, tu cabello es muy hermoso. Creo que no he visto a nadie con un\ncabello así de precioso...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_yum_001816",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te parece? La verdad es que no lo toco mucho...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_rna_001617",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No será por eso? Cuando usas tintes y esa clase de sustancias el cabello se\ndeteriora.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="fem_yum_001817",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo... No me había dado cuenta de eso.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_rna_001618",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es por eso que estos ratos son de felicidad para mí también.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_yum_001818",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"50 % verdad. 50 % mentira.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Aun así, ella sigue acariciando cariñosamente mi cabello.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Creo que le gusta hacerlo.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Se siente, muy bien...",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Tanto que... siento muy pesados... mis parpados.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"bgm",stop=1,time=2000},
{"bg",time=2000,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001619",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esto ocurrió la noche anterior a aquella de los ZYPRESSEN.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_rna_001620",ch="rna"},
},
ja={
{
name={"Rina"},
"“Antes de que se convirtieran en cerezos.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
vo={
{"vo",file="fem_rna_001621",ch="rna"},
},
ja={
{
name={"Rina"},
"“La niña de la sombrilla blanca germinó y creció allí para ser devorada por el\nlobo.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="fem_rna_001622",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que el lobo fue, probablemente, víctima de la tetrodotoxina.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="fem_rna_001623",ch="rna"},
},
ja={
{
name={"Rina"},
"“El lobo sucumbió al veneno.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="fem_rna_001624",ch="rna"},
},
ja={
{
name={"Rina"},
"“La niña que el lobo devoró tenía una dieta a base de 'UFT Sunfural S'. Al\nalimentarse de veneno, naturalmente este se acumulaba en su cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_rna_001625",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ella era una seta venenosa, del género de las Amanita, con tallo y sombrilla\nblanca. La niña Amanita atrae a los demás con una sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="fem_rna_001626",ch="rna"},
},
ja={
{
name={"Rina"},
"“La niña Amanita está siempre sonriendo entre todos.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_rna_001627",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una seta venenosa, sola, oculta en el bosque de ZYPRESSEN. Ni siquiera el lobo\npodría resistirse a poner sus garras sobre ella.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_rna_001628",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y por eso, ella es la víctima.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"msgoff"},
{"ex",time=2000,func="wait"},
{"bg",file="ev_com_d04_10",path=":ev/ev_com_d04/",set="ev_com_d04"},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001819",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿O, oeh? ¿M-Me quedé dormida?”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="fem_rna_001629",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Estabas durmiendo muy placidamente.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"bg",file="ev_com_d04_11",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001820",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y-Ya veo... Gununh... ¡N-No puedo creer que desperdiciara nuestro valioso\ntiempo juntas de esta manera!”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="fem_rna_001630",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues ese valioso tiempo te sirvió para relajarte, ¿no te parece bien así?”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
vo={
{"vo",file="fem_yum_001821",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡T-Tal vez, pero más que relajarme, yo quería más, algo más!”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_rna_001631",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, está bien, está bien. Pero no miento, realmente estabas durmiendo muy\nplácidamente, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"bg",file="ev_com_d04_12",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001822",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muhー, no me causa mucha alegría que vieras mi cara mientras dormía...”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
vo={
{"vo",file="fem_rna_001632",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás. Pero a los que tenemos la oportunidad de ver esas caras si nos alegra.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="fem_rna_001633",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongo que valió la pena quitarme el sostén. Dormiste bien, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"bg",file="ev_com_d04_13",sync=0,face=1,time=400,path=":ev/ev_com_d04/",set="ev_com_d04"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001823",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="fem_rna_001634",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, creo que ya deberíamos irnos.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="fem_yum_001824",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Espera, solo un poco más!”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_rna_001635",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya está, se acabó. ¡Nos vamos!”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z1",my=40,mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=9},
{"se",file="se9010",id=1},
{"fgact",ch="里奈",act="あくび",time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001636",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhhhn.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Rina se estira fuertemente.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_yum_001825",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Estás cansada?”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001637",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tanto, en realidad. ¿Pudiste dormir bien?”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="fem_yum_001826",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Llevaba rato sin dormir sin ningún sueño.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001638",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Pues me alegro que pudieras descansar.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_yum_001827",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001639",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_yum_001828",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001640",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hay de qué.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Rina me sonríe, con el sol poniéndose a su espalda.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"En ese momento, pensé: 'No le quiero dar esta sonrisa a nadie más'...",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"Pero... eso es imposible.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"Así que por ahora, aunque sea solo por estos momentos, quiero tener su sonrisa\nsolo para mí...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
