astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c07_01",path=":ev/ev_eye_c07/",set="ev_eye_c07"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Esa mañana, después de desayunar.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Le revelé a Ai nuestra relación.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_aid_000769",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Ai me escuchó sin interponer una sola palabra.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuidaré bien de Shizuku. Estoy decidido de todo corazón.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000770",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya, sal y demuéstrame eso...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? E-Entonces...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000771",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué? Estás decidido, ¿no? Demuéstramelo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, bueno. Salgamos afuera... Golpéame todo lo que quieras...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000772",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿I-Idiota?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000773",ch="aid"},
},
ja={
{
name={"Ai"},
"“Obviamente estoy bromeando...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Era una broma?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000774",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí. Y además... si es por golpearte, podría hacerlo aquí.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"ex",time=100,func="wait"},
{"bgm",stop=1,time=500},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se1528"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Ai me propina una cachetada.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000775",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esto es por haberte tardado en decírmelo. ¿Por qué no me dijeron antes que\nestaban en una relación?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000776",ch="aid"},
},
ja={
{
name={"Ai"},
"“No tengo nada más que decir aparte de eso.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0018",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000777",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fui yo quien te trajo a esta casa. Soy yo quien tiene la responsabilidad en\nesto.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, fui yo quien decidió iniciar una relación con Shizuku, y--”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0002",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000778",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya lo sé. Sé que no es un simple juego, y que tus sentimientos son reales.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ai...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000779",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero eso no cambia el hecho de que ustedes aún son solo unos estudiantes de\nsecundaria.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si necesitas que me haga responsable y le pida la mano, abandonaré de una vez\ndel colegio y--”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0017",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0015",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000780",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre yendo a los extremos. ¿Por qué los Kusanagi siempre salen con esas\ncosas?...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000781",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quiero que entres a la universidad y que consigas un buen trabajo. No vuelvas a\ndecir que vas a tomar responsabilidad en medio del furor de la conversación,\nes irresponsable.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000782",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000783",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es mi responsabilidad que esto haya resultado así. Siendo tú el futuro esposo\nde mi hermana menor, me ocuparé de velar por todos los aspectos de tu vida.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De mi vida?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000784",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Me ocuparé de la matrícula de la universidad, el transporte fuera y de\nvuelta a casa, y todos los demás gastos necesarios hasta que te gradúes y\nconsigas un empleo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no hace falta que hagas tanto... Todavía tengo algo de la herencia que\nmi madre me dejó, solo por si acaso...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000785",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo sé, pero insisto. Usa esa fortuna para tu propio bien en el futuro...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000786",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿O es que creías que yo no sabía nada?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000787",ch="aid"},
},
ja={
{
name={"Ai"},
"“Al parecer la Farmacéutica Nakamura publicó seis de las Sakura Nanasouzu,\n¿viste?...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000788",ch="aid"},
},
ja={
{
name={"Ai"},
"“Recuerdo haber visto unos cuadros idénticos en el depósito...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000789",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku llegó a venir varias veces en medio de la noche cuando trabajabas,\n¿verdad? Apenas la vi la seguí.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000790",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y observé que entró en el depósito... Los cerezos se cruzaron por mis ojos\ncuando la puerta se abrió...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000791",ch="aid"},
},
ja={
{
name={"Ai"},
"“En algún momento se me ocurrió que quizás Shizuku había regresado a Japón. Así\nque le pregunté varias veces a Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000792",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero siempre decía lo mismo. 'Yo no sé'...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000793",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nunca se me ocurrió que tú estarías encubriéndola hasta que te vi junto a ella.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000794",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y... fue cuando me entere de la verdad que me di cuenta de lo impotente que\nera...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000795",ch="aid"},
},
ja={
{
name={"Ai"},
"“'¿Es que los Kusanagi van a rescatarnos otra vez?' Pensé...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los Kusanagi somos familia con los Natsume, por si lo olvidas.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000796",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, de esa forma nos crió la abuela Kotoko...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000797",ch="aid"},
},
ja={
{
name={"Ai"},
"“Unas semanas después de haber visto ese cuadro, Shizuku regresó a esta casa.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000798",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me contó que ya era libre.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000799",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y ella misma estaba llorando, aparentemente frustrada...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Llorando? ¿Ella?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000800",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, estaba llorando. Sus emociones no son de mucho cambiar, pero aun así es\ncapaz de llorar cuando se entristece.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000801",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre somos nosotros los que acaban siendo rescatados, protegidos...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas, Ai.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú me rescataste a mí también.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando era todavía un niño, regresé al país para cuidar de mi enferma madre.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero era solo un indefenso niño. No podía hacer nada yo solo.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tú venías con frecuencia a nuestra casa, a cuidar de mamá.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000802",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué no es obvio? Mizuna-san es mi única hermana mayor. ¿Qué hermana menor no\ncuidaría de su hermana más grande?...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, me sentí protegido gracias a ti.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000803",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Tú? ¿Por mí? Pues, me reconforta mucho saber eso. La verdad es que estaba\nconvencida de que no he podido hacer nada por ti nunca...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000804",ch="aid"},
},
ja={
{
name={"Ai"},
"“En parte lo es. Así que quiero que confíes un poco más en mí. Quizás sea débil\ne indefensa, pero en todo momento estoy pendiente de ti.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000805",ch="aid"},
},
ja={
{
name={"Ai"},
"“Han pasado muchas cosas últimamente... Kenichiro-san... Shizuku... y lo de\nMisakura...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo de Misakura?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000806",ch="aid"},
},
ja={
{
name={"Ai"},
"“Andas ocultándolo, ¿no? Lo de Misakura.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces a Rin, Ai?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0006",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000807",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Cómo no podría saberlo? Es la primera amiga que Shizuku tuvo.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Pero nunca diste impresión alguna de conocerla.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000808",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku y tú estaban ocultándole algo, me di cuenta de eso. Así que pensé que\nlo mejor sería fingir que no sabía nada.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000809",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si llegara a saber de ella, probablemente todo se desmoronaría.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000810",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya Shizuku te habló de Rin, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque no todo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000811",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo... Lo mejor es que sea la misma Shizuku quien te cuente de aquel\nincidente. Y cuando lo haga, deberás escuchar.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si está bien en que yo me entere, pues me gustaría saberlo...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000812",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Quién diría que Shizuku y tú terminarían juntos?... Debería estar enojada,\npero la alegría es mucho más grande ahora.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000813",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku, entra.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Ai llama a Shizuku, quien estaba en el pasillo.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x2=0,x=-345,lv=4,id=9},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001016",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000814",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cuida y quiere mucho a Naoya. No es solamente el hombre del cual te enamoraste,\nes también el salvador de la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001017",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000815",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Sí? Pues entonces está bien.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000816",ch="aid"},
},
ja={
{
name={"Ai"},
"“Se acabó el tema entonces.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000817",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku, debes explicarle muy bien, tú misma... acerca de ese incidente.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001018",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Shizuku asintió con fuerza.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Juraba que Ai me golpearía...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001019",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ai nee-san no haría eso.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De hecho sí, ya me ha golpeado una vez.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001020",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Cuándo?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquella mañana que te dormiste en la cocina y te llevé a tu habitación. Me vio\nsaliendo de tu cuarto y pensó que había ido en la noche a hacer cosas\nobscenas.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0010",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001021",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ai nee-san sería capaz de hacerlo, en caso de que eso sucediera sin estar los\ndos en una relación formal.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001022",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero ya le contaste todo a nee-san. Así que no te golpeará.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad lo crees?...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001023",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... Por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Shizuku observa el jardín por la puerta deslizante abierta.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001024",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es mi turno ahora.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tu turno? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001025",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Tengo algo que contarte...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, a mí?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001026",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, acerca de Rin y de mí...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, eso...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso, sí...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Observo también el jardín mientras me rasco la cabeza.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que pasó entre las dos, eh...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Ese pasado oculto.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Así como yo estuve ocultándole todo a Rin, Shizuku y mi viejo estuvieron\nocultándome algo a mí.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Porque era, precisamente, una verdad que no necesitaba saberse.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Pero ahora que Shizuku y yo somos una pareja, no es bueno ocultarnos cosas\nentre los dos.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Y siendo algo que tiene que ver con Kenichiro Kusanagi, Rin Misakura y la\nfamilia Natsume, con más razón debo saberlo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escuchar todo eso justamente después de haberle revelado nuestra relación a Ai\nes... La verdad es que no me siento completamente preparado emocionalmente\npara eso...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001027",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Debería entonces hacerlo más difícil?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me enteré de esa verdad cuando eras todavía Kuzu. Y desde entonces, he sentido\ncuriosidad por saber qué sucedió.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ahora que tengo la posibilidad de enterarme de un momento para otro, me\nsiento algo extraño.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero así como Ai lo mencionó, eres tú quien debe contarme.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sé también que ya es ese momento... Así que preferiría que lo hicieras ya y\nno pusieras las cosas difíciles.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001028",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001029",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quiero que sepas. Acerca del pasado que Rin y yo tuvimos...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001030",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque quizás se alargue un poco la historia.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001031",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y es que en esos recuerdos con Rin siempre estuvo Kenichiro-san...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse, se supone que era su discípula...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001032",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así es. Aunque, también estaban Ai nee-san, la abuela Natsume, Saki\nNakamura-san... y Sui.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Saki Nakamura? ¿Mm? Ehm... ¿Quién es Saki Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0012",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001033",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es conocida ahora como Saki Toritani-san.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿N-No es esa la directora de Yumihari? ¿Es que acaso conoces a la directora?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001034",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo un poco... Aunque me dejó una fuerte impresión cuando la conocí...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001035",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Será algo larga la historia, ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Shizuku comenzó a contar todo, muy despacio. Acerca de la historia de las dos\nmuchachas...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"De su pasado, de cómo se conocieron por estos rincones, y de cómo sus caminos\nse separaron...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
