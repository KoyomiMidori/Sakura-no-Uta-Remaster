astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"se",id=1,file="se2658"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg019b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm103"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Ambos estuvimos en completo silencio desde inicio a fin.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Es posible que quizás haya quedada un poco indignada conmigo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Pues, sí, por más que me haya hecho esperar, no había razón para tomar esa\nactitud de animal desesperado.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Debí haber desistido de la idea y calmarme apenas apareció el señor del\nparque...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002486",ch="rnd"},
},
ja={
{
name={"Rin"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Rin está viéndome.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Por mi parte, la pena me impide devolverle la mirada.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"msgoff"},
{"bg",file="eveningsky_summer",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"se",file="se9012",loop=1,id=1},
{"cgdel",id=-1},
{"msgoff"},
{"bg",y=80,x=-160,zoom=100,speed=300000,file="zbg030c",path=":bg/",z2=50,x2=0,y2=-20,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2c0100",face="c0001",head="rin_z2c",x=240,y=40,lv=5,id=9,sync=0},
{"extrans",time=1000,sync=0},
{"cgact",stage="zbg030",y=100,act="びっくり",loop=-1,size=1,time=800},
{"fgact",ch="稟",act="びっくり",loop=-1,size=3,time=700,lv=5,id=9},
{"text"},
text={
ja={
{
"Después de eso, seguimos caminando por la zona residencial, en total silencio.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Rin estuvo todo el trayecto cabizbaja.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"¿Estará un poco incómoda la atmósfera entre los dos?...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"No lo sé muy bien.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Por lo general, de caminar los dos solos en silencio como lo hacemos ahora,\npensaría que las cosas están incomodas.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Pero, por alguna extraña y misteriosa razón, no sentía eso ahora.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"¿Será simplemente por lo tardo que soy?...",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Por alguna razón, me pareció que a pesar de estar en silencio los dos, no había\nrealmente ningún problema.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Rin está con la cabeza hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No dice nada.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Pero me pareció que eso se debía a que en este momento, entre los dos, no\nhacían falta palabras.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm103"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024c",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que ya llegamos. Me iré ya, entonces...”",
{"rt2"},
},
},
},
labelcount=2,
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002487",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fgact",ch="稟",act="おじぎ",size=5,lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin agarra fuertemente de mi brazo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002488",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"se",file="se0888f",id=1,vol=50},
{"fg",mode=-2,sync=0},
{"bg",x=120,y=360,speed=4000,file="zbg024c",path=":bg/",x2=-270,y2=-470,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Rin jala de mi mano y comienza a subir las escaleras de su apartamento.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"se",stop=1,id=1,time=500},
{"se",id=2,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... con permiso...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002489",ch="rnd"},
},
ja={
{
name={"Rin"},
"“He llegado...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha, R--”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"se",file="se9002",vol=50,id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002490",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*amuh*... *chuu*... *chuu chuu*... *hamuh*...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Un beso repentino.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Siendo más pequeña que yo, Rin estaba de puntillas ahora, tratando con todas\nsus fuerzas de comer mis labios.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puhaa... ¿R-Rin?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002491",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*chuu*... *chu*... *chupaah*, *kuchuu*... *chupaa*...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... ah...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=240000,file="zbg025d",path=":bg/",x2=0,y2=-586,x=-960,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"La mano de Rin se extiende hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Está sobando ahora mi miembro por encima del pantalón.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin... kuh... a-ahh...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"La suave mano de Rin está ahora acariciando mi miembro por encima del pantalón.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Suelto una voz un tanto patética.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002492",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*chuu*... *kuchuu*... *chuu*... *chupaa*... Hauuh.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Rin se adhiere a mis labios y manosea mis partes inferiores sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Sin poder aguantarlo más, levanté la falda de Rin y traté de tocar 'esa' parte.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"El interior de su falda estaba increíblemente caliente, y――",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto está...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Mi mano se detiene antes de llegar allí.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Rin para los besos y se dispone a hablar, con su cara enrojecida.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002493",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No eras el único que estaba tratando de aguantar las ganas, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002494",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también tuve mi cuerpo en calor durante todo este tiempo. No podía\nconcentrarme de ninguna manera en las clases...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002495",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me llamabas la atención en todo momento, y me quedé observándote, todo el\ndía...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0010j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002496",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Probablemente, he estado peor que tú...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002497",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al verte, sentí que en cualquier momento podría acabar haciéndolo por mi\ncuenta, y tuve terror de mí misma.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Tanto así? ¿Eh, con eso te refieres a que pensaste en masturbarte en medio\nde las clases?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002498",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto, no lo haría. No hay manera de que sea capaz de hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002499",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Y es que eso sería un desperdicio.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿U-Un desperdicio?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002500",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Pensé que tal vez, mientras más aguantara, más placer podría sentir junto a\nti, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0010j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002501",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Definitivamente soy una chica muy rara, ¿verdad?... Aun siendo mi primera vez,\nsolo pienso en cosas sucias...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no es de sorprenderse. Con lo que sucedió esta mañana... y además,\nconsiderando que ahora haremos más cosas sucias...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002502",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tal vez, pero ¿no se supone que normalmente se hace de una forma más\nsolemne? Es la primera vez. La primera vez que podré ser una con la persona\nque amo...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si deba ser más solemne o no, pero... sí, supongo que quizás normalmente\nes algo más romántico.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0010j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002503",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Verdad? Nadie hace esto... Comenzar a hacerlo al apenas llegar a la entrada,\nal regresar a casa, como si fuera un animal en celo...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002504",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero apenas vinimos, apenas entramos a mi apartamento, ya no podía aguantarlo\nmás, y, me pegué a tus labios como si tratara de comerlos...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siento lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0015j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002505",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué sucio esto, ¿no? Esta no es la clase de cosas que una pareja haría en su\nprimera vez.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, bueno, si ambos somos pervertidos entonces no hay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002506",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será que soy una pervertida?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Aunque yo sí lo soy.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002507",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces yo también lo soy.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"*chuu*...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002508",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... *kuchu*... *chupaa*... Hauuh... *chuu* *chuu*... *kuchuu*...\n*chupaa*... Hauuh... *chuu* *chuu*... *kuchu*...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Nos besamos aún con más pasión.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"Y entonces, nos agachamos en ese mismo lugar...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002509",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun... quiero seguir con la continuación de esta mañana...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es lo que debería decir yo... Quiero que me lo hagas, Rin...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002510",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, haremos... la continuación de lo de esta mañana. Y esta noche, hasta el\nfinal...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"se",file="se_zubon_out_long",id=1},
{"text"},
text={
ja={
{
"Rin pone sus manos sobre mi cremallera.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"se",stop=1,time=500,id=1},
{"fg",mode=-2},
{"bg",file="ev_rin_h06_02",path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002511",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, cierto... si vamos a seguir con lo de esta mañana, entonces... ¿no debería\ncomenzar por acá?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_rin_h06_03",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002512",ch="rnd"},
},
ja={
{
name={"Rin"},
"*chuu*...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002513",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Después de darle un beso a mi pene, Rin se detiene.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_rin_h06_02",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002514",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje... qué será esto...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002515",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ¿sabes? La verdad es que tenía pensado darle un beso a tu pe*e e\nimpacientarte un poco.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? ¿Qué pasa entonces?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002516",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que eso es imposible...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que es imposible?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002517",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No puedo aguantarme. Creo que me gusta mucho hacer esto...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te gusta hacer esto? ¿Hacer qué?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002518",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm... esto... ajajaja. No tiene caso apenarme, total, es algo muy\nvergonzoso... ¿Sabes, Nao-kun? Parece, que me encanta besar tu pe*e.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002519",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, Nao-kun, si no te importa, ¿podría seguir besando tu pene?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro, sí.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002520",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias... *chuu*.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_rin_h06_03",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002521",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*chuu*... *chuu* *chuu*... *kcuhu*, *chu*, *chuchu*... *chuu*, *pichaa*,\n*pichaa*... *kuchuu*...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Rin besa repetidamente mi miembro.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002522",ch="rnd"},
},
ja={
{
name={"Rin"},
"“U-Uh... ngh.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_rin_h06_02",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002523",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ¿podría besar mucho, mucho más tu pene?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto, tanto como quieras...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002524",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, no me refiero a la cantidad... ehm, dentro de todos los tipos de besos\nque hay, hay también besos largos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Besos largos?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002525",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿C-Cómo podría decirlo?... Siento que no puedo saciarme con un beso normal,\ny... pensé, que con un beso más largo podría sentirte por más tiempo,\nNao-kun...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te refieres a un beso profundo?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002526",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, un beso largo, de esos en los que se enganchan las lenguas... ¿Nao-kun,\npodría hacerlo con tu pene?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Rin trata de darse un beso profundo con mi pe*e. Eso, en pocas palabras es...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"La punta de mi miembro, el cual dio un pequeño y rápido salto, choca con los\nlabios de Rin.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002527",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Le daré ahora un beso profundo a tu pene con mi boca, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002528",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah... jaaa...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_rin_h06_04",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
ja={
{
"Un caluroso aliento me envuelve. Rin abre su boca...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-La boca de Rin irá... ahora a...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002529",ch="rnd"},
},
ja={
{
name={"Rin"},
"*rero*...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Aaahh! ¡Kuhaa!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"La lengua de Rin toca mi miembro. Esa sensación me da a saborear un placer que\njamás había experimentado antes.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"La sensación de esa suave y caliente lengua me hizo sentir como si una fuerte\nseñal eléctrica de placer corriera de mis testículos hacia mi cerebro.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002530",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... *kuchuu*... *rerorero*... Hauuun... ngh, ngh... nnghm...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, aaah! Kuhaaa...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_rin_h06_05",sync=0,face=1,time=400,path=":ev/ev_rin_h06/",set="ev_rin_h06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002531",ch="rnd"},
},
ja={
{
name={"Rin"},
