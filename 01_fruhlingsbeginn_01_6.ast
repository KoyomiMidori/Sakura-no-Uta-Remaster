astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm007"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg043e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Te lo preguntaré solo por confirmar. Dejando de un lado el descabellado\ntraje de Kei, ¿qué hay de esto?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000235",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es esto también parte de las actividades del club de arte para atraer nuevos\nintegrantes?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se2497",id=1},
},
},
text={
vo={
{"vo",file="fem_mkd_000236",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo es. Ya hice mis investigaciones. En fin, toma.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A qué te refieres con que hiciste tus investigaciones...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Al preguntar eso algo pasmado mientras recibía los folletos, Toritani me sonrío\nalegremente.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000237",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal como me lo imaginaba, Kusanagi, te queda muy bien. Eres alto, y tu cara,\npues, no está nada mal.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0004",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000238",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Usar todo lo que pueda usarse es mi lema, y es además el principio universal\ndel éxito de la humanidad! ¡Nada más observa lo lindo que se ve Kei!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0004",head="mak_z1d",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0009",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000475",ch="ked"},
},
ja={
{
name={"Kei"},
"“Auhh, quiero morirme ya...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000239",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes morirte cuando termines tu trabajo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres un demonio.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0016",head="mak_z1d",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000240",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me importa que me llamen así. ¡Observa nada más esto!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Toritani señaló firmemente con su dedo a la temblorosa cosa que tenía detrás de\nmí y dijo, con bastante confianza en su voz.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x="中",y=-300,speed=55000,file="zbg043a",path=":bg/",x2="中",y2=-100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",speed=72000,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",y2=0,y=-220,lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000241",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Incluso a los ojos de una mujer como yo ella es claramente una hermosa y\nexcesivamente sentimental chica! ¡¿No te parece ridículo no usar esto para\natraer a las personas?!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Concuerdo contigo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0006",head="kei_z2c",y=-220,lv=5,id=6},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000476",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué concuerdas con ella?!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000242",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Un maquillaje que aprovecha muy bien la ternura de su cara, y unas colitas que\nhacen resplandecer su natural simpleza!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Colitas~? Kei, no sabía que tu cabello podía crecer tan repentinamente~ Uwa~,\nes el trabajo perfecto para ti. Sin duda alguna~, el travestismo es tu\nprofesión ideal~”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0005",head="kei_z2c",y=-220,lv=5,id=6},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000477",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ni en broma! ¡Esto es solo una peluca! ¿Qué clase de monstruo me crees como\npara poder hacer crecer mi cabello tan rápido?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La muñeca Okiku también puede hacer crecer su cabello, así que un monstruo de\ntu nivel también debería ser capaz de hacer eso, ¿no~?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=0,y=-300,speed=70000,file="zbg043a",path=":bg/",x2=0,y2=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",speed=72000,mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",y2=-1000,y=-680,lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000243",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Una falda llevada al límite de lo corto que lo deja ver casi todo al\nobservarla debajo de las escaleras, y unos calcetines hasta la rodilla que\npodrían activar el volcán entre las piernas de todos los fetichistas de los\ncalcetines largos!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=320,y=-340,file="zbg043a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",lv=5,id=6,sync=0},
{"extrans",time=500},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000244",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y esta cara de animalito atemorizado, muerto de pena! ¡Esta cara que\nencendería el espíritu sadista de cualquiera!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000245",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Aquel que no se enamore con esto no es hombre!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, estás absolutamente en lo correcto...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="bg043e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000478",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Claro que no!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0020",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000479",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡Uwaan! ¡No haré más esto! ¡No lo voy a hacer, eh! ¡Esto solo lo haría\nalguien mal de la cabeza!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=10},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0020",head="kei_z1c",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000246",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, así que esta pequeña viene a decir esto ahora...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0010",head="mak_z1a",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="いいえ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000247",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah～, es una pena. Parece que por fin será revelado a la luz pública el secreto\ndel busto usado para dibujar que se esfumó de la sala de arte el otoño\npasado...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000480",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¡¿Ah?! ¡¡Ahh!!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"En el instante en que Kei escuchó las palabras de Toritani, su cuerpo se\nsobresaltó y paralizó, como si le hubiera caído un rayo encima.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hiciste algo, Kei?...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Mientras leía la atmósfera que se cernía entre los dos, lancé esa pregunta en\nun tono de voz bajo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000481",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah... esto... El año pasado... hice sparring con el busto para dibujar, y se me\nfue la mano... y lo rompí.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No te pongas a boxear con el busto para dibujar... Das pena de solo imaginarte\nhaciendo eso... Kei.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うんうん",time=250,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000248",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jum, jum... Soy una estudiante de honores que se apega fácilmente a las reglas\ny la organización. Parece que no me queda más opción que confesar eso.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0020",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0009",head="kei_z1c",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000482",ch="ked"},
},
ja={
{
name={"Kei"},
"“No mientas, Makoto. Tus calificaciones son excelentes, pero eres la primera en\nir siempre contra la administración del colegio... Vives una vida escolar\ncriminal, al borde de la expulsión.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=10},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000249",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Oh, estás seguro de que quieres seguir diciendo eso? Natsume-kun, eres un\namigo bastante importante para mí~, así que hasta ahora mantuve la boca\ncerrada ante los profesores~, pero eso realmente no me parece bien~”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000483",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000250",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué debería hacer~? Según el catálogo de instrumentos, ese busto valía más de\n100000 yenes~ Ahh, me dieron ganas de ir de una vez a hablar de justicia con\nlos profesores.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000484",ch="ked"},
},
ja={
{
name={"Kei"},
"“Está bien... Ya entendí... Quisiera ir a repartir folletos...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000251",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Me parece muy buena idea que vayas a repartir folletos con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0009",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",time=500,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0010",head="kei_z1c",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000485",ch="ked"},
},
ja={
{
name={"Kei"},
"“S-Sí...*sudor*.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000252",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios, hazlo con seriedad.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás yendo con más ímpetu que el año pasado. ¿Por qué estás tan\ndesesperada en incrementar el número de miembros del club?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0009",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000253",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo suficientes razones para desesperarme. Todos los senpai se fueron en\nmarzo y ahora no tenemos casi integrantes.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No tienen casi integrantes? ¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0015",head="mak_z1b",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000254",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te has dado cuenta de nada, eh... Aun cuando te la pasas metido en la sala\ndel club de arte.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000255",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si fuera otro caso ya hubiéramos tenido que cerrar el club. Bueno, es un club\ncon trayectoria histórica, así que no creo que tengamos que cerrar en algún\nmomento, pero son altas las posibilidades de que no nos asignen casi\npresupuesto.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿cuántas personas hay en el club de arte ahora?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000486",ch="ked"},
},
ja={
{
name={"Kei"},
"“Makoto y yo, y bueno, también Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡¿Solo ustedes tres?!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000256",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para ser más específicos, Akashi-senpai es un miembro temporal. Aún no se ha\ndecidido si repetirá el año o no, así que realmente solo somos Kei y yo.\nIncluso alguien tan tardo como tú sabrá en los aprietos que estamos metidos\nal escuchar cuántos miembros somos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, entiendo que estén en aprietos, pero... ¿Por qué tengo yo que hacer esto\ntambién?...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000257",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Acaso no es obvio?! ¡¿Tienes algún reclamo?!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Los servicios en Quimera. Mi uso indiscriminado de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Todos esos favores están reservados para estos momentos. No puedo reclamarle\nnada...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Reclamo, no tengo, pero... Ahora que me doy cuenta, no hay ningún miembro de\nsegundo año.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No entraron nuevos miembros el año pasado?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000258",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entraron, ciertamente... solo que...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000487",ch="ked"},
},
ja={
{
name={"Kei"},
"“No pudieron aguantar los acosos sexuales de Akashi-senpai, y todos los nuevos\nmiembros que entraron el año pasado renunciaron.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acoso sexual? Nada de que extrañarse de Akashi, pero...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000488",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hubo una época en la que se enfrascó con el tema de levantar las faldas de las\nchicas diciendo '¿Será que las faldas funcionan como paracaídas?' o algo así.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うんうん",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000259",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, sí, sí, hubo una época así.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué clase de época es esa...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0010",head="mak_z1d",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000260",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No solo paracaídas, también globos publicitarios. En fin, estaba obsesionado\ncon todo tipo de aparatos voladores. Aunque desconozco la razón.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0016",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000489",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahora que lo recuerdo, hubo una vez que Akashi-senpai se amarró una gran\ncantidad de globos y voló despegando desde la azotea.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000261",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Más que volar terminó estrellándose. Aunque supongo que fue mejor a que se\nfuera volando a algún lado y se desapareciera del mapa.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hubo un viejo que hizo lo mismo hace bastante tiempo... Se amarró a un montón\nde globos diciendo que cruzaría el pacífico y no lo volvieron a ver.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Como siempre, Akashi hace puras locuras.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x2=-345,x=0,lv=4,id=10},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? Toritani, ¿también te levantaron la falda?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",x=0,lv=4,id=10},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=0,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000262",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡P-Por supuesto que no! ¡Espera, ¿por qué preguntas eso?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"select",label="label07",text="select"},
{"select",label="label08",exp="f.mak=f.mak+1",text="select"},
{"select",name="select01_01_4",mode="sys"},
{"text"},
select={
ja={
"Realmente no lo hice con ninguna intención.",
"Realmente solo lo pregunto por curiosidad.",
{"rt2"},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no lo hice con ninguna intención. Solo que no puedo imaginarme tu\nreacción después de que te levantaran la falda. No sé si te sentiste\navergonzada o si te enojaste...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"excall",label="join4"},
{"text"},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente solo lo pregunto por curiosidad. Solo que no puedo imaginarme tu\nreacción después de que te levantaran la falda. No sé si te sentiste\navergonzada o si te enojaste...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"excall",label="join4"},
{"text"},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x=0,lv=4,id=10},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",x=0,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000263",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ambas! ¡Me daría vergüenza y también me enojaría! ¡Y de paso, lo mataría!”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que él también elige bien a la persona al momento de hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000264",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0011",head="mak_z1a",x=0,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=0,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000265",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, hasta el año pasado bastaba con vestir a Kei de mujer para atraer algo\nde atención, pero este año no puedo ir nada más con eso, así que hice que te\npusieras ese esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es lo que no logro entender para nada. No creo que se sumen nuevos\nintegrantes al verme en esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",x=0,lv=4,id=10},
{"fgact",ch="真琴",act="いいえ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x=0,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000266",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no es cierto. La gran mayoría de los nuevos integrantes del año pasado\nentraron por ti, así que podemos esperar un buen efecto de ese esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jaa? ¿Los nuevos integrantes del año pasado entraron por mí? No puede ser que\nalgo tan ridículo haya ocurrido.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x2=0,x=-345,lv=4,id=10},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000490",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, sí, claro que sí. ¿No recuerdas que para esta época en el año pasado\nKenichiro Kusanagi acababa de regresar al país? Así que la atención de toda\nla opinión pública y la sociedad se concentró también en su hijo, Naoya\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si el regreso de Kenichiro Kusanagi no tiene nada que ver conmigo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000267",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La sociedad no piensa igual que tú. En particular, tienes buen aspecto, así que\nel año pasado varias chicas malinterpretaron todo y entraron al club por ti.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es ridículo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0016",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000491",ch="ked"},
},
ja={
{
name={"Kei"},
"“Igualmente tú también repartiste folletos el año pasado, ¿no? Parece que\nhubieron bastantes chicas que quedaron embelesadas contigo. Decían '¡Así que\nese es el único hijo de ese genio artista del que hablan! ¡Es encantador!'”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000492",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Ahora sí entiendes?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me di cuenta una vez más de lo fácil que es quedar fascinado contigo cuando\nhablas como una mujer con esa ropa, y eso me causa terror. Se me puso la piel\nde gallina en la parte de '¡Es encantador!'.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000493",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué demonios estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, no tenía ni idea de que eso había pasado.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000268",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es porque no tienes interés por las demás personas. Aunque todas\nrenunciaron al club antes de que terminara abril.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por los acosos sexuales de Akashi?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000269",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, tampoco me conviene mucho que entren por esas razones tan sucias, y\nciertamente, no se puede elogiar lo que Akashi hizo, aunque tampoco se le\npuede reprochar demasiado. La verdad es que me sentí algo aliviada en ciertos\naspectos...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, eso fue realmente una molestia.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000494",ch="ked"},
},
ja={
{
name={"Kei"},
"“De verdad que sí. Naoya, eres un hombre que vive honorablemente solo,\nseguramente te molestaría que ese poco de niñas tontas armaran un escándalo\npor ti, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás malinterpretándolo todo. Con molestia me refiero a lo que Akashi hizo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me hubiera encantado vivir rodeado por mis fanáticas, así que es realmente una\npena.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000495",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Ehhh? ¿Hablas en serio? Naoya, juraba que odiabas esa clase de cosas.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? No hay ningún ser humano que en su sano juicio pueda odiar\na alguien que lo exalte y lo halague, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0017",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000496",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué estás diciendo? El mismo tipo que se enoja cada vez que los medios de\ncomunicación lo exaltan por algo...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da miedo que me adulen por negocio y dinero y por eso no me gusta. Las\npersonas se vuelven terroríficas cuando hay dinero de por medio.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000497",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sé si realmente lo que acabas de decir es muy profundo o no...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000270",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces podrías conseguirte a unas cuantas fanáticas este año, ¿no te parece?\nPodrás atraer todas las que quieras con esa pinta.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, creo que me siento un poco más motivado. Cuando las cosas son\nbeneficiosas para uno, la motivación se va para arriba.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0012",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000498",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Es en serio? Naoya, ¿de verdad no te importa? Siento que la imagen que tenía\nde ti se ha desmoronado dentro de mí.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Odio también a esas personas que se hacen una falsa imagen de mí como lo estás\nhaciendo ahora.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000499",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué me odias a mí ahora?!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うんうん",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000271",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, ¿cuál es el problema? Dejando eso de lado, Kei, tienes el manual que te\ndi hace un rato, ¿no? Hablarás tal como lo indica el manual.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000500",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De verdad tengo que usar ese manual?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"se",file="se9010",id=1},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
ja={
{
"Kei sacó una hoja impresa del bolsillo de su falda.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うんうん",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000272",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, sí. No te vayas a olvidar de las lineas que están escritas ahí, ¿sí? ♪”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",mode=-2},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0003",head="kei_z2c",lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0008",head="kei_z2c",lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000501",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ehm... 'Muchachos, ¿están disfrutando su vida escolar? ¡Soy la idol del club de\narte, Kei Natsume' ¡¿Llámenme Nakki~, sí?! (Sube una pierna acá y guiña el\nojo).”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0003",head="kei_z2c",lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0008",head="kei_z2c",lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000502",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué les parece si plasmamos todos sus ardientes corazones en el lienzo y\ndibujamos juntos esa encantadora obra llamada JU-VEN-TUD? (Pon la mirada\nhacia arriba mientras posas tu dedo índice sobre los labios)'.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0009",head="kei_z2c",lv=5,id=6},
{"fgact",ch="圭",act="icon",lv=5,id=6,icon="icon04z2",x=65,y=-525},
{"text"},
text={
vo={
{"vo",file="man_ked_000503",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei... Estás sudando bastante...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"quake",mode="mw"},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0007",head="kei_z2c",lv=5,id=6},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"fgact",ch="圭",act="icon",lv=5,id=6,icon="icon05z2",x=90,y=-550},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000504",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Idiotaaa! ¡Eres una idiota del nivel de una bomba destructora de planetas!\n¡Tienes el cerebro podrido! ¡Ya estás en un estado bastante grave,\nterriblemente peligroso, vete ya a un hospital!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fgact",ch="圭",act="停止",lv=5,id=6},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000273",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu... No logras entender nada, ¿verdad? Viera quien lo viera se daría cuenta\nde que es un guión perfecto. Es un guión tan perfecto que probablemente solo\nse vea una vez en el siglo en los premios de mejor guión en la Academia.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque solo ocurra una vez cada 100 años me parece igual que hay bastantes\nproblemas en eso...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000274",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cierto, para ti está esto, Kusanagi. Preparé un manual especial para ti.\n¡Vas a repartir estos folletos junto con estas líneas!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=10},
{"fgact",ch="真琴",act="うなづく",lv=4,id=10},
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Toritani ignoró los reclamos de Kei y sacó el manual de su bolsillo, para luego\nponerlo a la fuerza dentro de mis manos.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos... 'Para hacer brillar aún más tus maravillosos ojos es necesario darle\nun servicio estético a tu mente.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría dibujar juntos un plan futuro de amor en el lienzo? Hagamos una\nobra única en el mundo con la pintura de nuestros sentimientos...'.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajajaja...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0004",head="mak_z1d",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000275",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal está?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te parece que eres tú la que necesita un servicio estético de la mente?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000276",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Me pregunto qué querrás decir?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás fatigada... Me parece que estás cansada.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000277",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo... Es verdad. Creo que me he sentido cansada últimamente...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh, hoy deberías regresar rápido y dormirte temprano.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0029",head="mak_z1a",lv=4,id=10},
{"fgact",ch="真琴",act="いいえ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000278",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No, no tienes por qué preocuparte por eso! Debo supervisar el trabajo de los\ndos.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000279",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué chasqueaste la lengua?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No habrá sido el sonido del viento?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",x2=0,x=-345,lv=4,id=10},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0020",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",loop=-1,time=500,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000505",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaan. ¡Te lo ruego, dime que es una broma, por favor, por favor!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fgact",ch="圭",act="停止",lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0016",head="mak_z1d",x=-345,lv=4,id=10},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0017",head="mak_z1d",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000280",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ahh, estás perdiendo tu tiempo! Toma, ve y reparte esos folletos. No vas a\nentrar a la sala de arte hasta que termines de repartirlos.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En fin, ya entendí! ¡Haré de esa sala un nido de mis fanáticas y la cambiaré a\nmi gusto!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000281",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No está mal, ¿no? Después de todo probablemente termine resultando así.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Bien, Kei-kun, hagamos nuestro mejor esfuerzo para repartir los folletos!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000506",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan, tu motivación es también muy sucia!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg043e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000507",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh, siento la brisa rozando la zona de mis genitales... Esto es realmente\ntriste...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, en la medida de lo posible no te acerques a más de 2 metros de mí,\n¿entendido?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0021",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000508",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me agradaría para nada que piensen que estás conmigo.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"fgact",ch="圭",act="icon",lv=4,id=6,icon="icon05z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000509",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Q-Qué~?! Tú~”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fgact",ch="圭",act="停止",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Venga, no te enojes con esa ropa puesta. Si te pones a saltar así, se te va a\nver la falda.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"fgact",ch="圭",act="icon",lv=4,id=6,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000510",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaah, ¿e-en serio?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos a repartir esto de una vez en el anfiteatro. Terminaremos esto rápido.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000511",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Ehhh?! ¡Allá pasan muchas personas!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso mismo, si repartimos los folletos en un lugar donde pase mucha gente\nterminaremos rápidamente.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0020",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0021",head="kei_z1c",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000512",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡¿Acaso no tienes ningún sentimiento de compasión ni de amistad por\nmí?! ¡¿Me estás diciendo que vaya a mostrarme de esta manera ante todos?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Kei está ya con lágrimas en los ojos. Sin embargo, el aire de vergüenza se ha\nextendido por todo su cuerpo, luciendo de una manera que le podría encantar a\nalgunos maniáticos.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Al observar bien, me doy cuenta de que los alumnos que estaban a nuestro\nalrededor estaban fotografiando la sensual y encantadora figura de Kei con\nsus teléfonos con cámara.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Parece que incluso hay algunos con cámaras SLR que ya habían previsto que esto\nse trata de un evento anual.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Sin embargo, no sé de qué manera se supone que toda esta atención nos ayudará a\natraer nuevos miembros.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_01_7"},
{"text"},
linkback="block_00160",
},
label = {
top={block="block_00000",label=1},
notflag04={block="block_00075",label=1},
label07={block="block_00075",label=1},
label08={block="block_00077",label=1},
join4={block="block_00079",label=1},
},
}
