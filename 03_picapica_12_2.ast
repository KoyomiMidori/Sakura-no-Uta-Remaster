astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,rule=139,sync=1,vague=40,path=":cg/"},
{"se",file="se9004",id=1},
{"fgf",frame="frame_sd",ch="真琴",bgpx=":bg/",bg="black",sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009",head="mak_z2a",y=60,lv=5,id=24,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003747",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye... ¿De verdad es por aquí?...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, confía en mí.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0015",head="mak_z2a",y=60,lv=5,id=24},
},
},
text={
vo={
{"vo",file="fem_mkd_003748",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quisiera decir que no confío ni un poco en ti, y sin embargo me siento\ndesesperanzada de esta situación actual que me obliga a ponerme ahora en\nmanos de alguien tan desorientado como tú...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"Tras esperar unas dos horas... Al montarnos en el próximo tren, convencí a\nToritani, quien insistía en regresar hasta donde pudiéramos, y nos bajamos\ncuando ya no pude aguantar más.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Cuando digo que no pude aguantar más, no me refiero a las ganas de ir al baño.\nMe refiero a esa estación en la cual, al llegar, concluí que no había\nnecesidad de seguir regresando.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"No tiene que ver con la zona ni con la estación en particular. Por una\nmisteriosa razón, me dio la sensación de que todo saldría bien haciendo esto.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fgf",frame="frame_sd",ch="真琴",bgpx=":bg/",bg="black"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy consciente de que me estoy quedando perdido.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003749",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y cómo se supone que avanzas entonces tan rápido y sin dudar?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo que preparar todo para acampar.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003750_n1",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Imploro fervientemente que podamos regresar antes de que venga el lunes...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003751",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003752",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy bien. Más importante que eso ahora, ¿no crees que es peligroso seguir\navanzando por este sendero tan oscuro a estas horas?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía podemos seguir. Avancemos un poco más.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003753",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Está bien.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Se podía ver la luna, así que doblé a la derecha'...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es por acá.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fgf",frame="frame_sd",ch="真琴",bgpx=":bg/",bg="black"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0013",head="mak_z2d",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003754",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh, vamos a doblar aquí? ¿¿Con la luna a nuestras espaldas??”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me parece que es por acá.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003755",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0015",head="mak_z2d",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003756",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0008",head="mak_z2d",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003757",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sería inoportuno de mi parte comenzar a quejarme estando ya acá, supongo――\nVamos.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,sync=1,path=":cg/"},
{"fgf",frame="frame_sd",ch="真琴",bgpx=":bg/",bg="black"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003758",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Dónde se supone que estamos ahora?...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acampamos acá? Tengo hambre, y debes estar cansada también.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0015",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003759",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... hagamos eso...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003760",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Eh, espera un momento.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",y=60,lv=5,id=24},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003761",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No escuchas el sonido de un río?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fgf",frame="frame_sd",disp="消",mode=-1},
{"text"},
text={
ja={
{
"Afino mis oídos y me concentro en escuchar.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es por allá.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003762",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es acá?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Cada uno señaló una dirección completamente opuesta a la otra.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nos separamos?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003763",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003764",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Olvídalo. Tomemos la dirección que señalaste.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="nightsky_summer",id=2,lv=2,sync=1,path=":cg/"},
{"se",file="se0110",id=1,loop=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003765",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Toritani se queda sin palabras. Y en mi caso, me quedé parado al borde del río,\nconmovido y emocionado.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003766",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto... de verdad... ¿no es un sueño?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",file="se1226",id=2,vol=50},
{"text"},
text={
ja={
{
"Toritani camina tambaleándose, y entró al bajío del río con sus zapatos\npuestos. Finalmente, se desploma de piernas en ese mismo lugar.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
"Sin siquiera preocuparse de mojarse, se queda viendo anonadada el banco del\nrío.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"El agua del río reflejaba la luz de la luna y destellaba con un tenue blanco.\nLo que brilla es la fina arena tendida al fondo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Fuh.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Parece que de alguna u otra forma, lo logramos.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c51_01",path=":ev/ev_uni_c51/",set="ev_uni_c51"},
{"text"},
text={
ja={
{
"El humo que baila elevándose al cielo de otoño va desvaneciéndose lentamente.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"msgoff"},
{"bg",file="bg060a",path=":bg/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"Ya no hay más leña que echarle al horno escalonado, pero a pesar de eso, el\ninterior del horno estaba terriblemente caliente. De aquí comienza el proceso\nde 'enfriado', realizado mediante enfriamiento natural.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por fin lograste llegar hasta este punto.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003767",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... así es.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"El fin de semana, después de conseguir la arena que estuvimos buscando,\nreunimos tierra de la localidad donde conseguimos la arena y fuimos a pedir\npaja a la casa de unos campesinos que residen en la base de la montaña.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Fue Suetake quien colaboró para transportar todo el pesado equipaje.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Suetake, siendo fanática de Toritani como artista y no como creadora de\nvajillas, se alegró ante nuestra petición y accedió a cumplirla.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Toritani avanzó con la creación de su pieza sin dormir ni descansar. Traté de\nencargarme de todo aquello que requiriera fuerza física.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Después de preparar el objeto en arcilla para aplicar el esmalte, ella se\nencargó de aplicar una complicada tetsu-e con oniita alrededor de un extenso\nrango de la pieza, para luego bañar ciertas partes de la misma con esmaltes\nblancos de distintas concentraciones. Todo, ella sola.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Pude ver cómo dibujaba el diseño del tetsu-e. Aunque, era una clase de diseño\nque normalmente solo se culmina tras aplicarse el esmalte blanco y cocerse, y\nademás, también aplicó rounuki sobre la pieza, por lo cual era difícil tener\nuna imagen del diseño final.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Toritani estaba indecisa respecto a qué hacer con el esmalte blanco que produjo\nde la arena que recolectó: Hacer un esmalte Warabaiyuu al estilo onihagi, o\nusar un esmalte más uniforme como el Shino. Al final se decidió por esta\núltima opción.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Fue en base a la experiencia que obtuvo de todas las mezclas que probó en las\npiezas de prueba al momento de crear 'La Luna y las Estrellas' que llegó a la\nconclusión de que el esmalte blanco era el más indicado para esta pieza de\ncerámica.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"No sé qué acabado tendrá la pieza de cerámica que está cociéndose en este\nmomento en el horno escalonado.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Sin embargo, no cabía duda que de cierta manera, esta sería la amalgama\nconcentrada de toda su experiencia, conocimiento y esfuerzo.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_b01_03",path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003768",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo queda templar y sacar la pieza, aunque... para ser sincera, no sé qué me\nconseguiré sino hasta que abra el horno.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No estás muy segura de ti misma?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003769",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto que lo estoy. Pero tú también sabes lo difícil que es manejar el\nhorno escalonado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"En un horno escalonado hay demasiados factores involucrados que hacen muy\ndifícil obtener exactamente el resultado que uno espera.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"No solo el calor del fuego, sino también el clima y el viento, el estado de la\nleña, su humedad y temperatura, la ceniza que cae, el flujo de las llamas. El\nresultado se ve afectado por, prácticamente, todas las condiciones internas y\nexternas del horno.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Y por eso mismo, es que hay veces que también surgen obras maestras de ellos.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Las piezas de cerámica son obras de arte que nacen al pasar por ese\nminiuniverso que es el horno escalonado.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Y por eso, es tan difícil, y a la vez tan entretenido de usar. Entiendo el por\nqué tantas personas quedan encantadas con él.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003770",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta vez quiero una pieza de color gris... gris ligero, y no escarlata. Así que\nmientras me mantengo pendiente de eso...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003771",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo único que quedaría es que el esmalte se encoja como lo necesito... Lo mejor\nsería que tuviera un acabado rugoso, como el kairagi...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Toritani susurra eso carente de emoción alguna, pero la expresión que tiene en\nsu rostro, parada ahora frente al horno escalonado, es grave.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003772",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya calculé y controlé todo lo posiblemente calculable. Lo que busco crear no es\nalgo tan simple como para dejarlo todo en manos de la incertidumbre y la\ncasualidad.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003773",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pondré todo el esfuerzo que pueda dar, y haré todo lo mejor que pueda hacerlo.\nNo puedo descuidarme durante el enfriado, así que procuraré concentrarme\nhasta abrir el horno. Aunque en lo que concierne al resultado...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Toritani se encoje ligeramente de hombros.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003774",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo el dios de los hornos sabrá qué saldrá.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"De cualquier manera... dentro de poco conoceremos ese resultado.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bg060a",path=":bg/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Espero afuera por Toritani, quien se metió a la zona interna del horno, ya\nhabiendo finalizado el enfriado.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Mis puños se aprietan aún más, en la duda que me carcome, de si todo salió bien\no no. Toritani puso todo su ser en esta obra.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Le hablo a Toritani, quien había regresado. Parada ahora frente a la boca del\nhorno y sin decir nada, no había expresión alguna en su rostro.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"¿Falló? No, pero eso no... ¡No puede ser!",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Sin embargo, el hecho de que ese 'no puede ser' sí pueda ser es el aspecto más\nterrorífico de la alfarería.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Si realmente hay un dios en el horno, entonces también hay un demonio.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tori, ta... ni?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003775",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Toritani soltó un largo suspiro, como respondiendo a mi llamado.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bgm",file="bgm110"},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003776",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué esa cara?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Una sonrisa se forma en sus labios.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Intentó sonreír de manera imponente y audaz, pero falló. Llena de sosiego y\nalivio, esa sonrisa contenía toda la hermosa esencia de Toritani.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Su voz estaba algo temblorosa.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003777",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perdona que te pida esto ahora, pero ¿podrías ayudarme a llevarla a la sala de\narte?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, lo lograste.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0022",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003778",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh, por supuesto. ¿Qué no era obvio que lo lograría?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Al decir eso, Toritani sonrió. Ahí estaba la confiada y segura Toritani de\nsiempre.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003779",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por otro lado, hay un lugar al cual quiero que me acompañes, aunque será a\nprimera hora de la mañana. ¿No te importa?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003780",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay alguien, alguien a quien más quisiera mostrarle esta obra.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"se",file="se9004",id=1},
{"fg",ch="真琴",speed=5000,mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x2=0,x=-1500,lv=4,id=9},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="zbg010a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=1000},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2c0100",face="c0001",head="mak_z2c",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003781",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Toritani se para frente a la puerta del atelier. Se podía sentir a Kei\ntrabajando del otro lado de la puerta.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Esta trató de tocar la puerta, pero se detuvo, apoyando suavemente su frente y\nsus dos manos sobre ella.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003782",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay algo que quiero que veas.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"En contraste con su pose, similar a la de alguien orando, la nítida voz que\nsalió de sus labios pareció cruzar la puerta del atelier como una flecha y\natravesar los tímpanos de la única persona sentada allí adentro.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003783",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei... eres quien más quiero que la vea.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003784",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está en la sala del club de arte... Adiós.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"se",file="se9004",vol=60,id=1},
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Al decir solo eso, Toritani se alejó de la puerta. Sus palabras fueron pocas,\npero muy cargadas de sentimientos.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"se",file="se9010",vol=60,id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de dar dos pasos, Toritani se tambaleó, cayendo con su espalda sobre la\npared del depósito.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Sin respuesta alguna, su cuerpo va cayendo al suelo, arrastrando su espalda\nsobre la pared.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"se",file="se3130",vol=50,id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toritani!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Al instante en que toqué los hombros de Toritani mientras se iba encorvando\nhacia el suelo, su cuerpo comenzó a caer livianamente sobre mí.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003785",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Zzz...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Toritani se quedó dormida sobre mi pecho, casi como si se hubiera desmayado. Mi\ncara se queda atónita del alivio ante sus pacífica y rítmica respiración al\ndormir.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"msgoff"},
{"bg",y=-580,file="zbg010a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“――Sí, era de esperarse.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Lo único que la mantuvo despierta en estos últimos momentos fue su fuerza de\nvoluntad. Es más bien sorprendente que haya podido venir hasta acá.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Hacer que Kei vea su obra y decirle lo que debía decirle... Seguramente ese fue\nel objetivo principal de Toritani.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Usó hasta su última gota de fuerza de voluntad para venir acá y expresar sus\nsentimientos.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Aunque seguramente no deseaba de ninguna manera caerse rendida ante el sueño\nen este lugar.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",speed=700,time=0,sync=0,file="zbg010a",path=":bg/",x2=0,y2=-580,x=0,y=-70,ax=1920,ay=1126,bx=-960,by=-586},
{"cgact",stage="zbg010",act="いいえ",size=5,lv=2},
{"quake",size=5,mode="mw"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Va, mos--”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Cargo a Toritani mientras duerme. De la misma forma que lo hice cuando\nestuvimos huyendo de las colegialas aquella vez.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Dormida profundamente ahora, no se escucha ninguna queja de su parte.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"En fin, llevemos a Toritani a mi habitación. Tengo que despertar a Ai para\npoder pedirle permiso.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bluesky_winter",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="eveningsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm031"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003786",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Por qué no me despertaste?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"cgdel",id=-1},
{"se",file="se0744",vol=50,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbg041i",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Furibunda, Toritani va subiendo la colina con gran ímpetu.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Los estudiantes que van de vuelta a sus casas voltean para ver qué sucede, pero\nparece que ni esas miradas son de importancia para ella ahora.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Era ya pleno atardecer al despertarnos, así que puedo entender un poco su\nenfado. Yo también me quedé asombrado.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Traté de despertarte varias veces, pero no movías ni una pestaña.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0013",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003787",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, ¿en serio?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es mentira. Yo también estuve durmiendo a tu lado, ¿qué no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0015",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003788",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ahora que lo mencionas... Kuh, no puedo creer que haya caído por esta broma\ntan simple.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Apenas acabas de resolver una gran cantidad de serios problemas y eso te tiene\ndespistada. Sé un poco comprensiva contigo misma.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0007",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",size=5,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003789",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Aún no se ha resuelto nada! Ahhh, rayos, busqué a Kei pero no estaba en el\natelier... Lo cual, quiere decir que debería seguir en el colegio...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues está en la sala de arte, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bgm",stop=1,time=300},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg041i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008",head="mak_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Toritani se detiene por completo al escuchar mis palabras, sin dar un paso más.\nLa actitud amenazadora de hace un momento se desvanece, tornándose ahora\nextrañamente tranquila.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003790",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Crees... que esté allí?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿por qué estás tan insegura? No te preocupes. Está en la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003791",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es que no esté segura...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003792",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero sí, tienes razón... vayamos.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1c0100",face="c0001",head="mak_z1c",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm032"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003793",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
"Toritani, quien se quedó parada por un rato frente a la puerta de la sala de\narte, extiende ahora sus vacilantes manos y abre la puerta lentamente.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Me apoyo ligeramente con la espalda sobre la puerta, y me le quedo viendo\nmientras avanza hacia el fondo de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Al abrir la puerta de la sala de preparativos, Toritani se detiene por\ncompleto.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003794",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Al acercarme a la estupefacta Toritani, observo por encima de sus brazos el\nfondo del cuarto.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"msgoff"},
{"bg",file="bg050d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Habían un montón de lienzos tirados alrededor.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Al fondo, en el centro de la sala de preparativos, estaba colocada la obra de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"msgoff"},
{"bg",speed=80000,file="zbg050d",path=":bg/",x2=170,y2=-400,x=20,y=-400,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"La pieza de arte estaba envuelta por un sereno silencio y una tenue luz blanca,\nen medio de la oscura habitación, iluminada solo por la todavía débil luz de\nla luna.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Era una luna en la tierra. Puesta y sentada en silencio, cubierta por una\nblanca luz similar al brillo lunar.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"La gruesa capa de esmalte blanco representaba la brillante superficie de la luna,\nmientras que los patrones grises que se veían tras la fina capa de esmalte\nsemitranslúcido y las partes negras expuestas formadas por el tipo de\nencogimiento conocido como 'Kairagi' forman un delicado y perfecto contraste de\nsombras, describiendo los parches y sombras del único satélite del planeta.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Las sombras de la luna que vemos en el cielo dan a relucir a un conejo.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Mientras que las sombras de esta luna en la tierra daban a relucir a una\nincontable bandada de urracas, formando un puente sobre la Via Láctea, que\nbrillaba suave y tersa sobre la superficie de su cuerpo esférico.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"'La cara oculta de la luna'――\nEse fue el nombre que Toritani le dio a esta pieza.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"La ciencia logró ya descubrir lo que hay en el lado oculto de la luna. Sin\nembargo, es imposible verla desde la superficie terrestre.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Toritani tomó toda su imaginación, su deseo y toda su habilidad para crear la\ncara oculta de la luna.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"No tenemos forma alguna de volar y llegar a la cara expuesta de la luna.\nPero si es por su cara oculta――",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Entonces aún estando en la superficie podemos llegar allí, a ese paisaje de\nensueño e ilusión, solo usando nuestras mentes.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Rayos, ¿pero quién de los dos es más genial? Me dan ganas de preguntar eso.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003795",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",file="se9012",vol=30,id=1},
{"text"},
text={
ja={
{
"Toritani avanza con duda, como temiendo algo.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Alrededor de la luna que Toritani creó, estaban regados un gran montón de\nlienzos. Todas esas pinturas, dibujadas sobre ese incontable número de\ntelas---",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Todas, fueron pintadas por Kei. Toritani va revisando los lienzos, uno por uno.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Toritani supera ese mar de infinitos lienzos y llega al final de la habitación,\npara luego caerse sentada de piernas, sin fuerzas.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Al fondo, tras la pieza de la luna, estaba Kei tumbado dormido, acurrucado.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"En la mano de Kei, quien respiraba pacíficamente en su sueño, estaba sostenido\nun pincel. A su lado, estaba tumbada una paleta y sus pigmentos.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Toritani tomó en sus manos el lienzo tirado en el suelo más cercano a Kei.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Allí estaba plasmada la pintura de un ave, saliendo de su huevo y tratando de\nvolar. Parecía ser también una urraca.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Su pincel se detuvo a mitad de labor, sin culminar el dibujo.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Y lo mismo se veía en todos los lienzos.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Todas las pinturas estaban sin terminar.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Procurando no ensuciar la pintura, Toritani tomó el lienzo y lo abrazó.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"En sus ojos no se veían lágrimas.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"msgoff"},
{"bg",file="bg050d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2c0100",face="c0001",head="mak_z2c",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003796",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto es lo mejor que pude hacer.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003797",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Di lo mejor de mí, por esos dos genios. Creé a la luna, con el ferviente deseo\nde que los dos avanzaran aún más en su sendero.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003798",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero――”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Los dedos de Toritani aprietan el lienzo con aún más fuerza.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003799",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo logré. No llegué a alcanzarlo, pero...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003800",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No importa. Así está bien.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Sus labios temblaron, y se encorvó.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"No llegué a escuchar ningún sollozo.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Todos los cuadros que Kei había pintado estaban inconclusos. No fue capaz de\nver más allá del lugar donde está parado ahora.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Las manos de Toritani no lograron alcanzar su preciado deseo: 'Lo mejor que\npueda hacer, por el bien de los dos genios'.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Sin embargo, seguramente no llorará.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"'No importa. Así está bien'.\nEsas palabras que ella misma se dijo eran su todo ahora.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Si hay algo que pude entender en ese momento, fue eso.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
