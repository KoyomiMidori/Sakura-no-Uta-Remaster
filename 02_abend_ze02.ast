astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"bgm",file="bgm007"},
{"bg",file="eveningsky_spring01",id=9,lv=9,path=":cg/"},
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde que comenzó el verano ha estado bastante ocupada.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"A pesar de estar estudiando para los exámenes de ingreso, también ha estado\ntrabajando bastante en lo referente al club. Toritani es la que más ha estado\nlaborando hasta ahora...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, ahora está planificando un campamento. Aun con todo el tiempo que\ntoma elaborar algo de esa magnitud.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Otra opción es Akashi.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Ni en broma.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Hikawa podría ser una buena opción.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Lleva un buen tiempo viviendo en Yumihari. Debe conocer bien el lugar. Es\nademás perspicaz y espabilada como Toritani.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Siento que si sigo caminando sin rumbo alguno me perderé aún más.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Decidí pararme por un momento y elegir a la persona más indicada para ayudarme.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Rin también podría servir. Siempre se esmera en ayudar y guiar a los demás con\nmucha atención.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Sin embargo, apenas acaba de volver a Yumihari, y es posible que aún no se\noriente del todo bien por la zona.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que me deja con...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Concluí que este número era el único al cual podría llamar para pedir ayuda.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"msgoff"},
{"se",sync=1,id=1,file="se1343"},
{"se",id=1,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000430",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Hola? ¿Senpai?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy yo, Kusanagi. Naoya Kusanagi. Me surgió un pequeño problema, y...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_rna_000431",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tú, en problemas, senpai? Eso es raro.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí también me surgen problemas como a los demás.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_rna_000432",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no lo digo por eso, sino que siempre he pensado que no eras del tipo de\npersona que suele pedirle ayuda a los demás...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues te estás dando ideas que no son. A mí no me tiembla la mano en pedir ayuda\ncuando me meto en problemas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rna_000433",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Bueno, me alegra que hayas decidido pedirme ayuda a mí.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuve pensando por un buen rato, y concluí que eras la indicada.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rna_000434",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, de ser así quisiera servirte lo mejor que pueda, sí. ¿Y bien? ¿De qué\ntrata ese problema?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es algo que me cuesta un poco decir...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rna_000435",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entiendo, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le explico lo que sucedió hasta ahora a Hikawa. Al terminar de contar la\nhistoria, esta se rió de manera ligeramente burlona y comenzó a hablar.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rna_000436",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, estás caminando en sentido totalmente opuesto.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000437",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sigue caminando un poco hacia adelante y gira a la izquierda. Darás con un\nlugar que quizás has visto antes, creo yo.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sigo un poco más y luego giro a la izquierda?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_000438",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nos vemos entonces en un rato.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nos vemos?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
"Hikawa corta la llamada, sin responder a mi pregunta.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Pero qué chica tan poco amable...",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Pero, por otro lado...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Un lugar que he visto antes?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No conozco para nada este lugar, por eso la llamé. Y aun así, me dice que con\nsolo girar a la izquierda me toparé con un sitio que he visto antes.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umumuh...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Si hay algo para lo que soy bueno es en olvidar los lugares y como orientarme\npor ellos. Así que no sería raro que fuera verdad.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Por los momentos, comencé a seguir el trayecto que Hikawa me indicó.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"cgdel",id=-1},
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm105"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Lo que había allí era un parque, rodeado de cipreses.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un parque rodeado por cipreses...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Escucho una voz llamarme apenas cruzo la entrada.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rna_000439",ch="rna"},
},
ja={
{
name={"???"},
"“Ha pasado bastante tiempo desde que nos vimos acá por última vez.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="zev_com_a33_01",zoom=90,speed=100000,path=":ev/ev_com_a33/",set="ev_com_a33",x2=440,y2=10,x=600,y=190,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Al voltearme me encuentro con Hikawa.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Envuelta en un vestido blanco, y llevando una sombrilla igualmente blanca.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Su cara está como si nada, pero está jadeando, y sudando bastante. Seguramente\nse apresuró en llegar aquí por mí.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_a33_01",path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_a33_02",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000440",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De qué te estás disculpando, senpai? El senpai que yo conozco no haría eso.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que me tengo que disculpar, hice que vinieras hasta acá, aun con lo\nfuerte que está el sol hoy.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000441",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tienes de qué. Y además, mi casa queda por aquí cerca.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Ah, espera, sí, ahora que lo dices, creo que sí...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_000442",ch="rna"},
},
ja={
{
name={"Rina"},
"“Apenas terminamos de hablar por el teléfono vine hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me refiero a eso, sino que...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_a33_03",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000443",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Será que aún recuerdas este parque?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo recuerdo. Ya sería demasiado que lo olvidara, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rna_000444",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Conociendo cómo eres, pensé que lo habías olvidado todo por completo,\nsenpai.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, claro que no. ¿Cómo voy a olvidar el lugar donde te conocí por primera vez?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_a33_04",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000445",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, ya veo... Aunque, con tantos cipreses alrededor el parque parece un\ncementerio de Occidente, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, realmente que sí.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Los cipreses se usan como árboles de navidad, pero en Occidente son también\nsímbolo de la muerte, y se ven con frecuencia en los cementerios.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rna_000446",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es algo tétrico que nuestro primer encuentro haya sido en un parque de\ncipreses... Son símbolos de la muerte. De los lamentos y de la desesperanza.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera un momento, ¿no estás olvidando los otros significados que\nencierra el ciprés?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_a33_05",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000447",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Los hay?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Inmortalidad, reencarnación, y más de ese tipo. En el antiguo Egipto y la\nantigua Roma los cipreses fueron venerados como árboles sagrados, creyéndose\nque simbolizaban eso.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000448",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, sabes bastante.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? Se supone que eres tú quien tiene más apego con los cipreses,\n¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_a33_03",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000449",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Pues, supongo que una vez lo tuve.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez... eh.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Vuelvo a observar el bosque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Los cipreses sientan raíz fuerte en el suelo, imponentes como torres negras.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"La armonía que hay entre ellos se me parece... a aquella de los obeliscos.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_a33_02",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000450",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es descabellado que un genio sienta fascinación por el símbolo de la\nmuerte... Pero que una persona común y corriente como yo lo haga es cosa de\nfantasiosos.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rna_000451",ch="rna"},
},
ja={
{
name={"Rina"},
"“En aquel entonces estaba en el apogeo de mi época de niña fantasiosa.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Niña fantasiosa, eh... Pues, creo que si me hubiese parecido así, no habría\nhecho eso...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_a33_03",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000452",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no lo parezca, Naoya Kusanagi no es la clase de hombre que produce obras\npor allí y por acá indiscriminadamente.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rna_000453",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es eso cierto? De lo que recuerdo, esa obra estaba ya por la mitad en aquel\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahh... ¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_a33_04",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000454",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, senpai, tal como me lo imaginaba. Solo estabas inventando cosas.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000455",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero, me hace feliz que me digas eso. De que revelaras que pintaste esa obra\npara mí.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para ti... Sí, supongo que en parte fue eso también.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero fue más que todo porque me divertí haciéndolo. Me entretuve tanto que\nterminé culminándola.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_000456",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, claro. Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Hikawa se ríe.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Creo que llevaba tiempo sin ver esta sonrisa.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"No es de sorprenderse. Ha pasado bastante tiempo desde la última vez que\npudimos estar juntos a solas...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Hay algo en la sonrisa de Hikawa que se asemeja a la de Rin. Pero una es como\nla Luna, y otra como el Sol.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"La sonrisa de Hikawa me trae la Luna a la mente.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_000457",ch="rna"},
},
ja={
{
name={"Rina"},
"“Atravesemos el bosque.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Hikawa y yo comenzamos a caminar por el bosque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Llevaba un buen tiempo sin ver a Hikawa en ropa casual.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Sigue todavía llevando ropa blanca, como lo hacía hace tiempo.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"¿Estará sufriendo aún de los efectos de la enfermedad?",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_a33_03",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000458",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sucede algo? ¿Por qué me estás viendo?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no. Solo que, noté que llevas ropa blanca aún...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rna_000459",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿este vestido? Sí, bueno, es que el blanco refleja la radiación del sol. La\nsombrilla es blanca también.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que las negras funcionan mejor. Las blancas dejan pasar parte de la luz.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_a33_05",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000460",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En serio? Dicen que la ropa blanca protege del sol, así que se me ocurrió que\nla sombrilla debía ser blanca también.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000461",ch="rna"},
},
ja={
{
name={"Rina"},
"“La primera vez que te conocí también llevaba vestido y sombrilla blanca.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre nos veíamos en las noches, así que no sé qué sombrilla llevabas en\naquel entonces.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_000462",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Pero, aquella noche también llevaba una blanca.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_a33_05",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000463",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que las sombrillas negras son mejores... Quizás debí haber elegido una más\ncolorida entonces.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_a33_04",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000464",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mi sombrilla debe ser blanca. Estaba convencida de eso.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Hikawa sonrió un tanto tristemente mientras agarraba ligeramente el borde de la\nsombrilla.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Vestido blanco, sombrilla blanca.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Por alguna razón me pareció que esas dos cosas simbolizaban, de alguna forma, a\nHikawa.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sabías? Debí habértelo dicho antes.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000465",ch="rna"},
},
ja={
{
name={"Rina"},
"“Para nada. De ahora en adelante sé que podré disfrutar también eligiendo y\ncomprando sombrillas de variados colores. Alegrías como estas son siempre\nmejor dejarlas para después.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre te vistes de blanco, procurando no exponer mucho la piel al sol. Y mira\nnada más, por alguna ironía del destino, el uniforme de Yumihari es de tono\noscuro.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000466",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, por eso mismo mis padres se opusieron a que ingresara a Yumihari. Me\ndijeron que eso le pondría más carga a mi cuerpo, y me recomendaron que\neligiera otro lugar.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo menos debieron haber usado un tono más claro para el uniforme de verano.\nDe nada sirve llevar un chaleco negro en verano.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rna_000467",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa, realmente. Yumihari es el colegio al cual quise entrar, y por eso\nno me dejé llevar por la opinión de mis padres.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_000468",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además, el color del uniforme lo hace lindo. Si fuera blanco no se vería tan\nbien. Lo oscuro es el secreto.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no le sienta bien a tu salud, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_a33_03",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000469",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, ¿quién sabe? Capaz y ya me curé.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No mientas, lo tuyo no es la clase de enfermedad que se cura tan fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_a33_01",sync=0,face=1,time=400,path=":ev/ev_com_a33/",set="ev_com_a33"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000470",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes razón. Pero ya han pasado seis años desde entonces.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues vaya que sí. Seis años, eh...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Nos vamos acercando a la zona central del bosque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La parte central de este bosque está anormalmente vacía. No hay nada.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000471",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. En el centro del bosque no hay absolutamente nada.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000472",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es que, ese día... tras la noche de aquel día, después de que llegara aquel\nimpactante tifón, comenzaron la demolición.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese día... El tifón... Pero cuánto tiempo sin acordarme de eso. Sí, esa fue\nrealmente una noche huracanada.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000473",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo fue. ¿Será por eso que me emociono cuando viene tifones en la noche?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es normal, cualquiera se emociona cuando llega una tormenta en la noche, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0001",head="rna_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000474",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es así. Son precisamente las noches de tormenta en las que uno siente que\npodría suceder algo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0002",head="rna_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000475",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una noche en la que uno siente que podría suceder algo... Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Hikawa observa los alrededores del parque, y--",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0003",head="rna_z1e",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000476",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quisiera venir de nuevo, algún día de estos que tenga tiempo...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"se",file="se9004",id=1},
{"fg",ch="里奈",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Diciendo solo eso, comenzó a caminar sin esperar por mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Siguiendo los rápidos pasos de Hikawa, terminamos de atravesar el bosque de\ncipreses.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0002",head="rna_z1e",lv=4,id=9},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ese bosque está conectado con este lugar?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Al atravesar el bosque de cipreses y caminar por una especie de paseo, llegamos\nal Templo Hakuki en Yumenoukizaka.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0003",head="rna_z1e",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0001",head="rna_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000477",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Este templo está conectado con muchos atajos. Ehh, ¿templo Baku es que le\nllaman?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo de templo Baku es un nombre popular. Su verdadero nombre es otro.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su nombre original es Templo Hakuki. Aunque la gente de la zona comenzó a creer\nque acá se adora al Baku, y por eso le llaman templo Baku.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000478",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ahora que lo mencionas, me parece haber escuchado ese nombre antes.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, quién diría que terminaríamos acá...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000479",ch="rna"},
},
ja={
{
name={"Rina"},
"“Al parecer, en la antigüedad toda esta colina era un solo templo, y también fue\nla zona central de Yumihari. Así que conecta con varios lugares de la zona.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"La ciudad de Yumihari ha tenido a esta colina como un objeto de fe desde\ntiempos antiguos.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Asi que no me pareció nada descabellado que cualquier camino conecte a esta\nzona.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias por traerme hasta acá. Me sacaste de un aprieto.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000283",ch="yum"},
},
ja={
{
name={"???"},
"“¡Sacarte es poco!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Escucho una voz a mis espaldas.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Es la voz de Kawachino. No cabe duda alguna de que está corriendo hacia acá.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",stop=1,time=500,id=1},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000284",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Tooou!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"se",file="se9015",id=1},
{"text"},
text={
ja={
{
"Se escuchan unos pies pateando el suelo.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"se",file="se_avoid",id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Sentí un inminente peligro acercarse ante el grito de Kawachino, y me alejo de\ninmediato del lugar.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_000285",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh--”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000286",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿E-Esquivaste? ¡W-Waaahhh!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",rule=280,time=300,vague=40},
{"se",id=1,file="se1293"},
{"cgact",stage="bg063",act="いいえ",lv=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000287",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Kyaaawaaahhh!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0013",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000480",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y-Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿K-Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Parece que Kawachino trató de lanzarme una patada voladora, pero al haber yo\nesquivado terminó volando ella por el aire.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Y ojala hubiera sido solo eso, pero al parecer cayó directo sobre la pendiente\nque había cerca.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000481",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y-Yuumi! ¡¿E-Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="zeveningsky_spring01",id=9,lv=9,speed=300000,time=500,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Bajo la pendiente del Templo Hakuki por la cual cayó Kawachino.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Quizás el suelo sea de tierra, pero la pendiente está relativamente inclinada,\ny también hay varios árboles alrededor. Si llega a chocar con alguno de\nellos, las cosas se tornarán graves.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Bajo rápidamente al lugar donde cayó.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kawachino, ¿estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_000288",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“K-Kusanagi-senpai... a-auch...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que querías patearme, pero trata de medir más tu fuerza al hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_yum_000289",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hubiera pasado nada si hubieras recibido mi patada...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, aún eres capaz de decir estupideces. Pareces estar bien.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_yum_000290",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aun a punto de morir no pararía de decírtelas.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, demonios.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_000291",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Cargo a Kawachino en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000292",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Q-Qué haces?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te cargo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_000293",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Con el permiso de quién?!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien, si me quieres golpear entonces hazlo después.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_000294",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se te ocurra descontrolarte ahora, o cometer alguna idiotez. Es peligroso\nhacerlo acá. Así que en fin, espera a que subamos esta pendiente.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_000295",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Ese argumento es sorpresivamente convincente... como para venir de un idiota\ncomo tú...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te convenció lo que dije entonces agárrate bien. Esta pendiente es bastante\nempinada.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_000296",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"se",file="se9010",id=1},
{"mwact",act="おじぎ"},
{"text"},
text={
ja={
{
"Kawachino se aferra fuertemente a mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000297",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Q-Qué?! ¡T-Tú mismo dijiste que me sujetara bien!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es eso. Solo que tienes menos fuerza de agarre de la que pensaba que\ntenías... Ah, pues claro, por más que andes blandiendo un cuchillo de cocina\npor todos lados, eres una chica... ¡Eh, a-auch, auch!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"se",file="se1437",id=1},
{"quake",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000298",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y? ¿Todavía crees que tengo poca fuerza?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Imbecil, lo único que estás haciendo es pellizcarme!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000299",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo hago porque andas diciendo cosas raras...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan raro es eso? Lo único que dije es que tú también eres una chica-- ¡Esp--,\naaach!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"se",file="se1437",id=1},
{"quake",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000300",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Cierra la boca y llévame hasta arriba!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rayos, está bien, está bien.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"se",file="se9010",id=1},
{"mwact",act="うなづく",size=5},
{"text"},
text={
ja={
{
"Al decir eso, Kawachino volvió a agarrarse de mí.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Sus manos son pequeñas.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Se me vino eso a la mente, pero me pellizcaría si lo dijera, así que preferí no\nhacerlo.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0012",head="rna_z1d",x=-345,lv=4,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"se",file="se9010",id=1},
{"fg",ch="優美",size="z1",my=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000482",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000301",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, me atendiste con bastante cariño, así que estoy mejor ahora.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000483",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tampoco fue la gran cosa. Lo único que hice fue ponerte una curita sobre el\nraspón.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000302",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No me la quitaré jamás!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000484",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera, eso es imposible.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000303",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Me esforzaré!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Menos mal que no recibió ningún golpe, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000304",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Aprovechaste de tocar mis piernas con la excusa de verificar si había algún\nmoretón!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excusa ni nada, lo único que hice fue inspeccionar que estuvieras bien.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000485",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero ciertamente lo hiciste con bastante pericia. Tanta así que no parecieras\nser un simple integrante de un club de arte, senpai.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en parte está el hecho de que debo conocer bien el cuerpo humano al\nmomento de dibujar... y bueno, quise tener en mis manos una herramienta para\nconocerlo mejor, literalmente...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000486",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000305",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Estás tratando de desviar el tema! ¡Simplemente querías manosear mis muslos!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000306",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vírgenes, por cosas como estas es que no los soporto.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que sea virgen o no no tiene nada que ver. En fin, creo que no hubo ningún\ngolpe serio. Si te llega a doler después ve al hospital.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000307",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quizá lo haga. No me agrada la idea de tragarme todo lo que digas.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por eso es que vas a ir?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000487",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero es realmente un alivio que solo hayan sido rasponazos.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Y por otro lado, ¿por qué intentaste patearme repentinamente? En primer\nlugar, ¿qué haces acá?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000308",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Llamé a Rina, me dijo que te habías perdido e iría a ayudarte, así que me\nadelanté.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te adelantaste? ¿Cómo es que supiste que pasaríamos por acá?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000309",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000310",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No pienso contarle nada a idiotas.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A idiotas?... Por Dios, Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Por alguna razón, Hikawa estaba forzando una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rna_000488",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que no soy la única que sabe que al atravesar el bosque de cipreses se\nllega hasta acá...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que tú también conoces ese parque?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000311",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Digamos que sí. Aunque no me gusta.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_yum_000312",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque odio los cipreses.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Odias los cipreses?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000313",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los cipreses se convierten en cerezos. Esas negras y frondosas hojas terminan\npor transformarse, en cuestión de instantes, en una blanca tormenta de\ncerezos...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000314",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Y por eso es que odio con todo mi ser los cipreses!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cipreses, se convierten en cerezos...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000489",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Conozco ese panorama.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Justamente cuando me puse a pensar en eso――",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"bgm",stop=1,time=500},
{"bg",rule=037,time=300,file="black",path=":bg/"},
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"El viento sopló.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"No sé por qué, pero sentí que ese brisa había venido de muy lejos.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"bg",time=1500,file="white",path=":bg/"},
{"bg",file="zev_uni_c27_01",zoom=80,speed=60000,path=":ev/ev_uni_c27/",set="ev_uni_c27",x2=-190,y2=-320,x=110,y=-160,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Una luz blanca flota en medio de ese viento.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Blancos pétalos vuelan junto a esa lejana brisa.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0009",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000490",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Esto... es?...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000315",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Y en ese preciso instante, cuando creí haber visto pétalos alrededor, la brisa\nse detuvo.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me pareció haber visto pétalos de cerezo caer justo ahora...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0011",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000491",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, a mí también me parece haberlos visto... ¿Será solo mi imaginación?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que ya estamos fuera de temporada, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez fueron los espíritus de los cerezos muertos, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000316",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso es ridículo, lo que dices no tiene base científica alguna.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0009",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000492",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero tal vez... Sí, existe algo así, ¿no? Esa cosa que trae felicidad a aquel\nque la vea. ¿Cómo era que se llamaba? ¿'Kesaran Pasaran', era?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kesaran Pasaran? ¿No era esa la criatura que parece hecha de algodón?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0010",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000493",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo sé, jamás lo he visto.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. Aunque, probablemente no fue eso.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000317",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué fue entonces?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0011",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000494",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parecían ser pétalos de cerezos, pero... supongo que nuestra vista nos engañó,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000318",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Además, estamos en verano...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no hay ningún rastro de que estén floreciendo por acá...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Le echo un ojo a mis alrededores.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Por cosa obvia, no logro ver ningún cerezo fuera de temporada alrededor.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada floreciendo por acá, eh.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000495",ch="rna"},
},
ja={
{
name={"Rina"},
"“No creo que haya nada floreciendo aquí.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000319",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué fue eso que vimos entonces?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Vuelvo a ver alrededor.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no tengo manera de responder a esa pregunta...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000320",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los cipreses, se transforman en cerezos...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dijiste?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000321",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000322",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, ya se hizo tarde, regresemos a casa. Temo que si oscurece aún más\nKusanagi abusará de ti, Rina.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué demonios?!”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0004",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000496",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, me parece que eres tú la que está por violarme en cualquier momento,\nYuumi.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000323",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Tomaré eso como una invitación a hacerlo! ¡Así que quieres que te viole, ¿eh?!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0015",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000497",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡NO THANK YOU!”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000324",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Te crees Daddy Cool?!”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0010",face="e0017",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000498",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé de qué me estás hablando...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bien, creo que mejor nos vamos ya...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000499",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000325",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Nos fuimos del Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Conozco esos cerezos.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Esos siniestros pétalos, los he visto ya antes.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ni en mis peores pesadillas quisiera volver a vivir de nuevo lo que pasó\nese día...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_rna_000500",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Senpai? ¿Por qué te detuviste?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no sucede nada.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_yum_000326",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si te quieres quedar me harías un gran favor.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, muchacha, a un senpai no se le debe tratar de manera tan fría...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_000501",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí, está bien. Dejen de pelear los dos y vayamos ya.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_ze03"},
{"text"},
linkback="block_00288",
},
label = {
top={block="block_00000",label=1},
},
}
