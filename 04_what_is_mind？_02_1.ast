astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"bg",file="ev_eye_c12_01",path=":ev/ev_eye_c12/",set="ev_eye_c12"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"En ese entonces yo era un profesor a tiempo parcial en el colegio Yumihari.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Supongo que tú, siendo también uno a tiempo parcial, sabrás que el trabajo está\nlibre de ocupaciones, sí. Pero también te llena de preocupaciones por el\nfuturo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Pero, así como cualquier joven en cualquier época, tenía una visión\ninexplicablemente despreocupada de ese futuro.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Si hay un privilegio que se pueden dar los jóvenes es, probablemente, ese.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg043a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"bgm",file="bgm017"},
{"text"},
text={
vo={
{"vo",file="fem_skd_000001",ch="skd"},
},
ja={
{
name={"Saki"},
"“Bien, profesor Kusanagi, tengo algo que hablar con usted.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_kid_000047",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ah? Ah, Saki. ¿Por qué la cara de terror?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0016",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000002",ch="skd"},
},
ja={
{
name={"Saki"},
"“Kusanagi-kun, escucha, ¿sería mucho pedir que llames a la jefa de profesores\ncomo debe ser?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_kid_000048",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, cierto. Ehh, profesora Saki.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000003",ch="skd"},
},
ja={
{
name={"Saki"},
"“Apellido, no nombre.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_kid_000049",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Profesora Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0009",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000004",ch="skd"},
},
ja={
{
name={"Saki"},
"“Así es. Cielos, definitivamente aún no se te ha quitado la actitud de\nestudiante.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_kid_000050",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué puedo hacer? Hasta hace poco estuve vagando por ahí con esa misma actitud\nde estudiante.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000005",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ciertamente... Me contaron que estuviste todo este tiempo viajando.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_kid_000051",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, pasé por varios países con el dinero que me gané haciendo trabajos de medio\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0009",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000006",ch="skd"},
},
ja={
{
name={"Saki"},
"“Dios mío, ¿a quien se le podría ocurrir renunciar a un empleo formal para\nviajar por todo el mundo después de graduarse? No puedo creer lo\ndespreocupado que eres...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_kid_000052",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, pero ese despreocupado hombre está agradecido con la jefa de profesores,\naunque no lo creas.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_kid_000053",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si no fuera por tu recomendación hubiese sido muy difícil conseguir este puesto\nde profesor a tiempo parcial...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000007",ch="skd"},
},
ja={
{
name={"Saki"},
"“P-Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000054",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero ¿por qué pasar por tanto para ayudarme a entrar? Alguien en tu posición no\nvería como muy buena opción a un tipo como yo...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000008",ch="skd"},
},
ja={
{
name={"Saki"},
"“Si estás consciente de eso agradecería que cuidaras un poco más tu\ncomportamiento y no me metas en problemas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000055",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, me esforzaré. Aunque créeme que sí estoy agradecido contigo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0004",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000009",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿S-Sí?... P-Pues, al verte pensé que si no te conseguía algo, volverías a irte\na vagar a algún otro país y acabarías muerto de hambre por ahí, así que...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000056",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué? ¿Preocupada por mí? Pero sí, desde hace tiempo te he gustado, Saki.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0006",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000010",ch="skd"},
},
ja={
{
name={"Saki"},
"“¡Te recuerdo que soy una mujer casada!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000057",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_kid_000058",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Nakamura, era? Parece que es una familia enorme, eh. Según he escuchado, su\nhistoria se remonta a la era Kamakura.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000011",ch="skd"},
},
ja={
{
name={"Saki"},
"“Sí... así es. Aunque...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_kid_000059",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa? ¿Insatisfecha con tu matrimonio? ¿Qué tal si nos escapamos juntos\nentonces?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000012",ch="skd"},
},
ja={
{
name={"Saki"},
"“De verdad que no se te ha quitado ni un poco esa actitud bromista.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_kid_000060",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ni un poquito.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000013",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Y bien? ¿Es ese mismo espíritu de bromista lo que te lleva ahora a intentar\nrenovar la iglesia sin permiso de nadie?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_kid_000061",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya, ¿es que te diste cuenta?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0016",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000014",ch="skd"},
},
ja={
{
name={"Saki"},
"“Detén ya esa renovación. Si bien me enteré ya que fue el padre Masada quien\npidió hacerlo... vas a meterte en un problema muy grande si sigues haciendo\nlo que te da la gana.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"mwact",act="うんうん",time=200},
{"text"},
text={
vo={
{"vo",file="man_kid_000062",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está bien, está bien.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0006",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000015",ch="skd"},
},
ja={
{
name={"Saki"},
"“Se responde solo una vez.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"mwact",act="おじぎ"},
{"text"},
text={
vo={
{"vo",file="man_kid_000063",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está~, bien~”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,time=1000,sync=1,path=":cg/"},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
"Saki Toritani y yo hemos sido amigos desde nuestros años en la universidad.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Bueno, también hubo un tiempo que fuimos novios.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Aunque, para este entonces ella ya había contraído matrimonio y era parte ahora\nde la prestigiosa familia Nakamura.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Los Nakamura. No hay nadie en esta ciudad que no conozca ese nombre, y esa es\nmuestra de su fama. Antes de la guerra estuvieron involucrados en cada una de\nlas industrias activas en Yumihari.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Después de la guerra, el fuerte crecimiento de una familia de Yakuza llevó a\nque perdieran gran parte de su poder. Pero eso no cambió la inflada imagen\nque tenían en la ciudad de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="black",path=":bg/",sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"El esposo de Saki se llamaba Shoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Apuntado como próximo dirigente de la familia, tenía un enorme poder en sus\nmanos. Manejaba varios negocios a la vez que presidía la junta directiva del\ncolegio como presidente.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Gracias a eso es que Saki pudo convertirse en jefa de profesores.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Saki era ya una mujer inteligente y hábil. Pero en este mundo inteligencia y\nhabilidad no son suficientes para ascender la escalera social.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Y en lo social, otras cosas impactan mucho más que habilidad en sí.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"No sé qué sentimientos pudo haber tenido Saki al decidir casarse con Nakamura.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Aunque, al parecer su voluntad fue ignorada, procediendo todo como un\nmatrimonio de intereses.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"El hombre le lleva 15 años. Y su aspecto no se acerca en nada a un zorro\nplateado, he escuchado.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Y no me llegan muy buenos rumores de él.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Aunque bueno, es el administrador de este colegio. Supongo que es inevitable\nque sus empleados -los profesores- hablen a sus espaldas...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Aunque, si hay algo innegable es que definitivamente no es una personalidad de\ncarisma.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Y en eso, no puedo evitar pensar en algo que podría ser irrespetuoso.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"¿Qué tenía Saki en su mente y corazón cuando caminó el pasillo hacia el altar e\nhizo el juramento ante el padre?",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"No lo sé.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y la razón es porque jamás llegué a verla en vestido de novia.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Al momento de su casamiento yo estaba en los Estados Unidos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Entre todos los países que visité, uno de los que más me gustó fue Estados\nUnidos. Había pasado casi un año de recorrer todo lo largo de la costa este.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Estaba en la zona noreste de Massachusetts, condado de Suffolk. Fue en esa\nenorme metrópolis donde me enteré de su matrimonio.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Después de leer su carta, choqué mi copa en un bar de Boston con un americano\nque tenía casualmente sentado al lado.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Hasta el día de hoy no he dejado de pensar en algo.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"¿Fue lo correcto haber dicho 'salud' y brindado por ella?",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"¿O es que acaso hubiese sido mejor decir 'muérete' y mandarla a la mierda?",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Estando al otro lado del mundo y sin idea de cuál sería la opción correcta, lo\núnico que se me ocurrió fue decirle al americano de al lado, '¡Brindemos!.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"El americano respondió 'no hago nada que no dé dinero'. Yo le dije esto: '¡Pues\nhagamos ahora cosas que no den dinero!.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Soltando una sarcástica sonrisa, este dijo 'imbécil' y extendió su vaso.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="black",path=":bg/",sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Desde que lo conocí, el hombre -Fridmann- ha sido un tipo muy raro.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Se graduó en una famosa universidad de Massachusetts (la Umass, no muy conocida\nen Japón) para luego entrar en el mundo de las finanzas. Después de eso, por\nalguna razón ingresó a la fundación Moore.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Al parecer no poseía ningún título universitario en artes (su campo eran las\nfinanzas), pero desde ese entonces poseía un agudo ojo para el arte.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Como buen animal de las finanzas, su palabra más usada era 'dinero'. Y sin\nembargo, también hacía muchas cosas sin ningún valor o recompensa monetaria.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Si bien ni su actitud o personalidad son buenas, probablemente en el fondo es\nun buen tipo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"El sonido de nuestros vasos chocando sonó con tal fuerza que te hacía pensar\nque llegaría al otro lado del globo.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Pareció, definitivamente, la clase de sonido que podría llegar al fin del\nmundo.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Aunque, probablemente era porque estaba ya ebrio.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Estando al otro lado del planeta, celebré el matrimonio de Saki con un brindis.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Por cierto, Fridmann, quien estuvo conmigo ese momento, y yo, estaríamos\ndestinados a encontrarnos una y otra vez más después de ese día.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Varias veces fuimos compañeros de negocios, y otras adversarios. Nuestra\nrelación siempre fue así.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0008",head="sak_z1d",lv=4,id=9,sync=0},
{"extrans"},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_skd_000016",ch="skd"},
},
ja={
{
name={"Saki"},
"“En fin, ten prudencia. Solo hay que darle tiempo al tiempo, y puede que el\nasunto llegue a la directiva.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Saki siguió hablando de la restauración de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_kid_000064",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tiempo al tiempo, eh... Será verdad eso...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0016",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000017",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_kid_000065",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Según el padre Masada, ya lleva varios años intentando hablarle a la directiva\ndel tema, pero no le prestan atención...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000018",ch="skd"},
},
ja={
{
name={"Saki"},
"“No te convence lo que dije.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000066",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En realidad sí.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0016",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000019",ch="skd"},
},
ja={
{
name={"Saki"},
"“Mentiroso.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_kid_000067",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Saki me sigue.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000020",ch="skd"},
},
ja={
{
name={"Saki"},
"“Pero te lo advierto, Kusanagi-kun. Si sigues haciendo lo que te venga en gana\nterminarás en la calle.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kid_000068",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Y llegamos a la cantina.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_skd_000021",ch="skd"},
},
ja={
{
name={"Saki"},
"“Qué temprano almuerzas, apenas comienza el cuarto período, todavía falta un\npoco para el receso del mediodía...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_kid_000069",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso es que esta es la hora indicada. Ah~, eh~~, jefecito~”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_oys_000023",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¡Kusanagi! ¡Para ya con lo de jefecito! ¡Tengo casi la misma edad que tú!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_kid_000070",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿En serio? Vamos, qué importa eso, jefecito. Total te ves viejo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_oys_000024",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¡Y ya te he dicho que no me menciones más eso! ¡Me tiene acomplejado!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_kid_000071",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, está bien. Por cierto, ¿tienes la lata de sanma asado que te pedí?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_oys_000025",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Sí, la conseguí.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_kid_000072",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_skd_000022",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Lata de sanma asado?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="man_kid_000073",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, sí. Saki, ¿no te gustaría almorzar takikomi gohan hoy?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_skd_000023",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Takikomi gohan?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="man_kid_000074",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, lo prepararé con el sanma asado enlatado.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_skd_000024",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Con un enlatado? ¿Eres capaz de preparar semejante plato?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="man_kid_000075",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, claro. Y sabe genial, eh. Seguro que de probarlo se te alisarán esas lineas\nde expresión.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skd_000025",ch="skd"},
},
ja={
{
name={"Saki"},
"“¡Y-Yo no tengo ninguna línea--!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Saki se lleva apresuradamente la mano a su frente.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Siempre lleva una cara de enfado encima, pero es hermosa cuando sonríe.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Pero en contraste con eso, era una mujer terriblemente aguda.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Haciendo analogía con su agudeza, llegarían a llamarle después 'La cuchilla\nToritani'.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Toritani era su apellido de soltera. En pocas palabras, un tiempo después se\ndivorciaría de Nakamura.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="black",path=":bg/",sync=0},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Y mucho después de eso.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Según parece, se convirtió en la directora del colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Y digo parece porque en ese momento yo todavía no estaba en el país.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Desconozco los detalles, pero según me contaron, al convertirse en directora\nacabó con todas las acciones que poseían los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Eliminó el control de los Nakamura sobre el colegio Yumihari practicamente\nsola. Habilidad es poco para describir su talento.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"La intervención de Saki hizo que el colegio Yumihari pasara de ser propiedad de\nlos Nakamura a un sistema de múltiples accionistas.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Hospitales, contratistas de construcción y no sé quien más. En fin, varios\nmillonarios de Yumihari invirtieron enormes sumas de dinero en el colegio.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Ese mismo talento, sin embargo, le ganó rencor y muchos enemigos.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Según he escuchado, no se lleva bien con su hija.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Aunque, semejante hazaña no podría lograrse sin ganarse el odio de muchos.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"No sé por qué decidió llegar a esos extremos. No tengo manera de saber por qué.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Pero sé muy bien lo que significa tener a los Nakamura de enemigos.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Todo eso, lo hizo ella sola.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Me canso de decirlo ya, pero no conozco mucho de toda la hazaña que logró en\nese tiempo.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Sin embargo, tengo una idea en mente.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Probablemente nunca llegue a contármelo ella misma, eso sí.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Aunque sí.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Posiblemente fui yo quien llevó a Saki a convertirse en la directora del\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Mi encuentro con esa muchacha.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Si no la hubiese conocido en ese momento, probablemente todo habría tomado una\ndirección completamente distinta.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Quizá yo hubiese seguido trabajando de profesor en Yumihari, y quizá Saki\nseguiría portando el apellido Nakamura.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"No, olvida lo que dije. Es estúpido ponerse a pensar en eso.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"En la vida, ponerse a pensar en los 'y si' es inútil. En primer lugar, esas\nelecciones, en particular, apestan.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"En la vida no se necesita ningún 'y si'. Por eso mismo es que mi encuentro con\nesa muchacha, en ese lugar y en esa temporada, fue algo destinado.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"Así como los pétalos de cerezo deben dispersarse tarde o temprano... de esa\nmisma manera nos encontramos por primera vez, en la época donde esos pétalos\nvuelan.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_uni_c57_01",path=":ev/ev_uni_c57/",set="ev_uni_c57"},
{"text"},
text={
vo={
{"vo",file="man_kid_000076",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"El azulado humo se eleva, esfumándose en el cielo.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kid_000077",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pwaaah.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"mwact",act="うんうん",time=400},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000001",ch="mzd"},
},
ja={
{
name={"???"},
"*cof*, *cof*...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_kid_000078",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"mwact",act="うんうん",time=400,size=5},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000002",ch="mzd"},
},
ja={
{
name={"???"},
"*Cof*, *cof*...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Camino hacia el lugar de donde se escuchaban los tosidos.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_g02_01",path=":ev/ev_com_g02/",set="ev_com_g02"},
{"bgm",file="bgm011"},
{"text"},
text={
ja={
{
"Estaba allí sentada una muchacha, la cual me vio con una feroz mirada.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kid_000079",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“E-Ehm...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000003",ch="mzd"},
},
ja={
{
name={"???"},
"“¿Le molesta si le pregunto algo, profesor?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kid_000080",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000004",ch="mzd"},
},
ja={
{
name={"???"},
"“¿Por qué aun cuando intento alejarme siempre de usted usted se acerca?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_kid_000081",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, eh, disculpa por eso. Solo que te escuché tosiendo muy fuerte y me\npreocupé.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000005",ch="mzd"},
},
ja={
{
name={"???"},
"“Me estaba ahogando con el humo de su cigarro, profesor.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000006",ch="mzd"},
},
ja={
{
name={"???"},
"“Se supone que acá no se debe fumar, ¿o me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_kid_000082",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“T-Tienes toda la razón... lo siento.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Apago rápidamente el cigarro.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_g02_02",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000007",ch="mzd"},
},
ja={
{
name={"???"},
"“Está bien, no hace falta que lo apague. Me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_kid_000083",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero tú estabas aquí primero, ¿no? Eh, ¿cómo es que te llamas?...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"user",mode="conf",ch="水菜"},
{"bg",file="ev_com_g02_01",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000008",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Mizuna Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_kid_000084",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_g02_05",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000009",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“*Fiuu*, ¿usted también con esa cara?... Sí, justo como acaba de pasar por su\nmente, es 'esa' familia Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_kid_000085",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, no es por eso. Sino que ese nombre lo veo siempre de primero en las listas\nde calificaciones...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_g02_03",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000010",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ah, ¿por eso?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_kid_000086",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, no lo digas como si no fuese nada... Hablamos del primer lugar en\ncalificaciones, ¿sabes? Ni siquiera yo podría evitar aprenderme tu nombre.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_g02_04",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000011",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Sí? Pues gracias por el cumplido.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kid_000087",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pensé que eras algo más como una empollona.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_g02_02",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000012",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Lo soy. Incluso mis horas de sueño las uso para estudiar, soy una gran\nempollona. Pero sí, es normal conseguir esas calificaciones al llegar a este\nnivel.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_kid_000088",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eso crees? No es tan simple mantener el puesto de número uno consecutivamente\nsolo por estudiar también en tus horas de sueño, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_g02_04",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000013",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“En realidad sí. O al menos según lo que he leído, no hay mucha diferencia entre\nlas personas en lo que a memoria se refiere. Por lo tanto, más horas de\nestudio, mejores calificaciones, así de simple, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kid_000089",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Me estás diciendo entonces que lo único que haces es estudiar más que los\ndemás?...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_g02_05",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000014",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí. No soy particularmente mucho más inteligente que los demás, así que se\nreduce a eso...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"¿De verdad?",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Por mi parte, jamás he estudiado tanto como ella, así que no sabría decir...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_kid_000090",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_g02_02",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
ja={
{
name={"Mizuna"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Uh, la conversación se estancó.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_kid_000091",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Oye, eh... ¿Mizuna, san?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_g02_04",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000016",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_kid_000092",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que eres de la famosa familia Nakamura~, vaya. ¿Eres entonces familia de la\nprofesora Saki Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000017",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿La profesora Saki Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bg",file="ev_com_g02_05",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
ja={
{
"La expresión de Mizuna se ensombrece..",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000018",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí... lo soy, supongo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"En ese momento no sabía por qué su rostro se ensombreció. Sin embargo, un poco\ndespués conocería la razón.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_kid_000093",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Otra cosa. Estamos en hora de clases, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bg",file="ev_com_g02_04",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000019",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_kid_000094",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No irás al salón?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000020",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="man_kid_000095",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué raro ver a la número uno saltándose clases.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000021",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Es una materia que no influye en los exámenes de la universidad...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_kid_000096",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"se",file="se9010",id=1},
{"bg",file="ev_com_g02_08",path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
ja={
{
"Al decir eso, la muchacha abrió un libro.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"El título de la obra era 'Haru to Shura' (Primavera y Caos)",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Una colección de poemas de Kenji Miyazawa.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Esa colección, calificada por el mismo como una de bosquejos mentales, daba\nabarcadura para todo tipo de interpretaciones, y dependiendo de la manera en\nque lo leyeras, podría ser incluso incomprensible.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_kid_000097",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“'Haru to Shura' de Kenji Miyazawa...\nLos escritos que denominó como bosquejos mentales describen con palabras los panoramas mentales de la misma forma que\nun pincel lo hace con una pintura.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bg",file="ev_com_g02_07",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000022",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Pintura, y pincel?...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_kid_000098",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por algo le llama bosquejos. Aunque, el nivel de perfección es muy alto como\npara poder llamarle bosquejos, la verdad. A mi parecer, sus bosquejos\nmentales se acercan a los del impresionismo...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000023",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“El impresionismo...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_kid_000099",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Se me parece un poco a uno de los últimos impresionistas, Gogh.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000024",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Sabía usted de eso?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="man_kid_000100",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000025",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Que Kenji Miyazawa se inspiró en los cipreses de Gogh, y gran parte de sus\nbosquejos mentales se inspiraron en ese trabajo.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_kid_000101",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿En serio? No lo sabía.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_g02_09",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000026",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Dentro de 'Haru to Shura' aparece muchas veces la palabra ",
{"txruby",text="Tsipressen"},
"ZYPRESSEN",
{"txruby"},
".”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_kid_000102",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“",
{"txruby",text="Tsipressen"},
"¿ZYPRESSEN",
{"txruby"},
"? ¿Por qué? 'Shupresson' se acercaría más a la pronunciación\ncorrecta en alemán, ¿no?”",		
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000027",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ciertamente. Aunque al parecer Miyazawa reescribió 'Tsipressen' con ZYPRESSEN\nen su borrador de 'Haru to Shura'.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_kid_000103",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Es bastante común ver términos extranjeros en un katakana raro en los libros de\nantes de la guerra. ¿Será eso?",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"bg",file="ev_com_g02_07",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000028",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Según lo que acabo de escuchar, usted vio la influencia de Gogh en 'Haru to\nShura' no por libros y datos, sino intuitivamente.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="man_kid_000104",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Cómo es que descubriste eso solo con lo que dije?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000029",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Porque en los libros de ensayos de investigación, siempre que se habla de la\ninfluencia de Gogh también se habla de la pronunciación de ZYPRESSEN...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_kid_000105",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000030",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ya veo. Así que hay gente capaz de descubrir eso intuitivamente... increíble.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bgm",stop=1,time=500},
{"bg",file="ev_com_g02_08",sync=1,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"bg",file="ev_com_g02_09",path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
ja={
{
"Mizuna cierra sus ojos y comienza a recitar algo de memoria.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000031",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ese fenómeno llamado 'Yo' es una sola y única luz azul de una presupuesta\nlámpara de materia orgánica enlazada (El cuerpo compuesto de todos los\nespectros invisibles existentes)”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000032",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Una sola y única luz azul de una lámpara de causalidad enlazada que sigue\nbrillando cierta y definitivamente, mientras titila ocupada y afanosa, junto\nal paisaje y junto a todos (la lámpara desaparece pero la luz permanece)”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="man_kid_000106",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El prólogo...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_com_g02_08",path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
ja={
{
"Al asentir con un ligero movimiento, Mizuna siguió recitando el poema.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000033",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Todo esto viene de la dirección sentida como pasado, de veintidós meses usando\ntinta mineral con papel (Todo titila junto a mí, sienten todos a la vez)”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000034",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y así como detallan estos pasajes de sombra y luz, conservados desde entonces\nhasta hoy, es así mi bosquejo mental.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000035",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y respecto a esto, tanto personas, como galaxias y Asuras y erizos de mar comen\npolvo cósmico y respiran aire o agua. Y el uno y el otro pensarán en\ndistintas e innovadoras teorías ontológicas, pero cada una de ellas es solo\nun paisaje de la mente.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000036",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y con toda certeza, todos estos paisajes registrados, como registrados fueron\nson...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Por alguna razón, Mizuna no siguió leyendo después de esa parte.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="man_kid_000107",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué viene después?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000037",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Aquí tiene.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Mizuna me da el libro.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="man_kid_000108",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Quisiera que lo recitaras tú.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_g02_07",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000038",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No ofrezco tal servicio.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="man_kid_000109",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero si acabas de recitar para mí.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
delay={
vl01={
{"bg",file="ev_com_g02_08",sync=0,face=1,time=400,path=":ev/ev_com_g02/",set="ev_com_g02"},
},
},
text={
vo={
{"vo",file="fem_mzd_000039",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Lo hice porque quería hacerlo. Los poemas son algo maravilloso.\nRecitarlo en voz alta es algo totalmente distinto a recitarlo en la cabeza.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="man_kid_000110",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El sonido le da vida a los poemas.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000040",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Si bien casi imperceptible, la aparentemente inexpresiva Mizuna estaba\nsonriendo un poco.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="04_what_is_mind？_02_2"},
{"text"},
linkback="block_00229",
},
label = {
top={block="block_00000",label=1},
},
}
