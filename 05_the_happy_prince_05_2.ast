astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bgm",file="bgm020"},
{"msgoff"},
{"bg",file="zeveningsky_summer",id=9,lv=9,speed=300000,rule=139,sync=1,vague=40,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se1343",sync=1,id=1},
{"se",file="se3434",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hola? Soy yo.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_knd_000586",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, hola, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acerca de lo de esta noche, ya está decidido el lugar.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_knd_000587",ch="knd"},
},
ja={
{
name={"Kana"},
"“El colegio Yumihari, ¿no? ¿Te espero por el portón?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es imposible entrar por el portón principal en la medianoche. Espérame a\nlas once y media en la estación de Sakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_knd_000588",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es el último tren de la noche.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. ¿Algún problema?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_knd_000589",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues, que una muchacha joven como yo camine sola por la calle podría traer\nproblemas.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ayer en la medianoche viniste al taller de la residencia Natsume, ¿qué tiene de\ndistinto?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_knd_000590",ch="knd"},
},
ja={
{
name={"Kana"},
"“Lo sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_knd_000591",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, será algo fastidioso esperar tan tarde en la estación.\nAlgún policía podría llamarme la atención.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Por más que sea Sakuragahara, sigue siendo el centro comercial de\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_knd_000592",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así que...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Escucho una voz justo detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"A mis espaldas estaba Nagayama.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama... ¿Estabas ya acá?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000593",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, me puse a pensar y me dio algo de pereza, así que...\nvine de una vez.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque aún queda bastante para la medianoche.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000594",ch="knd"},
},
ja={
{
name={"Kana"},
"“No estaría mal pasar el tiempo charlando conmigo de vez en cuando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Charlar contigo? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
vl02={
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000595",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque no lo parezca, soy buena sacándole charla a los demás.\nAh, se me ha ocurrido algo. Bríndame algo de comer, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no tengo problema. Es lo único que puedo hacer para agradecerte.\nAunque no tengo tiempo para charlar contigo.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0012",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000596",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo que reunir pintura de acuarela.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000598",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Reunir pintura de acuarela? ¿El duelo será con un enorme cuadro de acuarela?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si fuese solo por eso no necesitaría tanto. Ahora necesito toda una caja de\nacuarela.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0012",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000599",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Toda una caja? ¿Pero qué tienen en mente?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Usaremos una piscina como lienzo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000600",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Una piscina?!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Ten por seguro que te invitaré a comer, ¿pero podría ser otro día?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000601",ch="knd"},
},
ja={
{
name={"Kana"},
"“Si es por recolectar pintura, dos son mejor que uno.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000602",ch="knd"},
},
ja={
{
name={"Kana"},
"“Si tienes tiempo de hablar ahora, mejor deberíamos irnos ya. Debemos ir\npor la pintura.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="香奈",speed=1000,mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x2=0,x=-680,lv=4,id=9},
{"se",file="se0744s",id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de eso, reunimos toda la pintura de acuarela que encontramos en mi\napartamento y en el taller de la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Nagayama me ayudó con eso.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0001",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpa el abuso.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000603",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, bueno, si es por ver un duelo de genios ha salido barato...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi oponente es un genio, pero yo soy solo uno más del montón.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000604",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ciertamente. Aunque es fascinante ver a una persona normal enfrentarse con un\ngenio, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso si logro dar pelea.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_knd_000605",ch="knd"},
},
ja={
{
name={"Kana"},
"“Claro que podrás. Solo eres un falso mediocre después de todo. Siempre que\nllega el momento muestras una habilidad fuera de este mundo.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espero que sea así.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",time=150,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000606",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, deja la modestia. Tienes la sensación de que podrás lograrlo, por eso\npensaste en proponer un duelo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000607",ch="knd"},
},
ja={
{
name={"Kana"},
"“Si resulta que no es así y estás intentando enfrentarte a un genio sin\nposibilidad alguna de victoria, te ganarás mi furia junto con una deuda de\ntreinta mil yenes.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué debo pagarte en metálico?!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000608",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por las horas que me tendrás contigo. Más o menos eso cobran las enkou, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Consideras esto como enkou?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000609",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eso en caso de que no seas capaz de nada. Si no quieres pagar treinta mil yenes\npon tu mejor esfuerzo para darle una patada a ese genio.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="eveningsky_summer",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"Llegó la medianoche.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Y tal como era previsto, Sui estaba ya por la piscina.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg061d",path=":bg/",sync=0},
{"extrans",time=1000},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000742",ch="sud"},
},
ja={
{
name={"Sui"},
"“Buenas noches, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viniste tal como acordamos.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000743",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues sí, tenía que agradecerte de alguna forma por aquel butadon...\nAunque siendo sincera, a Sui le encantan los duelos y las competiciones.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Y bien, ¿conseguiste tu pintura?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000744",ch="sud"},
},
ja={
{
name={"Sui"},
"“Todo esto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Al lado de Sui habían baldes repletos de pigmento.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Reuniste bastante...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000745",ch="sud"},
},
ja={
{
name={"Sui"},
"“Igualmente tú, Kusanagi-san... Has traído bastante.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Conseguí una caja completa en mi casa, y dos en el taller de la residencia\nNatsume.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tenía que hacerlo, usaremos una piscina como lienzo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",mode=-2},
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0200",face="a0011",head="kan_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000610",pan=70,ch="knd"},
},
ja={
{
name={"Kana"},
"“¿E-Esta niña es el dichoso genio?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Nagayama me pregunta en susurros.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, probablemente.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0013",head="kan_z2a",x=500,lv=5,id=6},
{"fgact",ch="香奈",act="びっくり",lv=5,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="うなづく",lv=5,id=6},
},
vl02={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0008",head="kan_z2a",x=500,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000611",pan=70,ch="knd"},
},
ja={
{
name={"Kana"},
"“¿P-Probablemente? ¿Eh? ¿Es que no tienes prueba certera de eso?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que no tenga.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0006",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000746",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Tachándome de genio a mis espaldas y susurrando?!\n¡Preferiría que apreciaran la belleza de Sui!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, perdona el gesto. Esta es Kana Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000747",ch="sud"},
},
ja={
{
name={"Sui"},
"“No me parece haber visto a esta mujer antes. ¿Eres su asistente?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es la jueza.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000748",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, un arbitro...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que sería necesario, siendo un duelo con pintura.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000749",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo... está bien.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000750",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bueno... ¿Comenzamos ya?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuáles son las reglas?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000751",ch="sud"},
},
ja={
{
name={"Sui"},
"“Las reglas son usar pintura de acuarela, y la piscina como lienzo. Es un vale\ntodo sin más reglas.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que no hay límite en el espacio a tomar como lienzo...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000752",ch="sud"},
},
ja={
{
name={"Sui"},
"“Así es. Puedes pintar en la zona que te parezca, y en cualquier otra también.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0001",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000612",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿No será necesario prohibir también cualquier intento de arruinar la obra del\ncontrincante?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_sud_000753",ch="sud"},
},
ja={
{
name={"Sui"},
"“No es necesario. De igual forma, este cuadro se borrará por completo después de\nculminarse.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, la obra no estará dada solo por el producto final, sino por\nel proceso de inicio a fin.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000754",ch="sud"},
},
ja={
{
name={"Sui"},
"“Un duelo de quién pinta algo más hermoso.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0012",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000613",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya veo, de ser así molestar al contrincante perjudicará a la persona.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente. Intentar arruinar la obra del otro se ve muy mal ante el\nespectador.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bgm",stop=1,time=500},
{"msgoff"},
{"bg",file="nightsky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000755",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Bien, comencemos!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Sui baja al fondo de la piscina.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"La sigo, bajando con mi pintura.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Si no pienso bien en dónde pintar y me muevo rápido, no conseguiré ni donde\npisar.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_sud_000756",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡El tiempo límite son tres horas! ¡A partir de ya!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"cgdel",id=-1},
{"bg",file="ev_com_i05_01",zoom=100,time=200,sync=0,z2=200,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"quake"},
{"quake",mode="mw"},
{"se",file="se_blood",id=1},
{"bgm",file="bgm015"},
{"text"},
text={
ja={
{
"Sui derrama una enorme cantidad de pintura sobre varias cubetas.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Y las mezcla con un cuchillo de paleta para óleo.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Su técnica es similar a la del óleo, pero usando una cubeta en lugar de paleta.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"No hay otra manera de pintar en este duelo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Basta con que la pintura de acuarela se disuelva solo un poco para que corra\nhacia el desagüe.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Por eso es necesario el cuchillo de paleta para retocar la pintura.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Es necesario un impasto más espeso que para una pintura de óleo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Esto requiere de muchísima técnica y análisis.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fgf",frame="frame_ctl",bg="zev_com_i05_01",bz=80,bx=-450,by=-300,rule="106l",time=40,id=5,lv=5,bgpx=":ev/ev_com_i05/"},
{"se",file="se_arrow1",id=10},
{"quake"},
{"ex",time=300,func="wait"},
{"fgf",frame="frame_1p",bg="zev_com_i05_01",bz=80,bx=-450,by=-300,rule=066,time=40,id=7,lv=7,bgpx=":ev/ev_com_i05/"},
{"se",file="se_arrow1",id=11},
{"quake"},
{"ex",time=40,func="wait"},
{"fgf",frame="frame_rts",bg="zev_com_i05_01",bz=80,bx=-450,by=-300,rule=177,time=40,id=8,lv=8,bgpx=":ev/ev_com_i05/"},
{"se",file="se_arrow1",id=12},
{"quake"},
{"ex",time=40,func="wait"},
{"fgf",frame="frame_2p",bg="zev_com_i05_01",bz=80,bx=-450,by=-300,rule=106,time=40,id=9,lv=9,bgpx=":ev/ev_com_i05/"},
{"se",file="se_arrow1",id=13},
{"quake"},
{"text"},
text={
ja={
{
"Y sin embargo, Sui va pintando sin preocuparse por nada de eso.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que no titubea ni por un segundo?...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"La piscina sirve de suelo, y también de lienzo.\nAsí que es necesario calcular detenidamente.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Esta labor es pintura de un solo intento.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"¿Y por qué? Pues una vez no puedas alcanzar el lugar que ya pintaste, no podrás\ncorregir más.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Ese factor es vital al momento de pintar sobre este enorme lienzo.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fgf",frame="frame_ctl",disp="消",mode=-1},
{"fgf",frame="frame_1p",disp="消",mode=-1},
{"fgf",frame="frame_rts",disp="消",mode=-1},
{"fgf",frame="frame_2p",disp="消",mode=-1},
{"bg",file="zev_com_i05_01",x=-960,y=-460,time=300,path=":ev/ev_com_i05/",set="ev_com_i05",ax=1920,ay=1080,bx=-960,by=-540,zoom=100},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Comienzo a trazar el esqueleto de mi obra.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Si coloco primero la línea principal antes de colorear tendré algo de libertad\npara dibujar. Comenzando con las líneas, podré asegurar lugar para caminar.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fgf",frame="frame_1p",bg="zev_com_i05_01",bz=70,bx=-450,by=-300,rule=058,time=200,bgpx=":ev/ev_com_i05/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000757",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Planeas pintar todo el rato con esa lentitud, Kusanagi-san? ¡Frente a este\nenorme lienzo tres horas no son nada!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Sui va pintando aquí y allá sin preocuparse por trazar esqueleto alguno.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Al pintar de esa manera, el más mínimo error podría arruinarlo todo.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Solo dos personas usarían ese método. Un idiota que no sabe pintar, o alguien\nque realmente es un experto dibujando.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"No hace falta decir cuál de los dos Sui es...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fgf",frame="frame_1p",disp="消",time=300,mode=-1},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000614",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Nagayama, quien estaba viendo a Sui trabajar, se había quedado ya atónita.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Lo único que he visto es la parte de la pared de la piscina que pintó al\nprincipio, pero desde donde estoy no puedo ver la ilustración completa.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"¿Qué está pintando?",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvídalo, debo concentrarme en mi propia pintura.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Trazo el esqueleto y comienzo a pintar. Si bien cada segundo cuenta, debo\nconsiderar también el lugar para caminar y el hecho de que debo mover el\nequipo de trabajo alrededor.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"No es algo que pueda hacer sin pensar mucho las cosas.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_knd_000615",ch="knd"},
},
ja={
{
name={"Kana"},
"“K-Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_i05_01",time=300,sync=0,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
"Nagayama señaló la pintura de Sui.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Solo habían pasado unas cuantas decenas de minutos de haber comenzado, y sin\nembargo, Sui estaba expandiendo su pintura a una velocidad increíble.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Cada vez se hace más visible la estructura de su pintura desde mi posición.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué... demonios?...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Pensé que mis ojos me habían fallado.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Pero no.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que... esa pintura... parece tridimensional?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",inter=3,ssize=3,ease="in",sfade=3000,style="raster"},
{"bg",id=1,lv=1,file="white",path=":bg/",sync=0},
{"bg",file="paintingeffect07",zoom=250,alpha=255,speed=240000,id=7,lv=7,path=":cg/paintingeffect/",set="paintingeffect",x2=0,y2=-810,x=-3840,y=810,ax=1920,ay=540,bx=-960,by=0,sync=0},
{"bg",file="paintingeffect03",zoom=200,alpha=170,speed=120000,id=8,lv=8,path=":cg/paintingeffect/",set="paintingeffect",x2=0,y2=0,x=0,y=-540,sync=0},
{"bg",file="paintingeffect05",zoom=200,alpha="128,64",speed=240000,id=9,lv=9,path=":cg/paintingeffect/",set="paintingeffect",x2=-960,y2=0,x=960,y=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Su pintura se veía en tres dimensiones, sí.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Pero cualquiera que conozca del trampantojo sabrá de qué truco se trata.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"Es posible hacerlo invirtiendo el tono de la superficie sobre la cual cae la\nluz y además dibujando de forma que la perspectiva se invierta, al igual que\nla sensación de tridimensionalidad.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"Usando trampantojo es posible usar la concavidad de la pared y el suelo y dar\nla ilusión de que es una figura tridimensional...",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Por ejemplo, toma un papel con zonas cóncavas y convexas, y pinta una cara de\nanimalito sobre este, usando color y perspectiva para invertir las\nconcavidades.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Eso hará que la mirada del animalito te siga, como si estuviera moviéndose,\ndando como resultado semejante rareza.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"Aunque, el problema es que...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Dependiendo de la forma en que lo vieras, ese color pintado de la misma forma\ndesordenada que Gogh daba la ilusión de que la pintura ondulaba.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Y ese movimiento le daba una increíble sensación de dinamismo a la obra.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Aunque si bien usa el trampantojo, solo lo hace para darle dinamismo a la obra.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Gracias al trampantojo, los toscos trazos de Sui formaban una gama de colores\ncon un dinamismo que jamás había visto.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"cgdel",id=-1},
{"colortone",style="raster",ease="out"},
{"bg",file="ev_com_i05_01",time=200,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cómo es posible que... pueda dibujar eso sin un solo error? ¿Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además... Incluso consideró también la luz de la luna en la elaboración...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_knd_000616",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Q-Qué clase de técnica para el dibujo y aptitud para los colores debe tener\nalguien, para poder pintar algo así en un solo intento?!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Nagayama no pudo resistirse a gritar.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Y sin darle mucho atención a eso, la pintura de Sui iba consumiendo poco a poco\nla piscina.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Un enorme lienzo que parecía tragarme.\nUna vibrante gama de colores.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Sentí que me había metido de lleno, literalmente, en el mundo de la pintura.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es su técnica lo que sobresale...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"No lo niego, necesitas un buen nivel de técnica para poder usar las paredes de\nla piscina y crear, de una superficie cóncava, una figura tridimensional.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Pero tanto su técnica para el dibujo como su aptitud para los colores no eran\nmás que herramientas apuntadas a un solo fin.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la habilidad que tiene para meter al espectador de lleno en su mundo de\ncolores...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su expresividad.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Sui va expandiendo el lienzo, sin pararse en ningún momento.\nY a medida que se expande, la diferencia entre realidad y pintura se va\nhaciendo cada vez más ambigua.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es increíble...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg061d",path=":bg/",sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0007",head="kan_z1a",lv=4,id=6,sync=0},
{"extrans",time=300},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000617",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿De verdad tienes tiempo para estar admirando su pintura, Kusanagi-san?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000618",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Ya ha pasado más de una hora!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_i05_01",time=200,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
"¿Me quedé admirando su pintura? ¿Quedé embelesado por el mundo de colores que\nha creado?",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Parece ser trampantojo, pero en realidad es algo distinto. Los colores\nparecieran formar un remolino dentro de la piscina.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Esto es más de lo que imaginaba.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Sin embargo, fue en este momento que entré en cuenta.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Haya pasado lo que haya pasado, la muchacha que tengo frente a mí fue la que el\nviejo había mencionado.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Ella es la bestia de lo estético, con el poder de materializar en sus manos.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Sencillamente, está en otro nivel. No soy oponente para ella.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Los colores van pintando todo alrededor. Había una sensación palpitante en\nellos, como si rebosaran la piscina e intentaran salir hacia el mundo real.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000758",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No te veo moviendo el cuchillo! ¡¿Es que ya te diste por vencido?!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_sud_000759",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Sui seguirá pintando hasta el final! ¡Hasta donde la flecha de la expresión me\nlleve!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-La diferencia en habilidad... es descomunal...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_knd_000619",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿K-Kusanagi-san?!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta sensación, que pareciera tragarme...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_knd_000620",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Te vas a dar por vencido ya?! ¡Apenas ha pasado un tercio del tiempo total!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De esto...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da algo de nostalgia...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_knd_000621",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta sensación de pintar algo con alguien, y ser avasallado...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",rule=191,time=100,file="white",path=":bg/"},
{"se",file="se_leaf2",vol=30,id=1},
{"fg",mode=-2,sync=0},
{"bg",file="zev_com_d02_01",zoom=50,speed=200,z2=60,path=":ev/ev_com_d02/",set="ev_com_d02",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",rule=191,time=100},
{"text"},
text={
ja={
{
"Fue hace tanto tiempo.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Rina Hikawa...",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Ella plasmó la sombra de la muerte sobre aquella pared.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Mientras que yo martillé la vida ahí.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"En aquel momento todavía podía mover mi brazo derecho.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"cgdel",id=-1},
{"bg",time=200,file="white",path=":bg/"},
{"bg",file="ev_com_i05_01",time=200,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
"Ya no.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Algo que pueda hacer con mi mano izquierda.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"¿Qué puedo hacer en este preciso momento?",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"En este remolino de colores.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"No, no se trata de qué pueda hacer.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Se trata de qué voy a hacer, ¿no es así?",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"El talento traiciona a los mediocres; la técnica, jamás.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Qué bien suena eso.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Toda esta habilidad técnica que he acumulado hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"¿De qué me sirve?",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"¿Para crear una pintura que no sea tragada por la suya?",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"No, mi nivel no cae ahí.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bgm",stop=1,time=10000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un remolino de colores... La manera de vencer el avasallador remolino de\ncolores de Sui es...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Colores... colores...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_knd_000622",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qué estás haciendo?! ¡No estás pintando nada!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Colores?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Observo de nuevo la pintura de Sui. Su selección de colores tomaba en cuenta la\nluz de la luna.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Para esta selección tan intrincada de colores, quizá...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",mode=-2},
{"se",file="se3130",id=1},
{"bg",speed=300,sync=0,file="zbg061d",path=":bg/",x2=-340,y2=0,x=-800,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"fg",ch="香奈",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x2=460,x=0,lv=5,id=6},
{"quake"},
{"quake",mode="mw"},
{"bgm",file="bgm034"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama, pásame rápidamente todos los pigmentos.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0013",head="kan_z2a",x=0,lv=5,id=6},
{"fgact",ch="香奈",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000623",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿T-Todos?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, todos!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bg",rule=215,time=200,sync=0,file="black",path=":bg/"},
{"se",file="se9020",id=1},
{"text"},
text={
ja={
{
"Lanzo la cubeta que estaba utilizando de paleta.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_i05_01",rule=215,time=200,sync=0,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este lienzo es enorme... No había necesidad de usar paleta...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_com_i05_02",sync=0,face=1,time=400,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"fgf",frame="frame_sd",bg="zev_com_i05_01",bz=200,bx=-4800,by=-3080,sync=1,bgpx=":ev/ev_com_i05/"},
{"ex",time=0,func="wait"},
{"se",file="se3130",vol=50,id=1},
{"fgf",frame="frame_sd",bg="zev_com_i05_02",bz=200,bx=-4800,by=-3080,sync=1,bgpx=":ev/ev_com_i05/"},
{"text"},
text={
ja={
{
"Tomo directamente varios tubos de pintura en la mano.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Los apunto sobre los lugares que Sui había pintado, y disparo la pintura.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000624",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Estás echando pigmento sobre su cuadro?! ¡K-Kusanagi-san, ¿pretendes\narruinarle su pintura?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera hasta el final, y si te parece que eso hice pues repruébame y ya!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero jamás haría algo tan ridículo como eso!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_sud_000760",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fgf",frame="frame_sd",disp="消",mode=-1},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000761",ch="sud"},
},
ja={
{
name={"Sui"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bg",rule=216,time=100,file="black",path=":bg/"},
{"se",file="se3130",id=1,vol=50},
{"bg",file="znightsky_summer",zoom=60,speed=200,id=9,lv=9,rule=216,time=100,path=":cg/",x2=0,y2=108,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"quake"},
{"text"},
text={
ja={
{
"Sui observa el cielo.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"La luna está oculta entre las nubes.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Era una noche con muy pocas nubes, pero a veces estas ocultaban la luna.\nY cada vez que eso sucedía, la pintura basada en la luz lunar de Sui perdía todo su\ncolor.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Sui se detiene.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Era de esperarse. No podía pintar sin revisar directamente con sus propios\nojos.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Pero en mi caso...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg061d",path=":bg/",sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=6,sync=0},
{"extrans",time=200},
{"text"},
text={
vo={
{"vo",file="fem_knd_000625",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué estás haciendo? Además, la luna se ha ocultado y no se ve casi nada, ¿está\nbien que sigas moviéndote?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema. Para este método es mejor no recurrir a los ojos.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La experiencia y la práctica que he acumulado se encargarán de todo.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_i05_02",time=300,sync=1,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"bg",file="ev_com_i05_03",sync=1,path=":ev/ev_com_i05/",set="ev_com_i05"},
{"text"},
text={
ja={
{
"Esta combinación de colores debería servir.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Sin luz lunar alguna, voy derramando la pintura de los tubos sobre el lienzo.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
