astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"bgm",file="bgm026"},
{"fg",mode=-2,sync=0},
{"bg",file="black",path=":bg/",sync=0},
{"extrans"},
{"text"},
text={
ja={
{
"Aquello era un sueño.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Nada más que un sueño.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"En ninguno de mis recuerdos había algo parecido.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_had_000010",ch="had"},
},
ja={
{
"'Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana'",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"'El sonido de las olas que deja atrás este barco que surca el océano, lenta\npero seguramente, es tan agradable que la noche se nos hace eterna,\nquitándonos el sueño'",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Un sueño tan, pero tan agradable, que terminamos despertando de él.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Cosas así pueden suceder...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"msgoff"},
{"bg",zone="0x000000",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"fg",ch="伯奇",size="z1",mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"En medio de ese aire purificado y santificado,",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"estaba yo sentada ahora, sin moverme ni un poco.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Los sudare frente a mí.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Tras ellos se veía la silueta de alguien acostado. Había dicho que se llamaba\nTokitsuna Nakamura, si no mal recuerdo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Apenas su sueño alcanza el punto del soñar, se le dan comienzo a los cantos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_hss_000003",ch="hss"},
},
ja={
{
name={"Hakuki"},
"“Esta noche, Hakuki, la sacerdotisa de Yumehari, retirará y colocará las\npesadillas de Tokitsuna-sama en este recipiente.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",id=1,file="isuzu"},
{"text"},
text={
ja={
{
"Housou suena una campana.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"El nombre de esa campana es 'Hakuki Kagurasuzu'.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Housou lo usa en la ceremonia del Da -'Da no Gi'- para poder sacar con más\nfacilidad el poder de Hakuki.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Y es, también, el artefacto divino que me une a mí con Housoushi.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_uni_c29_01",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
vo={
{"vo",file="man_hss_000004",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Nakaki yo no...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"La voz del Housoushi trae de vuelta mi levemente alejada consciencia.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Observo silenciosamente al jefe actual de los Nakamura, Tokitsuna, yaciendo\nacostado tras los sudares.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Tal como el canto lo dice――",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Una larga, larga noche, de solo soñar eternamente.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Y mientras más espero por el amanecer――",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Más, sigo――",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Viendo ese sueño, sin fin.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bg",file="ev_uni_c29_02",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"Y entonces, comienza a brotar.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Un translúcido líquido.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_uni_c29_03",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"Sueños translúcidos.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Que van llenando el recipiente.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"A pesar de que el recipiente cabe en mis manos, este se siente tan hondo que\npareciera imposible ver lo que hay al fondo.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",file="ev_uni_c29_04",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"El recipiente se va llenando.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Se va llenando de sueños.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Tras los sudares que tengo frente a mí, al fondo, están los sueños de ese\nhombre.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"No. Su propia alma.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Pongo mis manos sobre el recipiente.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",zone="0x000000",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Y entonces, me lo llevo lentamente a la boca.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="伯奇",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000012",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ngh... *traga*...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Me bebo silenciosamente su contenido.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sueños.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Sueños translúcidos.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Sueños transparentes que llenan hasta el fondo, sin fin alguno.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Me voy hundiendo en esos sueños.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Hacia lo más bajo, hacia lo más profundo.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",inter=3,ssize=2,ease="in",sfade=100000,style="raster"},
{"bg",blur=50,file="bg064c",path=":bg/",sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=092,time=1000},
{"text"},
text={
ja={
{
"Comienzo a ver algo.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sin embargo, ese algo está más a lo hondo.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"La superficie se agita ligeramente.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Y de allí, se escucha un susurro.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"De rencor.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Esa agitación de rencor me susurra.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡LOSODIO!'",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"¿Losodio?",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Probablemente lo que dice el susurro es 'Los odio'.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Me hundo en el fondo de ese oscuro sueño, aún más.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"'Habiendo tenido que preservar el honor de mi padre, no pude conseguir\nreputación para mí mismo en el campo de batalla.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"La voz se escucha claramente ahora.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"'Mi violento carácter como líder ha hecho que mis sirvientes me desprecien, y\nque incluso mi hijo, Yoshisada, esté más apegado a mi hermano menor, Ietsuna,\nque conmigo.'",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"'¿Es que acaso no fuimos mi abuelo, mi padre y yo quienes dimos nuestra sangre\npara reclamar este territorio?'",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"'¿Y aun así osan despreciarme a mí, olvidando todo lo que hice por ellos?'",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡Maldita gente desagradecida!'",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡Malditos sirvientes desagradecidos!'",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡Maldito hijo desagradecido!'",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
delay={
[300]={
{"quake",mode="mw"},
},
[1000]={
{"quake",mode="mw"},
},
},
text={
ja={
{
"'¡Ahh, cómo los odio! ¡Los odio, los aborrezco a todos!'",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡Odio a quien quiera que esté en los cielos! ¡Odio estas tierras! ¡Y odio a la\ngente que deambula por ellas!'",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"'¡Los odio a todos!'",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"El oscurecido fondo comienza a temblar.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"se",file="se9090",vol=30,id=1},
{"bg",rule=088,time=500,sync=1,file="black",path=":bg/"},
{"colortone",style="raster",ease="out"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg073a",path=":bg/",sync=0},
{"extrans",rule=088,time=500},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm003"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000589",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Otra vez ese sueño...",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Es como si fuera la continuación del sueño de ayer...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",mode=-2,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0000",face="d0012",head="rna_z1d",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000441",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Rina? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0001",head="rna_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000590",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000442",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estuviste casi gritando.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000591",ch="rna"},
},
ja={
{
name={"Rina"},
"“No... sabía...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000443",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tuviste alguna pesadilla de terror?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000592",ch="rna"},
},
ja={
{
name={"Rina"},
"“No fue precisamente de terror, pero... no fue un sueño muy placentero que\ndigamos...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000444",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“O-Oye, ¿tiene ese sueño algo que ver con que quisieras ir al Templo Hakuki?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Por alguna razón Yuumi me pregunta eso, como tratando de descubrir algo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000593",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, la verdad es que sí...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Tampoco era nada para ocultar, así que respondí con la verdad.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000445",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué clase de sueño fue? ¿Podrías contarme?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0011",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000594",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno, a fin de cuentas se trata de un sueño. Para ser sincera, me da un poco\nde pena hablar de esto tan seriamente.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000446",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero te preocupa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0010",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0005",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000595",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000447",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te enfrasques tanto en el asunto. Después de todo es solo un sueño, puedes\ncontármelo todo despreocupadamente.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000596",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le conté a Yuumi acerca de los dos sueños que vi entre ayer y hoy.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Era difícil explicarle hasta el más mínimo detalle, pero igualmente procuré\ncontarle tanto como pudiera.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2,sync=0},
{"bg",file="bg073a",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rna_000597",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que todo era en la antigüedad. En alguna época cuando todavía existían los\nsamurái. No sé con exactitud de qué era se trataba, pero habían bastantes\nguerreros pertenecientes a clanes locales, y eso.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000598",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé tampoco dónde ocurrió todo. Trata de un clan de sacerdotisas que llegaron\na la casona de un samurái de algún clan local, huyendo de Kyoto.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000599",ch="rna"},
},
ja={
{
name={"Rina"},
"“El nombre del clan era Housoushi, y entre ellos había una sacerdotisa llamada\nHakuki.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000600",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y al parecer, dentro del sueño, yo soy ella.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000448",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tú... eras Hakuki?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0012",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0005",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000601",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué te asombras tanto?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000449",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no pasa nada.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000602",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes quién es Hakuki, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000450",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, pero bueno, ¿podrías seguir por ahora con la historia?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0012",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000603",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí. ¿Sabes? Esa muchacha, Hakuki, era realmente extraña. No parecía tener\nninguna clase de sentimientos, ningún cambio de ánimo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000604",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una muchacha joven que acabara de huir de Kyoto sentiría normalmente ansiedad,\nmiedo, asombro, o cosas así, pero ella no parecía demostrar nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000605",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa con quién se encuentre o hable, pase lo que pase, no siente nada.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000606",ch="rna"},
},
ja={
{
name={"Rina"},
"“Más que no tener estado de ánimo alguno, parecía... sí, no parecía tener\ncorazón alguno.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000451",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No tenía corazón?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000607",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, así parecía.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000452",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una sacerdotisa sin corazón...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000453",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se supone que esa muchacha Hakuki era una sacerdotisa, ¿no? ¿De qué forma leía\nlos corazones de los demás?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000608",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo hacía por medio de un ritual bastante extraño. Uno del cual jamás había oído\nantes.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",zone="0x000000",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rna_000609",ch="rna"},
},
ja={
{
name={"Rina"},
"“La muchacha se sentaba al lado de la cama de la persona a la cual leería, pero\napartada por sudares.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_rna_000610",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y entonces, esperaba hasta el instante en que esa persona cayera en su sueño\nmás profundo.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rna_000611",ch="rna"},
},
ja={
{
name={"Rina"},
"“En la habitación más al fondo estaba uno de los miembros de mayor poder del\nclan de Housou, leyendo algo que parecía ser un conjuro. Apenas la muchacha\nempezaba a escuchar un poco de esa voz, esta se volvía capaz de ver los\nsueños de la persona que dormía ante ella...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rna_000612",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero al principio solo había algo que parecía una sombra, y no se podía\ndistinguir mucho...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_000613",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y entonces, del recipiente vacío que estaba colocado al lado de la persona\ndormida se escuchó algo que parecía agua.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_uni_c29_01",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"bg",file="ev_uni_c29_02",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"bg",file="ev_uni_c29_03",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"bg",file="ev_uni_c29_04",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000614",ch="rna"},
},
ja={
{
name={"Rina"},
"“Del recipiente vació comenzó a borbotear un líquido, completamente\ntransparente, y con bastante fuerza...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rna_000615",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y ese líquido, eran sueños. Los sueños de la persona que dormía frente a\nella...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rna_000616",ch="rna"},
},
ja={
{
name={"Rina"},
"“La muchacha podía convertir los sueños de los demás en una hermosa agua,\ncompletamente translúcida.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rna_000617",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esta fue llenando el recipiente de agua.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rna_000618",ch="rna"},
},
ja={
{
name={"Rina"},
"“De sueños.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",zone="0x000000",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rna_000619",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y luego, tomó el recipiente en sus manos.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_000620",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puso el borde del recipiente repleto de sueños cerca de su boca.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fgact",ch="伯奇",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000621",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y se tragó lo que había adentro, poco a poco.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg073a",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_000454",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los sueños de la otra persona?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000622",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, pero, más que sueños, era el propio corazón de esa persona. Beberse los\nsueños de alguien es casi lo mismo a tomar el corazón de esa persona dentro\nde uno mismo...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000455",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, bueno, dicen que los sueños son parte de la psicología profunda de las\npersonas...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000623",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, se sintió como si incluso los rincones más profundos de ese corazón entrara\nen ella.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000624",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se sintió como si me hundiera en lo más profundo de ese océano, del alma de esa\npersona... Y a pesar de tratarse de algo tan espantoso, esa muchacha no\nsentía nada.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000625",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás, por no tener corazón, o por tenerlo vacío, es que puede recibir los\nsueños de los demás, creo yo.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000456",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eras Hakuki en el sueño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000626",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo era.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000457",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No apareció un muchacho algo interesado en ella?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0012",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0011",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000627",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí, apareció. A, ver, ¿cómo es que se llamaba?...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0008",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000628",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que era Yoshisada, o algo así.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000458",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000629",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede con eso?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000459",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no pasa nada. En fin, ya entendí de qué va todo el asunto.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000460",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dentro de ese sueño estabas en el papel de esa muchacha, de Hakuki. Y en\nYumihari está el Templo Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000461",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es por eso que te llamó la atención, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0001",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000630",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno, fue exactamente así.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000462",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se sintió demasiado real como para ser un sueño cualquiera, es normal que te\ncausara curiosidad, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000631",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero los sueños son solo eso, sueños...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000463",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, pensaba en que podríamos ir al Templo Hakuki en la mañana, pero entre\ntanto hablar del sueño no parece quedar mucho tiempo para eso ahora.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000632",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, tienes razón. Con la hora que es no podremos estar mucho tiempo allá.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000464",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Salgamos rápido del club hoy y vayamos.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000633",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, es lo mejor.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000465",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Preparemos todo y vayamos al colegio.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000634",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Comenzamos a preparar todo para salir.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_07_1"},
{"text"},
linkback="block_00142",
},
label = {
top={block="block_00000",label=1},
},
}
