astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",time=2000,file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"msgoff"},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",x=-345,lv=4,id=5,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004173",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Entonces? ¿Nos contarás?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, supongo que no tengo mucha opción.\nEn fin, vean esto...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Les muestro el folio de documentos que me traje de la casa.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0012",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004174",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parte de la herencia de Kenichiro Kusanagi. Los planos de diseño de 'Las\nhuellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004175",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que estaban en tu posesión.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Si bien abandoné la herencia, me regresaron esto con la excusa de que fui\nyo quien completó la obra.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0003",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_004176",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Heeeh. ¿Y bien, y bien?\n¿Qué gran pista se encuentra escondida entre estos documentos?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acá hay varios diseños que Kenichiro Kusanagi propuso y descartó previo al\ndiseño final.Con casi ocho veces la cantidad de hojas...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004177",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Increíble... Supongo que ni el mismísimo Kenichiro Kusanagi podría haber dado\ntan fácilmente con ese diseño.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, eh, sí, supongo que sí. Parecieran haber trazos indicando que se la pensó\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004178",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué titubeas?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada. En fin, tengo en mis manos una buena cantidad de diseños\ndescartados.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0012",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004179",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estás pensando... en alguno de esos diseños?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por algo fueron descartados. Si bien se ven buenos, todos tienen algún tipo de\nproblema.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004180",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo suponía. ¿Qué piensas hacer entonces?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay uno de esos diseños que me llamó la atención. Este...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0006",head="mak_z1f",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004181",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A ver.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=345,lv=4,id=6},
{"fgact",ch="桜子",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skr_000351",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Cuál es?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"msgoff"},
{"bg",y=-275,zone="0x000000",file="zbg013e",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="奈津子",size="z2",mode=3,resize=1,path=":fg/nat/z2/",file="nat_z2a0200",face="a0001",head="nat_z2a",x=-630,lv=5,id=3,sync=0},
{"fg",ch="ルリヲ",size="z2",mode=3,resize=1,path=":fg/rur/z2/",file="rur_z2c0200",face="c0002",head="rur_z2c",lv=5,id=9,sync=0},
{"fg",ch="鈴菜",size="z2",mode=3,resize=1,path=":fg/suz/z2/",file="suz_z2c0200",face="c0002",head="suz_z2c",x=630,lv=5,id=4,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"fgact",ch="ルリヲ",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000137",ch="rld"},
},
ja={
{
name={"???"},
"“Qué curioso, oh sí.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="鈴菜",act="うなづく",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000095",ch="snd"},
},
ja={
{
name={"???"},
"“Este diseño luce realmente complicado.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fgact",ch="奈津子",act="おじぎ",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000064",ch="ntd"},
},
ja={
{
name={"???"},
"“Heeeh, así que este es diseño de Kenichiro Kusanagi-san... Tanto padre como\nhijo tienen la letra similar.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"cgdel",lv=5,id=5,rule="cinema",time=400},
{"msgoff"},
{"bg",zone="0x000000",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="ルリヲ",size="z1",mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=9,sync=0},
{"fg",ch="鈴菜",size="z1",mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"ex",time=300,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=9,sync=0},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_skr_000352",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Ruriwo-chan, Suzuna-chan, Natsuko-chan?!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hacen aquí?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000138",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Solo vinimos a comprar pintura. Escuchamos unos gritos viniendo de la parte\ntrasera de la tienda, los vi haciendo algo y me puse a espiarlos de lejos.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0008",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000096",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Espiar no es la forma adecuada de describirlo. Simplemente no sabíamos cuándo\nsalir.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000065",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“La discusión parecía estar muy enardecida...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y tú, Natsuko-kun?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0008",head="nat_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000066",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Yo solo pasaba cerca. Creo que cualquiera se detendría de ver a alguien\ndiscutiendo en este lugar tan concurrido.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... Qué pena...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="奈津子",mode=-1,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La culpa la tiene Toritani por intentar estrangularme.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0006",head="mak_z1f",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004182",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso te pasa por insistir en hacerte el tonto.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004183",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Estas tres también son alumnas de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Ruriwo y Suzuna ingresarán el año que viene, pero aún no lo son.Quizá no lo\nrecuerdes, pero son las hermanitas de Hikawa y Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0012",head="mak_z1f",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004184",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Las hermanitas de Rina y Yuumi? C-Cómo han crecido.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000139",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, yo soy Ruriwo Hikawa. He escuchado mucho de usted, Toritani-senpai.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x=570,lv=4,id=4},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000097",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Mi nombre es Suzuna Kawachino. Agradezco la amistad que le ofreció a mi hermana\ndurante su estancia en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=9},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esta que está aquí sí es alumna del colegio, Natsuko Kuriyama.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=0,lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000067",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Es un gusto conocerle, me llamo Natsuko Kuriyama.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",x=-570,lv=4,id=3},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004185",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues lo veo rodeado de muy BUENAS estudiantes, profesor Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene esa extrañamente maliciosa sonrisa?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0016",head="mak_z1f",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004186",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Yo? Nada en particulaaar...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="奈津子",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0002",head="mak_z1f",x=-570,lv=4,id=3},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000140",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Y bien, 'qué piensas hacer? ¿Cómo harás para modificar esa pintura?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000098",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Así es. Hay que contraatacar de alguna manera...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera un momento! ¡Chicas, ¿de dónde viene toda esa avidez?!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0004",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000141",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Eh~, mi hermana y todos los demás se esforzaron para pintar ese mural. ¿De\nverdad crees que nos quedaremos sin hacer nada ahora que lo han rayado?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0005",head="rur_z1c",lv=4,id=9},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",x=570,lv=4,id=4},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000099",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Yuumi onee-sama siempre me hablaba de ese mural. No vamos a quedarnos calladas\ndespués de lo que han hecho.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿cómo es que están enteradas del graffiti de la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000100",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Nosotras? Toda la ciudad ha estado hablando de eso.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000142",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“La fama del mural es tal que aparece incluso en los panfletos de la ciudad,\ntodos saben lo que sucedió. De ahí que han circulado rumores del graffiti.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_ntd_000068",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No sé qué tanto se habla en la ciudad, pero han circulado muchos rumores en el\ncolegio. Nadie sabe qué pasó exactamente, pero están enterados de que fue\nrayado el mural. El cual ahora está cubierto con lona...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0017",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000143",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es, así es. Intenté levantar la lona para ver el graffiti, pero me pilló un\nviejo extraño. Fue todo un lío.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era obvio que te iba a suceder eso. Y no es ningún viejo extraño, seguramente\nera el guardia de seguridad.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",lv=4,id=9},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004187",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no está nada bien...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0006",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_004188",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tenía la idea de que el colegio revelaría la obra en unos días, pero si ya han\ncirculado rumores por la ciudad, entonces... es muy posible que los medios se\nmuevan mañana.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000101",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ciertamente. El mural tiene fama en la ciudad por ser obra de Kenichiro\nKusanagi. Será difícil ocultar por mucho tiempo lo que ha sucedido.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000144",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Y? Van a borrar el graffiti, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_skr_000353",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Según Toritani-san y el profesor, no se puede hacer.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000145",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Por qué? ¿Qué van a hacer entonces si no se puede remover?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0004",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000102",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Pregunta la misma persona que fue descubierta apenas intentando levantar la\ncubierta de lona?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",lv=4,id=9},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0011",head="mak_z1f",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_004189",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Según escuché, acercarse a la obra ahora es imposible.Probablemente\nestén alertas ante Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué yo?...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004190",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Acaso no llegaste a tener desencuentros hace unos años con la Nagayama-san de\nBourbagi?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? Ninguno...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004191",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé qué pensarás tú, pero Nagayama-san te tiene el ojo puesto. Y Thomas\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Thomas? Absurdo. ¿El cabeza hueca ese?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0011",head="mak_z1f",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004192",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Él tiene sus razones también, aunque no lo creas.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=-570,lv=4,id=3},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000146",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Qué haremos entonces? No podemos acercarnos a la obra, y además no queda casi\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0005",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000147",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Que no hay problema? Problemas es lo único que hay ahora.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si logro ejecutar el plan que tengo en mente, podré modificar la obra sin\nnecesidad de acercarme a ella.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000103",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Modificar la obra sin acercarse a ella? ¿Es eso posible?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque no hay garantía absoluta de que funcione. Es el tipo de obra que\nnormalmente requiere mucha experimentación...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000104",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Experimentación?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Aunque según mis cálculos, debería funcionar como obra.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_skr_000354",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Eso de funcionar como obra suena algo extraño...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu, demonios, ¿por qué tuvo que suceder todo esto?...\nEn fin, con mi plan no debería haber peligro de ser arrestados o expulsados del colegio...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=9},
{"fg",ch="鈴菜",mode=-1,lv=4,id=4},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x2=-570,x=0,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004193",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Podrías explicarme de qué se trata?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque en caso de contarte deberás ayudarme.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",x=0,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004194",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Haré lo que pueda.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me basta con eso.\nDespués de todo ya no somos estudiantes.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",x=0,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004195",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Agradezco la comprensión.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es el trabajo indicado para ti.\n¿Conoces al consejero Inoue del hospital general de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",x=0,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004196",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El consejero Inoue del hospital general de Yumihari? Nunca he hablado con\nél...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees poder negociar algo con él?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",x=0,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0004",head="mak_z1f",x=0,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_004197",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Negociar? Las negociaciones no son mi fuerte.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiera encargarte las negociaciones a ti.Le convencerá mucho más una editora\nde revista de arte que un profesor a tiempo parcial como yo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0003",head="mak_z1f",x=0,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0004",head="mak_z1f",x=0,lv=4,id=3},
{"fgact",ch="真琴",act="うんうん",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_004198",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Convencer? A ver, a ver, ¿qué planeas?\nSuena divertido, me estás emocionando.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",mode=-2},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=-680,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-210,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000355",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Q-Qué podemos hacer nosotras?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000148",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así nos digas que nada hay por hacer, Ruriwo y Suzuna algo harán. Lo sabes.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0010",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="いいえ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000105",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No soy tan imprudente como tú.Aunque no creo ser capaz de aguantar sin hacer\nnada ante tal humillación.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-680,lv=4,id=1},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000069",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Si hay algo en lo que podamos ayudarle...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si las negociaciones salen bien, las necesitaré a todas ustedes.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, el margen de error de esta obra es mínimo, ni un solo milímetro de\nerror es admisible.\nSerá una labor intensamente delicada.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="ジャンプ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000149",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Déjamelo a mí! Soy buena en eso.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0004",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000106",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Eso es mentira. En lo que a tareas delicadas concierne, yo soy mucho mejor que\nRuriwo-san.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",x=-210,lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-210,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000356",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Yo también. No tengo tanta sensibilidad artística, pero sí soy hábil con cosas\nmeticulosas.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0011",head="nat_z1a",x=-680,lv=4,id=1},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000070",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿Y qué debemos hacer?\n¿Es posible modificar esa obra sin acercarnos a la pared de la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004199",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí o no? ¿Tienes seguridad de que funcione?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No podría decir sí o no con seguridad.\nPero algo me dice que funcionará.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es posible, creo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque necesitare la ayuda de todas ustedes.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y créanme que será una labor dura.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=-210,lv=4,id=7},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000150",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Dura?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_snd_000107",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Por qué dura?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque requiere muchísima práctica antes de ir con la obra real.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0016",head="suz_z1c",x=210,lv=4,id=8},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",x=-680,lv=4,id=1},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0007",head="nat_z1a",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000108",ch="snd"},
{"vo",file="fem_rld_000151",ch="rld"},
{"vo",file="fem_ntd_000071",ch="ntd"},
{"vo",file="fem_skr_000357",ch="skr"},
},
ja={
{
name={"Todas"},
"“¿Muchísima práctica?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se9026",id=1},
{"text"},
text={
ja={
{
"Suena un teléfono celular.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"se",stop=1,id=1,time=500},
{"se",file="se3434",id=2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Atiendo de inmediato la llamada.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",rule=139,vague=40,file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004200",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te tengo buenas y malas noticias. ¿Cuál quieres escuchar primero?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La que sea, no me importa. ¿Qué ha pasado?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004201",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Comencemos por las malas entonces.\nEnciende el televisor.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El televisor?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Enciendo el televisor.\nTras la pantalla se veía el colegio Yumihari, y la iglesia cubierta en lona.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya los medios están reportándolo?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004202",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te dije hoy que el colegio no era impenetrable, y así fue. Parece que\nalguien filtró la noticia a los medios.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004203",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“He revisado varios canales, y parece que el tema del graffiti ha causado\nbastante conmoción. La noticia se está cubriendo por todos lados.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece, otros canales lo están mostrando también.Lo cual quiere decir que\nel colegio se verá obligado a presentar la obra pronto.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004204",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Respecto a eso, al parecer el colegio está arreglando todo para presentarla lo\nmás pronto posible.\nQuizá mañana, si todo les sale bien.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mañana, eh... Me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004205",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, mañana convocarán a los equipos de prensa para presentar la obra de\nBourbagi.Según, se armaría un barullo si llegan a aplazar la presentación.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"msgoff"},
{"bg",file="znightsky_spring",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente son malas noticias.\nY bien, ¿cuáles son las buenas?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004206",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El consejero Inoue nos dio el visto bueno. Dijo que el hospital nos ofrecería\nsu completo apoyo.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? ¿Y qué hay con eso del completo apoyo?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004207",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El consejero Inoue no estaba nada alegre de que el consejero Murayama le\nllevara la delantera. Quiere quedar mejor que él ante los medios.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004208_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no hay manera de conseguir esos vitrales para mañana.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004209",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No hay problema? Fabricar un vitral en una noche es comparable a lo que hizo\nHideyoshi Toyotomi y su castillo construido de la noche a la mañana.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí se puede. Para eso compré todos los materiales necesarios en la ferretería.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004210",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En la ferretería... De verdad, ¿qué estás pensando fabricar?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Reviviré la herencia de Kenichiro Kusanagi. Es lo único que tengo por decir.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004211",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lamentablemente no podré ayudarte esta vez con la fabricación.\nTengo mucho por hacer de aquí a las próximas horas.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.\nYa somos adultos, cada quien tiene responsabilidades y posiciones que mantener.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso de hacerlo todo a lo loco como hacíamos siendo estudiantes no funciona más.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, ya me ayudaste con algo que solo un adulto podría hacer.\nConvencer al consejero Inoue.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con eso me basta y sobra.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004212",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004213",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No voy a disculparme...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegaras a hacerlo me enfadaría.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Convertirse en artista no es la única forma de vivir en el arte.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida lo de arte, como palabra es muy ambigua. La odio.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Expresar algo no se reduce simplemente a crear una obra. Y es que las obras no\naparecen de la nada.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dar con el significado y la motivación de una obra es tan importante como su\ncreación en sí.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que dedícate a tu trabajo sin reserva alguna. Este trabajo me pertenece a\nmí.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004214",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jejeje... Tan honrado como siempre.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso tú y los demás también lo son.\nHasta Kana Nagayama lo es.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004215",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004216",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues te deseo lo mejor. Tengo fe de que producirás otro milagro.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No habrá ningún milagro. Habrán acciones, con las cuales produciré resultados.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004217",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje, está bien. Adiós.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se3434"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno... ¿Estamos listos ya?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-680,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-210,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"bgm",file="bgm020"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000152",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Sí, mi capitán.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_snd_000109",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Practicamos bastante. Me siento confiada de que podré hacer una labor precisa.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0017",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000153",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Cinco horas no fueron en vano. Ruriwo está algo cansada.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000072",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“El margen de error es casi cero.\nUsted dijo eso, y creo que ahora he entendido muy bien lo que significa.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0010",head="sku_z1a",x=-210,lv=4,id=7},
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000358",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Sakizaki-kun se traga sus palabras y comienza a temblar.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entraste en pánico? Si es así――”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",x=-210,lv=4,id=7},
{"fgact",ch="桜子",act="ジャンプ",lv=4,id=7},
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うんうん",time=300,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000359",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Por supuesto que no! ¡Estoy muy, muy feliz en este momento!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",x=-210,lv=4,id=7},
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うんうん",time=300,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000360b",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Es la primera, la primera vez que siento esto desde que dejé el atletismo...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000361b",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Estoy emocionada, pero también llena de mucha expectativa.Es justamente lo\nmismo que sentía siempre antes de correr...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000154",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Tiene razón. Esto no se experimenta solo pintando cuadros.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_snd_000110",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ahora que lo menciona, esto es similar a esas horas previas a una competición\natlética.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=-680,lv=4,id=1},
{"fgact",ch="奈津子",act="うんうん",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-680,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_ntd_000073",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ajaja, nunca me he adentrado en ese mundo... ¿De verdad se siente así?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fgact",ch="桜子",act="うなづく",time=300,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000362",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Se parece mucho... Esa sensación, el miedo del posible fracaso...\nPero por encima de eso, una gran sensación de expectativa...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0010",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000111",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, es misterioso.Debería tener miedo de fracasar ahora, pero la expectativa de\nencarar con la obra es más grande.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0014",head="rur_z1c",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000155",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... pronto lo descubrirán...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="鈴菜",mode=-1,lv=4,id=2},
{"fg",ch="ルリヲ",mode=-1,lv=4,id=8},
{"fg",ch="奈津子",mode=-1,lv=4,id=1},
{"fg",ch="桜子",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x2=-210,x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000363",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, creo que ya lo descubrimos.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000364",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“La victoria puede venir de manera misteriosa. La derrota jamás.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000156",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, he escuchado esas palabras antes. ¿Quién había dicho eso?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_snd_000112",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿No fue un manager de béisbol?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, la fuente original fue un espadachín de la era Edo.\nAunque hoy en día se usa con frecuencia en los deportes.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0010",head="sku_z1a",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000365",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“A mi parecer todo se decide antes de competir.\nQuizá sea difícil ganar, pero para no perder se requiere mucha planificación...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0010",head="rur_z1c",x=-570,lv=4,id=3},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rld_000157",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Sí, y vaya que practicamos bastante. Pero, a final de cuentas ninguna de\nnosotras estuvo involucrada en el desarrollo del plan original.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000366",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“De ahí que resalta nuestra confianza por Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, ¿cuántas veces tengo que decir que el plan lo saqué de uno de los\ndiseños fallidos de Kenichiro?Si sientes confianza es porque estás en manos\nde un artista de fama internacional.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rld_000158",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pero Ruriwo no conoce mucho a Kenichiro-san.\nPor mi parte tengo más confianza en ti que en Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000367",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Yo también.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",x=570,lv=4,id=4},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000113",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Dios mío, vaya palabras que se gastan ante tal gran artista... Es increíble.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000159",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Tú no?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000114",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Yo no confío en personas que no he conocido.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=-570,lv=4,id=3},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000160",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Kusanagi-chan entonces? Qué poco honesta usted, pequeña Suzuna.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0010",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000115",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No es cuestión de honestidad o no. Es lógica.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="桜子",mode=-1,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-570,lv=4,id=3},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",lv=4,id=1},
{"fgact",ch="奈津子",act="うんうん",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000074",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Jaja...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué te ríes ahora, Kuriyama-kun?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000075",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No es nada, solo que realmente todas lo quieren mucho, profesor.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A esto le llamas ser querido?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000116",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Bueno, ya no queda más tiempo. ¿Podríamos parar con la charla ya?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=-570,lv=4,id=3},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000161",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Sí, creo que ya es hora de entrar a fondo con esto.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x2=-570,x=-680,lv=4,id=3},
{"fg",ch="奈津子",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x2=0,x=-210,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=210,lv=4,id=8},
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x2=570,x=680,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_skr_000368",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Entre tantas horas de práctica descubrimos que nuestra labor no tomará tanto\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0011",head="nat_z1a",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000076",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Pero requerirá mucha precisión y delicadeza.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",x=680,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000117",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Y cooperación.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=210,lv=4,id=8},
{"fgact",ch="桜子",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_skr_000369",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Practicando lo hicimos bien.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-680,lv=4,id=3},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000162",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pues entonces la obra real también nos saldrá bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fufufu...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-680,lv=4,id=3},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-210,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=4},
{"text"},
text={
ja={
{
"Después de reírme, todas se me quedan viendo.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se pongan muy nerviosas.\nDisfrutemos de esta noche.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La diversión también se puede percibir en la obra. ¿Verdad, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0003",head="sku_z1a",x=210,lv=4,id=8},
{"fgact",ch="桜子",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_skr_000370",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso se trata. Ya practicamos una y otra vez.\nLo logramos varias veces, sin error alguno.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo queda aplicar lo practicado en la obra real.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-680,lv=4,id=3},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=-210,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0003",head="sku_z1a",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x=680,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=3},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=1},
{"fgact",ch="桜子",act="うなづく",lv=4,id=8},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000118",ch="snd"},
{"vo",file="fem_rld_000163",ch="rld"},
{"vo",file="fem_skr_000371",ch="skr"},
{"vo",file="fem_ntd_000077",ch="ntd"},
},
ja={
{
name={"Todas"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"msgoff"},
{"bg",file="nightsky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Hora de ejecutar el plan...",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"¿Hace cuántos años fue que diseñé esto?...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
