astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",rule=139,vague=40,file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_rld_000051",ch="rld"},
},
ja={
{
name={"???"},
"“¿Howa? Pero si es Kusanagi-chan, holis~”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Escucho una animada voz llamándome. Al voltear, me encuentro con una muchacha\nvestida con uniforme de otro colegio.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"se",file="se9004",id=1},
{"bgm",file="bgm009"},
{"fg",ch="ルリヲ",size="z1",time=500,sync=1,mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, la hermanita de Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Ella es Ruriwo Hikawa, la hermana menor de Rina Hikawa.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0013",head="rur_z1c",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0017",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000052",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“No soy la hermanita de Hikawa, soy Ruriwo. ¿Cuándo piensas aprenderte eso~?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón. Ya Hikawa no está, creo que de ahora en adelante te llamaré\nHikawa a ti.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0011",head="rur_z1c",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0019",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000053",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Qué tonterías son esas? Ruriwo está bien, no importa. Sencillamente no hay más\nopción~”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Tiene razón, llamarla por su primer nombre lo resolvería todo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0011",head="rur_z1c",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000054",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Y bien, ¿qué haces por acá, Kusanagi-chan~? ¿Comprando golosinas~? ¿No está mal\ncomo profesor que compres golosinas saliendo del colegio~?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como profesor no hay problema, vamos. No soy estudiante además.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0005",head="rur_z1c",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000055",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Entonces sí estás comprando golosinas? Invítame a comer, ¿sí~?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero. Además, está prohibido que los alumnos coman golosinas en la calle.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000056",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vamos, eso no importa~ Ruriwo te comprará algo la próxima vez, así que bríndame,\n¿sí?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podrías prestar atención a lo que estoy diciéndote?",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿a dónde piensas ir después de la secundaria? Tienes los exámenes este\naño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000057",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Ah, esooo? Yo ya aprobé el examen de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hablas en serio? ¿Tú en Yumihari el año que viene?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000058",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es, el próximo año seré tu alumna, así que te llamaré profesor. Qué bien\npor ti, sí.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene nada de bueno eso.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000059",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿No? Pues te llamaré Kusanagi-chan en el colegio también.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni te atrevas.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000060",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Bueno, bueno, ¿y por fin me invitarás a comer?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que no me escuchas? No tengo ganas de brindarte nada.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0017",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000061",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Qué frío tú. ¿Quieres que Ruriwo te brinde entonces?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0013",head="rur_z1c",lv=4,id=9},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rld_000062",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Uwah, qué rápido en contestar. Está bien, pero cómprame algo la próxima,\nKusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno... está bien, siempre y cuando sea después de que me depositen...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000063",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Tan pobre estás? Muy mal, muy mal eso, todo un hombrecito y no tienes\nplanificación alguna de tus finanzas.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sucede que mi salario está por el piso. Y bien, ¿qué vamos a comer?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000037",ch="snd"},
},
ja={
{
name={"???"},
"“Comprar golosinas saliendo del colegio está prohibido.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",file="se9004",id=1},
{"fg",ch="鈴菜",size="z1",mx=40,mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",lv=4,id=9},
{"text"},
text={
ja={
{
"Volteo a ver y me topo con una muchacha vestida con el mismo uniforme que\nRuriwo.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, esto...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0011",head="suz_z1c",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",lv=4,id=9},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000038",ch="snd"},
},
ja={
{
name={"???"},
"“¿Podría aprenderse mi nombre de una buena vez? Kawachino, Suzuna Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",lv=4,id=9},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0013",head="suz_z1c",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000039",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Cielo santo, usted es profesor de Yumihari, Kusanagi-sama. ¿Podría dejar de\nincitar a alumnas saliendo del colegio a comprar golosinas?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdón...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Suzuna Kawachino. La conozco también desde hace tiempo. Su forma de hablar y\nactitud es completamente opuesta a la de Yuumi Kawachino.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0013",head="suz_z1c",x2=0,x=345,lv=4,id=9},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000064",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“No hay nada de qué disculparse, nada. Suzuna es una niña consentida, no hay por\nqué prestarle atención a lo que dice.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0011",head="suz_z1c",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000040",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Que sea una niña consentida o no nada tiene que ver.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0013",head="rur_z1c",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=-345,lv=4,id=5},
},
vl02={
{"fgact",ch="ルリヲ",act="うんうん",time=300,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000065",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“A eso le llaman ser niña consentida. La gente necesita sentir y experimentar.\nEl destino, una vida un encuentro, ¿has escuchado de eso? ¿Por qué no ir por\nun té con Kusanagi-chan de vez en cuando?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0015",head="suz_z1c",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000041",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Destino? ¿Una vida un encuentro?... Escucha--”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000066",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vamos, Suzuna, tú tampoco has hablado con Kusanagi-chan desde hace un buen\ntiempo, ¿a que no~?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=345,lv=4,id=9},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000042",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ohhh, ahora que lo mencionas, creo que llevo tiempo sin hablar con\nKusanagi-sama.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0019",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000067",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Verdad que sí? Desde que onee-chan se fue a Tokio no hemos podido hablar con\nél. ¿No es eso triste?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0010",head="suz_z1c",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000043",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, bastante pudimos hablar cuando Yuumi onee-sama todavía estaba, pero no\npuedo negar que estamos distanciados ahora.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000068",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es, así es. Además, tú también aprobaste el examen de Yumihari. Deja ahora\nque el profesor nos invite a algo para celebrar.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿A final de cuentas tengo que pagar yo?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0013",head="rur_z1c",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うんうん",time=300,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000069",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Deberíamos pagar nosotras entonces? ¿No es eso patético, profesor?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",x=345,lv=4,id=9},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000044",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Fiuu, no queda de otra. Está bien, ¿vamos por té entonces? Hay además un buen\nlocal de taiyaki cerca.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="icon",x=130,y=-400,lv=4,id=5,icon="icon03z1"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000070",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Taiyaki~, a Ruriwo le encanta. Sobre todo el que tiene anko en la colita~, son\ndeliciosos~”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=345,lv=4,id=9},
{"fgact",ch="鈴菜",act="いいえ",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000045",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“A mí no me gustan cuando tienen anko en la cola también. Se debe disfrutar el\nbalance entre la masa y el anko.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000071",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿En serio? Eh~, bueno, qué importa. Todo taiyaki es delicioso, sí~ Bueno,\n¿vamos~?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_snd_000046",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, vayamos...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Esto es divertido.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Las hermanitas de Rina Hikawa y Yuumi Kawachino son completamente distintas en\npersonalidad y en su relación, pero se llevan tan bien como lo hacen sus\nhermanas mayores.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_j03_01",path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000072",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Está muy bueno esto, y crujiente. Qué rico.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_rld_000073",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Además que al final terminaste brindándonos, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto, no iba a dejar que me brindaras tú a mí.\nTaiyaki para dos personas, eso no le hace ni cosquillas a mi billetera.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Por supuesto que es mentira.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_j03_02",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_snd_000047",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Y cómo ha estado usted, profesor?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_j03_03",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿tú también llamándome profesor?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_snd_000048",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Por supuesto, y es que a partir del próximo mes seré alumna del colegio\nYumihari. Y quisiera hacerle notar que mi nombre no es 'tú', es Suzuna.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya, lo siento, lo siento. Oye, qué bueno está este taiyaki. Llevaba tiempo sin\ndeleitar mi paladar con un dulce.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_j03_04",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_snd_000049",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Me alegra saber eso. Qué bueno, qué bueno.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Suzuna muestra una gran sonrisa.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Suzuna es amable, tanto que ni pareciera ser la hermana de Yuumi Kawachino.\nSu forma de hablar es delicada además... Siempre es cariñosa conmigo.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_j03_05",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000074",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Kusanagi-chan, te recuerdo que eres profesor. Si sigues viendo a Suzuna con esa\ncara, te arrestarán por crimen sexual~”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_j03_06",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No la veo de eso forma... Demonios.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_j03_02",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000075",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿De verdad? Pues, a Ruriwo no le molestaría que la vieras así.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Búscate a otra persona!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_j03_07",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000076",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“No has cambiado nada, Kusanagi-chan. Aun teniendo una chica tan linda\ndiciéndote eso, eres tan frío respondiendo. Es increíble.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo interés alguno en una chica que se define a sí misma como muy linda.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_j03_08",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000077",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pues sí~, eres profesor ya, un adulto.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y ya casi con los pies en la calle. No tengo intención alguna de meterme en\nsemejante relación con una alumna.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_j03_09",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000078",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Con los pies en la calle?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_snd_000050",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿A qué se refiere? Kusanagi-sama, ¿renunciará a su puesto de profesor?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Renunciar no, me harán renunciar. Y es una posibilidad, todavía no se ha\ndecidido.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rld_000079",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Una posibilidad? ¿Es que metiste la pata en algo?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No metí la pata, pero a veces te despiden justamente por no haberla metido.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rld_000080",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ya veo, uwaaah, qué mundo tan cruel. Aunque dicen que es importante moverse, y\ndeberías mostrarle a los de arriba lo importante que eres, profesor~”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_skr_000172",ch="skr"},
},
ja={
{
name={"???"},
"“¿No le parece inadecuado estar tragando golosinas en este lugar con otras\nestudiantes?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_j03_07",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm016"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000173",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Qué está haciendo? Si los otros profesores llegan a verlo, se meterá en\nproblemas.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000174",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Taiyaki?... Dicen que este local es famoso.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="桜子",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x2=0,x=-570,lv=4,id=9},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0001",head="rur_z1c",x=100,lv=4,id=10},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=500,lv=4,id=6},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000081",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Qué pasa, qué pasa? ¿Usted es alumna de Yumihari? ¿Senpai de nosotras, quizá?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000175",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Soy Sakurako Sakizaki, colegio Yumihari, segundo año.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=500,lv=4,id=6},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000051",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Es un gusto, me llamo Suzuna Kawachino. A partir del próximo año comenzaré a\nasistir al colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=100,lv=4,id=10},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000082",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Holi~, yo soy Ruriwo. Espero nos llevemos bien, senpai~”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=100,lv=4,id=10},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",x=-570,lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",x=-570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000176",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Fuh, así que todavía no han ingresado... Y usted, comiendo golosinas con estas\nmuchachas. Qué agallas tiene.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, escucha... ehm...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013",head="sku_z1b",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000177",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Tanto quiere usted que lo despidan?...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=100,lv=4,id=10},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000083",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Espere, espere, el profesor no tiene la culpa. Fuimos nosotras quienes lo\nobligamos a venir~”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-570,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0008",head="suz_z1c",x=500,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_snd_000052",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Nuestras hermanas y el profesor pertenecieron al club de arte en Yumihari, el\nmismo donde estuvo Rin Misakura. Aunque he escuchado que ya no existe dicho\nclub...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=500,lv=4,id=6},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",x=-570,lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",x=-570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000178",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿El profesor estuvo en el mismo club que Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Sakizaki-kun me lanza una muy feroz mirada.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"¿Y cómo no? Apenas ayer me hice el tonto cuando preguntó por Rin Misakura. Y\nahora se ha enterado que pertenecimos al mismo club...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013",head="sku_z1b",x=-570,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000179",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Está bien. Mantendré mi boca cerrada al respecto.\nAunque, ¿les molestaría si me uno un rato a la conversación?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=100,lv=4,id=10},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_rld_000084",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Para nada, con todo gusto. Venga venga, siéntese, senpai.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000180",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, yo también iré por un taiyaki, dame un segundo...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"se",file="se9004",id=1},
{"bg",file="ev_com_j03_06",path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
ja={
{
"Sakizaki-kun se aleja.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rld_000085",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Hoh~, pero qué senpai tan chula. ¿Quién es? ¿Tu novia, profesor~?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no... Es alumna, una alumna que siempre está preguntándome\ncosas.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_j03_01",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000086",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pwah, tan popular con las chicas como siempre, Kusanagi-chan. Vamos, ¿qué tiene\nde malo estar rodeado de tantas hermosuras? Me das envidia.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De popular no tengo nada. ¿Y qué tendría de bueno para ti estar rodeada de\nchicas lindas?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rld_000087",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Mucho, considerando que me encantan. Además, nunca te cansas de ver a una, no\nseñor.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Solo escucharla decir eso me recuerda a la vieja Kawachino...\nAunque tratándose de Ruriwo, es probable que simplemente le agraden las\nchicas lindas y ya...",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_j03_08",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_snd_000053",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, ciertamente. Es difícil cansarse de ver a una muchacha hermosa. Aunque no\na los extremos que alcanzó mi hermana...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_j03_09",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000088",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, cierto, tu hermana es lesbiana, ¿verdad? Estaba enamorada de Rina\nonee-chan~”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_snd_000054",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Estaba no, todavía lo está, ¿no? Aunque no sé cómo estará la relación entre\nambas ahora en Tokio...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rld_000089",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿En serio? ¿Es que Rina onee-chan está saliendo con ella? ¿Se casarán entonces?\n¡Genial!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_snd_000055",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Estás acelerando las cosas. Ni siquiera sé si están saliendo o no, aunque\nparece que sí viven juntas.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rld_000090",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Vaya, no sabía!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_snd_000056",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿En serio? Me sorprende que no lo sepas, Ruriwo-san.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rld_000091",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Onee-chan nunca habla de sí misma, por eso no sabía. ¡Aunque si las dos están\nen una relación, tienen todo mi apoyo!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_snd_000057",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Y por qué el apoyo, Ruriwo-san?...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_j03_06",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000092",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Porque desde pequeña he observado el amor de Yuumi-san por onee-chan. El amor\nes genial, ¿no crees? Ruriwo siempre apoyará a toda niña enamorada, sí.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_snd_000058",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Nunca he logrado comprenderte por completo, Ruriwo-san...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rld_000093",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Sí? ¿Qué tiene de malo una persona empeñada en algo? Sea amor, estudios,\ndeportes, me muero por personas así.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_j03_10",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_snd_000059",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ya veo. Pues en mi caso, me preocuparía mucho que mi hermana se casara con\nalguien del mismo sexo...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rld_000094",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Si es tanta la preocupación puedes hablar conmigo, quizá salga alguna buena\nidea.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_snd_000060",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Qué tanto me podría ayudar alguien que apoya esa relación?...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_skr_000181",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Regresé, disculpen la espera.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Sakizaki-kun llegó a mitad de la conversación entre las otras dos.Apenas se\nsentó, puso sus ojos sobre mí y abrió su boca.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"se",file="se9010",id=1},
{"bg",file="ev_com_j03_12",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000182",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y bien, ¿podría hablarme de ese club de arte que existió hace unos años?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Directo al grano. Tiene toda la apariencia de estar realmente enojada.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rld_000095",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Kusanagi-chan, ¿de nuevo ocultando el pasado del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_skr_000183",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿De nuevo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_snd_000061",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Al parecer otros estudiantes interesados por el club han consultado con\nKusanagi-sama, aunque este siempre lo oculta con alguna mentira.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tampoco es que llegué al extremo de mentir. Eh... pasa que, me he olvidado\nde él, y...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_j03_13",sync=0,face=1,time=400,path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000096",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Absurdo, vaya que no eres honesto contigo, muchachón. ¿Por qué tanto empeño en\nocultarlo?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije, no intento ocultarlo... Es que...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_snd_000062",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Entiendo que quizá represente una parte muy importante de su vida, pero no me\nparece bien intentar ocultarlo con mentiras.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_skr_000184",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Le pasó algo a usted con el club?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Varias cosas...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Después de examinarme con cuidado, Sakizaki-kun puso una expresión de ligera\nangustia.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_skr_000185",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No estoy forzándolo a hablar. Supongo que habrán cosas que no querrá contarle a\nlos demás...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_rld_000097",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ahí está, Sakizaki-senpai es considerada contigo. No vengas a hacerte el tonto\ncon más mentiras, debes ser honesto con ella.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm... Pues, para comenzar, mi padre――”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"msgoff"},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Le cuento a Sakizaki-kun de mi pasado.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"De mi padre, el famoso artista.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"De cómo llegué a irrumpir un poco en el mundo artístico gracias a su fama.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Acerca de mi amiga de la infancia, Rin Misakura, y nuestro reencuentro.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"De aquella muchacha que a todo le ponía empeño, Makoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"De mi amable y cariñosa kouhai, Rina Hikawa.\nY la terrorífica Yuumi Kawachino.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"De aquel hombre, del cual nadie sabía qué demonios tenía en la cabeza, Wataru\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Del tipo más extraño y sin sentido que he visto, Thomas Takizawa.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"De los cerezos de verano que pinté con ellos.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"De la herencia de Kenichiro Kusanagi que terminamos entre todos.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Y――",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"cgdel",id=-1},
{"bg",file="ev_com_j03_14",path=":ev/ev_com_j03/",set="ev_com_j03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así ocurrió todo...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_skr_000186",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué Misakura-san decidió de un día a otro viajar al exterior?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, habrá tenido sus circunstancias, supongo.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_skr_000187",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Vaya, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bgm",stop=1,time=2000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sakizaki-kun no preguntó más.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"¿Que por qué Rin se fue al exterior?",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Obviamente la muerte de Kei influyó en eso.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Pero no me pude motivar a hablarle, ni siquiera mencionarle a Kei Natsume.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"De cómo fue mi rival, y del estúpido sueño que compartíamos.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Y de que probablemente Rin está intentado seguir ese sueño.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"No tuve el valor de contarle nada de eso.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"msgoff"},
{"bg",file="eveningsky_winter",time=1000,id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_winter",time=1000,id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Solo ahora en la residencia Natsume, me preparo un ramen instantáneo.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"cgdel",id=-1},
{"bg",file="bg003c",path=":bg/"},
{"text"},
text={
ja={
{
"Y pensar que hace tiempo cocinaba buenos platillos para mí solo...",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Una vez que preparas comida para alguien, pierdes la motivación de cocinar para\nti mismo.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Al terminar de hervir el ramen en la cocina, me lo llevo todavía en su olla a la\nsala y me siento.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"*Shrp, shrp, shrp*... *shh*",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Comiendo directamente de la olla, enciendo el televisor.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"*Shhhrrr*...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Se escuchan risas del televisor.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"El comediante actúa como un comediante debe actuar, y la comunicación con su\npúblico se establece al producirse las risas.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Cambio de canal, pero todos muestran lo mismo.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Risas, y más risas.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Todo se siente frío, frívolo.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alegro de no haber estado de estudiante con la generación actual de\nYumihari...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, supongo que somos iguales después de todo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"A pesar de que ahora sea profesor y no estudiante en el colegio Yumihari, no\npodré librarme de ese ambiente mientras siga ahí.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Se supone que yo también debo cumplir mi papel en mi posición como profesor.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque si estoy en peligro de despido ahora es porque no pude representar bien\nmi papel...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"*Shhshhshh*... *shh*",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"se",file="se9026",id=1},
{"text"},
text={
ja={
{
"Suena mi teléfono celular.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Qué raro. Por lo general mi celular casi nunca suena.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién será?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Veo el número.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"No recuerdo haberlo visto antes.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",stop=1,id=1,time=500},
{"se",id=2,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, habla Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_wkd_000135",ch="wkd"},
},
ja={
{
name={"???"},
"“Oh~, Naoya. Tiempo sin escucharte la voz, eh.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Usted...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_wkd_000136",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Tal cual, tu profesor Wakata. ¿Me recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vienes a llamar ahora? ¿Qué quieres?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_wkd_000137",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Nada, nada, solo que recordé que no te di mi nuevo número, y me apresuré en\nllamarte ahora.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué diablos? ¿Cuántos años crees que han pasado desde que cambiaste de\nnúmero?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_wkd_000138",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, ciertamente. Y bien, ¿cómo has estado?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como siempre, no ha cambiado nada por acá.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_wkd_000139",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿En serio? Ya por este año te deberían promover a tiempo completo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al contrario, estoy en riesgo de que me despidan.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="man_wkd_000140",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Demonios, de verdad? ¿Qué hiciste?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es al revés, no he hecho nada.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="man_wkd_000141",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ah~, ya veo. Pocos resultados, eh.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ¿pero cómo esperan que un profesor de artes contribuya en algo?...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="man_wkd_000142",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Podrías aumentarles el porcentaje de admitidos a universidades de arte, ¿no? En\nmi caso te ayudé a ti y a muchos más a entrar a instituciones de arte, y por\neso me contrataron oficialmente.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú no me ayudaste en nada, idiota. Además, yo fallé mi primer intento del\nexamen de ingreso.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="man_wkd_000143",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Eso fue lo que pasó?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_wkd_000144",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Oye, ¿todavía sigue la coordinadora del tercer año? La vieja esa.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Esa nostálgica voz me alegró.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Después de tantos años, me sentí con los ánimos algo elevados.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Agotamos todas las quejas que teníamos de nuestros respectivos trabajos.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Wakata estuvo también en el colegio Yumihari, así que mis quejas son similares\na las que tuvo él entonces.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"La conversación se animó bastante.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"msgoff"},
{"bg",file="znightsky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="man_wkd_000145",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por cierto...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Wakata susurró eso, como si hubiese recordado algo.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="man_wkd_000146",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Tienes el licor que te di hace tiempo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Licor? Ah, ese que me diste. El de producción nacional, barrica única.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="man_wkd_000147",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Te lo tomaste?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="man_wkd_000148",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Te lo tomaste todo?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, todavía queda un poco...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="man_wkd_000149",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Todavía te queda un poco, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo un poco...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="man_wkd_000150",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Te lo has ido bebiendo poco a poco?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso. Solo lo abrí una vez y me bebí una buena cantidad ese día...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde entonces no se me ha ocurrido de ninguna forma abrirlo de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_wkd_000151",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No se te ha ocurrido abrirlo... eh.\nYa veo...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="man_wkd_000152",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Felicidad, eh. ¿Cómo podría saber uno que se es feliz en determinado instante?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_wkd_000153",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Imagínate que compras un licor especial, terriblemente caro.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="man_wkd_000154",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿No es normal pensar en abrirlo solo en un día especial?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, y el whisky se conserva bien. Es el indicado para eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_wkd_000155",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Qué podría ser un día especial?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ni idea. ¿Matrimonio, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="man_wkd_000156",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pues en esos casos hay champaña en la ceremonia, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro... Ehm, pues entonces, ¿un aniversario?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="man_wkd_000157",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Tienes un aniversario cada año, no tiene mucho de especial lo mismo cada año,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo dices, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_wkd_000158",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“El día más especial de nuestras vidas, ¿cuál podría ser?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en tu caso, cuando te promovieron a empleado formal, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="man_wkd_000159",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“En esos momentos siempre terminas celebrando con otros, bebiendo en locales.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí... Sé de lo que hablas.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="man_wkd_000160",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Basta con ir a un local de esos que solo vas a celebrar y ordenar algo que no\nsea Happoshu. Siempre terminamos haciendo eso.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Tiene razón. Nadie se va a casa a beber de su colección exclusiva cuando hay\nalgo para celebrar. Siempre terminamos bebiendo afuera.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="man_wkd_000161",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Un momento especial, ¿cuál podría ser?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿no serían entonces aquellos momentos en que no bebes Happoshu afuera?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="man_wkd_000162",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Tal vez tengas razón, pero veas como lo veas, nunca llegamos a abrir ese licor\nespecial.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Tiene lógica.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Saco el licor que Wakata me dio del armario.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, el día que lo recibí ya estaba abierto, y era claro que\nalguien había ya bebido un poco.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un día especial, eh... Con todo lo que me has dicho, ya no sé...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="man_wkd_000163",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Un día especial, un día feliz, un momento de felicidad... Son tan difíciles de\nconseguir como lo es abrir ese licor especial.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="man_wkd_000164",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Es después que te das cuenta que ese día, que ese momento, ese instante, fuiste\nfeliz...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que entiendo lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y para ti cuál fue ese momento, Wakata?”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="man_wkd_000165",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Mi instante de felicidad? Digamos que ahora soy feliz en todo momento. Soy\nprofesor contratado formalmente, y además me conseguí una novia.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conseguiste novia?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="man_wkd_000166",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, una oficinista. Siento la felicidad cada vez que me prepara la comida.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvidaba que no sabías cocinar...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_wkd_000167",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí. Y ahora todos los días tengo comida casera, Happoshu, y en mis días libres,\ncerveza. De lo mejor, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debo admitir que me das envidia. ¡Aunque puedes irte a la mierda si me llamaste\nsolo para alardear de eso!”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="man_wkd_000168",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, hay un poco de eso. Estoy pensando en casarme con ella.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? No olvides invitarme a la ceremonia.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="man_wkd_000169",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Te llamé en parte por eso.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... ¿Te le has propuesto ya?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="man_wkd_000170",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¡Podrás no creerme, pero todavía no lo he hecho!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Todavía no?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="man_wkd_000171",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¡Es que no tengo idea de cuándo decirlo! Además, no sé qué debería decir en el\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No basta con un 'casate conmigo'?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="man_wkd_000172",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero es que quiero decir algo que realmente le llegue al corazón.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que idiotez, yo qué sé. Aunque me alegro por tu felicidad.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="man_wkd_000173",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Gracias, eh.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Momentos de felicidad.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Días de regocijo.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Muchos luchan por obtenerlos, pero dar con ellos es difícil.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Y es algo impresionante poder afirmar que estás feliz en todo momento, así como\nWakata lo hizo.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="man_wkd_000174",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No vayas a dejar ese licor para el día de tu muerte. No vale la excusa de\nque no sabes si eres feliz o no.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco voy a dejarlo sin tocar por tanto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="man_wkd_000175",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No te confíes. La señora que vivía por mi casa y se murió hace poco tenía un\nOld Parr de cincuenta años escondido.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="man_wkd_000176",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Probablemente le costó caro cuando lo compro, así que debe haber sido su licor\npredilecto. Seguramente lo tenía para abrirlo en esos momentos especiales.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="man_wkd_000177",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Así de difícil es abrir el licor en esos momentos. Porque es difícil saber si\nalgo es especial o no.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que la señora nunca abrió el licor.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="man_wkd_000178",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí. Y no está mal celebrar si has tenido una vida feliz, pero no es un licor\nque puedas beber en grandes cantidades. Mucho cuidado.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="man_wkd_000179",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Un trago es suficiente para celebrar, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Está bien.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"cgdel",id=-1},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="man_wkd_000180",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ah, se me va a acabar al batería. ¡Este es mi número, no olvides registrarlo!”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="man_wkd_000181",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Hablamos otro día.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Cuídese mucho, profesor Wakata.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="man_wkd_000182",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Todavía no estoy tan viejo, diablos.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, cierto. Pues bien, estamos en contacto.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un día especial, eh...”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Inclino la botella, todavía con algo de líquido ámbar adentro.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"¿Qué sabor tendrá ese licor especial al beber el último día de nuestras\nvidas?...",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_03_1"},
{"text"},
linkback="block_00300",
},
label = {
top={block="block_00000",label=1},
},
}
