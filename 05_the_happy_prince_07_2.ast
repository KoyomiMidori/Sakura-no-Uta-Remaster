astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"La exhibición de cuadros había comenzado ya.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Cada uno de los cuadros son presentados uno por uno junto a un resumen\nintroductorio.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Según el reglamento, el autor correspondiente debía subir al escenario al\nexhibirse su cuadro. El primero era Shouzou Sakamoto, sin embargo se\nencontraba fumando y la presentación se realizó sin él.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Seguramente sabía que era el primero, así que probablemente fue a fumar para\nevitar tener que pasar al escenario.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"De hecho, él mismo no parecía muy dispuesto a ir...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"En ese sentido, quizá yo también debí haber huído.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Fue entonces que llegó mi turno.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"El personal me guió hasta el hombro del escenario.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Definitivamente no logro acostumbrarme a estos eventos...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"En el ensayo nos explicaron todo el proceso, pero de igual forma...Normalmente\nlas presentaciones de las exposiciones no se realizan en un escenario.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Seguramente así se siente esperar para tocar en un concierto de música clásica.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Y mientras pensaba en eso, alguien del personal me dio la señal para salir.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_msk_000001",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Tendremos ahora al nominado más joven en la historia de esta exposición, el\nseñor Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Tras la señal, salgo del hombro y paso al escenario.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Las luces de los reflectores se mueven para apuntarme.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Esta presentación... se me hace penosa.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Se supone que el escenario se oscurece para no mostrar la obra sino hasta el\núltimo momento, pero... esto es mucho más vergonzoso que los propios ensayos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_msk_000002",ch="msk"},
},
ja={
{
name={"Presentador"},
"“El señor Kusanagi todavía no――”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"El presentador explica que de niño pinté 'Fantasía de un día de cerezos',\nseguido por un breve silencio y la aclaración de que esta es mi primera obra\ndespués de un paréntesis de seis años.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No sé si fue por consideración, pero nadie mencionó que mi padre era Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Y la verdad, prefiero no escuchar más las mismas palabras de siempre, así que\nagradezco el gesto.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_msk_000003",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Vayamos entonces con la próxima obra. 'Soñando con mariposas', por Naoya\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"se",file="se9044",vol=30,id=1},
{"text"},
text={
ja={
{
"Paso al escenario.\nSe escuchan aplausos.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Las luces se concentran sobre mí.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Y al mismo tiempo se muestra en la pantalla del escenario mi obra.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"se",stop=1,time=1000,id=1},
{"msgoff"},
{"bg",zoom=64,speed=35000,ease="easeout_sine",time=2000,id=7,lv=7,file="zev_uni_c60_01",path=":ev/ev_uni_c60/",set="ev_uni_c60",x2=-268,y2=-151,x=268,y=-151,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=1000,func="wait"},
{"msgon",time=1000},
{"text"},
text={
ja={
{
"En ese instante, el teatro quedó en silencio.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Al igual que el escenario.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Incluso los presentadores se quedaron sin palabras.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",zoom=64,speed=30000,ease="easeout_sine",time=1000,sync=0,id=8,lv=8,file="zev_uni_c60_01",path=":ev/ev_uni_c60/",set="ev_uni_c60",x2=268,y2=-151,x=268,y=151,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Nada mal.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Este silencio es aquel de alguien cuyo corazón ha sido cautivado...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",zoom=64,speed=35000,ease="easeout_sine",time=1000,sync=0,id=9,lv=9,file="zev_uni_c60_01",path=":ev/ev_uni_c60/",set="ev_uni_c60",x2=268,y2=151,x=-268,y=151,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Ni una sola muestra de desconcierto entre los espectadores.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Para eso fue hecha esta obra.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bg",time=3000,file="ev_uni_c60_01",path=":ev/ev_uni_c60/",set="ev_uni_c60"},
{"ex",time=3000,func="wait"},
{"bgm",file="bgm022"},
{"text"},
text={
vo={
{"vo",file="man_msk_000004",ch="msk"},
},
ja={
{
name={"Presentador"},
"“E-Es una obra realmente impactante, sí... Quedé cautivado por un momento, y...\nolvidé seguir con la presentación, ajaja...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La risa del presentador despertó a los espectadores del trance.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Se escucharon risas venir de varios asientos.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Probablemente muchos se sintieron igual que él.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_msk_000005",ch="msk"},
},
ja={
{
name={"Presentador"},
"“E-Esto... veamos. Una multitud de mariposas está cruzando el mar, ¿cierto?\nGuau, realmente es un enorme enjambre... El impacto es increíble.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_msk_000006",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Pero lo que más nos sorprendió fue el remolino mareal que se ven al frente. Da\nla ilusión al espectador de ser tragado por él, y hace un contraste muy\ncaracterístico con las mariposas volando...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_msk_000007",ch="msk"},
},
ja={
{
name={"Presentador"},
"“El mar tiene un tinte muy claro, translúcido... Eso inspira aún más miedo del\nremolino...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_msk_000008",ch="msk"},
},
ja={
{
name={"Presentador"},
"“¿Usaste algún tipo de mariposa como modelo en el cuadro?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tomé la parantica sita, especie que tiene la costumbre de cruzar el mar.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A la parantica sita se le conocé también como la 'mariposa viajera'. En verano\nmigra al norte, mientras que en otoño al sur.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se dice que es la única mariposa capaz de cruzar fronteras.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_msk_000009",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Pero es increíble, sí. Ah, disculpen, es lo único que he estado diciendo. Esto\nno está nada bien como presentador...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_msk_000010",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Quiero decir... Este ilusorio enjambre de mariposas, y el remolino... No soy\nquien para decir esto, pero me traen a la mente la muerte.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_msk_000011",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Las mariposas no están siendo tragadas por el remolino, pero... ¿Cómo podría\ndescribirlo?... No lo están, pero parecieran estar a punto de serlo...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Pinté el cuadro metódicamente para despertar esos sentimientos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Hermosas mariposas recubriendo el cielo, y un remolino acentuado por un\ntranslúcido mar.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Parecen fenómenos de mundos distintos, pero al plasmarlos juntos en un mismo\nmundo le despierta una fuerte sensación de que algo no está bien al\nespectador.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Esa sensación despierta angustia, pero la angustia es diluída gracias a las\nhermosas mariposas pintadas al fondo.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Conscientemente despierta belleza, inconscientemente miedo.\nEsta obra está calculada para darle esa sensación de confusión al espectador.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"'Sakura Nanasouzu' usa un cadáver para representar la muerte.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Pero 'Sueño con mariposas' representa esa muerte al evitar pintar cualquier\nelemento relacionado a ella.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Por supuesto, no estoy completamente seguro de que realmente logré transmitir\nlo que quería.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Pero a juzgar por esta reacción,no cabe duda de que logré despertar algo\nparecido.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_msk_000012",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Esta sensación... Es difícil de describir.\n¿Es esto Nihonga?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tomé el estilo Nihonga para esta obra.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Hay una famosa obra del pintor japonés Gyoushu Hayami.Esta se llama 'Enbu'\n(Danza de las llamas)",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"La obra describe a unas polillas muy cercanas a una fogata.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Se dice que Gyoushu Hayami prendió una fogata todas las noches para retratar a\nlas polillas que se agrupaban a su alrededor.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Para la llama empleó las típicas llamas bermellón de las pinturas budistas.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Eso en conjunto con las polillas revolando en el aire.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Es una combinación muy enigmática.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Usé esa belleza y la describí de la manera inversa.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Sin usar el estilo caricaturizado del budismo, recurriendo más bien a una\nexpresión realista, pero con mar y remolinos al estilo Nihonga (muy parecido\na Togyuu Okumura, sí)",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Además, en lugar de usar polillas empleé a un hermoso enjambre de mariposas.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Esta obra ha superado todas aquellas que he pintado hasta ahora. Tanto en\nestructura, como presentación y técnica.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_msk_000013",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Una clásica, pura pintura japonesa, ciertamente. Todas tus obras han sido de\npop-art, o estilo moderno, así que me sorprendí un poco.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_msk_000014",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Pero para haber pintado semejante cuadro japonés debes haber tenido un gran\nmaestro del Nihonga, supongo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, el único que me ha enseñado es mi padre, Kenichiro Kusanagi. Todo lo demás\nlo he aprendido por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_msk_000015",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Claro, el maestro Kenichiro Kusanagi también llegó a pintar Nihonga. Aunque es\nimpresionante que hayas pintado un cuadro así con tu edad.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Después de eso prosiguieron los presentadores, aunque no tuve que explicar nada\nmás.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Vuelvo a ver mi cuadro.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"No está nada mal.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"No, más bien diría que es un buen cuadro.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Podría incluso llamarle mi más grande obra hasta el momento.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Así que――",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"¡Aquí tienes, Kei! ¡Pinté!",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"¡Pinté el mejor cuadro que pude!",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"¿Con qué vendrás tú?",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Al regresar a mi asiento, por alguna razón el hombre a mi lado me hizo una\nllave de cabeza.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_skm_000037",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¡Hombre, vaya semejante cuadro que has pintado, diablooos!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No hace falta la llave, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_mrt_000042",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Fufufu, pues creo que Kusanagi-kun podría acabar venciéndote, Sakamoto.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="man_skm_000038",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“No, eso jamás. Yo, yo soy genial, diablos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pues podría parar entonces con la llave, por favor?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_skm_000039",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¡Mierdaaaa!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_mrt_000043",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Un poco muy tradicional, tal vez... Pero bueno, es una excelente obra que usó\neso a su favor.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_mrt_000044",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Kenichiro Kusanagi también pasó repentinamente del arte moderno a las técnicas\ndel arte tradicional y pintó 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_mrt_000045",ch="mrt"},
},
ja={
{
name={"Murata"},
"“¿Tendrán eso en la sangre?...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_msk_000016",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Excelente, pues ahora presentaremos la última obra. Pintada por... el señor Kei\nNatsume.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Finalmente llegó el turno del cuadro de Kei.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Por fin podré ver el cuadro resultante de su arduo trabajo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"¡Pues veamos qué pintaste, Kei!",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Eso me dije a mí mismo en mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="man_msk_000017",ch="msk"},
},
ja={
{
name={"Presentador"},
"“'Girasoles', se titula.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="zev_uni_c61_01",zoom=70,speed=70000,time=2000,path=":ev/ev_uni_c61/",set="ev_uni_c61",x2=384,y2=130,x=190,y=130,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=3000,func="wait"},
{"msgon",time=1000},
{"text"},
text={
ja={
{
"Las luces se apagan, y sale a relucir un cuadro.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"A su lado no está el autor.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Solo un cuadro, reluciendo en medio del escenario.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_skm_000040",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Nuh...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_mrt_000046",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Ohhh...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Era un simple cuadro de dos girasoles.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"La temática de los girasoles en sí es muy común.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Pero los girasoles sobre el escenario eran completamente distintos a los que\nhabia visto hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_uni_c61_01",time=2000,path=":ev/ev_uni_c61/",set="ev_uni_c61"},
{"msgon",time=1000},
{"text"},
text={
ja={
{
"Dos girasoles.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Solo eran dos girasoles... y aun así, había algo absolutamente convincente en\nellos.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La fortaleza de este cuadro es...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"¿Su peculiar amarillo?",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"No, eso no es amarillo. ¿Rojo?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Solo son dos girasoles detenidos tranquilamente en el espacio.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Pero dejan una fuerte impresión, como si intentaran acercarse.Algo ardiente,\nenloquecedor...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Parecieran bambolearse, pero también parecen inmoviles. Parecen suaves al\ntacto, pero también filosos como el acero. Es como si goteara sangre, pero\ntambién como un instante congelado...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Daba una fuerte impresión de contraste entre inversos, antagónico incluso con\nla pantalla.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Le daba tensión a todo aquel que la viera.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"¿Qué clase de técnica usó para dar esa ilusión?",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"No, si es por eso no cabe duda alguna de que mi cuadro 'Soñando con mariposas'\nes superior en estructura, presentación y técnica.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Y no es cuestión de técnica.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Simplemente, su cuadro era extraordinario.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Maldita sea...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Estaba apretando mis manos. Tan fuerte que podría brotar sangre...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Pero nunca dejé de sonreír.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Una sensación tan indescriptible como su cuadro me envuelve.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Sabía que la obra de Kei sería impresionante.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Pero no me imaginé que tal obra llegaría a cautivar mi corazón de semejante\nmanera.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="man_skm_000041",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿Quién es ese Kei Natsume?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_mrt_000047",ch="mrt"},
},
ja={
{
name={"Murata"},
"“No tengo idea. Quizá el as bajo la manga de alguna facción por ahí. Es\nimposible que alguien capaz de pintar algo así sea un desconocido.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="man_skm_000042",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Y si no era suficiente, el autor no está acá...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_mrt_000048",ch="mrt"},
},
ja={
{
name={"Murata"},
"“¿Cómo lo ves, Sakamoto?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_skm_000043",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“... Uhnnn, es un cuadro algo complicado. Quizá solo parezca un simple dibujo\npara los inexpertos.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_mrt_000049",ch="mrt"},
},
ja={
{
name={"Murata"},
"“¿Crees eso?... A mí me parece que el hecho de que seamos artistas nos hace ver\nde manera complicada el cuadro...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="man_skm_000044",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_mrt_000050",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Mira al público.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="man_skm_000045",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿Al público?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"El público estaba en silencio.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Todos estaban embelesados con el cuadro de Kei.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_mrt_000051",ch="mrt"},
},
ja={
{
name={"Murata"},
"“El público se agitaría si fuese un cuadro difícil.Se escucharía barullo.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_mrt_000052",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Pero esta tranquilidad... Es signo de que están cautivados por el cuadro.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_skm_000046",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_mrt_000053",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Toda autoridad intentó aplastar a los impresionistas cuando surgieron.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_mrt_000054",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Aún se encuentran composiciones del enfrentamiento entre el Salón de París y el\nimpresionismo.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_skm_000047",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿Te refieres a la enorme cantidad de obras impresionistas que terminaron en\nEstados Unidos?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_mrt_000055",ch="mrt"},
},
ja={
{
name={"Murata"},
"“No, es más bien la pregunta del porqué hay un museo de Louvre y un museo de\nOrsay en Francia.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_mrt_000056",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Los cuadros del impresionismo que se enfrentó con el Salón están en el museo de\nOrsay, y no en el de Louvre.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_skm_000048",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“En principio fue en el Jeu de Paume. Pero sí, entiendo lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_mrt_000057",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Fueron nada más ni nada menos que los mismos ciudadanos de París quienes\napoyaron al impresionismo.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_skm_000049",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Quizá parezca una corriente dificil de entender hoy en día, pero para el\nparisino de entonces era mucho más sencilla de entender y de conectar que\ncualquier otro arte.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_mrt_000058",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Sí, aunque también por la influencia del japonismo en el impresionismo... De\nlos ukiyoe y eso.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_skm_000050",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Pues sí, los ukiyoe eran arte popular...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_mrt_000059",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_skm_000051",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Veo que le das muy buena apreciación al cuadro del tal Natsume, ¿no, Murata?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_mrt_000060",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Intuitivamente, sí. La intuición es importante en todo momento.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_skm_000052",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Como cuadro, pienso que el de Kusanagi junior es mejor.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="man_mrt_000061",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Sí, bueno, eso diría un artista. Aunque me pregunto como juzgará Moore ese\ncuadro a final de cuentas.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_skm_000053",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Espera, espera un momento, no voy a aceptar que ese cuadro supere al mío.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_mrt_000062",ch="mrt"},
},
ja={
{
name={"Murata"},
"“¿Ya dándote por vencido?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_skm_000054",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Me sentía como si alguien me hubiese chupado el alma.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Nada en su cuadro era superior al mío.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"En todos los elementos, mi cuadro era mejor al suyo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Pero una obra no se forma de solo eso.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"¿Fue su aplicación de los colores? ¿Sus trazos? No, ¿fue esa peculiar\ncomposición?",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Por más que lo analizara no lograba comprenderlo.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Y si bien no logro entender, el cuadro de Kei cautivaba a la gente.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Aún mientras el presentador hablaba el teatro estaba en silencio.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"No cabe duda. El cuadro que más cautivo hoy al público fue el de Kei.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Y sin que nadie se alarmara por mi trance, la Exposición Moore prosiguió.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bgm",stop=1,time=3000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"¿Qué tanto tiempo habrá pasado?",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Al volver en mí, ya la ceremonia de premiación había comenzado.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="fem_wsk_000001",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Bien, comencemos con el honorable Airain Phoque, con el cual se galardonará\na...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_msk_000018",ch="msk"},
},
ja={
{
name={"Presentador"},
"“El maestro del pop-art y ganador de varios premios internacionales, el señor\nKiyohiko Murata.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"se",file="se2893r",id=2},
{"flash",time=500,alpha=150,loop=2,color="ffffff"},
{"text"},
text={
ja={
{
"Se dan fuertes aplausos.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Kiyohiko Murata sube al escenario.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"No sé si es que le notificaron previamente, pero estaba bastante calmado.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Su estatus como artista internacional ya había sido cementado aun antes de la\nentrega de este premio.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Y por eso era él el predilecto.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"A pesar de ser el primer ganador nacional en tres años,el público no se asombró\ntanto.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"se",file="se2893r",id=2},
{"flash",time=400,alpha=150,loop=2,color="ffffff"},
{"text"},
text={
ja={
{
"Aplausos y vítores se escuchan.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Las camaras de la prensa no paran de parpadear.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"La obra de Kiyohiko Murata tenía su toque clásico y usual.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Su estilo ha penetrado en el exterior por un largo tiempo. Probablemente el\npremio fue más por sus logros que por su cuadro.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Sus cuadros ya vendían por un buen precio, pero ahora venderán por más con\nesto.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Quizá llegue a vender obras por los cientos de millones.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Eso es lo que implica ser premiado en la Exposición Moore.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"En contraste con el esplendor en el escenario, la tensión corría por los\nasientos de los nominados.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Ya se había colado la información de que el Airain Phoque iría para el señor\nMurata.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Pero nadie en esta fila sabe algo del otro premio a otorgarse.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"El aire alrededor se sentía tenso.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Pero por mi parte, me daba igual la respuesta a esa interrogante.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"O quizá es que muy dentro de mí ya sabía quién era el ganador.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=200000,file="zbg077e",path=":bg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_wsk_000002",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Es de nuestra grata sorpresa anunciar que hay otro premio para Japón aparte del\nAirain Phoque.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_msk_000019",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Así es. Ya los ganadores del Airain Loutre y el Airain Phoque se han anunciado\nen tiempo real internacionalmente.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000003",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Lo cual nos deja con el último premio del día, el Airain Otarie.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000004",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“En lo que respecta al Airain Otarie, han pasado seis años desde que Ryuu\nShinoyama obtuvo este premio por Japón.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_msk_000020",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Este premio es uno de altísimo valor, recibido por solo una única persona.Se\ndice que este prioriza más el talento a futuro que el historial de logros.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000005",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Pues bien, abramos entonces el sobre.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_msk_000021",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Nosotros tampoco sabemos de quién se trata. ¿Quién será el ganador de este\nhonorable galardón?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bgm",stop=1,time=3000},
{"text"},
text={
vo={
{"vo",file="man_msk_000022",ch="msk"},
},
ja={
{
name={"Presentador"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Breve silencio.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Fue entonces que el presentador abrió el sobre y revisó su contenido.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Después, y dejando algo de tiempo de espera, este anunció el nombre del\nganador.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm033"},
{"text"},
text={
vo={
{"vo",file="man_msk_000023",ch="msk"},
},
ja={
{
name={"Presentador"},
"“¡'Girasoles',de Kei Natsume!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"El auditorio estalla en aplausos.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Se escuchan las voces de Toritani y Rin.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo lograste...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Bajo mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Apenas vi el cuadro ya sabía que esto terminaría así.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Era el cuadro para eso.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_msk_000024",ch="msk"},
},
ja={
{
name={"Presentador"},
"“Debo decir que ha sido una gran sorpresa. Solo artistas con un gran historial\nde logros internacionales han ganado estos premios. ¿Quién diría que un joven\nadolescente se lo llevaría? Cabe destacar que es el más joven en la historia\nde la exposición...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000006",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Lo único que puedo decir es que se trata de una hazaña histórica.\nPero tengo acá un texto que explica el trasfondo del premio.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000007",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“El Airain Otarie es un premio único, una persona por año. Tiene fama por ser\nsobre todo un premio para jóvenes, nuevos artistas.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000008",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Aunque es la primera vez que un joven sin casi logros artísticos gana este\npremio. Este se ha otorgado a aquellos artistas con actividad internacional,\npero todavía en estado de anonimato.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000009",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Y sin embargo, estamos en la presencia de una situación excepcional, donde el\nhistorial del ganador es casi nulo, compuesto únicamente por su cuadro\nganador.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_wsk_000010",ch="wsk"},
},
ja={
{
name={"Presentadora"},
"“Respecto a esto――”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="man_frd_000301",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Yo me encargaré de explicar eso.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Fridmann sube al escenario.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_i07_01",path=":ev/ev_com_i07/",set="ev_com_i07",ax=960,ay=540,bx=0,by=0},
{"text"},
text={
vo={
{"vo",file="man_frd_000302",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Por alguna razón, Fridmann se me queda viendo.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bg",file="ev_com_i07_02",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07",ax=960,ay=540,bx=0,by=0},
{"text"},
text={
vo={
{"vo",file="man_frd_000303",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El arte japonés ha sido hermético por un largo tiempo.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_frd_000304",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Se dice que ha estado desconectado del mundo por siglos.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="man_frd_000305",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Se puede decir que el arte no crece en este país?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="man_frd_000306",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Todo lo contrario, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_frd_000307",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En los escritos de numerosos impresionistas se pueden ver varios nombres de\ngrandes maestros de la pintura japonesa.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="man_frd_000308",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Hokusai Katsushita, Hiroshige Utagawa, conocido también como Hiroshige Blue.\nKuniyoshi Utagawa, Utamaro Kitagawa... Se me acabará el tiempo nombrándolos a\ntodos.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="man_frd_000309",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Esta tierra ha dado a luz a numerosos artistas.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="man_frd_000310",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Podríamos decir que es una tierra amada por el arte.O por lo menos muchos\nartistas impresionistas creían eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_frd_000311",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Se puede ver también mucha artesanía japonesa conservada y amada en el\nexterior.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="man_frd_000312",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Se sabe que la fábrica real danesa de porcelana, antiguos proveedores de la\ncasa real, han sido fuertemente influenciados desde hace un gran tiempo por\nel Imari Sometsuke.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="man_frd_000313",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Esta no es tierra infértil de arte. Es una tierra donde crece arte alternativo.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="man_frd_000314",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pero justamente por ser alternativo, es que ha estado aislado del arte\noccidental por un largo tiempo.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="man_frd_000315",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sin embargo, eso cambió hace seis años.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="man_frd_000316",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Han pasado seis años desde que Kenichiro Kusanagi fue galardonado en esta\nexhibición.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_frd_000317",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y desde entonces, este país volvió a unirse con occidente.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="man_frd_000318",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Las artes que una vez siguieron caminos distintos se reencontraron.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="man_frd_000319",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y eso se vería en un incremento de galardonados japoneses en la Exposición\nMoore.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="man_frd_000320",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Todas las fronteras han desaparecido del arte, y justo ahora una nueva ola está\nformándose.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="man_frd_000321",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Junto con la promesa de una nueva generación.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="man_frd_000322",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y el señor Kei Natsume, ganador más joven de este premio y nuestro galardonado\nde hoy, representa esta promesa.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="man_frd_000323",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Él representa la nueva generación que empujará el arte de hoy.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="man_frd_000324",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sin duda alguna...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="man_frd_000325",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Fridmann se queda en silencio.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="man_frd_000326",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sin embargo, me da mucha pena anunciar que no podrá venir.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="man_msk_000025",ch="msk"},
},
ja={
{
name={"Presentador"},
"“¿Eh? ¿Es en serio? ¿Eh? Pero...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="man_frd_000327",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡Él no vendrá!”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="man_skm_000055",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“Eh, ¿qué está pasando?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="man_mrt_000063",ch="mrt"},
},
ja={
{
name={"Murata"},
"“Cierra la boca por un momento...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="man_skm_000056",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"“¿Eh? Ah, bueno...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="man_frd_000328",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Por lo tanto, y disculpen la insolencia, en mi posición como curador de la\nFundación Moore, daré unas palabras correspondientes a su galardón.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="man_frd_000329",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡Aplausos para el joven genio que pintó esta obra!”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="man_frd_000330",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Su logro ha sido una hazaña que quedará en la historia.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"se",file="se9044",id=1},
{"text"},
text={
ja={
{
"El teatro explota.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Como si todos ofrecieran sus bendiciones a la milagrosa premiación del ganador.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Sin embargo,\nFridmann no cambiaba su apesadumbrada expresión.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="05_the_happy_prince_07_3"},
{"text"},
linkback="block_00263",
},
