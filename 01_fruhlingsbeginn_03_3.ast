astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg062a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0200",face="a0012",head="yum_z1a",lv=4,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000059",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, acosador-senpai.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¿Por qué estás acá?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0008",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000060",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Yo? La razón por la cual estoy acá es porque soy integrante del club de\nastronomía.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No se supone que eras del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_tkd_000009",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Ah, ella habló ya con Toritani-san y le explicó que quería participar en dos\nclubes a la vez.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000061",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conque esto era lo que tenías que hacer...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0012",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000062",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ah, ese es super-acosador-senpai!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Kawachino señala con su dedo a Akashi, con una voz inexpresiva.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000068",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jajajaja, jovencita, ¿eres nueva estudiante? ¡Muy bien que llames super-\nacosador-senpai al ser más especial que ha cruzado por acá desde los inicios\nde este colegio, o debería decir desde los inicios del mundo! ¡Mis cumplidos\npara ti!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_yum_000063",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, hola.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000069",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Bien! ¡Recibe ahora con todo tu cuerpo y alma mi acoso sexual!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Detente!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",id=1,file="se2192"},
{"fg",ch="明石",size="z1",ex03="b0097",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0005",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000070",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Auch, ¿por qué me golpeas, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque solo sea en broma, cualquiera te detendría con un golpe si le dijeras a\nuna estudiante nueva que la vas a acosar sexualmente.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0009",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000071",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pero si solo era una bromita~”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0016",head="yum_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000064",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, Kusanagi-senpai, pupilo y maestro, ambos hacen juntos un muy buen dúo\nde Manzai.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya te dije que este tipo no es mi maestro! ¡¿Y a que viene eso de dúo?!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0008",head="yum_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000065",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y bien, ¿a qué se debe que hayan venido todos al club de astronomía?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_tkd_000010",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Parece que quieren observar un poco el club.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0017",head="yum_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0005",head="yum_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000066",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Observar el club de astronomía. Jaa, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",id=1,file="se1296"},
{"text"},
text={
ja={
{
"Al decir eso, Kawachino metió su mano en su mochila y comenzó a moverla\nadentro.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0210",face="a0015",head="yum_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000067",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La verdad es que no quiero hacer esto, pero...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fgact",ch="優美",act="いいえ",size=5,lv=4,id=9},
{"se",file="se9010",id=1},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¡¿Por qué sacas un cuchillo?!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000068",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo tomé prestado de la sala de cocina.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0017",head="yum_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0017",head="yum_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000069",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Que por qué? Pues, porque olvide mi cuchillo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me refiero a eso...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Espera, ¿qué diablos es eso de 'mi cuchillo'?",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",id=1,file="se2308"},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0017",head="yum_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0017",head="yum_z1b",x=-345,lv=4,id=9},
{"fg",ch="里奈",size="z1",mx=40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0200",face="d0013",head="rna_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000056",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Kusanagi-senpai, ¿por qué estás aquí?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Hikawa? ¿Qué haces tú aquí? ¿Tú también eres del club de astronomía?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0008",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0010",head="rna_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000057",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no sé muy bien por qué, pero Yuumi me dijo que era peligroso estar en la\nsala de arte, y me pidió que me quedara por un tiempo acá...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ohhh.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0011",head="rna_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000058",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Van a hacer algo allá? Me da algo de curiosidad, pero Yuumi no quiere de\nninguna manera que me acerque a la sala de arte...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0005",head="yum_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000070",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000072",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pero ¿qué es esto? Hay muchas lindas muchachas en el club de astronomía, nya~\nPero qué envidia. Si tan solo tuviéramos esta clase de material en el club de\narte, todos los días serían divertidos, nya~”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0210",face="a0017",head="yum_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000071",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Juzgando y analizando todos los factores en general, me di cuenta de que parece\nque Kawachino-san está realmente enojada.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Ya veo. No sé muy bien, pero parece que fue una terrible idea traer a Akashi\nacá. Incluso mi vida también está expuesta al peligro ahora.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Pero de igual manera, en la sala de arte está Rin. Así que quisiera detener a\nAkashi-senpai acá.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Estoy en un dilema.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"excall",label="flagon02",cond="g.rinclear==1&&g.makclear==1"},
{"excall",label="flagoff03"},
{"text"},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"select",label="label03",text="select"},
{"select",label="label04",exp="f.rna=f.rna+1",text="select"},
{"select",name="select01_03_2",mode="sys"},
{"text"},
select={
ja={
"El hecho de que mi integridad esté expuesta al peligro por esto es todo un problema.",
"Ciertamente, el hecho de que Hikawa esté expuesta al peligro es todo un problema.",
{"rt2"},
},
},
labelcount=1,
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"El hecho de que mi integridad esté expuesta al peligro por esto es todo un\nproblema.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"excall",label="join2"},
{"text"},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Ciertamente, el hecho de que Hikawa esté expuesta al peligro es todo un\nproblema.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"excall",label="join2"},
{"text"},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000073",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué pasa, Kusanagi? ¿Por qué me ves? ¿Tantas son las ganas que tienes de\ncontemplar mi majestuosidad?”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
"Mi mente se decide finalmente, gracias a las irritantes palabras de Akashi.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",mode=-2,sync=0},
{"bg",y=-100,zoom=80,file="zbg062a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0006",head="aka_z2a",lv=5,id=9,sync=0},
