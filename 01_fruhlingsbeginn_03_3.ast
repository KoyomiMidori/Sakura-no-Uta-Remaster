{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_05efe",id=4,lv=4,act="いいえ",size=10,time=100,loop=-1},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000099",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eh, PERO QUÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉ.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a25_04fg",id=3,lv=3,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"bg",file="ev_com_a25_06efe",id=4,lv=4,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"extrans",time=0},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_04fg",id=3,lv=3,act="いいえ",size=5,time=200,loop=-1},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_06efe",id=4,lv=4,act="いいえ",size=10,time=100,loop=-1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000091",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Así? ¿Y bien, es así? ¡Así es como se atraen los planetas! ¡¿Verdad, senpai?!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a25_03fg",id=3,lv=3,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"bg",file="ev_com_a25_05efe",id=4,lv=4,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"extrans",time=0},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_03fg",id=3,lv=3,act="いいえ",size=5,time=200,loop=-1},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_05efe",id=4,lv=4,act="いいえ",size=10,time=100,loop=-1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000100",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eh, eh, eh, se supone que los planetas giran alrededor de mí, no yo\nmismoooooooo!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a25_04fg",id=3,lv=3,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"bg",file="ev_com_a25_06efe",id=4,lv=4,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"extrans",time=0},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_04fg",id=3,lv=3,act="いいえ",size=5,time=200,loop=-1},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_06efe",id=4,lv=4,act="いいえ",size=10,time=100,loop=-1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000092",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad? ¿Pero no te parece bien girar tú mismo de vez en cuando? ¿No crees?\n¿Verdad que sí? ¿No es así, senpai?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a25_03fg",id=3,lv=3,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"bg",file="ev_com_a25_05efe",id=4,lv=4,path=":cg/cg_ev_com_a25/",set="cg_ev_com_a25",sync=0},
{"extrans",time=0},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_03fg",id=3,lv=3,act="いいえ",size=5,time=200,loop=-1},
{"cgact",file=":cg/cg_ev_com_a25/ev_com_a25_05efe",id=4,lv=4,act="いいえ",size=10,time=100,loop=-1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000101",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡NOOOOOOOOOOOOOOOOOOOOOOOOOOO, SI VAS A HACERME GIRAR HAZLO CON EL PODER DEL\nAMOR Y NO CON EL PODER DE TUS BRAZOSSSS!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_ked_000718",ch="ked"},
},
ja={
{
name={"Kei"},
"“O-Oye... Esa nueva estudiante...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, cuando la hacen enojar da más miedo que Toritani.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de ser batido hasta más no poder, al senpai se le subió la sangre a la\ncabeza y perdió el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Después de eso, contactamos a Toritani y Akashi fue escoltado hasta la sala de\narte.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Parece que la sesión de tortura que Toritani había mencionado está por\ncomenzar.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Aún a pesar de que acaba de ser revuelto tanto. Wataru Akashi es verdaderamente\nun hombre bastante lastimoso.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
