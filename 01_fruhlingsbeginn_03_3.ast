{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Bien.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0005",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000074",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Oh? ¿Ohh? ¿Qué pasa, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0009",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000075",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Q-Qué pasa? ¿Por qué me abrazas? ¿T-Te sientes solo, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, agarra sus pies.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_ked_000714",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡O-Ouh! Entendido.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"se",file="se3130",id=1},
{"fg",ch="明石",size="z2",rotate=-90,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0009",head="aka_z2a",x2=0,r2=0,x=-400,lv=5,id=9},
{"fgact",ch="明石",act="quake",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000076",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Uwaah!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0005",head="aka_z2a",x=-400,lv=5,id=9,rotate=-90},
{"fgact",ch="明石",act="いいえ",loop=-1,size=10,time=300,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000077",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Q-Qué pasa? Sé que soy absolutamente majestuoso, pero yo no soy ningún\nOmikoshi. ¡No hay necesidad de que me carguen!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"se",file="se0836",id=1},
{"bg",y=-100,zoom=100,speed=500,time=0,sync=0,file="zbg062a",path=":bg/",z2=80,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="明石",size="z2",ex03="a0097",rotate=-90,time=0,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0009",head="aka_z2a",x=-400,lv=5,id=9},
{"fgact",ch="明石",act="いいえ",loop=-1,size=15,time=200,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000078",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡E-Esperen! ¡¿Por qué están avanzando hacia la ventana! ¡E-Esperen! Esto es de\nverdad peligroso. Estamos en el sexto piso.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajajajaja... Akashi-senpai. Siempre eres, y serás nuestra estrella.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0006",head="aka_z2a",x=-400,lv=5,id=9,rotate=-90},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",x=-400,lv=5,id=9,rotate=-90},
},
},
text={
vo={
{"vo",file="man_wtd_000079",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿D-De verdad? Pues sí, ciertamente yo brillo, eh. Yo soy... ¡Sí! Soy como...\n¡¡UNA ESTRELLA FUGAZ!!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Conviértete entonces en una!!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",mode=-2},
{"se",file="se9003",id=1},
{"fg",ch="明石",rotate=-90,speed=1000,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",x2=-400,x=-3700,lv=5,id=9,sync=0},
{"extrans",time=0},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000080",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“GYAAAAAAAAAaaahhhh...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2,sync=0},
{"bg",file="bg062a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Adiós, senpai...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000715",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajaja, el senpai parecía una estrella fugaz.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",mode=-2},
{"fg",ch="琢磨",size="z1",mode=3,resize=1,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0010",head="tkm_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000011",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¿N-No crees que eso fue algo peligroso?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo está bien. Fue un ataque no letal. Digamos que se trata de eso que llaman\nla compasión de un samurái, Hirose.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0022",head="tkm_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000012",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“No creo que lanzar a alguien por la ventana sea un ataque 'no letal'...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"se",file="se3130",id=1},
{"fg",ch="琢磨",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0022",head="tkm_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="明石",size="z1",ex03="a0097",mx=-40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000081",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Estuve a punto de morir!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch, parece que justo debajo de esta ventana estaba la azotea...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0013",head="tkm_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000013",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“P-Por supuesto que lo hiciste sabiendo eso, ¿no, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debo admitir que fue una broma. La sola idea de querer eliminarlo rápidamente\ninvadió mi mente.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0001",head="yum_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"Observo a Kawachino.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Al parecer Kawachino captó rápidamente el propósito de mi rápida acción, pues\ntenía ahora su teléfono celular en sus manos. Tal como me lo esperaba, nada\nque ver con Kei.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Debió haber tenido suficiente tiempo como para mandarle un mensaje a Toritani.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Lo único que falta ahora es esperar a que Toritani venga.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0010",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000072",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000073",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No le pedí su dirección de correo. Había escuchado que la lista estaría lista\npronto, así que...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuuh.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Demonios.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Por supuesto, una llamada llamaría demasiado la atención, así que no hay manera\nde que haya podido hacerlo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"En pocas palabras, aún no le ha avisado a Toritani.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000082",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué sucede con la dirección de correo?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, no es nada!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Esto se ha tornado bastante engorroso.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Seguramente Toritani tampoco se dará cuenta de que este tipo está en el club de\nastronomía...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000716",ch="ked"},
},
ja={
{
name={"Kei"},
"“Y bien, ¿qué es lo que hace el club de astronomía?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Kei olvidó por completo el objetivo original y está ahora preguntando\ndespreocupadamente.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Aún durante ese rato, estuve pensando en una manera de contactar a Toritani.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Y es que...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_000074",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*giro*...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"La mirada de Kawachino es espeluznante.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=5},
{"bgm",file="bgm008"},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=5},
{"fgact",ch="明石",act="いいえ",size=25,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000083",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Que qué es lo que hace el club de astronomía?! ¿Quieres saber? ¡¡Quieres\nsaberrrrr?!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué eres tú el que responde?...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000084",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡El club de astronomía se encarga de observar las estrellas! ¡En pocas\npalabras! ¡La única razón de ser de ellos es observarme a mí, la estrella de\neste colegio!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fgact",ch="明石",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=5},
},
vl02={
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000085",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jajajajaja. ¡Hoy ha venido la estrella de ustedes, este desenfrenado cuerpo\ncelestial! ¡Yo! ¡Pueden admirar y contemplar tanto como quieran a esta\ngigante estrella! ¡Vamos! ¡Véanme! ¡Pueden verme!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=1000},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x2=0,x=-345,lv=4,id=5},
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0003",head="tkm_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="man_tkd_000014",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Aunque a pesar de todo, la actividad de las estrellas ocurre principalmente\ndurante las noches. Así que son pocas las cosas que podemos hacer durante\nestas horas.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="明石",size="z1",ex01="b0099",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0009",head="aka_z1b",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000086",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eh, ¿incluso tú me ignoras, Hirose?!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿qué es lo que hace el club de astronomía durante las horas en las\nque no se pueden observar las estrellas?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0001",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000075",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estamos por comenzar una sesión de estudio.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una sesión de estudio? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_tkd_000015",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Estudiaremos acerca de las estrellas. Aunque, diría que es más bien una sesión\nde presentaciones.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, se ve bastante aburrido. No cabe duda de que es el tipo de actividad\ndepravada ideal para ti, Hirose.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_tkd_000016",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¡¿Por qué es depravada?!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estudiar fuera de clases no es algo que la gente normal haga. Solo los\npervertidos lo hacen.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_tkd_000017",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Pervertido...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bgm",stop=1,time=300},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0017",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000076",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpai...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"*escalofrío*.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, Kawachino también forma parte del club de astronomía.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, quise decir...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0220",face="a0012",head="yum_z2a",lv=5,id=9},
{"bgm",file="bgm007"},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0220",face="a0016",head="yum_z2a",lv=5,id=9},
{"fg",ch="優美",speed=1200,mode=3,path=":fg/yum/z2/",file="yum_z2a0220",face="a0016",head="yum_z2a",x2="0,-100,0,100,0,-100",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000077",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me sorprende que te hayas dado cuenta, eh. DE QUE SOY UNA PERVERTIDA.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Pero q-- ¡¿Tú también eres una pervertida?!",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",time=0,mode=-2},
{"fg",ch="優美",size="z2",time=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0200",face="a0017",head="yum_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0220",face="a0015",head="yum_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000078",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa perspicacia... No es más que una amenaza para mí... No me queda de otra.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja de llevar el cuchillo en las manos mientras dices eso! ¡Realmente das\nmiedo!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0001",head="yum_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0008",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0015",head="rna_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000059",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera, Yuumi, Kusanagi-senpai siempre dice las cosas a la ligera, no\nte lo tomes todo a pecho.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0012",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000079",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0005",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000060",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Además, Hirose-senpai no es ningún pervertido, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0017",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000080",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Así será en realidad?...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",mode=-2},
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0022",head="tkm_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tkd_000018",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“E-Escucha, ¿podrías dejar de verme con esa expresión dudosa?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-En fin, eso solo lo dije por decirlo! Hirose es un pervertido, pero tú eres\nperfectamente normal, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0013",head="tkm_z1a",lv=4,id=6},
{"fgact",ch="琢磨",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tkd_000019",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¡¿Por qué soy un pervertido?!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000087",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso no tiene ninguna importancia! ¿No les gustaría, tal vez, comenzar ya su\nsesión de reportes o presentaciones de la que tanto se jactan? Les escucharé\ncon atención.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0005",head="yum_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000081",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Super-acosador-senpai, te comportas como si fueras muy importante.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"quake",size=4,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000088",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿COMO si fuera muy importante? ¿Haan? No es COMO si fuera, es que lo SOY. ¿Te\nquedó claro, jovencita?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0017",head="yum_z1b",lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000082",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ohhh... ya veo. Está bien. Lo tomaré de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Su voz era calmada, pero... tenía una sensación fuertemente avasalladora en el\nfondo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bgm",file="bgm008"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0005",head="yum_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000083",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, quisiera comenzar yo... 'Respecto a la teoría de remolinos de Descartes y\nla gravitación universal de Newton'.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_tkd_000020",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Me sorprende que conozcas la teoría de vórtices de Descartes, eh. Es la misma\nteoría que Newton criticó severamente. Ciertamente, su relación con la\ngravitación universal es bastante curiosa. Newton fue un crítico de esa\nteoría, pero es también un hecho que recibió una gran influencia de la\n'geometría' de Descartes.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Un montón de palabras que sentía que sabía, o que tal vez no, aparecieron en la\nconversación.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Me pareció que Takuma corrigió discretamente la lectura usada por Kawachino,\npasando de 'teoría de remolinos' a 'teoría de vórtices', pero supongo que así\nde difícil será el tema. En mi caso, no entiendo absolutamente nada.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Sea lo que sea, este club hace cosas más difíciles de las que se ven en clases.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Aunque bueno, el jefe de club es ese pervertido de Hirose, así que no hay nada\nde qué sorprenderse...",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000089",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué? ¿Jovencita, hiciste un reporte acerca de la gravitación universal? Fuh,\neso es totalmente ridículo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_000084",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es ridículo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=0,lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000090",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sí, así es! La gravitación universal es mi especialidad. Solo en gravitación\nuniversal tengo doctorado de 6 universidades distintas. No me causa más que\nrisas que hayas escrito un reporte de la gravitación universal sin mi\npermiso.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_ked_000717",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Senpai, te has graduado de 6 universidades distintas?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Obviamente es mentira. Además, ¿qué es eso de 6 universidades? ¿Es que acaso\npiensa jugar al béisbol?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_yum_000085",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Podrías ilustrarme entonces en tu teoría de la gravitación universal?\nSuper-acosador-senpai.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
},
vl02={
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
},
vl03={
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000091",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡La gravitación universal es, en pocas palabras, el poder que atrae a las\npersonas! ¡ES DE CIR! Eso que conocemos como el encanto de los hombres.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_yum_000086",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ohhh. ¿El encanto de los hombres?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",x=0,lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000092",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Así es! ¡La fuerza de gravedad es, en otras palabras, el poder del amor! Las\npersonas 'caen enamoradas' frecuentemente. ¡Sin duda alguna, el amor es\ngravedad!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000093",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Y por lo tanto, a la ecuación de los campos gravitacionales también se le\nconoce como la ecuación del amor!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_000087",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La ecuación de campos gravitacionales es... la ecuación de Einstein, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=0,lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000094",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Así es! ¡Usando la primera letra de la ecuación de Ainstain, las personas le\nllaman también la ecuación de 'a'! ¡En pocas palabras, la ecuación del amor!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_000088",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Einstein se escribe E I N S T E I N, así que la primera letra es 'E'...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0005",head="aka_z1b",x=0,lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000095",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso es algo insignificante! ¡Lo importante es que todos son atraídos por el\npoder del amor! ¡Las personas amadas como yo atraemos a los demás, como la\nsupergravedad!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000096",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y giran constantemente a mi alrededor. ¡Como las estrellas atrapadas en el\ncampo gravitacional del Sol!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_yum_000089",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, ya veo. Entonces super-acosador-senpai es como el Sol, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000097",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Se podría decir que es así, ¿tal vez? ¿No eres tú igual? Te sientes atraída por\nmí... ¿no?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_000090",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Podrías explicarme un poco más en detalle respecto a eso? Quisiera ver cómo\nlos planetas se atraen entre sí...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000098",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Claro, con gusto, señorita. Te mostraré cómo los planetas se atrae-- ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
