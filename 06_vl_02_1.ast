astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
"Comenzaba la mañana.\nEstaba en la azotea desayunando solo, como de costumbre.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",file="se9023",id=1},
{"text"},
text={
ja={
{
"Al rato, empecé a escuchar a alguien subiendo por las rígidas escaleras.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",stop=1,time=500,id=1},
{"fg",ch="桜子",size="z1",mx=40,mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, buenos días, Sakizaki-kun. ¿Necesitas algo?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000097",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Buenos días. No es nada, solo quise venir a la azotea a tomar algo de aire\nfresco.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm, cuánto donaire, eh.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000098",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Me lo dice usted a mí?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no podría decirlo?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000099",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted siempre desayuna pan francés y café.Eso sí tiene bastante donaire y\nelegancia.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pan francés y café?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000100",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, siempre desayuna eso, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es pan francés y té de cebada.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000101",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿T-Té de cebada? ¿Qué clase de combinación es esa?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El pan más barato que conseguirás es el francés. Y el té de cebada también es\nbarato.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000102",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y-Ya veo... P-Pensaba que su desayuno era algo más elegante...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué pensaste eso? ¿Qué parte de mí tiene esa elegancia?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_skr_000103",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Su presencia, quizá?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? ¿Qué tanta elegancia podría emanar mi presencia?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000104",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“La tiene. Y bastante.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000105",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Los rumores dicen que usted es el hijo ilegítimo de un gran pintor, y que llegó\na ser rival y amante de la famosa Rin Misakura... Pero algo en su pasado\nocurrió que ahora está inmerso en la soledad, contemplando todos los días el\ncielo desde la azotea.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿J-Jaa? ¿De dónde salieron esos rumores? ¿Así me ven ustedes a mí?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000106",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Por eso le pregunté ayer por su relación con Kenichiro Kusanagi y Rin Misakura,\npara esclarecer los rumores.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Heeh, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Pues, quizá influya el hecho de que no me he revelado como su hijo, pero...\n¿Por qué me ponen como su hijo ilegítimo?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"¿Y yo, amante de Rin?... La realidad es algo distinta.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Aunque bueno, así funcionan los rumores, supongo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000107",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero de lo que me contó ayer usted no parece tener relación alguna con los dos.\nY se me ocurrió que quizá usted está actuando de manera que los demás crean\nque sí la hay.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues vaya acusación tan terrible la que me haces.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0011",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000108",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, aunque considerando lo popular que es con las otras chicas, pensé que quizá\nestaría dándose aires de elegancia a propósito.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es una falacia. El profesor Kusanagi no se las da de elegante, simplemente\nes pobre.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000109",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ya veo. No me sorprende tanto, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te sorprende?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000110",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Así es. Después de hablar varias veces con usted acá, llegué a la conclusión de\nque los rumores de las demás carecen de credibilidad.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000111",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“En principio, nunca tuve interés particular por usted, y fue hace poco que me\nenteré de ellos.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000112",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ahora que he tenido la oportunidad de conversar con usted entre tanto\namonestarlo, las otras alumnas han llegado a preguntarme por usted.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? No me veo como un tipo popular, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000113",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, eso se debe a su apatía, me parece.\nDe hecho, solo por encontrarme con ustedes los demás me...\nAh, no, ¡no es nada!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo por encontrarte conmigo, qué?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0004",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000114",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Olvídelo, no insista. Por cierto, ¿sabe cocinar, profesor?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué cambio tan drástico de tema... Pues sí, llevo un buen tiempo viviendo solo,\nasí que sí sé.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000115",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Y aun así desayuna solo pan francés y té de cebada?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no lo creerás, pero esto es adictivo.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Saqué un envase de mayonesa de mi bolsillo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000116",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Mayonesa?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Tomas ahora el pan, lo partes, y...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Unto mayonesa sobre el pan.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pruébalo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000117",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿El, el pan?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo partí con la mano. No lo he tocado con mi boca, tranquila.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008h",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000118",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡E-Eso no me importa!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De veras? Bueno, prueba.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000119",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Está bien. Aunque, de verdad es solo pan con mayonesa, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="桜子",size="z2",mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000120",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ahm... *mogu, mogu*...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Sakizaki-kun mastica lentamente con su pequeña boca.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toma, té.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Esperé el momento adecuado para servir té de mi termo. Sakizaki-kun lo toma, y\nse lo bebe.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0003",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000121",ch="skr"},
},
ja={
{
name={"Sakurako"},
"*glup*, *glup*...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es todo.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000122",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Esto está muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Verdad que sí? Es fácil de preparar, sabroso, y además barato.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_skr_000123",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Heeeh... Ya veo. Nada cercano a los rumores, realmente.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los rumores nunca te dicen nada.\nSon solo producto de lo que los demás dicen, chismes.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000124",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Chismes... sí, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La gente siempre pone mucho esfuerzo para lo suyo, para ser entendidos. Y sin\nembargo, hablan en exceso y creen saber mucho de los demás.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000125",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pues considerando que ya llevo cierto tiempo conociéndolo, ¿no es ya hora de\nque me cuente un poco de usted?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que sepas nada de mí.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000126",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo estoy a tiempo parcial, ni siquiera sé si estaré el año que viene.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0004",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000127",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Esa clase de actitud no es algo problemática como profesor?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Yo no confiaría en un profesor enfrascado en hablar de sí mismo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000128",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Considerando el caso contrario, ¿dice usted que puedo confiar en un profesor\nque lo oculta todo?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás insistente hoy, Sakizaki-kun. A ver, ¿qué quieres saber entonces de mí?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001h",head="sku_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008h",head="sku_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000129",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Q-Qué quiero saber? Ahora que lo pregunta... no sabría qué decir...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo en la azotea, bajo el cielo, algo lúgubre, aparentemente melancólico.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo sucede que no me llevo bien con los otros profesores, y procuro evadir la\nsala de profesores en la medida de lo posible.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si parezco melancólico es porque no tengo dinero, no puedo comer buena comida y\nno tengo casi amigos, y soy pesimista. Así es, no melancólico, pesimista.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada más ni nada menos que decir de Naoya Kusanagi.\nTú más que nadie sabe eso ahora. ¿No es así, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001",head="sku_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0002",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000130",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Yo, más que nadie?... Sí, quizá.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_skr_000131",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Fue al comenzar a venir acá que me di cuenta de algo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000132",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“El mural de la iglesia se ve muy bien desde acá también.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El mural de la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000133",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí. Al parecer fue obra de Kenichiro Kusanagi, pero existen muchas leyendas\npertinentes a su creación.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000134",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Escuché que Rin Misakura también participo en su elaboración.\n¿Sabe usted algo de eso, profesor Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nopo, ni idea.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0013",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000135",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Será eso cierto?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Sakizaki-kun me lanza una mirada inquisitiva.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_skr_000136",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo veo extrañamente inquieto, profesor.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no estoy inquieto, no señor...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0009",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000137",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué esa forma tan extraña de contestar?...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000138",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Esa pintura es realmente misteriosa...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_skr_000139",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo que más me asombró al entrar al colegio fue el mural de la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000140",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y más fue el asombro al entrar en ella. El interior y el exterior son\ncompletamente distintos. Quedé impresionada con la obra...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. Fue diseñada por un artista de fama internacional.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0003",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000141",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, supongo que será por eso también. Aunque la obra en sí es entretenida.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entretenida?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_skr_000142",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Quizá haya estado diseñada tomando eso en cuenta, quién sabe. Da la impresión\nde que sus pintores se divirtieron mucho...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sus pintores se divirtieron mucho, eh...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000143",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Es posible percibir eso de una obra? ¿O es que son creadas tomando eso en\ncuenta?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te entiendo. Has mencionado algo interesante.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por qué el arte no emplea el lenguaje. Sí...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_skr_000144",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿El arte no emplea el lenguaje?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto que sí, en poemas y literatura se usan las palabras. Solo que\nno es exactamente lo mismo eso al lenguaje.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000145",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, no sé muy bien por qué, pero los poemas y la literatura no parecen contener\nexactamente lenguaje. Quizá palabras sea lo más adecuado en este caso.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000146",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué será? Ahora que hablamos de esto, lo que conocemos como lenguaje\npareciera ser una lengua muerta...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso se trata.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000147",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿Qué quiere decir? ¿Es que acaso esa era la explicación debida?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es, esa es la explicación. No se trata de relatar el significado, sino\nseñalarlo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000148",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No estoy entendiendo nada. ¿De qué está hablando?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Imaginate esto por un momento.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Se escuchan las voces de los pintores divirtiéndose'. ¿Acaso estas palabras\nsignifican algo? No, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por encima del significado de esas palabras, hay más valor en esas voces, en el\npropio sonido de la risa.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que las palabras que se escuchan de esa obra, te viste cautivada por el\ntono entretenido que había en ellas, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000149",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000150",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Ah! Increíble. No sé muy bien por qué, pero creo que acabo de entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bueno.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000151",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“He quedado impresionada, profesor Kusanagi. Realmente es usted todo un profesor\nde arte.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene eso?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000152",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Su explicación de cómo sentir una obra artística fue excelente.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000153",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ya veo. Así que a veces el sonido de las palabras valen más que la palabra como\ntal. Como las canciones.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Canciones?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000154",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, canciones, o composiciones musicales. No se trata de solo buscar\nsignificado en las palabras. A veces la melodía cambia ese significado en sí.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000155",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“La melodía convierte lo poético en musical.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo poético en musical, ya veo... Esa forma de ponerlo es también poética, diría\nyo.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000156",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo que yo noté como entretenido fue algo que se asemeja a la melodía en este\ncaso, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, algo así.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000157",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Heeeh, ya veo, ya veo, jeje～”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Sakizaki-kun me observa con un cierto tinte de admiración.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000158",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pues es que usted parece ser alguien realmente insensible, y no lo creí capaz\nde dar palabras tan magníficas y poéticas.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta, el arte es inmensamente magnífico. Y por ser magnífico es que es arte.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000159",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿En serio? A mi parecer el arte es algo más profundo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eso dejó de ser palabra y se convirtió en lenguaje. Tal como tú lo\ndijiste, ha muerto.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes ir a la biblioteca y encontrarás muchos libros de palabras muertas.Si\ntienes tiempo también a la galería de arte, te encontrarás con muchos cuadros\nmuertos colgados en sus paredes.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_skr_000160",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eso quiere decir que la literatura y el arte antiguo son cadáveres?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. En el momento en que lo percibes como 'profundo', eso ya ha muerto.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Igual que el lenguaje.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000161",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, el arte puede revivir una y otra vez.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegaras a cruzarte con una muestra de una mariposa muy hermosa, y llegas a\npercibirla como si realmente estuviese viva y volando, esa mariposa dejará de\nser un cadáver.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El ejemplar recibe nuevamente el derecho de 'volar', y de ahí que cautiva a las\npersonas. El arte es lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una eternidad que encierra en sí un instante.Aunque bueno, las obras en sí ya\ntienen límite de vida...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, mientras esa obra exista, ese instante seguirá encerrado en esa\neternidad.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y transmitirá uno, o a veces muchos más sentimientos... Eso depende de la obra.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es magnífica por transmitir muchos, ni tampoco espléndida por transmitir\nsolo uno.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero hay instantes atrapados en la eternidad que solo buscan transmitir una\núnica cosa. Obras así hay.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000162",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Heeh...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000163",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, solo que ya veo por qué usted es tan popular con las chicas...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué rayos hablas?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000164",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Uhm? Pero, usted tampoco parece ser mucho de decir semejantes cosas...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. ¿Qué clase de idiota se la pasaría balbuceando todo el\ntiempo fantasías delirantes como esa?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000165",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ya veo. Vaya, qué bueno que me levanté temprano hoy.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0003",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000166",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Nada en particular~”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sakizaki-kun, si tienes tiempo para venir tan temprano acá y hablar con un\nprofesor, ¿no sería mejor que lo invirtieras en disfrutar más tu vida\nescolar?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000167",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, hablando de tiempo, ¿está bien usted, profesor?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000168",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿No debe estar usted en la sala de profesores antes de que los estudiantes\nlleguen?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"mwact",act="びっくり"},
{"se",file="se3130",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, mier--”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000169",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Otra cosa, profesor!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué?!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000170",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Muchas gracias♪”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0003",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000171",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Bueno, así quedamos~”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"msgoff"},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"ex",time=1200,func="wait"},
{"se",file="se9004",id=1},
{"fg",ch="桜子",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Después de agradecerme de una manera muy distinta a la usual,Sakizaki- kun se\nfue por las escaleras.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"¿Así quedamos? Vamos...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, demonios, soy yo el que debería apresurarse!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"msgoff"},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Apenas comienza la mañana y ya me quedé discutiendo desenfrenadamente con una\nestudiante.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Parezco un niño.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Aunque, ya se acerca la primavera.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"La temporada de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Si bien esa pintura nació en verano, cada primavera me recuerda a los cerezos.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Siempre es así.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",rule=139,vague=40,file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm036"},
{"text"},
text={
vo={
{"vo",file="fem_jta_000001",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“Qué rollo esto de pintar, ah~ Oye, tú, ¿me ayudas?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000001",ch="ntd"},
},
ja={
{
name={"Estudiante Ｃ"},
"“Ah, eh, sí...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Hay algo que en mi época de estudiante no sabía, y es que todo colegio tiene un\nsistema de categorías algo peculiar.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Poniéndolo de forma simple, tenemos a los estudiantes que llaman la atención y\nesos que no.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Siendo un poco más precisos, tenemos clase A, clase B y clase C. Sí, dan ganas\nde preguntar si están hablando de carne o alumnos.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"La alumna A es alegre, animada. ¿Tipo gyaru, podríamos decir?En cambio, la\nalumna C es una muchacha tranquila y silenciosa.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Por lo general alumna A siempre le pide ayuda a la alumna C.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Sin embargo, al final la alumna C termina haciéndolo todo.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Teniendo esa jerarquía en el colegio, un buen profesor debe saber lidiar con\nlos estudiantes en el tope de esa categorización. Es decir, con los de clase\nA, la carne Matsusaka.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Los profesores suelen decir que el truco para llevar la clase sin problemas es\nllevarse bien con ellos.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, alumna A, no pongas a alumna C a pintar tu cuadro.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_jta_000002",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“¿Alumna A? Qué malvado usted, profe. ¿No recuerda mi nombre?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Haga silencio. Y deja de ponerla a pintar lo tuyo.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_jta_000003",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“No la estoy poniendo a pintar nada, solo me está ayudando. Ah, cierto, ese es\nsu trabajo, ¿verdad? ¿Por eso está molestito?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Unos cuantos estudiantes estallan en carcajadas.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, el comité de educación entraría en escándalo si descubren que alguien\nsin licencia de profesor está enseñando.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Las carcajadas se intensifican.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"No me parece haber dicho nada divertido.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_jta_000004",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“Sus réplicas son de otro planeta, profe. Me va a matar de la risa.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por algo yo sí tengo licencia de profesor.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Más carcajadas.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ahhh? No dije eso para entretenerlos a ustedes, paren las carcajadas. Cómo\nmolestan, eh.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"A pesar de eso se siguen riendo.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"¿Por qué se esfuerzan tanto en reír?Hay algo fuera de lugar para mí en eso.\nAlgo distante de mí.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y tú también! ¡Deja de hacerle la tarea a los demás!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0009",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000002",ch="ntd"},
},
ja={
{
name={"Estudiante C"},
"“Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Ese mundo conocido como salón que descubres al convertirte en profesor es\nrealmente peculiar.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Quizá es que no tenía mucho interés por los demás cuando era estudiante...\n¿Será que los tiempos han cambiado?",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Si me enfado con la alumna A todos se ríen, si me enfado con la alumna C solo\nrecibo un 'lo siento'.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Es normal que los alumnos de rango más bajo nunca sacan excusa alguna,\nprocurando siempre disculparse.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"A mi parecer lo debido sería disculparse, pero parece que hoy en día, hasta del\nreproche se debe sacar risa...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Todos los demás profesores parecen haber aceptado esto, e incluso yo que no lo\nveo tan bien termino haciendo lo mismo.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Aunque sí, esta clase de muchachos son expertos en animar el ambiente.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0007",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000003",ch="ntd"},
},
ja={
{
name={"Estudiante C"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Natsuko Kuriyama.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0001",head="nat_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000004",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah, d-dígame.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuriyama, sé que eres buena pintando, pero intenta no pintarle los cuadros a\nlos demás también.\nDiablos, piensa en una mejor forma de aprovechar tu talento...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0007",head="nat_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000005",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿Eh? ¡Ah, sí, entiendo!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_jta_000005",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“¡Profesor Kusanagi! No puedo creer que se sepa su nombre y no el mío.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjate de tonterías, tú misma prefieres que te llame así.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_jta_000006",ch="jta"},
},
ja={
{
name={"Estudiante A"},
"“Ah, claro. Ahora que lo dice, tal vez sí.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Vuelven las carcajadas al salón.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Es una lata, pero es parte de mi trabajo seguirles la corriente.Qué tontería...",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Observo a Kuriyama-kun.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Inexpresiva, al igual que hace un rato.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fgact",ch="奈津子",act="いいえ",loop=-1,size=2,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000006",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Espera, ¿está temblando?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"¡Está temblando! ¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fgact",ch="奈津子",act="停止",lv=4,id=9},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0007",head="nat_z1a",lv=4,id=9},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000007",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0200",face="b0012",head="nat_z1b",lv=4,id=9},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0012",head="nat_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0008",head="nat_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ntd_000008",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah, eh, auhhh.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Apenas nuestros ojos se cruzan, Kuriyama-kun baja la mirada.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Definitivamente es tímida... No encuentro otra forma de describirla...",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Ese día atendí otras tres horas intermitentes de clase.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Siendo profesor de tiempo parcial, me quedo sin nada que hacer cuando mis\nclases no son continuas.",
{"rt2"},
},
},
},
linkback="block_00234",
