astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le di la vuelta al edificio de aulas y traté de salir por el portón frontal del\ncolegio, pero llegué a ver un extraño grupo de gente afuera, así que me di\nrápidamente un giro en dirección contraria.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",file="se0110",id=1,loop=1},
{"msgoff"},
{"bg",file="bg063a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al salir por el portón trasero y llegar hasta el templo, me encuentro con\nToritani.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1c0100",face="c0001",head="mak_z1c",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani estaba observando silenciosamente el cielo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"se",stop=1,id=1,time=500},
{"bgm",file="bgm035"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002358",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"La mirada de Toritani se dirige hacia mí.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002359",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es un genio para ti?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002360",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para mí, genios son... aquellos capaces de alcanzar esa luna.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002361",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Personas que viven en otro mundo completamente distinto al mío.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002362",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y que pueden volar hacia la luna con su ilimitada y libre imaginativa...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002363",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Recuerdo que hace tiempo, en una novela de misterio que leí de niña, había esto\nescrito. El título tenía algo con un gato, o un triángulo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002364",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Una imaginativa de vanguardia es capaz de dar saltos hacia lugares aún no\nalcanzados, pasando por encima de toda razón, palabra o teoría.'”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002365",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Solo aquellos que logran saltar hacia ese lugar pueden tomar esa inspiración\npara ellos'”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002366",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Es después de eso que las personas ordinarias desarrollan minuciosas razones y\nteorías, pavimentando el camino para llegar hacia allá.'”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002367",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo los genios pueden volar hacia la luna. Y las personas ordinarias\nconstruyen el camino hacia ella, tratando de darle acceso a los demás...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002368",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cada vez que surge una nueva expresión artística en el mundo, son muchos los\nque dicen 'Incluso yo podría dibujar esto'.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002369",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, esa expresión nunca existió sino hasta el momento en que su\ncreador la hizo aparecer. Si lo ponemos en términos simples, se trata de eso.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Toritani devuelve su mirada hacia el cielo. Estrecha sus manos, y en la punta\nde ellas estaba la luna del mediodía.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002370",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cry for the moon...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002371",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace mucho tiempo, de niña, yo lloraba y pataleaba, pidiendo la luna.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002372",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era muy, muy tonta.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg063a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Toritani baja sus manos. Y entonces, me vio directamente a los ojos.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002373",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002374",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Crees que el hombre puede salvar al hombre?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puede.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así sucedió con Komaki y el padre. Solo el hombre puede salvar al hombre.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suponiendo que hubiera manera de ser salvado por algo más, eso sería solo una\nmaldición muy parecida a una salvación. O quizás, una maldición desde un\nprincipio.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002375",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... lo mismo pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Toritani baja su mirada, y luego vuelve a subirla.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Su mirada no tiembla, ni vacila. Con un tono silencioso, Toritani dice lo\nsiguiente.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002376",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay un lugar al cual quiero que me acompañes.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002377",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No será esta la primera vez que vienes acá?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que sí.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"cgdel",id=-1},
{"bg",file="bg013b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Toritani se detiene frente al cuadro que adornaba el ayuntamiento. Me paro a su\nlado, y lo observo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002378",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace un rato, cuando tú y esa mujer estuvieron hablando en la azotea, ambos\ntrataron de hacerme escuchar la conversación, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002379",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En esos momentos me doy cuenta de lo infantil que soy.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002380",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ella sabía que yo no le prestaría atención, así tratara de decirme las cosas\ndirectamente. Así que recurrió a ese método... Eso pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿conoces la canción de la cabra negra y la cabra blanca?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002381",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... La conozco. ¿Qué sucede con esa canción?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cabra negra le escribe cartas a la cabra blanca, pero esta termina\ncomiéndoselas. La cabra blanca le escribe cartas a la cabra negra, pero esta\ntermina comiéndoselas.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En la canción de la cabra blanca y la cabra negra hay un tercer personaje que\nactúa en las sombras y es indispensable en la historia. ¿Sabes de quién se\ntrata?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002382",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Toritani piensa un rato, y da su respuesta.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002383",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El cartero?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Es necesario e indispensable un cartero entre la cabra negra y la cabra\nblanca.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A medida que la cabra negra y la cabra blanca repitan decenas, cientos de veces\nlo mismo, en algún momento el cartero podría darse cuenta de la verdad.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y entonces, puede que el cartero actúe como mediador entre las dos.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cartero es la única persona que puede ponerse entre la cabra negra y la\ncabra blanca, y darle fin a ese ciclo eterno.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En este caso, fue la cabra negra quien se dio cuenta de eso primero, y por eso\nla directora quiso hablar conmigo... Teniéndome a mí como mediador entre tú y\nella.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Hay otras razones por las cuales la directora quiere hablar conmigo, sin\nembargo, no pasan de ser más que sentimentalismos por su pasado. No tengo\nrazón para hablarle a Toritani de eso.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002384",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Toritani se queda quieta y en silencio por un rato, y luego lanza un largo\nsuspiro.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002385",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente nos parecemos bastante. Ella y yo.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002386",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Igual de torpes las dos... Esto es realmente de lo peor.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"El ayuntamiento en medio del atardecer estaba en silencio, y no había ni una\nsola persona que pasara por el lugar donde el cuadro estaba colgado.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"En medio de ese solitario espacio, el silencioso susurro de Toritani resuena,\nllegando solo a mis oídos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002387",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace mucho tiempo...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002388",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta pintura me salvó.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002389",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Desde entonces, tuve algo que vine temiendo todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002390",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que mi odio, mi rencor por ella volviera a inflarse una vez más.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002391",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A veces me pongo a pensar en que... ¿No será que al fondo de ese pozo de agua\nque es mi corazón, quedan todavía los sedimentos de ese odio que quedó tras\nla tempestad?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002392",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... En que, quizás, si algo llegara a agitar ese pozo, los sedimentos podrían\nresurgir y enturbiar de nuevo el agua. Quizás esta paz es solo algo temporal,\ntransitorio.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002393",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En el fondo de mi corazón podría quedar aún odio por ella. Llegar a descubrir\neso me daba miedo...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002394",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso seguí insistiéndote en que no te acercaras a ella.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002395",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto, no mentí cuando dije que me desagradaba que te usara a ti y al\nclub de arte. Pero, la verdadera y principal razón era esta.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002396",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tenía miedo... Sin embargo, eso no llegó a suceder.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002397",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cada una de las cosas que hace esa mujer me irritan. Aún no he podido organizar\nbien las ideas y sentimientos en mi mente.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002398",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, allí quedó todo. No hubo más nada. Y por eso, estoy aliviada\nahora.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dices que esto te salvó?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002399",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Tu cuadro fue mi salvación.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002400",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perdona que te cuente algo tan extraño. Pero quería que lo supieras.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002401",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, la verdad es que hay algo más que quisiera que supieras también...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes contarme lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002402",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002403",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero dame solo un poco más de tiempo. ¿Crees que puedas esperar un poquito más\npara escuchar todo lo que tengo que contarte?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo preguntes...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002404",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg066b",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm019"},
{"text"},
text={
ja={
{
"Me siento al lado de una niña leyendo tranquilamente un libro, en el mismo\nlugar que la vez pasada.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="寧",size="z2",mode=3,resize=1,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000034",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Ah.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpa que te interrumpa la lectura.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000035",ch="nei"},
},
ja={
{
name={"Nei"},
"“No, está bien.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te vi en la parada de buses, así que pensé que estarías acá. ¿Hoy te viene a\nbuscar tu mamá?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000036",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí. Y por eso estoy esperándola acá ahora.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Bien, te daré esto entonces.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Dejo caer un montón de caramelos sobre las paginas abiertas de su libro. Los\nojos de Nei se van abriendo cada vez más.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000037",ch="nei"},
},
ja={
{
name={"Nei"},
"“Son muchos caramelos.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Pero no es la ración para los días siguientes, sino por todos estos\ndías que no nos hemos visto. Por todo el esfuerzo que has venido poniendo\nhasta ahora. Así que puedes comer tantos como quieras y cuando quieras.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0005",head="nei_z2i",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0004",head="nei_z2i",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000038",ch="nei"},
},
ja={
{
name={"Nei"},
"“Pero son tantos... no tengo manera de pagarle.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te los doy porque quiero, no tienes por qué pagarme.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000039",ch="nei"},
},
ja={
{
name={"Nei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Nei se me queda viendo fijamente. Le devuelvo la mirada, sin parpadear.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="寧",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000040",ch="nei"},
},
ja={
{
name={"Nei"},
"“Está bien. Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0004",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000041",ch="nei"},
},
ja={
{
name={"Nei"},
"“Pero quisiera agradecerle de alguna forma.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lee ese libro para mí entonces.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000042",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Solo eso?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Por cierto, ¿tienes alguna bolsa para guardar los caramelos?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000043",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Nei saca una pequeña bolsa de tela de su mochila.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Al abrir la bolsa, vierte con cuidado los caramelos adentro. Al terminar de\nguardarlos todos, esta cierra por un momento el libro infantil.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"En la portada había una luna, unas escaleras y un conejo dibujados.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000044",ch="nei"},
},
ja={
{
name={"Nei"},
"“Este libro me lo leyó alguien a mí. Quizás no pueda leerlo tan bien como esa\npersona, pero lo haré lo mejor que pueda.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Nei comienza a relatar, despacio. Esa era la historia de un conejo fascinado\ncon la luna.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"El conejo, fascinado por la luna, huye de la niña que hace de protagonista, y\nusa unas escaleras para ir a la luna.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000045",ch="nei"},
},
ja={
{
name={"Nei"},
"“'El conejo observaba la luna, como si estuviera hechizado por ella'”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0004",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000046",ch="nei"},
},
ja={
{
name={"Nei"},
"(¡No! ¡No debes dejarte cautivar por la luna!)",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Al llegar a esa parte, Nei paró.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000047",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Por qué el conejo habrá pensado en huir de la niña?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000048",ch="nei"},
},
ja={
{
name={"Nei"},
"“Yo preferiría estar en casa con mi mamá.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente alguna clase de impulso llevó al conejo a hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000049",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Un impulso?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Yo también soy de los que prefiere su casa sobre todo, así que no logro\nentender muy bien eso que hizo. Es de lo mejor quedarse en casa sin hacer\nnada.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="うなづく",size=10,time=300,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000050",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000051",ch="nei"},
},
ja={
{
name={"Nei"},
"“Pero, aun si no tuviera una casa, me bastaría con que mamá estuviera conmigo.\nSolo con tener a mamá a mi lado estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0005",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000052",ch="nei"},
},
ja={
{
name={"Nei"},
"“Las otras personas que también están en rehabilitación me han dicho que le he\ncostado mucho dinero a mi mamá. Me da mucha pena eso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0004",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000053",ch="nei"},
},
ja={
{
name={"Nei"},
"“Pero quiero curarme, sea como sea.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0005",head="nei_z2i",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0004",head="nei_z2i",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000054",ch="nei"},
},
ja={
{
name={"Nei"},
"“Quizás esté en este estado ahora, pero quisiera curarme, volverme capaz de\ntrabajar pronto y proteger a mi mamá.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No importa lo que te digan los demás. Sigue luchando por recuperarte, y no\ndesistas de tu rehabilitación. Digan lo que te digan, si ese es tu deseo\nentonces ve por él.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"fgact",ch="寧",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000055",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Nei asiente. Su expresión luce indiferente, pero da a sentir una fuerte\nvoluntad. A pesar de ser aún joven, esta muchacha está realmente determinada\na proteger a su mamá.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nur_000012",ch="nur"},
},
ja={
{
name={"看護師"},
"“Nei Onda-chaaan. Ah, así que estabas acá. Tu mamá te llama por teléfono.\n¿Podrías venir a la estación de enfermería?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="寧",size="z1",mode=3,resize=1,path=":fg/nei/z1/",file="nei_z1i0000",face="i0006",head="nei_z1i",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_nei_000056",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Nei me ve, y baja la cabeza apenada. Y entonces, abre su bolsito e intenta\nregresarme la mitad de los caramelos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0005",head="nei_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000057",ch="nei"},
},
ja={
{
name={"Nei"},
"“Lo siento, solo pude leer la mitad del libro. Así que le regresaré la mitad de\nestos caramelos.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es todo lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0006",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000058",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Todo lo contrario?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hecho de que me hayas leído hasta la mitad vale tanto como todos esos\ncaramelos que tienes en la bolsa. Si me hubieras leído hasta el final\nentonces hubiera tenido que volver a traerte más caramelos. Así que no\nimporta, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000059",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Nei da su aprobación, pero con una cara algo extrañada. Tomó los caramelos de\nsu mano y los regresó a su bolso.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000060",ch="nei"},
},
ja={
{
name={"Nei"},
"“Muchas gracias. Me iré entonces. Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"msgoff"},
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
{"ex",time=1500,func="wait"},
{"se",file="se9012",vol=50,id=1},
{"fg",ch="寧",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Al despedirse bajando la cabeza, Nei se va junto a la enfermera a su lado....\nQuizás su madre no pueda venir a buscarla hoy tampoco.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"bg",file="eveningsky_winter",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="man_jrb_000004",ch="jrb"},
},
ja={
{
name={"Cliente B"},
"“Hasta luego, gracias por la comida.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"se",id=1,file="se2225"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002405",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias por venir.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Uno de los clientes habituales de la hora de la noche sale del local. Ya ha\nbajado en gran parte la cantidad de clientes adentro.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Estoy ahora estudiando por mi cuenta en el mismo asiento de siempre. Me fui a\nla casa Natsume, preparé la comida y luego me vine acá, a Quimera.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se_koton",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002406",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ten, agua.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Toritani me sirve algo de agua en mi vaso vacío.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, gracias.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002407",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Toma también esto. Uno de nuestros clientes habituales nos lo dio, así que te\ndaré un poco a ti también.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Toritani deja un dulce puesto sobre un pequeño plato. Era un dulce japonés con\nuna simple forma de conejo.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Trayendo regalos a un local de café, eh.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0003",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002408",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es lindo, ¿verdad? Parece que le llaman 'Gyokuto', y se refiere a un conejo que\nvive en la luna...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un conejo que vive en la luna...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Lo observo fijamente, y luego le pego un mordisco a la parte de la cabeza.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bueno.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0003",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002409",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, a mí también me gustó el sabor.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes a un conejo viviendo en la luna. ¿A pesar de eso sigues creyendo que\nformas parte del grupo de los que no pueden volar a la luna?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002410",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me parece que no tiene nada de lógica poner en duda si soy o no de esa clase de\npersonas usando como argumento a un conejo que vive en la luna, pero...\nbueno, da igual.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002411",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, creo que por lo menos sería capaz de tomar una escalera para llegar a ella.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es como lo que dijiste en el templo. 'Las personas ordinarias desarrollan\nminuciosas razones y teorías, pavimentando el camino para llegar hacia allá.'”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002412",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Pero es lo único que puedo hacer. Más allá de eso se me hace imposible.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es ya bastante con eso?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0010",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0017",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002413",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué estás diciendo? Tú eres de los que si pueden volar a la luna, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo creas.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás sobreestimando demasiado. No pertenezco a ese grupo. A lo sumo,\nquizás, pueda ser el conejo que ve a la luna, cautivado con ella.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002414",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002415",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al conejo le encanta la luna... ¿Conoces ese libro? Aunque el nombre no es así.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo conozco. Veo que tú también, eh.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002416",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De vez en cuando le leo libros a los niños.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani... ¿Te tomas el tiempo para hacer eso también a pesar de lo ocupada\nque estás?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002417",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A veces, solo a veces. Solo en aquellos momentos que hace falta gente para\natenderlos. Aunque, bueno, es bastante divertido también lidiar con los\npequeños que se comportan mal.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"En pocas palabras, está ayudando a alguien en algún lado. De verdad, que mujer\ntan ajetreada.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002418",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Encantado con la luna, un día el conejo apoya unas escaleras sobre ella para\nllegar allí. La historia relata cómo la niña que protagoniza el libro\npersigue al conejo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002419",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si tú eres el conejo, entonces yo soy la que debería hacer la escalera y\nobligarte a ir a la luna.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puede que me cautive la luna, pero no. Creo que prefiero quedarme en mi casita.\nEs de lo mejor quedarse en casa sin hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002420",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No le encuentro absolutamente ninguna lógica a lo que dices...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La hay. Hay personas que a pesar de quedar fascinadas con algo igualmente no\nhacen nada, ¿no? Así soy yo, un perezoso.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0010",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002421",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y crees que un perezoso se tomaría el tiempo para meterse en los asuntos de\nlos demás como lo haces tú?... Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002422",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Qué tanto has avanzado hoy?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De aquí hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002423",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jee... no estás nada mal. ¿No quisieras probar a hacer un examen corto?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me digas que vas a hacerlo tú, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002424",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro que no. Solo tomaré algunos de los problemas que salen en el libro de\ntexto. No te fue tan mal con los que hiciste la vez pasada. Dame un momento.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1c0900",face="c0001",head="mak_z1c",lv=4,id=9},
{"ex",time=100,func="wait"},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Toritani verifica el estado del local, y al corroborar que no había ningún\nproblema, subió al segundo piso...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Y volvió justo después.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002425",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí está. Estos son los problemas de la prueba, y esta es la explicación para\ncada uno. El texto de explicación es muy bueno y detallado, así que procura\nno solo resolver el problema sino también leer y entender muy bien cómo se\nhace todo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002426",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Toritani, cruzada ligeramente ahora de brazos, pone una expresión pensativa.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002427",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias a todo este estudio probablemente puedas pasar las pruebas de mitad y\nfinal de período sin reprobar ninguna asignatura. Pero el problema son ahora\nlos exámenes de ingreso a la universidad.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002428",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, las matemáticas se te dan muy bien, ¿te parece intentar apostarlo\ntodo a tus calificaciones en ellas? ¿No tienes alguna visión o aspiración\nrespecto al ingreso a la educación superior, o... alguna universidad en\nconcreto a la cual quisieras entrar?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A dónde vas a ir tú?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002429",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, yo...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Toritani me dice el nombre de la universidad. Yo también conocía esa\nuniversidad.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces yo también iré por esa. No hay problema con que la tenga como objetivo\npor ahora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002430",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues si te preparas para las materias del examen nacional que esa universidad\nrequiere podrías complementar las calificaciones de la prueba secundaria en\nla gran mayoría de las universidades publicas y nacionales, pero...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no hay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002431",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Por qué la expresión tan aturdida?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002432",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no... solo que me pareció algo inesperado. Pensé que odiabas estudiar. No,\nbueno, supongo que lo más correcto sería decir que no te gusta hacer cosas\nfuera de tus áreas de interés.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002433",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso pensé que tirarías la toalla con las asignaturas que odias e\nintentarías aspirar a algún lugar que solo te exigiera aquellas que si se te\ndan bien...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa sería una alternativa, pero siempre se puede cambiar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002434",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni creas que entraré a una privada. Así como estoy ahora quiero optar por una\nnacional o una pública.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002435",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre pareces ser bastante descuidado e irresponsable, pero lo has estado\npensando bien...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un poco.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002436",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes probar entonces a resolver los problemas de mis libros akahon la próxima\nvez. Tengo bastantes que te puedo recomendar, te los prestaré en unos días.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ouh, te lo agradecería.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002437",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vale.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Quimera cierra sus puertas.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Asiento satisfactoriamente mientras observo el montón de libros de textos y mis\napuntes. Vaya que he avanzado bastante, eh.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z1",mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002438",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, sí que has avanzado. Buen trabajo.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Una taza de café y unos onigiris son dispuestos frente a mí.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"¿E-Espera, onigiris...? Mis ojos se ven atraídos hacia esos calientes y\nhumeantes onigiris.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Después de hacerme sonar la garganta tragando saliva, alzo mi mirada y veo a\nToritani, examinando su expresión.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Puedo?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002439",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro. Es mi muestra de agradecimiento, tómala.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hice algo para que me estés agradeciendo ahora?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002440",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo has hecho, ¿no? Salvaste a Kei cuando se cayó de las escaleras, y además\nayer entraste a trabajar para ayudarme, entre otras cosas... Cada vez son más\nlas deudas que tengo contigo.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que no te preocupes por eso.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Aprovecho y sin esperar un segundo más, me como los onigiris mientras respondo\ndespreocupadamente eso. Aunque Toritani no parece estar muy de acuerdo.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002441",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí sí me preocupa.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí no.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002442",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque a ti no, a mí sí.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muéstrame tus pantis entonces.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0006h",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002443",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡De ninguna forma lo haré!!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa... es justamente esa cara que pones.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008h",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002444",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me basta y me sobra con que pongas esa avergonzada expresión que tienes ahora.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0017h",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002445",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quieres decir, que las pantis no te importan?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las pantaletas no son mi objetivo.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0017h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002446",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, también quiero ver pantaletas. Sencillamente me muero por verlas.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002447",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Estás consciente de que no tiene nada de sentido lo que estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002448",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bastante que me has pedido que te muestre hasta ahora, y hace poco, cuando te\ndije que podría mostrártelas no quisiste...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002449",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No será que realmente no tienes interés alguno por ellas?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo estoy guardándome las deudas para después. Acumularé más, y haré que me\nmuestres algo aún mejor.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, haré que me muestres una pose vergonzosa tuya por tanto tiempo como me\nplazca!”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0006h",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0011h",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002450",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡Mm!!! ¡F-Fuiste tú quien decidió sin mi consentimiento eso, ¿no?! Y-Yo... no\nhe dicho, que sí, en ningún momento...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, solo espera con ansias.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0005h",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002451",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es lo que debería esperar con ansias?... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002452",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente eres indescifrable, Kusanagi. Nunca sé si estás bromeando o dices las\ncosas en serio.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Por lo general me muevo siempre en base a mis ocurrencias.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002453",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Solo en base a tus ocurrencias? Me cuesta creer eso...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Créeme que no miento. Ocurrencias, lindas ocurrencias.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_05_1"},
{"text"},
linkback="block_00240",
},
label = {
top={block="block_00000",label=1},
},
}
