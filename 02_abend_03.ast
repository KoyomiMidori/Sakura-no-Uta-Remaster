astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"se",file="se9027",loop=1,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm... ¿Teléfono?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Un escandaloso sonido esfuma mi sueño de domingo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Un peculiar, y estruendoso sonido. Y, es que en el pasillo de la casa de los\nNatsume aún está presente y trabajando un nostálgico y viejo teléfono a\ndisco.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nguh... Demonios...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Al revisar el reloj, este marcaba aún un poco antes de las 8 AM...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero para qué demonios... llaman un domingo...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Debe ser una llamada para alguno de los Natsume, pero dudo que la gente de esta\ncasa pueda levantarse con el timbre del teléfono....",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué lata...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se2516"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, familia Natsume, ¿qué desea?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000973",ch="mkd"},
},
ja={
{
name={"???"},
"“¿Vaya? Repentinamente me atendió Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién es?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000974",ch="mkd"},
},
ja={
{
name={"???"},
"“¡Date cuenta por la voz! ¡Estoy llamando a la casa de los Natsume y yo sí me di\ncuenta de golpe de que eras tú!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa arrogante forma de hablar... ¿Toritani o Akashi?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000975",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿De qué manera se te ocurrió esa pareja de opciones?! ¡¿No te parece\ndescabellado?! ¡¿Por qué dudas si soy yo o Akashi-senpai?!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces llamando a estas horas de la mañana?... Es domingo, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000976",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí te habías dado cuenta... Por Dios. En fin, tengo algo que quisiera discutir\ncontigo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Discutir?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000977",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, discutir. O, para ser más precisos, diría que tengo algo que preguntarte...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo que preguntarme, eh. ¿Y qué? ¿No puede ser por teléfono?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000978",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ser posible, quisiera que nos viéramos en persona. El tema es algo\nintrincado...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Una conversación que no puede darse por teléfono... No me da muy buena espina\neso.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Aunque no puedo ignorar a Toritani después de que me dijo que se trataba de\nuna discusión.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Iré a cambiarme y saldré apenas termine... Sí, creo que llegaré allá a eso de\nlas 10.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000979",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo, gracias. En fin, te espero en la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"se",id=1,file="se2516"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo que preguntarme, eh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No tengo ni idea de lo que podría ser...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000421",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Quién llamó?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? ¿Ai? No estás atontada por el sueño, eh.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000422",ch="aid"},
},
ja={
{
name={"Ai"},
"“Escucha, no es que realmente me la paso todo el tiempo atolondrada por el sueño\nen las mañanas.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así quisiera que fuera. En fin, esa llamada fue para mí.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000423",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Para ti?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, parece que Toritani, del club de arte, tiene algo que consultarme, así que\nme iré ya al colegio.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000424",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio? Debe ser terrible tener que ir en un domingo.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vuelvo de nuevo a las clases suplementarias al comenzar la semana, y aun\nasí me llamó, a pesar de que hoy es mi único día de descanso.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000425",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí. Y gracias eso, yo también tengo que ir al colegio para hacer los\npreparativos de las clases suplementarias. Creo que en ese sentido, realmente\nsoy bastante desafortunada.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0016",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000426",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y solo era una broma. La verdad es que tengo otra cosa que hacer hoy. ¿No\nquieres aprovechar de ir conmigo?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente quisiera evitar montarme en tu motocicleta de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000427",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajaja... Lamentablemente, hoy me toca irme en tren a mí también.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, últimamente te has ido todos estos días en tren, ¿sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000428",ch="aid"},
},
ja={
{
name={"Ai"},
"“Se trata de una motocicleta muy vieja, lleva mucho trabajo consigo. Sobre todo\nen los períodos muy húmedos se tiene que montar frecuentemente.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Ahora que lo menciona, en las épocas de lluvia siempre deja la motocicleta en\nel almacén.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Aunque de igual manera no creo que pueda ni sea recomendable ir en días de\nlluvia al colegio con la motocicleta...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, tren, eh... ¿Nos vamos juntos entonces?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000429",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, yo me encargaré de preparar el desayuno entonces. Tampoco has comido, ¿no,\nKusanagi?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿V-Vas a cocinar, Ai?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000430",ch="aid"},
},
ja={
{
name={"Ai"},
"“A qué se debe esa actitud... Seguro Kei te dijo que cocino terriblemente mal,\n¿no? Pero esas son solo falsas acusaciones.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Aunque realmente no parecían ser falsas acusaciones...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000431",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No es obvio? Yo soy una profesora.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, el hecho de que alguien sea profesor no implique que sepa\ncocinar...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000432",ch="aid"},
},
ja={
{
name={"Ai"},
"“Muh... Tomaré esas palabras como un desafío hacía mí.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no es ningún desafío, pero...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"bg",file="ev_com_a32_01",path=":ev/ev_com_a32/",set="ev_com_a32"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_aid_000433",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué pasa, Kusanagi? Vamos, come sin pena.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"¿Es esta la comida que Kei dijo que alborotaba incluso a la ciudad?...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_a32_02",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
ja={
{
"A juzgar por su aspecto... No parece ser tan peligrosa...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Aunque, aun así, no se puede juzgar el sabor de la comida por su aspecto\nexterior...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Por ejemplo, es absurdo decir que un asesino llevará una pinta de asesino.\nProbablemente el asesino se vista igual que las personas normales. Obviamente\nno va a andar llevando una ropa muy llamativa.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"De ser así... Esntonces es capaz que incluso este platillo asesino...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_aid_000434",ch="aid"},
},
ja={
{
name={"Ai"},
"“Oye... ¿Por qué andas murmullando desde hace un buen rato? Además, ¿qué quieres\ndecir con eso de asesino?...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, no te preocupes. Simplemente expresé mi opinión acerca de la comida.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_aid_000435",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No te parece demasiado descortés opinar eso respecto a una comida?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, simplemente se trataba de una expresión metafórica. No lo dije tratando\nde certificar el potencial letal de tu comida ni nada de eso, Ai.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_aid_000436",ch="aid"},
},
ja={
{
name={"Ai"},
"“Realmente eres muy descortés.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000437",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, vamos, di 'A i u e o'”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_a32_02",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000438",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Vamos, dilo ya! ¡Rápido!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aiue?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_aid_000439",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Eso fue muy rápido! Dilo de forma más lenta, y abriendo más la boca.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"¿Qué es lo que está diciendo? Primero me pide '¡Dilo rápido!' y ahora me dice\n'¡Vas demasiado rápido!'...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"se",file="se9030",id=1},
{"bg",file="zev_com_a32_03",zoom=100,x=50,y=-390,speed=250,time=0,z2=50,path=":ev/ev_com_a32/",set="ev_com_a32",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"cgact",file="zev_com_a32_03",act="うんうん",x=50,y=-390,zoom=100},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Ai lanza un bocado de comida en mi boca en el instante en que la abrí.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_a32_03",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
ja={
{
"Lo que entró en mi boca fue la comida de Ai.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"El sabor de su comida se extiende por mi boca... eso es...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es comible...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_a32_02",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000440",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu... Pero qué tipo tan descortés de verdad, eh... vamos.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que comible, diría que más bien... está bueno.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000441",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fufu... Obvio que lo está.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero Kei dijo que...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_aid_000442",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No te lo dije ya? De que solo eran falsas acusaciones por parte de Kei.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... Ciertamente, está bueno esto...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_aid_000443",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Ai me observa sonriente.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué me ves sonriendo? ¿No vas a comer, Ai?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_aid_000444",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, n-no es la gran cosa... lo siento...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_aid_000445",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajajaja, yo también comeré. Comamos juntos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_000446",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Oh? Llevaba tiempo sin prepararlo, pero no está nada mal, eh. Quedó muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Llevabas tiempo sin preparar esto?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_000447",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Quedó tan bueno que realmente no pareciera que llevara tiempo sin prepararlo...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Lo que Ai preparó fue arroz frito. Aunque parezca sencillo, es un platillo con\nmucha profundidad en su preparación.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Es necesario tener bastante habilidad para hacer que quede así de suelto el\narroz.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Una sartén bastante caliente. Bastante aceite.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Básicamente, más que salteado, el arroz frito se prepara friéndolo con bastante\naceite.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Aunque aun así, tampoco se le puede agregar tanto aceite.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Es el plato que más velocidad requiere, y es además de esos platillos que no\npueden arreglarse tan fácilmente después de fallar en la preparación.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"No es simple de preparar.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está muy bueno...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Y si se trata de un plato que alguien más me prepare, más sabroso aún.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_aid_000448",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me alegra eso. De vez en cuando tengo que actuar como una onee-san.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Ai, ¿qué es lo que tienes que hacer en el colegio? Aunque, habías\ndicho que no era de mucha importancia...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_000449",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues, soy la supervisora del club, aunque solo de título.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Supervisora del club? Ah, del club de arte, te refieres.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_aid_000450",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues, en principio, hubiera sido bueno que el profesor Wakata se encargara,\npero...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Él no era acaso el supervisor del club de arte? Él mismo dijo que lo era.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_aid_000451",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues, el profesor Wakata también tiene unas cuantas razones de fuerza mayor en\nsu contra...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Razones?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_aid_000452",ch="aid"},
},
ja={
{
name={"Ai"},
"“Digamos que los profesores de tiempo parcial no pueden ser supervisores, en\nfin, circunstancias de adultos...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esa regla existe?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_aid_000453",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso es porque los de tiempo parcial pueden ser despedidos en cualquier momento.\nDe eso se trata...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué cuestión tan dura y mundana de escuchar. Y pensar que se trata de un lugar\npara educar.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿por qué entonces él se las da del supervisor del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_aid_000454",ch="aid"},
},
ja={
{
name={"Ai"},
"“Porque Kenichiro-san fue el supervisor de ese club también.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo mencionas, ese hombre también fue profesor de Yumihari, eh... Pero\n¿no era él acaso contratado por tiempo parcial también?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_000455",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, Kenichiro-san también era profesor a tiempo parcial. Aunque, esa es también\nuna de las razones por las que los profesores de tiempo parcial no pueden\nahora trabajar como supervisores de club...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, ¿es que acaso metió la pata en algo de nuevo?...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_000456",ch="aid"},
},
ja={
{
name={"Ai"},
"“No sé si realmente se le pueda decir así. Aunque bueno, ciertamente para el\ncolegio eso fue una 'metida de pata'.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sabes nada de lo que sucedió en aquel entonces?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_aid_000457",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ni idea. No conozco bien los detalles. Para la época aún era una niña.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eras aún una niña... Jum.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_aid_000458",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es, pero... ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me pareció que no has cambiado nada respecto a entonces...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_a32_04",time=400,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"ex",time=200,func="wait"},
{"se",id=1,file="se2192"},
{"bg",time=200,rule=056,file="black",path=":bg/"},
{"ex",time=600,func="wait"},
{"se",file="se9010",id=1},
{"bg",file="ev_com_a32_04",zoom=100,time=1000,z2=110,path=":ev/ev_com_a32/",set="ev_com_a32"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_aid_000459",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre... hablas más de lo necesario.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando aún eras una niña, eh...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_aid_000460",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué pasa?... ¿Piensas decir algo ridículo de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo ridículo... sí...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás sea algo ridículo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000461",ch="aid"},
},
ja={
{
name={"Ai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_aid_000462",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nunca te lo han contado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_000463",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san. Él vivía en esta casa.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aún eras una niña para ese entonces, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_aid_000464",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ciertamente, era una niña, así que no sabía mucho de lo que pasaba con él en el\ncolegio, pero recuerdo muy bien a Kenichiro-san cuando estaba en casa.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, aunque aun así no me interesa mucho.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="ev_com_a32_05",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000465",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajajaja, sea lo que sea siempre insistes en pretender que no te interesa en lo\nmás mínimo Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no pretendo nada, realmente no me interesa.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000466",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad? De ser así, ¿no te gustaría escuchar las historias acerca de\nMizuna-san? Apartando a Kenichiro-san de la conversación.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_a32_05",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000467",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajaja... Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000468",ch="aid"},
},
ja={
{
name={"Ai"},
"“Las historias de aquella época... Estaba él, estaba Mizuna-san, jajaja, ahora\nque lo recuerdo, el profesor Wakata también venía acá de visita.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Wakata venía acá?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_aid_000469",ch="aid"},
},
ja={
{
name={"Ai"},
"“En un principio fue alumno de Kenichiro-san, pero aun así, después de entrar a\nla universidad Kenichiro-san lo llamaba frecuentemente. Pertenecieron a la\nmisma universidad, así que en esa ocasión, lo llamaba como egresado. Él era\nabsolutamente egocéntrico y caprichoso, así que el profesor Wakata debe haber\npasado bastante trabajo también, eh.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí, era absolutamente egocéntrico, y fue además el mejor de los peores\nhombres...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_aid_000470",ch="aid"},
},
ja={
{
name={"Ai"},
"“El mejor de los peores hombres... Sí, de cierta forma eso representa lo que él\nfue. Esa manera de decirlo es bastante acertada.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_aid_000471",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, ¿ya no pintarás más?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pintar...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué preguntas eso a este punto?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_aid_000472",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿A este punto?... Pero antes pintabas todo el tiempo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Hace tiempo atrás era lo único que hacía...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_aid_000473",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Ya no pintarás más?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Tampoco dejé de pintar por alguna razón muy seria.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_aid_000474",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo... Entonces, avísame cuando llegue el momento en que llegues a pintar...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuando llegue el momento en que pinte algo?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_aid_000475",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cuando llegue ese momento te contaré... Las historias que tengo de\nKenichiro-san cuando yo era una niña y él vivía acá...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese momento, eh... En el peor de los casos, puede que nunca logre escuchar las\nhistorias de tu niñez, Ai.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_aid_000476",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mis historias no son el tema principal. Son, de fin a cabo, historias acerca de\nKenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí es así, entonces no hay necesidad alguna para mí de volver a pintar de nuevo\njamás.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_a32_05",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000477",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajaja, las historias de mi niñez no tienen ningún valor. En fin, no importa.\nVamos, la comida que te preparé se va a enfriar. Come rápido.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"En todo momento, únicamente Ai es siempre así, de esta manera.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Solo ella me escuchó de manera normal cuando anuncié, por primera vez, que no\nvolvería a pintar...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Solo Ai me trató así.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_a32_01",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000478",ch="aid"},
},
ja={
{
name={"Ai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Ai sigue observándome, aún con la cuchara puesta sobre la comida.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay de ti, no vas a comer? Se te va a enfriar la comida.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bg",file="ev_com_a32_05",sync=0,face=1,time=400,path=":ev/ev_com_a32/",set="ev_com_a32",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000479",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Ahh... Tienes razón... Jaja, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"excall",file="02_abend_04_1",cond="f.rinroute==1"},
{"excall",file="02_abend_04_1",cond="f.rnaroute==1"},
{"excall",file="02_abend_04_1",cond="f.shzroute==1"},
{"excall",file="02_abend_pi01",cond="f.makroute==1"},
{"text"},
linkback="block_00176",
},
label = {
top={block="block_00000",label=1},
},
}
