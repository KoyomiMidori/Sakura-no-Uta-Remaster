astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm031"},
{"bg",file="black",path=":bg/"},
{"se",id=1,file="se3157"},
{"ex",time=1000,func="wait"},
{"bg",file="bg050b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans"},
{"se",file="se9010",id=1},
{"fg",ch="吹",size="z1",mx=-40,mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000143",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿E-Esto es?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te dije que te quedaras quieta... ¿Por qué me seguiste?...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000144",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues, es que se sentía un olor muy bueno... ¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es butadon.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000145",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, he escuchado de varias leyendas concernientes a esta comida...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso da igual ahora, come.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0007",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000146",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bien, aprovecharé tu buen favor y me dispondré a comugahgahgahgah.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No tienes por qué ir tan rápido...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Aún sin terminar de decir lo que iba a decir, Sui se echó el butadon a la boca\ny comenzó a tragárselo con ímpetu.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Se veía como el butadon iba siendo absorbido por ese pequeño cuerpo.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Fue tan impresionante esa forma de comer que sin querer, me le quede observando\ndetenidamente sin hacer más nada.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000147",ch="sud"},
},
ja={
{
name={"Sui"},
"“Puhaa... estuvo riko. No hace falta ningún pago.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No eres tú la que decide si pagas o no.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000148",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Planeabas cobrarme con dinero?!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces gritando con esa expresión tan de 'me has engañado'?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0007",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000149",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Es que le has brindado a Sui algo por lo que pensabas cobrar, sabiendo que\nSui no tiene dinero en su posesión! ¡¿Es que eres una bestia?!\n¡Notsurugi-san!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya te dije que no soy Notsurugi!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000150",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Eres Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Si no te puedes recordar mi nombre, entonces llámame por mi apellido.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000151",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, así que aún no me dejarás llamarte por tu nombre... ¡Es posible que\nnuestra relación avance aún más! Eso quieres decir, ¿no es así? Lo entiendo\nmuy bien.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡NO TE DEJO LLAMARME ASÍ POR TÚ ANDAR EQUIVOCÁNDOTE CON MI NOMBRE!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000152",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eres tú el que está errado, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Errado respecto a qué?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0022",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000153",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Errado en tratar de aprovecharte de los demás y solicitar dinero sabiendo que\nSui no posee nada de dinero!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni siquiera sé si tienes dinero o no. Espera, ¿es que no tienes nada de dinero?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000154",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Nada!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Lo dijo de forma tajante.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Esta muchacha... ¿De verdad no se habrá escapado de su casa?",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Ese enorme equipaje, y el hecho de que no tenga dinero...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Aunque ella misma lo ha negado...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que no tienes dinero...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"se",file="se3130",id=1},
{"fg",ch="吹",size="z2",my=40,mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0018",head="sui_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000155",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ya lo sé! ¡Sé lo que sucederá ahora! ¡Piensas pedir mi cuerpo como pago al no\npoder ofrecerte dinero, ¿cierto?! ¡Vamos, puedes abusar del cuerpo de Sui\ntodo lo que quieras!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No voy a hacerlo! ¡Y esa no es la clase de cosas que se dicen irguiendo el\npecho con tanto orgullo!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000156",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Estaba resaltando mis senos!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"(No se nota casi la diferencia aunque lo hagas...)",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Contengo mi boca para que no se escapen esas palabras.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Eso sería ya demasiado descortés para una muchacha de su edad.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000157",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Por qué te quedas mudo con esa expresión tan incómoda?! ¡Tenías todo el\naspecto de estar pensando 'no tienes senos que resaltar' o algo por el\nestilo!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso, pero... en fin, no estoy pidiendo tu cuerpo ni nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0019",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000158",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Qu--?! ¡Insinúas que el cuerpo de Sui no tiene siquiera el valor de un\nbutadon! Pero qué humillación. Es tanta la tristeza que me dan ganas de\nllorar, uh, uhh...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No llores...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000159",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué debería hacer Sui entonces? No sirve persuadirte con mis lagrimas, ni\ntampoco pagarte con mi cuerpo... ¿Piensas acaso pedir mi vida?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería llegar a pedir eso por un simple butadon?...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000160",ch="sud"},
},
ja={
{
name={"Sui"},
"“Para mí, ese butadon fue lo que me hizo aferrarme a la vida. Tanto valor así\ntiene.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"¿Así de hambrienta estabas?...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, no hace falta que me pagues.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La culpa la tiene esa persona que maneja un almacén de butadon en este lugar a\npesar de ser un profesor...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000161",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya entiendo. La verdad es que no entiendo absolutamente nada de lo que sucede,\npero me has hecho un gran favor. Gracias a tu cordialidad mi pureza fue\nprotegida.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"No pongas en peligro tu pureza por esta clase de cosas... Esfuérzate un poco\nmás por proteger tu castidad.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Protégela tanto como Ai lo hace...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios... ¿Pero qué rayos eres--”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000162",ch="sud"},
},
ja={
{
name={"Sui"},
"“Soy Sui.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso lo sé.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000163",ch="sud"},
},
ja={
{
name={"Sui"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000164",ch="sud"},
},
ja={
{
name={"Sui"},
"“... La verdad, yo tampoco lo sé muy bien.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ni tú misma lo sabes?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0017",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000165",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, la verdad es que no logro entender como teniendo una hermosa chica como Sui\nenfrente no pusiste tus manos sobre ella, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, no digas eso teniendo una tabla por pecho, idiota.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000166",ch="sud"},
},
ja={
{
name={"Sui"},
"“No puedo pasar por alto esas palabras. ¡Sui no tiene tan poco pecho! Si\npensamos en el termino medio, se podría decir que están al nivel inferior\ndebajo del termino medio, pero con tendencia hacia arriba.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se entiende nada de lo que dices!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000167",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es que no entiendes? ¡¿Ja?!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0022",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000168",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es que acaso planeas tocarlos y confirmarlo por ti mismo después de decir eso?\nEres de ese grupete de los que fingen no saber nada y piden tocarlos para\nconfirmar, pero que en realidad se mueren por tocarlos, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué quieres decir con grupete...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000169",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ni idea, Sui tampoco lo sabe muy bien.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000170",ch="sud"},
},
ja={
{
name={"Sui"},
"“De verdad.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"... No entiendo nada.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0110",face="a0008",head="sui_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Sui.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000171",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace un rato estabas viendo a alguien, ¿verdad? Estabas observando fijamente\nencima de las escaleras a alguien que estaba en el pasillo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0017",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000172",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Viendo a alguien? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000173",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tal vez?... Vamos...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0011",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000174",ch="sud"},
},
ja={
{
name={"Sui"},
"“Lo siento. Realmente no lo sé muy bien.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No lo sabes muy bien?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000175",ch="sud"},
},
ja={
{
name={"Sui"},
"“No, no es nada. No te preocupes por eso, por favor.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bgm",stop=1,time=500},
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Parece que alguien entró a la sala de arte...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Traté de abrir la puerta de la sala de arte desde la sala de preparativos,\npero...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-500,lv=5,id=5,sync=0},
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x=500,lv=5,id=6,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001408",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué significa esto?!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fgact",ch="明石",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000321",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya te lo dije, es el dinero del presupuesto que debía hasta el día de hoy.\n¿Acaso no te dije un cierto día que no lo había gastado, sino que simplemente\nlo había tomado prestado? Por eso es que estoy regresándotelo ahora.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001409",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y por qué justamente en este momento?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_wtd_000322",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ahh, la culpabilidad me remordía por no poder regresarlo. Aunque con esto ya\nestá todo, ¿no? Todo el presupuesto que usé.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001410",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es lo que estás tramando?... Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_wtd_000323",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Tramar de qué?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001411",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto es como.. ¡Esto es como si trataras de pagarme una compensación por\nseparación!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_wtd_000324",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Pero qué rayos? ¿Por qué debería ser una compensación por separación?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg050b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto se puso mal... Eh, Sui.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sui?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"En el lugar donde Sui estaba sentada hace un momento no había nadie ahora.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sui?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",file="se9023",id=1},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=0,y=70,speed=500,file="zbg050i",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=0},
{"quake"},
{"text"},
text={
ja={
{
"Corro hacia la ventana.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Y es porque la ventana que hasta hace poco estaba cerrada, estaba ahora\nabierta. Esta sala de arte está en un cuarto piso.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Si llegara a haber saltado por esta ventana, entonces caerá hacia el primer\npiso.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Reviso las afueras desde la ventana, pero no parece haber ninguna silueta de\nalguna persona.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa esto?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"¿Será que bajó por la tubería de agua que está al lado?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"He oído que es un método bastante usado por los ladrones...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué desapareció de repente?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-500,lv=5,id=5,sync=0},
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x=500,lv=5,id=6,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001412",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Entonces por qué tuviste que comprar justamente unos uwabaki cuyas suelas se\nderriten?!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_wtd_000325",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya te lo dije, simplemente fue un pequeño error de mi parte.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fgact",ch="真琴",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001413",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Entonces por qué los compraste en talla para niños?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_wtd_000326",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso también, fue un error...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001414",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No te hagas el tonto! ¡Akashi-senpai, estás planeando hacer algo por tu\ncuenta, ¿cierto?!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fgact",ch="明石",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000327",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No estoy pensando hacer nada exagerado, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001415",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es por Komaki y por Kosachi, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_wtd_000329",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No es exactamente...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001416",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Piensas hacer que te expulsen?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="man_wtd_000330",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De qué estás hablando...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001417",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Akashi-senpai, lo que estás haciendo es meritorio de expulsión! ¡¿Planeas\nabandonar la escuela?!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_wtd_000331",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya dije que yo...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001418",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Piensas hacerte el tonto, y seguir pretendiendo, hasta el final... que no sabes\nnada, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_wtd_000332",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Hacerme el tonto? Vamos... Prefiero hacerme unos fideos de shirataki~”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",sync=1,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x2=-500,x=0,lv=5,id=5},
{"se",id=1,file="se1528"},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Un sonido seco resuena por la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Incluso desde el cuarto contiguo se puede saber lo que pasó.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-500,lv=5,id=5,sync=0},
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x=500,lv=5,id=6,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001419",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tú... planeas hacerlo todo, solo! ¡Sin confiar en nosotros... ni tampoco pedir\nnuestra ayuda, en ningún momento! ¡De eso se trata, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_wtd_000333",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001420",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya entendí. De ser así, entonces haz lo que se te venga en gana... Tengo un\ncampamento del cual ocuparme ahora... ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",id=1,file="se2308"},
{"fg",ch="真琴",mx=40,mode=-1,lv=5,id=5},
{"text"},
text={
ja={
{
"Toritani se fue.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Por los momentos, entré a la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"msgoff"},
{"bg",zone="0x000000",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=6,sync=0},
{"extrans",sync=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=6,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000335",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Es que estabas viendo, Kusanagi? Es de muy mal gusto andar escuchando a\nescondidas, eh~”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes la mejilla roja.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000336",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Digamos que me apeno fácilmente, nya~”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A las personas tímidas no se les pone roja una sola mejilla...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani parecía estar bien enojada. ¿Qué fue eso, una pelea pasional?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000337",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiota... No hay forma de que ella dirija sentimientos románticos hacia mí.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso dices? A pesar de todo, se la llevan muy bien los dos, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000338",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Realmente eres bien tardo en lo que a esos asuntos concierne, eh.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tardo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000339",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sea lo que sea, no hay forma alguna de que ella tenga sentimientos románticos\npor mí.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces por qué te golpearon?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000340",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por haber comprado puras cosas sin uso alguno, nya~”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, entonces no tiene sentido enojarse ya a este punto, ¿no? ¿Cuándo\nfue que reuniste todo ese montón de chatarra?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000341",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Cuándo habrá sido?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A comienzos de abril.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000342",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, Kusanagi, vaya que lo recuerdas bien, nya~”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te empeñas tanto en hacerte el tonto?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000343",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Hacerme el tonto? Vamos... Prefiero hacerme unos fideos de shirataki~”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",id=1,file="se2192"},
{"fgact",ch="明石",act="うなづく",time=75,lv=4,id=6},
{"fg",ch="明石",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000344",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso dolió! Teniendo papel y tijera usaste piedra. Me golpeaste con la mano\nhaciendo piedra.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, lo siento. Simplemente me sacaste de mis casillas por un momento.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000345",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Pero qué les pasa a todos? Apenas les digo el chistecito del shirataki me\ngolpean. La deficiencia de calcio es un gran problema nacional.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“También le dijiste lo mismo a Toritani, ¿no es así?... Pero qué chiste tan\nridículo...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=6},
{"fgact",ch="明石",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000346",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, cuando se lo conté me golpeó.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Pero esa no fue la razón. La razón por la cual te golpeó.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Akashi.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te uniste conmigo el año pasado aquella vez?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2b0000",face="b0001",head="aka_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000347",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿El año pasado? ¿Unirte contigo? ¿De qué estarás hablando?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota... no te hagas el tonto. Movimos una enorme cantidad de dinero. No hay\nforma de que se te haya olvidado.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2b0000",face="b0003",head="aka_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2b0000",face="b0002",head="aka_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_wtd_000348",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Dinero? Aaahh, te refieres a eso~ Pues, obviamente te ayudé por el dinero que\npodría ganar.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué necesitabas dinero?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000349",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, en todo momento se necesita dinero. Tú también te la pasas diciendo todo\nel tiempo dinero, dinero, dinero, ¿o acaso me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ¿vas a decirme eso tú a mí?... Idiota.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000350",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, lo mismo va para los dos, tonto.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En aquel momento me ayudaste. Y gracias a esa ayuda es que pude lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000351",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues sí, un mocosito como tú no podía haber hecho nada por su cuenta, eh~\nAgradece que alguien tan especial como yo estuvo ahí por ti.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿No te hace falta ayuda alguna para el problema que cargas encima\nahora?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000352",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De ninguna manera. Soy omnipotente y omnisciente, nya~ No requiero de la ayuda\nde nadie.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, qué más da.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero te advierto algo. Lo que estás tratando de hacer es meritorio de\nexpulsión, tal como lo dijo Toritani. En el peor de los casos te podría\nagarrar la policía.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicho de otra manera, es un crimen.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000353",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“... De eso ya tengo plena consciencia.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imaginé...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000354",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Demonios, ¿por qué será que ustedes andan tan esmerados en averiguar lo que los\notros hacen?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será que los demás te aprecian?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",lv=4,id=6},
{"fgact",ch="明石",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_wtd_000355",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿De veritas? ¿De veritas? ¡Entonces prepara mis comidas de ahora en adelante!\n¡Quisiera comer tu comida todos los días, Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",id=1,file="se2192"},
{"fgact",ch="明石",act="うなづく",time=75,lv=4,id=6},
{"fg",ch="明石",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000356",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kusanagi, eso dolió... Deja de golpearme a cada momento, la factura la pagará\nmi cuerpo después.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces deja de decir cosas tan asquerosas a cada momento...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000357",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En fin, si hay algo que puedo decirles ahora... es que este es mi problema.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000358",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es problema únicamente mío.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad será como lo dices?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sabes, ¿no? Lo que es eso.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es así, entonces sabes muy bien que no es solo tu problema.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000360",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No sé, ni me importa nada... Ese problema es mío, y mío nada más...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="明石",mx=-40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Al susurrar eso, Akashi salió también de la sala de arte, sin decir nada más.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Su expresión estaba oculta tras sus gafas de sol, y así como siempre, era\nimposible indagar en ella.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Ya esto dejó de ser solo tu problema...",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Y es que más bien es problema mío. Akashi...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"bg",file="bg057b",path=":bg/"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Volví a pararme frente a la iglesia, de espaldas a la pared.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"El lugar donde Akashi estaba parado.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Aunque, aun así, no logro dar con nada.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad no logro ver nada que me diga algo...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"se",file="se9004",id=1},
{"fg",ch="吹",size="z1",mx=-40,mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000176",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Estás tratando de espiar aun cuando no puedes ver nada? ¿Es que hay alguna\nhermosa muchacha hospitalizada?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hospitalizada? ¿De qué rayos hablas? ¿Me estás diciendo que estoy viendo un\nhospital?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000177",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. ¿Acaso no estabas observando el hospital?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El hospital?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Al escuchar eso, volví a ver en la dirección donde Akashi estaba viendo.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Por primera vez, comencé a sentir algo fuera de lugar en una edificación que\nhasta ahora, creí que solo era parte de un complejo de apartamentos.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será posible que ese edificio que parece un complejo de apartamentos es... un\nhospital?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000178",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. ¿Acaso no lo sabías? Aunque ciertamente no se puede observar enteramente\nel hospital desde acá, así que es razonable que no te dieras cuenta...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿por qué ver un hospital teniendo tantos edificios y casas alrededor?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0003",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000179",ch="sud"},
},
ja={
{
name={"Sui"},
"“Porque la pared de esta iglesia se puede observar muy bien desde las\nhabitaciones del hospital.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Desde las habitaciones del hospital?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000180",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Ya veo, son muchas las edificaciones que se ven desde acá, pero había pasado\npor alto un solo detalle.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Una edificación completamente paralela a la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Una estructura que permite ver bien afuera desde sus ventanas.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Casi todas las demás edificaciones no son completamente paralelas a la pared de\nla iglesia.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Hay cierta desviación en sus ángulos.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Y además, la gran mayoría de los edificios tienen la vista obstruida por sus\nbalcones, lo cual les impide ver la pared de la iglesia que se encuentra\ndebajo.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Son pocas las edificaciones con habitaciones de cuyas ventanas se pueda\nobservar la iglesia. Más bien, solo hay una.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0110",face="a0002",head="sui_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo sabes? ¿Es que acaso estuviste hospitalizada alguna vez antes?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0005",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000181",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Por qué será? No lo sé muy bien, pero Sui siempre aparece en los lugares y\nmomentos más inesperados.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"No lo digas tú misma...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A partir de qué piso se puede ver la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000182",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ni idea, eso tampoco lo sé.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En fin, gracias!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000183",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Jee? Ja, de nada.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bgm",stop=1,time=1000},
{"bg",time=500,file="black",path=":bg/"},
{"se",id=1,file="se0744"},
{"text"},
text={
ja={
{
"¿Aún estará allí?",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"No, aún no debería haberse ido. Por lo general los profesores se quedan en el\ncolegio hasta más tarde que los alumnos.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"En especial porque hoy fue el último día de las clases suplementarias. Y\ntambién presenté un examen bastante simple. Es difícil pensar que se haya ido\nya, tan temprano.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg058b",path=":bg/",sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"bgm",file="bgm016"},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0013",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000569",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Pero q--! ¡Idiota! ¡No me llames sin honorífico en el colegio!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, l-lo siento, profesora Ai. Aunque tengo algo que preguntarte.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000570",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué sucede? ¿Aún tienes preguntas a pesar de haber terminado las clases\nsuplementarias? Aunque ciertamente, la nota de tu examen de reparación de\ngeografía fue terrible, bordeando en la raya...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no me importa el examen de hoy. Quiero preguntarte algo respecto al padre\nde esa iglesia.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000571",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Del padre? Esto, ¿te refieres al padre Masada?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí. Es él.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000572",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué quieres saber? Yo tampoco sé mucho respecto al padre.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podrías darme su nombre completo, para comenzar?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000573",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Su nombre completo? Ehm... Si no me falla la memoria, creo que es el padre\nAkira Masada...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, respecto a ese padre Masada, ¿en dónde está hospitalizado? ¿Está, quizás,\nen el hospital que queda justo al lado del colegio Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000574",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es. Me parece que era el Hospital General Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El Hospital General Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000575",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, al parecer había una habitación libre en ese hospital de donde se podía ver\nla iglesia, así que decidió ingresar allí.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... Así que ese era parte del pabellón del Hospital General Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Tenía la imagen de que el hospital estaba construido a lo largo de la calle\nprincipal, así que no pensé que fuera contiguo al colegio Yumihari, pero\nparece que el área de su terreno era más grande de lo que yo pensaba.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque la imagen de ese edificio me pareció algo distinta a la del Hospital\nGeneral Yumihari que se ve desde la calle principal...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000576",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ahh, de ser por eso, entonces es porque lo que se ve de acá es el pabellón\nviejo, ¿no? El pabellón nuevo es espléndido, así que no es de sorprenderse\nque se te hiciera distinta la imagen. Aunque, ¿qué pasa con eso?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces el número de la habitación donde está hospitalizado?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000577",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esto... Dame un momento. Me parece que puedo averiguarlo...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bg058b",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0012",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000578",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es la habitación 402 del pabellón viejo. Esa es la habitación donde está\nhospitalizado el padre Masada. ¿Qué es lo que sucede? ¿Te dieron ganas de ir\na visitarlo de repente?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0001",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000579",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque creo que ya debe haber terminado el horario de las visitas...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, de lo que recuerdo no debería haber inconveniente con el horario de las\nvisitas, aun en la noche. En fin, iré de una vez.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0013",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000580",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, K-Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"se",file="se0744",vol=50,id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=280,time=300,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"De la iglesia se podía ver parte del pabellón, ciertamente, pero había bastante\ndistancia del colegio hacia el portón frontal de la calle principal.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Tal como lo sugiere el algo exagerado nombre de 'Hospital General Yumihari',\nrealmente es un hospital bien grande...",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Creo que pensé lo mismo hace más o menos medio año, ¿no?...",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es acá...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="bg066b",path=":bg/"},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_nur_000001",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“E-Espera un momento, muchacho.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_nur_000002",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Ya la atención general terminó por el día de hoy... Aunque si es por\nemergencias, la entrada está allí...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no vine a revisarme, vine de visita...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_nur_000003",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“¿Visita a familia?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es familia, pero...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_nur_000004",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Lo siento. Ya el tiempo reglamentario de visitas para aquellos que no son\nfamilia terminó. Tienes que venir un poco más temprano...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, creo que este lugar tenía una limitación de horario de\nvisita dependiendo de si se es familia o no, ¿cierto?...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_nur_000005",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Sí, lo siento. Y, de ser posible deberías solicitar una cita. Es frecuente que\nlas visitas repentinas no puedan pasar a ver al paciente.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. A veces los pacientes no están por revisiones o exámenes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_nur_000006",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Sí. Lo sabes muy bien, ¿no? Y bien, ¿a quién viniste hoy a visitar?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A Akira Masada, de la habitación 402 del pabellón viejo...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_nur_000007",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Ahh, Masada-san. Entonces tienes hasta mañana para visitarlo... ya veo, por eso\nes que viniste tan apurado.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quiere decir?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_nur_000008",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Vaya, ¿es que no sabías? El Masada-san de la habitación 402 recibirá una\noperación muy importante pasado mañana. ¿No es por eso que viniste apurado?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me dice que es pasado mañana?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_nur_000009",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Sí, tiene una operación planificada pasado mañana. Si vas a visitarlo, entonces\ndeberías hacerlo antes de ese día, de verdad.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es la enfermedad del padre Masada?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_nur_000010",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Pues... no creo poder responderte eso, pero... en fin, lo único que te puedo\ndecir es que pasado mañana recibirá una operación muy importante...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Una operación pasado mañana...",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podré visitarlo aún mañana?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_nur_000011",ch="nur"},
},
ja={
{
name={"Enfermera"},
"“Sí, este es el horario de visitas. Recuerda recibir primero el ticket de visita\nen la taquilla general 1, en el primer piso del edificio principal.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas gracias...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Su operación es pasado mañana...",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Justamente el día en que comienza el campamento.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_12"},
{"text"},
linkback="block_00278",
},
label = {
top={block="block_00000",label=1},
},
}
