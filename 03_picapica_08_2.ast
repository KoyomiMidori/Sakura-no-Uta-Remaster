astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,time=2000,sync=1,id=1,lv=5,path=":cg/",x2=-960,y2=-540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
"Al próximo día, después de clases――",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Toritani le informó por teléfono a la directora que necesitaba el jarrón de la\nurraca. Fuimos hasta su oficina, pero no estaba.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"De alguna u otra forma pudimos contactar con la dueña.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Realmente fue de muy buena suerte que pudiéramos contactar con ella,\nconsiderando que a pesar de tener celular es, por lo general, difícil\nconseguirle.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Al escuchar de Toritani lo que estaba sucediendo, la dueña accedió a entregar\nel jarrón de la urraca.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Parece que le dijo algo más a través del teléfono, pero Toritani no me contó\nnada al respecto.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Al mismo tiempo, la directora nos envió el número telefónico de la abogada.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003157",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muchas gracias por todo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Las palabras de agradecimiento hacia la directora salieron de forma serena de\nla boca de Toritani.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg070a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Entramos en la bóveda de la casa de la familia Toritani.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es aquí donde están tus jarrones?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003158",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, es por acá.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Al avanzar por la bóveda, apareció una puerta al fondo. Toritani sacó una\nllave.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Toritani sacó la llave de la gaveta con cerradura de números del escritorio de\nla oficina de la directora tras hablar con ella por teléfono.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"bg",file="black",path=":bg/"},
{"se",id=1,file="gatya"},
{"msgoff"},
{"bg",file="bg071a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este lugar es...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"El aspecto de la habitación que estaba tras la puerta no era muy diferente al\nde la bóveda. La única diferencia que podría señalarse es que no solo habían\ncuadros, sino también varios objetos de volumen variado.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Y con volumen variado me refiero a que había también una enorme cantidad de\nbasura que de ninguna forma se podría llamar artesanía.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Aunque debo reconocer que habían varias cosas que no eran por completo\nchatarra, con un extraño encanto en ellas.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003159",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta es la habitación de la directora. Había dicho que era casi como un\ndepósito, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La directora duerme aquí?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003160",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ni en broma. Tiene otra habitación para dormir.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Me dio algo de alivio saber eso. Siento que este no es un lugar apropiado para\nque una persona duerma.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Carece de ese característico aire que se respira en aquellos lugares donde\nhabitan personas. El tiempo está estancado y detenido en este lugar, como si\nfuera una especie de viejo depósito.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Esta habitación no está hecha para que alguien la habite. Fue preparada para\ntodos los 'objetos' que están cuidadosamente dispuestos dentro de ella.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003161",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay un montón de cosas raras acá, ¿cierto? Probablemente esta habitación le\nsirve a esa mujer para reunir y guardar todos los objetos que le gustan.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003162",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Objetos que la cautivan por razones absolutamente indiferentes a cualquier\nvalor artístico, comercial o histórico...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003163",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí solo hay objetos que esa mujer considera como 'deleitosos'.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que aquí también están tus jarrones?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003164",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ni idea. ¿Quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Toritani se encoge ligeramente de hombros.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003165",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En lo que respecta a mis jarrones, quizás estén acá por la facilidad que ofrece\neste lugar para almacenarlos. O tal vez no sea así. No lo sé, ni tampoco es\nalgo de lo que deba ocuparme en pensar.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003166",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y además, en todo caso, esos jarrones son un fracaso para mí. Sería bastante\nirónico que esa mujer considere esas piezas fallidas como una obra magnífica.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero te llegó a gustar el acabado final que tomaron los jarrones, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003167",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, pues... sí, digamos que sí.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"La percepción que tiene Toritani de los jarrones de 'La Luna y las Estrellas'\nes cambiante. Se podría decir que incluso contradictoria.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Toritani parece estar desconcertada respecto a la obra maestra que creó, y la\nmanera en que la valoración que se le dio fue mucho mayor a la que ella\nesperaba. Aun a pesar de ser producto de sus propias manos, me da la\nimpresión de que no sabe qué hacer con ella.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003168",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí están... son estos.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"se",file="se0897s",vol=50,id=1},
{"text"},
text={
ja={
{
"Allí estaban en fila 3 de los 4 jarrones de 'La Luna y las estrellas'.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Una delicada y gentil sensación como el ópalo de la cera, y una suave forma que\nevoca a un 'Amezaiku'.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Las flores y la silueta de la mujer calados dejan pasar la luz y brillan\nligeramente.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Como por efecto de algo parecido a la fosforescencia, los jarrones absorben la\ntenue luz del interior de la habitación, y sueltan un ligero y débil brillo,\nparecido al de la luna y el de las estrellas.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"msgoff"},
{"bg",file="bg071a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Este es el esmalte cerámico especial que dices que usaste?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003169",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, el esmalte cerámico lo hice con las piedras que la dueña me envió.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003170",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Desde un principio tenía ya una consistencia fina y arenosa, aunque tenía poco\ngris plateado, y más bien parecía a un blanco espectrolita bastante intenso.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003171",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No he investigado aún su composición química, así que solo puedo aseverar eso\npor su aspecto. Tengo todavía un poco que guardé como muestra, te lo mostraré\notro día.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El esmalte con el que rellenaste las partes caladas es el mismo esmalte\ncerámico?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003172",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Y por eso es que es mucho más difícil para las partes caladas que\nbrillen como sucedería en un Hotarude normal de esmalte transparente.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003173",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Para decir la verdad, lo pulí un poco, y además diluí el esmalte para la\nparte del calado... Es vergonzoso la cantidad de trucos y trampas que usé...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, es increíble que hayas sido capaz de crear todo esto cuando apenas\ncomenzabas a aprender la alfarería. Para serte sincero, me parecen unas\npiezas bastante hermosas.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La 'Luna' te la quitaron, así que las que están acá son 'La Estrella de la\nMañana', 'La Estrella del Atardecer' y 'La Estrella Polar', ¿no?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003174",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... y por otro lado.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Toritani pone sus manos sobre la caja tsuzura de barniz rojo que estaba sobre\nel estante al lado. En la pared había un cuadro de pintura japonesa, y un\nespejo japonés.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"La pintura japonesa era el cuadro de la urraca que la abogada nos mostró en\nQuimera hace unos días. En las inscripciones de la parte de atrás del espejo\nhabía una bandada de urracas grabadas.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003175",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las urracas eran la temática que a la mujer esa le encantaba comprar y\ncoleccionar... Pero, jamás pensé que también pintara obras con la misma\ntemática.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Toritani ve el espejo de urraca.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003176",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace tiempo, esa mujer dijo que este espejo de urraca era la luna... En ese\nmomento aún era pequeña, y no entendí absolutamente nada de lo que dijo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003177",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero en realidad no era nada muy complicado. Se trataba de algo que incluso\naparece en el diccionario.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El espejo de la urraca... ¿Qué es lo que significa?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003178",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El espejo de la urraca es el nombre alternativo que se le da a la luna.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003179",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ese momento fue que lo entendí todo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003180",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue ahí que pensé que, así como dicen que en el lado frontal de la luna está la\nsombra de un conejo machacando mochi, quizás en su lado oscuro está la sombra\nde una urraca.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003181",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé por qué pensé eso... Aunque quizás se debe a que en la parte trasera del\nespejo hay un patrón de urracas grabadas, y terminé asociándolo con eso.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003182",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que ya conté muchas historias irrelevantes de mi pasado... Bien, vayamos\nal tema importante.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Historias irrelevantes de tu pasado, eh... La verdad es que preferiría pasar el\ntiempo ahora escuchando esas historias, pero supongo que no es el momento\npara hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003183",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¡Mm! C-Cómo te atreves a-- No niego que fui yo quien desvió la\nconversación, pero no podemos andar entre historias y descansos todo el día.\n¡Vamos, presta atención y mira esto!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Me acerco a ver yo también la caja tsuzura que Toritani había abierto.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Dentro de la caja había una vieja libreta y un libro contable, ambos de estilo\njaponés. Y además, algo que parecía ser el recorte de un artículo de revista.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"El artículo, completamente amarillento por el paso de los años, era referente a\nlas bellas artes. Este contenía una foto, junto a la presentación de una\nexhibición.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"La libreta japonesa y el libro contable parecen ser realmente viejos. No me\nsorprendería si me dijeran que pertenecen a la era Edo o la era Meiji.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Sin embargo...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Mientras veía fijamente la libreta japonesa, Toritani me pasó el recorte de la\nrevista sin decir nada. Probablemente ya la leyó.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Comienzo a ojear el artículo.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"se",file="se2497",vol=50,id=1},
{"msgoff"},
{"bg",y=0,speed=300000,file="zbg071a",path=":bg/",x2=960,y2=0,x=-960,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"La fiebre del Japonismo: La belleza nipona que le dio color a la vida parisina",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"La presente exhibición, llevada a cabo actualmente en el Museo Municipal de\nYumihari, toma la fiebre del japonismo observada en París y simbolizada por\nla Exposición Universal de París de 1878, y...",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"la presenta desde diversos ángulos, mostrando una gran gama de obras: Piezas de\nartesanía y cuadros impresionistas que fueron importados en grandes\ncantidades a Francia, además de piezas de cerámica creadas en el mismo país e\ninspiradas por las corrientes del impresionismo y las ukiyo- e.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Esta exhibición está compuesta por 4 capítulos: 『Capítulo 1 - La sala de\nrecepción: Un retrato de la familia』, 『Capítulo 2 - Salon japonais: La\ncolección de las damas』, 『Capítulo 3 - El Estudio: La colección de los\ncaballeros』 y 『Capítulo 4 - El Comedor: Las piezas de cerámica que\ncautivaron a París』.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Uno de los puntos a resaltar en esta exhibición son las 'habitaciones'\nrecreadas a partir de las corrientes impresionistas y los cuadros de la\népoca, empleando obras de arte y artesanía de aquellos tiempos.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"En el 『Capítulo 1 - La sala de recepción: Un retrato de la familia』, se\nreproduce la habitación de uno de los retratos más representativos de Renoir,\n'Madame Charpentier y sus hijos'.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"En el 『Capítulo 2 - Salon japonais: La colección de las damas』, se reproduce\nla habitación vista en 'Jovenes mujeres contemplando objetos japoneses', de\nJames Tissot. Si bien este no perteneció a la corriente impresionista, fue\nuno de los primeros, con esta obra, en impulsar el japonismo entre su\ngeneración.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Luego, en el 『Capítulo 3 - El Estudio: La colección de los caballeros』, se\nreproduce la habitación mostrada en 'Retrato de Émile Zola', de Édouard\nManet.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Después de haber contemplado y disfrutado de las piezas de artesanía que\ndecoran cada una de las habitaciones, le invitamos a que compare las\nhabitaciones con cada una de las pinturas que sirvieron de referencia para\nrecrearlas, las cuales están dispuestas de tal manera que faciliten la\ncomparación.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Por último, en el 『Capítulo 4 - El Comedor: Las piezas de cerámica que\ncautivaron a París』 se expone, a diferencia de los otras 3 habitaciones, un\ncomedor basado en un comedor del siglo XIX que realmente existió.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"El juego de vajillas dispuestas sobre la mesa están inspiradas principalmente\nen la serie 'Rousseau' producida por el pintor y artista de aguafuerte, Félix\nBracquemond.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Gran parte de la temática de la serie 'Rousseau' es traída de los 'Manga de\nHokusai'. Cerca de las vajillas se exhiben también los dibujos originales de\nHokusai en los cuales fue inspirada la serie.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Existe la leyenda de que fue Félix Bracquemond el primer artista francés que\ndescubrió los ukiyo-e, perteneciendo al círculo de críticos y artistas\ninvestigadores del arte japonés desde su fundación.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Bracquemond fue amigo de Manet y Baudelaire, llegando a presentar sus obras en\nla primera exposición impresionista, y mantuvo lazos de amistad con otros\npintores impresionistas y críticos que apoyaban la corriente artística.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Este conoció al ávido coleccionista de arte japonés y a la vez dueño de una\ncompañía de fayenza y piezas de cerámica, Charles Haviland, y se convirtió en\nel director artístico del taller Auteuil, el cual funcionaba como el taller\nnúcleo encargado de las pinturas y diseños para el estudio Haviland.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Bracquemond se retira en 1881, pero luego conoce a Gauguin en la exposición\nimpresionista de 1886. Bracquemond le presenta un puesto de trabajo en\nalfarería al empobrecido Gauguin, quien pasó todo un invierno trabajando de\nalfarero.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"De esta manera, una gran cantidad de pintores y artistas comenzaron a ser\ncontratados por el estudio Haviland, los cuales se dedicaron a producir obras\nde pintura únicas sobre platones y jarrones como lienzo.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Entre el círculo de pintores impresionistas, Gogh y Monet son famosos por haber\ncoleccionado con gran pasión ukiyo-e. Gogh frecuentaba uno de los dos tiendas\nde arte japonés que habían en París en ese entonces, cuyo dueño era Samuel\nBing, de manera de adquirir ukiyo-e para su colección.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Monet también llegó a obtener en sus manos, a través de distintas maneras,\ndiversas ukiyo-e, las cuales le sirvieron de influencia e inspiración para\nnuevas ideas con las cuales llegó a producir una gran cantidad de pinturas.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Su obra presentada en 1876 en la segunda exposición impresionista, 'Camille en\ntraje japonés', obtuvo muy buenas críticas, habiendo utilizado una gran gama\nde elementos del japonismo. De ella se dice que fue creada como un opuesto al\n'Camille en traje verde', presentada en el Salón de París de 1866.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"En 1876, Monet obtuvo una ukiyo-e de un japonés gracias a la mediación de\nSamuel Bing, y produjo una pintura inspirada en ese dibujo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Esa obra fue conocida como la segunda 'La Urraca' de Monet, obra y pieza de\narte maestra central que adorna esta exposición, junto al jarrón de estilo\nimpresionista con el mismo diseño de dicho cuadro.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Se piensa que la influencia que tuvo esa ukiyo-e sobre la segunda 'La Urraca'\nde Monet fue similar a la influencia que tuvo 'Vista nocturna de\nSaruwaka-machi' de Hiroshige en la 'Terraza de café por la noche' de Gogh.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"La primera 'La Urraca', creada en el invierno de 1868 en Étretat, y la segunda\n'La Urraca', producida en 1874 en Argenteuil, no fueron creadas exactamente\ncomo parte de una misma serie.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Sin embargo, partiendo del parecido general que hay entre los dos cuadros, no\nse puede descartar la posibilidad de que Monet haya visto anteriormente esta\nukiyo-e, la cual muestra un despejado paisaje nevado y una pequeña urraca, en\nalgún lugar, y...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"teniéndola en mente, haya buscado comprar varias ukiyo-e tras culminar con la\nprimera 'La Urraca' pintada en Étretat.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Por otro lado, se sostiene que el jarrón de la urraca, cuyo diseño fue\nreproducido fielmente siguiendo los trazos característicos del impresionismo,\nfue creado entre 1876 y 1878, aunque se desconoce la identidad de su creador.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Así como Gauguin se dedicó al trabajo de la alfarería, es posible que haya sido\nel mismo Monet quien prestó su pincel para dicha pieza. Se espera que las\nfuturas investigaciones esclarezcan esto, aunque, es innegable el hecho de\nque este jarrón nos trae a la mente diversas especulaciones y expectativas.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"El jarrón de urraca que decora el estante principal del comedor de esta\nexhibición y la segunda 'La Urraca' de Monet están acompañados de aquella\nukiyo-e que sirvió de inspiración para ambos. Esta es la oportunidad perfecta\npara que contemple con sus propios ojos la hermosa resonancia que forman\nestas tres bellas piezas de arte.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg071a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fue la directora quien escribió este artículo?...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003184",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así parece. Me contaron que llegó a imprimir una revista completa en la\nimprenta de un conocido y recortó el artículo de allí, solo para darle más\nrealismo al asunto. Minucioso es poco para lo que hizo.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Toritani responde eso mientras lee la página de la vieja libreta japonesa donde\nestaba metido el marcador de libros.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es asombroso.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Aunque no es de sorprenderse que alguien como la directora llegara a esos\nextremos para engañar a alguien.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003185",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya terminé de revisar esto.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué dice?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003186",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La familia Toritani estuvo metida de lleno en el negocio de las artes desde la\nera Meiji, y mantuvo varios tratos de negocios con agentes en el exterior.\nAunque, parece que tuvieron una profunda relación con los ezushi-ya desde la\nera Edo.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ezushi-ya?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003187",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así le llamaban a los establecimientos que creaban y vendían ukiyo-e y sushi\ncon dibujos.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003188",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ya entendiste más o menos lo que implica el artículo?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Según la manera en la que pone las cosas este artículo, el japonés que le\nconsiguió y envió la ukiyo-e a Monet fue un antepasado tuyo, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003189",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Correcto. Y según esta libreta, la autora de la ukiyo-e fue Kariyama Seiro.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003190",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Su estilo se asemejaba a otro pintor japonés de la misma época, Watanabe\nSeitei, manejando excelentemente las pinturas de aves y flores (kachi-ga).\nPor lo general se dedicaba a pinturas japonesas a pincel, aunque llegó a\nmanejar también estampas para nishiki-e... De esa manera la describen.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaja.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Levanto la cabeza para ver el ukiyo-e que estaba colgado en la pared.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003191",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La libreta está escrita como si se tratara del diario del comerciante de obras,\nTadamasa Toritani. Todo desde su punto de vista.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003192",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tadamasa tenía conexión con Samuel Bing, quien era comerciante de artes, y\nemprendió un viaje a Francia con su propio dinero para poder ver y sentir, en\ncarne propia, la verdadera demanda que había en París por el arte japonés.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003193",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue allí que conoció a Monet, quien le encargó que buscara una ukiyo-e que\nhabía visto hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003194",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Monet pasó sus primeros años en la ciudad portuaria de El Havre. Parece que fue\nallí que descubrió la artesanía japonesa, viendo las piezas de arte japonés y\nlos ukiyo-e que traían los marineros.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003195",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Monet le pidió a ese comerciante de artes que vino de Japón conseguir el\nukiyo-e del paisaje nevado y la urraca que vio de niño. Tadamasa le había\nparecido ver una pintura parecida, y se trajo una ukiyo-e de Kariyama Seiro\ndirectamente de Japón.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003196",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, para esa época Monet aún sufría de una severa situación económica.\nTadamasa mostró entendimiento, conociendo la situación del impresionismo para\nentonces, y le dio a Monet la ukiyo-e de Kariyama Seiro a cambio de una\npintura en óleo suya con la misma composición de la ukiyo-e. Eso es lo que\nsale escrito en esta libreta.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es por eso que en el artículo dice que la primera 'La Urraca', que dibujó\nteniendo esa ukiyo-e en mente, y la segunda 'La Urraca', que pintó al recibir\nla ukiyo-e de Tadamasa, se parecen.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003197",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Exactamente. Tadamasa también portaba interés por las piezas de cerámica\nimpresionistas que Charles Haviland producía, y mandó a crear un jarrón con\nestilo impresionista usando el mismo diseño de la segunda 'La Urraca' que\nrecibió de Monet.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
vl03={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003198",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todo eso, junto a todo lo demás que 'supuestamente' sucedió está escrito en\nesta libreta... La otra libreta es el libro contable de ese entonces. Este es\nel registro del jarrón, y el de la ukiyo-e de Kariyama Seiro es... este.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003199",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cuestiones de trabajo, Tadamasa regresó a Japón sin poder esperar a que se\nterminara de fabricar el jarrón. Luego, entre esto y aquello, el estudio\nHaviland mantuvo guardado el jarrón de urraca ya completo, al igual que la\npintura en óleo, mientras esperaban a que Tadamasa viniera por ellas.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, y entonces... fue después la directora quien descubrió eso cuando aún\nestaba en la preparatoria.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003200",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Unos días después de volver a Japón, Tadamasa consiguió una ukiyo-e\nidéntica a la que le dio a Monet. Esa ukiyo-e estuvo reposando en el depósito\nde la casa Toritani, junto a esta libreta diario y al libro contable...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y se 'supone' que esta es esa ukiyo-e, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003201",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Toritani devolvió el recorte del artículo y los dos libros japoneses a la caja,\ny la cerró.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que me doy cuenta, el jarrón de la urraca no está acá.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003202",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que la directora movió el jarrón de la urraca a la caja fuerte que está\nen su oficina. Había dicho que en el día de nuestra negociación con Reika nos\nharía llegar el jarrón escoltado por guardias de seguridad.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003203",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que ya me extendí demasiado. ¿Llevamos ya los jarrones?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"se",id=1,file="se2225"},
{"bgm",file="bgm102"},
{"text"},
text={
ja={
{
"A punto ya de cerrar por el día de hoy, la campana que anuncia la entrada de un\ncliente resuena en Quimera.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"La abogada entró con pasos calmados al local y tomó un asiento. Me paro en el\nasiento enfrente.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenas noches. ¿Le importa si me siento en la misma mesa con usted?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_obs_000027",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Fuiste tú quien me pidió venir, ¿no? Toma asiento.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"se",file="se3214",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-690,y=-240,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Asiento para luego sentarme. La muchacha de medio tiempo nos trae agua. La\nabogada no se preocupó por ver el menú, pidiendo solo un café.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_obs_000028",ch="obs"},
},
ja={
{
name={"Abogada"},
"“¿Le preguntaste a la directora Toritani por mi número?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fui yo quien la llamó, aunque el celular era de Toritani. Usé el número que\nella le pidió a la directora.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_obs_000029",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Ya veo. ¿Y bien, necesitas algo? Me llamas solo a mí justamente antes de la\nnegociación con mi clienta. ¿Es que acaso piensas negociar conmigo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Negociar... no, no es algo tan exagerado como eso. Diría que más bien se trata\nde un favor.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_obs_000030",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Fufu, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"El café llegó justamente después. Al irse la muchacha de medio tiempo, la\nabogada entró en el tema con toda tranquilidad.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_obs_000031",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Veamos, ¿cuál es ese favor me quieres pedir?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace unos días, usted le habló a Makoto Toritani acerca del 'Catálogo Uji',\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"La abogada asiente silenciosamente.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquel día, usted habló muy bien de las obras de Makoto Toritani. Le pidió que\nse dedicara a crear más obras de arte y menos productos para la vida diaria.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_obs_000032",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Sí, no lo niego. El talento que posee es algo maravilloso. Y por eso mismo es\nque deseo que siga fabricando obras maestras, así como aquella que está en el\nCatálogo Uji.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y hacerlas parte de su colección también?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_obs_000033",ch="obs"},
},
ja={
{
name={"Abogada"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"La reacción de la abogada se tardó por un instante. Después de un breve\nrespiro, esta me devolvió la mirada prudentemente, como tratando de averiguar\nalgo.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_obs_000034",ch="obs"},
},
ja={
{
name={"Abogada"},
"“... ¿Te... lo contó la directora Toritani?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aahhh, no...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Me rasco la mejilla con un dedo.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Digamos que he visto ya a unas cuantas personas con esos mismos ojos que tiene\nusted ahora, así que pensé '¿Será que quizás?'. Para decir la verdad, fue\nmera intuición.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_obs_000035",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Ya veo, supongo entonces que fuiste perseguido y acosado por una gran cantidad\nde personas con la misma mirada que tengo ahora.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_obs_000036",ch="obs"},
},
ja={
{
name={"Abogada"},
"“No esperaba menos del hijo del famoso Kenichiro Kusanagi. Descendiente de uno\nde los más grandes artistas a nivel mundial en esta época, además de niño\nprodigio, perseguido desde sus primeros años por los medios de comunicación.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco es que yo sea la gran cosa, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_obs_000037",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Admiro tu humildad.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_obs_000038",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Bien. Sí, soy una coleccionista de arte. ¿Sucede algo con eso? ¿Es que acaso\ntiene alguna relación con el favor que deseas pedirme?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suetake-san, el jarrón que usted tanto quiere es en realidad parte de una\nserie.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_obs_000039",ch="obs"},
},
ja={
{
name={"Abogada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Las cejas de la abogada... no, de Suetake, se movieron ligeramente.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La serie fue creada inspirada en la serie de paneles de 'La Luna y las\nEstrellas' de Mucha. En el catálogo estaba 'La Luna', mientras que los\nrestantes son...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_obs_000040",ch="obs"},
},
ja={
{
name={"Suetake"},
"“'La Estrella de la Tarde', 'La Estrella de la Mañana' y 'La Estrella Polar'...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. En unas pocas horas podrá apreciar con sus propios ojos los demás\njarrones. ¿Qué le parece?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_obs_000041",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Cuando me preguntas eso, te refieres a...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No los quisiera para usted?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_obs_000042",ch="obs"},
},
ja={
{
name={"Suetake"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_obs_000043",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Fufu...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Después de juntar los labios y cerrar su boca, Suetake muestra una ligera e\nindescifrable sonrisa.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_obs_000044",ch="obs"},
},
ja={
{
name={"Suetake"},
"“¿Me estás pidiendo que traicione aquí y ahora a mi cliente a cambio de los\njarrones?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_obs_000045",ch="obs"},
},
ja={
{
name={"Suetake"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Ante mi súbita negación, la máscara de Suetake se cayó por un instante,\nmostrando una expresión desconcertada. Se debe estar preguntando qué rayos\nestoy diciendo.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Una fuerte avaricia y deseo se esconden tras esos ojos suyos que intentan\nfingir serenidad. Cualquiera se daría cuenta de eso solo viendo su mirada.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Aquellos coleccionistas que pisan la raya de lo prohibido terminan por quedar\nenfermos con una particular locura. Terminan por poner su colección por\nencima de todo. Por encima del dinero, de la fama, y de su propia vida.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Me lo imaginaba. Esta mujer se muere por tener los jarrones de Toritani en sus\nmanos.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Si no fuera así, no hubiera halagado a Toritani en la manera que lo hizo. A\npesar de haber estado en medio de sus labores.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Y menos aún se hubieran escapado esas últimas palabras: '¿Me estás pidiendo que\ntraicione aquí y ahora a mi cliente a cambio de los jarrones?'.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_obs_000046",ch="obs"},
},
ja={
{
name={"Suetake"},
"“De ser así... ¿Qué es lo quieres que haga?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cuestión es simple. Queremos liberar a la familia Onda de este problema.\nTanto Toritani como la dueña dicen estar dispuestas a entregar los jarrones\npor ese fin.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"No hay ningún artista que guste de sacar al mundo una obra con la cual no haya\nquedado conforme.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Tanto Toritani como la dueña están dispuestas a entregar esas obras que en un\nprincipio jamás han querido mostrar ante los demás. Por el bien de la familia\nOnda.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Los jarrones que solo son un fracaso para Toritani. El jarrón que la dueña\nmandó a fabricar como parte de un engaño.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Hacer eso no significa ponerse de rodillas ante Reika Honma. La dueña y la\ndirectora son mucho más crueles que Toritani en ese aspecto.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"La dueña le dijo lo siguiente a Toritani mientras hablaban por teléfono.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"De ninguna manera podría decir que esa 'señora' es alguien agradable. Ni que me\npaguen. Y aun a pesar de eso, no quería ver a alguien de entre mis conocidos\nhaciendo el ridículo. Pero si ella tanto insiste, pues entonces no hay más\nque se pueda hacer...'",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"En lo que a la directora concierne, desde un principio nunca ha tenido interés\nen la obsesión de Reika con ese jarrón. 'Si tanto lo quiere como para llegar\na intentar incluso un robo, pues dáselo'. Esa es su postura ante este hecho.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo más importante ahora son las negociaciones que se darán a cabo en unos\ncuantos días entre la directora Toritani y Reika Honma. Si las negociaciones\nterminan tal como nosotros queremos...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_obs_000047",ch="obs"},
},
ja={
{
name={"Suetake"},
"“¿Entonces?...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de eso, negocie usted todo lo demás con Makoto Toritani.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_obs_000048",ch="obs"},
},
ja={
{
name={"Suetake"},
"“... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_obs_000049",ch="obs"},
},
ja={
{
name={"Suetake"},
"“¿Estás tratando de convencerme de que eso no es traicionar a mi cliente?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es. Aunque no estoy pidiéndole que la traicioné aquí y ahora. Para ser\nsincero, no nos serviría de mucho que la traicione aquí.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_obs_000050",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Ya veo. Tienes razón... Jeje.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_obs_000051",ch="obs"},
},
ja={
{
name={"Suetake"},
"“¿Puedo venir esta noche a ver los jarrones de la señorita Toritani?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_obs_000052",ch="obs"},
},
ja={
{
name={"Suetake"},
"“... No puedo esperar a que llegue la noche.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"se",file="se3214",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al susurrar eso de cierta forma extasiada, Suetake se para.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_obs_000053",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Tengo que ir a buscar a la señora, así que me retiro. Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Nos vemos en un rato.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Suetake sale del local.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bgm",stop=1,time=300},
{"se",id=1,file="se2225"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000023",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Gracias por venir～”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias por venir~”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Absorto ahora en mí mismo, repito las mismas palabras de despedida de la\nmuchacha de medio tiempo y veo al techo.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Q-Qué nervios me dio todo esto.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"No sabía de qué manera iba Suetake a hablar, y a pesar de aparentar calma y\ntenacidad, por dentro me estaba bañando en sudor frío.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"No soy muy bueno para este tipo de negociaciones, pero para haber sido algo\nimprovisado y tan repentino, supongo que no salió tan mal.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Sin embargo, esto no fue sino el preámbulo. Ahora es que viene la verdadera\nbatalla.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_08_3"},
{"text"},
linkback="block_00217",
},
label = {
top={block="block_00000",label=1},
},
}
