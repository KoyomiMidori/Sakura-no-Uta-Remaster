astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="znightsky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
"Me quedé pintando hasta el amanecer.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Pintando sin parar.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Ella me lo dijo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"'Tus ojos eran los de un completo mediocre.'",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Ya veo.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Esas palabras terminaron por salvarme.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los mediocres tienen su propio método.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",file="zbluesky_spring",id=8,lv=8,speed=300000,sync=0,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama tenía razón.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"cgdel",id=9,time=1500,lv=9},
{"text"},
text={
ja={
{
"Todavía sin dormir, me fui al colegio temprano en la mañana.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Y estaba ahora solo en la azotea, contemplando el cielo.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Un duelo de pintura con Sui...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Si bien eso propuse, queda otro problema... ¿Podré encontrarla?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Supongamos que la encuentro...\n¿Podré mantener un duelo con ella?",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Si lo que el viejo decía de su talento es cierto, en mi estado actual es muy\nprobable que todo termine sin poder hacer nada.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque se supone que en principio era Rin...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Bueh, no hay por qué preocuparse por los detalles.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Basta con que el talento de Sui sea auténtico.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Si quiero alcanzar a Kei, debo enfrentarme a alguien de un nivel idéntico.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguramente dará pasos agigantados...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alcanzará alturas a las que nadie ha llegado...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"cgdel",id=8,lv=8},
{"bg",file="bluesky_spring",id=7,lv=7,sync=0,path=":cg/"},
{"quake",mode="mw"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Hyaah?!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Siento algo frío en la mejilla.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Me levanto de un salto.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q-Quién está ahí?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_aid_001202",ch="aid"},
},
ja={
{
name={"???"},
"“Has llegado temprano hoy...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_aid_001203",ch="aid"},
},
ja={
{
name={"Ai"},
"“Toma, café helado.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"se",file="se9020",vol=30,id=1},
{"text"},
text={
ja={
{
"Ai me lanzó una lata de café.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"mwact",act="うなづく",size=5},
{"se",file="se_hand_pan1",vol=30,id=1},
{"text"},
text={
ja={
{
"La atrapo en mis manos.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, gracias.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001204",ch="aid"},
},
ja={
{
name={"Ai"},
"“Supongo que necesitas algo de cafeína ahora mismo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vaya que sí...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001205",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me parece que la luz del taller estuvo prendida toda la noche...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estabas despierta?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001206",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, me llamó un tanto la atención...\nY bien, ¿decidiste pintar entonces?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001207",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Ai sube la mirada al cielo.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001208",ch="aid"},
},
ja={
{
name={"Ai"},
"“A todos les gusta pintar.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001209",ch="aid"},
},
ja={
{
name={"Ai"},
"“A Kei, a ti... y a Kenichiro también...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001210",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hace un buen tiempo, Kenichiro llegó a dibujarme muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_aid_001211",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y me encantaba como no tienes idea.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_aid_001212",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cosas de este mundo, y fuera de él... De todo...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001213",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y siempre que yo decía 'gracias', Kenichiro me respondía con esto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001214",ch="aid"},
},
ja={
{
name={"Ai"},
"“Las pinturas renacen cuando alguien las ve.\nSin espectadores, una pintura no existe...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_aid_001215",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que gracias a ti por verla... decía él.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001216",ch="aid"},
},
ja={
{
name={"Ai"},
"“Probablemente Kenichiro llegó a pintar muchísimos cuadros que jamás llegaron a\ntener espectador.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001217",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así como tú.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No todo cuadro debe tener espectador.\nDiría que son más los cuadros que acaban sin uno.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bocetos, cuadros de práctica... Un ciclo cuasi-infinito para poder crear\nmejores obras..”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y todas, sin nadie que las vea.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso el viejo entendía muy bien la importancia del espectador.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguramente estaba realmente agradecido contigo cuando te dijo eso.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001218",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuadros sin espectador, eh...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sabes? Kei...\nEs un modelo a seguir para mí.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pinta y pinta como un maniático, sin parar.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que hay en su cabeza son cuadros.\nPodrías decir que ni sentido común tiene... lo cual es algo problemático, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La pintura no es algo en lo que puedas mejorar simplemente pintando más.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cien bocetos que un mediocre haya pintado jugando no le llegan ni a los pies a\nun solo boceto hecho con el sufrimiento de un genio.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una pintura sin dolor es solo autocomplacencia.\nNo es más que un pasatiempo...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si bien aparenta ser un muchacho sin preocupaciones, se siente sufrimiento en\nsus obras.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene ese ímpetu de describir las cosas de la manera que sea, así le cueste la\nvida. Sus cuadros tienen esa genialidad.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos bocetos pintados con sufrimiento. Esas repeticiones infinitas...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él nació para pintar.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está poniendo su vida en la pintura.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001219",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No es lo mismo contigo, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“He dado la imagen de que no pinto más,\npero aun así he seguido dibujando sin parar.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he dejado de practicar en ningún momento... En las sombras.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Con esta mano izquierda...",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La última reserva de fuerza que le quedaba a mi mano derecha la usé aquel\ndía...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así no logro alcanzarlo.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun cuando pienso que avanzo, siempre me topo con su espalda.\nEn todo momento me lleva la delantera.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001220",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei estuvo diciendo lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es por lo mucho que me sobrestima.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001221",ch="aid"},
},
ja={
{
name={"Ai"},
"“No lo sé. La verdad es que no me pareció así...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es así. Todos me ponen por encima de lo que realmente soy...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001222",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sigues dibujando...\n¿Por qué entonces pretendías haber dejado de pintar?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo mis razones.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_aid_001223",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero estás pintando.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo en práctica. Todos los cuadros han terminado como ejercicios propios.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he creado nada que pueda ser considerado como obra.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que lo de que dejé de pintar es verdad.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es mentira.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fgact",ch="藍",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001224",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero de aquí en estos días crearé una obra de verdad.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pintaré un cuadro... un cuadro que pueda estar a la par incluso con el mismo\nKei.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso he decidido, y ya no puedo dar vuelta atrás...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debo... tomar de nuevo el pincel en mis manos...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="藍",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="藍",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0002",head="aix_z2e",lv=5,id=9},
{"se",stop=1,id=1,time=500},
{"fgact",ch="藍",act="うなづく",sync=1,lv=5,id=9},
{"se",file="se9010",id=2,vol=30},
{"bg",file="ev_com_a06_02",time=500,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_001225",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estás temblando... ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No voy a... negarlo...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_001226",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pareces estar algo alterado... ¿Tienes miedo de algo?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_a06_03",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001227",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre intentas hacerte el fuerte...\nDios mio, todos los Kusanagi son iguales...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vamos... ¿Es que me abrazaste por verme temblando?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_aid_001228",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, y porque te conozco muy bien.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_001229",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aún desde pequeño eras un niño de mucho espíritu.\nNunca dabas un paso atrás, aun frente a un adulto.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_aid_001230",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero tu cara en esos momentos siempre se estremece ligeramente...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_aid_001231",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre que intentas afrontar un reto, que intentas enfrentarte a algo,\ntiemblas.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_a06_02",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001232",ch="aid"},
},
ja={
{
name={"Ai"},
"“Actúas en todo momento con valentía, como si nada te diera miedo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_aid_001233",ch="aid"},
},
ja={
{
name={"Ai"},
"“Probablemente para casi todos te ves como un poderoso héroe...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_aid_001234",ch="aid"},
},
ja={
{
name={"Ai"},
"“Un héroe invencible, capaz de superar cualquier dificultad...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_aid_001235",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero yo veo a un muchacho herido y con sus alas cayéndose, intentado volar de\nnuevo...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_001236",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entre cada lucha más heridas acumulas...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que de niño me sentía fascinado por eso.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ese superhéroe que llega calmado y galante para resolverlo todo.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un superhéroe capaz de superar cualquier adversidad...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero las cosas no son tan fáciles.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo los héroes de los cuentos tienen ese privilegio.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La realidad es distinta.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una persona normal que intente dárselas de héroe perderá muchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las personas no son tan omnipotentes como en los cuentos...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso hay que sacrificar tanto para proteger a alguien...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me he dado cuenta de lo frágil que es un héroe real comparado a los de los\ncuentos.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me di cuenta observando al viejo...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Prácticamente toda su vida se la pasó perdiendo cosas.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun a pesar de perder lo más preciado para él, siguió luchando.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso pensé en continuar su legado...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"De ahí surgió 'Sakura Nanasouzu'.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La abuela Natsume decía--”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que de joven mucho le arrebataron...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y que ahora vivía para arrebatar... como alguien del lado de los malos.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso lo puedes decir cuando realmente has vivido perdiéndolo todo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando una persona intenta hacer algo fuera de lo normal, debe pagar un precio.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedes ganar nada si no pagas antes.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso, mejor que nadie, lo sé yo...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso... es que también tiemblo...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre me pasa lo mismo cuando estoy por tomar una gran decisión...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mis pies tiemblan. Siento que no podré dar el primer paso.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso siempre procuro pisar hacia adelante.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así se me quita el temblequeo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_a06_03",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Ai me abrazó fuertemente.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_aid_001237",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya... ¿No te parece que ya está bien de luchar?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_aid_001238",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya has luchado bastante hasta el día de hoy.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_001239",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nunca has parado de luchar, a pesar de todo lo que has perdido.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_aid_001240",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si tiemblas es porque tienes miedo...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_aid_001241",ch="aid"},
},
ja={
{
name={"Ai"},
"“Intenta hacerle caso a esa sensación de vez en cuando...No tienes por qué\ncargar con todo el peso tú solo. No tienes por qué intentar aguantarlo todo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, admito que tiemblo en parte por miedo...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="ev_com_a06_02",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero las personas tiemblan también de la emoción.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una mezcla de miedo y emoción.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que no te preocupes, tampoco estoy poniéndome tanta carga encima.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_aid_001242",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Después de mostrar una triste expresión en su rostro, Ai dijo...",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_a06_04",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001243",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo... sí.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_001244",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esperaba esa respuesta de ti...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_a06_03",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001245",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero diré lo mismo cuantas veces sea necesario, siempre puedes reposar\nconmigo.\nPara eso estoy...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para eso? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_aid_001246",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tanto Kenichiro como la abuela Kotoko me encargaron a ti...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_aid_001247",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que puedes venir conmigo cuando quieras...Eso incluso me complacería.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién diría? No pensé que a tus ojos me viera así.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que estaba temblando...\nSí, bueno, lo estaba...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_a06_02",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001248",ch="aid"},
},
ja={
{
name={"Ai"},
"“Llevo años observándote. Te conozco mejor que tú mismo.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es posible.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_aid_001249",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, lo sé, es algo exagerado afirmar eso...\npero te conozco tanto que de esa manera me siento...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque hay algo que debo recordarte, Ai.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que ya lo dije antes.\nSi tanto me conoces, deberías dejar de abrazarme de esta forma...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_aid_001250",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, tienes razón. Pero no puedo quedarme sin hacer nada mientras te veo\ntemblar.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_aid_001251",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre que estés temblando solo te abrazaré y haré que te calmes...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... Me cuesta lanzar un chiste sucio de vuelta después de escuchar\neso...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_aid_001252",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hace falta que vengas con esos chistes. Realmente que para las cosas más\nraras eres un tonto.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es por eso, es que si no suelto un mal chiste ahora...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="ev_com_a06_04",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001253",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Llorarás?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Jaa?! P-Por supuesto... que no.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_a06_03",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001254",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No? Me parece que de niño siempre llorabas cuando pasaba esto...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“J-Jamás he mostrado lágrima alguna frente a ti...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_a06_04",sync=0,face=1,time=400,path=":ev/ev_com_a06/",set="ev_com_a06"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001255",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso digo, solo me parece.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“H-Haya o no haya sido así, era un mocoso todavía.\nYa no estoy en edad de llorar...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_aid_001256",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, ya veo... pero, déjame seguir un poco más, solo por ahora.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"El pecho de Ai estaba cálido.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"La sensación era, definitivamente, nostálgica.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Fue entonces que me di cuenta de que el temblor había desaparecido.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias, creo que ya se calmó.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_aid_001257",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así parece...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="藍",size="z1",my=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_001258",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Y bien? ¿Por qué estás a esta hora en la azotea?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay razón en particular... o al menos eso quisiera decir, pero...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Esa sería mi respuesta usual.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Es lo que te trae intentar resolverlo todo solo.\nNo es una costumbre muy buena que digamos...",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Busco a alguien. Pensé que quizá de un lugar alto podría encontrarle.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001259",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que buscas a alguien... ¿Qué clase de persona?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mide alrededor de 140 centímetros. Parece una niña, pero lleva el uniforme de\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_aid_001260",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es de nuestro colegio?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001261",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, ciertamente lleva el uniforme del colegio, aunque...\n¿Realmente es de acá?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="藍",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Volteo a ver el campus del colegio desde la azotea.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Y doy con la peculiar muchacha.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Está caminando hacia uno de los lados de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, esa es.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001262",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Esa es la muchacha que estabas buscando?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, y excúsame, tengo que irme!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001263",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entiendo... Uhm, que te vaya bien, pero intenta no exigirte mucho.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Bajo corriendo las escaleras.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bgm",stop=1,time=1000},
{"se",file="se9023",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm020"},
{"text"},
text={
ja={
{
"De nuevo acá.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"El flanco de la iglesia, donde está el mural.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sui!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0200",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0015",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000721",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero qué ruidoso. ¿Qué quieres, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Sui se voltea.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez me prometiste algo.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000722",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Una... promesa?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de que me mostrarías cómo pintas...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000723",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, lo recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo un favor que pedirte.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000724",ch="sud"},
},
ja={
{
name={"Sui"},
"“Qué extraño que me pidas un favor, Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pinta, por favor.\nEn un duelo, conmigo.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0012",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000725",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Un duelo? ¿Contigo?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000726",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh... ¿Un duelo con Naoya Kusanagi?...\nCon el famoso artista de los cerezos...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Artista de los cerezos?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0001",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000727",ch="sud"},
},
ja={
{
name={"Sui"},
"“Está bien. Suena interesante, sí.\nAunque, ¿está bien que hagamos esto?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Sui ignora mi pregunta.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000728",ch="sud"},
},
ja={
{
name={"Sui"},
"“No pareces estar del todo preparado...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy en perfectas condiciones.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Sostengo fuertemente mi brazo derecho.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Después de observarme fijamente por un momento, Sui abrió su boca.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000729",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo...\nPues sí, no niego que aun en tu estado actual tienes potencial, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000730",ch="sud"},
},
ja={
{
name={"Sui"},
"“Esa serie que han publicado recientemente no está nada mal...\nCon ese nivel no tendré problema en aceptar el duelo.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"¿Serie?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"¿También conoce la verdad de 'Sakura Nanasouzu'?",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"No, espera, es obvio...",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Hasta Nagayama fue capaz de deducirlo. Si esta muchacha fue la discípula de\nKenichiro Kusanagi, darse cuenta de eso debería ser pan comido para ella.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000731",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Podría saber de qué manera competiremos en duelo?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... pintar algo en un tiempo límite.\nEs lo único que me he pensado hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000732",ch="sud"},
},
ja={
{
name={"Sui"},
"“Son pocas las oportunidades de hacer un duelo de pintura. No suena muy\ninteresante eso.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hacemos entonces?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0018",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000733",ch="sud"},
},
ja={
{
name={"Sui"},
"“Hmph.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Después de pensar un rato, Sui miró la piscina.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000734",ch="sud"},
},
ja={
{
name={"Sui"},
"“En esta época la piscina está ya vacía.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000735",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué tal usar el fondo de la piscina como lienzo?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero qué estupidez propones. Ya tengo una fechoría en el historial con este\nmural, si me pongo ahora a rayar la piscina me expulsarán.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000736",ch="sud"},
},
ja={
{
name={"Sui"},
"“No hay problema. Es una piscina hay agua de sobra alrededor. Sabes de lo que\nhablo, ¿no, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Agua? E-Espera, ¿propones usar pigmentos de acuarela?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000737",ch="sud"},
},
ja={
{
name={"Sui"},
"“Si llego a escuchar algo mediocre como que no se puede pintar con acuarela una\npiscina, Sui rechazará este duelo.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No... Sé, sé que se puede... pero...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"No pensé que llegaría a dar con esa idea.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De dónde vas a sacar tanto pigmento?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000738",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui tomará todo el pigmento del salón de arte.\nTú encárgate de conseguir tu pintura, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Usar el fondo de la piscina como lienzo, con acuarela.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"A ninguna persona normal se le ocurriría algo así.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"No es de sorprenderse que el viejo la calificara como genio.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Aunque eso significa que el duelo será extremadamente técnico.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Usar acuarela implica eso.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Tomaré toda la pintura que pueda de mi casa.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000739",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Cuándo será el duelo?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy a la medianoche, en la piscina del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000740",ch="sud"},
},
ja={
{
name={"Sui"},
"“Está bien.\nSui confía en que mostrarás bastante empeño.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo haré lo mejor que pueda...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000741",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues mucho cuidado de no acabar bajo mis zapatos... Hay la posibilidad de que\ntermines con una herida irrecuperable.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deberías tener cuidado tú también y no dejarte aplastar por mí.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0200",face="a0002",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"Sui sonrío de oreja a oreja.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Mis manos estaban empapadas de sudor.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Pero ya no había temblor alguno.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="05_the_happy_prince_05_2"},
{"text"},
linkback="block_00263",
},
label = {
top={block="block_00000",label=1},
},
}
