astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Al terminar las vacaciones de verano, me había convertido en un héroe.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"'Las huellas de los cerezos' me convirtieron, de la noche a la mañana, en una\ncelebridad de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Así es, este mural.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_uni_c24_01",sync=1,path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"bgm",file="bgm035"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, definitivamente...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Vuelvo a abrir una vez más la copia de los planos de diseño de Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Habiendo perdido el derecho a la herencia, no puedo tener los originales en mis\nmanos.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Los originales seguramente pasarán por todos los procesos adecuados para luego\nconvertirse en dinero, y serán usados tal como Kenichiro lo tenía en mente.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"De seguro el condenado gringo Fridmann se encargará de que todo vaya viento en\npopa.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Pero, más importante que eso ahora...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"No cabe duda alguna, parte de los pétalos tienen una forma totalmente distinta\na la del diseño original.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Posición, ángulo, y además la puesta del pincel (¿o en este caso, uwabaki?).\nDiferentes en todos estos aspectos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No incluí a Kei en la labor puesto que su talento podría provocar que dejara\nplasmado su propio estilo en la obra... Con el enorme talento que tiene,\nhabía la posibilidad de que su estilo de obra entrara en conflicto con el de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Pero ¿qué hay de esta parte de los pétalos?",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene un estilo aún más egocéntrico que el de Kei, y a pesar de eso...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No acabó con la creación de Kenichiro Kusanagi. Más bien toma provecho de ella\ny la hace resaltar.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Este plano de diseño fue dibujado por Kenichiro Kusanagi antes de realizar su\ndebut. Una obra que pertenece a, como le llaman generalmente, la etapa previa\na su apogeo.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Y por eso mismo, aun habiendo algo fuera de lugar en esta parte, nadie se da\ncuenta de esa anormalidad.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta parte fuera de lugar tiene una fuerza en sus pinceladas más parecida a\naquellas tras su apogeo. No, se podría decir que se acerca incluso a la época\nde 'Cerezos recostados'...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es como si Kenichiro Kusanagi hubiese revivido...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"No. Tampoco eso.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si exageramos un poco, se podría decir que incluso supera al Kenichiro Kusanagi\nen pleno apogeo...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"No, ya eso es decir mucho.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Yo conozco muy bien la magnitud de su genialidad y talento.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"El primer y último japonés en obtener el máximo premio de la Exposición Moore,\nel Platine Épaulard.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Aun siendo llamado avaro y tacaño, artista de negocios, estafador, sus obras\nson aún amadas por una gran cantidad de personas alrededor del globo.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Es absurdo afirmar con tanta ligereza que hay alguien superior a él.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso perdí mi buen juicio?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"En fin, solo hay una persona que pudo haber pintado esta parte.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Solo puede ser ella.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Solo unos pocos grabaron con los uwabaki el muro, y bien que mantuve el ojo\npuesto sobre todos los demás mientras avanzaba la obra.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Hay una sola persona a la cual no pude observar mientras pintaba con los\nuwabaki.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"msgoff"},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justo en el momento que Sui se unió...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Mientras trabajaba junto a ella, mi consciencia se nubló y terminé\ndesmayándome.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Y fue esta la parte de la obra que se culminó después de que me desmayara.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"cgdel",id=-1},
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Casualidad?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¿Ese poder de salto le dio un toque único a los trazos?",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Simple 'azar'. ¿Sería normal pensar eso?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"¿Realmente fue así?",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi dijo que había practicado durante varios años para desarrollar esa única\npincelada que usó al dibujar el tronco.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible poder dar estos trazos tan perfectamente elaborados solo por mera\ncasualidad?...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"De ninguna forma.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Es lo mismo a que si un mono golpeara al azar las teclas de una máquina de\nescribir y acabara reproduciendo a Shakespeare.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Es imposible producir esa calidad de trazo solo por coincidencia.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa muchacha... ¿Quién rayos es en realidad?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Siento como si lo entendiera.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Como si lo supiera.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Esta sensación.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Es como si los puntos dispersos dentro de mí estuvieran a punto de conectarse\npor una línea, pero de repente se esfumaran. Esa fugaz sensación me invade de\nprincipio a fin.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_sud_000660",ch="sud"},
},
ja={
{
name={"???"},
"“¿Hablando solo? Qué asco...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, supongo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000661",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿A qué se debe? ¿Es que estabas pensando en lo tierna que es Sui?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensando en ti, sí. ¿En lo tierna que eres? Particularmente, no me parece.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000662",ch="sud"},
},
ja={
{
name={"Sui"},
"“Debe ser terrible no poder comprender la belleza de Sui. Eso ya es una\nenfermedad, sí. Qué tristeza por ti...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si bien no comprendo tu belleza, sé muy bien lo bellos que son tus trazos.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000663",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Mis trazos son bellos? ¿Qué no es obvio?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio, eh... Siempre que hablo contigo no sé si me estás bromeando o hablas en\nserio.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000664",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui siempre habla en serio. Sui es tierna, y hermosa. ¡Podríamos decir que\nextremadamente tierna y también hermosa! ¡¿Qué esperas para poseer a Sui?!\n¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vamos a qué? Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000665",ch="sud"},
},
ja={
{
name={"Sui"},
"“Hmhm, llevo un buen tiempo preguntándome algo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_sud_000666",ch="sud"},
},
ja={
{
name={"Sui"},
"“Kusanagi-san, ¿eres gay?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué supones que lo soy?!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000667",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tienes a muchas chicas lindas a tu alrededor. Pero aun así no le has abierto tu\ncorazón a ninguna...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000668",ch="sud"},
},
ja={
{
name={"Sui"},
"“Rin, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_sud_000669",ch="sud"},
},
ja={
{
name={"Sui"},
"“Temes de que ella descubra algo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De qué estás hablando? ¿Qué pruebas tienes para decir eso?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000670",ch="sud"},
},
ja={
{
name={"Sui"},
"“No tengo. Es solo la intuición de una artista.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_sud_000671",ch="sud"},
},
ja={
{
name={"Sui"},
"“Supongo que sabrás muy bien la aguda capacidad de observación que tienen los\nartistas, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en tu caso no parecieras tener esa capacidad, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000672",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿En serio? ¿No acabas de decir que mis trazos son bellos?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues... sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000673",ch="sud"},
},
ja={
{
name={"Sui"},
"“Parece que incluso una persona ordinaria como tú es capaz de percibir mi\nhabilidad, ¿no? No solo soy una muchacha hermosa, soy también capaz de\ndibujar hermosas pinturas.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaaa, ¿en serio?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0018",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000674",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Por qué pones ahora esa cara tan tonta?! ¡Mira lo maravillosa que es Sui!\n¡Vamos, poséeme! ¡Envuélveme en tus brazos!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh--”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0022",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="いいえ",loop=-1,time=500,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000675",ch="sud"},
},
ja={
{
name={"Sui"},
"“Nyaah, unyawaah, d-detente, mi cabello, ¡vas a despeinarme!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fgact",ch="吹",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sabeees? Cuando veo a esta tierna, y hermosa muchacha, algo por dentro me\nirrita, y se me ocurrió alborotar tu cabello para desquitarme.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0018",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000676",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡E-Eso no tiene sentido alguno! ¡Si vas a alborotarme algo hay otras partes de\nmi cuerpo para eso!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuáles?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000677",ch="sud"},
},
ja={
{
name={"Sui"},
"“No hace falta que lo diga, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo manera de saber sin que me lo digas.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0018",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000678",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Las partes más secretas de una dama, por supuesto!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"No se atrevió a decir cuál parte.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lamentablemente no tengo interés en lolis.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000679",ch="sud"},
},
ja={
{
name={"Sui"},
"“No estoy entendiendo. ¿Por qué de repente mencionaste la palabra lolis?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eres una niña.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",time=400,lv=5,id=9},
},
vl02={
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000680",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fuh... no te hagas el duro... Sé que cuando estás conmigo no puedes contener\ntanta excitación, y de ahí esa actitud tan fría.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000681",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ya lo vi todo! ¡Es tanta esa calentura que apenas me vaya no podrás evitar\nmasturbarte fuertemente!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Masturbarme?... ¡¿No puedes nombrar tus partes secretas pero sí puedes usar\nesa palabra?! ¡¿Cuáles son tus estándares como dama?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0002",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000682",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Eso es secreto de dama!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"N-No estoy comprendiendo nada...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi actitud fría es porque no tengo interés por ti. Sobre todo en el ámbito\nsexual.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0013",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000683",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿A eso estamos jugando?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No sé de qué me hablas!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"msgoff"},
{"fg",ch="吹",time=300,sync=1,my=40,mode=-1,lv=5,id=9},
{"se",file="se9032",id=1},
{"fg",ch="吹",size="z2",time=300,sync=1,my=40,mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000684",ch="sud"},
},
ja={
{
name={"Sui"},
"“No tengo atracción sexual alguna por ti, Sui. Vamos, quítate la ropa. Mi\ninterés por tu belleza es solo artístico...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="吹",time=300,sync=1,my=40,mode=-1,lv=5,id=6},
{"se",file="se9032",id=1},
{"fg",ch="吹",size="z2",time=300,sync=1,my=40,mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0015",head="sui_z2a",x=-500,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000685",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ah, y-yo, no... Kusanagi-san, esto es muy vergonzoso para mí... pe-pero, si\ntanto deseas ver el hermoso cuerpo desnudo de Sui... n-no me queda más\nremedio... No por nada, Sui es bella...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="吹",time=300,sync=1,my=40,mode=-1,lv=5,id=5},
{"se",file="se9032",id=1},
{"fg",ch="吹",size="z2",time=300,sync=1,my=40,mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0003",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000686",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡A eso me refiero!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“　　　　　　　　　”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000687",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿A qué se debe ese silencio?!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada. Solo que, es raro encontrar a alguien tan idiota, jiji.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0004",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="うんうん",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="びっくり",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000688",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Jijiji?! ¡Kusanagi-san jamás se reiría así!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así de grande fue mi asombro. Wah, qué sorpresa, qué sorpresa.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0018",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="うんうん",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000689",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Cuándo te cansarás de remedar a Sui, Kusanagi-san?...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0013",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000690",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Jaa! ¡¿Es que esto también es parte del juego?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja ya de repetir la conversación, te lo ruego. Me voy a cansar de seguirte la\ncorriente.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000691",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso sucede porque tú, Kusanagi-san, no admites el encanto de Sui.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh, está bien. Sí, lo admito, reconozco tu encanto. Así que, por, ahora.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cá, lla, te.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000692",ch="sud"},
},
ja={
{
name={"Sui"},
"¿P-Por qué, el tono amenazador?...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuve a punto de olvidar el tema más importante. En fin, quiero preguntarte\nalgo.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000693",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿De qué se trata?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has estudiado pintura alguna vez?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_sud_000694",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Pintura?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, en alguna escuela de artes o de pintura.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000695",ch="sud"},
},
ja={
{
name={"Sui"},
"“Estudiado de esa forma, no...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces aprendiste por tu cuenta?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000696",ch="sud"},
},
ja={
{
name={"Sui"},
"“Se podría decir que sí, casi todo fue por mi cuenta. Aunque sí tuve a una\nespecie de maestro.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una especie de maestro? ¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000697",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero no fue realmente mi maestro, la verdad. No me enseñó como dibujar, ni nada\nde eso.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando? No se le puede llamar maestro entonces, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=400},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000698",ch="sud"},
},
ja={
{
name={"Sui"},
"“'Yo te enseñé lo que es realmente pintar'.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000699",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso dijo una vez.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esas palabras...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bgm",file="bgm038"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000700",ch="sud"},
},
ja={
{
name={"Sui"},
"“Me parece que también me leyó bastantes libros. Muchos de ellos difíciles, sí.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde se conocieron?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000701",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Dónde? No lo recuerdo. Solo recuerdo que el maestro se quedó viéndome\nextrañado cuando estaba dibujando afuera.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_sud_000702",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero... lo que allí se ve no es real.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_sud_000703",ch="sud"},
},
ja={
{
name={"Sui"},
"“El mundo no cambiará estando ahí.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000704",ch="sud"},
},
ja={
{
name={"Sui"},
"“Recuerdo que el maestro dijo eso una vez...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000705",ch="sud"},
},
ja={
{
name={"Sui"},
"“Hmm, aunque es curioso. Había olvidado todo esto hasta ahora que te conté.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el nombre de ese maestro?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000706",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Su nombre?... Su nombre... hmm...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? No me vas a decir que lo olvidaste, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_sud_000707",ch="sud"},
},
ja={
{
name={"Sui"},
"“No debería haberlo olvidado... pero, algo me dice que no debería recordarlo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000708",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Por qué será?...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"¿Qué significa esto?",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Esa es la misma historia de cómo el viejo y Rin se conocieron.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"¿Casualidad?",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"No, casualidad no puede ser.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"¿Esta muchacha, quién es en realidad?",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"¿Es que acaso mi padre la confundió con Rin?",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"No, no tiene sentido. Él sabía que Rin es mi amiga.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"No hay manera de que se equivoque.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"¿Qué significa todo esto entonces?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000709",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está Dios dentro de ti?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000710",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, dentro de mí está Dios.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Desconozco la razón.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"No sé por qué.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Pero tengo casi toda la certeza.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"De que el maestro del cual habla, es Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Ella es la aprendiz de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... ¿podrías, un día de estos, mostrarme cómo pintas?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000711",ch="sud"},
},
ja={
{
name={"Sui"},
"“Está bien, acepto la propuesta.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_sud_000712",ch="sud"},
},
ja={
{
name={"Sui"},
"“Solo procura no perder la confianza en ti mismo ante mi genialidad, por favor.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno... sí, lo tomaré en cuenta.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000713",ch="sud"},
},
ja={
{
name={"Sui"},
"“Uhmmmm.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Sui se lleva las manos a la cabeza.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_sud_000714",ch="sud"},
},
ja={
{
name={"Sui"},
"“... ¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000715",ch="sud"},
},
ja={
{
name={"Sui"},
"“Kusanagi-san, eres un enigma.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_sud_000716",ch="sud"},
},
ja={
{
name={"Sui"},
"“A pesar de ser siempre tan negativo, eres indulgente con mi talento.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego. Si mi conjetura es cierta, eres portadora de un talento de escala\ninimaginable...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000717",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Sí así de complaciente eres con eso entonces deberías reconocer también la\nbelleza de Sui! ¡Tiembla! ¡Y ven a abrazar a esta hermosura!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Definitivamente te falta un tornillo en la cabeza...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000718",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Yo, o alguien más?!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué sé yo...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000719",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No le encuentro ningún sentido a eso, santo cielo! ¡Bien, Sui se irá ya!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000720",ch="sud"},
},
ja={
{
name={"Sui"},
"“Hasta luego.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"se",file="se9004",id=1},
{"fg",ch="吹",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Sui desaparece.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que enigmática esa muchacha...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, ya una vez llegué a ver algo parecido a los cerezos milenarios. Quizás\nestoy ya muy acostumbrado a los fenómenos paranormales.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Hay algo de discrepancia con lo que mi padre me contó, pero...",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Aun así me pareció que, era realmente ella la muchacha maldecida por la\nbelleza.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_summer",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"Me contaron que había un grupo de muchachas esperando para emboscarme en la\nentrada, pero tenía toda la seguridad de que eso no era cierto.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"¿Y qué sucedió? Pues apenas me vieron cruzar la puerta el grupo de muchachas de\notros colegios me persiguió, obligándome a montarme sobre las cercas de\nconcreto de la zona residencial y desplazarme sobre ellas.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Demonios, jamás pensé que llegaría a montarme encima de una cerca de concreto\nen este punto de mi vida.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"cgact",stage="bg015",stime="b",act="うなづく"},
{"se",file="se_hand_pan1",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, supongo que acá estaré a salvo...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000001",ch="knd"},
},
ja={
{
name={"???"},
"“¡Ah~! ¡Ahhhh~! ¡Kusanagi-kuuun!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Apenas me bajé de la cerca alguien me habló.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_c01_01",path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_knd_000002",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jaa, jaa, jaa, t-tanto tiempo, sin vernos. Soy yo, Kana Nagayama, ¡vaya\ncoincidencia encontrarnos acá!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tú, ¿p-por qué estás sudando y jadeando de esa forma?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_com_c01_02",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000003",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? E-Eso no es cierto. Así es, no es cierto. Y por otro lado, ¿por qué me\ntratas de 'tú'? Tengo un nombre con todas las de la ley, y es Kana Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"¿Kana Nagayama?",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000004",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Que quién soy? Qué cruel... ¿No recuerdas que estuvimos juntos durante la\nprimaria y la secundaria? Varias veces tocamos incluso en el mismo salón.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"bg",file="ev_com_c01_01",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000005",ch="knd"},
},
ja={
{
name={"Kana"},
"“Claro que sí. Y hoy, de repente, mientras pasaba acá casualmente te encontré,\nKusanagi-kun. ¡Realmente que la casualidad es increíble! ¡¿No crees?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Pasaste casualmente por acá, eh...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"¿Cómo es que alguien que pasaba casualmente por acá está jadeando?",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Y en primer lugar, no comentó absolutamente nada respecto a como salté de la\npared...",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Aunque, hay una buena distancia del portón de Yumihari hasta acá, eh...\n¿No estarás bastante cansada ahora?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_knd_000006",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡No, para nada! ¡Estoy perfectamente bien!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Casualmente...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_c01_04",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000007",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Así que era una de las tantas mujeres esperándome en el portón del colegio.\nAunque parece que fue la única que corrió hasta acá persiguiéndome...",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"bg",file="ev_com_c01_05",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000008",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, esto, digo... ehm, sí, eso. Kusanagi-kun, ¡retomaste la pintura, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Retomar la pintura?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_knd_000009",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, y me sorprendiste. Siempre, sieeempre me han gustado tus pinturas, y me\nsentí mal cuando supe que habías dejado de pintar.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé a qué viene el malentendido, pero... no es así.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"bg",file="ev_com_c01_01",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000010",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Lo vi todo en la TV! Fue increíble. En el instante que lo vi, pensé, 'Ah, solo\nKusanagi-kun podría hacer esto'. ¡Nadie más podría hacer algo parecido,\n¿verdad?! No podía esperar menos de ti, fue verdaderamente increíble.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Es que está hablando del mural de la iglesia?... Eso no lo hice yo, lo hizo\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"¿'No podía esperar menos de ti'? No me jodas.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_knd_000011",ch="knd"},
},
ja={
{
name={"Kana"},
"“No he podido evitar jactarme de eso en el colegio. A todos les digo 'Ah, él es\nmi amigo. Estuvimos en la misma escuela por un buen tiempo'.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"No sé si realmente estuvimos o no en el mismo colegio, pero la verdad es que no\nrecuerdo casi nada de ti.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_knd_000012",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué dejaste de pintar de un día para otro?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no te importa...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000013",ch="knd"},
},
ja={
{
name={"Kana"},
"“En ese entonces escuché rumores de que habías sufrido un accidente...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000014",ch="knd"},
},
ja={
{
name={"Kana"},
"“No sé realmente si fue por un accidente que dejaste de pintar, pero...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_knd_000015",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero si de verdad fue por tan absurda razón, entonces la persona que causó ese\naccidente debería pagar decenas, cientos, miles de millones en compensación.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="ev_com_c01_06",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000016",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Fue alguien en un vehículo o algo así? ¿Quedaste con alguna secuela? Recuerdo\nque te ausentaste del colegio por varias semanas...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_knd_000017",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahora que recuerdo, por esos mismos días...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Cállate ya!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000018",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fueh--”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No te atrevas a mencionar una vez más eso.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Razón absurda?! ¡¿Qué demonios sabes tú de mí?! ¡No sé si de verdad somos\nviejos conocidos o no, pero no vengas a balbucear estupideces con esa cara de\n'yo lo sé todo'!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bg",file="ev_com_c01_07",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000019",ch="knd"},
},
ja={
{
name={"Kana"},
"“K-Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué piensas de mí, pero en lo que a mí concierne ni siquiera recuerdo\nquién eres. Sinceramente, eres una molestia. ¡Deja de andar siguiéndome por\nahí!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"¿Viejos conocidos?",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Maldita sea, me trajo a la memoria justamente eso que no quería recordar...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazte a un lado, no tengo nada que hablar contigo...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Intento marcharme.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_knd_000020",ch="knd"},
},
ja={
{
name={"Kana"},
"“K-Kusanagi-kuun...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bg",file="ev_com_c01_08",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_knd_000021",ch="knd"},
},
ja={
{
name={"Kana"},
"“L-Lo sientooo... No pensé que llegarías a enfadarte tanto, pero no tenías por\nqué gritarme así, y más aún después de tanto tiempo sin vernos... *uuhh*,\n*uuhh*.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_knd_000022",ch="knd"},
},
ja={
{
name={"Kana"},
"“Siempre me gustaste, y solo quería expresar lo mucho que me lamentaba todo, no\nsé mucho de lo que pasó, sí, pero me sentí tan frustrada por ese accidente\nque robó de tu talento, y, Kusanagi-kun, Kusanagi-kun... Ueeehn.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qu--?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se3130",vol=70,id=1},
{"text"},
text={
ja={
{
"La muchacha, Nagayama, cayó sentada sobre el suelo en medio de la vía, y\ncomenzó a llorar fuertemente.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Las amas de casa que venían regresando de compras y los empleados que venían de\nvuelta de sus trabajos se me quedaron viendo fijamente.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Disculpa, creo que me sobrepasé con mis palabras. N-No llores, por favor.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_knd_000023",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es que, es que, no creo poder recuperarme ahora después de lo que me dijiste.\nUeeehn.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no podrás recuperarte? Ah, en fin, vamos, párate.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_knd_000024",ch="knd"},
},
ja={
{
name={"Kana"},
"“Nooo pueeedooo.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no eres ninguna niña.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_knd_000025",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Ueeehn! ¡Qué malo eres! De verdad no puedo paraaarme.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento, lo siento. ¿Qué debería hacer entonces?”",
{"rt2"},
},
},
},
linkback="block_00246",
