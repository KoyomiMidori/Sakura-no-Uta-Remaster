astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acá está mi apartamento.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1f1201",face="f0012",head="shz_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000013",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Esta es tu casa...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vengas a hacerte la tonta diciendo que creías que todo esto era mi casa.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0013",head="shz_z1f",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000014",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué la sorpresa?...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0001",head="shz_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000015",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Por un momento pensé que tenías alguna habilidad psíquica...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad pensabas salir con ese chiste?...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0002",head="shz_z1f",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000016",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí. Apenas acabamos de conocernos, así que pensé en evadir un poco lo incómodo\ncon algo de humor...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué ganas haciendo eso?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Vaya mujer tan rara...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Bueh, era de esperarse, considerando que está relacionada de alguna forma con\nKenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es acá. Las otras puertas son de los apartamentos de otras personas, no vayas a\nequivocarte.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000017",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, no hay problema. En Nueva York también habían muchos apartamentos.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah, sí? Bueno, entra.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000018",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0401",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kuzu se quita su gorro al entrar.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Dejando caer una suave y hermosa cabellera.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Ya no me cabe ninguna duda... Realmente es una preciosura.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es bastante grande, ¿eh? Aunque la gran mayoría de las habitaciones están fuera\nde uso.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0401",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000019",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las tenemos como depósito. Hay demasiadas cosas en la casa.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000020",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Usa mi habitación. Yo dormiré en la sala.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000021",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eh? ¿Dormiremos separados?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000022",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que por qué? ¿Acaso no es obvio?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000023",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué es obvio?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa~”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Me puse la mano sobre la frente.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y proseguí diciendo todo lo que se me viniera a la mente.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0401",face="a0001",head="shz_z2a",lv=5,id=9},
{"bgm",file="bgm031"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Sabes lo que va a pasar si duermo junto a una muchacha tan hermosa como tú?!\n¡Se me va a parar el pene! ¡Nada va a poder bajarme las erecciones!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000024",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Es eso en serio?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, así es! ¡Lo digo en serio, muy en serio! ¿Qué tal ahora? Te doy asco,\n¿verdad? Así somos los hombres, ¿te quedó claro? ¡Así que más vale que te\nvayas a esa habitación ya!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ud",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000025",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Permanezcamos juntos.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por, qué, demonios?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",time=350,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0001",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000026",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pensé que sería buena idea confirmar si de verdad se para tu pene.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha... no se va a parar solo porque estemos juntos.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000027",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero, acabas de decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo quería decir...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ud",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000028",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Humor?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, diablos!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0401",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000029",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Entonces...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué insistente, joder. ¡Sí, esto es humor japonés, por si no lo conocías! ¡Así\nque vete ya a tu habitación!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0401",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000030",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Kuzu lo ve así.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000031",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Estás tratando de ganarte mi desprecio diciendo vulgaridades.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tendría que hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0018",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000032",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Por consideración. Lo mejor para que no ocurra nada extraño entre los dos,\nestando bajo un mismo techo, es distanciarnos.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0401",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000033",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No es eso? ¿Qué otra razón hay entonces?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Te equivocas...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0401",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000034",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿En qué me equivoqué?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Simplemente me gustan las historias vulgares.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0401",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000035",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Qué coincidencia, a Kuzu también.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veooo. S-Sí, qué coincidencia...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0401",face="a0001",head="shz_z1a",lv=4,id=9},
