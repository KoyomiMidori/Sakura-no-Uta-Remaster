},
},
text={
vo={
{"vo",file="fem_sud_000526",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Es inconcebible! ¡¿Cómo no puede haber la talla de un traje de baño sexy para\nla sexy Sui?! ¡La gente de este local ha perdido la cabeza!”",
{"rt2"},
},
},
},
