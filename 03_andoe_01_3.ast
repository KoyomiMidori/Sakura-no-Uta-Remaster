astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg018e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,sync=1,vague=40},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Estábamos ahora frente a la entrada del centro comercial.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El centro comercial. Realmente se siente como una cita, vaya que sí.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0005",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000624",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Recuerdo haber dicho que ERA una cita.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, bueno, sí...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Tratándose de Shizuku, pensé que tenía algo distinto en mente...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000625",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tratándose de Shizuku, pensé que tenía algo distinto en mente... ¿Eso pensaste?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000626",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Acerté?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Lo dijiste por decirlo?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000627",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... no es ningún poder supernatural...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000628",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Shizuku es una chica normal. No posee ningún poder especial...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes toda la razón.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Lo habrá dicho sin pensarlo, pero vaya que dio en el blanco...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000513",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bien, ¿a cuál tienda iremos?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000629",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Veamos...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"se",file="se9004",id=1},
{"fg",ch="吹",speed=1500,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x2=-345,x=-1345,lv=4,id=5},
{"fg",ch="雫",speed=1500,mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x2=345,x=-680,lv=4,id=6},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg017a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Shizuku se detiene frente a la tienda de trajes de baño que visitamos\npreviamente con las demás.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿O-Otra vez acá?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000630",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sui, tengo un favor que pedirte.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000514",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué debo hacer?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000631",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pregúntale a la empleada si los trajes de baño se pueden probar.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000515",ch="sud"},
},
ja={
{
name={"Sui"},
"“Si se pueden probar los trajes de baño, ¿cierto? ¡Bien, Sui irá a preguntar!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"se",file="se9023",id=1},
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=5},
{"text"},
delay={
[500]={
{"se",stop=1,time=500,id=1},
},
},
text={
ja={
{
"Al decir eso, Sui salió corriendo hacia la empleada.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La vez pasada pudieron probárselos, ¿qué necesidad hay en preguntar?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000632",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me pareció que era mejor preguntar antes, y además... hay algo que quiero\ncomprobar.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Comprobar?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0005",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000633",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Observa a Sui.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-800,y=-470,file="zbg017a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0001",head="sui_z2a",x=0,lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Sui le habla a la empleada.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0003",head="sui_z2a",x=0,lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000516",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Disculpe! ¡Señorita!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_tnn_000002",ch="tnn"},
},
ja={
{
name={"Empleada"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"La empleada volteó a donde estaba Sui. Pero...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_tnn_000003",ch="tnn"},
},
ja={
{
name={"Empleada"},
"“¿Eh? ¿Fue mi imaginación?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0008",head="sui_z2a",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000517",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No está imaginándose cosas! ¡Señorita!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_tnn_000004",ch="tnn"},
},
ja={
{
name={"Empleada"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué está pasando?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_szd_000634",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Como me lo imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",x=0,lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"se",file="se9032",id=1},
{"text"},
delay={
[500]={
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"se",file="se9032",id=2},
},
[2000]={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0015",head="sui_z2a",x=0,lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
},
},
text={
ja={
{
"Sui siguió hablándole a la empleada, pero no logró recibir respuesta alguna.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0005",head="sui_z2a",x=0,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una empleada desconsiderada... no parece ser, supongo.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_szd_000635",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Posiblemente no.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_szd_000636",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La empleada no puede verla.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No puede verla?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_szd_000637",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, tampoco creo que nadie pueda verla.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_szd_000638",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Probablemente la empleada, por mera casualidad, no observó, y por eso no pudo\nverla.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No observó por casualidad? ¿Observar qué?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",x=0,lv=5,id=9},
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000518",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Disculpe!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",x2=0,x=345,lv=5,id=9},
{"fg",ch="雫",size="z2",mx=-40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1000",face="a0001",head="shz_z2a",x=-345,lv=5,id=5},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0012",head="sui_z2a",x=345,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000639",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Puedo probarme este traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Shizuku se interpone entre Sui y la empleada.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_tnn_000005",ch="tnn"},
},
ja={
{
name={"Empleada"},
"“Ah, sí, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y la empleada reaccionó de inmediato.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0002",head="shz_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000640",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Gracias, Sui. Bien, vayamos a probarnos varios trajes.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0004",head="sui_z2a",x=345,lv=5,id=9},
{"fgact",ch="吹",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000519",ch="sud"},
},
ja={
{
name={"Sui"},
