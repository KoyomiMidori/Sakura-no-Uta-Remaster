{"fg",ch="吹",mx=40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"De alguna forma, parece que Shizuku convenció a Sui.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
