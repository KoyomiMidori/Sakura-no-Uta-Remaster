},
block_00072={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000646",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres una muchacha tierna, Sui. Antes que nada debes tener eso en mente. A niñas\ntiernas como tú les queda mejor este tipo de traje.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Shizuku le muestra unos cuantos trajes de estilo tierno-infantil a Sui.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
