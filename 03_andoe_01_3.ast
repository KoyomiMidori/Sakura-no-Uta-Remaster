vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=345,lv=4,id=6},
},
vl03={
{"fgact",ch="吹",act="ジャンプ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000530",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Este traje? Mmm, de que es tierno, lo es, pero ¿no es un tanto infantil para\nel ardiente cuerpo de Sui?...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"¿Ardiente cuerpo? ¿Es en serio?... Pareces más un extraterrestre gris...",
{"rt2"},
},
},
},
linkback="block_00077",
