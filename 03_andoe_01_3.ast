block_00083={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x2=-345,x=0,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000649",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estamos ya en septiembre. ¿Por qué comprar un traje de baño ahora?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000650",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Justamente por ser septiembre. Ese traje de baño tiene un 80 % de descuento.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000651",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo sé. Pero aun después del verano podría usarlo en piscinas, ¿no crees?...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Retomando el tema de hace un rato, Shizuku. ¿A qué te referías cuando dijiste\nque no era solo por eso?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0005",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000652",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Es que acaso no te has dado cuenta, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000653",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De lo rara que es Sui.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000654",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Que te escaparas de clases y vinieras a ver el mural no tenía que ver con eso?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, en parte...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000655",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De qué forma se te hizo rara?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En aquella noche que pintamos 'Las huellas de los cerezos', por ejemplo...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era una noche calurosa, y el calor del horno era insoportable. Ni yo ni Akashi\npudimos aguantar y nos desmayamos. Y a pesar de eso Sui pudo terminar lo que\nfaltaba, como si nada.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, con una velocidad increíble.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no solo eso.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000656",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Su enorme talento al pintar. ¿Cierto?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sabes algo de Sui, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=0,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000657",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así--”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000658",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Una imagen dice más que mil palabras.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_sud_000532",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ya me cambié~!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"bgm",stop=1,time=500},
{"se",id=1,file="se1641"},
{"text"},
text={
ja={
{
"La cortina del probador se abrió con fuerza.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_sud_000533",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Qué tal?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y la Sui que vi allí--",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=50000,file="zbg017a",path=":bg/",x2=0,y2=-580,x=0,y=-470,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",speed=50000,mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2b0900",face="b0003",head="sui_z2b",y2=-320,y=-110,lv=5,id=6,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm026"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_szd_000659",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te queda muy bien, Sui.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg017a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1b0900",face="b0004",head="sui_z1b",lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="吹",act="du",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0900",face="b0002",head="sui_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000534",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿De verdad? ¿Qué te parece a ti, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sui, eso que tienes ahí... tú...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0910",face="b0008",head="sui_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000535",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Eh? ¿P-Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_szd_000660",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Parece que Naoya se quedó sin palabras ante tu sensualidad.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0910",face="b0004",head="sui_z1b",lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0910",face="b0016",head="sui_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000536",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo. No se siente nada mal escuchar eso.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000661",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Toma, creo que este te quedará muy bien también.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0910",face="b0001",head="sui_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0910",face="b0002",head="sui_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000537",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Otro color? Ya veo, sí, ese color le sienta bien a Sui. Me probaré este\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=6},
{"se",id=1,file="se1641"},
{"text"},
text={
ja={
{
"Después de decir eso, Sui cerró la cortina.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso, que acabo de ver...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000662",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sabes lo que es, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Articulaciones, de muñeca?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"No cabe duda alguna, las extremidades de Sui no eran las de un humano. Eran\narticulaciones de bola, aquellas usadas en muñecas.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000663",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí qué? ¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000664",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues, no creo que hayan muchas personas con extremidades como las de una\nmuñeca.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Prótesis de brazo y piernas?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. En ningún lugar verás prótesis así, con articulaciones de bola. Además, esa\nestructura es muy inestable para una prótesis.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería absurdo decir que es un androide, ¿no?... Esto no es ninguna película de\nciencia ficción.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000665",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Con androide te refieres a un autómata?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000666",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hace un tiempo llegaste a investigar acerca de Olympia, ¿verdad, Naoya?...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, fue mera curiosidad...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000667",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Olympia es una muñeca mecánica que aparece en el segundo acto de 'Los cuentos\nde Hoffman', una ópera.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿D-De verdad? Pero, habías dicho que no había ninguna ópera de Olympia...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0005",head="shz_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000668",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay ninguna ópera llamada Olympia. Solo existe en una llamada los cuentos de\nHoffman.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir... que ella es una muñeca mecánica?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000669",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es tan simple como eso...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000670",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, ¿recuerdas lo que sucedió después de que murió la madre de Rin?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000671",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sabes también entonces que Rin llevaba consigo a todos lados una muñeca similar\na su mamá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? E-Espera, ¿me estás diciendo que la muñeca que Rin llevaba en ese\nentonces, es Sui?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Cuando hablabas de que 'Las huellas de los cerezos' tomó como temática los\ncerezos milenarios, es porque...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000672",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En parte cierto. Pero en parte no.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En parte cierto, en parte no? ¿Qué quieres decir entonces?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000673",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estuviste allí aquel día, ¿cierto? Aquella noche, cuando florecieron los\ncerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, esa noche. Fue entonces que logré encontrar a Rin.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos cerezos se llevaron consigo la memoria de Rin. Y por eso el padre de Rin y\nyo intentamos borrar ese pasado.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000674",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ese es solo un lado de la verdad. Pero falta el otro lado...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El otro lado de la verdad?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000675",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No recuerdas lo que dijo Kenichiro-san después de eso?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000676",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sobrescribir un milagro con otro solo crea peores aberraciones...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sobrescribir un milagro, con otro...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku... no me digas que... tú...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
text={
ja={
{
"Shizuku asiente ligeramente.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",id=1,file="se1641"},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x2=0,x=-345,lv=4,id=5},
{"fg",ch="吹",size="z1",mx=40,mode=3,path=":fg/sui/z1/",file="sui_z1b0800",face="b0004",head="sui_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000538",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Bieeen, ¿qué tal este?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Sui volvió a meterse en la conversación, justo en la parte más importante.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000677",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Asiente*, definitivamente está hecho para ti, Sui. Excellent.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0800",face="b0002",head="sui_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0800",face="b0016",head="sui_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000539",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, considerando lo explosivamente sexy que es Sui, quizás el negro combine\nmejor que el blanco.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",mode=-2},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2b0800",face="b0008",head="sui_z2b",lv=5,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0003",head="sui_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000540",ch="sud"},
},
ja={
{
name={"Sui"},
"“Kusanagi-san, Kusanagi-san, ¿cómo se ve Sui? ¿Linda?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Sui se pone de puntillas, viéndome.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... no está mal, supongo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0005",head="sui_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0017",head="sui_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000541",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vaya. Qué raro verte de acuerdo con lo que Sui dice. Siempre me parecías\nalguien muy desagradable, siendo negativo en todo momento sin saber por qué.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y crees que lo soy por gusto? La culpa es de tu cabeza y las tuercas que le\nfaltan.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0002",head="sui_z2b",lv=5,id=6},
{"fgact",ch="吹",act="du",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000542",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bueno, qué más da. Basta con que me digas que me veo linda para sentirme\nalegre.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿L-Lo dices en serio?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0003",head="sui_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2b0800",face="b0004",head="sui_z2b",lv=5,id=6},
{"fgact",ch="吹",act="びっくり",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000543",ch="sud"},
},
ja={
{
name={"Sui"},
"“Por supuesto. A Sui le encanta recibir cumplidos de ti. Sui quiere mucho a\nKusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Un momento de silencio.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1b0800",face="b0004",head="sui_z1b",x=345,lv=4,id=6},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿J-Jaa?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"E-Espera, ni siquiera nos hemos visto tanto. Es imposible que de las\ndescabelladas conversaciones que hemos tenido desarrollaras esos sentimientos\npor mí...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1b0800",face="b0002",head="sui_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000544",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Verdad, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="du",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000678",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, definitivamente. No en vano ambas somos una especie de duplicado...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Duplicado?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000679",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vamos, podemos dejar eso para después. Iré a cambiarme también, ¿quieres ver?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="雫",speed=2000,mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x2=-345,x=0,lv=4,id=5},
{"text"},
text={
ja={
{
"Después de decir eso, Shizuku intenta entrar al probador, sin nada en las\nmanos.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",mode=-2},
{"bg",speed=300,sync=0,file="zbg017a",path=":bg/",x2=390,y2=-390,x=590,y=-390,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="雫",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1000",face="a0001",head="shz_z2a",x2=-200,x=0,lv=5,id=5},
{"se",file="se3130",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Y obviamente no titubeé en tomarla del brazo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, ¿qué traje de baño debería ver si no llevas ninguno?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b1000",face="b0010",head="shz_z2b",x=0,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b1000",face="b0016",head="shz_z2b",x=0,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000680",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues... el traje de baño más revelador conocido en la historia, ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No voy a dejarte! ¡Lo que vas a hacer es desnudarte!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"mwact",act="ジャンプ"},
{"se",file="se9031",id=1},
{"text"},
text={
vo={
{"vo",file="fem_sud_000545",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Yo también quiero hacerlo!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ni creas que también te dejaré a ti!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0011",head="shz_z2a",x=0,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000681",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Pero, Naoya, los juegos sexuales...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En ningún momento he pedido eso!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0008",head="shz_z2a",x=0,lv=5,id=5},
{"fgact",ch="雫",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000682",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Pero, las eventualidades sexuales...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nada de eventualidades sexuales! ¡Ya me estaba pareciendo desde que llegamos,\nlo que intentas hacer nada tiene que ver con eso!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"La emoción de Sui era incontenible, por lo que Shizuku y yo no pudimos seguir\ncon la conversación de hace un momento.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Pero, viendo cómo trataba a Sui, Shizuku parecía estar divirtiéndose.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Sui, y Shizuku... ¿Qué vínculo habrá entre las dos?...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Aunque no sé si, a final de cuentas, sea correcto ponerme a indagar mucho en\neso.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Ese incidente ya es cosa del pasado.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Así lo decidí yo, y de esa manera pienso dejarlo.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Estoy seguro de que Shizuku piensa igual...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Pero, de ser así...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"¿Por qué Shizuku me enseñó el secreto de Sui?",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg018f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000683",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, tomémonos fotos en el purikura.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Purikura?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000546",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui también quiere tomarse fotos.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Pero Sui...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Las personas no pueden verla, ¿puede aun así aparecer en fotos?",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1000",face="a0005",head="shz_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000684",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fotos paranormales... (susurro)”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahh.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Solo esas palabras bastaron para entenderlo todo.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000547",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Fotos paranormales? ¿Qué pasa con eso?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000685",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es nada. Bien, vayamos por unas lindas fotos.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000548",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Reto aceptado!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bgm",stop=1,time=1500},
{"msgoff"},
{"fg",mode=-2},
{"bg",file="nightsky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Y de esta manera -y vaya que no me imaginé al principio que sucedería-, la cita\ntranscurrió de manera muy amena, haciéndose bastante tarde.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Me escapé de clases, pero valió la pena.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000549",ch="sud"},
},
ja={
{
name={"Sui"},
"“Me divertí bastante hoy. Es maravilloso salir con Shizuku y con Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000686",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me alegro.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000550",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bueno, Sui se retira.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000687",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien. Cuando puedas ven a pasar la noche con los Natsume.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000551",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Los Natsume?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000688",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Creo haberte hablado ya de eso varias veces. ¿No lo recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000552",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo sé... Sui ha olvidado muchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000689",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Con el paso de los días recordarás más cosas, me parece.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000553",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tienes razón. Darle tiempo al tiempo, y redescubrir muchas cosas. Eso haré.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000690",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ujum. Bien, nos vemos, Sui.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000554",ch="sud"},
},
ja={
{
name={"Sui"},
"“Espero que podamos vernos de nuevo, Shizuku. ¡Y Kusanagi-san también!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así será.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"se",file="se9004",id=1},
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Después de esas palabras, Sui desapareció en el bullicio de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Viéndola sonriendo de esa manera la hace ver como una muchacha común y\ncorriente.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Aunque quedé anonadado cuando me dijo, de la nada, 'te quiero'...",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"La expresión de su cara en ese momento era la de una niña normal.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Pero sus extremidades eran las de una muñeca.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Eso implica que normal, no es.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Me preocupa también el hecho de que Shizuku preguntara por 'Las huellas de los\ncerezos'.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
ja={
{
"Observo a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000691",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así como le ocultaste varias cosas a Rin, yo también oculté unas cuantas otras.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000692",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si contarlo todo pudiera afectarte de alguna manera, preferiría no hacerlo...\npero...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000693",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quizás, sí pueda contarlo todo. Lo que sucedió entre Rin y yo... y acerca de\nSui...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000694",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hace falta alguna de ocultar nada, siempre y cuando tenga certeza de que\nnada sucederá.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pero, si llegara a suceder algo...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fgact",ch="雫",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000695",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No lo creo, por ahora son pocas las posibilidades de que suceda. Siempre que no\nse trate de algo grande, y realmente importante. No por nada Sui y yo nos\nhemos mantenido estables...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estables...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, tiene eso algo que ver con tu pod... perdón, ¿con el poder de Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000696",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kuzu... Cada vez que escucho ese nombre siento algo de nostalgia.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Tampoco es que ha pasado tanto tiempo, que yo sepa.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",lv=4,id=5},
{"fgact",ch="雫",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000697",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ha pasado tanto tiempo desde que pude disfrutar de ese sabor por última vez.\nCómo me encantaría probarlo de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto tiempo que no disfrutas de ese sabor? ¿Qué sabor?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",lv=4,id=5},
{"fgact",ch="雫",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000698",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es nada. Bueeeno, ¿nos vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vamos.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_andoe_01_4"},
{"text"},
linkback="block_00248",
},
label = {
top={block="block_00000",label=1},
},
}
