astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c11_01",path=":ev/ev_eye_c11/",set="ev_eye_c11"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001641",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yuumi?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mi voz resuena a través de la luz roja del lugar.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"bg",file="zev_com_d05_01",zoom=130,speed=90000,path=":ev/ev_com_d05/",set="ev_com_d05",x2=-1010,y2=290,x=-860,y=290,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Era ya de tarde en la sala de arte, y no había nadie.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Sin respuesta alguna, allí estaba Yuumi dormida, exhausta.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_rna_001642",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Me acerco lentamente a su lado.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Parece que no aguantó el cansancio.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rna_001643",ch="rna"},
},
ja={
{
name={"Rina"},
"“Era verdad lo que dijo senpai...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"La idea de que quizá se había metido en algún problema se cruzó por mi mente,\npero tal como senpai me dijo, solo estaba dormida.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Aunque, debe estar exhausta, supongo. No encuentro otra explicación posible\npara que esté durmiendo acá.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_rna_001644",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, no estarás metiéndote en otro gran problema de nuevo, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Yuumi no contesta.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_rna_001645",ch="rna"},
},
ja={
{
name={"Rina"},
"“Todavía no puedo creer que hayas armado semejante alboroto por algo tan\nridículo...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_rna_001646",ch="rna"},
},
ja={
{
name={"Rina"},
"“Que pueda o no pueda hablar con senpai realmente no me importa, ¿sabías?...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_rna_001647",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué serás así?...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_rna_001648",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero probablemente sea mía la culpa... Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"De ese pequeño veneno, del cual probablemente ni yo me había dado cuenta.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"De esa pequeña seta venenosa.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Saco un libro de mi mochila.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Y comienzo a leerle a Yuumi, mientras esta duerme.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_d05_01",path=":ev/ev_com_d05/",set="ev_com_d05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001649",ch="rna"},
},
ja={
{
name={"Rina"},
"“Había una vez una niñita en un pueblo, la más bonita que jamás se hubiera\nvisto.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rna_001650",ch="rna"},
},
ja={
{
name={"Rina"},
"“Su madre estaba enloquecida con ella y su abuela mucho más todavía.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rna_001651",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esta buena mujer le había mandado hacer una caperucita roja, y le sentaba tanto\nque todos la llamaban Caperucita Roja.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_rna_001652",ch="rna"},
},
ja={
{
name={"Rina"},
"“Un día, su madre, habiendo cocinado unas tortas, le dijo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rna_001653",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Anda a ver cómo está tu abuela, pues me dicen que ha estado enferma; llévale\nuna torta y este tarrito de mantequilla.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_rna_001654",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caperucita Roja partió en seguida a ver a su abuela que vivía en otro pueblo.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rna_001655",ch="rna"},
},
ja={
{
name={"Rina"},
"“Al pasar por un bosque, se encontró con el compadre lobo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rna_001656",ch="rna"},
},
ja={
{
name={"Rina"},
"“Este tuvo muchas ganas de comérsela, pero no se atrevió porque unos leñadores\nandaban por ahí cerca.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rna_001657",ch="rna"},
},
ja={
{
name={"Rina"},
"“Él le preguntó a dónde iba.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_rna_001658",ch="rna"},
},
ja={
{
name={"Rina"},
"“La pobre niña, que no sabía que era peligroso detenerse a hablar con un lobo,\nle dijo:”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_001659",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Voy a ver a mi abuela, y le llevo una torta y un tarrito de mantequilla que mi\nmadre le envía.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_rna_001660",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¿Vive muy lejos?, le dijo el lobo.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_rna_001661",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¡Oh, sí!, -dijo Caperucita Roja- más allá del molino que se ve allá lejos, en\nla primera casita del pueblo.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_rna_001662",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Pues bien, dijo el lobo, yo también quiero ir a verla; yo iré por este camino,\ny tú por aquél, y veremos quién llega primero.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_rna_001663",ch="rna"},
},
ja={
{
name={"Rina"},
"“El lobo partió corriendo a toda velocidad por el camino que era más corto, y la\nniña se fue por el más largo, entreteniéndose en coger avellanas, en correr\ntras las mariposas y en hacer ramos con las florecillas que encontraba.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_rna_001664",ch="rna"},
},
ja={
{
name={"Rina"},
"“Poco tardó el lobo en llegar a casa de la abuela; golpea: Toc, toc.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_rna_001665",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¿Quién es?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rna_001666",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es su nieta, Caperucita Roja, -dijo el lobo, disfrazando la voz- le traigo una\ntorta y un tarrito de mantequilla que mi madre le envía.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_rna_001667",ch="rna"},
},
ja={
{
name={"Rina"},
"“La cándida abuela, que estaba en cama porque no se sentía bien, le gritó:”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_rna_001668",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Tira la aldaba y el cerrojo caerá.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rna_001669",ch="rna"},
},
ja={
{
name={"Rina"},
"“El lobo tiró la aldaba, y la puerta se abrió. Se abalanzó sobre la buena mujer\ny la devoró en un santiamén...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_rna_001670",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues hacía más de tres días que no comía.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rna_001671",ch="rna"},
},
ja={
{
name={"Rina"},
"“En seguida cerró la puerta y fue a acostarse en el lecho de la abuela,\nesperando a Caperucita Roja.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rna_001672",ch="rna"},
},
ja={
{
name={"Rina"},
"“Un rato después, esta llegó a golpear la puerta: Toc, toc.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rna_001673",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¿Quién es?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_rna_001674",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rna_001675",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caperucita Roja, al oír la ronca voz del lobo, primero se asustó, pero creyendo\nque su abuela estaba resfriada, contestó:”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rna_001676",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es su nieta, Caperucita Roja, le traigo una torta y un tarrito de mantequilla\nque mi madre le envía.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_rna_001677",ch="rna"},
},
ja={
{
name={"Rina"},
"“El lobo le gritó, suavizando un poco la voz:”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rna_001678",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Tira la aldaba y el cerrojo caerá.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_rna_001679",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caperucita Roja tiró la aldaba y la puerta se abrió. Viéndola entrar, el lobo\nle dijo, mientras se escondía en la cama bajo la frazada:”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rna_001680",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Deja la torta y el tarrito de mantequilla en la repisa y ven a acostarte\nconmigo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_rna_001681",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caperucita Roja se desviste y se mete a la cama y quedó muy asombrada al ver la\nforma de su abuela en camisa de dormir. Ella le dijo:”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_001682",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Abuela, ¡qué brazos tan grandes tiene!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_rna_001683",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es para abrazarte mejor, hija mía.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_rna_001684",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Abuela, ¡qué piernas tan grandes tiene!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_rna_001685",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es para correr mejor, hija mía.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rna_001686",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Abuela, ¡qué orejas tan grandes tiene!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_rna_001687",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es para oír mejor, hija mía.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rna_001688",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Abuela, ¡que ojos tan grandes tiene!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_rna_001689",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Es para ver mejor, hija mía.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rna_001690",ch="rna"},
},
ja={
{
name={"Rina"},
"“~Abuela, ¡qué dientes tan grandes tiene!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rna_001691",ch="rna"},
},
ja={
{
name={"Rina"},
"“~¡Para comerte mejor!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rna_001692",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y diciendo estas palabras, este lobo malo se abalanzó sobre Caperucita Roja y\nse la comió.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rna_001693",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquí vemos que la adolescencia, en especial las señoritas, bien hechas, amables\ny bonitas, no deben a cualquiera oír con complacencia.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_rna_001694",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y no resulta causa de extrañeza ver que muchas del lobo son la presa.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rna_001695",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y digo el lobo, pues bajo su envoltura no todos son de igual calaña:”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rna_001696",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los hay con no poca maña, silenciosos, sin odio ni amargura...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rna_001697",ch="rna"},
},
ja={
{
name={"Rina"},
"“Que en secreto, pacientes, con dulzura van a la siga de las damiselas hasta las\ncasas y en las callejuelas;”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rna_001698",ch="rna"},
},
ja={
{
name={"Rina"},
"“Más, bien sabemos que los zalameros entre todos los lobos ¡ay! son los más\nfieros.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rna_001699",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cuídense mucho, jóvenes, y en especial, las señoritas.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"Los cuentos de hadas de Charles Perrault son los trabajos más antiguos en lo\nque al género de la fábula se refiere.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Y por supuesto, más que los de los hermanos Grimm.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"En la Caperucita de Perrault no hay ningún cazador que salve a caperucita y a\nsu abuela, como en el caso de la versión de los Grimm.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"En su lugar, la historia termina con una moraleja.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"La metáfora oculta en la historia es bastante obvia. Jamás encontrarás en la\nenciclopedia a un lobo que lleve jovencitas a la cama.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"No es difícil darse cuenta de la enseñanza que busca dar la historia.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"¿Y si la muchacha de la historia no hubiera sido caperucita roja?",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"¿Y si en lugar de una muchacha con una caperuza roja, hubiera sido una con una\nsombrilla blanca?",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"La niña de la sombrilla blanca era, al igual que la caperucita roja, amada y\nquerida por muchos.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Así que, probablemente, el lobo se comería a la niña de la sombrilla blanca,\nasí como lo hizo con caperucita.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Pero esa sombrilla blanca es peligrosa.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Hay que cuidarse de todo lo bello que lleve sombrilla o sombrero blanco.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Existen tres especies de setas conocidas, por su mortal veneno, como las tres\nmuertes.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Tres setas venenosas, muy conocidas a lo largo del planeta por su veneno.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"La amanita virosa.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"En Europa le conocen como el 'Ángel Destructor>Destroying Angel'. Es la mayor\nresponsable por las muertes de envenenamiento en Japón.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Y así como lo indica la alusión a los ángeles que hay en su nombre, tanto su\ntallo como su sombrero son blancos.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Luego le sigue la amanita verna.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Es hermosa y blanca. Pero solo una de ellas tiene suficiente veneno como para\nmatar a quien se la coma.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Su sombrero y tallo son también blancos.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Finalmente está la amanita phalloides.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Su sombrero es de un blanco con tinte oliva. El resto de su cuerpo es puro\nblanco.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Crece de forma natural en Europa, y le llaman 'death cap' (sombrero de la\nmuerte).",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Esas tres setas, bien conocidas por ser las más venenosas que hay, son blancas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Cubiertas por un vestido y una sombrilla blanca.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"¿Que sería de caperucita roja entonces si, en lugar de llevar una caperuza\nroja, llevara una sombrilla blanca?",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"¿Que sucedería con el lobo que, después de tres días de hambruna, logró comerse\na la muchacha y a su abuela?",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La niña de la sombrilla blanca no tenía como apodo 'ángel destructor' ni\n'sombrero de la muerte', pero poseía un veneno propio de sí, así como todas\nesas setas venenosas.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Ella tenía una dieta a base de 'UFT Sunfural S', y al alimentarse de veneno,\nnaturalmente este se acumulaba en su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Así como el fugu acumula tetrodotoxina al consumir veneno, ella también\nacumulaba ese tóxico 'UFT Sunfural S', en su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Los efectos al consumirlo se asemejan bastante a los de la tetrodotoxina.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Ella era una seta venenosa, del género de las Amanita, con tallo y sombrero\nblanco. La niña Amanita atrae a los demás con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"La niña Amanita está siempre sonriendo entre todos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Ni el lobo más astuto podría diferenciarla de la caperucita roja.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_d05_02",sync=0,face=1,time=400,path=":ev/ev_com_d05/",set="ev_com_d05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001700",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... ¿Te habías dado cuenta ya?...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rna_001701",ch="rna"},
},
ja={
{
name={"Rina"},
"“Del veneno que tenía dentro de mí...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Fue de niña que llegué a ver al lobo de mi historia.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Se me hizo hermosa, viendo cómo llevaba las riendas de esa gran manada. Y\ntambién se me hizo insoportable.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"No importara qué tan fuerte estuviese el sol, ella llevaba a su manada afuera,\ncazando todo tipo de presa.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y así como el lobo del cuento, ella era siempre ágil, más ágil que nadie para\ncapturar a su víctima.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Un día escuché que a una muchacha mayor le habían troceado el cabello.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Otro día escuché que a otra le habían roto la ropa y la habían desnudado.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Me enteré de eso al escuchar las historias que circulaban por varios de los\ngrupos de niñas.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Muchas de ellas escucharon las historias mientras temblaban de terror.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Pero ese no fue el caso para la niña de la sombrilla blanca.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"A ella se le hacía insoportable el Lobo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"La niña no podía correr, ni tampoco cazar.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Ni siquiera podía estar afuera por mucho tiempo.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Y por eso, no soportaba a aquella niña que corría, libremente, con su manada de\nlobos bajo el sol. La envidia era inaguantable.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"A la niña Amanita se le ocurrió dejarse comer por la niña Lobo.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"De esa manera su veneno alcanzaría hasta el último rincón de la niña Lobo, y\npodría matarla.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"De esa manera el Lobo no podría correr, ni cazar a nadie jamás.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Eso planeó hacer la niña Amanita.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Un día, en el salón.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Al cruzar su mirada con la de la niña Lobo, la niña Amanita le lanzó una\nsonrisa fingida.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Le sonrió con su careta más hermosa y tierna.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"La niña Lobo percibió peligro en esa sonrisa.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Y por eso pateó la mesa y se salió del salón.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Su intuición estaba más que acertada.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Seguramente sus instintos de lobo le alertaron del peligro que se ocultaba en\nesa sonrisa.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Pero a veces el destino juega cruelmente.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Ella misma puso sus pies sobre el parque donde crecía esa seta.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"El parque de los Zypressen.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Gogh los describió como 'un bello obelisco negro'.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Un símbolo de la muerte.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"La niña Lobo entró allí despreocupadamente.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"En la noche de los Zypressen.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Teniendo la oportunidad de verla de cerca, a la niña Amanita se le hacía\ninsoportable ver su rozagante y brillante piel.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"La niña Amanita quería teñirla de muerte. Así como lo estaba ella ahora.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Y para eso, ella le habló a la niña Lobo, buscando atraer lo más que pudiera su\natención.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"No había de qué preocuparse. La niña Amanita no podía actuar por cuenta propia.\nPero podía mimetizarse con el ambiente que la rodeaba.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"El blanco es el color más adecuado para teñirse con los colores de los demás.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Su especialidad era saber de qué manera actuar para alegrar a los otros.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Y fue por eso que la niña Lobo cayó fácilmente de rodillas por la niña Amanita.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Tentada por esa blanca Amanita...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_d05_03",sync=0,face=1,time=400,path=":ev/ev_com_d05/",set="ev_com_d05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001702",ch="rna"},
},
ja={
{
name={"Rina"},
"“Simplemente no te soportaba...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rna_001703",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te envidiaba...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_001704",ch="rna"},
},
ja={
{
name={"Rina"},
"“Para la niña Amanita, viviendo siempre en las sombras, el Lobo era en todo\nmomento un ser de encanto y admiración.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_rna_001705",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tenía una gran melena de azul oscuro, y una radiante y blanca piel.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rna_001706",ch="rna"},
},
ja={
{
name={"Rina"},
"“Era tan hermoso, y a la vez inaguantable...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_rna_001707",ch="rna"},
},
ja={
{
name={"Rina"},
"“Insoportable para alguien como yo, estando en lo más profundo del abismo de la\nmuerte...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rna_001708",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es por eso que...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Perdóname, Yuumi.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Fui yo quien te quitó los colmillos.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Fui yo quien te quitó la agilidad.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Fui yo quien te convirtió en una muchacha cualquiera.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rna_001709",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me quedaré contigo, hasta el final...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"excall",label="label01",cond="f.yum==1"},
{"excall",label="label02"},
{"text"},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"La besé.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_05"},
{"text"},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_001829",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y justo en ese momento, un cazador que pasaba cerca de la casa decidió\nacercarse, alarmado por los fuertes ronquidos de la vieja...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_d05_04",sync=0,face=1,time=400,path=":ev/ev_com_d05/",set="ev_com_d05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001710",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_yum_001830",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Juraba que Yuumi había dicho algo, pero estaba allí, durmiendo como lo ha\nvenido haciendo desde hace rato.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_rna_001711",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ese fue...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"¿Por qué escuché eso?",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Ese extracto, que me pareció escuchar con la voz de Yuumi, es de la Caperucita\nroja de los hermanos Grimm.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Su final es muy distinto al de la versión de Perrault.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="ev_com_d05_05",sync=0,face=1,time=400,path=":ev/ev_com_d05/",set="ev_com_d05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001712",ch="rna"},
},
ja={
{
name={"Rina"},
"“El cazador...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Portador de un poder absoluto e insuperable, este hizo trizas el pacto entre el\nlobo y la niña.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"De la manera más absurda, trajo consigo el final más absurdo.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"El cazador.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Las moralejas no funcionan con él.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Y es que él es un prodigio, bendecido con talento por Dios.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Su pincel es capaz de aniquilar incluso el más mortal de los venenos.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Ante él, la Amanita es solo una seta blanca cualquiera.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
