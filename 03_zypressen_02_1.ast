astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Subo la colina de Yumenouki mientras me froto los ojos.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Qué sueño, qué sueño.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000977",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uaah, qué sueño.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Rina me observa algo preocupada.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Ahh, qué carita tan linda tiene Rina ahora...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001314",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No has dormido bien?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_000978",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uhm, más que falta, es exceso de sueño.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001315",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Exceso de sueño?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_yum_000979",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No te pasa que te sientes más cansada de lo normal cuando duermes mucho?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001316",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sé cómo se siente. Suele pasar.\nPero ¿por qué estás durmiendo tanto? ¿Te sientes mal, estás enferma?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_yum_000980",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001317",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001318",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por cierto, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_yum_000981",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001319",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué te fuiste sin esperarme ayer?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_yum_000982",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, pues, dejé una nota escrita, ¿no? De que tenía algo que hacer.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001320",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Algo que hacer?... ¿Sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_yum_000983",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Vaya, vaya, vaya, será que tu amor por mí finalmente se manifestó y ahora\nte preocupa saber absolutamente todo lo que hago, Rina?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0018",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008i",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001321",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, en lo absoluto. Solo que la amiga con la que siempre me la paso se fue\nrepentinamente del colegio ayer, y quiero saber qué sucedió. Es todo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_yum_000984",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo. Bien, de ahora en adelante ya no volveré a dejarte en el colegio e irme\nyo sola. Estaré siempre a tu lado, Rina. Al ir y al regresar del colegio, en\nel baño, en la tina, en la cama, en todo momento.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001322",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso es lo que hacen los espíritus malignos...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"La verdad es que ayer no tenía nada por hacer.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Solo estaba tomando algo de precaución.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"En caso de que algo sucediera, podría terminar involucrando a Rina. Y por eso\nme regresé sola...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Pero nada ocurrió. Ahhh, me enfrasqué demasiado en el asunto. Y pensar que\nsacrifiqué mi valioso tiempo con Rina para evitarme problemas. Mucho esfuerzo\npara nada.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"De saber que nada ocurriría hubiera regresado con ella a casa.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Y en lo que pensaba eso, atravesamos la puerta frontal del colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000985",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Me quedo parada frente a mi casillero.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_yum_000986",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Alguien abrió esto...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_001323",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Había dejado la puerta del casillero cerrada con un pequeño trozo de cinta\nadhesiva de papel en el borde. Tan pequeño que nadie se dé cuenta al abrirla.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Y el trozo de cinta se había despegado.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abro mi casillero.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_yum_000987",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Humuh...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"No parecen haber puesto alguna trampa o triquiñuela sobre el casillero como\ntal.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Era de esperarse... No son la clase de gente capaz de exprimir la cabeza para\nhacer algo así.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¿Y por qué lo digo? Pues, porque todas parecían estúpidas...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Volteo mis uwabaki.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",id=1,file="se_gabyo"},
{"text"},
text={
ja={
{
"Y al hacerlo, una enorme cantidad de chinchetas salieron de ellos, junto a ese\ntípico sonido que hacen al chocar unas con otras.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Muy anticuada esta provocación...\nTanto que me dejaron algo perpleja.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0013",head="rna_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001324",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... e-esto es...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Rina me ve con preocupación.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_yum_000988",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Chinchetas.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001325",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Chinchetas? ¿Solo eso? ¿Cómo es que puedes reaccionar con tanta calma?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_yum_000989",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues lo más seguro es que sea alguna provocación por parte de las fans de\nKusanagi-senpai. Parece que lo de su popularidad no es mentira.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006",head="rna_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001326",ch="rna"},
},
ja={
{
name={"Rina"},
"“De nuevo con esa actitud... Yuumi, ¿hiciste lo de ayer aun sabiendo que esto\npasaría?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Rina me ve con una mirada un tanto enojada.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Ah, claro. Rina se enfadó conmigo ayer justamente porque estaba preocupada por\nmí.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"No se siente nada mal esto, eh.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Tan feliz me hace eso que incluso me hace olvidar que me acaban de hostigar.\nFue un lindo mal cálculo de mi parte, definitivamente.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001327",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Recuerdo bien las caras de las muchachas de ayer, iré a hablar con ellas!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_yum_000990",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, espera, no son el tipo de gente con la que se pueda discutir con razón.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001328",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pero aun así--!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"A diferencia de mí, Rina tiene una gran habilidad para comunicarse con\ndestreza.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Quizás la manada de fieras podría acceder a calmarse, de escucharla a ella.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Rina siempre maneja las cosas con muchísima sensibilidad y delicadeza.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Todo lo contrario a mí.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Y así ha sido, desde que éramos niñas.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Siempre ha estado rodeada de personas, en todo momento. De pequeña lo era, y lo\nsigue siendo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"La verdad es que es simplemente descabellado el hecho de que Rina se junte con\nuna oveja negra como yo.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_000991",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es nada serio, además, ya estoy acostumbrada a estas cosas.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0018",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001329",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada tiene que ver que estés acostumbrada o no.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Rina está molesta conmigo.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Aunque bueno, supongo que es inevitable que lo esté.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Probablemente se dio cuenta fácilmente de que lo de ayer fue solo una\nintromisión mía, para ayudarla.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Con lo popular que es Kusanagi ahora, Rina no puede hablar con él.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Odio a Kusanagi, pero Rina está enamorada de él.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No puedo evitar querer hacer algo por la chica que me gusta, sabiendo eso.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"¿De verdad es así?",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Odio a Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Espera, ¿es que realmente lo odio?",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Ese artista, ese excéntrico vive siempre sorprendiéndome y haciendo que me\naltere. Pero sé que definitivamente lo que siento por él es algo distinto al\nodio.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Y probablemente sé también ya de qué sentimiento se trata.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_yum_000992",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, hora de poner esto...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"se",file="se9010",id=1},
{"mwact",act="おじぎ",size=5},
{"text"},
text={
ja={
{
"Me saco un muy particular objeto del bolsillo.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Son las partes de un encendedor que compré en la tienda de 100 yenes.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Sin esperar más, pongo manos a la obra.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001330",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué haces?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_000993",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mm? Estoy instalando el mecanismo de disparo de un encendedor eléctrico de 100\nyenes...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001331",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mecanismo de disparo?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_yum_000994",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estoy conectándolo de manera que al tocarlo con las manos desnudas este lance\nun pequeño corrientazo, o algo así, supongo.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001332",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Puedes hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_yum_000995",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, los mecanismos de disparo de los encendedores de 100 yenes usan\nelectricidad para generar la chispa, así que sueltan un poquito de corriente.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_yum_000996",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo basta con colocarlo de manera que conduzca electricidad al momento de\nabrir y cerrar la puerta del casillero, y voilá. Tienes una sencilla trampa\neléctrica.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_yum_000997",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Listo...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001333",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_yum_000998",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡La maldad se castiga con maldad! Mis principios y razón de actuar se basan en\neso.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Rina me observa, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_000999",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Conoces muy bien cómo era yo hace tiempo, ¿no, Rina? Soy la clase de chica que\nno se deja derrotar por absolutamente nadie.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001334",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo sé. Así eres, pero...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Así es.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Siempre he sido una mujer fuerte.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Rina lo sabe.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se1279",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Apenas entramos al salón, los saludos comenzaron a llover sobre Rina.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000012",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“¡Hikawa-saaan, buenos días!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_rna_001335",ch="rna"},
},
ja={
{
name={"Rina"},
"“Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000027",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"¿Viste la tele ayer? Pasaron a--",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Al entrar al salón la gente comienza a reunirse a su alrededor.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Me escurro a un lado y me siento en mi puesto.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"mwact",act="おじぎ"},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001000",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Uhm...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"En lo que a mí concierne, suelo ser tranquila y silenciosa en el salón.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"De comportarme como la pequeña delincuente que era hace tiempo, le traería\nproblemas a Rina, así que me hago pasar por la niña tranquila, al menos acá.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Siendo una cualquiera más en el salón, probablemente solo me vean como una\nmuchacha tímida y taciturna.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Me conviene igual así. No quiero hablar con más nadie que con la chica que me\ngusta.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Odio lidiar con personas que no conozco.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Y no conozco a casi nadie en esta clase.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001336",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ah, lo olvidaba!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Después de conversar un rato con la gente del salón, Rina vino a hablarme.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0016",head="rna_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001337",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, hoy hay presentación de cuadernos. ¿Tienes tus apuntes al día?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
"Giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002i",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001338",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedes entregar eso así... Toma, tomé una copia de mis apuntes, cópialos\ndurante la clase. Y todos.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_001001",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_jka_000026",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Ahh, Hikawa-san, ese cuaderno es muy lindo! ¿Dónde lo compraste?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001339",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿este? Lo compré en Internet, es de una línea de papelería de un fabricante\nde vestidos.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Rina nunca ha intentado forzarme a entrar en sus conversaciones con los demás.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Pero siempre está atenta de mí, procurando no dejarme completamente sola.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Una muestra de consideración muy propia de Rina, diría.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"se",id=1,file="se_sliding_door"},
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="man_kya_000026",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Vamos, a sus puestos, que voy a comenzar la clase.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"El profesor entra.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Las muchachas que estaban reunidas alrededor de Rina se fueron a sus puestos.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Alrededor de Rina siempre ha habido gente.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Ha sido lo mismo desde aquel día.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"bg",file="ev_uni_c28_01",path=":ev/ev_uni_c28/",set="ev_uni_c28"},
{"text"},
text={
ja={
{
"Desde la noche anterior a los ZYPRESSEN.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Desde aquel día veo siempre chicas y más chicas junto a ella.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Se me hacía irritante verla así.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"En aquella noche de los ZYPRESSEN.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Me enamoré de ella.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"El chotacabras se convirtió en una llama azul, y el escorpión en una llama\nroja.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Pero mi horrendo ser no pudo convertirse en nada.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Me puse a pensar de nuevo en los cipreses.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Últimamente solo he estado pensando en eso.\nEn esos negros, negros ZYPRESSEN.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Y como cosa natural, recuerdo también a ese hombre que convirtió aquellos\nnegros ZYPRESSEN en cerezos.",
{"rt2"},
},
},
},
linkback="block_00132",
