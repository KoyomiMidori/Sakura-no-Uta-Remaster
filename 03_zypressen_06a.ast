astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="あくび",time=500,lv=4,id=9},
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003384",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nghhh, creo que ya está por hoy.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Que ya es la hora?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003385",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. ¿Podrías revisarla?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003386",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué te parece?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no está mal. Bien por ahora, supongo.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003387",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Menos mal.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿será que guardamos todo y nos vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うんうん",time=500,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003388",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, está bien. Mochila, ven a mí mochila～”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin va por su mochila, la cual había dejado al lado de la ventana.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003389",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Y se detuvo al llegar a ella.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Parece que está viendo algo afuera.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003390",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mmm? No es nada.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003391",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, se me olvidaba. Hoy tengo algo por hacer.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo por hacer?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003392",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Y también recordé que debo limpiar los instrumentos de pintura. ¿Podrías\nirte sin mí?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, si es solo por eso no tendría problema en esperarte...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003393",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tranquilo, no hace falta. Y Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003394",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No sería bueno que regreses a casa temprano? Al menos de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003395",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si te quedas acá conmigo ayudándome, dejarás a los demás Natsume esperándote\npara cenar.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En eso no hay problema, últimamente he estado regresando siempre a la misma\nhora, ya se acostumbraron.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003396",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bueno, sí, pero... ¿Podrías irte sin mí hoy?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, si tanto me lo pides...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003397",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por favor. Me da mucha pena tenerte siempre esperándome.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Me iré ya entonces.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003398",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, nos vemos. Gracias por hoy.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay de qué.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="eveningsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Decido regresar a casa de una vez, urgido por la inexplicable presión de Rin.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Pero sí, considerando lo que sucedió esta mañana, es de esperar que no quiera\ncaminar afuera conmigo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Salgo del salón de arte.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"cgdel",id=-1},
{"se",file="se1279",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001841",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿¿Eh? ¿Senpai?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, Hikawa. ¿Qué haces acá? ¿Por qué no estás con Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001842",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, es que... al parecer se fue sin mí.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, pero qué raro eso. ¿Se fue sin decirte nada?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001843",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, precisamente. Dejó una nota...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una nota? ¿Por qué hizo eso?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001844",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé por qué. Así que estuve buscándola en los lugares donde pensé que podría\nestar.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no la has encontrado, supongo.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001845",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Solo me queda el salón de arte por revisar...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No había nadie más allí aparte de Rin y yo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001846",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En serio?... Uhmm, entonces sí se fue sin mí.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, ya veo. ¿Qué tal si nos regresamos juntos entonces? Para variar un poco.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001847",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Los dos?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. ¿Te desagrada la idea?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001848",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero qué tonterías dices, por supuesto que no...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Digo, siempre está Yuumi también, y pensé que no te gustaría mucho estar a\nsolas conmigo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001849",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es en serio? Más bien sería como un premio para mí.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un premio? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0016",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001850",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién sabe? En fin, ¿variamos un poco y regresamos juntos? Aunque, si no mal\nrecuerdo nuestras casas están en direcciones totalmente distintas.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta mitad de camino entonces.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Intento caminar hacia el portón frontal.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Pero entonces,",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0005",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001851",ch="rna"},
},
ja={
{
name={"Rina"},
"“No te recomendaría el portón frontal.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0015",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001852",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está rodeado de toda una multitud de fanáticas esperándote.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? Eso es absurdo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001853",ch="rna"},
},
ja={
{
name={"Rina"},
"“No estoy mintiendo. Justo hace un rato pasé por ahí...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás segura de que no era una simple multitud de gente?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001854",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quieres probar entonces y regresar caminando en medio de esa manada de mujeres\ninteresadas?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Creo que mejor no.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001855",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vayamos por el portón trasero. Por allí no había nadie.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaríamos yendo en dirección opuesta a la estación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001856",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tendremos que caminar un poco más de lo usual. ¿Quieres venir igual?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguiré tu consejo por los momentos...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="eveningsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Salimos del colegio por la puerta trasera.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Según Hikawa, hasta hace unos minutos habían colegialas merodeando por acá\ntambién. Me cuesta creerlo, pero... no cuesta nada ser prudente.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De nuevo acá, eh.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001857",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tendremos que seguir caminando un poco más en dirección contraria a la\nestación. ¿No te importa?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema. Total, si nos vamos en dirección a la colina Yumenouki nos\nverán perfectamente desde el portón frontal.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001858",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_d06_01",path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001859",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Realmente no te importa?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Importarme qué?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rna_001860",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ir de vuelta a casa conmigo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué diablos estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rna_001861",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora puedes tener cualquier chica para ti, senpai.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rna_001862",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso insisto, ¿realmente no te importa estar acá gastando tu tiempo conmigo?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya forma en que lo pones. Y en primer lugar, ¿qué tontería es esa de que\npuedo tener cualquier chica? No hay ninguna así.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_001863",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tontería es lo que estás diciendo ahora. ¿Vas a ignorar a todas esas chicas que\nestaban en la entrada frontal?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, las ignoro.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy tan elocuente ni desenvuelto como para tratarme bien de noche a la\nmañana con mujeres que ni de dónde vienen sé.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rna_001864",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001865",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está Rin-senpai también...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, eh. He estado enseñándole a pintar, así que últimamente hemos estado\nregresando juntos con frecuencia.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_001866",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué no regresaron juntos hoy?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya a saber.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rna_001867",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue por pura casualidad, pero... hace un momento nos cruzamos las miradas.\nRin-senpai y yo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Hace un momento? Pero si ninguna de las dos se ha cruzado con la otra.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_d06_01",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001868",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Solo que estuve observando la sala de arte desde el patio, mientras\ncaminaba. Me preguntaba si había alguien, y...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y entonces?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001869",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vi a alguien que se parecía a Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que se parecía? Pero entonces no se cruzaron las miradas ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_d06_01",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001870",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees? Es difícil discernirlo a simple vista, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, pues... ahora que lo dices, quizá sí sea posible...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_001871",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hoy también los vi juntos, así que pensé que la acompañarías de vuelta a casa.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rna_001872",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no es con mala intención...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy enseñándole a pintar a Rin. Eso es todo.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rna_001873",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso... es todo?...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_d06_03",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
ja={
{
"Hikawa echa su mirada a un lado.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? No te veo muy contenta.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rna_001874",ch="rna"},
},
ja={
{
name={"Rina"},
"“No estoy molesta.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_001875",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai... ¿Qué tanto recuerdas todavía?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerca de?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rna_001876",ch="rna"},
},
ja={
{
name={"Rina"},
"“De cuando nos conocimos, en el parque de cipreses.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿es que estás tratando de echarme encima que la vez pasada había\nolvidado cómo es que llegaste a comenzar a hacerte pasar por mi hermana\nmenor?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rna_001877",ch="rna"},
},
ja={
{
name={"Rina"},
"“No intento recriminarte, de igual manera no recordabas nada.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, eh. Lo había olvidado por completo. Aunque no se me ocurrió tampoco\nque todavía estuvieras aferrada a eso.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rna_001878",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué forma tan cruel de decirlo. Para mí ha sido una de las memorias más\nimportantes que he tenido.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez para mí también...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_rna_001879",ch="rna"},
},
ja={
{
name={"Rina"},
"“No pareces estar muy interesado.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? No, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no lo pareciera, aquel día estaba al borde de mi límite.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_d06_04",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001880",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Al borde de tu límite?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recuerdo muy bien todo lo que sucedió aquella noche. No, más bien nunca llegué\na olvidarlo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero créeme, fue duro para mí. Eras terriblemente buena pintando.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_d06_05",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001881",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Terriblemente buena? Qué manera de decirlo, jeje.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a venir a reírte? No te estoy mintiendo, fue horriblemente duro para mí.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rna_001882",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo parecía.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era un fanfarrón. Me gustaba presumir de ser la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001883",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo cual no ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te parece? Juraba que ya no lo era tanto...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_rna_001884",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si realmente dices eso en serio debo decirte que careces seriamente de visión\nobjetiva.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_rna_001885",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabías algo, senpai? Me gustas.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Tengo la seguridad de que te caigo bien, eso sí. Y por cierto, tengo\ntambién la seguridad de que le caigo pésimo a Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_d06_06",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001886",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah~, definitivamente no tienes nada de visión objetiva, senpai. Lo estás\nmalinterpretando todo.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Me equivoqué en algo? ¿No te caigo tan bien entonces?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bg",file="ev_com_d06_03",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001887",ch="rna"},
},
ja={
{
name={"Rina"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué idiota? No puedo leer las mentes de los demás.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque debo admitir que me entristecería enterarme de que en realidad no te\ncaigo bien.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rna_001888",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? La verdad es que no das la impresión de importarte mucho lo que yo piense\nde ti, senpai.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es así entonces tú tampoco ves las cosas con mucha objetividad que digamos.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_d06_01",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001889",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero qué dices...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué dijiste aquella vez que te volverías mi hermanita?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001890",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya sabes por qué. Porque dijiste que no podía ser tu discípula.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, pero aun así diste un salto demasiado grande. De eso a hermanita menor.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_d06_05",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001891",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo sé, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001892",ch="rna"},
},
ja={
{
name={"Rina"},
"“Simplemente se me ocurrió que eso era lo mejor en el momento.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_001893",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero ser la hermanita tiene sus cosas buenas. Puedes permanecer al lado de esa\npersona, aun sin ser su pareja...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una amiga también podría hacerlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_d06_01",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001894",ch="rna"},
},
ja={
{
name={"Rina"},
"“No. No sirve ser amiga.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_001895",ch="rna"},
},
ja={
{
name={"Rina"},
"“Porque en algún momento no podrá seguir siendo la amiga.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No podrá seguir como amiga?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rna_001896",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongamos que... esa persona llegara a conseguir novia. De ser así entonces\nesa muchacha ya no podría seguir siendo su amiga, ¿o no?...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que suceda así?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rna_001897",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, no sé si así sea en realidad. No tengo, ni tampoco hay indicio alguno\nde que llegue a tener pronto experiencia en eso.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_d06_05",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001898",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y no por más, se supone que soy tu hermanita menor, senpai. Y seguiré\ncomportándome como tal.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rna_001899",ch="rna"},
},
ja={
{
name={"Rina"},
"“Porque es el privilegio de una hermana menor poder estar siempre en esa\npeculiar posición, de no ser ni lo uno ni lo otro... o al menos, así se\nsupone.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es así?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rna_001900",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Es así.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me gusta eso de que juegues a ser mi hermanita, eh.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_d06_01",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001901",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tengo forma de justificar nada, por más reclamos que me hagas...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente me desagrada.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rna_001902",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Estás tratando de pedirme de forma tácita que deje de pretender que soy tu\nhermanita?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te voy a pedir que dejes hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero me molesta que trates de dibujarte una raya a tu alrededor y pretender\nquedarte ahí.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Casi como que, 'solo pretendo ser tu hermanita, y no seré nada más ni nada\nmenos que eso'.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001903",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, es que de no hacerlo así no podría estar a tu lado, senpai.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame preguntarte algo entonces.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué harías si la otra persona cruza esa raya?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_d06_07",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001904",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aun así podrías seguir jugando a ser la hermanita? Eso se me hace raro, te lo\ndigo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa clase de situaciones debería quedarse en historietas o en juegos. En la\nficción.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las relaciones reales no funcionan así. Por más líneas que traces los demás la\npisarán como si nada, y terminará por volverse ambigua.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_d06_02",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001905",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Rin-senpai.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa con Rin?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rna_001906",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai es hermosa.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo es.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rna_001907",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y probablemente tiene sentimientos por ti.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez. Creo que de pequeño llegué a sentir algo por ella.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_d06_08",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001908",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué no poner en lugar esos sentimientos entonces?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya lo hice.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="ev_com_d06_07",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001909",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que te guste alguien de niño no significa que realmente ames a esa persona.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías llegar a sentir algo por tu maestra del jardín de niños, o, en casos\nraros, incluso por tu madre. Pero eso no es amor.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El enamoramiento de un niño es distinto al verdadero amor que se puede tener\npor alguien.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que sucedió en el pasado no puede definir lo que siento ahora.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rna_001910",ch="rna"},
},
ja={
{
name={"Rina"},
"“K-Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si es por flechazos, ese no fue el último para mí.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre fui un niño de mamá, así que quizás también llegué a tener sentimientos\npor mi madre.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, también en aquella noche...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"En el bosque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Estaba allí ella, la niña de la sombrilla blanca.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Su sonrisa era como la luna.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Como esa misma luna que todas las noches convierte el fulgor del sol en un\ntenue y gentil brillo.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Estaba allí esa llama azul, pintando muerte.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Y yo me le quedé observando fijamente.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bg",file="ev_com_d06_09",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001911",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Por qué te me quedas viendo?...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento. Me quedé pensando en algo...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_d06_10",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001912",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Esa cara que pones, es... es tan maliciosa... y para más colmo, en este\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_d06_11",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001913",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Esa, esa cara. K-Kusanagi-san, siempre das en el punto débil...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué me estás hablando? ¿Maliciosa? ¿Punto débil?...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_com_d06_10",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001914",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eres un tramposo, un injusto... Siempre atacas cuando menos me lo espero.\nDios...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rna_001915",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquella noche, en la noche de Zypressen...\nEsa noche convertiste los cipreses en cerezos, en cuestión de un instante.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rna_001916",ch="rna"},
},
ja={
{
name={"Rina"},
"“Transformaste lo negro en blanco, en un abrir y cerrar de ojos.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rna_001917",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rna_001918",ch="rna"},
},
ja={
{
name={"Rina"},
"“――Esta noche de tormenta me pareció perfecta...",
{"rt2"},
"　　　　　　　　　　　――Pensé...",
{"rt2"},
"　　　　　　　　　　　　　　que era buen momento para colocarle ya las flores.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",file="ev_com_d06_12",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001919",ch="rna"},
},
ja={
{
name={"Rina"},
"“Remataste con esa frase...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Pero qué demonios?! ¿Vas a venir a juzgarme por ser un chuuni en ese\nentonces? ¿Por eso? ¡N-No voy a negar que me sobrepasé un poco, pero--!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_001920",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bastante, diría yo...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rna_001921",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es bien, bien difícil encontrar a alguien a quien le queden bien...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es que, estábamos en plena tormenta, y la atmósfera se prestaba para... Espera,\n¿eh?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bg",file="ev_com_d06_10",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001922",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caí fácilmente, como toda una tonta. Así de terribles son los efectos que trae\nel UFT Sunfural S...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"bg",file="ev_com_d06_11",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001923",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Por eso es que--!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿P-Por eso, qué?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_com_d06_09",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001924",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"bg",file="ev_com_d06_10",sync=0,face=1,time=400,path=":ev/ev_com_d06/",set="ev_com_d06"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001925",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, no es nada. Ah, ya estamos por llegar a la estación.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Apenas me di cuenta ya habíamos llegado a la estación de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001926",ch="rna"},
},
ja={
{
name={"Rina"},
"“Conociéndote, me imaginé que sería lo mejor guiarte hasta el final o te\nperderías.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, c-claro... Sí, agradezco que lo hicieras, pero...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001927",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vale. Nos vemos, senpai...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí. Nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001928",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhm. Adiós...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"msgoff"},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"ex",time=800,func="wait"},
{"se",file="se9004",id=1},
{"fg",ch="里奈",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Después de despedirse inclinando un poco su cabeza, Hikawa desapareció entre el\nbullicio de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Y mientras todavía me rascaba la cabeza en curiosidad, entré a la estación.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_07"},
{"text"},
linkback="block_00225",
},
label = {
top={block="block_00000",label=1},
},
}
