astver = 2.0
astname = "ast"
ast = {
block_00000={
{"fg",mode=-2},
{"bg",file="ev_com_a28_01",time=1500,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000001",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Muy bien, en lo que concierne a este asunto, procedamos a resolverlo antes de\nque comience la reunión anual de discusión de presupuesto por parte de la\nasociación de estudiantes de Yumihari.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000003",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¡No, esto no le compete al consejo estudiantil! Me parece que debemos\ninformarle de una vez a los profesores y que ellos se encarguen de tomar la\nmedida más adecuada.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000002",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Pero, el caso fue reportado al consejo estudiantil.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_a28_01",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000004",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Ya están por reunirse los jefes de cada uno de los clubes para participar en la\nreunión de discusión de presupuesto de la asociación. No hay tiempo para\ndiscutir este caso. En mi opinión, debemos reportar esto inmediatamente a los\nprofesores.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bg",file="ev_com_a28_02",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000003",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“¿Reportar a los profesores? Wakata-sensei, usted también está informado\nrespecto al caso, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wkd_000040",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por supuesto. Fui yo quien recibió la notificación por parte de Akashi.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000005",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¡No se puede confiar en el profesor Wakata!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_wkd_000041",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Por qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000006",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¡Profesor, por lo general usted solo se preocupa por su bien propio! ¿O es que\nen caso de haber problemas en el club que usted mismo supervisa no pensaría\nen mantenerlos dentro de sus manos?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_wkd_000042",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pues, no puedo negarlo, pero no hace falta que seas tan enfática...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000764",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, en el sentido estricto, el profesor Wakata no es supervisor,\nsimplemente es una especie de supervisor alterno...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000007",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Justamente por eso, por tratarse de un profesor no regular, es que el profesor\nWakata podría tratar de alterar la realidad de los hechos en caso de que\nalgún problema surja en el club al cual fue asignado como supervisor alterno!\n¡Porque podría ponerse en peligro su posición en el colegio!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000004",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“No debes decirle esas cosas a un profesor.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bg",file="ev_com_a28_08",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000008",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Pues quizás me extralimité en mis palabras, pero me parece que es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000005",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Fuu, sí. ¿Qué tal si el profesor Wakata se encarga entonces de reportar este\nasunto a los demás profesores?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_wkd_000043",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, me parece bien así. Yo me encargaré de informarles.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_a28_01",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000009",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¿Eso quiere decir que usted se encargará de reportar este caso a los demás\nprofesores, profesor Wakata?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_wkd_000044",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pues claro.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",file="ev_com_a28_08",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000010",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Ya veo, entiendo. Pero no solamente confiaremos en su visión subjetiva del\ncaso, sino que también elaboraremos rápidamente un reporte por parte de\nnosotros. Presente el reporte en la reunión de profesores, sin alterar ni una\nsola palabra, por favor.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"mwact",act="びっくり",size=3},
{"text"},
text={
vo={
{"vo",file="man_wkd_000045",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000765",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, vamos, el profesor Wakata no tiene la culpa, no tienes por qué\nrecriminarlo tanto...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000011",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Tienes razón. La culpa la tienen ustedes, club de arte. Aún después de haber\ncausado tantos problemas el año pasado, buenas agallas que tienen ahora para\ncomenzar el año de esta manera, eh.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000766",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo palabras para expresar mi pena...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000006",ch="kmd"},
},
ja={
{
name={"Presidenta"},
"“Vamos, no debes exaltarte tanto.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000012",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Por supuesto que me exalto. ¡Justo cuando pensé que ahora que Akashi se graduó\nya no surgirían más problemas!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000767",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa la interrupción, pero... Akashi-senpai no se ha graduado.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000013",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¿Qué dices? ¿Esa cosa sigue aún en el colegio? C-Con razón me pareció verlo\nmerodeando por ahí en uniforme...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000007",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Oh, vaya, ¿no sabías?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000014",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Es que estoy tratando siempre de hablar lo menos posible con él.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000008",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Pero, deberías saber por lo menos si se graduó o no...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000015",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¡Ya basta de este asunto! ¡Son cuestiones privadas! Dejando eso de un lado,\nquisiera comenzar a tomar las declaraciones respecto a este caso.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000009",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“¿Y bien, cuál fue el problema provocado por los amigos del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000016",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Sí, tomé las declaraciones de todas las personas que estaban en ese lugar. Esta\nes toda la información recopilada.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",id=1,file="se1894"},
{"bg",file="ev_com_a28_01",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000010",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Uwah... Es bastante grueso este documento, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000017",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“En resumen, realizaron un evento sin autorización del colegio, y lo\npromocionaron el día anterior a su realización en un sitio web para videos.\nEl contenido del evento consistía en disolver ropa con pistolas de agua, algo\nabsolutamente indecente. Estos son los comentarios de ese sitio de videos.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_a28_02",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000011",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Ya veo, al escuchar solo esa parte, pareciera ser un problema bastante grave.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000018",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Tal como se puede ver, hay varios comentarios de este tipo en el sitio, así que\nhay suficientes pruebas físicas.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000768",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajajaja... Vaya que pudiste investigar eso en tan corto tiempo, eh. Eres\nbastante competente.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000019",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Los cumplidos no servirán de nada.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bgm",stop=1,time=300},
{"se",file="se1279",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000202",ch="wtd"},
},
ja={
{
name={"???"},
"“Solicito permiso para entrar~”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_a28_07",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000020",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“¡¿Quién es?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",file="bgm008"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000203",ch="wtd"},
},
ja={
{
name={"???"},
"“Yo soy el mundo, y el mundo soy yo.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000769",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eh, ¿pero por qué estás acá, Akashi-senpai?!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_wtd_000204",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Porque el mundo soy yo.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000021",ch="ksd"},
},
ja={
{
name={"Vicepresidenta"},
"“Tú~”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_wtd_000205",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ouh, pero si es Kosachi. ¿Estás esforzándote bastante y apoyando a la\npresidenta?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000022",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡No tienes derecho a alguno de decirme eso! ¡Además, ¿es verdad que repetiste\nel año?! ¡¿No te habías graduado aún?!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_wtd_000206",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No! ¡No he repetido ningún año!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000012",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Tranquilos, tranquilos, hablemos eso después, ¿sí? Eso no tiene nada que ver\ncon el tema actual.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000023",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Y bien... ¿Qué haces acá?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_wtd_000207",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Me llamé voluntariamente a mí mismo para dar mi parte como testigo.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000024",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Nadie te pidió que vinieras.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_wtd_000208",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Aunque nadie me haya llamado, allí estoy yo! ¡Y por ende, el mundo está allí!\nPuesto que yo soy el mundo.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000013",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Bien, entonces dejemos que Mundo-san haga acto de presencia.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_a28_05",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000025",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No... Este hombre no se llama Mundo, se llama Wataru Akashi... Y el año pasado\ncometió una buena cantidad de ridiculeces y fechorías.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000014",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Oh, Wataru-san, ¿eres tú?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_a28_06",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000026",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Eh... ¿Ahora es que te vienes a dar cuenta?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000015",ch="kmd"},
},
ja={
{
name={"Presi del consejo"},
"“Ah, es que Wataru-san debería estar encerrado en su casa estudiando, así que...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_wtd_000209",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohhh, así que tú eres Komaki. Veo que sigues mostrándole esa cara de tonta al\nmundo como siempre.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000016",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ajajaja... sí.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"se",id=1,file="se1882"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000210",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Gyawah.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000027",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Qué manera de dirigirse a la presidenta es esa?... Si te pones a decir muchas\npatrañas en este lugar, te mataré...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000028",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Makoto!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000770",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000029",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Sí, tú! ¡Se supone que es potestad de la sala de arte encargarse de este tipo,\n¿no?! ¡¿Por qué lo tienen suelto?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_wtd_000211",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“La potestad soy yo... y a la vez, el universo.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000771",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bien... Hablando ya un poco en serio, Akashi-senpai, ¿qué rayos viniste a\nhacer acá?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="man_wtd_000212",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh... Ciertas cosas.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000030",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“En fin, qué más da. Ignoraré a este tipo y proseguiré con las declaraciones.\nBien, de acuerdo a las declaraciones de las personas que se apersonaban\nallí...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_wtd_000213",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todo fue mi responsabilidad.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000031",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“... ¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_wtd_000214",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todos estos eventos fueron parte de una presentación artística, todos\nprovocados bajo mi propia responsabilidad.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_a28_07",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000032",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿U-Una presentación artística? ¿Pero qué rayos es eso?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_wtd_000215",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, acaba de comenzar el nuevo año escolar... El evento lo preparé para darle\na conocer a todos mi presencia, tanto afuera como adentro.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_wtd_000216",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Crear una situación de guerra en el colegio... No, realizar una actuación de\nesos tiempos conocido como guerra, ambientado en el colegio... Ese era el\nobjetivo de esta presentación.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000033",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“T-Tú...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000217",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ajajajaja. Fue increíblemente realista, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000772",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pero q--, Akashi-senpai, q-qué di--. N-No. Todo esto se debió a que la sesión\nde dibujo que yo planifiqué sufrió un cierto problema, y--”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_wtd_000218",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hahaaan, ¿qué sucede, imbécil? ¿Planeas robarte el crédito de mi presentación\nartística? ¿Haan?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000773",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai... ¿Será que... lo estás haciendo para protegerme?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_a28_08",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000034",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ya entiendo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000035",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Todo eso fue ejecutado bajo responsabilidad tuya y de nadie más, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_wtd_000219",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por supueeesto.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_a28_01",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000036",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Entonces así lo reportaré con los profesores. Aunque sin duda alguna te\nexpulsarán.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000220",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="ev_com_a28_08",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000037",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Hasta ahora has provocado también un gran número de problemas, así que me\nparece que sin duda alguna serás expulsado.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",id=1,file="se1790"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000221",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿EXPULSIÓÓÓÓÓÓÓN? ¡¿POR QUÉÉÉÉÉÉÉ?!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000774",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué te sorprendes tanto?...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000222",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kusanagi me engañóóóó! ¡Solo vine porque me dijo que ese alboroto tendría\nbuena recepción en el consejo estudiantil y que incluso me darían un\npremioooo!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000775",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh, es en serio?... ¿Solo querías quedarte con todo el crédito por eso?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_wtd_000223",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Uwaan. Todo lo que acabo de decir es mentira. Es una mentira. No puede haber\nninguna expulsión, ¿sí? ¡Yo no tengo la culpaaaa!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000776",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu... Tal como lo puedes ver, yo tengo toda la responsabilidad por ese evento.\nAkashi-senpai es inocente.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000038",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Entonces de esa manera lo reportaré con los profesores. De que los autores\nintelectuales fueron la actual jefa Toritani, y el ex-jefe Akashi.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000777",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera un segundo. Akashi no tiene nada que ver. ¡Ya te dije que es mi\nresponsabilidad!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_wtd_000224",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. ¡Elige la opción que más te guste!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_a28_01",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000039",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No, Akashi se confesó voluntariamente, así que también es culpable.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000225",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ueeehn. Les pido perdón~”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000040",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No hay manera alguna de que podamos perdonarte. ¿Cuántas veces crees que van ya\ncon esta? El otoño pasado te pusiste a volar con un extraño maniquí y se armó\nun escándalo, y hace poco recubriste el suelo con espejos e hiciste que se\nviera la ropa interior de las chicas...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_wtd_000226",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No es ningún maniquí extraño! ¡Es un Love Pillow!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000017",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Love Pillow? ¿Una almohada de amor?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000778",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, una muñeca sexual...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_wtd_000227",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Mi Love Pillow Kaga*i Hiraki-chan no es ninguna muñeca sexual! ¡Es la esposa\nque más amo de entre todas!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_com_a28_05",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000041",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Cuántas mujeres amadas tienes?... Y además, que sea una muñeca sexual...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000779",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me preocupa más el hecho de que le ponga nombre a una muñeca sexual...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000018",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Vamos, no hay ningún problema, es bueno cuidar y querer a nuestras cosas.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000780",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En primer lugar, ese vuelo terminó fallando y te fracturaste, ¿no recuerdas? En\nel instante en que caíste al suelo, pensé que habías muerto.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_wtd_000228",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Bueh, en el arte es necesario tener esa clase de convicción y preparación\nmental~ Y es que yo siempre pongo mi vida en riesgo por el bien de mis\nactividades artísticas, nya~”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000042",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Más que tus heridas, el hecho de que cayeras sobre una de las casas adyacentes\nal colegio y destrozaras su techo fue mayor problema aún!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_wtd_000229",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues eso es cierto, pero... me encargué de cubrir todos los gastos de\nreparación...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_wtd_000230",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Y además, y además! ¡No recubrí el suelo con espejos! ¡Lo pulí hasta que se\nvolvió como un espejo!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000043",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Es lo mismo!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000781",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y de dónde obtuviste ese pulidor industrial? Yo también me sorprendí bastante\nese día, cuando vi que el suelo había sido pulido y parecía un espejo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_wtd_000231",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Era necesario por el bien del arte! ¡Y si es necesario entonces debía\nobtenerlo! Y por eso conseguí un pulidor industrial.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_a28_05",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000044",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Qué tiene de arte fabricar un suelo capaz de reflejar la ropa interior de las\nchicas?...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000782",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno, en realidad esa clase de obra sí llegó a existir en el arte moderno. Una\nen el que todo el suelo era un espejo...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000045",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ah, ya veo. A juzgar por lo que me cuentan, el arte moderno no parece ser nada\nbueno.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000232",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sin embargo, el arte es arte! ¡Aunque a veces parezca tener un aspecto\nantisocial! ¡No, al contrario! ¡A veces el arte puede incluso convertirse en\nalgo antisocial! ¡Aunque reciba las miradas de desagrado y disgusto de los\ndemás, un artista debe estar siempre dispuesto a quitarse la vida junto a la\nbelleza!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_a28_02",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000046",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Bien, entonces haremos que te expulsen por el bien del arte.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000233",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Por qué?! ¡Se supone que es ahora cuando debes perdonarme, ¿no?! ¡Todo lo\nhice por el arte~!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000047",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Nada de 'por qué'! ¡Has desarrollado tus actividades artísticas hasta ahora\nsiempre preparado en caso de que sucediera algo así! ¡¿No?! ¡Castigo es\ncastigo! ¡Crimen es crimen! ¡No tengo idea alguna de tu valor artístico, pero\ntransgresión es transgresión! Y haré que pagues por tu crimen.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="man_wtd_000234",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tojojo~ Y pensar que llevo tres años estudiando acá para que me expulsen\nahora...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000048",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Eso es lo que quisiera decir yo! ¡Se me hace totalmente inconcebible que no te\nhayan expulsado hasta ahora!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bgm",stop=1,time=100},
{"bgm",file="bgm031"},
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000019",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Oh, vaya?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_a28_02",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000020",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Esto no está bien, Kosachi-san.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000049",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Perdón?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000021",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Esta toma de declaraciones... No se especifican nombres, ni año escolar ni\nsección.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_a28_06",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000050",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Eh? ¿No hay?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000022",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No hay.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000051",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Eh, ¡pero...!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000023",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Más que una toma de declaraciones, parecen más bien simples apuntes. No hay\nforma de saber quién dijo qué.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_a28_09",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000052",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡P-Pero...! Tenemos los comentarios publicados en el sitio web de videos.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000024",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ciertamente, ¿pero hay alguna prueba de que los comentarios en ese sitio de\nvideos hayan sido escritos por algún miembro del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000053",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“N-No la hay, pero, me parece que solamente alguien perteneciente al club de\narte pudo haberle hecho publicidad en la red.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000025",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Eso piensas? Asumamos que de verdad estuvieran haciendo publicidad. ¿Crees que\nen ese caso dejarían el historial de conversación intacto? Se trata de un\nescándalo que de descubrirse podría llevar a expulsión. Me parece difícil de\ncreer que ellos mismos hayan dejado intacto el historial.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000054",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡P-Pero es un hecho de que se realizó todo lo que se especificaba en ese\nhistorial!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000026",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿De verdad? En este historial no dice nada acerca de disparar un extintor\ndentro de la sala y dejarla completamente teñida de blanco.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000055",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“P-Probablemente trataron de agregar cierto factor sorpresa al evento...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000027",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Eso crees? A mi parecer, alguna clase de problema sucedió y provocó que las\ncosas tomaran ese giro. Pienso que sucedió algún incidente de por medio que\niba en contra de toda voluntad de la jefa Toritani y el ex-jefe Akashi.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000056",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“E-Eso no es más que una hipótesis, ¿no? El hecho de que te parezca que algún\nproblema haya sucedido.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000028",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Entonces, vicepresidenta, eso de que 'trataron de agregar cierto factor\nsorpresa' es también una hipótesis, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000783",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“K-Komaki...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000029",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ambos quedan como presuntos inocentes.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_a28_09",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000057",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡P-Pero...!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000030",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Nuestro colegio Yumihari decidirá, en base a los principios establecidos en las\nleyes criminales modernas, los cargos a tomar. Lo único que podemos dar como\nun hecho por ahora, es que realizaron una sesión de dibujo sin autorización.\nAdemás de que se rompió una ventana, y se dispararon unos extintores. Eso es\ntodo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_a28_05",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000058",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“T-Tienes razón, pero...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000031",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Así que por las razones anteriormente expuestas, delegaré las acciones a tomar\nal profesor Wakata.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_wkd_000046",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“S-Sí, me alivia saber que con la presidenta si se puede hablar.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_a28_03",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000059",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"¡*girori*!",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_wkd_000047",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000235",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Komaki... Disculpa por haberte dicho que tenías cara de tontaaa... Uhh, uhh...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000784",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias, Komaki. Te pagaré esta deuda en algún momento.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_a28_04",sync=0,face=1,time=400,path=":ev/ev_com_a28/",set="ev_com_a28"},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000032",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Qué estás diciendo? Yo simplemente hice mi trabajo como parte del consejo\nestudiantil. Además, entre nosotras dos no hay deudas ni nada de eso, ¿no,\nMakoto-chan?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"fgact",ch="真琴",act="おじぎ",time=650,size=15,lv=4,id=9},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000785",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y así sucedió todo.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que resultaron libres de todos los cargos... Increíble, eh.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000786",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, más que libre de cargos, nos hicieron el favor de dejar el asunto al\nnivel del consejo estudiantil. No le revelaron nada a los profesores.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, Wakata hubiera alterado bastante la historia al momento de informarle a los\notros profesores. Además, había dicho que por ser un instructor de tiempo\nparcial lo podrían despedir en cualquier momento si llegaba a provocar algún\nproblema.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0009",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000787",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000788",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si hubiera descrito todo tal como lo vio en la reunión de profesores,\nAkashi-senpai y yo hubiéramos sido expulsados, y ustedes habrían sido\nsuspendidos.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en realidad las victimas fuimos nosotros, eh.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0010",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000789",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque de ninguna manera los profesores lo verían de esa forma. Simplemente\npensarían que realizamos ese alboroto de manera planificada.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso quiere decir que la presidenta del consejo estudiantil nos salvó las\ncabezas, eh. Supongo que estamos en gran deuda con ella.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000790",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues eso quisiera decir yo también, pero ahora que nos hicieron llegar esto...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",file="se2497",id=1},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0200",face="a0008",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani me pasa un recorte de papel.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Presupuesto, -1500 yenes...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto? ¿Por qué el presupuesto está en números negativos?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0009",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000791",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues no le dirán nada a la administración del colegio, así que tenemos que dar\nde nuestro propio presupuesto para cubrir todos los equipos rotos, ¿no te\nparece?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ya veo, así que al deducir el monto de las reparaciones del presupuesto,\ntomó números rojos.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000792",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa presidenta, es difícil decir si es amable o si en realidad es severa...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0002",head="mak_z2b",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000793",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Komaki siempre ha sido así desde hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Conoces a la presidenta?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0002",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000794",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Cuando éramos niñas, tuvimos algo de contacto...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, así que cosas así también suceden.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"msgoff"},
{"fg",mode=-2},
{"bg",x=-730,y=240,file="zbg049b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="トーマス",size="z2",rotate=180,sync=0,mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0200",face="a0010",head="tho_z2a",y=-500,lv=5,id=9},
{"fgact",ch="トーマス",act="ゆらゆら",loop=-1,time=1000,size=1,lv=5,id=9},
{"se",file="se9032",id=1},
{"text"},
text={
vo={
{"vo",file="man_tmd_000039",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Ahm, oigan.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_tmd_000040",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Podrían bajarme ya~?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0018",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000795",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta vez simplemente terminaste colgado, así que deberías agradecerme más bien.\nEn otro caso ya deberías estar expulsado.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tienes a Thomas colgando?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000796",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es acaso obvio? Por haber hecho lo que hizo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me refiero a eso, sino a por qué dejas que ponga sus pies en el club de\narte. ¿No se supone que debimos obligarlo a escupir toda la verdad y hacer\nque lo expulsaran?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000797",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las cosas no irán tan bien de hacerlo así. Aunque la verdad salga a la luz,\nambos lados seríamos penalizados. Nosotros también seríamos expulsados junto\na él.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000798",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, a pesar de que Thomas lo haya planificado todo, la responsabilidad\nrecae sobre el club de arte.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000799",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, de igual manera no estábamos autorizados aún para realizar la sesión de\ndibujo. Aunque bueno, no había forma de lograr conseguir el permiso de un día\npara otro.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, ¿por qué permitiste a este tipo entrar?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0012",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000800",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Observa, este es el dibujo de Thomas. Lo hizo con todo su esfuerzo durante todo\nese alboroto.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dibujo?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000801",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal? Te sorprendiste, ¿cierto? Aun con este aspecto y esta personalidad\nque tiene, y contrario a nuestras expectativas, tiene esta clase de talento.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000802",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No cualquiera podría dibujar esto en medio de ese desastre. Tiene bastante\ntalento.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000803",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es algo problemático que su deseo creativo solo se estimule con desnudos, pero\nno hay duda alguna de su capacidad. Su habilidad es necesaria para nosotros.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Su habilidad es necesaria?! ¿Vas a autorizar el ingreso de este tipo al club?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000804",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué llegas a esos extremos de incluso proteger tipos como este?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000805",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por mi ferviente deseo.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un ferviente deseo?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000806",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Y pienso cumplirlo. Por eso es que meteré a toda persona con talento en\neste club, independientemente de los problemas de personalidad que pueda\ntener.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso... ¿vas a meter a este tipo en el club?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000807",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por más desviado que haya sido, hay que reconocer lo increíble de su fuerza de\nvoluntad como para haber preparado 3 trajes en una noche solo con ver el\nvideo de Kei vestido de maid. No es algo que simplemente pueda hacer\ncualquiera proponiéndoselo.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces sí preparó los trajes en un solo día?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000808",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así parece. Parece que se le ocurrió ese plan cuando surgió la idea de realizar\nla sesión de dibujo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de fácil es conseguir material disoluble al agua?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",file="se1279",id=1},
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mx=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000236",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues ciertamente los venden por encargo, aunque deberíamos asumir que ya lo\ntenía en su posesión desde un principio.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Akashi?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000237",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Al ir fuera de las pinturas de óleo y experimentar con otros campos, por\nejemplo, el arte con objetos, uno se vuelve conocedor de cosas como\npigmentos, materiales, y también disolventes orgánicos, nya~ En realidad, yo\ntambién poseo ese mismo tipo de material.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú... ¿tienes esa clase de material en tu posesión?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000809",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueh, eso es porque Akashi-senpai suele realizar muchas obras tipo performance.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000238",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. Ciertamente, este tipo tiene bastantes problemas, pero a juzgar por su\nhabilidad al dibujar, y por su conocimiento de materiales, no es un tipo\ncualquiera.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quizás sea así, pero...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000810",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me extrañaría que volviera a causar más problemas después, pero ya estoy\nacostumbrada a los problemas gracias a Akashi-senpai. De alguna u otra manera\nresolveremos.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="明石",size="z1",ex02="b0098",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0005",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000239",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque a mí no me parece haber causado esa clase de problemas, eh.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000811",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cuántas veces crees que has estado ya al borde de la expulsión, senpai?...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No tiene caso discutir eso.”",
{"rt2"},
},
},
},
