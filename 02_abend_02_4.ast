{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000924",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La mansión de los Natsume está igual de enorme que siempre.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000488",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble... Es la primera vez que veo una mansión tan grande.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000890",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿nunca llegaste a ver antes la mansión de los Natsume?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fgact",ch="稟",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000489",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Por qué? Es la primera vez que entro...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, sí, supongo que tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000490",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O eso creo...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000925",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué la cara complicada, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Tengo esa cara?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000926",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso da igual ahora, entremos, entremos.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000891",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡He llegado!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="雫",size="z1",mx=-40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000142",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bienvenido de vuelta.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000892",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hoy vinieron bastantes invitados.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000143",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Invitados?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000893",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así es. Te los tengo que presentar. Son del club de arte, y... Ehm, en fin,\nentren todos.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000927",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000491",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Buenas noches.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya regresé.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0012",head="shz_z1a",lv=4,id=5},
{"fgact",ch="雫",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000144",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",file="se9023",id=1},
{"fg",ch="雫",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000894",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000895",ch="ked"},
},
ja={
{
name={"Kei"},
"“Shizuku se fue huyendo.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-570,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000928",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿S-Será que hicimos algo imprudente?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, no es eso. Solo que Shizuku es un tanto tímida con los demás.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000896",ch="ked"},
},
ja={
{
name={"Kei"},
"“S-Sí, es algo penosa...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000492",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000929",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Mm? ¿Qué pasa, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="いいえ",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000493",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah? No, creo que es solo una equivocación mía, pero... Simplemente, me pareció\nconocida su cara...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000897",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jejeje, no es ninguna equivocación.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000494",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000898",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sabías? Shizuku es una artista. Ha salido en TV y en revistas, en muchísimos\nlugares.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000495",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, ya veo! Con razón me pareció que era tan hermosa.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000930",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Había escuchado antes de ella, pero aun en persona es bastante linda. Su cara\ntambién es bastante pequeña y delicada.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejando eso de lado, ¿hasta cuándo piensas dejarlas hablando en la entrada?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000899",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahh, lo siento. En fin, nee-chan no ha regresado aún, pero pasen.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000496",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien, con permiso.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000931",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con permiiiso.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003c",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=4,sync=0},
{"extrans",rule=139,vague=40},
{"se",id=1,file="se1049"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000497",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble, eres rápido cortando el cebollín en rodajas.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Mientras estaba cortando en rodajas el cebollín, Rin mostró su cara por un\nlado.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? El cebollín es relativamente sencillo de cortar. Los movimientos\nson cortos, me parece más difícil cortar repollo en tiras.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=4},
{"fgact",ch="稟",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000498",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, el movimiento es más alargado al tener más altura que el cebollín, ¿verdad?\nPero, el núcleo del repollo no se usa, así que si lo retiras su altura baja\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fgact",ch="稟",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000499",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y además, a diferencia de los cortes en rodajas del cebollín, hay un cierto\ntruco para cortarlos...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué truco es ese?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000500",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues no sé si realmente es un truco, pero se usa un cuchillo largo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ya veo... Ahora que lo mencionas, tienes razón. El repollo es bastante\namplio, así que debe ser más fácil cortarlo usando un cuchillo largo.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm106"},
{"text"},
text={
vo={
{"vo",file="man_ked_000900",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ambos parecen estar llevándose bien.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000932",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, realmente, tal y cual amigos de la infancia.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000901",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué alivio...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000933",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Alivio... eh. Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000902",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000934",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, solo que, Kei, desde hace tiempo siempre te las has dado de torpe y tardo,\npero en realidad eres bastante sensible.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000903",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000935",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué te enojaste tanto aquel día?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000904",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Aquel día?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000936",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El día que Rin-chan vino por primera vez al club. Aquel momento en el cual\nKusanagi dijo que no volvería a pintar jamás.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000937",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'¿Por qué dejaste de pintar repentinamente? Aún no he escuchado la razón'. ¿No\nrecuerdas como dijiste eso tan frenéticamente?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0016",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000905",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, aún no he escuchado esa razón...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000938",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad? Ya han discutido lo mismo varias veces, pero es la primera vez que\nte veo alzar la voz de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000906",ch="ked"},
},
ja={
{
name={"Kei"},
"“La primera vez que escuché que dejaría de pintar también me enoje de esa\nforma...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000939",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero eso fue hace bastante tiempo, ¿no? ¿Por qué te volviste a enojar así, ya a\neste punto?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000907",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No será que estaba de mal humor en ese momento?... Realmente da igual.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000940",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú conoces más a Kusanagi que yo, Kei.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000941",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que tú debes entender muy bien que él no dejó el pincel por alguna\nrazón cualquiera.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000942",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así como vemos a diario a ese hombre llamado Kusanagi, él en realidad tiene una\nfuerza de voluntad muy poderosa, totalmente inimaginable de su aspecto\nnormal.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000908",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso es obvio. Sin una voluntad de esa magnitud no se pueden producir esa clase\nde pinturas. Las pinturas de Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000943",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces debes saber que Kusanagi no abandonó las pinturas por capricho alguno,\n¿no? Aquellas pinturas por las cuales dedicó tanto tiempo, aquellas pinturas\nque alcanzaron tal nivel, tal majestuosidad.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000944",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En este mundo hay genios que, al llegar a cierto nivel, dicen '¿Esto es todo?'\ny paran, creyendo ya que lo saben todo, pero Kusanagi no es de ese tipo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000945",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Él está parado en un lugar totalmente distinto a esos talentos mediocres.\nProbablemente él conoce mejor que nadie ese nivel, aquel lugar que está más\nallá de todos esos talentos, y quizás quería avanzar aún más, ir más allá,\npero aun así se prohibió a sí mismo seguir caminando.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000909",ch="ked"},
},
ja={
{
name={"Kei"},
"“Se prohibió, eh... Me parece correcta esa expresión.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000910",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ese hombre llamado Naoya Kusanagi es estúpidamente recto y estúpidamente bueno\ncon los demás. Siempre mete su hocico en varias cosas, sin que nadie se\npercate de ello, y termina perdiendo mucho en el proceso.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0016",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000911",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me frustra admitirlo, pero aquellas cosas que no puedo ni pude hacer, y\naquellas cosas que en principio yo debí haber hecho, todas las hizo él...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000912",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero no puedo permitir que lo sepa, y debo hacer como si nada hubiera pasado.\nEs verdaderamente mortificante, pero eso es lo único que puedo hacer.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000913",ch="ked"},
},
ja={
{
name={"Kei"},
"“Él es realmente como uno de esos héroes que aparecen en los mangas. No solamente\nse trata de la pintura. No tiene que ver únicamente con su talento.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000946",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso te diste cuenta.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000914",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000947",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te diste cuenta en ese momento, de la posible causa por la cual Kusanagi dejó\nde pintar...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000948",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero la verdad me parece que ya nos habíamos dado cuenta de la causa.\nCualquiera que pinte se daría cuenta, de sus gestos tan raros.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000949",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo que ninguno de nosotros sabía hasta ahora la raíz de esa causa.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbg004c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-345,lv=5,id=5,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0100",face="a0015",head="kei_z2a",x=345,lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000915",ch="ked"},
},
ja={
{
name={"Kei"},
"“Cuando veo las series de superhéroes en la TV, me doy cuenta, de como a pesar\nde que nadie llama al héroe, aparece de cualquier lugar de repente y ayuda a\naquellos en aprietos.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000950",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cambiaste el tema súbitamente.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0016",head="kei_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000916",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, pero ¿no te parece misterioso? ¿Por qué será que aparecen de cualquier\nlugar de repente?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000951",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0010",head="kei_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000917",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sabes? Me parece que el héroe es capaz de escuchar los gritos de súplica de\nalguien.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000952",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Escuchar los gritos de súplica de alguien...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_ked_000918",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por más solitario que sea, por más lejos que esté, él puede escuchar los\ngritos, la voz de alguien.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000953",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero sería absurdo decir que Kusanagi puede hacer eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0008",head="kei_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000919",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eso crees? Quizás no sea exactamente así, pero me parece que tampoco está tan\nalejado de la realidad.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000954",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Si así lo dices tú, entonces quizás sí sea así.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0100",face="a0002",head="kei_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000920",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_ked_000921",ch="ked"},
},
ja={
{
name={"Kei"},
"“Cierto. Makoto, ¿conoces la condición que cumple un verdadero genio?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000955",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Algo tan ambiguo como eso no existe.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_ked_000922",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tal vez. Yo tampoco sé muy bien realmente, pero hay unas palabras que me\ngustan bastante.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000956",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cuáles?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000923",ch="ked"},
},
ja={
{
name={"Kei"},
"“Solo donde el genio es delgado, puede verse el talento. Genio es lo que nos\nhace olvidar el talento.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000957",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De quién son esas palabras?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000924",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ni idea, las escuché de algún lado, así que no sé.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000958",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No están nada mal.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000925",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así es. Esas palabras no están tan mal.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000959",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Siento que llevamos tiempo sin hablar de esta manera tan seria.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000926",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000960",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace tiempo... Aún siendo solo unos niños, solo hablábamos de cosas negativas,\ndeprimentes.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000927",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quizás fue así.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000961",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero me alegra de que estés bien.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000928",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿A qué viene eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000962",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es la conclusión a la cual llegué tras observarte por estos 3 años.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000929",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo estoy viviendo feliz como Kei Natsume.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000963",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000964",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo... aún no he podido poner en su lugar varias cosas dentro de mí.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_ked_000930",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues podrías tomarte tu tiempo, ¿no? Yo pienso que en algún momento las dos se\nreconciliarán.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000965",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡VENGAN! ¡Ya está listo! ¡Ustedes también, ayuden por lo menos a servir!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000931",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ouh! ¡Ahí voy!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000966",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, está bien, no tienes por qué alzar tanto la voz.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Después de terminar de comer, Rin me ayudó a estudiar, tal como lo había\nprometido. Por supuesto, también estaba incluida la geografía de la cual no\nquiero saber nada.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"La verdad es que era un favor no tan bienvenido, pero bueno, todo lo que decía\nRin era correcto.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Si puedo componer este extremadamente pésimo sentido de dirección, debería\nhacerlo, y debería aprender lo suficiente y necesario al respecto.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000501",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que hoy llegaremos hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000932",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhii... E-Estoy cansado...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="圭",mode=-1,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000967",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ya terminaron?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000502",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Siento que te obligara a acompañarnos, Mako-chan...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000968",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, no te preocupes, después de todo estaré sola en casa al regresar, así que\nes lo mismo estudiar acá que allá.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000503",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, ¿vivías sola?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000969",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, ¿no te lo había contado? Se vive con menos preocupaciones solo, y eso\ndeberías saberlo tú también, ¿no, Rin-chan? Aunque bueno, en mi habitación no\nhay nada realmente de interés.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000504",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Puedo ir entonces a visitarte próximamente?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0004",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000970",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, por supuesto, quisiera pedírtelo yo más bien a ti. Por lo general tengo\nbastante tiempo de sobra en los días libres, ¿no te molestaría si voy a tu\ncasa?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000505",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que no. Ah, cierto, ¿no te gustaría reunirnos a estudiar juntas un\ndía de estos?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0004",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000971",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso me gusta.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Estudiar juntas.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Eso me gusta.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Le sobra el tiempo en los días libres, y por eso va a casa de alguien que vive\nsola. Para estudiar.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Es algo que definitivamente, y de ninguna manera, puedo lograr entender.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000972",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿será que nos vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000506",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="nightsky_spring",id=9,lv=9,time=500,path=":cg/"},
{"text"},
text={
ja={
{
"Kei y yo las acompañamos hasta afuera.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"¿Las acompañamos hasta sus casas?' Les propusimos eso, pero Toritani dijo que\nvivía cerca, y además Rin estaba con ella, y que por lo tanto no tenía\nproblema.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Aun así, Kei fue a buscar su motocicleta, insistiendo en que las acompañaría.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Aunque la verdad es que me parecería una gran molestia tener esa cosa\ncorriendo al lado durante todo el trayecto...",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
