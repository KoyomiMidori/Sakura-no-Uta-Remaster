astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"No puedo desperdiciar mucho tiempo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Apenas terminó la reunión con los dos me dirigí a la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm016"},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000712",ch="aid"},
},
ja={
{
name={"Ai"},
"“Oh, Naoya. ¿A qué vienes hoy?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es algo rápido. Solo quisiera ver el taller que mi padre usaba.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000713",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, ¿el depósito? No tengo ningún problema, pero ¿por qué de un día para otro\ndecidiste venir a verlo?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con todo lo que ha estado pasando con el viejo me dieron ganas de venir a ver\nel depósito.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000714",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, es normal, supongo. Está bien, velo tanto como quieras.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",file="se9004",id=1},
{"fg",ch="藍",speed=5000,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x2=0,x=-1000,lv=4,id=9},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000715",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué tal? Está muy bien organizado, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo está.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000716",ch="aid"},
},
ja={
{
name={"Ai"},
"“A veces Kei lo usa. Aunque por lo general soy yo quien limpia.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo mencionas, ¿dónde está Kei?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000717",ch="aid"},
},
ja={
{
name={"Ai"},
"“Salió. Últimamente ha estado pintando mucho afuera.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000718",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por cierto, ¿no te pasó nada después de aquel día?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000719",ch="aid"},
},
ja={
{
name={"Ai"},
"“Los Nakamura. Desde aquel día no volvieron a acercarse acá, y comencé a\npreocuparme. Tenía miedo de que fueran a tu casa.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ¿eso? No hay nada de lo que te debas preocupar.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000720",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad? Si es así, pues supongo que no debería preocuparme tanto\nentonces... A veces pienso que debería ir uno que otro día a visitarte.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000721",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es justamente para esa clase de situaciones que he estado practicando artes\nmarciales todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, como mi guardaespaldas? Mm, bueno, supongo que no estaría mal...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000722",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Verdad?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tranquila, estaré bien solo. Y quizás tengas experiencia en artes\nmarciales, pero tener a una mujer de guardaespaldas no me agrada mucho.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0005",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000723",ch="aid"},
},
ja={
{
name={"Ai"},
"“No digas eso. Te aseguro que estarás más seguro conmigo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Por más experiencia que tengas, eres muy ligera. No creo que puedas\npelear en serio con esos guardaespaldas.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0008",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0018",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000724",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por supuesto que sí. ¿Quieres probar? Estoy segura de que por lo menos más\nfuerte que tú sí soy. De ninguna forma podría descuidarme contigo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Descuidarte, eh...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"*Fiuu*...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bgm",stop=1,time=500},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2h0000",face="h0005",head="aix_z2h",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Me relajo, y extiendo mis manos lentamente hacia Ai.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",file="se9031",vol=70,id=1},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0005",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"fgact",ch="藍",act="icon",lv=5,id=9,icon="icon01z2",x=80,y=-550},
{"text"},
text={
ja={
{
"Como era de esperarse, Ai se prepara a la espera de un ataque.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Pero no me detengo, y termino abrazándola.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000725",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿Ah, eh? E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Ai no supo cómo reaccionar ante tan inesperado movimiento.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"No es de sorprenderse. Yo también quedaría desorientado si fingieran atacarme y\nacabaran dándome un abrazo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0009h",head="aix_z2f",lv=5,id=9,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿no se supone que no te descuidarías? Mira nada más, te tengo en mis\nbrazos...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0013h",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"fgact",ch="藍",act="icon",y=-500,lv=5,id=9,icon="icon18z2",x=-250},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0008h",head="aix_z2e",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0009h",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"fgact",ch="藍",act="stopicon",lv=5,id=9},
},
vl03={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0010h",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000726",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, no, bueno, s-sí, tienes razón. P-Pero no es lo que crees. No sentí ninguna\nintención de ataque, y me descuidé.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El enemigo siempre atacará cuando menos te lo esperes... Así que, acabas de\nperder.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0014h",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0021h",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000727",ch="aid"},
},
ja={
{
name={"Ai"},
"“Te equivocas, no es lo que crees. Naoya, eres un tramposo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fgact",ch="藍",act="停止",lv=5,id=9},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0006h",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005h",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000728",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Que por qué?! ¡Solo se le puede llamar trampa a lo que hiciste!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? La posibilidad de que el enemigo te tome de sorpresa en un descuido\nno es nula, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0011h",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000729",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ese ataque sorpresa solo le funciona a unos cuántos!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces no deberías descuidarte con tipos como yo, ¿no? Y más aún cuando\nse trata de un joven y guapo hombre.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0018",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000730",ch="aid"},
},
ja={
{
name={"Ai"},
"“No estoy de acuerdo con lo que dices. Yo jamás me descuidaría con un joven\nhombre guapo.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué estás haciendo ahora?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0013",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000731",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Hii!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",mode=-2},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Paso a cargar a Ai en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"No me costó ni una gota de sudor en levantarla.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Vaya que es ligera.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"mwact",act="うんうん"},
{"se",file="se9032",vol=70,id=1},
{"text"},
delay={
vl01={
{"se",file="se9032",vol=70,id=2},
},
},
text={
vo={
{"vo",file="fem_aid_000732",ch="aid"},
},
ja={
{
name={"Ai"},
"“B-Bájame. ¡No me cargues!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sucede que esta pequeña no escucha a los demás. ¿Ves lo fácil que te dejas\ncargar por tipos como yo, Ai?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_aid_000733",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡T-Te lo vuelvo a decir, te equivocas! Si fueses un completo desconocido ya\nestaría ejecutando una sumisión.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Intenta someterme entonces...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000734",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_aid_000735",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-No puedo...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Verdad que no?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_aid_000736",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si intento hacer una sumisión a esta altura podría doblarte el brazo con mi\npeso...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, claro, también tenías esa posibilidad.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Ciertamente, estando en este estado podría ejecutar fácilmente un ude-\nhishigi-juji-gatame.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Si llegara a lanzarme encima su peso podría acabar destrozando mi brazo.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_aid_000737",ch="aid"},
},
ja={
{
name={"Ai"},
"Por ahora, quisiera que me dejaras bajarme. Hablar en este estado, es... un\ntanto penoso.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Bajo a Ai.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="藍",size="z2",my=-40,mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0023h",head="aix_z2h",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0011h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000738",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo que acabas de hacer fue muy injusto. ¡A-Abrazar de esa forma, a una mujer!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, tú también me abrazas de vez en cuando, Ai.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0011h",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0018h",head="aix_z2f",lv=5,id=9},
},
vl02={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000739",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Porque soy una especie de hermana mayor, tengo ese privilegio.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Entonces yo no puedo abrazarte?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0005h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0018h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000740",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Así es. N-No puedes, no debes.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué demonios?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0018",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0009",head="aix_z2e",lv=5,id=9},
},
vl03={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0018h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
vl04={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000741",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo soy mayor, no hay problema en que te abrace. Pero tu no debes. Tú... ¡No sé\nbien por qué, pero no debes!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entendí ese argumento, pero está bien. Y la verdad, tampoco soy un niño ya,\ncreo que me sobrepasé un poco.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La próxima vez me aseguraré de advertirte que te 'acosaré' previo a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0008h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0011h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000742",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Aun así no debes. No, y no, y no.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0009",head="aix_z2e",lv=5,id=9},
{"bgm",file="bgm016"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000743",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-En fin, si algo llegara a sucederte por culpa de los Nakamura, no soportaría\nla culpa.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0006",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0005",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000744",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no lo sabes. ¡No entiendes lo mucho que me preocupo por ti!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah--, sí, es verdad. Hagamos esto entonces.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te molesta si uso este taller por unas semanas?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0012",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000745",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo unas cuantas cosas que hacer, y debo encerrarme unas semanas para\nterminar todo eso. ¿Crees que pueda usar el depósito?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0012",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000746",ch="aid"},
},
ja={
{
name={"Ai"},
"“C-Claro, no hay problema. ¿Te quedarás a dormir acá?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no planeo quedarme a dormir, pero... puede que pase varias noches acá\ntrabajando.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0008",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000747",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Vas a madrugar trabajando? ¿Es que vas a pintar algún cuadro?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es la gran cosa, es solo un trabajillo que me encargaron. Y respecto a eso,\nquiero que me prometas algo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0002",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000748",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Que te prometa algo? Dime qué.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No le digas a nadie que estoy usando este taller. Ni siquiera a Kei, por\nsupuesto.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0008",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000749",ch="aid"},
},
ja={
{
name={"Ai"},
"“No sé por qué me lo pides, pero mantendré la boca cerrada, si eso necesitas.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no quiero que nadie entre mientras trabajo. Ni Kei, ni tú.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0009",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000750",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es que...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"¿Qué hago?",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Obviamente no puedo decir la verdad, y tampoco quiero meter a Ai en esto.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Si Ai llega a verme haciendo estas falsificaciones, se convertirá en cómplice.\nY no quiero que eso suceda.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Me vine sin ninguna excusa en mente.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Ehmmm, veamos.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Sí, creo que solo me queda usar esto.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Resulta que el trabajo que me han encargado--!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000751",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tiene un fuerte contenido pornográfico!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013h",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000752",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Por lo tanto, no puedo permitir que me veas trabajando.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011h",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009h",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000753",ch="aid"},
},
ja={
{
name={"Ai"},
"“C-Cuando hablas de trabajo pornográfico... ¿qué, es lo que debes hacer?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues dibujar contenido de ese género.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013h",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000754",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿H-Has estado trabajando en eso?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005h",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000755",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡P-Pero aún eres un estudiante, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi situación económica no me permite rechazar ningún trabajo. Ahora que el\nviejo está en peligro, tendré que valerme por mi mismo de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000756",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ugh... s-sí, bueno, ya me he enterado de la condición de Kenichiro-san...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso mismo debo trabajar.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
vl03={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011h",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000757",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sé que eres estudiante y no tienes una fuente constante de ingresos, pero, en\nestos casos lo normal es hacer un trabajo de medio tiempo convencional, ¿no?\n¿Por qué t-te has puesto a trabajar en esos, esos encargos p-pornográficos?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Porque yo vivo para lo erótico, sí señor!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013h",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000758",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿V-Vives para lo erótico?!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente, Ai. ¡Así que te lo pido, por favor! ¡No despojes a un joven de su\ntrabajo, de su labor de vida!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011h",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008h",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009h",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000759",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Ah, eh? ¿Ehh?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y solo por si acaso te digo que se trata de creación artística.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008h",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000760",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿C-Creación artística?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así es! ¡Creación artística erótica!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Ni siquiera yo sé lo que estoy diciendo.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010h",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009h",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000761",ch="aid"},
},
ja={
{
name={"Ai"},
"“C-Claro, quizás sea algo pornógrafico, pero son dibujos después de todo,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, algo así...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0009h",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0011h",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000762",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Está bien, entiendo. Creo entender ya lo que haces y para qué.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entiendes lo que trato de hacer?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0009h",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0010h",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000763",ch="aid"},
},
ja={
{
name={"Ai"},
"“La verdad es que no por completo, pero... escuchando la pasión que hay en tus\npalabras, supongo que no hay nada que pueda hacer.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Sí?!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008h",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010h",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011h",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000764",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Entiendo que eres un muchacho, es completamente normal que tengas interés en\nesas cosas. Aunque tengo todavía sentimientos encontrados por el hecho de que\ntrabajes en eso, pero si me dices que vives para esa profesión... no tengo\nderecho de prohibirte nada.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así es, no lo hagas, te lo ruego!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000765",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Está bien. Basta con que no entre a ver, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000766",ch="aid"},
},
ja={
{
name={"Ai"},
"“Solo te pido que vengas de vez en cuando a la casa a vernos, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ten por seguro que lo haré.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000767",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me alivia escuchar eso. Bien, cumpliré entonces con nuestra promesa.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, me iré ya, tengo otras cosas que terminar.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000768",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Otras cosas? Pareces estar bastante ocupado.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tengo algo de presión encima.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Debo decir que esa fue una terrible excusa la que me inventé, pero bueno... no\nhabía otra manera.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bluesky_summer",id=8,lv=8,rule="083r",sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
"El sol comienza a acercarse al horizonte.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Los días se acaban rápido en verano.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Al llegar a Sakuragahara, me dirigí a la tienda de materiales de pintura.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"se",id=1,file="se2225"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=0,speed=180000,file="zbg014b",path=":bg/",x2=960,y2=-540,x=960,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_tns_000017",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¡Bienven-- ah! ¡Kusanagi-kun, pero si eres tú!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tiempo sin verle señor.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_tns_000018",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Qué haces aquí? Tengo años sin verte venir a la tienda. ¿Volverás a pintar de\nnuevo?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No exactamente. ¿Cree que pueda reunirme estos pigmentos?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_tns_000019",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Pigmentos?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Le doy al dueño la tabla de pigmentos de 'Cerezos recostados' que Fridmann me\nproporcionó.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Al ver la tabla, el rostro del dueño tomó un aspecto serio.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_tns_000020",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Muchos de estos pigmentos son difíciles de encontrar, eh. Y costosos, muy\ncostosos, además...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_tns_000021",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Y? ¿Qué piensas pintar?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"El dueño de la tienda me pregunta eso, buscando saber más.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tanto pintar, se trata más de una restauración.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_tns_000022",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Restauración? ¿Alguna de las pinturas de tu padre?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo así.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_tns_000023",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Ah, ya veo. Me dejaste perplejo por un momento. Esta es la misma tabla de\npigmentos usada en 'Cerezos recostados', así que pensé que ibas a crear algo\nde tu parte.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Tal como lo había imaginado, el dueño es inteligente.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Consideré la posibilidad de que sospechara algo solo viendo la tabla de\npigmentos, y solo le bastó un instante para darse cuenta de que era la tabla\nde 'Cerezos recostados'.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que es más un encargo de parte de mi padre.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_tns_000024",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Ah, ¿no vas a pintar nada entonces? Es una lástima, me gustan tus cuadros.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"El dueño es un viejo conocido de mi padre, y al parecer trabajó bastante con él\ncuando todavía estaba en Japón. Según mi padre me contó, es capaz de\nconseguir con rapidez todos los pigmentos que necesites.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Y usando sus contactos, puede encontrar incluso aquellos más difíciles de\nconseguir.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_tns_000025",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Casi todo lo que me pides lo debo ordenar, ¿es urgente?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con toda urgencia.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="man_tns_000026",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Déjame preguntarte una vez más. No es para una nueva obra tuya, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, obra mía no es.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_tns_000027",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Mmmm, ¿es así? Bueno, qué importa. Si realmente vas a volver a tomar un pincel\nen mano de nuevo, haré todo lo posible por conseguirte esos pigmentos\nrápidamente.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se lo encargo, por favor. Y, ahora, respecto al tamaño de los lienzos...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_tns_000028",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Tamaño? ¿Lienzos?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiera encargar unos cuantos, la cantidad y medidas están escritas en este\npapel.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_tns_000029",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¡¿Eh?! ¡Muchacho, estas dimensiones--!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="man_tns_000030",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“... ¿De verdad, es esto solo para una restauración?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues sí, lo es.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_tns_000031",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Hummm, ya veo. Bueno, está bien.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cree poder hacerme el favor?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_tns_000032",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Sí, está bien. Después de tantos años por fin podré ver más de tus obras, así\nque me esforzaré.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, como le dije, no voy a pintar nada... es solo, una restauración...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_tns_000033",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Sí, sí, entiendo. En fin, reuniré todo lo más pronto posible.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Con esto pude asegurar los pigmentos.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"De no tratarse del dueño del local de Sakuragahara, era muy seguro que me\nrechazarían esta petición. Son muchos pigmentos, y difíciles de conseguir.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Terminé con todo lo que podía hacer por el día y regresé a casa.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bgm",stop=1,time=1000},
{"se",id=1,file="gatya"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llegué...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm031"},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"fg",ch="雫",size="z2",time=200,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0801",face="b0005",head="shz_z2b",lv=5,id=9},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000370",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"¡*Bish*!",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Al pasar a la entrada, Kuzu me recibió parada, haciendo una pose.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Pero qué demonios?! ¿Qué haces en ropa interior?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000371",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No es ropa interior. Es un traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué haces con un traje de baño?!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000372",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Siempre me baño sola.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues obviamente que sí.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000373",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Y se me ocurrió que no estaría mal lavar tu espalda de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No quiero eso! ¡Naoya Kusanagi no necesita esa clase de situaciones que muy\nbien podrían aparecer en alguna comedia romántica o erótica, no las necesito!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0006",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0010",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000374",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No quieres... Eso significa, que no te gustan los pechos planos.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Escucha, no se trata de eso--”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0006",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000375",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eso significa que debería acentuar más la arma más poderosa de Kuzu, su\naspecto de infante?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acentuar más tu aspecto de infant*? ¿Qué demonios piensas hacer?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000376",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Acentuar el hecho de que no tengo vello púbico.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo?!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"msgoff"},
{"bgm",stop=1},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0018",head="shz_z1b",lv=4,id=9},
{"ex",time=2000,func="wait"},
{"se",file="se9031",id=1},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0005",head="shz_z1b",lv=4,id=9},
{"fg",ch="雫",speed=150,mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0005",head="shz_z1b",y2="0,-10",y=0,lv=4,id=9},
{"ex",time=1000,func="wait"},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"bgm",file="bgm031"},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0801",face="b0006",head="shz_z2b",lv=5,id=9},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000377",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me quitaré la ropa.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Te prohíbo que hagas eso!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0801",face="b0013",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0009",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000378",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿T-Tampoco sirve eso? Supongo que falta entonces abrirme un poco más.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso de abrirte un poco más?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000379",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo encontré hoy buscando navegando en el teléfono. ¿Quieres que lo haga?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡No percibo nada bueno en esa terminología! ¡No es no! ¡¿Queda claro?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000380",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Tanta negación pone triste a Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha bien, Kuzu. Soy un muchacho normal, y muy saludable.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000381",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso mismo, si sigues haciendo esto podría perder mi control en cualquier\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0003",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000382",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No tengo problema con que pierdas el control. ¡Violación con penetración\ninstantánea, y mucho más! ¡Todo eso es posible con este lubricante que yo\nmisma elaboré!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué demonios haces creando tu propio lubricante?!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0003",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000383",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pues, pensé que de entrar a bañarnos juntos podría hacer algo que te gustara, y\nal buscar en el navegador del celular di con una página de lubricantes\ncaseros.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que esa clase de sitios existen?!”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0005",head="shz_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0006",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000384",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Se pueden hacer fácilmente con almidón de papa. ¡Pero, el almidón se pudre en\ncuestión de horas! ¡Oh no, hay que usarlo ya!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no te preocupes. Hoy prepararé mapo tofu con eso.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0010",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000385",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Todo el esfuerzo de Kuzu...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que no necesito nada de eso. Y no te preocupes, me encargaré de ver\nrevistas porno antes de dormir para no tener pesadillas.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"bgm",stop=1,time=1000},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000386",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo de la pesadilla fue culpa mía, no tienes por qué ocupar tu tiempo en eso,\nNaoya.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no importa, haré lo posible por tener buenos sueños eróticos. No hace falta\nque hagas nada.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000387",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo cual quiere decir que Kuzu es una buena para nada...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto. Simplemente preferiría que no intentes darme ningún estímulo\npervertido.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000388",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Está bien. Si tanto insistes, no tengo más opción que ceder.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000389",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero ten por seguro que algún día te regresaré este favor, sea de la forma que\nsea.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro. Solo hay algo que quisiera que hicieras por mí cuando todo esto\ntermine. Con eso me es suficiente.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0003",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000390",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Una o todas las que quieras, haré lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, cuando todo termine te lo diré.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0004",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000391",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, a cenar y dormir temprano hoy. Probablemente comience a regresar tarde a\ncasa a partir de mañana.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000392",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me entró un trabajo de urgencia. Tal vez incluso hayan días en los que me quede\ntrabajando y no regrese. No creo que pueda darte sueños a tragar en esos\ndías.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dile a Kenichiro que te deje tragar alguno de sus sueños mientras tanto.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000393",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No creo que pueda hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000394",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Seguramente Kenichiro está teniendo ahora muchos sueños del pasado. Nadie tiene\nderecho a ver los recuerdos de los demás sin permiso alguno.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Ya al viejo no le queda mucho tiempo... Entiendo muy bien a lo que se refiere\nKuzu.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... aunque, en ese caso no podrás comer nada durante varios días.\n¿Estarás bien?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0002",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000395",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Estaré bien. Kuzu se las arreglará solita.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, está bien entonces, supongo... Bien, mañana me toca salir temprano, así\nque...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0004",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000396",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Está bien. Hoy comeré bastante de tus sueños, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="雫",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9002",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Uhm? ¿Está sonando mi teléfono? ¿Mm? ¿Un mensaje?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, ese mensaje lo acabas de enviar tú!”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000397",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Rayos, me han descubierto.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y cómo querías que no te descubriera? A ver, ¿qué enviaste?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0016",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000398",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Son fotos mías. Aprendí mucho en Internet, así que muy seguramente te servirán.\nTambién hay algunas donde me 'abro'.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Borrar, borrar, borrar, borrar, borrar.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000399",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ah, el esfuerzo de Kuzu va siendo borrado sin siquiera ser apreciado...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ni lo voy a ver!”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000400",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Has pulverizado cada uno de los gestos que Kuzu ha intentado mostrar por ti...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni creas que voy a ver fotos tuyas 'abriéndote'.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0005",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000401",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ni siquiera sabes a qué me refiero cuando digo que me 'abro'.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No importa. No sé a qué te refieres, pero probablemente sí lo sé.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0801",face="b0018",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000402",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Realmente eres malo conmigo.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La culpa está en tu falta de sentido común.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Y de esta forma terminó otra noche más.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Aunque a partir de mañana se acabará esta calma.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_02_13"},
{"text"},
linkback="block_00256",
},
label = {
top={block="block_00000",label=1},
},
}
