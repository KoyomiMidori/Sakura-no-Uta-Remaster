astver = 2.0
astname = "ast"
ast = {
block_00000={
{"excall",label="next",cond="f.mak>=3"},
{"excall",label="next",cond="f.rna>=3"},
{"excall",label="next",cond="f.shz>=3"},
{"eval",exp="f.rinroute=1"},
{"excall",label="join"},
{"text"},
linknext="block_00001",
},
block_00001={
{"eval",exp="f.rinroute=1",cond="f.mak>=3&&f.rna>=3"},
{"eval",exp="f.rinroute=1",cond="f.rna>=3&&f.shz>=3"},
{"eval",exp="f.rinroute=1",cond="f.shz>=3&&f.mak>=3"},
{"eval",exp="f.rinroute=1",cond="f.mak>=3&&f.rna>=3&&f.shz>=3"},
{"excall",label="join",cond="f.rinroute==1"},
{"eval",exp="f.makroute=1",cond="f.mak>=3"},
{"eval",exp="f.rnaroute=1",cond="f.rna>=3"},
{"eval",exp="f.shzroute=1",cond="f.shz>=3"},
{"excall",label="join",cond="f.makroute==1"},
{"excall",label="join",cond="f.rnaroute==1"},
{"excall",label="join",cond="f.shzroute==1"},
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c16_01",path=":ev/ev_uni_c16/",set="ev_uni_c16"},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
"Debajo del cielo de verano.",
{"rt2"},
},
},
},
labelcount=12,
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No importa qué tan pequeño sea. Por ahora, elijo un lugar con sombra y me\nrecuesto.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Sin embargo, el sol de verano es implacable. A medida que el sol sube más hacia\nel punto tope, se va robando la poca sombra que había.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"El intrincado patio. La brisa del mar cruza por entre las edificaciones y actúa\ncomo una especie de aire acondicionado natural.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"La brisa del mar. Solo decir eso evoca bastante gusto y finura.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Aunque el viento que atraviesa las edificaciones proviene, como se podría\ndecir, de las edificaciones, así que en realidad no tiene ni un solo ápice de\nfinura.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Sin embargo, gracias a este viento proveniente de las edificaciones, y sin\nfinura alguna, se siente bastante fresco.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Debajo del despiadado sol de verano. Me recuesto en un pequeño parche de\nsombra.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"A partir de este momento dormiré la siesta por 1 hora. De esa manera están\ndispuestos mis planes para hoy.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Al recostarme, algo extraño salta a mi vista.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Un hombre observando la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Un hombre sin sentido común, llevando un caluroso abrigo negro en medio del\nverano.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Rayos, algo bastante caluroso entró a mi vista... Pero qué molestia.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos está haciendo?...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Está observando la iglesia bajo el implacable y abrasador sol. Normalmente, la\ninsolación lo hubiera tumbado al piso rápidamente.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"No sé si es mera fuerza mental, o si simplemente está acostumbrado, pero...\nPero bueno, es un hombre con una fuerza de voluntad dirigida en la dirección\nequivocada.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos hace ahí parado, observando con tanta seriedad?...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Nada bueno resulta cuando él se embarca de manera seria en cualquier cosa. Su\nseriedad es más peligrosa que la seriedad de cualquier otra persona.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c16_01",path=":ev/ev_uni_c16/",set="ev_uni_c16",sync=0},
{"extrans",time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, vaya, ¿de nuevo planeando algo inescrupuloso? Este hombre no aprende para\nnada...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Cuántas veces ha sido suspendido, y cuántas llegado al borde de la\nexpulsión?... Es todo un insensato ese hombre.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un hombre insensato...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Solo hay dos tipos de hombres insensatos.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Y si me preguntan por qué... Pues, porque sería terrible que hubieran tantos\ntipos de insensatez.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"La pared que el hombre observa recibe con bastante fuerza los rayos del sol,\nreflejando un color blanco. Era como un enorme lienzo recibiendo el sol de\nverano.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Por más que el tiempo pase, ese hombre no se mueve.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Llegué a pensar '¿De verdad no se irá a desmayar?', pero supongo que no es\nnecesario preocuparse por esa 'cosa'. Ese hombre tiene el poder de\nsupervivencia de una cucaracha. No va a morir por algo como eso.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Faahh...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Apenas me recuesto, el sueño me invade. Por ahora, cierro mis ojos.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"se",file="se_semi",id=1},
{"text"},
text={
ja={
{
"Me despierto por el sonido de las cigarras.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"¿Qué tanto habré estado dormido? Aunque me parece que no dormí por tanto\ntiempo...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"En fin, ese hombre había desaparecido ya.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya se fue...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Es lo obvio. ¿Qué demonios vino a hacer aquí en medio de las vacaciones de\nverano? No debería tener nada que hacer...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente es un ocioso...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Aunque quizás no pueda decir mucho al respecto... La verdad es que tengo una\nlegítima razón, aunque en contra de mi voluntad, para tener que venir al\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Si no tuviera esa razón, no vendría de ninguna manera a este lugar. No soy tan\nocioso como para desperdiciar las vacaciones de verano en el colegio.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",file="zev_uni_c16_02",x=-400,y=-100,path=":ev/ev_uni_c16/",set="ev_uni_c16",ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Vuelvo a ver hacia el cielo.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Por alguna razón, el cielo estaba tapado por una sombra.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una sombra? No, esto es... ¿Una sombrilla?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_uni_c16_02",path=":ev/ev_uni_c16/",set="ev_uni_c16"},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Lanzo mi mirada hacia más allá de la valla donde estaba amarrada la sombrilla.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_a30_01",path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
ja={
{
"Allí estaba Hikawa, con un sombrero de paja encima.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Espera... ¿Un sombrero de paja?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hikawa?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rna_000090",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hace bastante calor~, realmente, qué calor... Ya el verano está cercaaa... Y,\nasí de esa forma expreso mi asombro, una y otra vez...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás acá?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_a30_02",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000091",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues eso. Tu hermanita kouhai está siempre dentro de tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy preguntando por esa clase de historias de fantasía.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_a30_01",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000092",ch="rna"},
},
ja={
{
name={"Rina"},
"“De fantasía... Una hermanita kouhai de fantasía, se siente justo como si fuera\na comenzar un nuevo drama, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, dentro de tu cabeza puede comenzar eso y cualquier otra cosa. Pero no te lo\nsaques de la cabeza. Es realmente irritante...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rna_000093",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí, lo sé. Senpai, hay que ver que siempre eres estricto con Hikawa, ehhh.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde hace tiempo nunca he entendido lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rna_000094",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué cruel eres, diciendo eso, y además que es desde hace tiempo. Aunque bueno,\nRina ha sido excéntrica desde hace un gran tiempo, pero nunca críptica.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que estás consciente de que eres excéntrica?...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rna_000095",ch="rna"},
},
ja={
{
name={"Rina"},
"“Excéntrica... Pues, consciente estoy. Aunque, diría más bien que muy delirante.\nComo la noche de ZYPRESSEN, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"La noche de ZYPRESSEN... Al escuchar esa frase, se me vienen a la mente unos\nárboles, como unas llamas negras, parados debajo de la noche.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Qué estás haciendo, excéntrica? Llevando un sombrero de paja debajo\nde este sol tan implacable.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rna_000096",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vi cómo te estabas secando al borde del agua, así que decidí observarte, a tu\nlado.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No entiendo nada de lo que dices, eh. En primer lugar, ¿qué quieres decir\ncon el 'borde del agua'? Yo estoy durmiendo en el patio.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rna_000097",ch="rna"},
},
ja={
{
name={"Rina"},
"“Veo que tu sentido espacial es tan nulo como siempre, senpai. ¿Acaso no estás\ndurmiendo justo al lado de la piscina? Por eso es que estamos hablando ahora\ncon la malla metálica de por medio.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La piscina? Ahh, ahora que lo mencionas...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Pensaba estar durmiendo la siesta en el jardín trasero, pero ahora que lo\npienso bien, justo a un lado del jardín trasero está la piscina.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Ciertamente pude ver la piscina al fondo de la malla metálica... Parece que\nlos humanos tienen un mecanismo que les hace borrar todo aquello que no les\ninteresa.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Lo había olvidado por completo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Puedo ver un poco, tras la malla metálica, la espalda de Hikawa y un sombrero\nde paja. Y la sombrilla abierta estaba colgada de la malla.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Yo estaba dentro de la sombra de esa sombrilla.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"La razón por la cual pude dormir la siesta debajo de la sombra sin recibir la\nluz directa del sol era esto...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te importa no cubrirte con la sombrilla?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rna_000098",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, Rina tiene su sombrero de paja.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces por qué trajiste una sombrilla?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rna_000099",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pensé que llegaría a usarla, pero parece que no la necesito, así que la dejé\nsuelta.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Por más pequeña que sea Hikawa, no lo es tanto como para poder cubrir su cuerpo\nentero de los rayos del sol de verano con un sombrero de paja...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Y, sobre todo, si no va a usar la sombrilla entonces no tenía por qué dejarla\nsuelta y abierta...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué calor, eh.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_a30_03",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000100",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Hace tanto calor que cualquiera que se atreviera a dormir debajo de este\nsol terminaría completamente seco en un momento.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los humanos no se secan tan fácilmente...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_000101",ch="rna"},
},
ja={
{
name={"Rina"},
"“No del todo. La insolación es terrible. Ataca siempre de repente...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece, eh...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rna_000102",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es... Aunque el afectado piense que está bien, a veces termina desmayándose\nsúbitamente. Es necesario tener cuidado.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sabes bastante, eh.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_com_a30_01",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000103",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las especificaciones del cuerpo de Rina son bajas, así que ya lo he\nexperimentado varias veces.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_rna_000104",ch="rna"},
},
ja={
{
name={"Rina"},
"“En especial, es peligroso para aquellas personas que se duermen babeándose\ndebajo de este sol.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rna_000105",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada está bien. Además, no es bueno exponer esa cara tan desprotegida a los\ndemás de manera tan descuidada.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por mi parte no hay problema...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_a30_03",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000106",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no lo decides tú, senpai.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rna_000107",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tu cara dormida solo la pueden ver aquellos que tengan el privilegio para\nhacerlo. Me causa problemas que la expongas al público con tanta ligereza.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué rayos estás hablando...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_a30_01",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000108",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Has visto ya dormir a tu amigo ~ para conocer cuál es su aspecto? ¿Pues qué\nes, por lo demás, el rostro de tu amigo? ¿Has visto ya dormir a tu amigo? ¿No\nte horrorizaste de que tu amigo tuviese tal aspecto?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te pongas a citar cosas extrañas de nuevo. Y qué sorpresa que conozcas esas\npalabras.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_a30_02",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000109",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jejeje, excelente, Kusanagi-senpai, eres capaz de descifrar rápidamente las\nfuentes de aquellas frases que excitan los corazones de los delirantes y\nfantasiosos.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No le digas delirante y fantasioso a un personaje histórico importante...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_a30_01",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000110",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno, en fin, el privilegio de ver el rostro al dormir de senpai le pertenece\na su hermanita.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué... rayos...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_000111",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así son las cosas. Aunque, ese privilegio no durará por siempre...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_a30_04",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000112",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero agradecería que me acompañaras en esta farsa, hasta el último momento en\nque ya no pueda hacer uso de ese privilegio... Ejeje.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Y, sin saber por qué, Hikawa dijo eso con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida eso, y usa tú esa sombrilla...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rna_000113",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rina está bien. Pues es la hermanita con sombrero de paja.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Escucha, ¿no acabas de decirlo tú misma? De que los síntomas de la\ninsolación no son percibidos por el afectado y atacan súbitamente...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, Hikawa, ya tienes experiencia en el asunto, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además――”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_a30_01",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000114",ch="rna"},
},
ja={
{
name={"Rina"},
"“... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rna_000115",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Podrías permanecer en silencio por un momento?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ja? Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Se puede ver la silueta de una persona al lado de Hikawa.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Esa es...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"se",file="se9004",vol=70,id=1},
{"bg",file="ev_com_a30_05",path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000137",ch="yum"},
},
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_rna_000116",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_000138",ch="yum"},
},
ja={
{
name={"???"},
"“Rina... Eso es lo que debería preguntarte yo. ¿Qué haces acá hablando sola?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rna_000117",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ohh, esto? Yuumi, ¿no puedes saber de qué se trata viendo esto?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_000139",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No... No le veo sentido alguno.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rna_000118",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tal como lo ves, estoy pescando~”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_000140",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero esta es una piscina.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rna_000119",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, es una piscina.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_000141",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Puedes pescar algo aquí?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rna_000120",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmm, estoy investigando eso ahora~”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_000142",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te diviertes?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rna_000121",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, es algo divertido~”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_yum_000143",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero parece ser aburrido.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rna_000122",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa~? Estás algo terca, eh, Yuumi. ¿Estas en 'ese' día~?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"La silueta de Kawachino asiente ligeramente.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Al ver eso, Hikawa movió su cabeza a los lados ligeramente.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rna_000123",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tengo muchas servilletas, así que no sirve de nada que vengas acá~”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rna_000124",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ashi que vete ya, jovénshita. La abuela inshistirá un rato más acá, ehh.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"se",file="se9010",vol=30,id=1},
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
ja={
{
"Kawachino se sienta con un pequeño movimiento al lado de Hikawa.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Quedo algo sorprendido ante ese gesto suyo tan natural.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Kawachino pareciera no abrirle su corazón a casi nadie...",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Obviamente, no lo hace con Akashi, pero tampoco lo hace ni con Kei ni conmigo,\nni con alguien de su mismo sexo como Toritani... ni tampoco con Rin...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Sin embargo... por alguna razón, pareciera ser que Kawachino le abre su corazón\nnada más a Hikawa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Es como si actuara de manera normal únicamente frente a ella.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_a30_07",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000125",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué pasha~, Yuumi-chan. Apreshurate, eh~, ya van a comenshar las clases...\nAbuelita te dará caramelos, ashí que cuando los reshibas vete rápido.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_000144",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No necesito. Odio las cosas dulces. Además, estamos en vacaciones de verano, no\nhay clases...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rna_000126",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Odias lo dulce? Ya veo, aún con lo delishioso que es el dulce, ehh... ¿Quieres\nun sukonbu entonshes? Es muy bueno, ehh. Sabe a vinagre, y es muy, pero muy\ndelishiosooo.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_yum_000145",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, esa imitación no es muy cómica...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000127",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No es muy cómica?... Pero es todo un boom ahora... Se supone que la primera\nmitad de este año estaba terriblemente de moda...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_yum_000146",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo dentro de tu universo, Rina...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rna_000128",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mi universo es equivalente a todos los universos, así que el hecho de que esté\nde moda en mi universo significa que también está de moda en todos los\nuniversos, así que... Ah, me da fastidio seguir explicando...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_yum_000147",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, siempre eres bastante serena y refinada en el salón, y tu manera de\nhablar también es elegante... Y por eso me siento feliz de que tomes esa\nactitud tan libre y despreocupada solo frente a mí...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"¿Hikawa es serena y refinada en el salón? ¿Esa Hikawa? ¿Es en serio?",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Esa es solo la propia visión de Kawachino, ¿no?",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Por lo menos, yo no recuerdo haber visto a Hikawa jamás actuar de esa...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"No.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Sí, ahora que lo recuerdo, cuando apenas nos conocimos parecía ser así.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Pero, más que serena y refinada, parecía ser algo distinto. ¿Quizás se le\npodría llamar 'sombra'?... Era algo más arraigado en ella.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_000148",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque mi personalidad es excéntrica desde hace bastante tiempo, así que\nsupongo que me sigues la corriente cuando estás conmigo...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_000149",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero me hace más feliz cuando actúas de manera linda, Rina.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rna_000129",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no soy tan linda como lo describes, Yuumi. Además, jamás te he considerado\ncomo una excéntrica.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_yum_000150",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo estoy loca. Estoy consciente de ello, sin embargo, tú eres distinta, Rina.\nLa Rina natural es amada por todos.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rna_000130",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no, incluso Kusanagi-senpai dice que soy excéntrica... No estoy tratando de\nseguirte la corriente, Yuumi. Probablemente esta es mi forma natural.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_yum_000151",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, ese senpai es más que excéntrico, es un simple depravado y está loco. Tú\nsimplemente has tratado de seguirle la corriente a él. Es un demente.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡¿Q-Qué dice?! ¡Esta mocosa!",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rna_000131",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, ciertamente, mi senpai es un tanto raro.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡Hikawa, imbécil! ¡Si consideramos la proporción de demencia entre Kawachino y\nyo estaríamos hablando de 4:6 a favor de Kawachino, eso si usas el sentido\ncomún!",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rna_000132",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero, senpai es excéntrico, o, más bien, pues da la sensación de que tiene\nmucho talento. Él es un genio...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_yum_000152",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo talento... Eso es lo único que tiene...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rna_000133",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dicen que los genios no están hechos de talento.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_yum_000153",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién dijo eso?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rna_000134",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, hace tiempo Kei-senpai me lo contó una vez. De que los genios hacen\nolvidar el talento a los demás.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_yum_000154",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ese senpai es solo un idiota, así que esas palabras no son de fiar.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rna_000135",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees? Aunque a mí me parecen bastante ciertas...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_yum_000155",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muh...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Kawachino infla sus cachetes.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Así que Kawachino es capaz de mostrar esa expresión también... Cuando está con\nHikawa.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_a30_07",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000136",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ah, sin embargo, hace bastante calor, eh~ Este verano está en su momento\nmás implacable, ehh...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_000156",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me parece que te da calor por estar en este lugar donde caen tan fuerte los\nrayos del sol, Rina...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rna_000137",ch="rna"},
},
ja={
{
name={"Rina"},
"“El calor fatiga... No me dan ganas de hacer nada...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_000157",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué tendrá que suceder algo tan fastidioso como esto~?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_rna_000138",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te refieres al verano? El verano no es fastidioso, señorita. El cielo azul,\nlas blancas nubes, el extenso mar, largas vacaciones, ¡y vacaciones!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000139",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y vacaciones desde el final de julio hasta el primero de septiembre!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_000158",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Te encantan las vacaciones de verano, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_000140",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues ni hablar, me encantan y fascinan.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_000159",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A mí tampoco me fastidia el verano... Además, me gustan las vacaciones de\nverano.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rna_000141",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Entonces qué es lo que te fastidia, señorita?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_000160",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La menstruación... es fastidiosa.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rna_000142",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah~, eso, eh~, ciertamente es fastidiosa, pero es necesaria para dejar\ndescendencia~”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_yum_000161",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No dejaré descendencia.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rna_000143",ch="rna"},
},
ja={
{
name={"Rina"},
"“A Dios no le interesa las circunstancias individuales de cada quien. Le da\ntedio usar una línea de producción distinta para cada quien, así que nos\nfabrica a todos en la misma. Y por eso es que todos estamos hechos igual.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_yum_000162",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No me importa en lo más mínimo las circunstancias de Dios... Les pone las\npartes raras de la misma manera a todos, y lo más importante lo reparte de\nmanera dispersa... es absurdo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_000163",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Además, si ese Dios realmente existiera entonces quisiera reclamarle varias\ncosas...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rna_000144",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué le dirías?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_yum_000164",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Le diría varias cosas.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rna_000145",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues tendrás que esforzarte.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_yum_000165",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Esforzarme?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rna_000146",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así mismo. Según, con ese ese señor llamado Dios solo se pueden encontrar\naquellos que van al Cielo. Si quieres reclamarle algo entonces tienes que\nesforzarte para ir al Cielo mientras vivas.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_yum_000166",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo... Parece ser alguien muy arrogante. Eso de no poder verlo a menos que\npidas una cita y esperes por ella toda tu vida... Es bastante cruel ese\nseñor.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rna_000147",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya te lo dije... A Dios no le importan las circunstancias individuales de\nnadie. Dios no le presta la más mínima atención a lo que le pase a uno u al\notro.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_yum_000167",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y entonces, ¿qué debería hacer para poder ir al cielo?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rna_000148",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmm, esa cuestión está fuera de la especialidad de Rinacchi, así que no sé muy\nbien, pero supongo que rezarle a Buda, ofrecer sacrificios, pelear las\nCruzadas, hay varias maneras, aunque la forma más rápida que te puedo\nrecomendar es...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rna_000149",ch="rna"},
},
ja={
{
name={"Rina"},
"“Que me des dinero a mí, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_000168",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rna_000150",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quieres saber?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_000169",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rna_000151",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque podría ser una historia muy larga... ¿Aun así quieres saber?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_000170",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rna_000152",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te estoy diciendo que será larga la historia...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_000171",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_000153",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me fastidia tener que explicarte, así que dame el dinero y ya, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_000172",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si no termino de convencerme, no te daré dinero.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_a30_07",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000154",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso quiere decir que de quedar convencida me pagarás. Me pagarás el monto\ncompleto, ¿no? Hace mucho, mucho tiempo, en el continente del oeste, existía\nel tercer hijo de Dios...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_000173",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El comienzo de la historia es bastante súbito...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rna_000155",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien, cállate y escucha. Ese hijo de Dios viajó por todo el mundo,\npredicando y buscando enseñar las verdades de este mundo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_rna_000156",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y entre eso y aquello, esa encarnación de Dios obtuvo a varios discípulos...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_yum_000174",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso de encarnación de Dios huele raro...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000157",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, así es. Y por eso, uno de sus discípulos le preguntó.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rna_000158",ch="rna"},
},
ja={
{
name={"Rina"},
"“Preguntó, '¿De qué manera debemos comportarnos para poder abrir las puertas del\nCielo?'...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_rna_000159",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y entonces, la encarnación de Dios dijo esto... 'Si eso desean obtener...\nprotejan los mandamientos'.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_yum_000175",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mandamientos? ¿Qué clase de mandamientos?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rna_000160",ch="rna"},
},
ja={
{
name={"Rina"},
"“Primero, no debes matar. No debes fornicar. No debes robar. No debes dar falso\ntestimonio, honra a mamá y a papá... y ama a tu prójimo como a ti mismo...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_yum_000176",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Son un montón...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_rna_000161",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, los humanos deben usar toda su vida y respetar ese montón de mandamientos\npara poder abrir las puertas del Cielo...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_yum_000177",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jee... Parece ser bastante difícil... eso de ir al Cielo...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rna_000162",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero ese discípulo era bastante inteligente y capaz, así que supuestamente\nsiguió todos los mandamientos.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_yum_000178",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Entonces pudo ir al Cielo?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_rna_000163",ch="rna"},
},
ja={
{
name={"Rina"},
"“No. Parece que no pudo.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_yum_000179",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000164",ch="rna"},
},
ja={
{
name={"Rina"},
"“El Señor así lo dijo... Si de verdad quieres abrir la Puerta perfecta, ve al\npueblo y véndelo todo, y reparte lo que consigas a los pobres.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_rna_000165",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso significa acumular fortuna en el Cielo...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_yum_000180",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_rna_000166",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es más fácil que un camello pase por el ojo de una aguja que un rico pase las\npuertas del Cielo...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_rna_000167",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que el discípulo se alejó del hijo de Dios con una cara triste...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_yum_000181",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es obvio...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_rna_000168",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero dicen que la mejor manera de ir al Cielo es pagar dinero rápido.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bg",file="ev_com_a30_07",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000169",ch="rna"},
},
ja={
{
name={"Rina"},
"“No voy a pedir el monto completo, pero, si pudieras prestarle unos 500 yenes a\nesta pobre señora...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_000182",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si necesitas dinero, entonces no me importaría, pero...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_yum_000183",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si llego a darte el dinero... Aunque yo pueda ir al Cielo, tú no podrás,\nRina...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_yum_000184",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso no me gusta.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_rna_000170",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, nooo... Por mi parte, no hay problema. Yuumi, tú eres una jovencita de\nbuena familia, así que quizás no lo sepas, pero en caso de no poder ir al\nCielo, si pagas dinero en el río Sanzu podrás ir a la Tierra Pura.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_rna_000171",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dicen que el dinero es el mejor abogado, incluso en las cortes del Infierno. Si\ntienes dinero puedes ir a la Tierra Pura, así que no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_000185",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad? ¿Entonces yo iré al Cielo, y Rina a la Tierra Pura?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_rna_000172",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Bueh, el Cielo te lo daré a ti, Yuumi, así que yo me quedaré con la Tierra\nPura.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_000186",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero entonces no podremos vernos...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_rna_000173",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Así que préstame dinero, por favor!”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_000187",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pudiste haberme dicho en un principio que te prestara dinero y ya...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_rna_000174",ch="rna"},
},
ja={
{
name={"Rina"},
"“U-Uhh... lo siento...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_yum_000188",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, claro. Te prestaré dinero, pero quiero preguntarte algo, Rina...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000175",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm? ¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_yum_000189",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿alguna vez has tenido sexo?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"bg",file="ev_com_a30_08",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000176",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Buh!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_rna_000177",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sexo?... Estás usando una expresión bastante directa... ¡Una dama no\npuede decir eso!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_000190",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Entonces has copulado?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_rna_000178",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Esa forma de decirlo es aún peor!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bg",file="ev_com_a30_07",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000179",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estás bastante intensa hoy, Yuumi. Estás tan intensa que esta pobre señora está\na punto de sacar fuego por la cara...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_yum_000191",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya te dije que esas imitaciones son aburridas, deberías dejar de hacerlas.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000180",ch="rna"},
},
ja={
{
name={"Rina"},
"“No digas tan tajantemente que son aburridas. Harás que me ponga triste.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_yum_000192",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo siento... Pero eso de que imites a una señora... no me gusta...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_rna_000181",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eh... Si pones esa cara tan remordida me lastimarás igual...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_yum_000193",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué todos harán esa clase de cosas?...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"bg",file="ev_com_a30_09",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000182",ch="rna"},
},
ja={
{
name={"Rina"},
"“Con esa clase de cosas te refieres a... ¿a eso? Mmm, ¿por qué será~?”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_yum_000194",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Simplemente no deberían hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_rna_000183",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Hay realmente algún problema en que lo hagan?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_yum_000195",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_rna_000184",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues solo digo, ¿acaso los hombres y las mujeres no prueban su amor juntando\nsus cuerpos~?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_000196",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los humanos no son más que un criadero de bacterias... No logro entender por\nqué se embarcan en esos riesgos...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000185",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Un criadero de bacterias?... Estas igual que siempre, Yuumi~”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_yum_000197",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero es que es así. Eso de juntar mi cuerpo con alguien más... yo no lo haré,\nde ninguna manera, así que quisiera que me quitaran esta sensación de\ncansancio de encima.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_rna_000186",ch="rna"},
},
ja={
{
name={"Rina"},
"“Otra vez de nuevo con eso... Yuumi, si sigues diciendo eso, vas a acabar con\ntelarañas en tu himen.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_000198",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No me importa... Además, Rinacchi, tú también tienes una v*gina con himen que\nno ha sido usada ni una sola vez aún...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"bg",file="ev_com_a30_08",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000187",ch="rna"},
},
ja={
{
name={"Rina"},
"“Otra vez~, me inquietas que digas esa clase de cosas vergonzosas de manera tan\nimpasible, así que deja de hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_rna_000188",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por Dios, esta muchacha, se la pasa diciendo esas cosas tan vulgares con esa\ncara tan fresca... Oh, esta señora se siente tan triste...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_yum_000199",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh... ¿Eh, Rina?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"bg",file="ev_com_a30_09",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000189",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mm? ¿Qué sucede? Yo soy Rina~”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_yum_000200",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es eso... Rina, está picando.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"bg",file="ev_com_a30_06",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000190",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Picando? ¿Eh? ¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"El corcho se mueve ligeramente.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Hikawa trata de jalar de inmediato, y rápidamente Kawachino procede a ayudarla.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"se",file="se3130",vol=30,id=1},
{"bg",rule="084b",time=150,file="black",path=":bg/"},
{"bg",file="bluesky_winter",id=9,lv=9,rule="084b",time=150,sync=1,path=":cg/"},
{"se",id=2,file="se3356"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000201",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kyah...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Al haber aplicado una mayor cantidad de fuerza de repente, el objeto que estaba\ndentro del agua salió con bastante impulso, y las dos caen al suelo.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Hikawa cae encima de Kawachino.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_yum_000202",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué pescaste?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_rna_000191",ch="rna"},
},
ja={
{
name={"Rina"},
"“La rueda de un carro.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Kawachino levanta la rueda... o mejor dicho, el tapacubos que pescaron.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="fem_yum_000203",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Esto... es divertido?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_rna_000192",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tanto.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_yum_000204",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me lo imaginé.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rna_000193",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vamos, ¿qué pasa? Yuumi, hoy estás bastante fastidiosa... Voy a violarte.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="fem_yum_000205",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Poh.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_000194",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_rna_000195",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, no se supone que deberías sonrojarte con eso...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
