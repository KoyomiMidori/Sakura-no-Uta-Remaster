astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Uhm?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Al terminar las clases del día de hoy e ir a la sala de arte, no había nadie.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Si no hay nadie ahora en la sala de arte es porque todos están concentrados en\nsus obras, seguramente.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Pensé que Rin me estaría esperando en la sala del club para sus lecciones de\npintura, pero...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003576",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun, ¿estabas ya dentro de la sala?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, simplemente pasé para saludar. Pensé que no estabas.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003577",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, estuve hablando con Mako-chan y me propuso que hiciera una pintura de\npaisaje, así que estuve caminando un poco por el colegio.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Desde que comenzaron las vacaciones de verano, Rin ha estado diciendo que\nquiere pintar afuera, y quizás sea mejor dejarla ya que pinte lo que quiera,\ny no obligarla a seguir las instrucciones de mis lecciones.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003578",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Había un montón de gente cerca del mural.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003579",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo durante clases se puede observar con calma, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003580",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh, me hubiera gustado ver el mural contigo. Fue realmente una lástima que\nterminara perdiendo en el piedra, papel o tijeras.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me dijeron que estuvieron jugando a eso en plena clase. Buen trabajo que\nhicieron para que el profesor no las pillara.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003581",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En lo que a eso respecta no tengo falla alguna. Y más aún cuando se trata de\nMako-chan y yo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debí esperármelo.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque por otro lado, realmente se la llevan muy bien ahora ustedes dos.\nBueno, ya desde la primera vez que se vieron comenzaron a llevarse muy bien.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003582",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sipi. Yo le hablé a Mako-chan para que me trajera a la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003583",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Desde aquel momento Mako-chan ha estado pensando en muchas nuevas ideas para\nprepararse para la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003584",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hablé con Mako-chan, y me di cuenta de lo enfocada que estaba. Así que pensé\nque yo también debería esforzarme.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué ponerte tanta carga encima tampoco.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003585",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, Mako-chan dijo lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003586",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Tanto tú como ella son muy amables.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La amable eres tú, Rin. Nadie podría decir lo contrario...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003587",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmmm... Creo que eso no es muy cierto.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Rin sonrió, con una sonrisa algo aquejada.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003588",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes? Mis pinturas aún son pésimas, aún las más básicas. Así que en realidad,\nquisiera que me siguieras enseñando, pero...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que dice Toritani es cierto. Si piensas presentar algo en la Exposición\nMoore, entonces es preferible que vayas comenzando a pintar lo que quieras y\ncomo quieras. Las básicas son importantes, sí, pero lo esencial es divertirse\nal pintar.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003589",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?... Es una lástima...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no importa. En mi caso, trataré de estudiar o hacer algo al regresar a\ncasa.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003590",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, cierto, tienes razón. Tienes que estudiar también.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me voy a mi casa ya. Nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fgact",ch="稟",act="びっくり",size=14,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003591",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Volteo a ver a Rin al escuchar su llamado.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003592",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Apoya a Mako-chan, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A Toritani? Ella hará lo que quiera y tenga que hacer, sin fallo alguno. Así\nno tenga mi apoyo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003593",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, claro, sí. Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003594",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso suena tan genial. Me parece asombroso que seas capaz de decir algo así\nrespecto a Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003595",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, por lo general nunca puedes apartar tu ojo de las personas débiles.\nPero, viendo cómo admites que Mako-chan no es una de esas personas, me doy\ncuenta de que se ha ganado tu reconocimiento. Creo que eso me da un poquito\nde envidia.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003596",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre he pensado que tienes un poquito de eso. No puedes pasar de alto a\naquellas personas, no precisamente débiles, pero en aprietos.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... no puedo negarlo en lo absoluto, aunque la mayoría de las veces todo lo\nque he hecho ha sido por el mero curso de las cosas, supongo.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003597",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Sí, mejor dejémoslo así.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, me voy a casa entonces.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003598",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien. Nos vemos, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Levanto un poco la mano para despedirme de Rin, quien estaba moviendo la suya\nligeramente, y me marché de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",file="se1279",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",file="bluesky_winter",rule="083r",sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está saliendo humo... debe ser Toritani...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Bueh, realmente no tengo nada que hacer allá, pero... ¿Será que echo un\nvistazo?",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Me dirijo al horno escalonado, donde Toritani está probablemente trabajando en\nestos momentos.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"No sé quién lo construyó ni cuándo, pero en el colegio Yumihari hay un horno\nescalonado. Pero qué colegio, de verdad...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bgm",stop=1,time=500},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_b01_01",rule="083r",vague=40,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Le estás poniendo bastante trabajo, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001739",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué viniste a hacer acá, Kusanagi? ¿Burlarte?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, nada de eso, solo que vi algo de humo salir desde lejos...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_b01_02",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001740",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, de la manera que lo dices se escucha precisamente como una burla...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás sola?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001741",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estuve obligando a Thomas a ayudarme hasta hace un rato, pero trató de ver tras\nmi falda y estaba muy fastidioso, así que lo retiré de sus labores.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001742",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre me pongo leggings antes de comenzar con las actividades del club, pero\ntenga o no leggings, me desagrada que me vean.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, puedo imaginarme lo desagradable que debe ser que se te quede viendo\ncon tanto detenimiento...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Cabe agregar además que se trata de alguien que lo hace mientras frota hacia\narriba y hacia abajo un lápiz...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Preparando tu obra para la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001743",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy haciendo una pieza de práctica para prepararme.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero se supone que no hay categoría de alfarería en la exposición, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001744",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay una categoría de objetos de arte.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Objetos de arte... Pues, ciertamente se podría presentar alfarería también...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Toritani sigue enfrascada en sus labores, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te ayudo?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001745",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace falta, no hay razón alguna para que me tengas que ayudar.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame levantarte la falda entonces.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_b01_06",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001746",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿P-Pero qué idioteces andas diciendo?! ¡T-Te estás comportando exactamente\nigual a Thomas!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna forma, yo soy distinto a Thomas. Él nunca le pide permiso a los\ndemás, ¿o sí? Yo sí lo hago. Te estoy pidiendo el favor ahora.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_b01_02",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001747",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No cuestión de pedir permiso o no, por Dios... Jaa, ¿además, por qué tanta\nfijación por las pantis?... A veces no logro entender esos arranques tan\nsúbitos tuyos...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si veo tus pantis quedaré en gran deuda contigo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001748",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Solo pides que te las muestre para quedar en deuda conmigo?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es solamente por eso.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_b01_01",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001749",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces... ¿Para qué?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hace falta preguntar eso? Las pantis son hermosas, son buenas, ¿o no? Y si\nllegaras a poner una tierna cara para mí al mostrármelas, sería muchísimo\nmejor.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_b01_06",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001750",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿U-Una tierna cara?...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, iré a echar leña al otro lado.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001751",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--, ni creas que te voy a mostrar mis pantis!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_b01_07",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001752",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué dices?!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Venga, no te enojes que te ayudaré.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Comienzo a meter la leña al fuego desde el lado contrario.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_b01_03",rule=139,vague=40,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001753",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001754",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Respecto a lo que hablamos hace un rato... tú...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Te refieres a las pantis? ¿Vas a mostrármelas?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_b01_02",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001755",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡De ninguna forma!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué se trata entonces?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001756",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Lo que dijiste hace un rato, frente al mural. Dijiste que supiste 'eso'\ncuando te convocaron a la oficina de la directora... Así que me preguntaba,\nsi también, te habló de algo más...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Se refiere al tema de que la directora y ella son madre e hija, supongo. A\nToritani le preocupa saber si la directora habló algo más referente a ella.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te preocupa eso?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001757",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo evitarlo... Jaa.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_b01_01",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001758",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La verdad es que me gustaría poder afirmar con toda seguridad que no me\nimporta, que no tengo interés por lo que ella haga o diga, pero...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las cosas no siempre salen como queremos.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001759",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿eres de los que les gusta limpiar y organizar su propia habitación?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y a qué viene eso de repente? Bueno, no me desagrada hacerlo, pero...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001760",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí tampoco.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues imaginaba que tenía que gustarte... Si no fuera así, no serías capaz de\nmantener tan organizado el desván de la sala de arte, aunque lo mismo se\npodría decir para la organización que llevas con las finanzas del club.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De cierta forma, el hecho de que puedas organizar lugar por lugar las cosas de\nla manera en que lo requieren y no únicamente por el bien de organizar es una\nespecie de talento. Me parece algo de admirar.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001761",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco es para tanto. Simplemente me repugna dejar problemas en el aire sin\nresolver. Por eso es que prefiero siempre resolverlos rápidamente y quitarme\nlos pesos de encima de una vez... solo eso.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno... para responder a tu pregunta, no hablamos tanto. Ah, pero después de\nque hablé con la directora, surgió algo que me causó curiosidad.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001762",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, me preguntaba por qué vives de manera tan austera, aun siendo hija\nde ella...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001763",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... Para ser sincera, quisiera cortar mi vinculo familiar legal con\nella...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no se escucha muy bien.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001764",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Absolutamente... y más aún con la manera tan fría en que lo digo... Sí...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Parece estar acomplejada por la manera en que su mismo comportamiento acentúa\nlos sentimientos de desacuerdo y conflicto con su madre...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001765",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ser posible, quisiera independizarme lo más rápido posible, pero aún soy una\nestudiante... Es justamente eso lo que me restringe de ser libre.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001766",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque lo mismo le sucede a los adultos. Quizás parecieran estar todo el\ntiempo haciendo lo que les da la gana, pero... a veces, no tienen casi\nlibertad de ser y actuar como quisieran.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ninguna libertad, eh...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001767",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, y eso los lleva a tramar cosas a escondidas, en las sombras. Kusanagi, tú\nmás que nadie debes saber eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001768",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Has llegado a vivir inmerso en ese huracán de intrigas y circunstancias que\nrodean a los adultos. ¿O me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001769",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, disculpa. Creo que volví a meterme de nuevo en lo que no debía... Volvamos\nal trabajo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Toritani, quien se estaba disponiendo a reanudar las labores, se detuvo.\nLevantó su cara, viéndome desde el otro lado del horno.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Me está observando ahora con una cara seria, muy probablemente preocupada de\nhaber hablado de más.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Y por eso, pongo una cara impasible y un tono de voz despreocupado, actuando\ncomo si nada hubiera sucedido, para entonces decirle lo siguiente a Toritani.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no me importa que hables de lo que quieras hablar.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_b01_03",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001770",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"La expresión de Toritani se relaja súbitamente.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Seguramente no suele mostrarle a los demás esa algo atontada cara, así, de esa\nmanera tan inconsciente.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Habla de lo que quieras hablar, sin tanta reserva. Solo relájate y saca todo lo\nque tengas adentro.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001771",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios, de verdad... Me dejas ahora a medio gas diciéndome eso, y de esa\nmanera...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así me gustas más, como una soda sin mucho gas.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001772",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tiene de bueno eso? A mí no me gusta.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
delay={
vl01={
{"bg",file="ev_com_b01_05",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
},
},
text={
vo={
{"vo",file="fem_mkd_001773",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No paras de decir puras tonterías... En fin, a trabajar un poco más, que ya\nterminamos.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_b01_04",sync=0,face=1,time=400,path=":ev/ev_com_b01/",set="ev_com_b01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001774",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te sirve una rosquilla de crema y una de miel como agradecimiento?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo no soy Kei!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"bgm",file="bgm009"},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? ¿Por qué tengo que salir por el portón trasero?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001775",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De verdad que aún no estás consciente de lo que sucede a tu alrededor. Eres un\nfamoso, una superestrella. Si llegas a salir por el portón frontal, tus\nfanáticas van a rodearte y no podrás salir.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001776",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, deja de hablar y ven.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"se",file="se9004",id=1},
{"fg",ch="真琴",speed=1000,mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",x2=0,x=-300,lv=4,id=9},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Estoy ahora en Quimera, pasando el tiempo sin hacer nada mientras me bebo el\nvaso de agua que una de las muchachas que trabaja a medio tiempo me trajo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Hay pocos de los siempre asiduos clientes adentro. Quizás estamos en esa hora\nen la cual no hay mucha gente.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001777",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo que agradecerte de alguna forma por haberme ayudado en el horno\nescalonado, pásate un momento por Quimera. No hay problema con que regreses a\ncasa antes de la cena, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"cgdel",id=-1},
{"bg",time=500,file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Por esa propuesta de Toritani es que terminamos viniendo a Quimera.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Con premura me trajo, con fuerza me sentó en el mismo asiento de siempre, y con\nprisa entró al fondo de la barra.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Aunque bueno...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"En lo que a mí concierne, me alegra un poco poder presenciar de nuevo la usual\nterquedad de Toritani...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Recuerdo lo que hablamos frente al mural, y luego en el horno escalonado.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Ya se ha disculpado conmigo numerosas veces. Y bastantes veces también estuvo a\npunto de perder la razón.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Así de acostumbrado estoy de ver a la Toritani de siempre, que el verla\ntambalearse en su manera de actuar me quita la calma... y me impide también\napartar la vista de ella.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y todo eso desde que...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Todo comenzó desde que esa directora empezó a involucrarse con el club de arte.\nDesde que eso sucedió, la manera usual de actuar de Toritani ha cambiado.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"La directora... y a la vez, la madre de Toritani... Al recordar la conversación\nque tuvimos en la dirección, se me viene a la mente esa astuta――",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001778",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sucede algo? ¿Por qué la cara molesta?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? Me estaba dando cuenta de que tengo algo de hambre.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001779",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿quizás te hubiera sentado mejor un gyuudon? Pero si vas a comer en casa,\nentonces no deberías comer tanto acá.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que voy a morir de no comer nada, pero mi estómago no es tan débil como\npara que un gyuudon tamaño mediano de Quimera me afecte en la cena.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001780",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? Para ser un chico, me parecía que comías relativamente poco, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso debería reclamarte yo a ti. Aun para ser una chica no comes nada.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001781",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'No es que voy a morir de no comer nada', y no hace falta que te preocupes por\nmí. Así que aquí tienes, y disculpa la espera.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Toritani pone un café y una torta sobre la mesa.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001782",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La torta es uno de mis prototipos, y el café salió de las muestras de granos de\nsiempre.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001783",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás esté un poco fuera de temporada, pero hice una chifón sakura.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú misma la horneaste?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001784",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es. Aún no he logrado obtener el acabado que quisiera... Pero, planeo\nseguir probando una y otra vez para poder incluirla de manera formal en el\nmenú de la próxima primavera.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Esa actitud y postura dedicada que demuestra al crear sus postres es la misma\nque vi en ella al trabajar con su obra en el horno escalonado. Toritani\nsiempre actúa con seriedad y dedicación en lo que emprende.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nunca paras hasta que das con algo con lo que te puedas sentir satisfecha, eh.\nY no solo en la alfarería.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001785",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Aunque, ¿no es eso lo normal? Crear y crear hasta obtener algo con lo\nque te puedas sentir satisfecho.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La voluntad de esforzarse y la tenacidad son talentos de por sí. Me parece\nasombrosa la capacidad de concentración que tienes, y esa perseverancia tuya\nque no te deja parar hasta obtener un resultado satisfactorio.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001786",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿D-De... verdad? Está bien. Supongo que aceptaré el cumplido esta vez...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001787",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, estás mansita hoy, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001788",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No está de más que lo esté de vez en cuando! ¡¿No?! ¡Vamos, tómate el café\nantes de que se enfríe!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo siento. En fin, buen provecho.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"Tomo del café, y como la torta.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Su textura es esponjosa, y se siente húmeda al paladar, con un buen aroma\nademás.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"El café era de esos riesgosos y peligrosos granos que envía la dueña desde\ndistintas partes del globo. Sin embargo, esta vez combinaron perfectamente\nbien con la torta chifón.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001789",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué alivio.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de poca era la confianza que tenías en tu creación?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001790",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Ya las muchachas de medio tiempo me habían dicho que estaba deliciosa, y\nnuestros clientes de mayor confianza también me dieron su buen visto.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001791",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque sabía que tu 'está bueno' sería prueba de que el platillo le agradará\nal paladar de muchos más. Aun a pesar de que cocinas y tienes tus\nparticularidades en la cocina, tu paladar no es tan quisquilloso que digamos,\nKusanagi. En el buen sentido.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me veo a mí mismo como un portador de gustos relativamente corrientes y nada\ndesviados. ¿La taza de café y el plato son nuevos también?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001792",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, vaya que te diste cuenta. Pronto vendrá otro cambio de temporada, así que\npensé en ofrecerle un toque más suave a los labios de los clientes...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001793",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La torta chifón es algo grande, así que pensé en servirla en un plato especial\npara ella. En lo que a colores se refiere, tengo el mismo blanco de siempre,\ny tengo otros platos de verde para combinar con los cerezos.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"El plato de tarta que tengo frente a mí ahora es blanco... Es el blanco Usagiko\nque Toritani maneja tan bien. De por sí es ya maravillosa esta pieza, pero me\nencantaría ver también el plato verde.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiera ver el plato verde también... ¿Podría?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001794",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo problema, pero... ¿quieres que mueva la torta chifón al nuevo plato?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías poner otro pedazo y comerlo tú, se supone que es solo un prototipo,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001795",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un pecado capital ofrecerle torta a una chica en estas horas. Espera un\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"se",file="se9012",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani devolvió la torta chifón a medio comer a la bandeja, y desapareció en\nla cocina al fondo de la barra.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Creo que le di más trabajo ahora...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Sin embargo, se trata de la nueva pieza de Hakushuu Usagiko. No aguanto las\nganas de verla.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"El café está delicioso también, y este ambiente de calma que se respira en\nQuimera hace que la espera no se sienta agobiante.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001796",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí está, disculpa la espera.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Discúlpame a mí por el trabajo extra.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001797",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Como creadora, no se siente nada mal que alguien que se la pasa todos sus días\ncon cara desinteresada y aparentemente sin mucha motivación como tú muestre\ninterés en mis piezas, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",id=1,file="se_koton"},
{"text"},
text={
ja={
{
"Un ligero sonido se escucha al caer el plato de torta sobre la mesa.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"El tamaño del plato es ligeramente grande, ajustado para las tortas chifón,\npero aun así no siento nada de pesadez en ella.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues vaya que cambia la impresión con el color del plato, eh.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001798",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, los platos de color blanco aprovechan el tierno rosado de la torta chifón y\ndan un simple, pero suave aire soñador, como el que emanaría de un libro de\ndibujos infantiles...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001799",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por otro lado, este plato fue diseñado con una imagen nipona en mente, de\nmanera que la impresión que de al colocar la torta chifón encima sea la de un\nsakura mochi.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0012",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001800",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La cocina se basa en los cinco sentidos, así que aun teniendo el mismo sabor,\nes posible que lo percibas de manera distinta teniendo ahora una coloración y\ntextura diferente en el plato. Toma un bocado.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso haré.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Me llevo un bocado a la boca, tal como Toritani me lo sugirió. La suave y\nhúmeda textura de la chifón no ha cambiado... pero...",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se siente el aroma del sakura mochi, o no, tal vez... ¿el gusto?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001801",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El mismo sabor se lo di al momento de hacer la mezcla. En el caso de la torta\nde chifón con té negro, se agregan hojas de té negro a la mezcla y se amasan.\nDe esa misma manera, agregué hojas de cerezo saladas y finamente trituradas a\nla mezcla.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001802",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen que un plato no está completo sino hasta tener el manjar encima. Yo\ntambién pienso igual... Es divertido ver cómo también influye en el paladar\nde quien come, así como ahora.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001803",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen que es el marco de un cuadro lo que cambia la impresión de la pintura,\n¿no? Es lo mismo en este caso. El plato cambia la impresión del manjar.\nCambia nuestra percepción de su aroma y su sabor...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta taza de café también es nueva, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001804",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, le cambié el grueso, aunque solo un poco. Alteré también un poco la textura\nde la asa y la taza como tal...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001805",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Da la imagen de quedar muy bien con una espesa sopa o un reconfortante\nchocolate caliente en otoño o invierno, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001806",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun en su propia tierra natal, este café se caracteriza por su muy refrescante\nsabor, así que quizás tomarlo de una taza de forma más nítida y definida\npodría acentuar la verdadera esencia de ese sabor...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001807",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé que quizás, para servir a estas horas, se daría mejor una atmósfera un\ntanto más relajada y serena, así que aproveché la presentación de mi nuevo\npostre para estrenar la taza.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001808",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por cierto, puedo garantizar que lo fácil que es de limpiar la hace\nespectacular para usarse en locales de café.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Sí, ciertamente, la textura de esta taza al toque de la mano es muy buena.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"La tierra y piedras para esmalte cerámico que trae la dueña en sus viajes por\ntodo el país junto a las propias recetas de Toritani, hacen que la coloración\ny textura de sus piezas de cerámica sean únicas, lo cual da a entender por\nqué hay tantos fanáticos tan entusiastas de esta marca.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, también colocaste un anuncio preliminar de su venta en\ntus sitios web de manualidades, ¿no? La silueta que salía allí era la misma\nque esta taza. ¿Planeas sacarla al mercado?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0029",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001809",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“V-Vaya, la revisas constantemente... Sí, así es. Esta taza tiene esa cálida\nsensación que podría agradarle a las personas en otoño, así que podría tomar\npopularidad. Esta es la época para subir las ventas.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fabricas y experimentas con distintas piezas para la Exposición Moore, trabajas\ncomo artista alfarera, y además estás creando nuevos platillos para Quimera.\n¿No estás como que trabajando demasiado?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001810",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro que no. Estoy tomando las horas de sueño necesarias, y también tengo\ntiempo para estudiar, repasar y adelantar el contenido de las clases.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001811",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es tan difícil administrar el tiempo, siempre y cuando hagas solo lo\nestrictamente necesario en el día.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001812",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Intenta armar todas tus tareas del día sin dejar hueco alguno, como si fueran\nbloques de L*GO. Incluso tú deberías poder hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Bloques de L*GO...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que pueda aguantarlo.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001813",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno... en tu caso, tienes suficiente resistencia física y fuerza\nexplosiva, así que quizás se te dé mejor hacer las cosas a última hora y de\nuna sola vez, sin dormir... La verdad es que no te puedo imaginar armando un\nhorario y cumpliéndolo al pie de la letra.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se podría decir que vivo de momento a momento, sin pensarlo mucho.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001814",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No creo que sea tampoco así... Aunque, por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Toritani pone una expresión pensante, aún con la bandeja en su mano.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001815",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La torta era solo un prototipo, y además me diste tu opinión después de comer,\nasí que esto no sirve todavía de agradecimiento por la ayuda que me diste en\nel horno escalado.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que traigas el asunto de las deudas acá.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0006",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001816",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo permitirme hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, muéstrame entonces tus pantis.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001817",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Otra vez de nuevo con eso?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Toritani responde en un tono estupefacto, pero sin enojarse.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001818",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace un tiempo tuvimos una situación parecida acá mismo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo recuerdas aún? Ya juraba que lo habías olvidado.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001819",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo he podido olvidar... Es uno de los episodios tuyos más impactantes que he\npresenciado, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, quedé decepcionado, lo admito, pero también estuvo realmente bueno. Si tan\nsolo, hubieras levantado un poco la falda así... se hubieran visto tus\npantis.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ver las pantis que se asoman por debajo de tu falda mientras pones una cara\nde vergüenza... En una situación así tus pantis pasarían de ser un simple\npedazo de tela a ser un objeto divino y especial.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001820",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pantis, más pantis, ¿es que acaso tienes alguna agnosia que solo te\ndeja ver pantis?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001821",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... aunque no lo niego, a mí también me parece que las pantis son\nespeciales.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿de verdad?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"No llegué a pensar que Toritani pudiera entenderme. Sin pensarlo me inclino\nhacia ella.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0900",face="d0001",head="mak_z2d",lv=5,id=9},
{"quake",mode="mw"},
{"se",file="se3214",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pudiste entender cómo me siento?! E-Entonces--”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0018",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0005",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001822",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto que no. Las pantis son especiales, y por eso no se muestran\nsino a esa persona especial, y con un motivo especial. Eso fue lo que quise\ndecir.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"El muro que cubre las pantis fue más grueso de lo que pensaba. No, en este\ncaso debería ser el muro de la falda. Esa falda es un muro impenetrable de\ngrueso acero.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame entonces dibujarte desnuda.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0013",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001823",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Por qué pasas de las pantis a un desnudo?! ¡Estás aumentando aún más el\nnivel de dificultad!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijiste que las mostrarías de tener algún motivo especial.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0006",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001824",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Una panti y un dibujo al desnudo no tienen nada que ver, y además, de\nninguna forma haría eso!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Umuh, parece que no funcionó. Qué lástima...",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0006",head="mak_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo bromeaba. En general trato siempre de no llevar esa clase de impulsos a la\nhora de dibujar.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001825",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun no dejas de negar en todos sus aspectos a Renoir, eh.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso. Cualquiera que conozca algo de historia de la pintura sabe que la\nsensualidad y el arte están fuertemente unidos entre sí. Solo que en mi caso,\nno puedo llevar la sensualidad a mi arte.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001826",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0910",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001827",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás ocultando algo. ¡Tienes alguna razón oculta, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay, no hay ninguna razón. Soy virgen, solo por eso es que no puedo hacer\ndibujos al desnudo.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001828",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa, no te cansas de mentir. Es imposible que después de haber sido educado y\nentrenado de forma especializada por el mismísimo Kenichiro Kusanagi no hayas\ndibujado desnudos jamás.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, de que los he hecho los he hecho, pero los modelos han sido siempre\npersonas desconocidas... Y además, para mí dibujar desnudos es, más que todo,\nuna labor mecánica.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001829",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Otra mentira más. Tus dibujos no son los de alguien que solo hace las cosas de\nmanera mecánica. Hay que tener demasiados detalles en mente como para poder\ndibujar de esa manera la expresión y el interior de las personas.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto, no lo niego, he tenido que dibujar a los modelos de una forma que\naparentemente pareciera expresar su interior, y eso como uno de los elementos\nque componen la obra completa. Pero reitero, solo como un elemento más del\ncompuesto final. Jamás he dibujado realmente el verdadero lado interno de los\nmodelos.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001830",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás tratando de decir? No entiendo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es muy famosa la historia del pintor impresionista Edgar Degas, y de cómo sus\nobras reflejaban el interior de sus modelos, dependiendo de la expresión que\nles dibujara.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese ojo tan agudo y observador de él llegó incluso a enfurecer a su amigo,\nManet.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001831",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, conozco ese cuadro. 'Édouard Manet y su mujer'. Degas le envió la obra a\nManet como un regalo, pero Manet terminó arrancando la parte del lienzo donde\nsalía su esposa tocando el piano.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, así que lo conoces. La parte de la señora Manet tocando piano quedó como\nun misterio para toda la eternidad, pero dicen que el agudo ojo de Degas fue\nla razón, habiendo plasmado en el cuadro el estado de la relación entre la\npareja en sus expresiones faciales.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así de perspicaz era el ojo de Degas.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, y para darte un ejemplo, a pesar de toda la sensación de presencia\ny realismo de la cual gozaba su obra representativa, 'La clase de danza',\neste no llegó a dibujar realmente una verdadera clase de danza.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Degas dibujó modelo por modelo, todas separadas, y luego las unió cuidadosa y\nminuciosamente en una sola pintura.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La obra transmite ese ambiente único que se respira en la clase de danza. Se\npueden ver algunas muchachas viendo al instructor con cierta tensión y\nrigidez. Otras hablando, otras aburridas, mientras que la muchacha más al\nfrente se rasca la espalda sin prestarle atención a una sola palabra del\ninstructor.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ese ambiente no lo reprodujo simplemente en base a lo que sintió.\nTodo fue creado de manera calculada.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001832",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir entonces?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mis dibujos son bastante mecánicos, y muy calculados, así como los de Degas.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001833",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿quieres que te enseñe una de tus mañas?”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa? C-Cambiaste súbitamente de tema, eh.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001834",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estoy cambiando el tema. Es más de lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001835",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre que mientes te pones a pensar de inmediato, y en eso se te frunce el\nceño.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, eso es porque estaba en medio de la explicación, y...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001836",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A nadie se le frunce el ceño al explicar algo, siempre y cuando sea algo\nproducido naturalmente. Se nota a leguas que estás mintiendo.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es ninguna mentira.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001837",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy completamente segura de que tienes otra razón para rechazar el hecho de\nque haya alguna relación entre modelo y pintor. ¿Me equivoco? Desde que pasó\nlo de Renoir y Thomas me ha dado esa fuerte sensación.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso no es... cierto.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001838",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmmm. ¿Será verdad lo que dices?”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy mintiendo, de verdad.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001839",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien entonces, dejémoslo así.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani pone una pequeña bolsa de papel frente a mí.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y esto?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001840",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rosquillas de crema y de miel. Me acordé de ellas cuando las mencioné hace un\nrato, así que aproveché de paso para hacer unas cuantas. Dáselas a Kei.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Al abrir la bolsa, sentí el dulce aroma de las rosquillas recién freídas.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001841",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ha estado esforzándose bastante para la Exposición Moore, son unas provisiones\npara darle ánimos.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Esto no lo hizo solo 'de paso'... Al abrir la bolsa, le digo a Toritani...",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dáselos tú.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001842",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo que trabajar, no puedo.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías acercarte un momento a la casa, ¿no? No hay muchos clientes hoy.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001843",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo dije, soy una especie de jefa de piso acá, algo así como la\nrepresentante de la dueña. Si hiciera eso le causaría problemas a las\nmuchachas que están en su turno, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_bit_000008",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Eh～, a mí no me molesta～, puedes ir sin ningún problema, Makoto-san～ Has\nestado trabajando demasiado～”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, así es～”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Asiento fuertemente en aprobación ante el oportuno apoyo de la muchacha de\nmedio tiempo. No conozco tu nombre, pero gracias igual, muchacha de medio\ntiempo.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes pasarte por un ratito a la casa de los Natsume, quedarte a cenar, y\nluego regresar. Sí, perfecto, bien, vámonos.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0014",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"fgact",ch="真琴",act="icon",lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001844",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, esp--, espera!”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"Toritani me llama con una voz exaltada, tratando de detenerme mientras yo\nintentaba salir de Quimera sin siquiera haber agarrado la bolsa de las\nrosquillas.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fgact",ch="真琴",act="停止",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0007",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001845",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Está bien, ya entendí, por lo menos espera mientras me cambio!”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"se",file="se9010",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani desaparece al fondo del local, murmurando 'Por Dios'. Y mientras\ntanto, la muchacha de medio tiempo y yo nos alzamos los pulgares el uno al\notro. Esta muchacha es buena compañera de tretas.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"Toritani ha estado trabajando demasiado. Y además, esta noche no hay casi\nclientes. Esta es la oportunidad perfecta para ponerla a descansar un rato.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_01_3"},
{"text"},
linkback="block_00307",
},
label = {
top={block="block_00000",label=1},
},
}
