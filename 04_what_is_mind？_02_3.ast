{"fg",mode=-2,sync=0},
{"bg",file="bg001b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",lv=4,id=9},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000643",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Otra vez ese estruendoso ruido!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000644",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Mizuna nee-sama! ¡Ha venido de nuevo! ¡El profesor vino a la casa!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x2=0,x=-345,lv=4,id=9},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000078",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Que lo hayas visto no es excusa para que lo traigas... Ai-chan.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",stop=1,time=500,id=1},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0021",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000645",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Jaa?! ¡Demonios, fui yo quien lo trajo hasta acá!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000224",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ajajaja, gracias, Ai-chan.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0019",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000646",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y-Y me está dando las gracias ahora... Mizuna nee-samaaa...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000079",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Está bien, está bien. Tú no tienes la culpa, Ai-chan. No pongas esa cara.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_kid_000225",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Buenas...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000080",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Día tras día lo mismo. Es usted realmente terco, profesor...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0006",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000647",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Terco! ¡Profesor, terco!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_kid_000226",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ai-chan, después te dibujaré algo, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0004",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000648",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿En serio? ¿Qué me dibujarás ahora? ¿Mick*y? ¿Hello K*tty?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_kid_000227",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, pero después. Cuando estemos en un lugar seguro. Lo que me pides es\npeligroso en términos de copyright.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0004",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000649",ch="aid"},
},
ja={
{
name={"Ai"},
"“Waaah. ¡Profesor, qué buena persona eres!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0017",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000081",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y ahora amansando a niños...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_kid_000228",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso de amansar a niños no se escucha muy bien.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000650",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿¿Mm?? ¿Qué es amansar?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000082",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Intentar ganarte tu confianza con dibujos para luego tomarte de sorpresa,\nAi-chan.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000651",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0021",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000652",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Rayos! ¡Rayos y rayos! ¡Han tomado de sorpresa a Ai! ¡La han tomado mucho!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うんうん",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000653",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Profesor! ¿Cómo tomaste de sorpresa a Ai?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0016",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000083",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ganando tu confianza y aprovechando tus descuidos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0018",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000654",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nununuh... No puedo descuidarme con el profesor.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_kid_000229",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Puedes bajar la guardia conmigo, no hay problema. Toma este Rilakk*ma que\ndibujé. Mira nada más, lo hice estampita.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0004",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000655",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Waaah, Rilakk*ma! Es una estampita de Rilakk*ma. ¡Genial, es tan parecido, es\ntan lindo!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0015",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0017",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000084",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“*Fiuu*... Dios.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000656",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=9},
},
vl03={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0019",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000657",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-No me hace falta... No voy a, recibir nada... del profesor... N-N-No, lo...\nnece... sito.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Se está muriendo por tenerlo...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Aunque sí, soy bueno haciendo reproducciones. Creo que quedó muy bien...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0016",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000085",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No te preocupes, Ai-chan. El profesor se tomó el trabajo de dibujarlo para ti,\nrecíbelo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000658",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿Me lo puedo quedar? ¿Puedo quedarme con este osito tan parecido a\nRilakk*ma?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000086",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000659",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Pero el profesor quiere hacerme bajar la guardia, ¿verdad? Va a bajar\nbastante mi guardia, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000087",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No importa, Ai-chan. La culpa de todo la tiene el profesor por intentar meterte\nen su guerra psicológica.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000660",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿El profesor es quien tiene la culpa?!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_kid_000230",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, tal vez. Aunque, créanme que lo hago para volverme amigo de ustedes.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000661",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Amigo? Profesor, ¿quieres ser nuestro amigo?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_kid_000231",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, quiero ser su amigo, y que nos llevemos mejor.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000662",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo... pero, Mizuna nee-sama. No debería...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0018",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0017",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000088",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Dios mío, pero qué manera de manipular el corazón de una niña... Usted es\nrealmente maquiavélico.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000663",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Manipular el corazón? ¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000089",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Hacerte bajar la guardia, Ai-chan.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0017",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000664",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Wah! ¡¿Otra vez?! ¡El profesor baja la guardia de Ai a cada rato! ¡Y otra y\notra y otra vez! ¡Esto es un problema para Ai!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_kid_000232",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ai-chan, yo jamás haría algo que te cause problemas.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0001",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000090",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Pero ha amansado a Ai-chan, ¿no es así? Y bastante.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000665",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Bastante?!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_kid_000233",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, bueno, ¿y por qué no? Quiero complacer a Ai-chan, después de todo. Tanto\ncomo sea necesario.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000666",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Quieres complacer a Ai?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_kid_000234",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0018",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000667",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, eso me alegro un poquito, creo... Uhmmm, eso es un problema.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_kid_000235",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué parte de lo que dije podría traerte problemas?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000668",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Profesor! ¡Es muy difícil saber si eres malo o bueno! ¡Elije un lado!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_kid_000236",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Malo no soy.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000091",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Es malo.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000669",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Así que sí eras malo!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2i0000",face="i0005",head="aix_z2i",x=0,lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Ai se pone en posición para golpear.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000237",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡E-Espera, todo menos un puñetazo allí!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0010",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000092",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“*Fiuu*... era solo una broma, Ai-chan.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2i0000",face="i0012",head="aix_z2i",x=0,lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000670",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Era una broma?!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000671",ch="aid"},
},
ja={
{
name={"Ai"},
"“Qué raro ver a Mizuna nee-sama bromeando.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kid_000238",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Es raro?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000672",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mizuna nee-sama es muy seria. Normalmente no bromea.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0012",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000093",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“E-Eso no es cierto. A veces lo hago...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_kid_000239",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Te dieron ganas de bromear teniéndome acá?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0005",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0018",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000094",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por qué... debería?... Santo cielo, usted es todo un caso...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_kid_000240",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo lamento, así es mi personalidad.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0015",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0017",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000095",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Fuh... cielos, mire nada más lo mansa que está Ai con usted... Deberían darle\ncargos por pornografía inf*ntil.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000241",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Yo no veo a esta niña con ojos sexuales!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000673",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué son los ojos sexuales?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0018",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000096",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No necesitas saberlo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000674",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es verdad, profesor?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_kid_000242",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, aún es un poco pronto para que lo sepas, Ai-chan.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0017",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000675",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Secreto de los dos~?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0001",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000097",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“A final de cuentas no lo odias, ¿verdad, Ai?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000676",ch="aid"},
},
ja={
{
name={"Ai"},
"“No. A Ai le agrada el profesor. ¿Pero a ti no, Mizuna nee-sama? Si es así...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000098",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Tranquila. No me desagrada tampoco...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000677",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio? Pensé que odiabas mucho al profesor, Mizuna nee-sama.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0018",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000099",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Me hubiese gustado que así lo creyera, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kid_000243",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si realmente me odiaras yo no sería tan insistente.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0017",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000100",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Cuesta creerlo...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0001",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000101",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Se lo advierto, nada bueno le vendrá relacionándose con nosotras.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_kid_000244",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo sé. Por eso la actitud tan fría en la residencia, ¿verdad? Aun con lo bien\nque nos llevamos en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000678",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mizuna nee-sama, ¿te llevas bien con el profesor en el colegio?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0010h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000102",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“T-Tampoco es que nos llevamos tan bien...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0006h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000103",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Se lo advierto, profesor! ¡No responderé por lo que pueda pasar!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_kid_000245",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo sé, ya te lo dije. No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",mode=-2},
{"fg",ch="水菜",size="z2",mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0400",face="a0008",head="miz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000104",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“... Pero quiero que me prometa algo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_kid_000246",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Prometer algo?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0009",head="miz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000105",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Que si en algún momento llega a verse en una situación terrible por\nrelacionarse con nosotras, huirá de inmediato.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_kid_000247",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo prometo.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0015",head="miz_z2a",lv=5,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000106",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Será eso verdad?...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_kid_000248",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué desconfiada, eh. ¿Me veo como el tipo de hombre capaz de sacrificarse en\nsituaciones de peligro por los demás? Obviamente no, soy más del tipo que\nhuiría de inmediato, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0005",head="miz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000107",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Habría que ver quién inspira más desconfianza en ese caso...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_kid_000249",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, eso no importa.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0018",head="miz_z2a",lv=5,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000108",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Dios santo, no puedo creer que lo dejaré entrar a casa...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_kid_000250",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eh? ¿Me vas a dejar entrar?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0005",head="miz_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0006",head="miz_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000109",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Molestaremos a la gente del vecindario si nos quedamos hablando acá. ¡Y\nhablando de molestia, todos los días trae con usted esa ruidosa motocicleta!\n¡¿Pero qué tiene en la cabeza?!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="man_kid_000251",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa ruidosa motocicleta no... bueno, sí, es viejita...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0017",head="miz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000110",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Qué ganas de molestar, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_kid_000252",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No, no son ganas de eso. Solo que, bueno, es el sueño secreto de cada hombre\ntener una motocicleta así.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0400",face="a0018",head="miz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000111",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Realmente es de lo peor usted.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000679",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡De lo peor!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_kid_000253",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La próxima vez vendré caminando...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bg",time=1000,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Desde ese día logré cruzar la puerta del Umoreginoya.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Obviamente ellas tampoco la llamaban así, así que le llamaban 'la residencia\nKootoha', en base al nombre de la zona.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Solo Mizuna y Ai vivían en la residencia Kootoha.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Al parecer habían personas de servicio entrando de vez en cuando a la casona,\npero por lo general, la residencia era solo para ellas dos.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2i0000",face="i0004",head="aix_z2i",lv=5,id=5},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000680",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Profesor, cuéntame otro cuento improvisado!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kid_000254",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Claro que sí!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_kid_000255",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hace mucho, mucho tiempo～, en una montaña～♪”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"En esta casa no había nada para entretenerse.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"En contraste a lo espacioso de la residencia, era poco lo que había adentro.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Ai esperaba con ansias todos los días por el cuento infantil que le dibujaba\nmientras cantaba.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"En todo el tiempo que pasé visitando esta casa, casi nunca llegué a ver alguien\nvisitándola.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Jamás vi a algún amigo de Mizuna venir, menos aun a alguno de Ai.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Lo único que venía era la ocasional correspondencia.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"En esta casa casi nunca sonaba el timbre.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"A pesar de eso, Ai nunca llegó a decir 'me siento triste' o 'no me siento\nfeliz'.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Así como Mizuna, Ai me pareció una muchachita fuerte.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Y considerando esa personalidad suya, es probable que realmente se moría todos\nlos días por tenerme en casa.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"A pesar de tener solo a una pequeña espectadora, me divertía dibujándole.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Pintar para alegrar a los demás. Una alegre sensación tan simple y normal que,\nno obstante, creo yo, había olvidado.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",mode=-2,sync=0},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"extrans",time=300},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0400",face="a0001",head="miz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000112",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Usted verdaderamente tiene talento para contar historias, profesor.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="man_kid_000256",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿En serio? ¿Te entretuvo mi cuento?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000113",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="man_kid_000257",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué bueno saber eso.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"msgoff"},
{"bg",file="eveningsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"De un momento a otro pasé de tener uno a dos espectadores.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Lo único que podía hacer era pintar. Y así hice, dibujando para las dos.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Y les conté relatos.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"No de los aburridos sucesos del mundo real.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Sino relatos de la imaginación. Y así, mientras contaba, transmutaba esas\nhistorias en dibujos frente a ellas.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"'Yo no naka wo, Yoso ni mitsutsumo, Umoregino umoreteoramu, kokoronakimi ha'",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Este es el poema que originó el término 'Umoreginoya'. Fue compuesto por Ii\nNaosuke.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Significa algo así: 'Enterrado, como árbol olvidado, alejado de todo como un\nermitaño, pero sin el corazón sepultado'.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Considerando la clase de lugar en el que vivían, me pareció mejor darles\ndivertidos relatos imaginarios.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Los días pasaban con normalidad.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Era tanta la paz con la que transcurrían que casi olvido mi enemistad con Saki,\ny lo mucho que Mizuna se vio renuente a aceptarme en la residencia.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bgm",stop=1,time=3000},
{"text"},
text={
ja={
{
"Pero esos días de tranquilidad no duraron.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Esta es la residencia que los Nakamura llamaron 'Umoreginoya'.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Los días de paz no eran sino una efímera realidad.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bgm",stop=1,time=500},
{"excall",file="04_what_is_mind？_02_4"},
{"text"},
linkback="block_00223",
},
label = {
top={block="block_00000",label=1},
},
}
