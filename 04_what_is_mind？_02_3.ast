astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"bgm",file="bgm109"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg058b",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="紗希",size="z2",zoom=70,mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2d0000",face="d0001",head="sak_z2d",y=-144,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000188",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fui al Umoreginoya.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El sol estaba poniéndose por las ventanas de la sala de profesores.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Después de confirmar que no había más nadie adentro, llamé a Saki.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000042",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Cómo... diste con ese lugar?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_kid_000189",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me disculpo de antemano por haber espiado. Vi el nombre ayer en los archivos\nque estabas revisando...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0007",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0009",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"fgact",ch="紗希",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000043",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Te aprendiste el mapa en ese corto instante? *Fiuu*, definitivamente esa\nhabilidad tuya para aprender figuras es impresionante...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_kid_000190",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No es que me lo haya aprendido todo. Sucede que ya he ido varias veces a\nKootoha.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0011",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000044",ch="skd"},
},
ja={
{
name={"Saki"},
"“Y bien, ¿qué quieres saber?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_kid_000191",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué le llaman Umoreginoya a esa residencia?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0010",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
},
},
text={
vo={
{"vo",file="fem_skd_000045",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Y de verdad crees que te voy a decir por qué? Creo habértelo advertido ayer.\nNo te metas en los asuntos de los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_kid_000192",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Umoreginoya no es el nombre que le dan a las casas donde viven niños\nilegítimos?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_kid_000193",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El término lo originó el Tairo de los últimos años de Edo, Ii Naosuke.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_kid_000194",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ii Naosuke, también hijo ilegítimo y viviendo en una residencia para niños no\nreconocidos, denominó la casa como 'Umoreginoya. Desde entonces, el término\nse ha usado para referirse a residencias usadas para alojar niños ilegítimos.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_kid_000195",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hijos ilegítimos. En pocas palabras, los Nakamura han usado esa mansión para\nalojar a todos sus hijos nacidos fuera del matrimonio. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0011",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000046",ch="skd"},
},
ja={
{
name={"Saki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_kid_000196",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Saki, ¿por qué estabas tan cabizbaja cuando estabas frente a ese mapa?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0004",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000047",ch="skd"},
},
ja={
{
name={"Saki"},
"“Eso es porque...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_kid_000197",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hay algo que te inquieta en esa residencia, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0006",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"fgact",ch="紗希",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000048",ch="skd"},
},
ja={
{
name={"Saki"},
"“¡Kusanagi-kun, esto es algo grave! No es la clase de asunto en la que deberías\nmeterte.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_kid_000198",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Nada tiene que ver si es algo grande o pequeño. Tú eres la legítima esposa del\npróximo jefe de la familia Nakamura, ¿qué hacías viendo con tanta inquietud\nun mapa con el lugar de la residencia de sus hijos ilegítimos?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0004",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"fgact",ch="紗希",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000049",ch="skd"},
},
ja={
{
name={"Saki"},
"“No es la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_kid_000199",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo. Así que pretendes hacerte la tonta ahora...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000050",ch="skd"},
},
ja={
{
name={"Saki"},
"“Kusanagi-kun, ¿estás consciente de tu posición? Eres un profesor de un colegio\nadministrado por la familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_kid_000200",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, lo soy. Pero no solo soy profesor de este colegio, soy profesor de esa\nmuchacha también.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0010",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000051",ch="skd"},
},
ja={
{
name={"Saki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_kid_000201",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No sé qué papel tengan los Nakamura en esto, pero a mí no me concierne.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"fgact",ch="紗希",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000052",ch="skd"},
},
ja={
{
name={"Saki"},
"“Fuh, de verdad que me descuidé. Quién diría que te aprenderías ese mapa en\ncuestión de segundos...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0010",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000053",ch="skd"},
},
ja={
{
name={"Saki"},
"“Sí, todo es exactamente como lo has dicho. En esa residencia conviven los hijos\nilegítimos de los Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0013",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000054",ch="skd"},
},
ja={
{
name={"Saki"},
"“Y es además...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Saki prosigue con lo que iba a decir.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0004",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000055",ch="skd"},
},
ja={
{
name={"Saki"},
"“Y sirve además, para criar a las muchachas que servirán como sus amantes en un\nfuturo...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_kid_000202",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Convierten... a las hijas de sus amantes en nuevas amantes?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"En pocas palabras, los Nakamura usan a los hijos de sus amantes como nuevas\namantes. Para eso han estado usando la residencia.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Eso es absurdo. ¿Cómo puede ser eso posible?",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Alzo mi voz.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000203",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡¿Por qué hacen eso?! ¡Eso no es normal!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_kid_000204",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Ni siquiera la ley lo permite!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000056",ch="skd"},
},
ja={
{
name={"Saki"},
"“Y por eso te digo que no subestimes el poder de los Nakamura. Es ese mismo\npoder lo que les ha permitido cometer esas aberraciones.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_kid_000205",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Pero hacer amante a tus propias hijas... es ridículo, no es normal!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0008",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
},
},
text={
vo={
{"vo",file="fem_skd_000057",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo tampoco conozco el motivo..., pero, por alguna razón, los Nakamura se\npreocupan por mantener su sangre fuerte.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_kid_000206",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por mantener su sangre fuerte?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0015",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000058",ch="skd"},
},
ja={
{
name={"Saki"},
"“Incluso la caída que sufrieron puede ser resuelta manteniendo esa sangre\nfuerte... o al menos eso creen ellos... Usándola para revivir la sangre de\nHakuki...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_kid_000207",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No entiendo todavía bien lo de la sangre y eso, pero si lo que dices es\ncierto, entonces Mizuna y esa muchachita Ai son...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0008",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000059",ch="skd"},
},
ja={
{
name={"Saki"},
"“Así es. Esas dos muchachas han sido criadas para convertirse en las amantes de\nlos hijos legítimos de los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000208",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Maldita sea, Saki! ¡¿Cómo puedes estar tan calmada?! ¡Esas muchachas podrían\nterminar como las putas de tu gente!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0009",head="sak_z2d",y=-144,lv=5,id=9,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_skd_000060",ch="skd"},
},
ja={
{
name={"Saki"},
"“Podrían... Hubiera sido mucho mejor eso, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000209",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡¿---?!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",mode=-2,sync=0},
{"bg",y=80,x=0,zoom=80,speed=200,file="zbg058b",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="紗希",size="z2",zoom=100,speed=200,mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",y2=-144,z2=70,y=0,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",file="se3130",id=1},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kid_000210",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Saki, imbécil! ¡¿Qué estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Tomé a Saki por el cuello de su camisa.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0004",head="sak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000061",ch="skd"},
},
ja={
{
name={"Saki"},
"“Soy una Nakamura. Todo Nakamura debe seguir las tradiciones de la familia...\nindependientemente, de lo que eso implique...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_kid_000211",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Tradiciones?...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2d0000",face="d0005",head="sak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000062",ch="skd"},
},
ja={
{
name={"Saki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Le lanzo una feroz mirada a Saki. Sin embargo, esta no se inmutó ni un poco,\nmanteniendo el contacto visual conmigo.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000212",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"*Tch.*",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"se",file="se9010",vol=40,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg058b",path=":bg/",sync=0},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",lv=4,id=9,sync=0},
{"extrans",time=400},
{"text"},
text={
ja={
{
"La dejo ir.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_kid_000213",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tienes suerte de ser mujer. Si fueras un hombre ya estaría golpeándote.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0004",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000063",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Eso crees? La verdad es que jamás me había sentido tan frustrada de ser mujer\ncomo ahora...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_kid_000214",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“... Saki.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000064",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ser mujer... Sí, vaya que es duro.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_kid_000215",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000216",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="black",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me doy la vuelta para irme.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_kid_000217",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Protegeré a esas muchachas...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_kid_000218",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque eso signifique convertirme en tu enemigo.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_skd_000065",ch="skd"},
},
ja={
{
name={"Saki"},
"“Lo sé...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_skd_000066",ch="skd"},
},
ja={
{
name={"Saki"},
"“Desde que conociste a Mizuna... supe que... esto terminaría así.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_skd_000067",ch="skd"},
},
ja={
{
name={"Saki"},
"“Así que deberías verme como enemiga de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000219",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡No hace falta que me lo digas!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Dejé atrás la sala de profesores mientras el sol se iba hundiendo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",rule="083r",vague=40,file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000220",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Mierda!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000221",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Maldita sea!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"¿Por qué estoy tan agitado?",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"¿Qué es lo que me tiene así?",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"¿Es que acaso creía que Saki permanecería de mi lado pasara lo que pasara?",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"No jodas.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Debí haber entrado en cuenta el instante en que vi a esas muchachas en esa\ncasona.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"De cómo terminaría esto hoy...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Pero aun así...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_kid_000222",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Saki...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Por alguna razón, las lágrimas no paraban de brotar de las cuencas de mis ojos.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_kid_000223",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Maldita sea, parezco una niña...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Son poquísimas las veces que he llorado, aun desde niño. Y a pesar de eso...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"¿Por qué estoy tan frustrado?",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
