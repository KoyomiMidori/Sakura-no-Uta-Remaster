astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="nightsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Después de cenar, regreso a mi habitación.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Y por alguna razón, había una revista tirada en el suelo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"La abro. Al parecer es un especial de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estaba tirada esta... ¡Eh, Shizuku!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Eché un ojo al pasillo y a la ventana, pero no llegué a verla.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que estaba espiándome de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Vuelvo a la revista y comienzo a hojear.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Hay fotos de Shizuku en traje de baño. Tratándose de un nuevo volumen,\nobviamente es primera vez que las veo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"La Shizuku de la revista sale con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pocas veces la he visto con esta cara...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Shizuku no varía mucho sus expresiones faciales.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Pero si comparamos ahora con hace un tiempo, su variedad de expresiones se ha\nenriquecido.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Shizuku está viviendo su vida como una chica normal.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Ahora que todo terminó, ha logrado vivir bajo su nombre. Su nombre original.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que recuerdo... algo había dicho de que su corazón era solo una copia...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Hubo un genio artista.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Fue él quien creó su corazón.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Y fue teniendo a una espectadora como ella, que el genio conoció el arte de la\ngente.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Eso es lo que he escuchado...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía me cuesta creerlo, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su corazón, eh...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Veo las fotos de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Y recuerdo cómo lloró la primera vez que comió de mi comida.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No pensé que llegaría a reaccionar de esa manera.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, todavía no le he preguntado por qué lloró...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Sería de muy poca delicadeza hacerlo.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Pasó por bastante. Terminó en mi mesa. Comió de mi comida. Y lloró.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Debería dejarlo de esa forma...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"En cada una de las fotos de esa sexy colección, Shizuku sonreía.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente tiene una cara hermosa...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Ya desde hace tiempo se me hacía hermosa, pero jamás pensé que llegaría a\nconvertirse en una modelo profesional.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ahora que lo pienso, quizás desperdicié una gran oportunidad...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"No, no, olvídalo. No debería decir eso, ni siquiera en broma.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"se",file="se2497",id=1},
{"text"},
delay={
[800]={
{"se",file="se2497",id=2},
},
},
text={
ja={
{
"Sigo pasando las páginas.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Una foto.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En traje de baño...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"No una, varias.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sin siquiera acercarme a ver las fotos, alzo la voz.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás ahí, ¿verdad, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No hay respuesta alguna.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No está?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más solo que esté no creas que voy a ver las fotografías que dejaste.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hombre... ¿Qué pretendes haciendo esto ahora?...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fgf",frame="frame_ss",bg="black",ch="雫",bgpx=":bg/"},
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",y=-15,lv=5,id=25},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Justo entonces, Shizuku apareció tras la ventana.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conque estabas allí...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fgact",ch="雫",act="うなづく",size=5,lv=5,id=25},
{"text"},
text={
vo={
{"vo",file="fem_szd_000699",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, aquí estaba.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te quedas afuera te van a picar los mosquitos.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0010",head="shz_z2a",y=-15,lv=5,id=25},
{"text"},
text={
vo={
{"vo",file="fem_szd_000700",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya estoy cubierta de picadas...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agh, demonios, entra de una vez.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Shizuku entró a mi habitación por la puerta trasera.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000701",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quería que vieras mis fotografías...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, ¿de verdad crees que lo haré?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0010",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000702",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Desde que comenzaste a vivir en la casa Natsume, pensé que, quizás\nfuncionaría... pero, veo que tu reacción no cambia.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo cual es obvio.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000703",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Era de esperarse, supongo. Ya me habías rechazado antes...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Por qué dices que yo te rechacé? No estoy entendiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000704",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000705",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dejando eso a un lado, hay algo que me llamó más la atención...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"La expresión de Shizuku se torna grave.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000706",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Estás aún... arrepentido de eso?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De eso?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000707",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“'Desperdicié una gran oportunidad'. Eso escuché...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Idiota, no es eso. No me refería a eso.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me arrepiento en ningún momento de haber abandonado esa fortuna.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000708",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad?... Kei nii-san había dicho que estabas arrepentido de haber\nrechazado la herencia...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no lo niego, un poco. Era bastante dinero.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000709",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Entonces--”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿sabes? Mucho peor hubiese sido el arrepentimiento si por aceptar la\nfortuna no estuvieras ahora acá, en esta casa.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, arrepentimiento es poco. Me odiaría de por vida, sin duda alguna.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000710",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aun así... me pone triste.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no hay nada de qué entristecerse.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sí, estoy arrepentido, pero solo un poquito. No era mi dinero, no lo trabajé,\ny la verdad, el monto era tan grande que simplemente no se me hacía real.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No siento pesar por lo que hice. Para nada.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000711",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, Kei nii-san y Ai nee-san...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Les conté lo del abandono de la herencia porque sabía que en cualquier momento\nse enterarían. No podía mantenerlo en secreto.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero igual tenía que hacerles creer que realmente estaba arrepentido, o se\nvería raro. Nadie en su sano juicio rechazaría heredar una fortuna sin\nargumento alguno.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegaran a sospechar de mí intentarían indagar más, y eso complicaría las\ncosas. Lo que sucedió aquel día debe quedar entre nosotros, y nadie más.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es solo un teatro, para que no sospechen.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡El idiota se hace el guapetón, dice que el dinero no lo es todo, abandona la\nfortuna y luego se arrepiente! ¿Quien sospecharía algo de tamaña estupidez?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es solo eso. Nada más.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000712",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, realmente... eres demasiado amable...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, tonta. Y si es por eso, quien en realidad reunió ese\ndinero fue Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"msgoff"},
{"se",file="se9002",vol=50,id=1},
{"fg",ch="雫",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="雫",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008",head="shz_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000713",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“O las falsificaciones...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-De igual forma, fue gracias a él que se pudo reunir el dinero. Fue él quien\ntuvo más mérito.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, esa fue parte de su voluntad, de aquella que nunca dejó en testamento.\nUna muy de él, y basada en lo mucho que me conocía.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Sigue con aquello que yo no pude lograr.'”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa fue la voluntad que nunca escribió.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, aún estaba vivo para entonces...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, lo único que hice yo fue cumplir con su voluntad, como su hijo.\nMás nada.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que si quieres darle las gracias a alguien, dáselas a mi padre.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000714",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estoy agradecida con Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000715",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, estoy aún más agradecida contigo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué yo? Creo que ya lo dije antes, le debo mucho a lo que pasó. Tanto que\nhasta gratitud siento.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me dijo que mi obra era como un epitafio para él.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso siento gratitud. Por haber podido producir una obra digna de esas\npalabras...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que no te preocupes mucho.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0008",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000716",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es imposible que no lo haga... Tanto que hiciste por mí, y yo no he podido\ndarte nada a cambio...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comiste lo que te preparé aquel día, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0009",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000717",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso no es suficiente. De ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues yo digo que sí, y así está bien.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000718",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, pero entonces, ¿qué hago con estos sentimientos?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, esos sentimientos... Vamos, que no sé qué hacer con tanta gratitud...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000719",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. No es gratitud. ¡Yo, yo--!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Las palabras de Shizuku se detuvieron allí.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000720",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y-Ya llevo tiempo diciéndotelo.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Decirme qué?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000721",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué, qué más podría ser? ¡Lo que yo siento!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo que sientes? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000722",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku... ¿Qué sentimientos son esos?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000723",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uh～”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La cara de Shizuku se sonrojó de repente.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Esta muchacha es capaz de sonrojarse, aun sin expresión alguna.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"No sé por qué, pero me pongo tenso.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Pues, entre tanto sonrojarse, parecía estar enojada...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0010j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000724",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡L-Lo que yo siento, es--!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0010j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000725",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhh～～”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Tan roja ahora, que definitivamente se veía un cambio en su expresión.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000726",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhh... ¿Por qué? Antes era más fácil...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué era más fácil?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0005j",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0006j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000727",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhh, la culpa la tienes tú también por no escucharme.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Escuchar qué?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0100",face="b0018i",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0005i",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000728",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, no importa, no importa. Vamos, es hora de dormir.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0006i",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000729",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡M-Me iré a dormir ya!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo olvidaba. Dejé el agua de la tina calentándose. Báñate antes de dormir.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008i",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000730",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008i",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000731",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Hasta mañana, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"se",file="se9003",id=1},
{"fg",ch="雫",mx=1280,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"No sé por qué, pero Shizuku salió de mi habitación casi como huyendo.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué le pasa?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Ahora que recuerdo, no le expliqué a qué me refería cuando mencioné lo de haber\nperdido una 'gran oportunidad'.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Bueno, supongo que no hace falta, pero...",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Pero, ahora...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En aquel tiempo todavía acabábamos de conocernos, y ninguno de los dos sabía\nmucho del otro...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, ahora la conozco muy bien...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y por eso es que todavía no puedo dejar de pensar acerca de lo que dejé ir.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo evitarlo? Con lo hermosa que es...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué más da, no sirve de nada lamentarse por lo que ya pasó...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Me puse a estudiar mientras esperaba a que Shizuku saliera de bañarse, y\ndespués de ducharme, me acosté a dormir.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=2000,func="wait"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"???"},
"“――”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Escucho la voz de alguien en medio de mi sueño.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Esta voz... Siento que no es la primera vez que la escucho...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"No tengo percepción de la realidad...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"¿Por qué la habré olvidado?...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Claro.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Siempre que despierto después de sentirme así, siento mi mente despejada, como\nsi algo se hubiera llevado todos los fragmentos de sueños remanentes\nadentro...",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Por eso es que nunca me acordaba de esa voz.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Pero――",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_szd_000732",ch="szd"},
},
ja={
{
name={"???"},
"“――”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay algo raro...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Me levanto de inmediato.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_szd_000733",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kuh... hauh...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Y frente a mí estaba Shizuku, tumbada sobre el piso.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_f01_01",path=":ev/ev_com_f01/",set="ev_com_f01"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿S-Shizuku?!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Al mover mi mirada un poco doy con aquel recipiente, tirado sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Un líquido estaba desbordándose de él.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡S-Shizuku! T-Te pusiste a--”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_f01_02",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000734",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kuh... e-estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes que estar bromeando. ¡¿Por qué lo hiciste?! ¡Ya no hay razón alguna para\nque hagas esto!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_szd_000735",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“L-Lo siento... s-solo que...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, traeré agua.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_szd_000736",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“T-Traje, agua conmigo...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Había una botella plástica tirada junto a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_szd_000737",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por, si acaso...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por si acaso?! ¡No me jodas! ¡¿Sabes lo que puede pasarte si tragas sueños en\ntu estado actual?!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_szd_000738",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Perdón...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Tomo la botella plástica. El plástico de la tapa estaba intacto.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"No ha bebido ni una sola gota.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, toma. Agua.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_szd_000739",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“U-Uhm...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Los labios de Shizuku temblaban, y no podía beber de la botella.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bebe, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_szd_000740",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ugh... me tiemblan los labios, no puedo...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Su rostro se ve cada vez peor.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"No puedo desperdiciar un segundo más.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Me llevo algo de agua a la boca.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Y entonces――",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000741",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nmm...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_szd_000742",ch="szd"},
},
ja={
{
name={"Shizuku"},
"... *glup*... *glup*...",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Le doy de beber directamente de mi boca.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_szd_000743",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*cof*...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_f01_03",path=":ev/ev_com_f01/",set="ev_com_f01"},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",file="ev_com_f01_06",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000744",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Esta vez si pude permanecer despierta...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_szd_000745",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hace un tiempo me hiciste lo mismo... pero aquella vez estaba inconsciente...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo recuerdo. Veía que no despertabas y me desesperé bastante.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_szd_000746",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El remordimiento de aquel día no me deja tranquila aún. ¿Por qué tuvo que\npasar, justo cuando estaba inconsciente?...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajaja, vamos, ¿es que acaso no se trataba de una broma cuando me pediste que\nlo hiciera otra vez ese día?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_szd_000747",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto que no... Ese día sentí que desaproveché un gran chance...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué barbaridades dices? Los efectos secundarios de tragar sueños te estaban\nmatando, si te di a beber agua de esa manera fue porque tenía que salvarte de\nalguna forma...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
delay={
vl01={
{"bg",file="ev_com_f01_04",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
},
},
text={
vo={
{"vo",file="fem_szd_000748",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez, pero... kuh...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te sientes mal aún?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_com_f01_03",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000749",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Parezco estarlo?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_szd_000750",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No me siento, mal, en absoluto... uhnn...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no? Tienes la cara roja, tu respiración y pulso están descontrolados.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_szd_000751",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entiende... eso no es porque, me sienta mal.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, ¿por qué te pusiste a tragar sueños? Ya no hace falta que te\nvuelvas Hakuki, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_szd_000752",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así es. Pero... quizás, es que no podía olvidar aún...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Olvidar qué?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_szd_000753",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El júbilo, de compartir un mismo corazón contigo...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_szd_000754",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cuando aún era Hakuki... tragar tus sueños, me hacía feliz...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues si la memoria no me falla, tu misma habías dicho que lo único que tragabas\nde mi corazón eran sueños eróticos.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_szd_000755",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ciertamente, solo habían sueños eróticos. Pero sueños puramente eróticos no\nexisten... En los tuyos siempre había amor...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_szd_000756",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No tenía manera de conseguir tu amor... así que tomarlo prestado, aunque sea en\nsueños, era la única y dulce alegría que tenía entonces...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué estás... diciendo...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_szd_000757",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me gustabas... incluso antes de conocernos... Y después de conocernos,\ncomenzaste a gustarme más y más...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_szd_000758",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero... nunca te fijaste en mí...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta, ¿por qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_szd_000759",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Acaso olvidas todo lo que hice?...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Todo lo que hiciste?...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_szd_000760",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Intenté hacer muchas cosas pervertidas, después de bastante investigación en el\nteléfono.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que era para poder hacer realidad esos sueños, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_szd_000761",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso solo era una excusa...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_szd_000762",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo lo hice porque me gustabas...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_szd_000763",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Perdóname... Todo esto debe ser una molestia para ti.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_szd_000764",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo que... aún al día de hoy... no he podido borrar esos sentimientos...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_szd_000765",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por eso, terminé causándote problemas de nuevo ahora... Perdóname, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bg",file="ev_com_f01_05",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000766",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tanto, tanto has hecho por mí, y lo único que hago yo, es causarte problemas...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Lágrimas se desbordan de los ojos de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_szd_000767",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo único que quiero es hacerte feliz, pero aun así... soy demasiado tonta, y ni\nsiquiera eso sé cómo hacer...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_szd_000768",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No he podido pagar nada de lo que has hecho por mí, solo darte problemas...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tonta...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Abrazo a Shizuku, quien estaba ahora llorando.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_szd_000769",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Siempre haces mucho por mí, así como ahora... Siempre, tan amable...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_szd_000770",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Siempre, por mí...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que siempre por ti? Vamos, no seas tonta.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te estoy abrazando ahora, no es exactamente por ti...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_com_f01_06",sync=0,face=1,time=400,path=":ev/ev_com_f01/",set="ev_com_f01"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000771",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, vaya momento que elegiste para confesarte.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_szd_000772",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Todas, las confesiones hasta ahora han sido reales...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues de la forma en que lo hacías, todas sonaban a broma.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_szd_000773",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez... Ahora, que lo pienso, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahhh, diablos.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_szd_000774",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Perdóname. ¿Te enojaste?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo no enojarme?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_szd_000775",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que estoy enojado. Y es que...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre había estado decidido a ser el primero en confesarse.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y de que sería solo una vez en mi vida.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“He vivido todos estos años con esa decisión siempre firme dentro de mí.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_szd_000776",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Suena a algo que solo tú harías...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conoces a la familia Kusanagi, así que debes saberlo ya. Todos los de nuestro\nlinaje son fieles a una sola mujer, de por vida.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_szd_000777",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_szd_000778",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por eso es que una muchacha como yo no hace falta en tu vida.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja... de decir tantas estupideces...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_szd_000779",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1,vol=50},
{"text"},
text={
ja={
{
"Abrazo fuertemente a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-470,zoom=90,file="zbg005h",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue solo hace poco que nos reencontramos, por casualidad. No somos eso,\n¿sabes?...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0009j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000780",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Al menos yo sí lo pienso así... La deuda que tengo con Naoya Kusanagi es\nimpagable, por más que me tome la vida entera.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0010j",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000781",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, en el caso de Shizuku, apenas acabamos de conocernos...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun como Shizuku ya llevamos casi medio año juntos. Aunque, nuestro tiempo\njuntos ahora no ha sido tan íntimo como entonces...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0002j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0003j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000782",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, fue un tiempo de muchos sucesos. Tiempo que fue de mucha felicidad para\nmí...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0011j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000783",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por eso mismo, quise pagarte de vuelta la felicidad que me diste... pero, no\npude hacer nada...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0005j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0009j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000784",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo es, y probablemente solo pueda pagarlo de vuelta con dinero.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0003j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000785",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por eso comencé a trabajar.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000786",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Participé en muchos comerciales y programas de televisión, donde sabía que\nconseguiría dinero...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0002j",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000787",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Soy buena ocultando mi corazón, y por eso... también soy buena, actuando.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos... ¿Es que acaso estás trabajando de actriz solo para regresarme ese\ndinero?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0005j",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0018j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000788",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo para, no. Ese es el único propósito de vida que tengo.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0005j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000789",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pienso pagarte todo de vuelta, algún día.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0006j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000790",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Idiota por qué? ¡Estoy haciendo mi mayor esfuerzo, a mi manera!”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás podría aceptar ese dinero...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0005j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000791",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haré que lo tomes, así sea a la fuerza.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna manera lo recibiré.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0006j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000792",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Entonces--!”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0010j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000793",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Entonces que debería hacer con esto que siento?!”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000794",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La persona que amo está siempre allí por mí, ayudándome, pero yo no puedo hacer\nnada por él.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000795",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Dime! ¡¿Qué debería hacer para librarme de este sentimiento?!”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Después de un rato de silencio, abro la boca.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, ¿qué te parece si hacemos esto?”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se trata de algo que te va a tomar la vida entera para pagarme de vuelta, ¿no?\nDe ser así, entonces...”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dame tu posesión más preciada.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0009j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000796",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mi posesión más preciada?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me basta con que me des eso.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000797",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué es lo más preciado que tengo?”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquello que Kenichiro Kusanagi, Ai Natsume, Kei Natsume y Rin Misakura te\ndieron.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por supuesto yo también, en parte...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000798",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1,vol=50},
{"text"},
text={
ja={
{
"Acerco mi cara a la de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu corazón...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Y nos besamos.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
