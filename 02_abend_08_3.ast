{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=345,lv=4,id=6,sync=0},
{"extrans"},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0006",head="mak_z1d",x=345,lv=4,id=6},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001278",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Vamos! ¡Voy a cerrar ya!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000870",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Espera un momento, por favor!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001279",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, sé que están concentradas, pero se supone que hoy van a comprar sus trajes\nde baño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000871",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque no es exactamente así. No 'van' a comprar, sino que 'vamos' a\ncomprar. ¡Tú también te comprarás uno, Mako-chan!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001280",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No te preocupes por mí... Podría llevar el del año pasado y ya...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",mode=-1,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=-345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000593",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que tienes un traje de baño del año pasado?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001281",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo sé. Quizás sea del año antepasado, en fin, ya tengo un traje de baño así\nque no me hace falta comprar ninguno.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x2=-345,x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000594",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",file="se9031",id=1},
{"fgact",ch="優美",act="ジャンプ",loop=-1,time=300,size=5,lv=4,id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0014h",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="縦揺れ",size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0022h",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001282",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kyaah, esp--, q-qué hac--, detent--, iyaan. ¡D-Detente!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás sobando y estrujándole los pechos a Toritani?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fgact",ch="優美",act="停止",lv=4,id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006",head="yum_z1b",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000595",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No abras la boca, Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Por alguna razón me regañó.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"se",file="se9031",id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",x=0,lv=4,id=1},
{"fgact",ch="優美",act="ジャンプ",loop=-1,time=300,size=5,lv=4,id=1},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0021h",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001283",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No, d-dejaaa, auh, eh! ¡Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fgact",ch="優美",act="停止",lv=4,id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000596",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Imposible.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",file="se9010",id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006h",head="mak_z1d",x=345,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006h",head="mak_z1d",x2=345,x=570,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001284",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué es imposible?!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000597",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tus pechos no entrarán en un traje de baño del año antepasado.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0006h",head="mak_z1d",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001285",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Cómo es que sabes eso?!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000598",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo sé. En estos últimos días tus pechos han crecido aún más, Toritani-senpai.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0007h",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001286",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y yo te estoy preguntando por qué razón estás enterada de eso!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000599",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues lo único que hago en este club es verle los pechos a todas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"No tienes diferencia alguna con Thomas en lo que acabas de decir.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001287",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Igual puedo ir con el traje de baño reglamentario del colegio! Aun con un poco\nmás de busto el traje de baño reglamentario me entra igual, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z1",mx=-40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000283",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que ir a la playa con el traje de baño del colegio haría que llamaras la\natención más bien.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0018",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001288",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡M-Me da igual! ¡A mí no me preocupan esas cosas!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿cuál es el problema con comprarte un simple traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0006",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001289",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Un simple traje de baño?! ¡No puedo andar despilfarrando el dinero de esa\nforma!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000284",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Despilfarrar? ¿Pero qué tan ahorradora eres?... No creo que una joven dama\ndeba titubear a la hora de comprarse un traje de baño nuevo...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001290",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Da igual, total no se lo mostraré a nadie...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0005",head="yum_z1b",x=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000600",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Kusanagi lo verá!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? Ya les dije que yo no voy a ir a ese campamento...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=570,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0018",head="mak_z1b",x=570,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001291",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que Kusanagi venga o no no tiene nada que ver. ¡Además! ¡¿Por qué se supone que\ndebo comprar un traje de baño para mostrárselo a Kusanagi?! ¡Pero qué\nidiotez!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una idiotez, eh...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000285",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede? Tienes una cara de bastante lamento ahora. ¿Pensaste algo así\ncomo, 'No tenías por qué ser tan tajante conmigo' o algo por el estilo?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo así.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=0,lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=0,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000601",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupaste en siquiera negarlo, eh. Que típico de los hombres, o debería\ndecir, de los depravados...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues no puedo negarlo, me encantaría ver los majestuosos bustos de Toritani y\nde Rin y de Hikawa envueltos en traje de baño!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_yum_000602",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",lv=5,id=1},
{"se",id=1,file="se2500"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gyaaah! ¡Mis ojos! ¡Mis ojossss!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000603",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Crees que voy a permitirle a una bestia que solo vive de bajas intenciones\ndeleitarse los ojos con los agraciados cuerpos de las senpais?!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No tienes derecho alguno a decirme eso a mí! ¡La misma que se la pasa viéndole\nlos pechos a las otras integrantes del club de arte!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000604",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Yo soy una mujer y por eso no hay problema! ¡Puedo ser una pervertida y no\npasa nada!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000286",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí hay problemas.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000605",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pechos grandes, pechos grandes! ¡¿Es que tanto te encantan los pechos\nenormes?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, la verdad es que también quisiera verte en traje de baño a alguien como tú,\nKawachino. Tienes buena figura.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000606",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",zoom=70,x=-380,speed=200,time=0,sync=0,file="zbg049b",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="優美",speed=200,time=0,sync=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x2=0,x=-300,lv=5,id=1},
{"quake"},
{"quake",mode="mw"},
{"se",id=1,file="se2500"},
{"text"},
text={
ja={
{
"Esquivo al instante su ataque.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Crees que voy a caer de nuevo por lo mismo?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",mode=-2},
{"bg",time=300,file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0110",face="a0005",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000607",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nuh...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy igual a Thomas. No voy a recibir el mismo ataque varias veces.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000608",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡De ninguna forma voy a mostrarme en traje de baño frente a ti, Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Es una pena. Aun cuando pensaba contemplar fijamente tu cuerpo en\ntraje de baño hasta cansarme.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000609",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tienes bastantes agallas como para decir eso frente a mí. Realmente eres todo\nun acosador-senpai.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Di lo que te de la gana. Nunca fui ningún acosador-senpai, pero por andar\nllamándome así tan insistentemente me cansé y decidí vivir siendo fiel a mis\ndeseos y mi lujuria.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006",head="yum_z1b",lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000610",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gunuh. ¿Quieres decir que yo misma hice despertar al acosador-senpai? No puede\nser...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Fujajajaja! Observa con terror el poder del acosador-senpai tras su despertar.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0006",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000611",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nuh, maldito depravado.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wajajaja, ambos lo somos.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0006",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000287",ch="rna"},
},
ja={
{
name={"Rina"},
"“Oigan, OIGAN, no crean que es muy chistoso lo que están haciendo. A los ojos de\nlos demás, están teniendo una conversación bastante ridícula.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es que esta muchacha no se cansa de llamarme a cada rato acosador-senpai,\nacosador-senpai.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000612",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero realmente me parece que eso fue acoso sexual. Me parece una broma de muy\nmal gusto decir que quieres verme en traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es ninguna broma. Realmente quiero verte en traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_000613",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aun cuando ya viste mis pantis...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001292",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué rayos? ¿Cómo viste las pantis de Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000614",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me vio a hurtadillas desde abajo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000101",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Pero qué demonios, socio? ¡Eso es terrible! ¡¿Sabes cuántas veces he estado\npersiguiendo ese momento y cuántas se me ha ido de las manos?! ¡¿Por qué no\nme invitas a mí a espiar, socio?! ¿Qué sucede con nuestra amistad?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo no tengo ninguna amistad contigo, imbécil! ¡En primer lugar eso no fue a\npropósito, realmente fue pura casualidad!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",x=570,lv=4,id=4},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001293",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pura casualidad, eh. Eso me huele demasiado a mentira. Ya llevo un buen tiempo\ncon esto en la mente, Kusanagi. ¿No crees que tu frecuencia de crímenes\ndepravados no es como que mayor a la de Thomas?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mx=-40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-680,lv=4,id=9},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0006",head="rna_z1b",x2=-570,x=-210,lv=4,id=3},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x2=0,x=210,lv=4,id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",x2=570,x=680,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000872",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues es que es Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, Rin! ¿Qué rayos dices? No me estás ayudando en nada.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",x=-680,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0016",head="rin_z1a",x=-680,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000873",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué estás diciendo, Kusanagi-kun? No puedo darle mi apoyo a una persona capaz\nde ver a hurtadillas la ropa interior de una chica...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"A pesar de tener una sonrisa en cara, Rin me da demasiado miedo...",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=210,lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",x=210,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000615",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por tal razón es que deben cuidarse de Kusanagi. ¡Su cabeza está totalmente\nero-contaminada!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-680,lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-680,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000874",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, claro! Traigamos a Kusanagi-kun para que nos acompañe a comprar nuestros\ntrajes de baño.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006",head="rna_z1d",x=-210,lv=4,id=3},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0006",head="yum_z1a",x=210,lv=4,id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",x=680,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000288",ch="rna"},
{"vo",file="fem_yum_000616",ch="yum"},
{"vo",file="fem_mkd_001294",ch="mkd"},
},
ja={
{
name={"Makoto, Rina y Yuumi"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-680,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-680,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000875",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, sí, ¿por qué será? Aunque, si Kusanagi-kun viene con nosotras Mako-chan\nno podrá argumentar '¡No necesito traje de baño porque no se lo mostraré a\nnadie!'.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fgact",ch="里奈",act="びっくり",lv=4,id=3},
{"fgact",ch="優美",act="びっくり",lv=4,id=1},
{"fgact",ch="真琴",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000289",ch="rna"},
{"vo",file="fem_yum_000617",ch="yum"},
{"vo",file="fem_mkd_001295",ch="mkd"},
},
ja={
{
name={"Makoto, Rina y Yuumi"},
"“¡¿Pero por qué?!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=210,lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",x=210,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000618",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Estuviste escuchando todo lo que sucedió hasta ahora? La cabeza de Kusanagi\nestá totalmente ero-contaminada.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",x=-680,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000876",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Pero también está la opción de elegir un traje con la cantidad\nsuficiente de tela como para que Kusanagi-kun no se excite, ¿no? Después de\ntodo iremos todos juntos al campamento.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-210,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000290",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, si elegimos los trajes de baño en base a nuestro integrante más\nero-contaminado, Kusanagi-senpai, entonces más bien estaríamos seguras.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que yo soy el más depravado? No voy a permitir que me manchen mi nombre de esa\nforma.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0012",head="rin_z1a",x=-680,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000877",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿No quieres verlas a todas en traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, quiero verlas!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-680,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000878",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces no hay problema con que seas el más ero-contaminado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que tienes razón. Soy el hombre con mayor grado de ero-contaminación\nacá.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000879",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, a veces eres muy fiel a tus deseos. Tanto que sorprende un\npoquito.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy fiel a mis más bajos deseos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000619",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bueh, yo no me mostraré frente a Kusanagi mientras esté probándome los trajes\nde baño en el vestidor, así que no me importa...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000880",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, yo también preferiría mostrarlo cuando llegue el momento.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006i",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000620",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿P-Por qué se supone que en ese momento le mostraremos nuestros trajes de\nbaño?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000881",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no me refería a eso... Quise decir, en el momento en que debamos\nestrenar nuestros trajes de baño, no me refería a mostrárselo a\nKusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017i",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000621",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"No sé por qué, pero después de que a Kawachino se le pusiera la cara como un\ntomate, me observó ferozmente.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006i",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000622",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Realmente eres pestilente, Kusanagi. No te soporto.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Me lanzó un reclamo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001296",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puh... puhpuhpuh...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"De repente, Toritani comenzó a reírse. No quedaba un solo rastro de la\nexpresión malhumorada que tenía hace un rato.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001297",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, ya entendí. Si dejo que Rin-chan siga hablando todas las demás\nchicas terminarán revelando sus secretos más preciados. Sí iré, iré con\nustedes.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000882",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Mako-chan, elige tú también un traje de baño nuevo conmigo, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001298",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, Rin-chan, eres algo increíble.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000883",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001299",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es difícil de creer que seas capaz de hacer algo que termine aumentando tu\nnúmero de rivales.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000884",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Mako-chan, a juzgar por esa forma de decirlo, tú también...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0006",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001300",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No, te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000885",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo bromeaba. No me importa tanto eso de rivales, simplemente pensé en pasar\nun buen rato con todos.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000886",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, será mi primer y último verano en el colegio Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001301",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ya veo. Aunque sí, eso es muy de ti.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001302",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perfecto, está bien. ¿Nos vamos a comprar nuestros trajes de baño junto a\nKusanagi y Kei entonces?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",my=40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000102",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001303",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En esta ocasión no puedo aceptar de ninguna forma que vengas.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z2",mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0100",face="a0010",head="tho_z2a",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000103",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡NOOO!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"El centro comercial al anochecer. Es muy raro que yo venga acá.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Por eso es que no sé realmente si hay más o menos personas de lo usual, pero\n¿se supone que los centros comerciales están siempre así de llenos?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg018f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun cuando está anocheciendo hay bastante gente...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000291",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás por estar en vacaciones de verano es que hay también muchas familias con\nsus niños.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000887",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-san se está tardando.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que nos alcanzaría en motocicleta, ¿será que se perdió en el camino?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001304",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... En fin, quedamos en que nos avisaría al celular cuando llegue, así que no\nhay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0004",head="yum_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000623",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Bien, será que vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"se",file="se0744",id=1},
{"fg",ch="優美",mx=-40,mode=-1,lv=4,id=3},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000292",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, ¿pero por qué vas corriendo antes que los demás? ¿Conoces la tienda,\nYuumi?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",size="z1",mx=-40,mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004i",head="yum_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_yum_000624",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ya no importa si la conozco o no, Rina, vayamos rápido a algún vestidor! Y\nentonces las dos, encerradas, enclaustradas, atrapadas, Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000293",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, llevo tiempo conociéndote, pero igual eso me repugna~”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004i",head="yum_z1a",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000625",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Rin-senpai! ¡Rápido! ¡Vamos rápido al vestidor a que te desnudes! ¡Después\npuedes elegir el traje de baño!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000888",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Creo que eso no es así... Normalmente se entra después de elegir el traje de\nbaño.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"se",file="se9004",id=1},
{"fg",ch="里奈",mx=-40,mode=-1,lv=4,id=9},
{"fg",ch="優美",mx=-40,mode=-1,lv=4,id=3},
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=4},
{"text"},
text={
ja={
{
"Rin y Hikawa entraron junto a Kawachino a la tienda, ambas jaladas de las manos\npor ella.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001305",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Incluso Yuumi, que se mostraba renuente a venir, se está divirtiendo viniendo\nde compras.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, de ninguna forma parece estar disfrutando venir solo a comprar.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001306",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te parece? ¿No es esa su forma de ocultar su pena? A esa muchacha le gusta\ndivertirse con todos, de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Aunque siempre pareciera estar irritada por algo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001307",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro que no. Si fuera así no hubiera venido hoy con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, supongo...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso quiere decir que no te la estás pasando tan mal después de todo?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001308",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué estás diciendo? No tenía forma de rechazarles después de que me\ninvitaran tan insistentemente, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te estás divirtiendo entonces?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001309",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me estoy divirtiendo, no puedo evitarlo al verlos a todos tan felices. Pero no\ntengo mucho dinero, así que no tenía tantas ganas de venir de compras.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad es eso?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001310",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No estabas tratando de investigar a Akashi por tu cuenta después de que todos\nse fueran?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0018",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001311",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... estás demasiado perspicaz...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001312",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no quiero aguarle la fiesta a mis kouhai cuando parecen estar pasándola\ntan bien.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, quieres bastante a tus kouhais.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Comenzamos a caminar lentamente.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_szd_000333",ch="szd"},
},
ja={
{
name={"???"},
"“Qué casualidad...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"se",file="se9004",id=1},
{"fg",ch="雫",size="z1",sync=1,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000334",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Es que acaso piensas comprar los ingredientes de la cena en este lugar?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también quisiera saber qué haces aquí.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000335",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Este centro comercial está muy cerca de San Ruan, así que suelo acercarme al\nsalir de clases.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001313",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Esta muchacha...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000336",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*cohon*... No me he presentado aún. Me llamo Shizuku, soy la segunda hija mayor\nde la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001314",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eh! ¿la hermanita de la profesora Ai?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000337",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Realmente lo siento mucho por agitarme y haberles mostrado una escena tan\nvergonzosa la vez pasada.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
},
vl02={
{"fgact",ch="真琴",act="stopact",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001315",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Eh? Ah, no importa, no importa, nosotras tenemos la culpa por haber entrado\na tu casa tan de repente.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001316",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque realmente impacta ver en persona a alguien de la TV. Y no es de menos,\nconsiderando lo famosa que es Kuzuka Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puh.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000338",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué sucede, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acabas de decir Kusuka Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001317",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto. Kusuka Kusanagi. A cada rato ponen su comercial, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tú... ¿Has estado usando ese nombre artístico?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1d1000",face="d0003",head="shz_z1d",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000339",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, he estado trabajando con ese nombre artístico... ¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... es que...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"¿Así de pobre en variedad son tus nombres falsos?",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001318",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede? ¿Es que acaso estuviste todo este tiempo sin saber el nombre\nartístico de Shizuku-san?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000340",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hubo un día que se quedó con los ojos puestos sobre mis fotos, así que pensé\nque debía saberlo, pero... ¿no será que se concentró demasiado en otra parte\ny no leyó las letras?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001319",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué clase de fotos estabas viendo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000341",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fotos en traje de baño... Al parecer tenía preferencia por los trajes de baño\nblancos.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es cierto, no es cierto. Solo que había una nota adhesiva pegada a la\nrevista, y la abrí por pura casualidad.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000342",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero estuviste más de 10 minutos viéndola. ¿Por qué no te diste cuenta aún\ndespués de verla tanto tiempo?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo que en la nota estaba escrito 'Shizuku'.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000343",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues esa nota la pegó nee-san, así que obviamente usaría mi verdadero nombre.\nPero aun así ni siquiera esas enormes letras entraron a tus ojos... ¿Tanto te\ngustaron las fotos del traje de baño blanco?...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001320",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“10 minutos viendo unas fotos de una muchacha en traje de baño... Ya, fuera de\nbroma, ¿realmente no serás el más ero-contaminado de todos, Kusanagi? ¿De\nverdad habrá sido buena idea traerte con todas las muchachas a elegir sus\ntrajes de baño?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0012",head="shz_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000344",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Los trajes de baño de todas las muchachas?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001321",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, realizaremos un campamento, e iremos a un lugar con playa, así que\ndecidimos venir a comprar todas nuestros trajes de baño.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000345",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ohhh... Y entonces Naoya vino con ustedes de la nada...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Vine porque me invitaron a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0022",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001322",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque invitado por ser el más ero-contaminado, no lo olvides.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uguh...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"No lo puedo negar.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1000",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000346",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... ¿Rin vino también?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Shizuku me pregunta eso en voz baja.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, también vino.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Le respondo, también en voz baja.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000347",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... ¿Puedo ir yo también?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
