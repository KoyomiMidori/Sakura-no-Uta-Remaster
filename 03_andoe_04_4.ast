astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm026"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063c",path=":bg/",sync=0},
{"extrans",time=1500},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003894",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan... Viniste...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_szd_001082",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003895",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo sabía, puedes sentirlos... Los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_szd_001083",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quizás... porque soy Hakuki...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0005",head="rin_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003896",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hakuki? ¿La sacerdotisa que hizo florecer los cerezos milenarios?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_szd_001084",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003897",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hmmph. Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0005",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003898",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace tiempo Kenichiro-san mencionó que eras muy poco expresiva en tus\nemociones... ¿Se refería a eso?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_szd_001085",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003899",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La sacerdotisa de los cerezos milenarios, eh... Entonces, tal vez yo también\nsea Hakuki...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_szd_001086",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003900",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo no puedo convertir los sueños de las personas en agua, ni tampoco\ntragarlos...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003901",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero puedo hacer florecer los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_szd_001087",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003902",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí. ¿Podrías sostenerme esto?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin me dio el álbum.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"El álbum lleno con sus recuerdos. El álbum que había sido arrancado de toda\nimagen de su madre.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003903",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ese álbum es igual a mí. Le hace falta una parte muy importante de sí...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bgm",stop=1,time=1000},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003904",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="ev_com_f05_01",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"bgm",file="bgm025"},
{"text"},
text={
ja={
{
"Rin alzó el pincel al aire.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Y apuntando estaba el pincel al Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003905",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pintaré los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"msgoff",time=0},
{"se",id=1,file="se1306"},
{"bg",file="zev_com_f05_03",id=2,lv=2,zoom=50,alpha=64,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=3,lv=3,zoom=50,alpha=64,time=40,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",time=0,sync=0,file="ev_com_f05_01",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"msg",no=1},
{"cgdel",id=-1},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001088",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“----”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Escuché algo similar a un fuerte pitido. Como si algo estuviera resonando con\nalgo...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003906",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hito Futa Mi Yo Itsu Mu Nana Ya Kokono Tari Furube Yurayura to Furube.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Rin estaba entonando algo.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Parecía ser una especie de encantamiento, pero no entendí qué significaba.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Rin movió el pincel.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"El pincel danzaba por el aire.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"se",file="se2340",vol=51,id=1},
{"bg",file="ev_com_f05_02",rule="106r",time=300,sync=0,face=1,path=":ev/ev_com_f05/",set="ev_com_f05"},
{"text"},
text={
ja={
{
"Y con él, los cerezos.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001089",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Pétalos?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Existe la leyenda de que los cerezos milenarios resuenan con los sentimientos\nde las personas.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Pero si solo fuera por eso, estos podrían florecer con completa facilidad.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Y la realidad es distinta.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Los cerezos milenarios, cerezos que no florecieron por un milenio.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Era un imposible.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Pero incluso lo imposible se puede dibujar.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"La imaginación puede tomar cualquier forma.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Pero ¿puede tener esa imaginación la misma magnitud que lo real? Esa es la\ncuestión.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"El número de personas que podría lograr algo así se acerca a cero.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Pero, cero como tal no es. Casi cero.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003907",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡---!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"El sudor de Rin vuela por el aire.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Cada una de las gotas brillaba, y se convertía en un pétalo de cerezo.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Era un panorama terrible, pero hermoso.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"El pincel, deslizándose por el aire, comenzó a formar el contorno.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"msgoff",time=0},
{"se",id=1,file="se1306"},
{"bg",file="zev_com_f05_03",id=2,lv=2,zoom=50,alpha=64,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=3,lv=3,zoom=50,alpha=64,time=400,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",time=0,sync=0,file="ev_com_f05_01",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"cgdel",id=-1},
{"ex",time=100,func="wait"},
{"msgoff",time=0},
{"se",id=2,file="se1306"},
{"bg",file="zev_com_f05_03",id=2,lv=2,zoom=50,alpha=64,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=3,lv=3,zoom=50,alpha=64,time=400,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",id=1,lv=1,time=0,sync=0,file="ev_com_f05_01",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"msg",no=1},
{"text"},
text={
ja={
{
"No era una ilusión.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No era que se me parecía verlo, ni nada de ese estilo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"A medida que Rin mezclaba el pigmento en el aire, la figura de los cerezos\nmilenarios iba formándose.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_szd_001090",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Esto es...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Las fotos de la madre de Rin que habían sido arrancadas del álbum que tenía\nahora en la mano, comenzaron a aparecer.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Era el preludio de un milagro.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Sentí terror.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Esta muchacha está dibujando los cerezos milenarios, y está intentando revivir\na un muerto.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"msgoff",time=0},
{"se",id=1,file="se_wind_strong"},
{"cgdel",id=-1},
{"bg",file="zev_com_f05_03",id=2,lv=2,zoom=50,alpha=255,time=500,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=3,lv=3,zoom=50,alpha=128,time=700,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_03",id=4,lv=4,zoom=50,alpha=128,time=1000,path=":ev/ev_com_f05/",z2=55,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"ex",time=0,func="wait"},
{"bg",time=0,sync=0,file="ev_com_f05_03",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"msg",no=1},
{"cgdel",id=-1},
{"text"},
text={
ja={
{
"Viento sopla. La vibración de la brisa penetra mis oídos.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Cerezos blancos comenzaron a aparecer sobre el oscuro cielo, revoloteando\nfuertemente como si de una tormenta se tratara.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003908",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan... ahora sí, puedes verlos, ¿verdad?... Ahora, sí... Y esta vez...\nno desaparecerán...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003909",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Estos cerezos no desaparecerán de ninguna forma!\n¡Así pasen mil, diez mil, millones de años, jamás lo harán!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001091",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"――",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Sentí una voz.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Una voz llamándonos.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_szd_001092",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Kenichiro-san?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003910",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Habiendo percibido la voz de Kenichiro, Rin comenzó a acelerar los movimientos\nde su pincel.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_szd_001093",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Fue al escuchar la voz de Kenichiro que me resolví.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"se",file="se9010",id=1},
{"bg",file="ev_uni_c29_01",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"Se dice que ese recipiente ha estado en la residencia Natsume desde tiempos\nantiguos.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Cuando la residencia Natsume era todavía llamada la residencia Kootoha.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"En toda su larga historia, Hakuki nació una y otra vez, dedicándose a adivinar\nlas fortunas de los demás en la residencia.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Ese recipiente era utilizado en la ceremonia de Yumehari. El 'Da'.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Por supuesto, no sabía cómo se usaba.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Pero, guiada por el instinto, alzo el recipiente hacia Rin.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_f05_04",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001094",ch="szd"},
},
ja={
{
name={"Shizuku"},
"'Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana'",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Rin conocía esas palabras.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Fue solo una vez que vi esas palabras en este templo, y sin embargo estaban\nadheridas a mi cabeza, sin error alguno.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"msgoff",time=0},
{"se",id=2,file="se1306"},
{"bg",file="zev_com_f05_04",id=2,lv=2,zoom=50,alpha=64,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_04",id=3,lv=3,zoom=50,alpha=64,time=400,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_04",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",id=1,lv=1,time=1000,sync=0,file="ev_com_f05_05",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"msg",no=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003911",ch="rnd"},
},
ja={
{
name={"Rin"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"El color va desvaneciéndose del pincel de Rin.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Y al mismo tiempo, el recipiente va llenándose de agua.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003912",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿S-Shizuku-chan?! ¡¿¿Q-Qué estás--??!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_szd_001095",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y-Yo soy Hakuki. La tragasueños.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003913",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Sueños?!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_szd_001096",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esto es un sueño. Un sueño que tú has fabricado, Rin.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003914",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No, esto no es un sueño!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_szd_001097",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si no fuese un sueño, Hakuki no podría tragarlo como hace ahora.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"El agua empieza a gotear del recipiente.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Pesa bastante.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"No se siente como la cantidad de agua que pudiera caber en un recipiente de\napenas unas decenas de centímetros.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003915",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡Shizuku-chan!!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"El agua se desborda.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Me la bebo por completo.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Una cantidad desorbitante.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Me lo llevo a la garganta, todo.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"msgoff",time=0},
{"se",id=2,file="se1306"},
{"cgdel",id=-1},
{"bg",file="zev_com_f05_04",id=2,lv=2,zoom=50,alpha=64,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_04",id=3,lv=3,zoom=50,alpha=64,time=400,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_04",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",time=1000,sync=0,file="ev_com_f05_05",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"cgdel",id=-1},
{"msg",no=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003916",ch="rnd"},
},
ja={
{
name={"Rin"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_szd_001098",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Sentí un dolor que jamás antes había sentido correr por mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Y a pesar de eso, no paré de tragar la fantasía que Rin estaba fabricando.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"El color se desvanece.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"El pincel se mueve en el aire sin hacer nada.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_f05_06",sync=0,face=1,time=400,path=":ev/ev_com_f05/",set="ev_com_f05"},
{"text"},
text={
ja={
{
"Convirtiéndose en una batuta sin orquesta.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Haciendo movimientos inútiles en el aire.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"msgoff",time=0},
{"se",id=2,file="se1306"},
{"cgdel",id=-1},
{"bg",file="zev_com_f05_07",id=2,lv=2,zoom=50,alpha=255,time=300,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_07",id=3,lv=3,zoom=50,alpha=64,time=400,path=":ev/ev_com_f05/",z2=51,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_07",id=4,lv=4,zoom=50,alpha=64,time=600,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=077,time=300},
{"ex",time=0,func="wait"},
{"bg",time=1000,sync=0,file="ev_com_f05_07",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"cgdel",id=-1},
{"msg",no=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003917",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_szd_001099",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Pero Rin no se rendía. Y terriblemente, varias veces logró revivir el gradiente\nde colores.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Recuperaba el tempo de su pincel tal cual director recuperando su orquesta.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"En su talento no se veían límites.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Era una luz eternamente encendida de causalidad enlazada.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Los cerezos milenarios se bamboleaban entre la existencia y no existencia.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"El recipiente transformaba el talento de Rin en agua.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Y en medio del terrible dolor.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Lo único que podía hacer era devorar su talento.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Yo devoro. Ella pinta. Yo devoro. Ella pinta. Yo devoro. Ella pinta. Yo devoro.\nElla pinta. Yo devoro.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Repitiéndose el ciclo, una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"En algún momento la tormenta paró.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Silencio absoluto.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"El sonido de la orquesta de colores se detiene.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_f05_07",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"text"},
text={
ja={
{
"Los rastros de luz.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"msgoff",time=0},
{"se",id=1,file="se_sakura_zawawa"},
{"cgdel",id=-1},
{"bg",file="zev_com_f05_07",id=2,lv=2,zoom=50,alpha=64,time=500,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_07",id=3,lv=3,zoom=50,alpha=64,time=800,path=":ev/ev_com_f05/",z2=53,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_f05_07",id=4,lv=4,zoom=50,alpha=64,time=1000,path=":ev/ev_com_f05/",z2=55,set="ev_com_f05",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=200},
{"ex",time=0,func="wait"},
{"bg",time=1000,sync=0,file="ev_com_f05_08",path=":ev/ev_com_f05/",set="ev_com_f05"},
{"cgdel",id=-1},
{"msg",no=1},
{"text"},
text={
ja={
{
"Las flores se dispersaron como fuegos artificiales apagándose.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_001189",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Rin! ¡¡Shizuku!!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Reconocimos a Kenichiro al verlo.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_f05_09",sync=0,face=1,time=400,path=":ev/ev_com_f05/",set="ev_com_f05"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003918",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Me pareció ver a Rin sonriendo al dar con Kenichiro...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bgm",stop=1,time=500},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"text"},
text={
ja={
{
"Para luego desmayarse.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063h",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",lv=4,id=9},
{"fgact",ch="直哉",act="うなづく",lv=4,id=9},
{"se",file="se9015",id=1},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Un muchacho se acercó corriendo a tomar a Rin mientras se desmayaba.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"De él emanaba un gradiente de colores único.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Ah, claro.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Este es el muchacho del cual Rin tanto hablaba...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Habiendo despojado a Rin de su poder, me di cuenta de inmediato.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, Rin podía ver los colores...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001190",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿M-Me están diciendo... que los cerezos milenarios... florecieron?...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001191",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Todo esto... lo hizo Rin?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Asiento, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001192",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Maldita sea... ¿Quién pudo pensar que esto terminaría así?...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001193",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No, debí haberme dado cuenta yo antes. Ya varias veces en el pasado había\ncreado cerezos de la nada...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001194",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todo indicaba que Rin era capaz de lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="健一郎",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="健一郎",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/ken/z2/",file="ken_z2b0000",face="b0011",head="ken_z2b",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_kid_001195",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Shizuku... ¿Usaste tu poder?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"mwact",act="うなづく",size=5},
{"text"},
text={
ja={
{
"Asentí.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="健一郎",size="z2",mode=3,path=":fg/ken/z2/",file="ken_z2b0000",face="b0004",head="ken_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001196",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No te duele?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"mwact",act="いいえ",size=5},
{"text"},
text={
ja={
{
"Vuelvo a girar la cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Porque soy Hakuki...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Intenté decir eso, pero ni siquiera vocalizar podía.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="健一郎",size="z2",mode=3,path=":fg/ken/z2/",file="ken_z2b0000",face="b0006",head="ken_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001197",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Demonios... Se supone que yo debía de encargarme de esto, y aun así te obligué\na usar tanto de ese poder...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="健一郎",size="z2",mode=3,path=":fg/ken/z2/",file="ken_z2b0000",face="b0009",head="ken_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001198",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué diablos he estado haciendo?...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kenichiro-san me abraza.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"De sus ojos estaban cayendo lágrimas.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y ante eso, no sentí absolutamente nada.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Solo recuerdo haber sentido fuertemente la calidez de Kenichiro-san mientras me\nabrazaba.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Papá, ¿qué está pasando? ¿Qué son esos cerezos?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063h",path=":bg/",sync=0},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=-345,lv=4,id=5,sync=0},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1b0000",face="b0008",head="ken_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_kid_001199",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Los cerezos milenarios? ¿Pero qué demonios es eso?...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001200",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cerezos que provocan milagros.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Milagros? ¿Esto?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0005",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001201",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Así son los milagros! Alterar los principios naturales...\nEs lo único que hacen...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alterar los principios naturales...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001202",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Naoya! ¿Cómo está Rin?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está respirando... Su respiración está muy tranquila... Pareciera estar\ndurmiendo...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que no es nada grave.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=-345,lv=4,id=5},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001203",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo... menos mal...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001204",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si algo le hubiese pasado a Rin... Haberlas juntado a las dos hubiese sido un\nterrible error...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0008",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001205",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No... Eso no cambia el hecho de que fui yo quien produjo esto...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001206",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Debí haber tenido más cuidado...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Kenichiro-san no tiene la culpa.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Además, me siento contenta de haber podido conocer a Rin.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Pero no pude vocalizar nada.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rin perdió todos los recuerdos de haber intentado revivir a su madre, y su\npoder también.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Naoya creyó que habían sido los cerezos milenarios los que robaron a Rin de sus\nrecuerdos, pero no era así.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Los cerezos milenarios resonaron con su deseo, e intentaron materializarse\nusando su poder.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Fui yo quien le robó a Rin su memoria.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"No, para ser correctos, le robé del sueño de querer revivir a su madre. Eso, y\ntodo lo demás, se lo quité.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Usé mi poder, y me convertí en Hakuki.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Entre los artefactos divinos de los Housoushi, hay uno llamado Hakuki\nKagurasuzu.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Los Housoushi sonaban la campana Kagura y recitaban poemas al momento de\nejecutar el Da.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Pero esta campana Kagura tiene, además, otro poder.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Funciona como un artefacto que conecta a los Housoushi con Hakuki.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Y teniendo eso, la familia Nakamura no necesitaba tenernos en todo momento bajo\nsu vigilancia.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Puesto que cuando Hakuki despierta, la campana suena con un peculiar sonido.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Reacciona al poder de Hakuki.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Y fue así que en la noche en la cual me transformé en Hakuki, la familia\nNakamura se apresuró a reunir su gente, y rodearon la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"De seguir Kotoko Natsume viva no podrían haber hecho algo tan arriesgado como\neso. Pero ahora que la familia Natsume se había desintegrado, nada les\nimpedía recurrir a métodos más violentos.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Y menos aún que no solo se trataba de una mujer de los Nakamura. Se trataba de\nla mujer que había despertado como Hakuki.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Me buscaron desesperadamente.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Pero obviamente Kenichiro-san no me dejó en la residencia Natsume. Me escondió\nen un hotel de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Unas semanas después, gracias a Kenichiro-san y sus amigos, pude huir a Nueva\nYork.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Y después de eso, pasé los años viviendo con él en Nueva York.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_04_5"},
{"text"},
linkback="block_00186",
},
label = {
top={block="block_00000",label=1},
},
}
