astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg012a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué calor... Hace demasiado calor...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000487",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya es verano.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, plena y ridículamente verano...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000488",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Odias el verano?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nadie a quien le guste el verano...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000489",ch="aid"},
},
ja={
{
name={"Ai"},
"“No... hay a quienes sí les gusta, ¿no? ¿Cómo es que puedes aseverar eso de esa\nmanera tan fresca?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que quise decir es que no entiendo qué rayos tienen en la cabeza aquellos\nque les gusta el verano. En primer lugar, el verano es muy caluroso, es\nhúmedo, sencillamente no le encuentro nada bueno...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000490",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Tanto así odias el verano? ¿Qué estación te gusta entonces? ¿Invierno?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Los inviernos son fríos, así que están fuera de lugar.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000491",ch="aid"},
},
ja={
{
name={"Ai"},
"“No te gusta lo caluroso ni lo frío... A eso únicamente se le llama ser\ncaprichoso.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm... Si tuviera que irme por una, pues diría que los otoños son plácidos, tal\nvez.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000492",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo. Sea como sea, para ti las estaciones se categorizan simplemente por si\nson plácidas o no.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es eso lo normal?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
delay={
vl04={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000493",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hay otras cosas más a tomar en cuenta aparte de eso, ¿no es así? El cielo\ndespejado del verano, los paisajes nevados de invierno, o las hojas de\notoño... Cierto, ¿qué tal la primavera? La primavera es tan agradable como el\notoño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La primavera... La primavera es la estación que más odio...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000494",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿La primavera es la estación que más odias? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La primavera es deprimente...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000495",ch="aid"},
},
ja={
{
name={"Ai"},
"“La primavera es deprimente, eh... Jaja, eso es tan de ti...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000496",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eres probablemente el único capaz de decir que la primavera es deprimente.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Aquellos que sufren de alergia al polen lo mencionan\nfrecuentemente, de que la primavera es deprimente.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000497",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nunca me llegué a enterar de que sufrías de alergia al polen.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es obvio. No tengo ninguna alergia al polen.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así... odio la primavera.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_aid_000498",ch="aid"},
},
ja={
{
name={"Ai"},
"“Todos los alrededores se tiñeron por completo de verde...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué estás diciendo? Es obvio, ya estamos por terminar julio.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000499",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tienes razón. En esta estación todos los árboles de cerezo están cubiertos de\nverde... es obvio...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000500",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajaja... Incluso cosas tan obvias como esas las olvidas. Cuando estás\nocupado...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás ocupada?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000501",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, los profesores siempre andamos bien ajetreados el primer período... Por eso\nes que cuando llegamos al punto de transición entre períodos, nos damos\ncuenta. En el momento en que paramos, es que nos damos cuenta por primera vez\nde todo el tiempo que ha pasado...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000502",ch="aid"},
},
ja={
{
name={"Ai"},
"“De que ya es verano...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues claro que lo hacen. Los profesores se la pasan de vacaciones casi todo el\nverano, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000503",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota, incluso durante las vacaciones de verano los profesores nos mantenemos\nocupados.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, parece que el club de arte hará un campamento este verano. Están\nplaneando ir a alguna parte del campo o algo así.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000504",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, ya me enteré. Un campamento durante esta época. Aunque bueno, supongo\nque será por la exhibición de otoño.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La exhibición de otoño?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000505",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No sabes cuál es? Parece que es una exhibición financiada por una fundación\nextranjera.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, la Exposición Moore. Es esa exposición donde Kenichiro Kusanagi obtuvo el\nmáximo premio hace bastante tiempo. El Platine Épaulard.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000506",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, esa es, he escuchado que últimamente sus premios gozan de mayor renombre\nque las propias exhibiciones nacionales.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que renombre, la cifra de dinero que se puede recibir es incomparable. Los\nmillonarios del extranjero crearon e invirtieron en ese evento para poder\nasegurar y en un futuro revender las obras ganadoras. Tanto aquellos que van\npor el premio como aquellos que lo ofrecen van con una actitud totalmente\ndistinta, en ese caso.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese premio es pura y meramente, por el fin del dinero, aunque la verdad, puedo\nentenderlo un poco...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000507",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sabes bastante de ese evento, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no hay ninguna otra exposición tan famosa como esa. Toda exposición con\nprofundo pasado histórico que pueda haber en el país se ve opacado por ella.\nLa manera en que los medios de comunicación la publicitan es descomunal.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000508",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad? Pero ahora que lo mencionas, la Exposición Moore no parece tener\nuna historia tan larga... Aunque incluso en las noticias llegan a reportar a\naquellos que ganan algún premio de esa exposición. ¿Por qué eso?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente porque eso significa dinero para ellos también. La verdad es que la\nExposición Moore colabora, en el caso de Japón, con todas las grandes\nagencias de publicidad del país. Obviamente la tele y todos los otros medios de\ncomunicación masiva se ocuparán de mostrarlos en exclusiva.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000509",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, por eso parece ser tan colosal el evento.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, en el caso de este país, el evento tomó bastante fama a partir del\nmomento en el que Kenichiro Kusanagi recibió el premio mayor. Hasta ese\nentonces ningún japonés había logrado ser premiado en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En particular, ninguna otra persona volverá a ganar el Platine Épaulard, aparte\nde Kenichiro Kusanagi. Para ese entonces los medios lo reportaron como un\nacontecimiento deslumbrante y maravilloso.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000510",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Esa exposición cogió fama después de que Kenichiro-san recibiera el premio?...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy hablando específicamente de que se volvió famosa en Japón. En el\nextranjero ya tenía fama desde hace bastante tiempo. Las obras de los\nartistas que llegaron a ganar ese premio superan en valor, sin ninguna\nexcepción, los cientos de millones. Por eso es que es totalmente imposible\nrecibir ese premio presentando cualqueir obra mediocre.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000511",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Así de difícil es? Kei había dicho que era extraordinariamente complicado...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es común ver todos los años que no acepten a ninguna obra para aspirar al\nPlatine Épaulard. Algunos años ni siquiera premian a nadie.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000512",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso es increíble. Pero ¿el hecho de no premiar a nadie no les acarrea problemas\ncomo exposición?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque no es únicamente realizada en Japón. Parece que la realizan al\nmismo tiempo en varios países. No se distribuyen la misma cantidad de premios\npor cada país, así que básicamente todos los países se disputan por ellos.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es por eso que por lo general ningún japonés es premiado... Y lo digo de nuevo,\nel único que pudo ganar ese premio fue Kenichiro Kusanagi, nadie más podrá.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000513",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así de difícil es... ¿Toritani está aspirando a ese premio?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Platine Épaulard está completamente fuera de alcance, es imposible, sin\nembargo, cualquier premio, sea el premio al esfuerzo o lo que sea que\ncontenga la palabra 'premio' y provenga de la Exposición Moore sería un logro\nimpresionante.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000514",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, y por eso Toritani está tan entusiasmada... Aunque ya los exámenes de\ningreso a la universidad están a la vuelta de la esquina, así que\npersonalmente me gustaría que se esforzaran mesuradamente.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues este año también está Kei, así que quizás piense que tal vez, a lo mejor,\ntienen una oportunidad... Pero sinceramente, la Exposición Moore está\nbastante difícil...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000515",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero todos están esforzándose, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese no es el problema. Para eso no solo se requiere únicamente calidad\nartística, sino también una capacidad de persuasión y de generar polémica y\natención en la obra capaz de atraer los ojos de los distintos inversores de\ntodo el mundo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se podría decir que, en cierta forma, el hecho de que el dinero se involucre en\nesa ecuación hace que los aspirantes al premio sean expuestos a los jueces\nmás severos del mundo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recibir ese premio significa tener tu carrera artística internacional\ngarantizada. No es ni siquiera la edad lo que influye, pues dudo incluso que\nalguien del actual club de arte de Yumihari sea capaz de recibir ese premio,\nen ningún momento de sus vidas.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000516",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así de grande es la magnitud de ese premio...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el colegio Yumihari existe, según, entre los miembros de tercer año, la\ntradición de presentar una obra a la Exposición Moore y retirarse del club\nposteriormente, aunque eso no es más que una especie de 'mejor intentarlo a\nno arrepentirse'.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos los años el plazo es hasta finales de octubre, y a partir de ahí\ncomienzan a concentrarse en los estudios para las pruebas de ingreso. Aunque,\nla gran mayoría de los estudiantes que pertenecen al club de arte de Yumihari\npresentan en universidades de arte y artes plásticas, así que no es tan\ndescabellado la idea de pintar también para la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De cierta manera se ha vuelto tradición, justamente por darte la oportunidad de\nconcentrarte y practicar tus habilidades básicas de dibujo y diseño.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero de igual manera, personas como Rin no piensan entrar a una universidad de\nartes, ¿realmente estará bien que esté pintando en esta época?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000517",ch="aid"},
},
ja={
{
name={"Ai"},
"“Misakura no tiene ningún problema. Con su habilidad académica podría entrar a\ncualquier universidad nacional de difícil ingreso sin mucho trabajo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, ese tema es muy lejano para alguien con habilidades académicas tan\npobres como yo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000518",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si te esfuerzas y estudias tú también podrías entrar a una universidad, quizás\nno una de difícil ingreso, pero igualmente con buen nivel. Esfuérzate\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, haré lo mejor que pueda.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_aid_000519",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, acá nos separamos.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000520",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿A qué hora terminas lo que tienes que hacer?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, ni siquiera sé de qué se trata...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000521",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo... no hay forma de saberlo entonces. En fin, me iré a la sala de\nprofesores.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",file="se9012",id=1},
{"msgoff"},
{"fg",ch="藍",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, vamos...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z1",mx=-40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000980",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me alegra que vinieras.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así me pediste que hiciera.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000981",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perdona por llamarte un domingo.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pensé que me llegarías a llamar hoy, a pesar de que estuviste hasta anoche\nen la casa de los Natsume.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000982",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue esta mañana cuando me di cuenta... ¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000983",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De qué manera podría agradecerte?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime primero lo que necesitas de mí. Tenías algo que preguntarme, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000984",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Seré breve y directa.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bgm",stop=1,time=500},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000985",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿estás planeando perpetrar algo de nuevo en conjunto con Akashi?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bgm",file="bgm007"},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué se supone que debería ponerme a planear perpetrar algo junto con\nAkashi?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000986",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace un tiempo hicieron algo ustedes dos juntos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hecho de que hayamos hecho algo juntos una vez no significa que lo hagamos\nde nuevo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, ¿qué razones tendría yo para ponerme a planear algo con él?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0008",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0005",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000987",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo sé. Simplemente se me ocurrió eso... En fin, te lo preguntaré una vez\nmás. Kusanagi, ¿tienes algo que ver en este caso?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de lo que me estás hablando, ¿es que acaso Akashi está planeando algo de\nnuevo?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0001",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000988",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ni idea. Hasta ahora, solo mi intuición cree eso...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu intuición...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Recuerdo a Akashi y cómo observaba la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Ciertamente, parecía estar planeando alguna fechoría...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías preguntarle directamente a Akashi y no a mí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000989",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Crees que va a acceder a decirme la verdad sin reserva alguna? Después de todo\nseguramente me vendrá con las mismas tonterías que dice siempre.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Las acciones y palabras engañosas y complicadas de ese hombre siempre superan\nnuestras expectativas, no importa que tanto tiempo llevemos conociéndolo.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000990",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún pareciendo que hiciera puras cosas sin sentido o relación alguna, después\nque pasa un tiempo te das cuenta de que todo estaba conectado. Es\nrelativamente normal que nos demos cuenta siempre al final del verdadero\npropósito de las acciones de Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Siempre aparenta no pensar ni planificar nada, pero en realidad, en\nlo que concierne a planear fechorías es todo un maestro.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque lo de los 600 pares de uwabaki o la estufa gigante o el enorme\nventilador no tuvieron nada de sentido al final...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000991",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000992",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sinceramente, debe estar teniendo problemas para deshacerse de todo eso, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues los debe estar teniendo. Si por lo menos fueron uwabakis sin usar se\npodrían vender, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000993",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso está fuera de lugar. Esos uwabaki están completamente defectuosos. Incluso\n100 yenes por un par de ellos es ya demasiado caro.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Defectuosos? ¿Es que acaso se rompieron?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000994",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se rompieron, pero la suela de goma está bastante pegajosa. Son de tan mala\ncalidad que la superficie se derrite con el calor del verano. Es imposible\nusarlos.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, entonces no deberían llegar ni a los 100 yenes por par, eh.\nBásicamente, compró chatarra...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000995",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue hoy que me di cuenta, así que quizás ni el mismo Akashi-senpai se ha dado\ncuenta aún.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí. No tengo idea de lo que pensaba hacer con esos uwabakis para niños,\npero, no hay absolutamente nada que pueda hacer con algo tan defectuoso.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"A pesar de parecer estar conversando de manera normal, Toritani está\nobservándome fijamente. Está escudriñando mi expresión.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000996",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, lo siento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"La expresión de Toritani se aligera un poco.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000997",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya me di cuenta de que no tienes nada que ver en este caso. A juzgar por tu\nexpresión, no pareces estar mintiendo.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que lo sabes? Podría estar mintiéndote.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000998",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna forma. Cada vez que mientes tomas una expresión bastante peculiar,\ncualquiera se da cuenta. ¿Es que no estás consciente de eso?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... Creo que he han dicho algo así antes...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000999",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, perdóname por haber dudado de ti. Tenía que ver tu expresión sí o sí\npara saber si realmente estabas mintiendo o no...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Aunque, también es algo problemático que pueda saber eso solo por mi\nexpresión...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, es natural que como jefa estés vigilante de las acciones de Akashi, ¿no?\nNo te preocupes por eso...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001000",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, te lo agradezco. En fin, toma esto.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"msgoff"},
{"fgact",ch="真琴",act="ジャンプ",sync=1,lv=4,id=9},
{"se",file="se9020",vol=50,id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ouh.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Agarro lo que Toritani me lanzó. ¿Qué es esto?",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pan?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001001",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás sea poco como para un almuerzo, pero por los momentos, calma tu hambre\ncon eso.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te importa darme esto? Es un pan gratinado, el segundo más caro de la\ncantina.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001002",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A pesar de haber usado pase de estudiante, viniste en tren. Quizás no sea nada\nsuficiente para pagarte de vuelta el dinero que te debo por este favor, pero\ntómalo igual.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya deja de una buena vez eso de las deudas. Además, lo de esta ocasión no fue\nla gran cosa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001003",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque tú no lo pienses así, yo no puedo quedarme tranquila.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001004",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Una vida sin deudas con nadie!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001005",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De no lograr eso no puedo comportarme como realmente soy yo, la chica que no se\npreocupa por lo que los demás digan o piensen, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así te ves obligada a mostrarte despreocupada ante lo que digan los\ndemás como para tener que hacer incluso eso?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0022",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001006",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Claro!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"No lo digas con tanto orgullo...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Ya terminé lo que tenía que hacer con Toritani, así que por ahora me dirijo a\nla plaza central.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"No tenía nada que venir a hacer acá realmente, pero el clima está bueno, así\nque pensé en sentarme en el Anfiteatro y comerme el pan que Toritani me dio.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"cgdel",id=-1},
{"excall",file="02_abend_04_2"},
{"text"},
linkback="block_00143",
},
label = {
top={block="block_00000",label=1},
},
}
