},
block_00246={
{"se",file="se9004",id=1},
{"fg",ch="水菜",mx=40,mode=-1,lv=4,id=6},
{"fg",ch="藍",mx=40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Ambas se metieron en la residencia y no volvieron a salir.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="man_kid_000186",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que este es... El Umoreginoya...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="man_kid_000187",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me imaginaba que sería algo así, aunque...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Tal como lo pensé... Esta residencia tiene una conexión con Mizuna...",
{"rt2"},
},
},
},
