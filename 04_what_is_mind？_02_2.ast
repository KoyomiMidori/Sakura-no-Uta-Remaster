astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="man_kid_000111",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Oye~, Wakata~”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="若田",size="z1",mode=3,resize=1,path=":fg/wak/z1/",file="wak_z1a0000",face="a0001",head="wak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000088",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_kid_000112",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sabes quién es Mizuna Nakamura, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fgact",ch="若田",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000089",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, la supergenio, ¿cierto? Me pregunto qué tan inteligente hay que hacer para\nobtener esas calificaciones. Inteligente, hermosa y además es de la\nprestigiosa familia Nakamura. La vida le ha dado todo, realmente.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_kid_000113",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es popular entonces. Supongo que lo será en particular con el sexo opuesto,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fgact",ch="若田",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000090",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ni tanto, la verdad. Tiene un aura que repele a los demás. Es una chica\nsolitaria, digo, nunca se le ha visto charlando de forma amena con alguien.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_wkd_000091",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Aunque, según he escuchado aún no paran de venir hombres a confesársele. Es una\npreciosura, después de todo.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_kid_000114",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_wkd_000092",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Aunque supongo que para alguien de una clase tan alta como ella no hay valor\nalguno en tratar con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_kid_000115",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hmmmph. ¿La odian en el salón?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fgact",ch="若田",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000093",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No la odian. Al contrario, le tienen miedo. Si bien la familia Nakamura tiene\nprestigio, también es famosa por estar inmiscuida en asuntos con la Yakuza.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_wkd_000094",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Y por eso todo el salón la trata como una especie de tumor intocable, supongo.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_kid_000116",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un tumor...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_wkd_000095",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Sucede algo con Mizuna Nakamura, profesor?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_kid_000117",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No es nada...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_wkd_000096",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Por qué me pregunta por ella? ¿Es que acaso es buena pintando también?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_kid_000118",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Escucha, muchacho, tampoco es que estoy las veinticuatro horas del día pensando\nen pintura, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fgact",ch="若田",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000097",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿En serio? Pero pareciera estar siempre pensando en lo mismo, profesor.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000119",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, supongo porque es lo único en lo que soy bueno, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fgact",ch="若田",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000098",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Venga y revise entonces mi cuadro, profe.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000120",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No hace falta. Sigue pintando como te parezca.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fgact",ch="若田",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000099",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Nunca se digna usted a asistirme con mis cuadros, profesor.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000121",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya te enseñé lo que necesitabas saber al principio, ¿no? Con tal de que sigas\nlas básicas todo saldrá bien. Y aunque no lo creas, sí estoy revisando\nconstantemente.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_kid_000122",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Siempre que hay algo raro o fuera de lugar te lo indico, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_wkd_000100",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pues tiene razón, sí.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fgact",ch="若田",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000101",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pueees bueno, a empujar un poco más. ¡Esto lo termino hoy!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kid_000123",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es, a trabajar duro se ha dicho.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_g01_01",path=":ev/ev_com_g01/",set="ev_com_g01",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"En esos tiempos eras parte del club de arte, eh, Wakata.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"No habían muchos miembros para ese entonces, pero aun así el nivel del club era\nalto. Habían ganado una buena cantidad de premios en concursos.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"El colegio Yumihari ha egresado, desde hace muchos años, a una gran cantidad de\nartistas. Supongo que eso habrá influido también.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"No era supervisor ni nada por el estilo, pero no tenía a donde más ir, y por\neso frecuentaba el salón de arte.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Bueno, la verdad es que los únicos dos lugares que tenía para relajarme era la\nazotea y acá.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Solía charlar frecuentemente acá contigo.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Siendo aspirante a una universidad de artes, siempre solías hacerme preguntas.\nY de ahí te ayudé varias veces con tus pinturas.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"En ese sentido, quizá fuiste una especie de discípulo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"¿Lo cual, te preguntarás, significa que he tenido otros discípulos?",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Pues, la verdad no sé si se le podría llamar discípulo... pero hubo un tiempo\nen el que enseñé a una muchacha con un talento de dimensiones\ninconmensurables.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Tenía la misma edad que Naoya, sí...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"¿Que tú también, Wakata?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"¿Qué ridiculeces dices? ¿En qué momento dije yo que tú tenías talento?",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Aunque sí, no niego que eres un tipo trabajador. Nunca me parecieron mal tus\ncuadros, la verdad...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Oh, vaya, me desvié de la conversación.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Ella se saltaba clases a veces.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Sobre todo, según me enteré, educación física y música.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Educación física, porque la odia. Música, no porque la odie, sino porque no\npudo tolerar más la diferencia de gustos que tenía con el profesor.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Para ambas ha mantenido el nivel mínimo de asistencia requerido. Y sus\ncalificaciones en exámenes de papel son buenas, así que sus calificaciones\nfinales no son malas.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Los días en que se saltaba clases y hacía buen clima, se la pasaba leyendo.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Una vez le pregunté '¿Te gusta leer?'",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y con una cara de extrañeza encima...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"cgdel",id=-1},
{"bg",file="ev_com_g02_01",path=":ev/ev_com_g02/",set="ev_com_g02"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000041",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Qué harás sabiendo eso?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Me respondió eso.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No pude contestarle nada. Aunque, su selección de libros consistía\nprincipalmente en libros relativamente difíciles.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Obras que no te imaginarías ver a una colegiala leyendo.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Una vez la vi leyendo el texto original de un famoso filósofo. Sorprendido, le\npregunté...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"¿Por qué estás leyendo la versión original?",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y esto respondió ella.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0005",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000042",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Immanuel Kant es un filosofo alemán. ¿Cómo se supone que un texto en inglés es\nel original?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"No lo dije en ese sentido, no. Solo que no podía entender por qué leía a Kant\nen inglés. Según ella...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000043",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“La 'Crítica de la razón pura' de Kant es famosa por ser mucho más sencilla de\nentender en inglés que en japonés.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Eso me dijo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"¿Famosa por eso? Pasé casi un año viviendo en Estados Unidos, pero ahora es que\nme vengo a enterar de eso.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Los libros que leía eran siempre de ese estilo, así que en otra ocasión fui\ndirecto al grano y le pregunté...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_kid_000124",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué lees libros tan difíciles?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Y sin cambiar ni un poco la expresión en su cara, ella respondió...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000044",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No los leo porque quiera...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_kid_000125",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Entonces por qué?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000045",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“A lo largo de la historia han aparecido personajes muy, muy inteligentes,\n¿cierto? Pitágoras, Kepler, Galileo, Descartes, Newton.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000046",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Todos ellos describieron las verdades de este mundo en libros, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_kid_000126",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Las verdades de este mundo?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fgact",ch="水菜",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000047",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí. Usando el lenguaje de las matemáticas describieron las verdades del mundo.\nY esas verdades se mantienen aún hasta hoy en día.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000048",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Hay otros más famosos como Cristo, Buda, Confucio. Todos estos grandes\npersonajes entendían el sentido, significado y verdad del mundo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_kid_000127",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues... no sé, la verdad es que no entiendo mucho...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000049",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Todo el ímpetu que tuvo hasta ahora hablando se esfumó de repente.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000050",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“... Sí, tiene razón.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000051",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ya no soy una niña, debería darme vergüenza hablar de eso. ¿Las verdades del\nmundo? Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_kid_000128",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eso crees? Me parece genial que intentes buscar esas verdades mediante la\nlectura.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000052",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Son pocas las cosas que uno puede descubrir en los libros.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_kid_000129",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000053",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Así es. Si el conocimiento de los libros fuese así de impactante, todos los\ngrandes personajes que han movido este mundo serían novelistas.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000054",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y de lo que yo sé, la realidad es distinta.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000055",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Por eso creo que para encontrar la verdad, quizás sea mejor recurrir a los\nlibros de texto del colegio, y no esta clase de escritos.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_kid_000130",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eso crees? Pero no hay manera de encontrar la verdad en los estudios del\ncolegio, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000056",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Que se pueda o no obtener esa verdad estudiando no importa. Si para un\nestudiante dedicarse a los estudios es la clave para una mejor vida, entonces\nesa acción en sí es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000131",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es decir, la típica ruta de estudiar, ir a una buena universidad, y luego ir a\nuna buena compañía, eh. Qué franca eres.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000057",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Incluso una muchacha como yo sabe que el mundo se mueve en base a esa franca,\ndura verdad.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000058",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Por eso es que dedico la mayoría de mi tiempo a los estudios.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="man_kid_000132",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso explica esas calificaciones... Aunque, me pregunto, ¿es esa razón para\nestudiar tanto?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0018",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000059",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ni hace falta que lo diga. Aunque la verdad, alguien realmente dedicado a los\nestudios no estaría leyendo acá con tanta tranquilidad...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kid_000133",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero aparte de esto lo único que haces es estudiar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000060",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí, es lo único que realmente sé hacer. Y es en lo que invierto todo mi tiempo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_kid_000134",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000061",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Porque es lo único en lo que realmente me puedo esforzar por ahora.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_kid_000135",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Esforzarte? ¿Esforzarte para qué?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000062",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Quién sabe.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000063",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Pero, así como acabo de decirlo, si ese es el camino para alcanzar una mejor\nvida en esta sociedad, pues sería obvio seguirlo, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_kid_000136",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No es tan obvio para los demás. Por eso es que siempre eres la número uno,\nsupongo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Ella era una muchacha algo fría en su manera de ver las cosas.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Tenía muy claro que estudiar era simplemente una herramienta para sobrevivir en\nsociedad.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Por más claro que cualquiera pueda tener eso, ejecutarlo de forma calculada y\nconcisa no es nada fácil.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Y sin embargo, ella lo estaba logrando.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"¿Se podría decir entonces que su visión del mundo estaba fija ya?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"A mi no me pareció así.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Su mirada al seguir las letras impresas en papel estaba llena de vida. No\nparecía la de alguien con una visión fría del mundo.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Ella no estudiaba por estudiar, ni leía por leer.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Parecía, más bien, movida por alguna clase de impulso.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Por eso, cuando me dijo 'Ya no soy una niña, debería darme vergüenza hablar de\neso.', no lo tomé exactamente de esa manera. Me pareció más bien un mensaje\nde precaución para ella misma.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Ella invierte su tiempo estudiando, sacrificando incluso sus horas de sueño.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Y lee cuando ese mismo tiempo se lo permite.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Lo que me pareció ver ahí no era a alguien luchando por sobrevivir. Sino a\nalguien intentando buscar las respuestas de este mundo en su tiempo libre.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Probablemente ella deseaba, más que nadie, conseguir la verdad. Pero con mayor\nmagnitud aun intentaba empujar esa verdad a un lado, tachándola de infantil.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"De no ser así, no habría forma de que leyera esos libros tan complicados en su\ntiempo libre y a la vez mantuviera esas brillantes calificaciones.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Recuerdo que en una de nuestras conversaciones me dijo esto, con un tono\nbromista.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0002",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000064",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“What is mind? No matter. What is matter? Never mind.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Era un inglés simple. Algo que cualquiera podría descifrar.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_kid_000137",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“What is mind? ¿Qué es la mente? No matter. Materia no es.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_kid_000138",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"What is matter? ¿Qué es la materia? Never mind. Jamás mente.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_kid_000139",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“O eso podría decir, pero no es solo eso.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_kid_000140",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“What is mind? ¿Qué es la mente? No matter. Eso no importa.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_kid_000141",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“What is matter? ¿Qué es la materia? Never mind. Solo olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000065",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Ya lo conocía?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_kid_000142",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No, no lo conocía. Aunque viví un tiempo en Estados Unidos, así que apenas te\nescuché supe que se trataba de algún juego de palabras.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000066",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ya veo, así que vivió en los Estados Unidos...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_kid_000143",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y en otros países también. Estuve viajando por varios lugares.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0002",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000067",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ehhh... ¿Así que ha viajado a varios países?... ¿Como cuáles?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Los ojos de Mizuna tomaron un inusual brillo apenas escuchó la palabra 'varios\nlugares'.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Para ella, todo lo que tuviera que ver con 'países' y 'fuera de la ciudad' era\nalgo emocionante.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Se dispuso a escuchar todas mis historias de cuando viajé afuera con mucha\nalegría.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Después fue que investigué y me di cuenta que 'What is mind? No matter. What is\nmatter? Never mind.' era un juego de palabras con cierta fama entre los\nneurocientíficos angloparlantes.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Mizuna adoraba esa frase, y volví a escucharla una y otra vez después de ese\ndía.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Incluso ahora lo pienso. Esas palabras describían muy bien lo que ella sentía\npor dentro.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"La diversidad oculta entre la bipolaridad de estas palabras expresaban\nperfectamente sus sentimientos internos.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg058b",path=":bg/",sync=0},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1d0000",face="d0004",head="sak_z1d",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Ya atardeciendo, y después de confirmar que los demás profesores se fueron,\nentré a la sala de profesores y me encontré a Saki, con arrugas en su frente\ny sentada cabizbaja.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="man_kid_000144",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Cansada, Saki?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000026",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ah, no... no es nada.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="紗希",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Apenas me vio, Saki cerró apresuradamente el archivo que tenía frente a ella.\nSegún alcancé a ver, había un mapa adentro.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Vi unas letras allí escritas.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000027",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Quieres algo?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kid_000145",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué excusa podría necesitar un profesor para venir a la sala de profesores?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000028",ch="skd"},
},
ja={
{
name={"Saki"},
"“C-Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_kid_000146",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“*Fiuu*, no se presione mucho, señora jefa de profesores.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000029",ch="skd"},
},
ja={
{
name={"Saki"},
"“Lo sé... aunque, vivir sin presión alguna como tú también sería problemático.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_kid_000147",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_kid_000148",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por cierto...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Solo era una pequeña duda que tenía. No era nada serio.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Simplemente le pregunté a Saki de la misma despreocupada forma que lo hice con\nWakata.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kid_000149",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Saki, ¿conoces a una muchacha llamada Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0014",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000030",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Mizuna? ¿Mizuna Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Al escuchar ese nombre, la expresión en el rostro de Saki cambió visiblemente.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_kid_000150",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Es una Nakamura, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000031",ch="skd"},
},
ja={
{
name={"Saki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000032",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo no sé.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_kid_000151",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000033",ch="skd"},
},
ja={
{
name={"Saki"},
"“Kusanagi-kun, no te involucres con la familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_kid_000152",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Con la familia Nakamura? ¿Podría saber por qué?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000034",ch="skd"},
},
ja={
{
name={"Saki"},
"“La familia Nakamura tiene el poder en esta zona. Son los que llevan realmente\nel mando en este colegio, además.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_kid_000153",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No estás exagerando? Te creería si fuese antes de la guerra, pero ya no.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000035",ch="skd"},
},
ja={
{
name={"Saki"},
"“Lo sé. Ya no tienen casi nada del poder que tenían antes. Pero relativamente\nsiguen teniendo poder.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_kid_000154",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué hay de ti entonces, Saki? Eres también una Nakamura, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000036",ch="skd"},
},
ja={
{
name={"Saki"},
"“Así es... y en ese sentido, quizás no sea buena idea que confíes mucho en mí\ntampoco.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000037",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo también soy como ellos. Sucede, solamente, que todavía puedo tratar contigo\npor el hecho de ser viejos conocidos.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_kid_000155",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Podría ejercer mi poder en cualquier momento... ¿Eso es lo que quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000038",ch="skd"},
},
ja={
{
name={"Saki"},
"“Exactamente. Así que te recomiendo que no cojas mucho interés por los\nNakamura...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_kid_000156",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo... está bien.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000039",ch="skd"},
},
ja={
{
name={"Saki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0009",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0016",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000040",ch="skd"},
},
ja={
{
name={"Saki"},
"“*Fiuu*, no pareces ser del tipo que acceda tan fácilmente a hacer lo que le\ndigan los demás. Aun después de lo que te dije.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kid_000157",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso no es cierto. Confío en ti, Saki. Si tu lo dices yo lo creeré.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000041",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ya te dije que no confíes en mí.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_kid_000158",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En ese sentido confío en ti también.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Escuchando a Saki no me costó llegar a la conclusión de que Mizuna era,\nprobablemente, un tabú dentro de la familia Nakamura.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bgm",stop=1,time=1000},
{"bg",time=1000,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Pero hubo algo que me llamó aún más la atención.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"'Umoreginoya'",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Eso estaba escrito en el mapa que Saki cerró.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Ese nombre me dio algo de mala espina...",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="man_kid_000159",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Umoreginoya, eh. Vaya jerga tan antigua que se usaron...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Estaba ahora corriendo por los alrededores de Kootoha, en Yumihari, con mi\nmotocicleta.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Memoricé el mapa durante los pocos segundos que lo pude ver y lo dibujé apenas\ntuve la oportunidad, y ahora buscaba el lugar del 'Umoreginoya' descrito en\nel mismo.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Probablemente fue el cambio de actitud en Saki cuando mencioné a 'Mizuna\nNakamura' lo que captó mi atención. Llevo un largo tiempo conociéndola, jamás\nla había visto con esa cara.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_kid_000160",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No me cuesta tanto memorizar figuras en una fracción de segundo... pero, un\nmapa completo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Si bien era muy difícil buscar algo de un mapa que solo vi por un instante, me\nconocía muy bien la zona y pensé que no habría problema.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Además, la residencia que aparecía descrita en ese mapa era enorme, lo cual me\nconfió de que podría encontrarla.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Me bajo de la motocicleta.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_kid_000161",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pensé que era por acá, pero...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Para este momento sentía que ya había recorrido el mismo camino una y otra vez.\nQuizá sea mejor buscar caminando... pensé, pero entonces.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bgm",stop=1,time=500},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000622",ch="aid"},
},
ja={
{
name={"???"},
"“¡Intruso!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000162",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Intruso?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000163",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eh? ¿Dónde?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000623",ch="aid"},
},
ja={
{
name={"???"},
"“¡Tú!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_kid_000164",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"cgdel",id=-1},
{"bg",speed=400,sync=0,file="zbg001b",path=":bg/",x2=200,y2=-90,x=0,y=-90,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="藍",size="z2",speed=400,sync=0,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2i0000",face="i0005",head="aix_z2i",x2=200,x=0,lv=5,id=9},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
"Apenas volteé a ver a donde escuché la voz venir, me encontré con una diminuta\nniña frente a mí.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_kid_000165",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué sucede, pequeña? ¿Por qué me llamas intruso?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2i0000",face="i0006",head="aix_z2i",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000624",ch="aid"},
},
ja={
{
name={"???"},
"“¡Estabas pasando una y otra vez frente a la residencia! ¡En una motocicleta muy\nruidosa! ¡Eres un delincuente, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kid_000166",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Residencia?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Vuelvo a examinar mis alrededores.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_kid_000167",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Ya veo. Lo había pasado por alto por completo.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"En la siguiente calle había, ciertamente, algo que parecía la entrada a una\nresidencia.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="man_kid_000168",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahhh, me había equivocado en una calle...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000625",ch="aid"},
},
ja={
{
name={"???"},
"“¡¿A-Así que sí viniste por nosotros?!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_kid_000169",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esto... muchacha, ¿eres hija de los Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0006",head="aix_z1i",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000626",ch="aid"},
},
ja={
{
name={"???"},
"“¡No tengo razón para darle mi nombre a un extraño! ¡Te va a doler mucho si no\nte vas ya!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_kid_000170",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me dolerá, eh, ajajaja... Haga lo que haga una niña como tú no me dolería.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000627",ch="aid"},
},
ja={
{
name={"???"},
"“¡Hum!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"msgoff"},
{"fg",ch="藍",size="z2",sync=1,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2i0000",face="i0005",head="aix_z2i",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",sync=1,lv=5,id=9},
{"msgoff"},
{"se",id=1,file="se_punch_swing"},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"ex",time=200,func="wait"},
{"se",id=2,file="se2023"},
{"bg",file="閃光小",id=9,lv=9,time=200,path=":cg/battle/",set="battle"},
{"ex",time=200,func="wait"},
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg001b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000171",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡GYYAAAAAAAAAaaahhhhh!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0006",head="aix_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000628",ch="aid"},
},
ja={
{
name={"???"},
"“¡¿Qué tal, intruso?! ¡¿Has aprendido tu lección?!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"mwact",act="おじぎ"},
{"text"},
text={
vo={
{"vo",file="man_kid_000172",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“GWOOOH, qué estúpido fui... M-Me descuidé totalmente... Era más que obvio que\nuna niña de su altura me golpearía ahí...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000629",ch="aid"},
},
ja={
{
name={"???"},
"“¡Si sigues intentando acercarte a Mizuna nee-sama haré que te duela más!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="man_kid_000173",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Mizuna nee-sama?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000068",ch="mzd"},
},
ja={
{
name={"???"},
"“¿Profesor Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x2=0,x=-345,lv=4,id=9},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0012",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_000174",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“T-Tú... Mizuna-kun.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000630",ch="aid"},
},
ja={
{
name={"???"},
"“¡Mizuna nee-sama, este intruso estaba merodeando alrededor de nuestra casa!\n¡Seguramente es uno de ellos!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0012",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000069",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ah, no... él no. Es maestro en mi colegio...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000631",ch="aid"},
},
ja={
{
name={"???"},
"“¿Maestro?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="man_kid_000175",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“S-Sí lo soy...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000632",ch="aid"},
},
ja={
{
name={"???"},
"“Eres muy débil como para ser un maestro...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000176",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Que sea maestro no me hace fuerte, y cabe recalcar que nadie aguantaría un\ngolpe entre las piernas!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000633",ch="aid"},
},
ja={
{
name={"???"},
"“Pero el maestro de mi dojo es más fuerte.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0016",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000070",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ai-chan, él no es un maestro de artes marciales, es un profesor de pintura.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000634",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pintura? ¿Dibujos?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000071",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí, dibujos.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000635",ch="aid"},
},
ja={
{
name={"Ai"},
"“Profesor, profesor, ¿eso quiere decir que eres bueno dibujando?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"La expresión de completa desconfianza de la niña desapareció como por arte de\nmagia, y ahora me preguntaba eso inocentemente.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="man_kid_000177",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, algo, sí...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0004",head="aix_z1i",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000636",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Dibuja a Pika*hu y Mi*key!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="man_kid_000178",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Uhmmm, está difícil... Cuestiones de copyright.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000637",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Copi, rait?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="man_kid_000179",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, no es nada. Cosas mías.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000072",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Y qué hace acá, profesor?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_kid_000180",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, nada. Solo pasaba casualmente cerca...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000638",ch="aid"},
},
ja={
{
name={"Ai"},
"“Está mintiendo, estuvo pasando varias veces por acá. Creo que vino a verte,\nMizuna nee-sama...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0012",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000073",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Vino a verme a mí?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_kid_000181",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“P-Pues, siendo sincero, sí...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000074",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“A mí...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bgm",stop=1,time=2000},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"El rostro de Mizuna tomó una expresión alegre por un momento, pero justo\ndespués se ensombreció.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",mode=-2,sync=0},
{"bg",x=-600,file="zbg001b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="水菜",size="z2",mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0400",face="a0006",head="miz_z2a",lv=5,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000075",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No se acerque más a esta residencia, por favor...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_kid_000182",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mizuna-kun.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Intento acercarme a Mizuna justo después de que me pidiera alejarme, pero...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"quake",size=5,mode="mw"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000639",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Si te acercas más te daré otro buen golpe!”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="man_kid_000183",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Wa, wawawah, espera, todo menos eso! ¡Si vuelves a darme otro golpe de esos no\naguantaré mucho!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000640",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",mode=-2,sync=0},
{"bg",file="bg001b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=5,sync=0},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0400",face="a0001",head="miz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000076",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ai-chan, no hace falta que recurras a eso. El profesor no es mala persona...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000641",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mizuna nee-sama...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0400",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000077",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Profesor, váyase ya, por favor. Este no es lugar para alguien como usted.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
