},
block_00244={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0018",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000642",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Este no es lugar para ti!”",
{"rt2"},
},
},
},
