astver = 2.0
astname = "ast"
ast = {
block_00000={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"bg",file="znightsky_summer",id=9,lv=9,speed=240000,time=1500,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"El propio sonido de mi respiración me hace recobrar el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué me pasó?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Parece que estuve desmayado.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"¿Perdí el conocimiento por el calor?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"¿Se me enredaron las piernas y me tropecé?",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"¿Me tropecé cuando sentí que mi consciencia se estaba nublando?...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Ni siquiera sé de qué manera me desmayé.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Frente a mis ojos se veían las estrellas, mucho más brillantes de lo usual.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"¿Por qué las estrellas estarán más brillantes de lo usual?...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mierda... hasta las estrellas se me hacen encandilantes...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"¿Será que se me dilató la pupila?...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"¿Pero no se supone que la pupila se debería dilatar al morir?...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy muerto, ¿o sí?...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Muevo mis piernas y brazos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Estoy bien. Sentí algo de calambre, pero mis extremidades se mueven\ncorrectamente.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me puedo mover...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_sud_000184",ch="sud"},
},
ja={
{
name={"???"},
"“Qué interesante se ve eso a lo que juegas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... ¿q-quién es?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg057g",path=":bg/",sync=0},
{"extrans"},
{"fg",ch="吹",size="z2",mx=-40,mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000185",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui. ¿Por qué estás encendiendo una estufa en verano y corriendo alrededor de\nella? ¿Se trata de algún nuevo tipo de juego?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué demonios? Oye, ¿qué haces aquí?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0004",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000186",ch="sud"},
},
ja={
{
name={"Sui"},
"“Mientras caminaba frente al colegio escuché un ruido de adentro, así que usé\neste fénec y me metí en la escuela.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Espera, ¿pero qué demonios hace esta muchacha rondando el colegio a\nmedianoche?...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Usando al fénec?... ¿No habrás roto la pared con esa palanca para entrar, o\nsí?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0006",head="sui_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000187",ch="sud"},
},
ja={
{
name={"Sui"},
"“Estás poniendo en duda la inteligencia de Sui, Kusanagi-san. ¡Sui no es capaz\nde hacer algo tan estúpido! ¡Clavé este fénec a la pared y la escalé, con\ntodas las de la ley!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene de legal eso?... Mmm...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",file="se9010",id=1},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000188",ch="sud"},
},
ja={
{
name={"Sui"},
"“A ver, ¿aún puedes moverte?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sea lo que sea, no tengo tiempo para andar jugando contigo...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000189",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pensé que el juego había terminado ya. ¿Seguirás jugando?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto. Mientras mi cuerpo siga moviéndose, seguiré.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000190",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pareces estar sufriendo bastante... ¿Por qué sigues haciéndolo?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues hay una persona con quien tengo una deuda que pagar... Debo culminar este\njuego por él...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo pasarme toda la vida sin saldar mis deudas...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000191",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, ¿y piensas jugar solo, así como ahora?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy jugando...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000192",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿No acabas de decir que era un 'juego'?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo era una forma de decir las cosas...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000193",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh... Parece que estás jugando a un juego bastante misterioso.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Al decir eso Sui, comenzó a hojear y ojear los planos de diseño de Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces viendo eso sin permiso?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000194",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya entendí buena parte del asunto. Es un juego que consiste en estampar los\nmismos lugares que este dibujo, ¿cierto?... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que no es un juego...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000195",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Cuántas horas te tomó hacer todo esto?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Hora?!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Reviso mi reloj.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"La hora marcaba más de las 2 AM.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ya son las 2... Apenas queda la mitad del tiempo original para el\namanecer... Habiéndonos tardado 4 horas para esto, no creo que...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Vuelvo a calentar los uwabaki con la estufa.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mierda...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Sinceramente, esta labor es bastante dura y agotadora. Pero qué caliente está\nesto...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"No es de sorprenderse que Akashi haya terminado con el cuerpo de esa manera. De\nverdad, aguantó bastante...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0004",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000196",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, alrededor de 1 tercio en 4 horas. Ya veo, ya veo. Fufufu, reescribiré ese\nrecord con bastante facilidad.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000197",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vamos, rápido, Kusanagi-san, tú trabajarás en la estufa. ¡Sui estampará a alta\nvelocidad!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Y al decir eso, me arrebató el uwabaki derretido de mis manos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="吹",my=-40,mode=-1,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000198",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ja!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",time=100,sync=1,file="black",path=":bg/"},
{"se",file="se_arrow1",id=1},
{"bg",file="battle_008r",id=9,lv=9,rule="106r",time=100,sync=1,path=":cg/battle/",set="battle"},
{"bg",rule="106r",time=100,file="black",path=":bg/"},
{"cgdel",id=-1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Pero qué rapidez... ¿O más bien, fuerza de salto?",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Esa altura es ridícula, ¿es que acaso eres una jugadora profesional de\nbaloncesto?",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Sui logra hacer saltando con bastante ligereza aquello para lo que nosotros\nrequeríamos usar escaleras.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Su tiempo de vuelo es descabellado.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="bg057g",path=":bg/"},
{"fg",ch="吹",size="z1",my=-40,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_sud_000199",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué tal?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Umuh...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"La posición es precisa.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"O más que precisa, debería decir que hasta más preciso que cuando yo lo estaba\nhaciendo.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Vaya que puede hacer esa clase de trucos sin usar escalera... ¿Pero qué diablos\nes esta muchacha?...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000200",ch="sud"},
},
ja={
{
name={"Sui"},
"“Venga, funde rápido los uwabaki, por favor. Crearemos un nuevo record.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"La verdad es que quisiera replicarle muchas cosas, pero no hay tiempo para eso\nahora.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Solo hay algo que debo hacer ahora.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Entiendo, está bien! Yo me encargaré de la estufa, así que tú ve estampando.\n¡Eso sí, siendo fiel al dibujo original! No trates de estampar donde te dé la\ngana.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000201",ch="sud"},
},
ja={
{
name={"Sui"},
"“Jejeje, decirle eso a alguien con una precisión sin par como la de Sui es una\nridiculez. Kusanagi-san. ¡Sui es una máquina! ¡La precisión de una máquina es\nanormal!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien, en fin, vamos a trabajar.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Vuelvo a calentar los uwabaki con el calor de la estufa.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000202",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Vamos, rápido!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya lo sé.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Voy dándole órdenes a Sui mientras veo el boceto.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Ella va estampando con una velocidad y precisión incomparables a las de un\nhumano normal.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Caliente es poco para describir esto.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"En primer lugar, aún tratándose de artículos defectuosos, la temperatura de\nahora es suficiente para derretir los uwabaki.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"El calor de pleno verano y el abrasador ardor de la estufa.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Si el Infierno de verdad existe, entonces debe ser así. Era tal el calor, que\nno podía evitar pensar eso.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Akashi está aún desmayado al lado.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Es sorprendente que haya podido hacer esto solo hasta ahora...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Pudimos simplemente habernos intercambiado en turnos y ya...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"No, supongo que incluso ese tiempo le era muy preciado como para malgastarlo\nintercambiando lugares...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Incluso de a dos, es un misterio si realmente se pueda terminar esta obra antes\ndel amanecer.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Y por eso todo este tiempo, estuvo él solo...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mierda... Te pavoneaste demasiado... idiota...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000203",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Vamos! ¡Hay que apresurarse!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo sé!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="white",path=":bg/"},
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"se",loop=1,id=1,file="se1299"},
{"text"},
text={
ja={
{
"...... *chun*... *chun...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",time=1500,file="ev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasó?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"¿Me desmayé de nuevo?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"No, espera, ¿en qué momento?",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"¿Fue cuando Sui comenzó a ayudarme?",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"¿O fue mucho antes?",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Me paro.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",zoom=120,speed=120000,file="zbg057j",path=":bg/",x2=1344,y2=756,x=960,y=756,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Observo la pared de la iglesia que tengo frente a mí.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"La obra ha avanzado bastante.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fue Sui?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"¿O es que acaso eso fue un sueño, y simplemente todo lo hice yo en medio de un\ntrance?",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Veo a mis alrededores, pero en ninguna parte puedo encontrar a Sui.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ha avanzado bastante, pero...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Se escucha el gorjeo de los gorriones.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"El momento antes del amanecer. El cielo está tornándose poco a poco ligeramente\nbrillante.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo lograremos a tiempo...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Avanzamos hasta una buena parte, pero... así como van las cosas, no se logrará\na tiempo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Por más que se avance esta obra, no sirve de nada si no se culmina.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"En este momento, no hemos completado la obra de Kenichiro Kusanagi. Simplemente\nsomos culpables de haber hecho unos horrendos garabatos en la pared.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Criminales, eh...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Simplemente somos criminales, vándalos...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Un arte inconcluso, que trató de ser y no fue, no tiene ningún valor. Es solo\neso, un garabato.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldita sea...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Golpeo el suelo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",stop=1,id=1,time=500},
{"bg",file="bg057j",path=":bg/"},
{"bgm",file="bgm018"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001423",ch="mkd"},
},
ja={
{
name={"???"},
"“Si golpeas el suelo, vas a destrozar tus valiosas manos.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué valor pueden tener mis manos?!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001424",ch="mkd"},
},
ja={
{
name={"???"},
"“Lo son. Las manos de Naoya Kusanagi son valiosas... Aunque ahora no pintes...\naun así, ese brazo derecho es muy valioso... No es algo que tú puedas\ndestrozar como si nada...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="真琴",size="z1",time=1000,sync=1,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001425",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Justo lo que me imaginé.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",my=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000487",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001426",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen que detrás de todo crimen siempre hay dinero y mujeres. No soy\nespecialista en mujeres, así que investigué el flujo de dinero.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",file="se2497",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001427",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Toma, son las copias de los recibos de entrega.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Recibos de entrega?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001428",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, pesqué por todos los tipos de disolventes orgánicos, pero también conseguí\nmuchas otras cosas. Este es de un pulidor con disco de diamante.\nProbablemente fue esto con lo que se pulió el mármol, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000488",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001429",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes una cara de '¿Cuándo lo descubriste?', eh. Desde hace mucho. Lo descubrí\nen el momento en que te pillé al haber gastado todo el presupuesto. Revisé\ntodos los recibos de envío...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_wtd_000489",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así que lo sabías todo desde un principio... Idéntica a un bufón, eh.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001430",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que tuviste que gastar bastante dinero, ¿no es así? Y por eso también\ndebiste usar el dinero del presupuesto.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001431",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Viniste con puras mentiras, diciendo que lo habías tomado prestado, o que lo\nhabías usado en el pachinko. Necesitabas dinero para culminar la reforma de\nesta iglesia. Y aun así, no te preocupaste en hablarme al respecto.\nSimplemente seguiste acumulando mentira tras mentira...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no lo recrimines tanto. Akashi debió haber tenido dinero suficiente como\npara realizar una restauración de gran escala sin necesidad de usar el\npresupuesto del club, en un principio...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001432",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nah, cosas mías...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Demonios, Akashi!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Le lanzo una mirada feroz a Akashi.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por eso te dije que recibieras tu parte del dinero!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000490",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Cierra la boca! ¡Yo no quería ese mísero dinero!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001433",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero de qué están hablando? No estoy entendiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000491",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es otro asunto. Y uno que terminó hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000492",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por otro lado, ya debí haberte regresado todo el dinero. ¡No tienes derecho ni\nrazón alguna a meterte en mi camino a este punto!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001434",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vine para impedir que cortaras todo vínculo con nosotros y que hicieras lo que\nte viniera en gana solo con la excusa de haber pagado. ¡No puedo dejar que te\nsalgas airoso tras pagarme una suma insuficiente!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000493",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El monto está completo, ¿no? Te regresé la misma suma que gasté. Aparte de los\ntrabajos de medio tiempo normales, tuve que agarrar trabajo nocturno también,\nno fue nada fácil...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001435",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No es nada suficiente! ¡¿Es que acaso no sabes que en el mundo existe algo\nllamado tasa de interés, Akashi-senpai?!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0007",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000494",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Intereses?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0006",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001436",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿No es acaso obvio?! Te tomaste prestado todo el presupuesto de un período\ncompleto, así que pienso cobrarte una buena suma en intereses a cambio.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001437",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y por supuesto, a diez por diez! Ehm, a ver, calculando eso...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿10 % por cada 10 días?! ¡¿Pero es que eres de los Yakuza o qué demonios?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_wtd_000495",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso es pedir sobrepago! Te voy a demandar.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0018",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001438",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes demandarme cuando pagues aunque sea un solo centavo. Y bieeen,\n¡obviamente que no es momento para andar hablando estas pistoladas ahora!\n¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_rna_000330",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, vaya, lo han hecho en grande.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6,sync=0},
{"extrans"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000719",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, dejar esto a medias sería lo mismo a tener un gran garabato, y de una\nescala muy problemática.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa y Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000953",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso creen? A mí me parece que se ve muy hermoso ya de por sí.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_000331",ch="rna"},
},
ja={
{
name={"Rina"},
"“La elección de colores es muy buena, así que no puedo negar que aun en este\nestado se ve hermoso. No se podía esperar menos del diseño de un genio.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",time=500,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=-345,lv=4,id=5},
{"fg",ch="稟",time=400,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001439",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A ver, a ver.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001440",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ohhh, así que este es el plano de diseño de Kenichiro Kusanagi...\nCiertamente, es increíble.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rna_000332",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muéstramelo a mí también, por favor.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000954",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah, es toda una obra propia de un pintor con renombre internacional...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001441",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno, es una obra diseñada por el Kenichiro Kusanagi antes de\nconvertirse en pintor con fama internacional.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todas ustedes... ¿Qué hay de su campamento?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que salen hoy en la mañana, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001442",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... Así estaba planificado...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Planificado?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001443",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así estaba planificado.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000720",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuu... Por eso dije que los odiaba a ustedes. Así como ahora, involucran a un\nmontón de gente y hacen de todo un desastre...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000333",ch="rna"},
},
ja={
{
name={"Rina"},
"“Teníamos planeado ir al campamento... Aunque Toritani-senpai lucía algo\nextraña, así que finalmente terminamos enterándonos nosotros también.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se enteraron?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000955",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque si no lo hubiésemos hecho entonces quizás hubiéramos podido ir al\ncampamento...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000334",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya después de enterarnos, no seríamos capaces de parar algo tan divertido.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_wtd_000496",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiota, podrían expulsarlas...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000721",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, si es por eso, no hay problema. Declararemos que tú nos engañaste,\nAkashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000335",ch="rna"},
},
ja={
{
name={"Rina"},
"“Diremos que el senpai nos mintió, diciendo que el colegio había encargado la\nelaboración formal de esto.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_wtd_000497",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Creen que ese tipo de excusas va a funcionar?...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000336",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues creo que eso no lo sabremos hasta que lo intentemos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿de verdad estás de acuerdo con esto? ¿Sabes lo que significa el\nhecho que todos participen en esto? Existe incluso la posibilidad de que el\nclub de arte que tanto has cuidado y por el cual tanto has trabajado\ndesaparezca.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001444",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No entiendes nada... La razón por la cual estoy tan apegada al club de arte...\nSimplemente no entiendes nada de nada. No sé si eres así de tardo, o es que\nte estás haciendo el tonto...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0005",head="yum_z2a",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000722",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa torpeza siempre me irrita a mí también...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿pero por qué tienes un spray en mano? ¿Por qué me tienes en la mira, justo\nen este momento?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",id=1,file="se2500"},
{"quake"},
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, p-pero qué frío.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Tanto la cantidad como el tamaño de las partículas del spray son más grandes de\nlo normal...",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esto... es agua?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0001",head="yum_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000723",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Akashi-senpai, toma tú también...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"se",id=1,file="se2500"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000498",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Nyoh, c-ciertamente, es frío.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0017",head="yum_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000724",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No vayan a morirse de un infarto, ¿sí? Por ahora, procuren bajar sus\ntemperaturas corporales. De seguir así, morirán de verdad.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000986",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uaaahh, pero qué sueño.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0009",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000104",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“ZZZZZ...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, y Thomas también...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001445",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si tanto sueño tienen, pudieron haberse quedado en sus casas...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000987",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Crees que voy a hacer eso~? No puedo dejar pasar de largo el chance de\nparticipar en un proyecto para completar una obra de Kenichiro Kusanagi~\nUaahhhh.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001446",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puras palabras sin nada de emoción ni pasión en ellas, eh...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",my=40,mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000105",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES, podré espiarles las faldas de manera legal mientras trabajamos, MASU.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_yum_000725",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué tiene eso de legal?!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"se",id=1,file="se2500"},
{"fg",ch="トーマス",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0010",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="quake",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000106",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OHHH, NOOO, MIS OJOS, MIS OJOS, MIS OJOSSS.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000499",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Oigan, oigan, ¿pero qué pretenden hacer reuniéndose todos a estas horas? No les\nhabrá venido la época de rebelión de forma tardía, ¿no? Como para venir a\nromper los vidrios del colegio en la noche o algo así.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001447",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya la noche está por terminar...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001448",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cuánto tiempo más faltaba para la operación?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000500",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿también sabías eso?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001449",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto. Si no fuera así, no nos hubiéramos reunido todos a esta hora...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000337",ch="rna"},
},
ja={
{
name={"Rina"},
"“Además, Toritani-senpai es amiga de las hermanas Akashi... Le bastaba con\npreguntarles para poder enterarse de eso.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras... ya lo sabía practicamente todo, eh.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="man_wtd_000501",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De no ser así, Toritani no se hubiera enojado de esa forma, ah...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001450",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="man_wtd_000502",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Lo sabías todo, y por eso no podías perdonarme que aun así me hiciera el tonto,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001451",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Yo solo... estaba, enojada por haber sido mentida...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000338",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vamos, no es momento para hundirnos en sentimentalismos. Este es momento para\navanzar con la obra. Y no tenemos mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="里奈",time=400,mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0004",head="rna_z1b",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="真琴",time=400,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",time=500,mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=570,lv=4,id=4},
{"bgm",stop=1,time=10000},
{"text"},
text={
vo={
{"vo",file="fem_yum_000726",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aún queda cierto tiempo para la operación, pero el padre despertará en menos de\n1 hora. Debemos completar esto antes de que lo haga.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0110",face="a0004",head="mak_z2a",lv=5,id=6},
{"fgact",ch="真琴",act="うなづく",lv=5,id=6},
{"se",file="se9010",id=1},
{"bgm",file="bgm020"},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0003",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001452",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ouh! ¡Bien, vengan todos!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=680,lv=4,id=2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",x=210,lv=4,id=8},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-680,lv=4,id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_rna_000339",ch="rna"},
},
ja={
{
name={"Rina"},
"“El misterioso plano de diseño. Cada vez que lo veo, entiendo más lo maravilloso\ne increíble que es.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_000727",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todo un genio. La calidad es tan alta que no parece obra del padre de Naoya\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000956",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No. Justamente por ser obra del padre de Naoya Kusanagi-kun, es que tiene este\ngrado de calidad.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001453",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, voy a repartirles sus tareas a cada uno. ¡Yo me encargaré de fundir los\nuwabaki en la estufa!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000503",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiota... Esa no es labor para una muchacha...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001454",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás diciendo? Muy discriminatorias tus palabras, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000504",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vas a quedar bañada en sudor... Y si llega a pasar eso, mira nada más, de tener\nuna sola camisa se te va a traslucir el sostén.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_mkd_001455",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="man_wtd_000505",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque si es por ofrecerte a mostrarnos tu sostén, entonces con todo gusto y\nalegría lo aceptaremos. Pero, no pensé que tuvieras esas inclinaciones\nexhibicionistas, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0006h",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001456",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡A-Akashi-senpai! P-Pero qué estupideces--”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",mode=-2},
{"fg",ch="明石",size="z2",my=40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Akashi se para lentamente.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Sin embargo, y a diferencia de hace un rato, esta vez pone sus pies firmemente\nsobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0002",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000506",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kusanagi... Vaya molestias te he causado... Y pensar que me desmayé yo primero\ndespués de haber dicho tantas fanfarronerías... Pero qué escena tan\nvergonzosa acabo de dar...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien estuvo más tiempo delante de la estufa. Es natural que\nterminaras así después de pasar tanto tiempo allí.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000507",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por supuesto que no, en primer lugar el avance que lograste es incomparable al\nmío... Aunque no sé qué clase de magia usaste para lograrlo...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0001",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000508",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya estoy bien... Yo me encargaré de la estufa. Kusanagi, perdona el abuso, pero\nencárgate tú de estampar la goma.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001457",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Akashi-senpai!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000509",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Cállate! ¡¿Crees que puedo dejar que una mujer haga esto?! ¡Basta con un\nminuto frente a esta cosa para que una muchachita como tú termine\ncompletamente deshidratada!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001458",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Un grito intimidante por parte de Akashi. Nadie jamás había visto algo así.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Akashi, el mismo inútil que siempre anda con una risa ridícula y una actitud\nmuy a la ligera.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Akashi, el mismo del cual nunca se sabe si habla en serio o en broma, el que\nhabla siempre con un tono burlón y en chiste.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Ese mismo Akashi le gritó fuertemente a Toritani, con una expresión de seriedad\ny rectitud que jamás había mostrado.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=8},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, escucha lo que Akashi te dice...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi no está exagerando. Por más que trates de esforzarte, este no es el tipo\nde labor que una mujer pueda hacer...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001459",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pero, claramente Akashi-senpai está...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",mode=-2},
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000510",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Toritani, estoy bien. Ya logré llegar hasta aquí... No hay problema, gracias a\nKusanagi pude descansar lo suficiente... Bien, hora de reiniciar labores...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es... A seguir entonces. ¿Bien, qué haremos ahora?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="man_wtd_000511",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Acerca de qué?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pretendes que culminemos la obra entre los dos?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0001",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000512",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso implicaría no terminarla jamás...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin duda alguna. Es imposible que terminemos lo que falta entre los dos con el\ntiempo que nos queda.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0002",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000513",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De igual forma, toda esta gente fue engañada por mí. Les mentí diciendo que yo\nhabía obtenido permiso del colegio para hacerlo... Si es así, entonces no hay\nde otra...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Te sientes mejor?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0001",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000514",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso te pregunto yo a ti.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que sí... Estoy mucho mejor entrenado que tú...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0002",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000515",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Pero qué disparates balbuceas, imbécil? A diferencia de mí, pasaste todos tus\ndías sin preocuparte por agarrar algo de resistencia al calor... Soy yo quien\nestá mejor entrenado que tú.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se le llama entrenamiento al hecho de cargar un abrigo en medio del\nverano...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000516",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000517",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Misakura y Kawachino! ¡Encarguense de pasarle los uwabaki a los de las\nescaleras, háganlo en forma de carrera de relevo!”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="man_wtd_000518",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kusanagi y Hikawa, suban a las escaleras y reciban los uwabaki allí, y\nestámpenlos en base a las órdenes dadas!”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000988",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Q-Qué hago yo?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="man_wtd_000519",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Thomas y Kei, corten las ramas de este árbol, está obstruyendo la vista.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0006",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000989",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué tengo que ponerme a cortar ramas~?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Correcta decisión.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"De todos los que están aquí, Kei tiene un talento totalmente excepcional, pero\npor eso mismo, existe la posibilidad de que termine alterando la obra de\nKenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Así de enorme es el talento de Kei.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="man_wtd_000520",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=8},
{"fgact",ch="真琴",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001460",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="man_wtd_000521",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Encárgate de mover a todos de manera que el mural sea terminado exactamente\ncomo sale en este boceto. Con toda esta cantidad de personas aquí, de no\ntener a alguien capaz de dar correctamente todas las órdenes, no se podrá\nterminar la obra... ¿Puedes hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001461",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, puedo hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000522",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Buena respuesta... No podía esperar menos de mi sucesora...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000523",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Escúchenme bien, todos! ¡Esta es la última orden del jefe número 89 del club\nde arte de Yumihari, Wataru Akashi! ¡Ejecuten todas las tareas que les he\nordenado, y culminemos esta obra!”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="man_wtd_000524",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Culminaremos esta obra póstuma de Kenichiro Kusanagi con nuestras propias\nmanos!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=8},
{"fgact",ch="真琴",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001462",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Así es!”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001463",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los cerezos enigmáticos. Los enigmáticos cerezos milenarios que Komaki aseguró\nhaber visto.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001464",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Los cerezos que florecieron en pleno verano!”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001465",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen las leyendas que aun bajo el glacial frío del invierno, aun bajo el\nabrasador calor del verano, aquellos cerezos florecían de forma hermosa.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0006",head="mak_z1d",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001466",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y ahora, haremos florecer esos cerezos! ¡Nosotros, el club de arte de\nYumihari!”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25",sync=0},
{"extrans"},
{"text"},
text={
ja={
{
"Gritos de alegría.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Rin y Kawachino corriendo.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Hikawa y yo, pegando la goma fundida sentados sobre las escaleras.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Kei y Thomas, cortando las ramas del árbol de manera que el mural se pueda ver\nperfectamente desde la habitación del padre.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Toritani, dando las órdenes.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"La velocidad de trabajo que tenemos ahora es incomparable a la de hace un rato.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"bg",file="zev_com_a34_01",speed=300000,path=":ev/ev_com_a34/",set="ev_com_a34",x2=-960,y2=540,x=430,y=450,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_yum_000728",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Hace bastante calor!”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rna_000340",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhh, lo siento. Está bastante fresco acá arriba en las escaleras. Gracias al\nventilador.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="fem_yum_000729",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así, estás bañada en sudor, Rina... ¿Estás bien? Tu cuerpo no es muy\nfuerte...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_000341",ch="rna"},
},
ja={
{
name={"Rina"},
"“No soy tan débil como para deteriorar mi salud haciendo esto. Aunque bueno,\ndespués de todo...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_yum_000730",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Te estás divirtiendo.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="fem_rna_000342",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me estoy divirtiendo. ¿Y tú, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_yum_000731",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Yo? Yo...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_yum_000732",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me estoy divirtiendo, ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Kawachino sonríe. Con una sonrisa muy, muy rara.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000957",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble. La obra está avanzando a una marcha totalmente increíble.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001467",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún, aún falta. ¡Debemos culminar esta obra antes de que el padre despierte,\nantes de que la noche desaparezca y amanezca por completo!”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"La labor a realizar es técnicamente la misma que la de hace un rato.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Lo que sí se puede aseverar es que las condiciones de trabajo son terribles.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"No es la clase de situación en la que uno se podría divertir de ninguna forma.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Trabajar bajo estas condiciones tan terribles, y además sumado a eso, teniendo\nla posibilidad de que al dar un paso en falso, terminemos todos expulsados.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"No debe, ni debería ser nada divertido.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Y a pesar de eso.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="man_ked_000990",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Genial, genial, cada vez está tomando más forma!”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001468",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Se me pusieron un poco los pelos de punta...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_rna_000343",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhh, no puedo ver mucho trabajando de tan cerca...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="man_tmd_000107",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“NOOO, es imposible ver por debajo de las faldas desde acá... ¡¡NOOO!!”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_yum_000733",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Genial, genial, genial.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000958",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto emociona bastante. Increíble. Esto es totalmente increíble.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="fem_yum_000734",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Sí, es increíblemente divertido!”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="man_ked_000991",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Bien, parece que ya todos están en fuego, en llamas! ¡Esto es destructor,\navasallador, todos están encendidos!”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="man_wtd_000525",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todo este tiempo estuve imaginándomelo, pero... Ciertamente, la obra verdadera\nes distinta...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Me abrazo a mí mismo, poniendo mis manos sobre mis hombros.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"Estoy temblando.",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"¿Estoy emocionado?",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Lo estoy también...",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Pero, aún más que eso...",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estoy divirtiendo?...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"bg",file="ev_com_a34_01",path=":ev/ev_com_a34/",set="ev_com_a34"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001469",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jejeje... ¿Pero qué vienes a decir ahora? Obviamente que te estás divirtiendo.\n¡Y es que esto, es tan divertido!”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Divertido...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001470",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bien, ya estamos cerca de la culminación! ¡Pero tampoco queda tiempo!\n¡Muchachos, subiremos la velocidad ahora! ¡Vamos a poner todo nuestro\nesfuerzo! ¡¿Les quedó claro?!”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"Todos gritan de júbilo.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"La noche va aclarándose.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"El cielo comienza a teñirse de blanco.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Los cerezos encubiertos por la oscuridad e iluminados solo por la luz de la\nestufa, comenzaban ahora a mostrar poco a poco su figura.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Gracias a la luz del sol, los cerezos comienzan a brillar con colores más\nvivos.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"Sonrisas.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"Aún empapados en sudor, ensuciados con tierra y polvo, cubiertos con la goma\nendurecida que había caído, los uniformes de todos bailaban y se movían de un\nlado a otro alegremente.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
"De alguna forma, entendí el otro significado que encerraba esta obra.",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"Entendí que los uwabaki representaban las huellas de los calzados de los niños.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"La capilla después de que los niños corrieran alrededor y se fueran.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Para el padre, quien se la pasaba limpiando este lugar, debe ser un escenario\nbastante familiar.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"Todas esas huellas estaban esparcidas alrededor, como pétalos de cerezos.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"Los dueños de esas pisadas dejan sus huellas para luego desaparecer...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"Pero las huellas de los niños permanecen.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
"Para el padre, quien ha estado un largo tiempo enseñando a los niños en las\nescuelas dominicales, debe ser el escenario que más cercano y familiar se le\nhace.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
"Las huellas de los niños al irse, y los pétalos de cerezos esparciéndose.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"Sin embargo, eso se repite, una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"Los cerezos florecen este año también, y de igual manera, los niños vuelven a\nvenir.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Una vez más, vendrán nuevas huellas acá.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
"La obra de Kenichiro Kusanagi. 'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
"Esta obra encierra ese significado.",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"Pero... no solamente ese.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muy típico de él, eh...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Ahora que lo pienso, se me hace obvio.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
ja={
{
"Es imposible hacer todo esto solo.",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
"Lo mismo aplica para Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"De ser así, entonces probablemente robamos la diversión de Kenichiro Kusanagi,\ny la del padre... y además, la de todos los niños.",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="man_wtd_000526",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“A juzgar por esa expresión, pareces haberte dado cuenta ya, eh...”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Igual tú...”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="man_wtd_000527",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo... Así que de eso se trataba...”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Hubiera sido mejor hacerlo así como ahora, desde un principio.”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001471",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué hay con esas caras de funeral de ustedes?! ¡Vamos, ustedes también\ntrabajen, trabajen! ¡Ya el amanecer está por llegar!”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
vo={
{"vo",file="man_wtd_000528",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hii, hasta hace un momentito estuve mareado y tambaleando, trátame con un poco\nmás de cariño.”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001472",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Si vas a decir eso ahora, entonces pudiste haberme dejado que yo lo hiciera!\n¡Vamos, funde más, más!”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"La otra temática de esta obra.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
"Esa otra temática es lo que hay ahora en este lugar. 'Sonrisas'.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
vo={
{"vo",file="man_wtd_000529",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Él diseñó esto para que el padre y los niños pudieran construir la obra juntos,\ndivirtiéndose...”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se supone que esto se debe hacer entre muchas personas. De solo pensarlo es\nobvio. Es imposible hacerlo solo.”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde un principio, era una obra destinada a ser realizada entre varias\npersonas, todos riendo y divirtiéndose...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
vo={
{"vo",file="man_wtd_000530",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así parece, eh...”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La herencia de Kenichiro Kusanagi... Sí, ciertamente da toda la sensación de\nherencia...”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Una obra con la cual los niños y el padre pudieran divertirse y entretenerse,\ncomo si fuera un juego... De eso trata esta obra, 'Las huellas de los\ncerezos'.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
vo={
{"vo",file="fem_rna_000344",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ahora?”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
vo={
{"vo",file="fem_yum_000735",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y el próximo uwabaki?”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000959",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El próximo uwabaki está...”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"bg",file="ev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001473",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
vo={
{"vo",file="man_wtd_000531",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001474",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muchachos, acérquense todos acá, donde estoy yo...”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
"Llamados por Toritani, todos los miembros del club que habían parado sus manos\nse reunieron en ese lugar.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"Un lugar un tanto alejado de la pared.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"El sol sale.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"El lienzo recibe la luz del sol por detrás.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Y allí――",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"bg",time=2000,file="white",path=":bg/"},
{"msgoff"},
{"bg",zoom=100,speed=2000,file="ev_uni_c24_01",z2=120,path=":ev/ev_uni_c24/",set="ev_uni_c24",sync=0},
{"extrans",time=2000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001475",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Hemos culminado!”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000960",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
vo={
{"vo",file="fem_rna_000345",ch="rna"},
},
ja={
{
name={"Rina"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="fem_yum_000737",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Waaah.”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
vo={
{"vo",file="man_ked_000992",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Esto, es genial!...”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="fem_yum_000738",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh... es realmente impactante.”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"bg",file="bg057j",path=":bg/"},
{"text"},
text={
ja={
{
"Después de haber entretenido a sus creadores, esta es la obra completa,\nresultante...",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
ja={
{
"¿Qué clase de cerebro habrá tenido ese hombre?",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La obra póstuma de Kenichiro Kusanagi... ha sido terminada...”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-760,lv=4,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-395,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",x=0,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=395,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=750,lv=4,id=2},
{"fgact",ch="圭",act="びっくり",lv=4,id=1},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_rna_000346",ch="rna"},
{"vo",file="fem_rnd_000961",ch="rnd"},
{"vo",file="fem_mkd_001476",ch="mkd"},
{"vo",file="fem_yum_000739",ch="yum"},
{"vo",file="man_ked_000993",ch="ked"},
},
ja={
{
name={"Todos"},
"“¡Lo logramos!”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",my=40,mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0006",head="tho_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_tmd_000108",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH, NOOO.”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
vo={
{"vo",file="man_tmd_000109",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“No tuve ni una sola oportunidad. Tan despiadado. Tan efímero este mundo, DESU.”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Limpiamos con agua la tinta usada para describir las coordenadas.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
"Y al hacerlo, la obra mostró su figura culminada.",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"text"},
text={
ja={
{
"Los pétalos de cerezos son las huellas de los niños.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
ja={
{
"La capa base tiene algo de blanco con un tenue tono rojizo, de manera que se\nresalten y aprovechen al máximo los pétalos de todo el lienzo.",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
"Gracias a esa capa base pintada con un tenue tono rosado, las huellas frontales\nparecen unos pétalos de cerezo flotando suavemente, como si se tratara de una\nilusión.",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
"Al ver la obra de lejos se percibe una sensación de profundidad, dando la\nilusión de sobre los pétalos adheridos hay otras capas de pétalos.",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
ja={
{
"Y los vitrales.",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
ja={
{
"El interior de los vitrales parecía un enorme cielo azul, extendiéndose hacia\nel infinito.",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
ja={
{
"Dentro de ese infinito cielo van, también, siendo tragados los pétalos de\ncerezo.",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
"Sin embargo, esos pétalos van convirtiéndose en alas.",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
ja={
{
"De las huellas de los niños a los pétalos de cerezo, para luego convertirse, al\nvolar por el vacío del cielo, en las alas de los ángeles.",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
"Una composición maravillosa.",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
ja={
{
"Un diseño maravilloso.",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
ja={
{
"Y una temática absolutamente maravillosa y espléndida.",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"bg",file="bg057j",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será ya la hora de que el padre despierte?”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0001",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000532",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No estás arrepentido?”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0002",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000533",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Qué pregunta tan estúpida...”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
"Se escuchan las voces de enfado viniendo desde el edificio del colegio.",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
"¿Habrán despertado los profesores que estaban de guardia en el colegio?",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"En fin, alguien viene corriendo con bastante fuerza hasta acá.",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos van a expulsar.”",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0001",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000534",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Con que no nos agarre la policía ya es una bendición del cielo, ¿o no?...”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
ja={
{
"Akashi y yo nos reímos.",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"text"},
text={
ja={
{
"¿Estará viéndonos el padre?",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
ja={
{
"Y.... ¿Kenichiro Kusanagi también?...",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
