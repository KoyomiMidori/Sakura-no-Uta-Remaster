astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c01_01",path=":ev/ev_eye_c01/",set="ev_eye_c01"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"se",file="se9002",id=1},
{"ex",time=1000,func="wait"},
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=1500},
{"bgm",file="bgm036"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me paro en la cocina y preparo el café.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Un aroma que no encaja para nada con las cocinas de Japón envuelve el lugar.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Sirvo algo del café recién hecho a mi taza, y mientras bebo un poco de ella,\npreparo el desayuno.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Se siente el aroma del pan tostándose mientras que los huevos revueltos y el\ntocino se freían, emitiendo ese particular sonido crepitante al freír.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"A pesar de que debería ser el mismo escenario de siempre, es completamente\ndistinto ahora.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Comida para 4 personas.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se9010",vol=50,id=1},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0700",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000208",ch="aid"},
},
ja={
{
name={"Ai"},
"“Buenos días. Eres mañanero, eh, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? A mí me parece normal...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0003",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000209",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ohhh, qué desayuno tan maravilloso. Parece un desayuno de hotel.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Me alegra que te guste. Come rápido antes de que se enfríe. Por cierto,\n¿qué hay de Shizuku y Kei?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0011",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000210",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, ya los llamé varias veces, en cualquier momento deberían levantarse...\ncreo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"se",file="se9010",vol=50,id=1},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000033",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buenas~”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿B-Bueno'~?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0016",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000034",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buenas~”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Shizuku levantó una mano, y repitió varias veces lo que parecía ser un saludo\nde buenos días.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Buenos días. S-Si no comes rápido y te vas, llegarás tarde al colegio.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000035",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa~ Comeré~”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"msgoff"},
{"se",file="se9010",vol=50,id=1},
{"fg",ch="雫",sync=1,mx=-40,mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0700",face="e0012",head="aix_z2e",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0700",face="e0008",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000211",ch="aid"},
},
ja={
{
name={"Ai"},
"“A todos los de la familia Natsume les cuesta levantarse temprano. En particular\nShizuku, que suele tener la presión sanguínea baja.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_szd_000036",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Guh~”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y mientras dices eso se está durmiendo de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0700",face="e0015",head="aix_z1e",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0003",head="aix_z1e",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000212",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ja... ¡Vamos, levántate! ¡Shizuku!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",file="se9002",vol=50,id=1},
{"fg",ch="藍",mx=-40,mode=-1,lv=4,id=5},
{"fg",ch="雫",mx=-40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Despertada a la fuerza por Ai, Shizuku se dirigió al lavabo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A los Natsume les cuesta bastante levantarse temprano, eh...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, así que de esa manera reacciona cuando la despiertan a la fuerza...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Al darme cuenta, ya las vacaciones de primavera habían llegado a su fin.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Ya han pasado unos cuantos días desde que comencé a vivir en la casa de los\nNatsume.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"No sabía que el tiempo podía pasar tan rápido como está sucediendo ahora.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Aún no logro terminar de asumir por completo todos los sucesos que han ocurrido\ndurante estas vacaciones.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Pues, en estos pocos días la vida que llevé durante 10 y tantos años tomó un\ngiro inesperado.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z1",mx=1280,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"bgm",file="bgm012"},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000383",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaaah! ¡Esto es grave!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es grave?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000384",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ya vamos a comenzar el colegio!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. A partir de hoy comenzamos el colegio.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0017",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000385",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwah! ¡Wahwah! ¿Por qué estás vestido ya?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, porque en un rato me voy al colegio, ¿será?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000386",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Yo sigo en pijama!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eres un idiota, ¿será?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0022",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0005",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000387",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué estar en pijama me hace un idiota! ¡Si sigues con esos comentarios me\nenojaré!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, vamos, no es momento de que te pongas a armar un escándalo acá. Si no te\ncambias rápido te meterás en problemas después.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="quake",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000388",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaah, esto es graveeee!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"msgoff"},
{"se",file="se9003",id=1},
{"fg",ch="圭",sync=1,mx=1280,mode=-1,lv=4,id=9},
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De veras que mi vida cambió por completo, eh...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Una vez terminan las breves vacaciones de primavera, el nuevo período comienza,\ncomo si de algo totalmente obvio se tratara.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Un nuevo año escolar.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"A partir de hoy, comenzaremos a ser estudiantes de tercer año del colegio\nYumihari.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bgm",stop=1,time=800},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="藍",size="z1",mx=40,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000213",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué andas tan absorto, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai... No, solo estaba observando el exterior de la mansión Natsume.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000214",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es enorme, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vaya que es una mansión inmensa. Solo el costo de mantenimiento ya es\nbastante caro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000215",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es. Nada más el costo de mantenimiento es bastante alto.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sería buena idea que vendieran este lugar y se mudaran a un lugar más\npequeño?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000216",ch="aid"},
},
ja={
{
name={"Ai"},
"“De ninguna manera podría hacer eso... Si no fueras tú ya te hubiera golpeado\npor haber dicho eso.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo lo que tratas de decir. Pero aun así, no tienen necesidad alguna de\nesta mansión tan grande, ¿no? Ahora que todo terminó ya.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000217",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ciertamente... Pero, aun así no puedo soltar esta mansión.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000218",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hay muchos recuerdos amargos en esta mansión, pero sobretodo eso, hay\nmuchísimos más recuerdos maravillosos. Creo que mientras yo siga viviendo\nseguiré protegiendo esta mansión...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí me parece que deberían venderla.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000219",ch="aid"},
},
ja={
{
name={"Ai"},
"“No digas eso a la ligera, idiota.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente ese hombre diría lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000220",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues sí, seguramente Kenichiro-san diría lo mismo que tú.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000221",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero ¿no es eso porque tanto tú como él odiaban a la abuela Natsume?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es que esa vieja era bastante violenta...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000222",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ese es el único punto donde la opinión de Kenichiro-san y la tuya coincidían,\neh.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa vieja era amable con las mujeres, pero terriblemente estricta con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000223",ch="aid"},
},
ja={
{
name={"Ai"},
"“Les dio mucho cariño, ¿no? Sobre todo a ti, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues a mí no me parecía en nada que lo hiciera.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=5},
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000224",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, si no vamos al colegio ya, no llegaremos a tiempo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"Tienes razón.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"se",file="se9004",id=1},
{"fg",ch="藍",speed=2500,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x2=0,x=345,lv=4,id=5},
{"text"},
text={
ja={
{
"Al tratar de caminar en dirección a la estación... Ai comenzó a caminar en la\ndirección opuesta.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ai, ¿la estación no queda en dirección opuesta?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000225",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo voy en motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="藍",sync=1,mx=40,mode=-1,lv=4,id=5},
{"bg",file="ev_com_a11_01",path=":ev/ev_com_a11/",set="ev_com_a11",ax=960,ay=542,bx=0,by=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_aid_000226",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es una motocicleta, una Mach III.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por el nombre pareciera ser bastante rápida, pero se ve bastante vieja y\ndestartalada.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_a11_02",sync=0,face=1,time=400,path=":ev/ev_com_a11/",set="ev_com_a11",ax=960,ay=542,bx=0,by=-2},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a11_01",sync=0,face=1,time=400,path=":ev/ev_com_a11/",set="ev_com_a11",ax=960,ay=542,bx=0,by=-2},
},
},
text={
vo={
{"vo",file="fem_aid_000227",ch="aid"},
},
ja={
{
name={"Ai"},
"“Destartalada, ¿eh? Pues sí, es bastante vieja. Es rápida, pero es famosa\ntambién por ser una motocicleta que solo trae problemas.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué montas una motocicleta que solo trae problemas?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_aid_000228",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues sí, ¿por qué será que monto en una motocicleta que solo trae problemas?...\nLa respuesta es... ¡porque tiene problemas! ¡Pero aun así no me importa!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_a11_02",sync=0,face=1,time=400,path=":ev/ev_com_a11/",set="ev_com_a11",ax=960,ay=542,bx=0,by=-2},
{"mwact",act="うんうん",size=5},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a11_01",sync=0,face=1,time=400,path=":ev/ev_com_a11/",set="ev_com_a11",ax=960,ay=542,bx=0,by=-2},
},
},
text={
vo={
{"vo",file="fem_aid_000229",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajaja, lo siento, esa es una frase de alguien más que me gusta bastante. Por\notro lado, si sigues ahí parado vas a llegar tarde.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"se",file="se9053",id=1,loop=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué demonios?! ¡Qué motocicleta tan ruidosa!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_aid_000230",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es porque tiene un motor de 2 tiempos de 500cc. El sonido es bastante\nparticular.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_aid_000231",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ahh, bueno, supongo que no es nada importante para aquellos que no les interesa\nesto... Bien, ya el motor está lo suficientemente caliente, así que me iré\nya.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",stop=1,id=1,time=500},
{"se",file="se9005",id=2,loop=1},
{"msgoff"},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al soltar un estruendoso sonido, la silueta de Ai desapareció a lo lejos.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Aunque cabe destacar que...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué sonido tan ruidoso.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",stop=1,id=2,time=500},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg040a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
"La colina Yumenouki, recubierta con flores de cerezo...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Los alumnos de Yumehari comienzan su nuevo año transitando por debajo de los\nárboles en completo florecimiento y cruzando el portón del colegio.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"El bullicio de las mañanas que llevaba sin escuchar por cierto tiempo ya.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Al sentir esta atmósfera en mi piel, vuelvo a percatarme de que otro nuevo\nperíodo está por comenzar.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Siguiendo las instrucciones de 'Siéntense en cualquier puesto' escritas\nrápidamente en el pizarrón, posé mis caderas sobre un asiento en la parte\ntrasera del salón.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Supongo que habrán tomado esta medida debido a que se reorganizaron los salones\nal pasar a tercer año, y aún no tienen la lista nueva.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Los otros estudiantes también se sientan en el asiento que más les parece al\nentrar. Algunos con suerte tocaron en el mismo salón que sus amigos, mientras\nque otros se reencuentran con viejos compañeros. Sus reacciones son variadas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Y en lo que respecta a mí...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000389",ch="ked"},
},
ja={
{
name={"Kei"},
"“Volvimos a quedar juntos en el mismo salón, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000390",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Oh? Naoya, estás siendo un poco malvado. ¿Por qué pones esa cara malhumorada?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, justo cuando pensé que me había liberado de esa voz tan escandalosa que\nescucho siempre en casa, me veo ahora perturbado de nuevo por esa voz.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000391",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, ¿estás hablando de nee-chan? Ella trabaja en este colegio también, así\nque es inevitable eso.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"La ironía y el sarcasmo no funcionan con este idiota…",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000392",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, cierto, Naoya. He estado pensando en algo desde ayer.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En qué? Siempre saltas demasiado entre los temas de conversación como si nada,\nhaz una introducción antes de hablar.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="圭",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="圭",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_ked_000393",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Recuerdas la chica del álbum de ayer?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa, pedazo de lolicon? ¿Aún con eso?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0013",head="kei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000394",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo de lolicon no tiene nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Parece que Rin atrajo bastante la atención de Kei, pues no se cansó ayer de\nhablar de ella, y está tratando de comenzar a hablar de nuevo de lo mismo.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"No tenía ganas de hablar del tema, así que fui ignorando las palabras de Kei\nmientras asentía y le respondía brevemente.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000395",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué pasa?! ¡¿Estás escuchándome, Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? Te escucho, te escucho. Estás hablando de que eres un pervertido que le\ngustan las ni*as, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0022",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000396",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=240000,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Observo el cielo desde la ventana.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Este salón está ubicado en la parte central del primer piso de esta edificación\nde tres pisos, así que entra bastante sol.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Incluso los templados rayos del sol de primavera se sienten un poco sofocantes,\nasí que... los veranos son horrendos.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bluesky_spring",id=9,lv=9,path=":cg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"――Y por otro lado, el día de hoy está bastante despejado.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Aunque este cielo tan despejado se muestre ante mí, no puedo hacer nada estando\nencerrado entre estas viejas paredes de piedra.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Pensé en esas cosas mientras observaba la fuertemente soleada colina Yumenouki\nteñida de rosado.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... lo radiante de la primavera me deprime.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000397",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De qué estás hablando? ¿Se te metió el espíritu fantasioso de un prepuberto de\nsecundaria?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es inevitable sentirme deprimido teniendo que comenzar el nuevo período en este\nsalón tan lúgubre con este sol tan brillante de primavera afuera.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000398",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tendremos que pasar nuestros días en el colegio hasta que llegue el verano. Si\ntan solo hubiera algún acontecimiento divertido...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000399",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ah, cierto! ¿Será que vendrá algún estudiante nuevo?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No es normal que alguien se transfiera en tercer año.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000400",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Tu crees?... Si tan solo viniera esa chica...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De nuevo con eso?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mx=-40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000079",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Comenzaron la mañana con muy buenos ánimos, eh.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000401",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh, pero si es Makoto! Estamos de muy buenos ánimos.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El único que está enérgico es este. ¿De qué ángulo me viste como para decir que\nyo también estoy de buenos ánimos?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000080",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? Me parece que por lo general te ves siempre más desanimado. De lo\nque puedo recordar, tanto que parecieras estar a punto de morir en cualquier\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni que estuviera en la fase terminal de una enfermedad incurable...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000081",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es Naoya Kusanagi ese tipo de persona?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, tienes razón. Así soy yo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0001",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000082",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vaya? ¿Te molestaste?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo me fastidié.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si combinas lo irritante de Kei con lo irritante que eres tú, pues cualquier\ncosa terminará fastidiándome.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000083",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa, y ahora abandonas toda voluntad de replicar... Por Dios, qué hombre tan\npoco enérgico, eh. ¿No será que de veras te vas a morir mañana o pronto?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se supone que debo morir?...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000084",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues tus ojos están muertos.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no tiene nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0004",head="mak_z1d",lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000085",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000086",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, estamos comenzando el nuevo período. No voy a pedirte que vayas con\ntodos los ánimos, pero el clima está muy bueno, y los cerezos están\nfloreciendo. No está de más poner una cara más amable, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, trataré de mejorar eso.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0013",head="mak_z1d",lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000087",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, cierto! No me importa lo desanimado que estés, tan pronto termine la clase\nde guiatura y la ceremonia de inicio de año escolar, iremos a cazar a\nestudiantes nuevos para el club.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Esfuérzate mucho.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",file="se3130",vol=60,id=1},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0210",face="d0006",head="mak_z2d",lv=5,id=5},
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000088",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tú también te esforzarás conmigo!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y en qué se supone que debo esforzarme?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0005",head="mak_z2d",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0017",head="mak_z2d",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000089",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te he dicho ya mil veces que vamos a buscar estudiantes de primer año? ¿Aún\ncon esta edad y ya no te sirven los oídos?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No son mis oídos, lo único que no sirve es la relación entre nosotros dos.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0001",head="mak_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0005",head="mak_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000090",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te crees muy cómico diciendo eso? Pues déjame decirte que no.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no lo estoy diciendo para alegrarte.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0028",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000091",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces no está de más que trates de alegrarme de vez en cuando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vine equipado con esos servicios.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, Toritani, estás diciendo eso como si fuera lo más natural del\nmundo, pero quisiera preguntarte algo.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tengo que ayudarte a ti y a tu club a atraer nuevos integrantes de\nprimer año?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0012",head="mak_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0002",head="mak_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000092",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es acaso obvio? Eso es porque tú eres un miembro más de nuestro honorable\nclub de arte del colegio Yumihari, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh... ¿En qué momento me volví un miembro de ese honorable club de arte del\ncolegio Yumihari? No tengo ningún recuerdo al respecto.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0001",head="mak_z2b",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0003",head="mak_z2b",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000093",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tu memoria no es nada confiable. En lo que a mí concierne, Naoya Kusanagi es un\nmiembro más de nuestro club de arte.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, entonces a partir de este momento renuncio a tu honorable club de arte.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0001",head="mak_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000094",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es solo lo que tú piensas, ¿no? Eso no tiene ningún efecto conmigo.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué demonios es eso?!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0200",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000402",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja... Naoya, vaya lío en el que estás metido, eh.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0006",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000095",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Espera, tú sí eres un miembro del club de arte!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Y mientras seguíamos en esa discusión, la cantidad de alumnos que llenaban el\nsalón fue incrementándose.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, deberías irte a tu asiento ya. Ya es la hora de la clase de guiatura.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"se",stop=1,time=500,id=1},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0018",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000096",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ya lo sé! Dejando eso de lado, Kei, Kusanagi, les quedó claro, ¡¿no?! ¡Hoy\nvamos a buscar nuevos integrantes de primer año para el club!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",sync=1,mx=-40,mode=-1,lv=4,id=5},
{"fg",ch="圭",sync=1,mx=-40,mode=-1,lv=4,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Al escaparse el sonido de las campanas por las cornetas, una atmósfera distinta\nhasta ahora comenzó a llenar el salón.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bgm",stop=1,time=1000},
{"excall",file="00_op_04_2"},
{"text"},
linkback="block_00168",
},
label = {
top={block="block_00000",label=1},
},
}
