astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="znightsky_summer",speed=300000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Por cosa rara, esa noche tuve un sueño.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Probablemente por culpa del encuentro con Shoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Tuve un sueño del pasado, de Shoichi Nakamura arrebatándome a mi madre.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Obviamente se trataba de una pesadilla.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"La tristeza era tan grande que sentí como si mi pecho se partiera.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"cgdel",id=-1},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se2766"},
{"mwact",act="うなづく"},
{"text"},
text={
ja={
{
"Del lado de la cama escucho a alguien caer sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=120,file="zbg023d",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule="008b",time=300},
{"se",file="se3130",vol=70,id=1},
{"cgact",stage="zbg023",y=120,act="びっくり",lv=5},
{"text"},
text={
ja={
{
"Me levanto de inmediato.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"No siento sueño al despertar, como todas las mañanas. Lo que quiere decir...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Me encuentro a Kuzu tirada sobre el piso.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuzu!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000289",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Aun llamándola no recibo respuesta alguna. Parece que está inconsciente.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"La levanto cargándola.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",file="se9010",vol=70,id=1},
{"bg",file="ev_com_f03_01",path=":ev/ev_com_f03/",set="ev_com_f03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuzu! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000290",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La sostengo en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Está respirando un poco.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldita sea, se tragó mi pesadilla...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000291",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Su boca se movió un poco.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué intentas decir, Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000292",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"No le sale la voz.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Voy rápidamente por un vaso de agua y lo acerco a la boca de Kuzu.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="ev_com_f03_02",path=":ev/ev_com_f03/",set="ev_com_f03"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000293",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Soltando adoloridos quejidos, Kuzu no bebe del agua.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Demonios, perdóname por esto, Kuzu!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Llevo algo de agua a mi boca. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le doy el agua boca a boca.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Las pesadillas se disuelven con el agua, según me contó el viejo.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Es peligroso darle de beber agua a una persona inconsciente, pero de esta forma\nes que se lidia con un tragasueños cuando le da un ataque.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Y entonces, justo en el momento en que me llevé la segunda bocanada de agua a\nla boca...",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c34_01",rule=7,time=50,path=":ev/ev_uni_c34/",set="ev_uni_c34"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=400,func="wait"},
{"bg",file="ev_com_f03_03",rule=007,time=100,path=":ev/ev_com_f03/",set="ev_com_f03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no me falla la memoria, esa era Rin...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"La persona que vi allí era mi amiga de la infancia, Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Corté todo vínculo con ella hace bastante tiempo. ¿Por qué justamente ahora\nvine a recordarla?",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, estos recuerdos son...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_f03_04",sync=0,face=1,time=400,path=":ev/ev_com_f03/",set="ev_com_f03"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000294",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"*cof*, *cof*.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Kuzu comienza a toser. ¿Será que le entró agua en la traquea?",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Cuido de Kuzu mientras se recupera.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg023d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000295",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo siento mucho.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es lo que debería decir yo. A pesar de que le prometí al viejo que te\ncuidaría te puse en peligro.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000296",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No, debí haberlo botado todo de inmediato. La culpa la tengo yo por no haber\nescupido en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000297",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Gracias por qué?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000298",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Una vez más me salvaste. Una más de tantas.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez mi padre lo ha hecho, pero yo no.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000299",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Eso no es cierto! Ah, ¿qué debería hacer para poder pagar todo lo que has\nhecho por mí? ¡No se me ocurre nada!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me he cansado de decírtelo ya, no hace falta...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000300",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Uhh... ¿Cómo podría pagarte de vuelta?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000300b",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“N-Naoya, ¿n-no quisieras convertirme en tu esclava sexual?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡De ninguna forma!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Pero qué clase de cosas dices de repente?!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000301",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ya veo... Eso quiere decir que no permitirás que te pague con mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000302",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Dinero, entonces?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dinero? Ah, por eso no hay problema. Tengo una enorme herencia que recibiré\npronto, así que no me hace falta.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000303",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000304",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"*mira fijamente*",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0005",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000305",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Mentiroso...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0002",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000306",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eres una buena persona. Realmente eres como me habían contado.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como te contaron? ¿Jaa? ¿Es que el viejo te dijo eso?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0018",head="shz_z2b",lv=5,id=9},
},
vl02={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000307",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No. Kenichiro-san siempre decía, 'ah, es un idiota, qué tristeza que se\npareciera a mí y resultara ser un completo idiota. Ah, cómo me hubiera\ngustado que se pareciera a Mizuna, ah qué lata, no quería un hijo así'.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo voy a matar cuando lo vea!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000308",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero si eres tan idiota como Kenichiro, eso quiere decir que eres también una\nbuena persona.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, claro que no. En primer lugar, él es un gran idiota.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000309",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Tanto padre como hijo se dicen lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es que realmente lo es. Siempre actúa de forma ridícula, y solo dice\nidioteces.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0012",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000310",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, definitivamente dicen lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Estuvo diciendo eso de mí?! ¡De verdad que lo voy a matar!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0002",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0003",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000311",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Aunque fue una vieja amiga quien me dijo que eras una buena persona. Te\nllamaba 'el artista de los cerezos'...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una vieja amiga?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",time=50,file="black",path=":bg/"},
{"bg",file="ev_uni_c34_01",rule=7,time=50,path=":ev/ev_uni_c34/",set="ev_uni_c34"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Solo con escuchar 'vieja amiga', la imagen de una cierta persona se cruza por\nmi mente.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuzu, cuando hablas de una vieja amiga... ¿será, que hablas de una muchacha\nllamada Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000312",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí... qué sorpresa que lo supieras.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerté?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000313",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, cuando me refiero a mi vieja amiga hablo de Rin Misakura. ¿Cómo es que lo\nsupiste?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que al parecer parte de tu corazón entró en mí cuando te di de\nbeber el agua...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000314",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Parte de mi corazón?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vi a Rin, y algo que parecía ser como el vínculo entre las dos...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000315",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eh? ¿Espera, de qué manera me diste de beber el agua?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, escucha, de verdad quiero que me disculpes por lo que hice, pero era una\nemergencia.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000316",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Y?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... boca a boca...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000317",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Con la boca...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás molesta?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0015",head="shz_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000318",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No, no lo estoy, pero... A-Ah... creo que me desmayaré de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué?!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000319",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, así que si llego a desmayarme dame agua de la misma manera, por favor...\n*gwah*.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",my=40,mode=-1,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kuzu cierra los ojos y saca la lengua.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, Kuzu, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bgm",stop=1,time=500},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000320",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"... *mira de reojo*",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000321",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"¿Qué fue eso?",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Observo a Kuzu.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000322",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"*waku waku*...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"quake",size=5,mode="mw"},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
"¡Kuzu está completamente despierta!",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"mwact",act="rlr"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000323",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Rápido, agua, boca a boca, hurry, hurry.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pareces estar muy bien, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000324",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Uhh, es una pena. Jamás creí que me encontraría con ese nivel extra\npermaneciendo inconsciente.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué nivel extra ni qué nada, realmente estabas en peligro.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="雫",size="z1",my=40,mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000325",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000326",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Es un fastidio seguir pensando en alternativas, haz de Kuzu tu esclava sexual,\n¿sí?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué quieres decir con que es un fastidio?!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0018",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000327",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Uhmmm, preferiría pagarte de vuelta con mi cuerpo y no con dinero.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No necesito tu dinero ni tu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000328",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“*uuhh*, ¿tan fea es Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Es raro encontrarse con una chica tan preciosa como tú.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bgm",file="bgm003"},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000329",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pero Rin también era muy linda. Debe haberse convertido ya en una hermosa\nmujer.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, probablemente. Y ahora que lo pienso, Kuzu, ¿cómo es que conoces a Rin?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000330",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Éramos eso que llaman amigas de la infancia.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Recuerdo haber conocido a Rin, pero nunca llegué a conocerte a ti...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000331",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ciertamente. En aquellos tiempos no solías venir mucho a la residencia Natsume,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Sí sabía que ella tenía algo que ver con la residencia Natsume, pero no me\ndigas que también vivías allá.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000332",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, por unos años...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, después de mudarnos al apartamento en Sakuragahara hubo\nun tiempo en el cual no me acercaba mucho a la residencia Natsume",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Aunque no fue por cuestión de años... Si no me falla la memoria, solía ir por\nlo menos una vez cada tantas semanas...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también tenía asuntos allá, pero nunca llegué a encontrarme contigo.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000333",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Tienes razón. Yo sí llegué a verte varias veces, pero Kenichiro me había dicho\nque huyera cuando viera a cualquier desconocido...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no era ningún desconocido, demonios... Pudiste haberte tomado la molestia de\npresentar a tu propio hijo, idiota.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000334",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, Kenichiro nunca nos presentó.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000335",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Cada vez que venías procuraba huir de inmediato, así que nunca llegué a verte\ndirectamente. Pero... aun así, te conocía.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000336",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Rin solía hablar bastante de ti...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que te llevabas bien con Rin.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000337",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Era mi única amiga...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Por cierto, Rin y yo íbamos al mismo colegio, aunque supongo que tú\nibas a otro.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000338",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que ambas se conocieron entonces?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000339",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Porque Rin Misakura era la aprendiz de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aprendiz?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Pero qué diablos? ¿La aprendiz de Kenichiro Kusanagi? A-Apenas ahora me\nentero de eso.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000340",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Olvidaba que no sabías nada al respecto.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no sabía nada? Él mismo decía que no tomaría ningún aprendiz...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Wakata se hacía llamar su aprendiz, pero el viejo nunca llegó a reconocerlo\ncomo tal.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000341",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Decía que era su única aprendiz. Y Rin era realmente una genio de la pintura.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una genio en la pintura? ¿Ella?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000342",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin? ¿Pintura?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás llegué a ver a Rin pintando algo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000343",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No? Rin era una pintora maravillosa.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mumumuh... ¿En serio? Me cuesta creerlo...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"En primer lugar, era tan torpe que incluso no podía usar bien el columpio...",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, jamás llegué a verla en alguna exposición...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000344",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Supongo. Probablemente a Rin no le interesaban las exposiciones...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún sigue pintando?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000345",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No, me parece que ya se ha vuelto pasado.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pasado?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0301",face="b0011",head="shz_z2b",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“K-Kuzu, no me digas que, conoces algo del día en que florecieron los cerezos\nmilenarios.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000346",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Es que estuviste involucrada en ese incidente?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0002",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000347",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Rin me dio un corazón.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0011",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000348",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Así que usé mi poder por ella...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que usaste tu poder? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011",head="shz_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000349",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Yo soy Hakuki. Y por eso, por eso――”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Para!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No hace falta que digas más.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000350",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay alguien que tiene el deber de explicar todo esto.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000351",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Alguien que tiene el deber de explicar todo?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, Kenichiro Kusanagi. Parece que el idiota ese ha estado ocultándome muchas\ncosas...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Lo que sucedió con Rin.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"El hecho de que Kuzu es Hakuki.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Y de la relación entre ambas.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Seguramente lo sabe todo...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_andoe_02_10"},
{"text"},
linkback="block_00174",
},
label = {
top={block="block_00000",label=1},
},
}
