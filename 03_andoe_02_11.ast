astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="nightsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Después de cenar y de calentar la tina del baño como de costumbre, Kuzu, recién\nbañada, vino a la sala mientras yo leía.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya te bañaste?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000352",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, entonces iré ahora yo, supongo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="雫",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="雫",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000353",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000354",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Pudiste hablar con Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000355",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Perdón, por haber ocultado todo este tiempo lo de Rin...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿P-Por qué te disculpas? Simplemente no había lugar para hablar de eso,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0009",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000356",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, pero... de igual manera intenté ocultarlo, y además, aún hay cosas de las\nque no te he hablado.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo podrías decir de mí entonces. En ningún momento llegué a hablarte de\nRin.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000357",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Creo que en tú caso sí no había lugar para hablar.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es lo mismo, tanto para ti como para mí.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000358",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya, ¿después de aquel día no volviste a hablar con ella?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no lo he hecho.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000359",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Es porque no quieres recordarle de ese incidente, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. El trauma que sufrió de ese día hizo que perdiera la memoria.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000360",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿De verdad crees que un humano pueda perder la memoria por un simple trauma?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, ¿no? Bastante hay de eso en mangas o películas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0009",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000361",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, así es... pero...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ya está bien. No te preocupes por eso, ya lo de Rin se acabó.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000362",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Se acabó?... Esa manera de ponerlo, es muy triste.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás, pero es justamente por no querer hacerle recordar su pasado que decidí\ncortar todo lazo con ella.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000363",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo sé, pero... pero, es muy triste la manera en que lo dices.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0005",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000364",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Yo quiero mucho a Rin.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000365",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por eso, qué?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0011",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000366",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Mi corazón es una especie de copia de Rin...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu corazón es tuyo, de nadie más...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",size=5,lv=5,id=9},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000367",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No lo digo por eso. Naoya, yo te--”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0012j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0011j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000368",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La cara de Kuzu se sonroja como un tomate.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1501",face="a0011j",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008j",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000369",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No, nada. ¡Buenas noches!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué descanses...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"msgoff"},
{"se",file="se9010",vol=40,id=1},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0011j",head="shz_z1a",lv=4,id=9},
{"fg",ch="雫",speed=100,mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0011j",head="shz_z1a",x2="0,10,-10,10,-10",x=0,lv=4,id=9},
{"ex",time=500,func="wait"},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0014j",head="shz_z1a",x=0,lv=4,id=9},
{"ex",time=300,func="wait"},
{"fg",ch="雫",mx=1280,mode=-1,lv=4,id=9},
{"se",file="se9003",id=1},
{"text"},
text={
ja={
{
"Kuzu sale de la sala rápidamente, como huyendo.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenas noches, eh. Que yo sepa, Kuzu no duerme...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Saco mi celular.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Envío dos correos, con el mismo contenido, a dos personas.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No tengo tiempo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Mañana debo a comenzar a trabajar en esto.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=2000,func="wait"},
{"se",id=1,file="se2225"},
{"bgm",file="bgm102"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003983",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, vaya. Bienvenido seas.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Están ocupadas las mesas del segundo piso?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003984",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Del segundo piso? Están desocupadas, ¿por qué?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excelente, ocuparé una. Y otra cosa, no sientes a nadie más en el segundo piso,\n¿sí?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003985",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ah? ¿Qué disparate estás diciendo? Vas a hacer que pierda clientes.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000044",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pues entonces permítenos rentar el local entero. Pagaremos lo necesario.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003986",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quién es este señor?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, un conocido de mi padre.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000045",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y señorita, de ser posible quisiera que también te fueras.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003987",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Yo también?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000046",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Se trata de asuntos de negocios concernientes a Kenichiro Kusanagi. Hubiese\npreferido rentar una sala de reuniones, pero bueno...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pudimos conseguir una adecuada.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003988",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fiuu, está bien, supongo. Le diré a la dueña. Aunque tampoco podemos dejar el\nlocal vacío, así que estaré en la cocina.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003989",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre buscando hacer lo que te conviene, por Dios, Kusanagi. Si no se tratara\nde un caso excepcional no hubiese accedido a aceptar alejarme de las mesas.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003990",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero bueno, solo viendo que no tienes esos ojos de muerto que llevas siempre, me\ndan ganas de hacer algo por ti.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué diablos hablas?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0016",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003991",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que tienes una buena mirada en este momento, quise decir. Igual no importa, a\nesta hora no vienen tantos clientes. Bueno, ¿una hora les basta?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000047",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Suficiente.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003992",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muy bien, y si no les molesta tomaremos su pago por adelantado～”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000048",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Está bien, pero trae recibo, por favor.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Después de organizar un poco el local, Toritani se fue.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Si bien se queja con frecuencia, casi siempre me ayuda cuando estoy en\nproblemas.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"mwact",act="うんうん",size=5},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000694",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Ya se fue?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre huyéndole a Toritani, eh.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_wtd_000695",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Está empeñada en saber siempre lo que hago, me tiene harto. Y además, ya es\nbastante sospechoso que me vea contigo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será porque haces solo cosas que provocan sospecha, idiota?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_frd_000049",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Terminen su cháchara cuando estén a solas, por favor. Quiero entrar en lo\nimportante ya.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000696",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Podría preguntar por qué hacer una reunión acá? ¿No era mejor rentar una sala\nde reuniones?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente, pero muchos de los locales de esta zona están bajo la\ninfluencia de los Nakamura. Podría ser fatal si nos descuidamos.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De hecho, el incidente del día pasado ocurrió justamente por llamar a la\noficina postal.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000050",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿No hay problema aquí?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, acá no entra ningún Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000051",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Confiaré en ti entonces. Bien, comencemos...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",time=300,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000697",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sí, es hora de entrar en lo importante! ¡Kusanagi! ¡¿Realmente eres capaz de\ncrear falsificaciones de las obras de Kenichiro Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién sabe.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うんうん",lv=4,id=5},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000698",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Quién sabe? ¡No quiero un quién sabe por respuesta! Mi vida está en peligro.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué andas diciendo? Fuiste tú el que se dejó sonsacar por Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000052",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Debo agregar que en principio solo le encargué que te vigilara.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues quién sabe, ¿no lo habrás hecho sabiendo que esto sucedería?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000053",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Puedes pensarlo así, si eso quieres... Pero yo no le propuse que hiciera esa\nlocura.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Viendo todo lo que sucedió con los Nakamura, cabe decir que Fridmann quería un\ninformante.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Fridmann tenía conocimiento de la relación entre mi viejo y los Nakamura.\nDespués de que mi padre regresó al país, Fridmann dedujo que algo había entre\nlos Kusanagi y los Nakamura, y le pidió a un conocido mío, en este caso\nAkashi, que me vigilara.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"No sé de qué manera Fridmann y Akashi se conocieron. Y la verdad, no me\nimporta.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Si me pongo a pensar en las personas que siempre están merodeando por mi casa,\nprobablemente solo tendríamos a Akashi y Kei.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Kei pertenece a los Natsume. Así que la opción más obvia era Akashi.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Akashi debió haberse concentrado solo en mi vigilancia, pero por alguna razón\ndecidió meterse más en este problema. ¿Será que Fridmann le dijo que había\nbastante dinero de por medio?",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"No sé cómo realmente habrá transcurrido todo, pero como resultado Akashi\nterminó encargándose de engañar a los Nakamura, yo quedé a cargo de hacer\nlas falsificaciones, y Fridmann de todo lo demás.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"cgdel",id=-1},
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann, todo este desastre que ocurrió cuando Shoichi Nakamura vino a mi\napartamento, lo planificaste tú, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000054",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Si bien le di a Akashi la tarjeta de Kenichiro y el juramento escrito, nunca le\npedí que entrara por la ventana.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que no, nadie es tan idiota como para incluir semejante estupidez en un\nplan así. Pero exceptuando eso, todo lo demás salió tal como lo planificaste,\n¿o no?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000055",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Si eso crees, pues así será, supongo.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Este tipo dice las cosas de una manera terriblemente irritante.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿por qué lo hiciste? ¿Sentiste la responsabilidad de ayudar a\nKenichiro, tu viejo compañero de negocios?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000056",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, así es. Bastante me ha ayudado hasta ahora, por lo que decidí devolverle\ntodos los favores.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo me dijo que solo actuabas cuando había dinero de por medio. Y si eso\nno bastaba, también dijo que eras capaz de traicionar en el peor de los\nmomentos.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0004",head="fri_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000057",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pues entonces Kenichiro me malinterpretó como persona. Yo soy un hombre de\ncompleta integridad.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Es increíble la forma en que puede decir eso, y con esa cara.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"¿De verdad piensas que voy a creer eso después de que metiste a Akashi en una\nsituación tan peligrosa?",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y? El hecho de que estés aquí significa que esto podría traducirse en bastante\ndinero, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000058",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso si logras crear algo lo suficientemente bueno a mis estándares.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000059",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así como me ves, también soy un hombre de negocios, ¿sabes? No me involucro en\nnada que no produzca dinero. Por eso confío en que harás un buen trabajo,\nNaoya.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que confías en mí, eh. Aun suponiendo que logre hacer esas falsificaciones,\nestoy seguro de que alguien se dará cuenta en poco tiempo. ¿Qué piensas de\neso?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000060",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es de esperarse. Aunque puedas engañar a Shoichi Nakamura, no podrás engañar a\nla Fundación Moore... Si se descubrirá en meses, o en años, eso sí no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sería inútil entonces?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000061",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El antiguo director del Museo Metropolitano de Arte dijo una vez esto. 'De\ntodas las obras que me han traído en mis dieciséis años a cargo, un 60 % han\nsido falsas'.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El New York Times también ha dicho que un 40 % de las más grandes obras en el\nmercado son falsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="明石",speed=150,mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",y2="0,-10",x=-345,y=0,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x2=0,x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",x=-345,y=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000699",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿40 %? ¿Tantas falsificaciones hay?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay muchas más falsificaciones en el mercado de lo que se cree. Para dar un\nejemplo, se dice que hay 2.500 obras reales de Jean-Baptiste Camille Corot,\npero la colección de sus obras, solo en Estados Unidos, alcanza las 7.800\nobras.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Théodore Rousseau, un pintor del siglo 19, dijo una vez esto.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deberíamos darnos cuenta de que solo podemos hablar de las malas\nfalsificaciones, de aquellas que se han descubierto. Las buenas todavía\ncuelgan de las paredes.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000700",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En pocas palabras, el mundo del arte está sostenido por falsificaciones... Qué\nespeluznante.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000062",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Las falsificaciones, en el arte, son como el menor de unos gemelos. El mayor se\nlleva toda la atención, pero cabe decir que en realidad las falsificaciones\nson como una parte importante de la historia de ese arte.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y es eso excusa para que alguien de la Fundación Moore se disponga a colaborar\ncon la elaboración de esas falsificaciones?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000063",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fuu, ¿es que acaso crees que los comerciantes de pinturas predican un credo de\nética respecto a las falsificaciones?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Si los comerciantes de arte tuvieran ese credo, no tendríamos un 40 %\nde obras falsas circulando en el mercado.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000064",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tal cual. El arte se sostiene por una relación de complicidad entre\ncomerciantes y artistas. Sin importar que una obra pueda ser real, o\nfalsificada.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000065",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Además, no por pintar cualquier cosa puedes decir que tienes una falsificación.\nPara vender esa falsificación como real, necesitas agregar una excelente\nhistoria a esa obra.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya tuve la oportunidad de ver un guion excelentemente escrito en el\naltercado con Shoichi Nakamura. Jamás creí que alguien de la Fundación Moore\nse podría prestar para semejante teatro.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000066",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Teatro? En ningún momento emití alguna mentira allí. Solo dije verdades.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón. Todo quedó como un invento por parte de Akashi.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,y=0,lv=4,id=5},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000701",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué? ¿Yo? ¿Por qué solo yo?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que no te diste cuenta? Excluyendo el hecho de que te llamara 'el\nmundialmente reconocido Wataaru Akkashi', Fridmann ha sido sumamente cortés y\nconservador en sus palabras.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso se tomó la molestia de advertirle a Shoichi Nakamura que no firmara tu\njuramento escrito.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="明石",size="z1",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000702",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“E-Eso quiere decir que si nos descubren, ¿solo yo iré preso?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
},
vl02={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000067",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No realmente. Si todo llega a descubrirse, todos los que estamos acá seremos\naprendidos por estafa. La ley no es tan condescendiente.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000703",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso sería terrible.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso debemos planificar bien todo para que no suceda.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000068",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No, no hay necesidad de que se preocupen por eso. Yo me encargaré de todos esos\ndetalles.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000704",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿De verdad? No esperaba menos de usted, Fridmann-san.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Insinúas que te dejemos el trabajo sucio a ti?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="明石",mode=-1,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x2=345,x=0,lv=4,id=9},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=0,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000069",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así es. Nuestro trabajo es simplemente colaborar para que nuestros artistas\ncreen buenas obras.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, ¿no estarás mintiendo? No me extrañaría que ya tengas un plan de escape y\nplanees inculparnos a nosotros por las falsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000070",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Insisto, si esto llega a pasar a manos de la policía, por efecto dominó caeré\nyo también.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué plan tienes en mente entonces?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000071",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No trabajo de comerciante de artes en vano. Sé qué clase de pinturas Shoichi\nNakamura tiene en su posesión.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000072",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No es nada raro ver que el arte se use para lavado de dinero.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000073",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Basta con saber cómo se mueven las obras para saber cómo se mueve el dinero. Y\nese movimiento de dinero no será siempre limpio. O más bien, debería decir\nque por lo general es sucio.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann, ¿me estás diciendo que ya sabes de todo de sus fraudes?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000074",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Siempre procuro gestionar bien mis riesgos.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Es decir, el momento en que se descubra que seis de las siete obras son\nfalsificaciones representará también el fin de Nakamura, ¿es así?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000075",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así es. La falsedad de las seis obras se descubrirá después de que caiga preso\npor fraude, es decir, cuando se vea obligado a venderlas.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000076",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque, a pesar de todo eso, solo estará unos años en la cárcel. Hay la\nposibilidad de que busque venganza al salir.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000077",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y el problema, en ese caso, lo tendrás tú. Akashi usó un nombre y una\napariencia falsa. Y es muy probable que Nakamura no se entere de que yo\ntambién estoy involucrado. Pero...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seré el único sospechoso, ¿verdad? El único aparente beneficiado de la venta.\nPero está bien, me cuidaré de alguna posible venganza en unos años.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000078",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Para entonces ya Shoichi Nakamura debería estar convertido en un anciano. Dudo\nque intente hacerte algo aun después de perder todo...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esperemos que sea así.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000705",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Más o menos cuándo podrían descubrir que son falsificaciones?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000079",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ni idea. Podrían ser meses, o años. Puede que incluso nunca se descubra.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000080",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“La línea entre falsificaciones y obras originales es poco clara. ¿Es que acaso\npodemos denominar de falsificaciones a esas falsificaciones que son\npresentadas en museos como originales?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000706",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Entonces hay la posibilidad de que nunca se descubra?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000081",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es completamente posible.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000707",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De ser así podría mantenerme sano y a salvo...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime algo, ¿cuál es el plazo para completar las obras?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000082",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tenlas listas de hoy a tres semanas.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000708",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Tres semanas? ¿Solo tres semanas para terminar esas seis grandes obras?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la opción segura, en realidad. Hacerlo esperar mucho nos pondría en\ndesventaja. Aumentaría las probabilidades de que nos descubran.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000083",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y tampoco sabemos qué tanto más aguantará Kenichiro. Asegúrate de terminar en\nese plazo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Algo haré en esas tres semanas.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Fridmann suelta una irónica risa ante mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0003",head="fri_z1b",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000084",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fiuu. Qué rápido en contestar fuiste, eh.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que te causa risa?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000085",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“La manera en que accedes a emprender una tarea casi imposible.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suena cómico, tal vez. Pero no me desagrada esta clase de tareas imposibles. Si\nhay la manera de superar esta misión de alguna manera, no escatimaré esfuerzo\nalguno.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me desagrada mucho más, la verdad, ese período de tiempo en el que no queda más\nque dejarlo todo a la suerte.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000086",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tenía entendido que ya no pintabas, pero sí, definitivamente eres el hijo de\nKenichiro Kusanagi. Se parecen los dos.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que más me molesta es que ambos nos decimos lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000709",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y bien, ¿qué planes hay de ahora en adelante?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000087",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Contactaré a Nakamura. Le diré 'no es buena idea que se involucre en negocios\ncon gente sospechosa', 'le recomiendo que nos invite a formar parte de la\nventa', e intentaré convencerlo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que acceda a hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000088",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No lo hará.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces por qué hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000089",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso lo presionará a culminar la venta rápidamente.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000710",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ciertamente!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, Fridmann, ¿y cómo piensas sacar dinero de esto?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000090",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es simple, solo basta con que las falsificaciones tengan un valor superior a la\ndeuda de Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000711",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, así que piensas darle a las pinturas un valor superior al de la deuda y\ntomar el excedente.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo piensas fijar el precio?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000091",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Por eso mismo es que contactaré con frecuencia a Nakamura. Le diré cuánto\npodrían valer las siete obras de Kenichiro Kusanagi en caso de ser reales.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000092",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Mientras más insista en explicarle eso, menos confiará en mí, y al mismo tiempo\nempezará a creer con más fuerza que las misteriosas siete obras realmente\nvalen mucho.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000712",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Claro, mientras más se intente convencerlo, más sospechará él de esa\npersona. Pero tanta insistencia lo hará creer también que las pinturas tienen\nbastante valor. Así que eso planeas hacer.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000093",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Le indicaré un precio superior al esperado. Akashi propondrá un valor casi\nsimilar al momento de negociar. De esa manera creerá que el precio es el\nadecuado.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, de escuchar el mismo precio de ambos lados, pensará que es el\napropiado.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000094",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque Nakamura odia gastar su dinero, así que intentará bajar el precio.\nAkashi, después de negociar un poco, puedes fingir darte por vencido y\naceptar. Si Nakamura observa que logró bajar el precio, creerá que hizo una\ncompra barata.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000713",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, así que el precio final incluye el monto a descontar.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000095",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“De esa manera podremos controlar el precio con mayor facilidad. Estos son los\ncálculos para el precio y los gastos asociados.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"se",file="se2497",vol=70,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Fridmann nos mostró una tabla con todas los cálculos\nminuciosamente hechos.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Este es el presupuesto para el monto total? ¿Hacía falta indicar hasta el más\npequeño número?...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000096",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000714",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya monto tan enorme, eh...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pero hay algo que me preocupa. ¿Cómo harás para obtener el dinero que le\nfaltará para comprar las falsificaciones? Nakamura se muere por conservar su\ndinero.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000097",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso ya está resuelto. No habrá problema siempre y cuando Akashi haga lo que le\nindiqué.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000098",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, nada de qué preocuparse.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con tal de que pueda obtener el dinero necesario para liberar a Kuzu, no me\npreocupo. Supongo que podríamos dejar que Fridmann se encargue del excedente,\naunque...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000715",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Estoy de acuerdo con hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees que es buena idea dejar todo en manos de este tipo?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000099",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Pero qué dices, Naoya? ¿Cómo planeas montar la farsa del negocio desconfiando\nde mí?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que desconfíe completamente de ti, pero no has esclarecido aún la manera\nen que se cobrará el excedente.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000100",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nakamura tiene varios cuadros en su posesión como parte de su fortuna. Hay\nmuchas pinturas falsas, pero también hay unas cuantas reales.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Piensas cobrar el excedente con cuadros?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000101",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Algo así.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cobrar en cuadros...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000102",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿No te convence?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo problema con eso, pero esas pinturas requerirán toda una ruta para\npoder convertirse en dinero.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000103",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así es, y de esa ruta me encargaré yo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás sea más adecuado decir entonces que tú debes encargarte de todo, ¿no,\nFridmann?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000104",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tal vez. ¿Algún problema con eso?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De mi parte, no... ¿Tú, Akashi?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000716",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sin problema alguno.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000105",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No hay más opción entonces, ¿no? ¿O es que crees poder idear algún plan\nmilagroso para resolver esto?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000717",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“De eso se trata todo. Nunca hemos tenido otra opción.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, así parece...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000718",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por mi parte no hay problema. ¡Con esto podré hacerme rico!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="明石",mode=-1,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x2=345,x=0,lv=4,id=9},
{"text"},
text={
ja={
{
"El plan de Fridmann parecía ser casi perfecto.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Pero sentí algo extraño en ese perfectísimo plan.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"No sabía qué era exactamente, pero algo no encajaba por completo.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000106",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Bien, ¿qué necesitas para el contrato adicional? ¿Basta con que incluya un\npárrafo garantizando la libertad de esa muchacha Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, respecto a eso... no sé para qué, pero el viejo me encargó con que\nobtuviera un artefacto llamado 'Hakuki Kagurasuzu' a como dé lugar.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000107",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Hakuki Kagurasuzu? ¿Qué es eso, alguna antigüedad de valor?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Mi padre me pidió que lo obtuviera de cualquier manera. Creo que su\nimportancia va más allá del valor monetario.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000108",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Entiendo. Bien, haré lo necesario para poder obtener eso también.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de eso, nos encargamos de organizar detalladamente cada uno de los\npasos a seguir.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Akashi se encargará de las negociaciones. Aunque todas las ideas que usará\nfueron pensadas por Fridmann.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"En caso de algún problema, Akashi se ocupará de mantener la situación bajo\ncontrol, mientras que Fridmann tendrá en sus manos idear una solución.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"El plan de venta estaba preparado minuciosamente.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Probablemente no es la primera vez que Fridmann vende una obra falsa. Es\nincreíble, pero a la vez aterrador.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"El problema son las falsificaciones.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Ni Akashi ni Fridmann tienen alguna buena idea para los cuadros.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Todo queda en mis manos.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Y si mis falsificaciones resultan mediocres, todo el plan se desmoronará.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Obras que incluso un profesional no sea capaz de distinguir como falsificación.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Eso es lo que Fridmann me está pidiendo.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Cuando Nakamura deje ir las obras, la Fundación Moore, la cual se ha encargado\nde planificar todas las actividades de Kenichiro Kusanagi hasta ahora, dirá\nque las obras son falsas. Pero solo lo podrán decir basándose en que 'nunca\ntuvo tiempo para pintar eso cuando aún seguía con vida'.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Bajo esa premisa, les tomará una buena cantidad de tiempo investigar si la obra\nes una falsificación o no. Y la excusa de 'nunca tuvo el tiempo para pintar\neso cuando seguía con vida' pasaría a convertirse en la búsqueda de una\nprueba diabólica.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Por ejemplo, puede ser que usó algunas horas de sueño durante varios años para\npintar los cuadros. O podría decirse también que las terminó junto a 'Cerezos\nrecostados'. Se pueden conjeturar muchos contraargumentos.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Es muy posible que les tome muchísimo tiempo saber si las obras son falsas o\nno.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"De salir todo bien, serán consideradas como auténticas.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"En ese caso, Shoichi Nakamura también terminará beneficiándose, aunque eso nos\nlibraría de cualquier peligro a nosotros. Para ambos lados, este sería el\nmejor resultado.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Y para poder alcanzarlo, se requiere un nivel de perfección muy alto en las\nobras.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Deben ser tal que puedan ser reconocidas como de Kenichiro Kusanagi, incluso\nsiendo revisadas por un perito profesional.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Fridmann hizo énfasis en eso.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"bgm",stop=1,time=1000},
{"excall",file="03_andoe_02_12"},
{"text"},
linkback="block_00250",
},
label = {
top={block="block_00000",label=1},
},
}
