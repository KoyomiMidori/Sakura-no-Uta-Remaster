astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0800",face="b0002",head="rna_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0810",face="b0005",head="yum_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"se",id=1,file="sarawsh"},
{"bgm",file="bgm011"},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000410",ch="rna"},
},
ja={
{
name={"Rina"},
"♪～",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000789",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ji--”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000411",ch="rna"},
},
ja={
{
name={"Rina"},
"“... ¿Podrías dejar de verme tan fijamente? Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0800",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001023",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, y en este caso, la función continua de la variable...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Esto parece una sesión de estudio autónoma, eh...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Kawachino había dicho que no había traído traje de baño, aunque parece que su\nhermana se lo trajo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Accedió a ponérselo de mala gana, siempre y cuando Hikawa también se lo\npusiera.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Ambas se cambiaron a sus trajes de baño.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Mis kouhais, lavando los platos en traje de baño.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Y mi amiga de la infancia, estudiando también en traje de baño.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Pues, sinceramente...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No está nada mal...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Umuh...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001609",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Por qué me estás viendo?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001610",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Descontento de que solo yo lleve uniforme entre todas las demás con traje de\nbaño?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-no es eso...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001611",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo estoy en ropa interior, así que no puedo hacer lo mismo. Vamos, vamos, a\nseguir estudiando.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="znightsky_spring",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm107"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001024",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es algo extraño entrar en la piscina en medio de la oscuridad, ¿no creen?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001612",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hice que apagaran las lámparas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_ked_001017",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, a medida que pase algo de tiempo te darás cuenta del porqué.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000178",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Sí. Ustedes también se darán cuenta en unos cuantos minutos.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El tiempo?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Veo a Toritani.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Toritani estaba observando el cielo mientras flotaba sobre el agua.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000189",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿No es ya la hora?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000179",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Les recomiendo que floten en el agua y vean al cielo como lo estoy haciendo yo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001025",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Flotar en el agua... y ver al cielo?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Tal como Kosachi lo sugirió, floto sobre el agua. Poco a poco mis ojos van\nacostumbrándose a la oscuridad.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="ev_com_a35_02",id=8,lv=8,x=-960,speed=280000,path=":ev/ev_com_a35/",set="ev_com_a35",x2="-960,960,-960,960",ax=1920,ay=540,bx=-960,by=0},
{"bg",file="ev_com_a35_01",id=9,lv=9,x=-960,speed=280000,path=":ev/ev_com_a35/",set="ev_com_a35",x2="-960,960,-960,960",ax=1920,ay=540,bx=-960,by=0},
{"evset",file="ev_com_a35_01",set="ev_com_a35",path=":ev/ev_com_a35/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001026",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uwaah.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_rna_000412",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, increíble.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_yum_000790",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo... así que estábamos esperando a que nuestros ojos se acostumbraran a la\noscuridad...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Al flotar sobre el agua y ver hacia el cielo, este estaba repleto de estrellas,\ncomo si no le diera atención alguna al hecho de que no nos habíamos dado\ncuenta hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001613",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si está la oportunidad, entonces pensé... ¿Por qué no ver las estrellas? Aunque\nbueno, probablemente no estén al mismo nivel del pueblo donde vivía Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001027",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no. Es increíble que se pueda ver toda esta cantidad de estrellas.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Ya veo, así que esta es la razón por la cual prefirieron apagar las lámparas...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Aún tratándose de la recompensa por haber reformado la iglesia, ¿no es como que\nmuy opulenta?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Ver las estrellas desde la piscina en medio de la total penumbra. ¿Está bien\nque el colegio le permita tantos lujos a sus alumnos?",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001614",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por tal razón es que pedí que apagaran las lámparas, de manera que se\npudieran ver las estrellas. Aunque, bueno, supongo que también será más fácil\nver los fuegos artificiales así.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_aid_000604",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu, y por tal razón también es que ahora estoy trabajando horas extra.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rna_000413",ch="rna"},
},
ja={
{
name={"Rina"},
"“Profesora Ai, ¿por qué no entra usted también~?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_aid_000605",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo soy la encargada de supervisarlos a ustedes. Sería todo un lío que sucediera\nalgo en medio de esta oscuridad. Los debo vigilar de un lugar con buena\nvisibilidad.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001615",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero pudo haber venido en traje de baño también, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_aid_000606",ch="aid"},
},
ja={
{
name={"Ai"},
"“Toritani... ¿Estás buscándome pelea? ¿Crees de verdad que yo tengo eso?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001616",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero fue ayer que le avisé.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_aid_000607",ch="aid"},
},
ja={
{
name={"Ai"},
"“Toritani, te lo diré una vez más. ¿Crees que una mujer soltera, profesora y\nencargada de sus hermanos puede conseguir algo así de un día para otro\nhabiendo sido notificada tan repentinamente?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001617",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ajajaja. Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001028",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ruriwo-chan, Suzuna-chan, ¿no van a entrar?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_rld_000014",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Está muy hondo!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_snd_000019",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Parece ser algo profundo para nosotras...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001029",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, ahora que lo mencionan, ciertamente las piscinas para niños tienen\nmenos profundidad.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_000414",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque realmente se ven con lujo de detalle, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_yum_000791",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, la observación de las estrellas también se puede hacer recostados sobre\nel suelo. Realmente no me parece tan mala idea hacerlo flotando sobre el\nagua... Aunque jamás he oído de algo así.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001030",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Todos ven hacia el cielo.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Al quedarse todos en silencio, solo el sonido del agua llega a nuestros oídos.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001031",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué silencio...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001618",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es porque el colegio Yumihari está bastante adentrado en las montañas.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que adentrado en las montañas, es más preciso decir que está encima de una\ncolina. Solo por si acaso, hay también edificios y conjuntos de apartamentos\ncerca...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001032",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero esta parte está particularmente aislada... De verdad no se escucha casi\nnada.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_000792",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué bueno que es luna nueva hoy... Se ven aún mejor las estrellas.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001033",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, claro, mientras más oculta esté la luna menos luz emite, así que mejor se\nven las estrellas...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rna_000415",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es una experiencia que se pueda repetir todos los días, así que deberíamos\ndisfrutar al máximo de ella. Es algo muy, muy raro.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón. Y además, ya van a terminar las vacaciones de verano...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"En particular para nosotros, siendo nuestras últimas vacaciones de verano.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001034",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya... están por terminar...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001619",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo nuestro verano, eh... Solo nuestro verano está por terminar.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Nuestro verano terminará pronto...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"cgdel",id=9,lv=9,rule="216r",time=2000},
{"se",file="se_fflower",id=1},
{"evset",file="ev_com_a35_02",set="ev_com_a35",path=":ev/ev_com_a35/"},
{"ex",time=1500,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001620",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Genial...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001035",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waah.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"se",id=1,file="se_fflower"},
{"text"},
text={
ja={
{
"Los fuegos artificiales se elevan al aire.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Y después de ellos, vienen más, uno seguido del otro.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Las estrellas que brillaban en medio de la oscuridad dejan de verse al\ninstante, como si hubieran huido despavoridas del sonido de los cohetes.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Los radiantes fuegos artificiales vistos a lo largo del cielo, desde la piscina\na oscuras.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Destellan con fulgor el cielo, para luego desaparecer y venir de nuevo.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Durante ese momento, todos quedaron enmudecidos.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Dentro de la oscuridad solo estaba la luz y el sonido de los fuegos\nartificiales.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Todo lo demás es borrado y opacado por ello.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Los fuegos artificiales anuncian el fin del verano, en su noche de pleno\napogeo.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Daba la impresión de que este tiempo duraría por siempre...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001621",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo que terminó fue nuestro verano...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001622",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nuestro final no es acá.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Toritani susurró eso mientras observaba los fuegos artificiales.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"No, corrijo.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Para ser más precisos: Mientras observaba algo más allá de los fuegos\nartificiales.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Estaba viendo hacia el fin del verano.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Y entonces pensé... 'ya veo'.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"La razón por la cual esta muchacha ha estudiado con tanto esmero y dedicación\ndesde el primer año.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"La razón por la cual trata de ayudarme a estudiar.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Obviamente solo hay una.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo creerlo... Y pensar, que de verdad vas tras eso...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001623",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es acaso obvio?... Este es el último intento.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es la razón que te lleva a fijarte tanto en ese premio siendo estudiante?\nNi siquiera los más grandes profesionales del área han logrado obtener ese\npremio. ¿Crees que unos simples estudiantes como nosotros podrían ganarlo?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001624",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo hago porque así lo creo...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Los fuegos artificiales se elevan al cielo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Y esa luz se refleja en la cara de Toritani.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Su mirada era de fuerza.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001625",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero ahora...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deberíamos disfrutar el último verano...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001626",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Eso que llaman eternidad no existe.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Hay un principio, y hay un final, como si eso fuera lo natural.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Por más que algo brille por dentro, por más que algo sea tan\nbello por dentro... Llegará a su fin.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Los fuegos artificiales también se acabarán.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Solo unos cuantos disparos más.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Solo unos cuantos minutos más.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Los fuegos artificiales que iluminan el cielo con tanta fuerza...",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"... también van desapareciendo en el cielo sin sonido.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y por eso, es que solo ahora...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Sin pensar en ese final, y sin pensarlo mucho, disfrutamos de los fuegos\nartificiales.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"En el fin del verano...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"eval",exp="g.clear_2=1"},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"excall",file="03_olympia_01_1",cond="f.rinroute==1"},
{"excall",file="03_picapica_01_1",cond="f.makroute==1"},
{"excall",file="03_zypressen_01_1",cond="f.rnaroute==1"},
{"excall",file="03_andoe_01_1",cond="f.shzroute==1"},
{"text"},
linkback="block_00113",
},
label = {
top={block="block_00000",label=1},
},
}
