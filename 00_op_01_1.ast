astver = 2.0
astname = "ast"
ast = {
block_00000={
{"autoplay",speed=150,wait=250,auto=2500,autoflag="g.prologue"},
{"bgm",file="bgm036"},
{"bg",time=5000,file="ev_uni_c01_01",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=1000,func="wait"},
{"bg",time=3000,file="ev_uni_c01_02",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=2000,func="wait"},
{"bg",time=3000,file="ev_uni_c01_03",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=2400,func="wait"},
{"bg",time=3000,file="ev_uni_c01_04",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=2000,func="wait"},
{"bg",time=2000,file="ev_uni_c01_05",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=3000,func="wait"},
{"bg",time=2000,file="ev_uni_c01_06",path=":ev/ev_uni_c01/",set="ev_uni_c01"},
{"ex",time=7000,func="wait"},
{"bg",time=5000,file="black",path=":bg/"},
{"ex",time=4000,func="wait"},
{"bg",time=5000,file="ev_eye_c01_01",path=":ev/ev_eye_c01/",set="ev_eye_c01"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=5000},
{"se",stop=1,id=-1,time=5000},
{"vostop",stop=1,time=5000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=5000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bgm",file="bgm002",time=1000},
{"bg",time=3500,file="ev_uni_c02_01",path=":ev/ev_uni_c02/",set="ev_uni_c02",ax=960,ay=720,bx=0,by=-180},
{"autoplay",mode="stop"},
{"eval",exp="g.prologue=1"},
{"msgon",time=1500},
{"text"},
text={
ja={
{
"Solo observo las flores de cerezo revoloteando en los alrededores.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"En ese escenario no había ni tristeza, ni dolor.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"¿Será por eso que no lloré?",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Las rosadas flores de cerezo revoloteando con el viento eran ciertamente\nhermosas, pero ese es el único sentimiento que evocan ahora dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Entre ese aroma de flores de cerezo que me llega a la nariz (bueno, en realidad\nno tienen un olor tan fuerte) se transporta un ataúd, cargado por personas.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"El cadáver de papá, expuesto dentro de la belleza de las flores de cerezo era,",
{"rt2"},
"simplemente, horrendo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"El cadáver de papá, encerrado dentro de esa caja de madera,",
{"rt2"},
"no puede, ni siquiera, cumplir con la tarea de acentuar la belleza de las\nflores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"¿Cómo será el mundo observado desde la caja de madera?",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"El fin de su mundo.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"El punto de fuga del mundo en el cual él creyó.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"El bosque de flores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"El viento sopla.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Las flores de cerezo revolotean.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Y pintan de rosado el cielo de primavera.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Esa vista es hermosa.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",time=1000,file="ev_uni_c03_01",path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"text"},
text={
ja={
{
"Mientras la lluvia de pétalos rosados que caía en la funeraria nublaba mi\nvista, me despedí del ataúd de papá, el único familiar que me quedaba.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Junto al fin de aquel sobrio funeral, presenciado solo por aquellas personas\nrelacionadas con él, se le dio punto final a la vida de papá.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"De mis ojos, ahora parado en el bosque de flores de cerezo, no salen las\nlágrimas.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Y tampoco puedo encontrar ese sentimiento de tristeza por ninguna parte.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No logro dar con la tristeza en el escenario que se observa desde acá.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"¿Qué será de las personas alrededor?",
{"rt2"},
"¿Será que ellos sí están tristes?",
{"rt2"},
"¿Será que sus corazones sufren de dolor por el suceso?",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Solo... que al observar el cadáver debajo de esas flores de cerezo en revuelo,\nhay cosas que, lo quiera o no, termino recordando.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Por un instante, una fisura se produce en mi corazón.",
{"rt2"},
"Las flores de cerezo que papá dibujó...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Aun dentro de las incontables obras que papá dejó en este mundo,",
{"rt2"},
"solo hay una donde dibujó las flores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Y aun así, esa obra llegó a ser proclamada como su obra representativa.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"No fueron los otros temas, sino justamente ese cuadro el que fijó su posición\ncomo artista.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",time=2700,file="ev_uni_c04_04",path=":ev/ev_uni_c04/",set="ev_uni_c04"},
{"ex",time=500,func="wait"},
{"bg",time=2000,file="ev_uni_c04_01",path=":ev/ev_uni_c04/",set="ev_uni_c04"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"―― Cerezos recostados.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Tal como lo sugería ese extraño nombre,",
{"rt2"},
"ese cuadro era una pintura de un cerezo en flor, con sus ramas dobladas,\nrecostadas sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Ese cuadro evocaba, en todos los sentidos, a la imagen de los muertos.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"El aspecto de cómo las flores de cerezo, puestas sobre el suelo de la\nmuerte――",
{"rt2"},
"florecían de blanco en las sombras.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Por supuesto, acá no hay esa clase de raros árboles de cerezo.",
{"rt2"},
"Solo está el ya totalmente usual y familiar escenario de primavera.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y aun así, ese bosque de cerezos que coloreaba la muerte de ese hombre...",
{"rt2"},
"parecía estar haciendo florecer unas lúgubres flores de ligero rosado, como si\nsobre él hubiera recaído la maldición de los cerezos recostados.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"El hombre no publicó ninguna otra obra relacionada con las flores de cerezo,\nexcepto por Cerezos recostados.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"A pesar de eso, su imagen general era la de las flores de cerezo, y él mismo\ntambién amaba a esas flores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",time=1000,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Los críticos dicen.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Aquel hermoso mundo, detenido totalmente en el tiempo. El instante de la\nmuerte.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Aquel viejo y enorme árbol de cerezos era como un cadáver, desprendiendo un\nfuerte olor de putrefacción, y era también como una muerte eterna y clara...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Era la imagen de la propia muerte, tanto bella como horrenda.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Ya había visto varias veces esa misma clase de comentarios en las revistas.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Son las palabras de aquellas inteligentes y respetables personas aclamadas como\ncríticos, así que seguramente es como dicen.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Yo realmente no lo entiendo muy bien,",
{"rt2"},
"ni quiero entenderlo.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_uni_c05_01",time=1500,path=":ev/ev_uni_c05/",set="ev_uni_c05"},
{"text"},
text={
ja={
{
"Pero había una única cosa que sí podía entender.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Ahora, aquí, en este escenario.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"No hay ningún trazo de esa descripción tan complicada en su cadáver\ntransportado bajo este bosque donde el rosado florea.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Lo único que hay es un contraste bastante obvio.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Solo los hermosos cerezos y el horripilante cadáver.",
{"rt2"},
"Solo el fuerte aroma de las flores, y el olor del cadáver bañado en\nconservantes.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Debajo del bosque de cerezos,",
{"rt2"},
"acabo de recordar ese cuadro.",
{"rt2"},
"Y entonces, pensé un poco.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Acerca de este escenario y de su pintura,",
{"rt2"},
"pero no porque fueran iguales,",
{"rt2"},
"sino porque eran inequívocamente distintos.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Esa fue la conclusión a la que llegué.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_uni_c03_01",time=1500,path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"text"},
text={
ja={
{
"La muerte de aquel hombre que dibujó aquella extraordinaria imagen de las\nflores de cerezo, llegó a su fin en una ordinaria ceremonia funeraria.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Quizás creer que esto serviría como la más humillante venganza contra Kenichiro\nKusanagi fue solo un infantil delirio mío…",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"En realidad, tampoco lo sé.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Realmente no lo sé, pero――",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"De igual manera, este fue el día en que la única y última persona que compartía\nmi misma sangre desapareció de este mundo.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Esa era la única y certera verdad.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_a01_01",path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
vo={
{"vo",file="man_ked_000001",ch="ked"},
},
ja={
{
name={"???"},
"“Naoya, ya terminó...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya terminó...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_ked_000002",ch="ked"},
},
ja={
{
name={"???"},
"“Fue bastante difícil para ti, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta es ya la segunda vez que asisto al funeral de un familiar, realmente no es\nla gran cosa...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_a01_02",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
vo={
{"vo",file="man_ked_000003",ch="ked"},
},
ja={
{
name={"???"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Con una triste expresión, una cara casi como la de una muchacha observa la mía.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Ojos humedecidos... Piel clara.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Si en mi lugar estuviera un hombre que no supiera nada, probablemente sería\nimposible conservar la calma al ser observado con esa expresión por alguien\ncon ese aspecto físico.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Sin embargo, al conocer el sexo de esta persona tan agraciada de cara, creo que\naquellos que compartan su mismo género se verán invadidos por sentimientos un\ntanto distintos.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Por supuesto, no es ninguna muchacha.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Su nombre es Kei Natsume. Es un hombre.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_a01_03",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, no me veas con esa cara...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"user",mode="conf",ch="圭"},
{"text"},
text={
vo={
{"vo",file="man_ked_000004",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya... ¿qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es... un poco repugnante...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_ked_000005",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué sucede? ¿Te sientes mal, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Quizás...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_a01_02",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
ja={
{
"Observo hacia el cielo... y veo las flores de cerezo en revuelo.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no es eso...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_a01_04",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
vo={
{"vo",file="man_ked_000006",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Es otra cosa?",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pude revelarte la verdad, Kei...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_ked_000007",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Q-Qué quieres decir con la verdad, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bgm",stop=1,time=3000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna manera pude revelarte que tu cara es repugnante...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_com_a01_05",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"mwact",act="びっくり",size=5},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="man_ked_000008",ch="ked"},
},
ja={
{
name={"Kei"},
"¡¿Q-Qué?!",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy capaz de decirte que... sí, se me revuelve el estómago cuando me ves con\nesa cara tan repugnante...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000009",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡¿Qué estás diciendo?! ¡Mi cara no es repugnante! ¡Eso que dices es muy\ncruel!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_a01_06",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿C-Cómo supiste lo que estaba pensando?!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah! ¡Rayos! ¡Y eso que tenía la intención de decirlo en monólogo para no\nlastimarte! ¡Ah, debe ser eso! Eres tan repugnante que la voz de mi mente se\nescapó por mi boca.(tono monótono)”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000010",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué rayos dices?! ¡Eso es bastante cruel, decir que yo soy repugnante!\n¡Corrige lo que dijiste! ¡Corrige! ¡Si no corriges, uwaaahn, te mataréééé!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"mwact",act="うんうん",size=5},
{"se",file="se3130",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajajaja, no me abraces! Criatura repugnante, te mataré.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_ked_000011",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Ah?! ¡Eres tú el que morirá! ¡Uwaan! ¡¡Realmente dices cosas muy irritantes!!\n¡No estoy abrazándote! ¡Estoy cargando a golpearte! ¡Toma!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"U-Uoh... e-espera...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",file="se3130",vol=70,id=1},
{"bg",file="ev_com_a02_01",sync=0,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch, auch... Qué tipo tan peligroso eres, eh...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_ked_000012",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso es porque te estás burlando de mí... ¡¡Por andar llamándole repugnante a\nuno!!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... es que...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Mis ojos se cruzaron con los suyos.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Ajajajajajaja!",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_ked_000013",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué te ríes?!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_a02_02",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000014",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡¿Por qué?! ¡Ya, no puedo aguantarlo más!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Demonios.",
{"rt2"},
"Pero qué acabo de hacer. No fui capaz de contener mis sentimientos, y terminé\nriéndome.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajaja! ¡E-Espera! ¡Hay una buena razón para esto! ¡Ujajajaja!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_a02_01",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000015",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué razón tienes para ver la cara de los demás y reírte?!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pues, eso, acaso no dicen que entre la risa y el miedo hay solo una ligera\nfranja?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_ked_000016",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Q-Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, quiero decir, me diste miedo cuando me atacaste.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ked_000017",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Miedo? ¿Al yo atacarte?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue tanto el miedo que acabé riéndome...",
{"rt2"},
"De lo terrorífico que eres, eh.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_a02_03",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"text"},
text={
vo={
{"vo",file="man_ked_000018",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿D-De veras? ¿T-Tanto miedo te doy? ¿Te di miedo? ¿E-En serio? Lo siento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"POR ALGUNA RAZÓN, Kei Natsume sonríe felizmente.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Parece estar sintiéndose extasiado ante el hecho de que yo sentí miedo.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_ked_000019",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, es de esperarse que cualquiera sienta miedo si un hombre tan macho y\nmasculino como yo llegara a intimidarlo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un hombre macho y masculino...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Kei Natsume insiste en su hombría, aún a pesar de llegar a los extremos de ser\nredundante.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Me sentí un poco apenado por él al ver cómo hacía eso.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Ese ser vivo llamado Kei Natsume parece, únicamente, una mujer.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Sin embargo, el susodicho no accede de ninguna manera a aceptar esa realidad...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Kei es un hombre que no logra ver la realidad...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Al verlo a él...",
{"rt2"},
"Me sentí tan triste, que...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_a02_04",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"text"},
text={
vo={
{"vo",file="man_ked_000020",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, no te rías tanto... Naoya, en realidad no soy tan terrorífico. Siempre\nsoy amable y cariñoso contigo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajajajajajajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_ked_000021",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ciertamente, parezco ser un tanto fuerte, y bueno, realmente lo soy...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ujajajajajaajajajaja, ujajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_a02_01",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"text"},
text={
vo={
{"vo",file="man_ked_000022",ch="ked"},
},
ja={
{
name={"Kei"},
"“... Naoya.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wajajajajajajajajajajajajajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_ked_000023",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No estás como que... mintiéndome?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En base a qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Todo en exceso es malo.",
{"rt2"},
"No es bueno llevar las cosas a los extremos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Regreso a mi yo calmado de siempre.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay manera de que yo mient... Puh.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000024",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué se te escapa la risa?! ¡Entonces sí estás mintiéndome! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Rayos.",
{"rt2"},
"No pude contener la risa al verle los ojos.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",file="se3130",vol=50,id=1},
{"bg",file="zev_com_a02_02",zoom=70,x=-10,y=190,time=0,speed=300,sync=0,z2=50,path=":ev/ev_com_a02/",set="ev_com_a02",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540,my=-40},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000025",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaaan! ¡Te mataré! ¡Te mataré! ¡Te mataré de verdad! ¡Más profundo que el\nocéano! ¡Más alto que las montañas! ¡Y más extenso que el cielo, te mataré!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajaja! ¡Eso da cosquillas! ¡Me das cosquillas! ¡Ajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"se",file="se3130",vol=50,id=1},
{"bg",file="zev_com_a02_02",zoom=80,x=0,y=300,time=0,speed=300,sync=0,z2=70,path=":ev/ev_com_a02/",set="ev_com_a02",x2=-10,y2=190,ax=1920,ay=1080,bx=-960,by=-540},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000026",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué tiene eso de cosquilleante?! ¡Te estoy golpeando!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ajajajajajaja! ¡Detente! ¡Detente, por favor!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"msgoff"},
{"se",file="se3130",id=1,vol=50},
{"bg",file="zev_com_a02_02",zoom=100,x=10,y=410,time=0,speed=100,z2=80,path=":ev/ev_com_a02/",set="ev_com_a02",x2=0,y2=300,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=0,func="wait"},
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=0,func="wait"},
{"se",id=2,file="se2192"},
{"bg",file="閃光小",id=9,lv=9,rule=105,time=100,path=":cg/battle/",set="battle"},
{"ex",time=0,func="wait"},
{"cgdel",id=-1,time=200},
{"bg",file="zev_com_a02_02",zoom=50,x=0,y=0,time=0,speed=300,sync=0,z2=100,path=":ev/ev_com_a02/",set="ev_com_a02",x2=10,y2=410,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se3130",id=3},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000027",ch="ked"},
},
ja={
{
name={"Kei"},
"¡Nyaah!",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_a02_05",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, creí que moriría de la risa...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_ked_000028",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya... me duele. La cabeza me palpita del dolor...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... así es. Porque te golpeé fuertemente.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_ked_000029",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué me pegas? Eso duele...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, fuiste tú quien atacó primero.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_ked_000030",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡P-Porque mis ataques van cargados de amor! ¡Y-Y no duelen!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajajajajaja, eso es porque eres un debilucho. Maricón.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_a02_02",sync=0,face=1,time=400,path=":ev/ev_com_a02/",set="ev_com_a02"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000031",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡Qué malo eres! ¡Eso de maricón es demasiado cruel! ¡Imbécil! ¡No te\nburles de mí solo porque no me sale vello en las piernas!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No he dicho nada de es--”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bgm",stop=1,time=1000},
{"se",file="se3130",id=1,vol=50},
{"bg",file="zev_com_a02_02",zoom=70,x=-10,y=190,time=0,speed=300,z2=50,path=":ev/ev_com_a02/",set="ev_com_a02",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=0,func="wait"},
{"bg",rule=056,time=200,file="black",path=":bg/"},
{"se",id=2,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Gah!",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"mwact",act="うんうん",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000032",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jaa, jaa, jaa, fuh...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="zev_uni_c07_01",speed=240000,path=":ev/ev_uni_c07/",set="ev_uni_c07",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm002"},
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Un mediodía de abril, con algo de frío aún remanente en el viento.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Debajo de la lluvia de flores de cerezo, Kei y yo estábamos tumbados sobre el\nsuelo.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Podía ver el cielo.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Y también, los cerezos.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"El viento sopla.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Y las flores de cerezo son llevadas consigo.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Como si los pétalos trataran de obstruir mi vista...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Y entonces,",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"las nubes se mueven.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Lentamente...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Van moviéndose las nubes por el enorme cielo...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_a03_01",path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada... Nada...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_ked_000033",ch="ked"},
},
ja={
{
name={"Kei"},
"... Naoya.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_a03_02",sync=0,face=1,time=400,path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es... Realmente, no pasa nada...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_ked_000034",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Kei me observa sin emitir ninguna palabra.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, deja de hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me gustan mucho las escenas deprimentes. Al menos eso deberías saberlo,\n¿no?...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_ked_000035",ch="ked"},
},
ja={
{
name={"Kei"},
"“... Lo sé. Lo sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si lo sabes, entonces deja de poner esa cara tan depresiva...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_ked_000036",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Depresiva? No estamos hablando de economía...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás tengas razón, no hay manera de que los cambios en la economía hagan que\ntu cara dé tanta risa...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_a03_03",sync=0,face=1,time=400,path=":ev/ev_com_a03/",set="ev_com_a03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000037",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Espera! ¡En primer lugar, mi cara no da tanta risa!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_a03_04",sync=0,face=1,time=400,path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿No?",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_ked_000038",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿POR QUÉ PONES ESA CARA DE MISTERIO?!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿NO ES ACASO MISTERIOSO?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000039",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡De ninguna manera lo es!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, ¿por qué tu cara cambia de esa manera tan cómica?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="man_ked_000040",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mi cara no cambia de ninguna forma cómica!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_ked_000041",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿POR QUÉ REBOBINAS LA CONVERSACIÓN?!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“ES QUE ME CAUSA MISTERIO.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_ked_000042",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No hay ningún misterio! ¡Esta conversación se acabó! ¡No tiene caso discutir\ncontigo cuando dices eso!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bg",file="ev_com_a03_05",sync=0,face=1,time=400,path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
"Kei volteó su cara hacia un lado, visiblemente molesto.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Después de soltar una sonrisa forzada, me puse a ver el cielo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"El cielo de primavera...",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Ese cielo de primavera envuelto en los cerezos.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo pienso... Kei.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_a03_06",sync=0,face=1,time=400,path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
vo={
{"vo",file="man_ked_000043",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos son hermosos...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_ked_000044",ch="ked"},
},
ja={
{
name={"Kei"},
"¿Los cerezos?",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es... Los cerezos...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Susurré brevemente eso, mientras observaba el rosado florecer entre ese\npenetrante color azul.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Kei sigue mi mirada.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Los pétalos de las flores de cerezo vuelan junto al viento y son violentamente\nlanzados al cielo.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_ked_000045",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, los cerezos de este año son de lo más hermosos...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos de este año están de lo más hermosos...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Las flores de cerezo, las cuales parecieran florecer de la misma manera todos\nlos años.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Ciertamente, y tal como lo dice Kei, a mí también me parecieron de lo más\nhermosas las flores de este año.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Estas flores de cerezo que también, a los ojos de Kei, son hermosas.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"¿Será que entonces, a Kei también le pareció horrenda la figura de papá\nencerrado en ese cajón de madera?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"O es que――",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El arte imita a la naturaleza...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O tal vez...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La naturaleza imita al arte...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_ked_000046",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué es eso? ¿Acaso no va del otro lado?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_ked_000047",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Bueh, algo sin mucho sentido.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"bg",file="ev_uni_c04_01",time=1500,path=":ev/ev_uni_c04/",set="ev_uni_c04"},
{"text"},
text={
ja={
{
"El hombre que pintó Cerezos recostados.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Mi papá fue un artista reconocido a nivel mundial.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Un artista reconocido a nivel mundial.",
{"rt2"},
"¿Habrá algo que suene más raro y sospechoso que eso en esta época?",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Imposible.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Por eso es que también fue conocido como un artista sospechoso, de aires\ndudosos.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Emprendedor, empresario oportunista, estafador, y artista.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Eran varios los nombres que se le dieron a Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Fue una persona mundialmente famosa,",
{"rt2"},
"pero también fue un símbolo de sospecha y poca fiabilidad.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Y, sin embargo,",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"todos y cada uno,",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"se comportaban de manera distinta únicamente al tener esa pintura frente a\nellos.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Todas aquellas personas que llegaron a tener esa pintura frente a sus ojos\npensaron lo siguiente:",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Esta belleza es real",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Esta emoción es real",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Y así...",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"El cuadro Cerezos recostados.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Son muchos los que hablan mal de él, pero pocos los que hablan mal de esa\npintura.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Así es esa obra llamada Cerezos recostados,",
{"rt2"},
"y así era ese artista llamado Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"bg",file="zev_uni_c03_01",zoom=70,speed=240000,time=1500,path=":ev/ev_uni_c03/",set="ev_uni_c03",x2=-384,y2=-216,x=384,y=216,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Mi relación con papá fue completamente cortada tras su muerte.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"El único vínculo que me quedó con él fue una libreta que tenía impresa un\nmonto de dinero tan grande que me permitiría vivir sin problema alguno hasta\nla muerte.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Unos meses antes de su muerte.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Me mostraron esa libreta.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"En ese momento, pensé...",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Ahh... ya veo...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Con esto podré vivir de parranda por el resto de mi vida.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Pues, ese hombre es rico, eh.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Así que, si llego a heredar su fortuna, entonces yo seré rico.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Una vida de ensueño, por la cual todos fascinan.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"No tendré que preocuparme por buscar empleo aún después de graduarme.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"¡En esta sociedad,",
{"rt2"},
"la edad del hielo del empleo es algo del día al día!",
{"rt2"},
"¡Si vas a entrevistarte, se acabó todo para ti!",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Tan difícil parece ser conseguir empleo, que incluso dicen eso.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Es duro salir e insertarse a la sociedad, pero la realidad es que no te dejan\ninsertarte.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"No tendré que trabajar en esta clase de sociedad.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Fui liberado de todo tipo de labor.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"A tipos como yo nos dicen que somos del grupo de los ganadores.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"¡Si usamos términos más elegantes, somos ociosos adinerados!",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Todos los días serán domingos.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Días maravillosos.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"HELLO, SEKAI.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Genial~, genial~",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"... Eso pensé.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"bg",file="ev_uni_c03_01",time=1500,sync=0,path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"text"},
text={
ja={
{
"Ciertamente, en ese momento pensé eso...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Sin embargo, ya ni siquiera sentía emoción por eso.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Todos los escenarios se me hacían bastante llanos.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Sobrios...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"bg",file="ev_com_a03_01",path=":ev/ev_com_a03/",set="ev_com_a03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué será que no siento nada?...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="man_ked_000048",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Al verme de esa manera, Kei me observa con una expresión de preocupación.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Fuerzo la sonrisa y le digo a Kei que no hay nada de qué preocuparse.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"La razón por la cual mis sentimientos están tan apaciguados.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"La razón por la cual todo se me hace tan distante.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Probablemente, la razón es...",
{"rt2"},
"Eso.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Eso fue lo que pensé...",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"bg",time=1500,file="black",path=":bg/"},
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"Fue aquel día, cuando me mostraron por última vez esa libreta.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Dije lo siguiente frente a ese tipo que llaman administrador de fortunas.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"colortone",style="sepia"},
{"bg",file="ev_com_a04_01",path=":ev/ev_com_a04/",set="ev_com_a04"},
{"bgm",file="bgm108"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a aceptar este dinero...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay vínculo alguno entre Kenichiro Kusanagi y yo como para poder aceptar\neste dinero...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="man_kna_000001",ch="kna"},
},
ja={
{
name={"Persona A"},
"“¿Que no hay vínculo?...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_knb_000001",ch="knb"},
},
ja={
{
name={"Persona B"},
"“¿Naoya-kun, acaso el señor Kusanagi no es tu padre?... ¿A qué viene esto?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Todos los que estaban allí se me quedaron observando con ojos de sorpresa.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Es obvio.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Pues acabo de decir que no aceptaré la fortuna de ese artista reconocido a\nnivel internacional, siendo yo su único pariente...",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Solo una sola persona, el hombre que tengo frente a mí ahora, me observó con\nuna mirada perspicaz.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="man_frd_000001",ch="frd"},
},
ja={
{
name={"???"},
"¿Vínculo?",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"El hombre era, según decía él mismo, el administrador de la fortuna de\nKenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Por supuesto, se supone que en este momento no lo conozco, ni lo he visto\nantes.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Y en realidad, ni siquiera entendía bien qué relación tenía él con Kenichiro.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="man_frd_000002",ch="frd"},
},
ja={
{
name={"Administrador"},
"“¿Qué quieres decir con que no hay vínculo entre ustedes?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quiero decir que... el señor Kenichiro Kusanagi y yo somos solo dos extraños...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="man_frd_000003",ch="frd"},
},
ja={
{
name={"Administrador"},
"“¿Extraños?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Por eso es que no puedo aceptar este dinero.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"El silencio se perdió de ese lugar.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Pude darme cuenta de cómo todas las personas que estaban adentro estaban\nalteradas.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Al ver eso, vi hacia abajo, y...",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Lancé una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Así es...",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"No voy a aceptar una fortuna valorada en más de 1 billón.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Porque mi padre y yo no teníamos ese tipo de vínculo...",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Por esa razón... no la aceptaré.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"El hijo de aquel gran artista.",
{"rt2"},
"Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"En pocas palabras, yo.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Genial...",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"En estos momentos, me veo genial...",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Cualquiera quedaría fascinado conmigo al verme haciendo esto.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Un noble espíritu, incorruptible por el dinero",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"La felicidad no se puede comprar con el dinero",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"La forma en la que me veía ahora, declarándoles eso con mis acciones,\nrepresentaba,",
{"rt2"},
"en términos de historias y novelas, el climax.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Quizás mi mente estaba un poco exaltada.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Se los diré, a manera de excusa.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Simplemente se me ocurrió hacerlo, fue un impulso.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Quizás se vea guay si lo hago...",
{"rt2"},
"Tal vez, simplemente tenía eso en mente al hacerlo.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Y además, ¿no es acaso esa la belleza de los japoneses? Comenzar, en principio,\nrechazando la oferta.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Pues, es una fortuna de más de 1 billón.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Y es el dinero de papá, con quien no me la llevaba tan bien.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Además, no conozco a nadie de los que están acá.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Así que, pensé que quizás no estaría mal comenzar rechazándola.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"Si nos preguntamos si está mal o no, pues, claro que no está tan mal, ¿no?",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"(¡¿Pero qué está diciendo?!)",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"(¡Por favor, por favor, no diga eso!)",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
"(¡Acéptela usted, por favor!)",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"(Dentro de la fortuna que dejó el reconocido artista Kenichiro Kusanagi, hay\ntambién una gran cantidad de obras artísticas)",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"(Es usted, su único pariente, quien debe recibirla, Naoya-sama)",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"(Mmm, ¿eso creen?)",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"(¿De verdad?... Tal vez, eh)",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
"(Bueno, si tanto insisten, pues supongo que no me queda de otra, eh)",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"(Ciertamente, mi padre y yo compartimos la misma sangre...)",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"(Si tanto insisten, pues supongo que no me queda más opción que aceptarla...)",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"¡Esto!",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"¿No es acaso esta la usual y muy ordinariamente general etiqueta de los\njaponeses?",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Se rechaza la primera vez.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Aun así, la otra persona no se dará por vencida.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"Seguirá insistiendo. Acepte, por favor.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Y en el momento adecuado,",
{"rt2"},
"se dice está bien, y se acepta agradecidamente.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
"¿No es esta acaso la percepción virtuosa y estética japonesa?",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"Y a pesar de eso...",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="man_frd_000004",ch="frd"},
},
ja={
{
name={"Administrador"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
"El albacea hizo brillar sus azules ojos y asintió con la cabeza.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"Es un extranjero.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Su nombre es Marty Fridmann.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Este tipo no entiende la hermosa etiqueta japonesa.",
{"rt2"},
"¡Aun cuando acabo de enseñársela!",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"Este puerco caucásico de mierda.",
{"rt2"},
"Fridmann es delgado, y de buen aspecto, pero...",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Apenas escuchó lo que dije, procedió a elaborar los documentos para formalizar\nel abandono de la fortuna.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="man_frd_000005",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Bien, Naoya Kusanagi, firma acá.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"Todas las personas que estaban ahí tenían sus ojos puestos sobre mí.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Para no dejar escapar ni un solo movimiento ni acción mía...",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"Una sensación de nerviosismo que jamás había experimentado antes me estaba\ninvadiendo.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"¿Qué es esto?",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"¿Qué está pasando?",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
"Fue entonces que me di cuenta.",
{"rt2"},
"Me di cuenta de todo.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡ME HAN TENDIDO UNA TRAMPA!",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"Grité eso dentro de mi mente.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"Ya era tarde.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Tarde era ya.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
"¡¿No es esto raro?!",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
"¡No hay gracia ni sutilidad alguna!",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"La sonrisa desapareció de mi cara, y en su lugar, sudor grasiento comenzó a\ncorrer por ella.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
ja={
{
"ESTO ES MUY RARO",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Es totalmente descabellado",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
ja={
{
"Si pensamos en las etapas que se debieron haber seguido previamente, es\nabsolutamente raro.",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
"¡No tenía esta escena en mente!",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"¿No se supone que confirmaría, por lo menos 3 veces, si de verdad estaba yo de\nacuerdo?",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"¡¿No se supone que esa es la manera correcta de proceder?!",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"¡Fridmann!",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Lo pensé una y otra vez al respecto, pero ya me había hecho el guapetón,\nhabiendo dicho todo de manera tan apuesta y majestuosa. Así que...",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
"¡Eso era una mentira!",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
"¡Olviden lo que acabo de decir!",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
"¡Quiero el dinero!",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"¡Si es necesario, me desnudaré acá solo para recibirlo!",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
"¡O más bien, permítanme desnudarme!",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
"No pude decir eso, y...",
{"rt2"},
"Yo...",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Yo...",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con esto, ya no existe ninguna relación ni vínculo entre Kenichiro Kusanagi y\nyo...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, de ahora en adelante, no traten de buscarme ni de involucrarse\nconmigo, por favor...”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"bgm",stop=1,time=2000},
{"colortone",style="reset"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Dije únicamente eso, y abandoné esa oficina.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Desde aquel día, yo...",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
"Corté todo vínculo con Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
"¿Será por eso?...",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
"La razón por la cual mi corazón está tan inerte...",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
"La razón por la cual este escenario se me hace tan llano...",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"excall",file="00_op_01_2"},
{"text"},
linkback="block_00367",
},
label = {
top={block="block_00000",label=1},
},
}
