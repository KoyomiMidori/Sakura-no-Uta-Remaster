astver = 2.0
astname = "ast"
ast = {
block_00000={
{"se",id=1,file="gatya"},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Al tocar la puerta, bajar la cabeza y entrar, ya adentro había otro visitante.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Era Akashi.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo Akashi? ¿Y los demás?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_kya_000019",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Calla, no hables nada fuera de lo necesario.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"user",mode="conf",ch="紗希"},
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000001",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y bien, siguiendo con la conversación...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000002",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué hay de esta planilla de expulsión? ¿Puedes decirme qué significa esto?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_wtd_000544",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Toda la responsabilidad la tengo yo. Así que consideré que bastaba con que yo\nrecibiera todo el peso del castigo... Para eso es esta planilla de\nexpulsión...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_kya_000020",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Muchacho, deja de hablar de esa forma frente a la directora.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000003",ch="htd"},
},
ja={
{
name={"Directora"},
"“Responsabilidad, eh... ¿Quieres decir que tú eres el principal responsable?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, te equivocas. Perdón, se equivoca usted...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000004",ch="htd"},
},
ja={
{
name={"Directora"},
"“Hmmm, tú eras, ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, Naoya Kusanagi. El hijo del pintor Kenichiro Kusanagi, quien se encargó del\ndiseño de esta obra, además de culminar la parte interior de ella.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fgact",ch="紗希",act="うなづく",time=260,lv=4,id=9},
},
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000005",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, te recuerdo. Te vi en el funeral de Kenichiro Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"“Aunque yo no la recuerdo...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000006",ch="htd"},
},
ja={
{
name={"Directora"},
"“Dejando eso de lado, acabas de decir algo. De que me 'equivoqué'. ¿Qué\nsignifica eso?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vio los documentos?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Señalo los documentos que estaban sobre la mesa de la directora.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000007",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, los vi. Estos parecen ser unos planos de diseño creados por el mismísimo\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Solo por si acaso, tienen la firma de Kenichiro Kusanagi. Aunque aun así, esta\ndirectora aceptó con demasiada facilidad que estos planos de diseño son\nreales, eh.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Y además, aún teniendo enfrente a los estudiantes que provocaron todo este\ncaso, no mueve ni una sola pestaña. Y yo que pensaba que vendría a gritarnos\ny regañarnos como ese profesor...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"A pesar de ser la directora, se supone que no es la dueña de este colegio.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Y por eso mismo, existe la posibilidad de que la misma directora tenga que\ncargar con toda la responsabilidad en general... ¿Cómo es que tiene tanta\ncompostura y calma entonces? Esta mujer...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos son todos los documentos necesarios para la reforma completa de esa\niglesia. Aunque ya la reforma del interior había sido terminada hace más de\ndiez años...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000008",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, así es. Lo recuerdo. Aquella vez también fue realizada como ahora, sin\nningún tipo de autorización...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000009",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque no fue realizada en un solo día como ahora, pero sí se llevó a cabo en\nsecreto...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que aquella vez tampoco hubo autorización para ello. Y por eso es\nque el colegio despidió a ese profesor. Como medida para cobrar\nresponsabilidad.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kya_000021",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡K-Kusanagi! ¡No sé de qué están hablando! ¡Pero cuida tu boca, muchacho!\n¡Estás frente a la directora!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que cuide mi boca? No, esta es la llana realidad. Sea quien sea que tenga\nenfrente, la realidad no cambia.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_kya_000022",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“M-Me importa un comino si sea verdad o no. ¡¿En primer lugar, cómo eres tú\ncapaz de aseverar que algo que sucedió hace tanto tiempo es verdad?!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000010",ch="htd"},
},
ja={
{
name={"Directora"},
"“Lo es. Puesto que fui yo quien despidió al señor Kenichiro Kusanagi. Yo misma.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"¿Esta directora?",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Me quedé algo sorprendido ante esa respuesta.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Se supone que Kenichiro Kusanagi fue profesor de este colegio hace bastante\ntiempo...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Su edad pareciera ser la misma que la de Kenichiro... no, se ve aún más joven,\npero ¿aún desde ese momento tenía ya ese poder de autoridad?",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000011",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué sucede? Simplemente afirmé lo que tú mismo dijiste, ¿por qué te quedas\npasmado ahora?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, Kenichiro Kusanagi fue removido de su cargo por la administración del\ncolegio. Y por eso mismo, se tapó la verdad de que fue Kenichiro Kusanagi\nquien reformó esa iglesia. Y eso, debido a que no les convendría a ustedes.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque de todas formas, en aquella época no les quedaba de otra. Para ese\nentonces, Kenichiro Kusanagi no era sino un profesor más.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ayer es ayer, ahora es ahora. Tener el sello de 'Obra de Kenichiro\nKusanagi' es una marca de prestigio y honor, nada menos que eso.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún después de haber muerto, o no, justamente por haber muerto es que ahora se\nha vuelto tan famoso como para haber incluso causado un pequeño boom del arte\npor todo el país.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es obvio. Después de la guerra, fueron pocos los artistas que lograron\nalcanzar el éxito y la fama. Y más ahora en esta época donde cualquier\npersona que alcance el éxito, en cualquier área, es considerada como una\nsuperestrella.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aun así, se siguió encubriendo el hecho de que esa iglesia fue obra de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué se debe eso?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000012",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿A qué crees que se debe?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La administración del colegio castigó a Kenichiro Kusanagi. Y consecuentemente,\nobligó a dejar inconclusa la obra de un pintor de renombre internacional.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En un colegio normal no sucedería gran cosa, pero para este colegio que ha\negresado a tantos artistas, eso sería una terrible mancha. No hay forma de\nque puedan exponer esa verdad a la luz.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno, es lógico que quieran esconder esa verdad. Pues no hacerlo implicaría\nexponer la falta de gusto y apreciación artística de ustedes.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kya_000023",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡Kusanagiii!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000013",ch="htd"},
},
ja={
{
name={"Directora"},
"“Profesor Tamura, ¿podría dejarnos a solas?... Subdirector.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_kto_000001",ch="kto"},
},
ja={
{
name={"Subdirector"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000014",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Podría dejarme a solas con Kusanagi-kun y Akashi-kun?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_kya_000024",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿V-Va a dejar a estos dos acá?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_kto_000002",ch="kto"},
},
ja={
{
name={"Subdirector"},
"“Sí, sí, vamos, profesor Tamura...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_kya_000025",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"msgoff"},
{"fg",mode=-2},
{"se",id=1,file="gatya"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"El subdirector, callado todo este tiempo, y el profesor que lo único que hacía\nera gritar, salieron de la oficina.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"El silencio corre por la hasta ahora bulliciosa oficina de la directora. Me da\nincluso la impresión de que hay algo más de presión sobre el lugar que hace\nun momento...",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000015",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien, sigamos con la conversación entonces, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000016",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Tienes acaso alguna pregunta respecto al hecho de que yo haya despedido al\nseñor Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no tengo ningún problema al respecto. La cuestión es que, justamente por\ntratarse de un producto no terminado, es que esa obra no se expuso al\npúblico. Simplemente quería confirmar eso.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000017",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es tal como lo has dicho, Kusanagi-kun. Por haberlo despedido a él y haber\ndejado inconclusa su obra, no pudimos presentarla.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000018",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tal como lo dijiste, de tratarse de un colegio normal no habría ningún\nproblema, tal vez, aunque bueno, digamos que la tradición y historia de\nYumihari no nos permitió eso.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso enterraron a lo más profundo la obra de Kenichiro Kusanagi, aún\nincompleta.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000019",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estás, en gran parte, en lo correcto, sin embargo hay partes en las que no.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000020",ch="htd"},
},
ja={
{
name={"Directora"},
"“En realidad, Kenichiro Kusanagi no fue oficialmente despedido. Todo quedó como\nuna renuncia.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Renuncia?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000021",ch="htd"},
},
ja={
{
name={"Directora"},
"“Recibí también la carta de renuncia de su parte... Aunque igualmente, tal como\nlo dices, a fines prácticos fui yo quien lo despidió. Y fui yo quien dejó esa\nobra de manera inconclusa. Eso es verdad.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_wtd_000545",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kenichiro Kusanagi... renunció...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000022",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Entienden lo que significa esto?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000546",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo... en pocas palabras...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_htd_000023",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que nuestro alumno aquí lo entendió ya.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000547",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No conozco como fue la realidad, pero de igual manera, en los documentos todo\nquedó registrado como una 'renuncia' por parte de Kenichiro Kusanagi. En\npocas palabras, ya no sería cierto que el colegio despidió a Kenichiro\nKusanagi a la fuerza y 'le impidió concluir su obra'.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_htd_000024",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así mismo. Aun si esa obra llegara a completarse y fuera expuesta al mundo, no\nhabría ningún problema ni inconveniente para nosotros.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"La directora observa la cara de Akashi.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_htd_000025",ch="htd"},
},
ja={
{
name={"Directora"},
"“Justamente por tratarse de una verdad inconveniente para nosotros, es que te\naprovechaste de ello y trataste de negociar. Insistiendo en que tú eres el\nresponsable para proteger a los otros alumnos.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"se",file="se3130",id=1},
{"bg",time=200,sync=0,file="zbg059a",path=":bg/",x2=160,y2=0,x=0,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="紗希",size="z2",time=200,sync=0,mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",x2=160,x=0,lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Directora!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La directora se vuelve hacia mí y se ríe.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000026",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sin embargo, no hace falta que sugieras ese asunto. Kusanagi-kun, los adultos\nson más maliciosos, y además más astutos de lo que tú crees.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Maliciosos... y astutos?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000027",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Creíste que no me había dado cuenta de nada?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué quiere decir?...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000028",ch="htd"},
},
ja={
{
name={"Directora"},
"“Yo también tengo amistad con el padre Masada.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000029",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estando hospitalizado, al parecer el padre Masada ni se imaginaba que ustedes\npensaban culminar esa obra, pero bueno, estando en un cargo de educadora,\ndebo poner mis ojos en varios lugares y cosas.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"se",file="se2497",id=1},
{"text"},
text={
vo={
{"vo",file="fem_htd_000030",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Recuerdas estos recibos de entrega?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_wtd_000548",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Esto era lo que Toritani tenía en su poder...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000031",ch="htd"},
},
ja={
{
name={"Directora"},
"“Actualmente, mi hija y yo estamos en un estado en el cual hemos roto todos los\nlazos entre las dos... Aunque aun así, como madre debo enterarme de todo lo\nque mi hija investiga.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_wtd_000549",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ciertamente... es obvio...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué quieren decir?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0007",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000032",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya, vaya, ¿es que acaso no lo sabías?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_wtd_000550",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, ¿así que no lo sabías? Sin embargo, bastaba con pensarlo un poco para\nque te des cuenta. De la razón por la cual Komaki y Kosachi, quienes han\ntenido vínculo con este colegio desde hace tiempo, y Toritani, son amigas.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_wtd_000551",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hace un tiempo Toritani lo mencionó, ¿no? De que la familia Akashi y la familia\nToritani tienen vínculos familiares.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Toritani?...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000033",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Makoto Toritani es mi hija.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Su hija, señora directora?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000034",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Aunque bueno, debo enfatizar el hecho de que actualmente hemos roto\ntodos nuestros lazos.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A juzgar por la forma en que usted ha hablado, ya estaba, en cierto grado,\nenterada de lo que sucedía... ¿Se trata de eso?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000035",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Lo diré de nuevo, Kusanagi-kun, los adultos son más inteligentes de lo\nque crees. Somos astutos, maliciosos, y a veces también engañamos a los\ndemás.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000036",ch="htd"},
},
ja={
{
name={"Directora"},
"“En particular, para las personas como yo que hacen todo por obtener algún\nbeneficio, esa tendencia es fuerte. Yo tenía el poder para detenerlos a\nustedes, y también tenía el poder para dejarlos actuar. Y elegí la segunda\nopción. ¿Sabrás por qué?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="紗希",size="z2",mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para culminar aquella obra.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0002",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000037",ch="htd"},
},
ja={
{
name={"Directora"},
"“Correcto. Así es.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Pero entonces, pudo habernos solicitado el favor de manera formal!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0010",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000038",ch="htd"},
},
ja={
{
name={"Directora"},
"“Los adultos estamos enmarañados en muchas circunstancias. Las cosas no son así\nde fáciles. Y por eso hice culminar esa obra engañándolos y usándolos a\nustedes.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_wtd_000552",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, sinceramente no pienso que realmente se haya culminado de esa manera...\nFuimos, en primer lugar, nosotros quienes hicimos eso...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=9},
{"fgact",ch="紗希",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000039",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tienes razón. Fue por libre voluntad de ustedes que esa obra se culminó. Es el\nresultado del esfuerzo y la voluntad de hacerlo que tuvieron ustedes.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0011",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000040",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sin embargo, es también un hecho que yo estaba en plena capacidad de dejarles\ncontinuar con esa obra, así como también para detenerla.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_wtd_000553",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Directora...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000041",ch="htd"},
},
ja={
{
name={"Directora"},
"“Dejemos los preámbulos hasta acá. Bien, ¿será que hablamos ahora de lo que\nviene?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_wtd_000554",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿De lo que viene?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000042",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, respecto a la forma en que se publicara esa obra...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"La directora era realmente astuta.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Nunca supe que teníamos a una persona como esta de directora.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Hasta ahora, la única imagen que tenía de ella era la de rareza, y eso por\ntratarse de una directora mujer.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"La directora propuso lo siguiente: 'Naoya Kusanagi fue quien culminó la obra\npóstuma obra de su padre, Kenichiro Kusanagi, con la asistencia del club de\narte, con Wataru Akashi como eje central, mientras que solo unos pocos\nmiembros del colegio y de algunos clubes fueron notificados.'",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"De aceptar esa propuesta, quedaríamos libres de todo cargo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"En un giro de 180 grados, Akashi no sería expulsado, y más bien le bastaría\npresentar un examen final para graduarse.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Todos los demás miembros del club quedarían libres de castigo.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Sin embargo, de no aceptar esa petición.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Todos los miembros del club de arte serían expulsados.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Tendríamos que pagar una fianza de compensación por los daños realizados a la\niglesia.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Era el peor de nivel de castigo pensable.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"No hay nadie que sea capaz de medir estas dos posibilidades en la balanza y\nquedarse pensando.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Sin embargo...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo aceptar eso.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000043",ch="htd"},
},
ja={
{
name={"Directora"},
"“Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_wtd_000555",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000044",ch="htd"},
},
ja={
{
name={"Directora"},
"“Personalmente, pienso que no está nada mal la propuesta...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi es el creador principal de esa obra. Yo simplemente me encargué de\nayudar. Yo no fui quien culminó esa obra.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La realidad es que quien completó la obra póstuma de Kenichiro Kusanagi fue el\nanterior jefe del club de arte, Wataru Akashi, con la asistencia mía y del\nclub de arte del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo dejar que se pretenda decir que fui yo quien completó esa obra, que\nfui yo el autor de esa obra. ¡Si llegara a dejar que sucediera eso, ya ni\nsabré dónde estoy parado!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000045",ch="htd"},
},
ja={
{
name={"Directora"},
"“... ¿Prefieres entonces que todos sean expulsados?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puede expulsarme solo a mí. Si yo soy el máximo responsable, entonces eso es lo\nlógico.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000046",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya que dices cosas descabelladas, eh. Si eres el máximo responsable entonces\nquedas libre de todo cargo. No entiendo qué lógica puede explicar que tú,\nquien negó ya ser el máximo responsable, sea el único expulsado.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",mode=-2,sync=0},
{"bg",zoom=130,speed=300,file="bg059a",path=":bg/",z2=100,ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",zoom=130,speed=300,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",y2=0,z2=100,x=0,y=180,lv=4,id=9,sync=0},
{"extrans",time=0},
{"quake"},
{"quake",mode="mw"},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los descabellados son todos ustedes. ¡Dejense de andar jugando y burlándose del\narte! ¡Fue Akashi quien hizo esa obra! ¡Yo no!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esa obra fue hecha por Akashi para el padre, para Komaki y para Kosachi! ¡No\nfue producto de mi esfuerzo! ¡Fue producto del esfuerzo y el sudor de Akashi!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cree que voy a dejar que nieguen eso?! ¡No me jodan, mierda!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=0,y=180,lv=4,id=9,zoom=130},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=0,y=180,lv=4,id=9,zoom=130},
},
},
text={
vo={
{"vo",file="fem_htd_000047",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Ya veo... De ser así--”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"se",file="se3130",id=1},
{"fg",ch="明石",size="z2",zoom=150,mx=-40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",x=-500,y=300,lv=5,id=10},
{"quake"},
{"ex",time=0,func="wait"},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"se",id=1,file="se2192"},
{"bg",rule=105,time=100,file="black",path=":bg/"},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,speed=200,file="bg059a",path=":bg/",z2=130,ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=100},
{"ex",time=0,func="wait"},
{"se",file="se3130",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",blur=5,file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0,zoom=100},
{"extrans",time=100},
{"quake"},
{"ex",time=0,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0,zoom=100},
{"extrans",time=0},
{"quake"},
{"ex",time=0,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",blur=5,file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0,zoom=100},
{"extrans",time=0},
{"quake"},
{"ex",time=0,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0,zoom=100},
{"extrans",time=0},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Por un momento, no supe lo que había pasado.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Después de escuchar un seco sonido, sentí como mis ojos se encandilaron.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Y después de eso, mi mejilla se calentó.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=10},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi... maldito.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000556",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué andas enloqueciendo ahora, Kusanagii? ¿Es que ahora piensas achacarle tus\ncrímenes a los demás, nya~?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=10},
{"fgact",ch="明石",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000557",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Disculpe. Este muchacho está anonadado y asustado ante la realidad de que acaba\nde hacer algo tan grande, y está tratando ahora de achacarme sus crímenes~ En\nun principio, fue este hombre quien lo planeó todo, nya~”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi, ¿pero qué demonios estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000558",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Cierra esa maldita boca, gallina! ¡Cállate!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué dices?!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000559",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡En primer lugar, tú también llegaste a publicar obras dando detalles falsos!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso es muy diferente a esta situación! ¡¿Estás consciente de todo el tiempo y\ntrabajo que invertiste en esta obra?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_htd_000048",ch="htd"},
},
ja={
{
name={"Directora"},
"“Fuh... ¿Podrían tratar de no provocar un conflicto violento frente a la\ndirectora? Por más que se trate de mí, no creo poder encubrir eso.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=10},
{"fgact",ch="明石",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=10},
},
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000560",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Disculpe de verdad por provocarle tanto trabajo, nya~ Todo este incidente fue\nprovocado por nada más ni nada menos que Naoya Kusanagi. De eso no hay duda\nalguna. Si así lo requiere, ¿le parece si tomamos la palabra de todos los\nmiembros del club?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_htd_000049",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me parece que alguien que estuvo involucrado en el incidente no debería tomar\nla palabra de los otros involucrados.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que acaso estás de acuerdo con eso?! ¡Es la obra por la cual te gastaste 3\naños de tu vida! ¡¿Estás de verdad de acuerdo con que esa obra no sea tuya?!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000561",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Pero qué estás diciendooo? Fuiste tú quien hizo esa obra, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me jodas, Akashi! ¡Akashi! ¡¿Es que acaso sabes lo que significa crear una\nobra?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=10},
{"fgact",ch="明石",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000562",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¡¿Y qué mierda dices tú saber?!!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Akashi...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Akashi alza su voz con furia.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000563",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Después de haber dejado el pincel por tanto tiempo... ¿Qué puedes saber tú?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000564",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué dices tú saber de lo que significa hacer una obra?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000565",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Para ti, ¿una obra es algo que debe ser reconocido por muchas personas? ¿Es\nalgo por lo que los medios tienen que armar un escándalo?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000566",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por qué, y para qué se hizo esa obra... Y para quién la hice...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000567",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Que para qué se hace una obra? Ahora te voy a preguntar eso mismo a ti. ¿Es\nque de verdad puedes decir que entiendes lo que eso significa?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Akashi.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000568",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Esa obra no fue creada para nadie más. No fue creada para alguien que esté a lo\nlejos... Esa obra fue creada para Komaki, para Kosachi, y para aquel que las\nsalvó a ellas, el padre Masada... para nadie más.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=10},
{"fgact",ch="明石",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000569",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por esa razón es que yo no tengo ya necesidad de ser el autor de esa obra. No\nhay necesidad de que mi nombre quede en esa obra.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000570",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No puedes estar de acuerdo con eso? De ser así, entonces como artista, estás\npor debajo de la tercera clase.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_wtd_000571",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“La razón por la cual las obras nacen, y son creadas...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000572",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El porqué que nos lleva a crear una obra... Siempre y cuando no perdamos eso de\nvista, no habrá ningún problema... aun cuando el nombre inscrito en esa obra,\nno sea el nuestro.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_wtd_000573",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Directora, ¿me permite?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=260,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000050",ch="htd"},
},
ja={
{
name={"Directora"},
"“Claro. Esa fue una maravillosa respuesta.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_wtd_000574",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El diseño de 'Las huellas de los cerezos' fue realizado por Kenichiro Kusanagi.\nLa elaboración le corresponde a Naoya Kusanagi. Y la asistencia a esa\nelaboración fue aportada por nosotros, el club de arte de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000051",ch="htd"},
},
ja={
{
name={"Directora"},
"“Falta agregar la parte de que recibieron la autorización de la directora, eh.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_wtd_000575",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000052",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien, listo todo entonces...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_wtd_000576",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000053",ch="htd"},
},
ja={
{
name={"Directora"},
"“Muchas gracias... eh.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000054",ch="htd"},
},
ja={
{
name={"Directora"},
"“Fuh... ¿Hace cuántos años que no escucho esa palabra?...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_wtd_000577",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000055",ch="htd"},
},
ja={
{
name={"Directora"},
"“No, nada... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"No pude decir más nada después de eso.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"¿Para qué es creada una obra?... Para qué...",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Ese significado, esa razón...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"No tenía forma alguna de contestar a esa pregunta al tenerla puesta frente a\nmí...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Lo único que pude hacer es echar la cabeza hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_14_3"},
{"text"},
linkback="block_00191",
},
label = {
top={block="block_00000",label=1},
},
}
