astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm011"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué calooor...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001477",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Deja de quejarte y ponte a trabajar ya!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_rna_000347",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuu... aunque realmente hace bastante calor...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_yum_000740",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_rna_000348",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, sí, gracias a que me estás cubriendo con el paraguas estoy bien, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001478",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En lo que a temperatura concierne, el trabajo de aquella vez debió haber sido\nmucho más caluroso...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_rna_000349",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues me imagino que habrá sido producto de eso que llaman euforia del\ncorredor, o un estado de trance, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000962",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, fue bastante divertido eso.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001479",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Vamos, dejen de hablar y limpien!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg061a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001480",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay que limpiar todo antes del atardecer. ¡Y rápido!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001481",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Gracias a ustedes ahora tuvimos que hacer el campamento dentro del colegio, no\nlo olvides!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por nuestra culpa?... Pero si fueron ustedes quienes vinieron a meter sus\nnarices.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000350",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero, tanto Kusanagi-senpai como Akashi-senpai fueron los que estuvieron\nactuando y tramando en las sombras, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Yo no dirigí ni colaboré con ese plan! Simplemente tomé parte en la\ncreación de la obra.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000351",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? Pero, a la imagen pública fuiste tú quien quedó como el autor\nintelectual de todo, ¿no, senpai?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo también me he visto bien agobiado por eso! ¡Realmente es desagradable!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"El fin de agosto.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Estamos en medio de nuestro campamento.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Aun cuando en un principio, debimos haber estado rodeados de verdor y\nacariciados por la brisa marina... Pero por alguna razón, fuimos obligados a\nlimpiar esta piscina olorosa a cloro.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Ese día... Estamos desarrollando el campamento al cual no pudimos ir aquel día\ndentro del mismo colegio Yumihari. De todos los lugares posibles, no había\npor qué elegir el colegio, ¿no? Esto es realmente el colmo de lo\nlamentable...",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0018",head="rna_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000352",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No acabas de pensar algo así como 'De todos los lugares posibles, no había por\nqué elegir el colegio, ¿no?～. Esto es realmente el colmo de lo lamentable～\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, y-yo no--”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Acertó totalmente. ¿Es que tanto así se me notaba en la cara?",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000741",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Pero qué rayos?! ¡Si eso es verdad entonces te mataré!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Se equivo--”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000742",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es. No debes, bajo ningún modo, pensar eso, ¿verdad? Porque gracias a\nKusanagi-senpai y Akashi-senpai, ese campamento terminó arruinándose. El\ncampamento que esperaba con tantas ansias y para el cual incluso compramos\ntrajes de baño...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Cada vez que se habla del tema de la suspensión del campamento, sus intenciones\nasesinas se elevan al máximo... Aunque, es natural que lo haga...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000994",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, no está tan mal. Después de todo estamos ahora haciendo el campamento\nacá.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_000353",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que lo está... Es muy diferente bañarse en la playa a limpiar una\npiscina.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000963",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad es que esperaba un poquito poder dibujar en medio de la naturaleza.\nAunque, esto también es divertido. Es la primera vez que limpio la piscina\ncon todos.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000110",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OHHH, YEAAAH, EYACULAR... EYACULAR EN MEDIO DE LA NATURALEZA... OHHH, YEAAAH.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001482",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tú! ¡No frotes la punta del trapeador hacia arriba y hacia abajo!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Veo la pared de la iglesia desde la piscina.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Se podría decir que es perfectamente obvio. Todo comenzó desde el momento en\nque descubrí a Akashi allí mientras dormía al lado de la piscina.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Es normal que la iglesia se pueda ver desde acá.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-570,lv=4,id=3},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0003",head="rna_z1d",x=0,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000354",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque, cómo podría decirlo... es, increíble. La iglesia vista desde acá no\nestá nada, nada mal.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001483",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Aunque en el momento en que culminamos esa obra, me había preparado ya para\nasumir cualquier cosa...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000743",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, era algo que ameritaba estar preparado para lo que fuera...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero todo resultó ALL RIGHT.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001484",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me irrita que lo digas tan despreocupadamente.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sucedieron muchas cosas desde aquel día en el cual completamos la pintura sobre\nla pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Y ciertamente, toda una gran cantidad de cosas impensables para unas vacaciones\nde verano normales.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Mencionando nada más cómo resultó todo, esa pintura se mantuvo intacta, y tanto\na nosotros como al club de arte, se nos permitió continuar en este colegio.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Exceptuando, por algo...",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bgm",stop=1,time=1000},
{"bg",file="white",path=":bg/"},
{"bg",zoom=70,speed=200000,time=1500,file="zev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25",x2=384,y2=-50,x=-384,y=-50,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm110"},
{"text"},
text={
ja={
{
"El último día de julio.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"O más bien, debería decir la mañana del primer día de agosto.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Esa obra fue completada.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Así como unos cerezos floreciendo de repente y fuera de estación en un día de\npleno verano, esa obra mostró su figura de un momento a otro sobre la pared\nde la iglesia. La obra de Kenichiro Kusanagi, 'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"La obra está compuesta de una representación de cerezos en completo\nflorecimiento, usando unas pequeñas huellas de pisadas en lugar de pintura,\nque evocan la imagen de unos niños. Sumado, además, por unos vitrales que\nemulan la superficie del agua y sobre la cual parecieran caer los pétalos de\nflores.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Los vitrales observados desde el interior de la iglesia son, por supuesto,\nhermosos. Teñidos con base azul, reciben una gran cantidad de luz desde el\nexterior, pintando de una manera hermosa a ese mármol pulido hasta volverse\nblanco.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Sin embargo, no todo termina allí. Los vitrales observados desde afuera no\nreflejan el resplandeciente azul como sucede adentro, sino que se transforman\nen una hermosa y ligeramente oscura, así como traslúcida superficie de agua.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Al dibujar los 'cerezos' en la pared, es que por primera vez se da lugar a esa\ntransformación. Al recrear los cerezos revoloteando por el aire en el mural,\ny la superficie del agua en los vitrales, y combinar esos dos elementos, es\nque esa ligera oscuridad resalta.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"La única obra completa de Kenichiro Kusanagi con cerezos como temática es,\nexceptuando sus obras de práctica, 'Cerezos recostados'.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"O esa era la norma y lo común dentro de la industria del arte. Y por eso, con\ntoda seguridad, la obra que dejó como diseño preliminar mientras seguía aún\ncon vida, 'Las huellas de los cerezos', hará eco, no solo dentro de la\nindustria del arte, sino en otros muchos lugares y personas.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Recibirán el mismo impacto que recibí yo al ver por primera vez este diseño...\no no, seguramente aún más.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Lo que yo vi fue el diseño preliminar.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Sin embargo, lo que todos vieron fue la 'obra completa' que apareció de repente\nen una noche de pleno verano.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Todos aquellos que de alguna forma se relacionaron con Kenichiro Kusanagi\nhabrán pensado que para él, la temática de los 'cerezos' era algo especial, y\nél mismo publicó únicamente hasta ahora 'Cerezos recostados', como si de\nalguna manera tratara de demostrar eso.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Por eso mismo, es que pensé que este plan podría resultar. Completar esta obra\nno era una batalla perdida del todo.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"En ese sentido, podría decir que este resultado ya lo tenía, en parte,\nprevisto.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"No, creo que quizás eso es ya decir demasiado...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Quiero que sea así. Si llega a resultar así, tendremos todas las de ganar. De\nesa forma lo pensaba. Bueno, quizás.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"De todas formas, dependiendo del acabado de la obra, nuestro destino pudo haber\nsido algo totalmente distinto.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Si hubiera sido un acabado que no solo arruinara la obra de Kenichiro Kusanagi,\nsino que además arruinara la arquitectura del lugar, entonces una expulsión\nhubiera sido poco para lo que nos hubiese tocado afrontar.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Cruzamos un puente bastante peligroso. Sin embargo, de culminar perfectamente\nesta obra, entonces teníamos suficientes oportunidades de triunfo. Teníamos\nla posibilidad de que el punible crimen se transformara en una hazaña digna\nde honor y admiración.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25"},
{"text"},
text={
ja={
{
"Aquel día.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Justo casi después de culminar la obra, la seguridad del colegio nos descubrió.\nProbablemente, debido al ruido que hicimos por el júbilo en aquel momento.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Después de terminar la obra, si hubiéramos huido sigilosamente, entonces quizás\nno nos hubieran agarrado.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Sin embargo, a nadie se le podría ocurrir tratar de huir sigilosamente después\nde culminar semejante obra. Armamos un barullo tan pronto la terminamos.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Y como cosa obvia, la seguridad vino corriendo hacia nosotros.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Nos infiltramos sin permiso en medio de la noche al colegio, y además dejamos\nunos 'enormes rayones y garabatos' sobre la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Fue un gran escándalo. Y de tal magnitud, que al principio casi llamaban a la\npolicía.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Aún a primera hora de la mañana, los profesores se reunieron tras ser\nnotificados. Fue un escándalo, sin precedente alguno desde la fundación del\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Por supuesto, allí también estaba Ai.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Mientras los otros profesores perdían la cabeza y no sabían que hacer, o\nsimplemente nos gritaban y regañaban, Ai simplemente se quedó observando la\npintura de cerezos que Kenichiro Kusanagi dejó.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Se quedó todo, todo el rato observando esa pintura, en medio del bullicio, con\nla misma calma que podría tener un visitante en un museo de arte.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Después de haber contemplado con lentitud y detenimiento la obra, Ai me vio,\nse río... y entonces,",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",id=1,file="se1512"},
{"text"},
text={
ja={
{
"... me golpeó.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Un poco después, las hermanas Akashi llegaron.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Estaban llorando.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Parece que se apresuraron a venir después de ver todo lo que sucedía acá desde\nel hospital. Aunque bueno, es de esperarse.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Ese hospital es el asiento de gala. Seguramente quedaron pasmadas.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Una pintura de cerezos, que hasta el día de ayer no estaba, apareció de la\nnada, de repente.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="小沙智",size="z1",mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0017",head="kom_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000,sync=1},
{"fg",mode=-2,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_wtd_000535",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué tal? ¿Se alegró?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000158",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Q-Que si se alegró? I-Idiota.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se1512"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000536",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000159",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Kosachi, quien pareció haber abofeteado a Akashi, estaba sorprendida.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="小牧",size="z2",mode=3,resize=1,path=":fg/kom/z2/",file="kom_z2a0100",face="a0021",head="kom_z2a",lv=5,id=6,sync=0},
{"extrans",time=1000,sync=1},
{"text"},
text={
ja={
{
"Y es que quien la interrumpió, y además abofeteó a Akashi, fue Komaki.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_wtd_000537",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“... Komaki.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0009",head="kom_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2a0100",face="a0006",head="kom_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000177",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Crees que vas a poder salir airoso habiendo hecho esto, onii-chan?...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_wtd_000538",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Me importa un bledo salir airoso o no... Lo que me interesa, es si el padre se\nalegró... y además――”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0011",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0009",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000539",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Si, ustedes se regocijaron o no por esto.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0019",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000160",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0020",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000178",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“... Sí, el señor padre, se alegró muchísimo... y... nosotras también, nos\nsentimos muy felices...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_wtd_000540",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo. ¿El acabado de la obra pudo recordarte un poco a los cerezos milenarios\nque viste?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000179",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, por supuesto que sí.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Komaki sonríe felizmente mientras llora.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_uni_c25_01",path=":ev/ev_uni_c25/",set="ev_uni_c25"},
{"text"},
text={
ja={
{
"Aquellos enigmáticos cerezos que Komaki Akashi dijo haber visto en una noche de\nverano.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Los cerezos que según se cuenta, dan unas hermosas flores en cualquier\nestación.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"No sé si en verdad esta obra tiene como temática esos cerezos, pero...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Pero, hay con toda certeza, algo en ella que atrae a las personas.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Probablemente, no se debe solo a la habilidad y esfuerzo de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Ciertamente, esta obra existe gracias a sus geniales ideas y sentido estético.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Sin embargo, no fue Kenichiro Kusanagi quien culminó esta obra.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Lo que atrae a las personas a esta pintura de cerezos, son los sentimientos de\nAkashi. Sus sentimientos por Komaki, por Kosachi, y por el padre.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y además, la pasión y esmero de todos ellos que les impulsó a completar esta\nobra...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Dicen que 'una figura de Buda creada sin alma, no es más que piedra y madera'.\nAunque el diseño preliminar haya sido fabricado por Kenichiro Kusanagi, si\nlas personas que completaron esta obra no hubieran puesto su alma en ello, no\nhubiera tenido el poder de atracción que tiene ahora.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"La pasión de todos los que están acá ahora, junto a algo de técnica y\nhabilidad, es lo que le dio forma a la obra póstuma de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Por eso, es que esta obra es...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000180",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Es maravillosa... realmente, lo es...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_kya_000003",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡¿Y bien, quién es la cabeza que se encargó de planear todo esto?! ¡¿Fueron\nustedes, los del club de arte, verdad?! ¡¿Quién es el jefe?! ¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000541",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ahh, ¡pero qué escándalo, qué barullo! ¿Es que acaso no nos pueden dar ni\nsiquiera algo de tiempo para sumirnos en sentimentalismos? ¡Aun cuando\nacabamos de culminar una obra de esta magnitud! ¡De verdad que ningún\nprofesor sabe apreciar lo bueno, eh!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000542",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Fui yo! Toda la responsabilidad recae sobre mí, Wataru Akashi. ¡Yo los engañé\ny los llevé a hacer todo esto! ¡Bien, pueden llevarme a mí ahora!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_kya_000004",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡Idiota! ¡¿Crees que van a salirse nada más con eso?! ¡Vengan todos ustedes!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000744",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auch...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000543",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ellos no tienen nada que ver! ¡No los traten con violencia!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000581",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estos muchachos no pondrán ninguna resistencia. Le pido que se reserve todo\nacto violento, por favor.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_kya_000005",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Profesora Natsume...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000582",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo soy la supervisora del club de arte. Parte de la responsabilidad también la\ntengo yo. Todas las sanciones y castigos los recibiré yo...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_kya_000006",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“E-Espere un segundo, por favor. Profesora Natsume, ¿no se supone que usted solo es\nsupervisora en papel?... Todos saben que a fines prácticos, el supervisor\nreal es el profesor Wakata... En primer lugar, ¿por qué el profesor Wakata no\nha venido aún?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000583",ch="aid"},
},
ja={
{
name={"Ai"},
"“Al profesor le cuesta levantarse en las mañanas. Dudo que responda el celular a\nesta hora en un día de descanso.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_kya_000007",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡Ese irresponsable!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Akashi es el único al cual los profesores se llevaron... Obviamente, lo que\nacabo de decir es mentira. Las cosas no resultaron así de convenientes para\nnosotros.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Cada uno de los que estábamos en ese lugar fuimos llevados a salones separados,\nsiendo ametrallados con preguntas, casi a manera de interrogatorio.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Todos pensaban que el interrogatorio duraría un largo tiempo, pero terminó, y\npor cosa de sorpresa, casi apenas al comenzar.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Y todo, por efecto de algo que dije.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bgm",stop=1,time=1000},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm027"},
{"text"},
text={
vo={
{"vo",file="man_kya_000008",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡¿Pero qué diablos pretendes?!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que qué pretendo? Aunque te lo diga probablemente no lo entiendas.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_kya_000009",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿Te lo diga? ¿No lo entiendas? Imbécil, ¿para ti qué demonios es un profesor?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ni idea. Lo único de lo que me acabo de dar cuenta ahora es que son unos\nirracionales idiotas, que no pueden sentir nada aún al haber visto eso...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_kya_000010",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¡Imbécil! ¡¿Qué forma de dirigirse a un profesor es esa?! ¡No pienses que vas a\nsalir bien parado después de esta ridiculez!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ridiculez? ¿Estás bien de la cabeza? ¿Te parece que esa obra es una simple\nridiculez? Su precio actual es de unos cuantos millones de yenes. No, ahora\nmismo podría estar al nivel de las decenas de millones.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kya_000011",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿D-De qué rayos hablas?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a mostrarle esto a la persona con más poder en este colegio, ¿verdad? Y se\nle dirá que es la obra póstuma de Kenichiro Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"se",id=1,file="se2497"},
{"text"},
text={
ja={
{
"Al decir eso, tomé el montó de hojas de planos y los diseños y los puse sobre\nla mesa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="man_kya_000012",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿Pero qué rayos te pasa, muchacho? ¡Escucha bien!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gufooh.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0006",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000584",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pero qué clase de actitud es esa, imbécil?...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ai...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guhaa!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl02={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0018",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000585",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es Ai. Es profesora Natsume. ¿Cuantas veces tendré que repetírtelo para que\nlo entiendas? Pedazo de idiota...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_kya_000013",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Profesora Natsume.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000586",ch="aid"},
},
ja={
{
name={"Ai"},
"“Déjeme encargarme de lo demás, por favor. Haré que este muchacho se calle... Y\npor otro lado, trate con cuidado los documentos que Kusanagi le dio. Tienen\nun valor que ronda unos varios millones de yenes.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_kya_000014",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿Varios millones? Natsume-sensei, va a venir usted también con esas\ntonterías... Es obvio que estos trozos de papel no tienen valor alguno.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000587",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, dele eso a la directora, por favor. Ya la contacté, así que debería\nestar por llegar al plantel. Y tampoco olvide de decirle de que es 'la obra\npóstuma de Kenichiro Kusanagi', por favor.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_kya_000015",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“¿La obra póstuma de Kenichiro Kusanagi? Pero si...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000588",ch="aid"},
},
ja={
{
name={"Ai"},
"“Le ruego que haga lo que le indiqué, por favor.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_kya_000016",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“E-Ehm, profesora Natsume...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2f0000",face="f0005",head="aix_z2f",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_000589",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por favor.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_kya_000017",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Ai dice eso con un tono un tanto imperioso.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_kya_000018",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"msgoff"},
{"fg",mode=-2},
{"se",id=1,file="se2308"},
{"ex",time=1000,func="wait"},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo creer que aún teniendo semejante obra frente a sus ojos, lo único que\npiense es en cómo castigar a sus alumnos... ¿Pero qué tan seca tiene ya su\nsensibilidad artística?... Idiota.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gefuh!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000590",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡El idiota eres tú! ¡¿Pero qué clase de estupideces estás diciendo?! ¡¿Estás\nconsciente de lo que acabas de hacer?!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo estoy... Por supuesto que lo estoy, y aún estando consciente de lo que\nhacía, lo hice, ¿qué no es obvio?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000591",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad sabes lo que has hecho? Acabas de incurrir en ingreso ilegal y daño\na la propiedad. Crímenes con todas las de la ley.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Lo hice aún sabiéndolo todo.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0006",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000592",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuh... ya veo. ¿Eso quiere decir que simplemente fue una falsa muestra de\nosadía?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"No solo yo, todos los demás se involucraron en eso preparados ya para una\nexpulsión.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"No hay nadie que no haya entendido lo que estábamos haciendo en ese momento...\ncreo... (No estoy muy seguro de Thomas)",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque esta falsa osadía era necesaria. Si llegara a acobardarme y mostrarme\nsospechoso, nadie creería que esa cosa tiene valor.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es necesario algo de falsa osadía para no dejarme llevar por la otra persona, y\nde ser posible, también algo de falsa osadía para lograr avasallar a esa otra\npersona.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Había la posibilidad de que ese profesor llegara a tirar a la basura los\ndocumentos de diseño de Kenichiro Kusanagi. O por lo menos en su caso, de no\nhablarle de esa manera era peligroso, puesto que no entendía en lo más mínimo\nel valor de esos planos.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000593",ch="aid"},
},
ja={
{
name={"Ai"},
"“De igual forma, ¿hay alguien que se dirija de esa forma a un profesor? Por\nDios, muchacho, pero qué tan insensato eres...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000594",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, esa falsa osadía fue usada como herramienta de negociación, ¿no?... De\nser así, quedas perdonado con los golpes que te di. Aunque si me estás\nmintiendo, podría golpearte ahora tanto que no podrás ni levantarte.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, si llegas a aplicar esa clase de castigos corporales te van a imponer\nun despido disciplinario.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000595",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es ningún castigo corporal, es lenguaje corporal. Sí no entiendes con\npalabras de la boca, entonces haré que lo entiendas con tu propio cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué primitiva eres...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0018",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0009",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000596",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sería mejor que salieras airoso nada más con eso, ¿no?... Mejor a que todo\ntermine en un desastre...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",stop=1,time=1000},
{"fg",mode=-2},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Fue 1 hora después que me convocaron a la oficina de la directora.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"se",id=1,file="se2924"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con permiso...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"excall",file="02_abend_14_2"},
{"text"},
linkback="block_00178",
},
label = {
top={block="block_00000",label=1},
},
}
