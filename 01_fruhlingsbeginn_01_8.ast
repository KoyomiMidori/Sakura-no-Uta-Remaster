astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",rule="083r",zoom=150,speed=120000,vague=40,file="bg046b",path=":bg/",z2=100,x2=0,y2=0,x=-360,y=50,ax=960,ay=563,bx=0,by=-23},
{"cgact",stage="bg046",act="びっくり",size=2,time=500,loop=-1},
{"se",file="se9012",vol=30,loop=1,id=1},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Los pasillos se queman de rojo ante la luz del atardecer que entraba por las\nventanas.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Camino algo cansado.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Estuve un largo tiempo repartiendo folletos obligado, así que la fatiga se\nestaba apoderando de mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"se",id=1,file="se1279"},
{"bg",file="ev_com_a18_01",path=":ev/ev_com_a18/",set="ev_com_a18"},
{"text"},
text={
vo={
{"vo",file="man_wkd_000001",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Qué quieres, muchacho?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres? No me jodas...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_wkd_000002",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Mm? Ah, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Bebiendo alcohol?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_wkd_000003",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Qué?... ¿Algún reclamo?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ningún reclamo, pero ¿no es peligroso que tomes alcohol dentro del\ncolegio? Aún estás en horas de trabajo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_wkd_000004",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por eso mismo ando bebiendo acá escondido, rayos.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por eso mismo?... Si solo fuera por lo de los almuerzos no habría tanto\nproblema, pero si te ven así vas a terminar despedido con toda certeza...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_wkd_000005",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ni que estuviera bebiendo en clases, ¿cuál es el problema?... Ah, eso, cuando\naún era un estudiante, siempre bebía mientras participaba en los seminarios.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no tiene nada que ver...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_wkd_000006",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ah, cierto, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_wkd_000007",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Te daré esto.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",file="se9010",vol=60,id=1},
{"bg",file="ev_com_a18_02",sync=0,face=1,time=400,path=":ev/ev_com_a18/",set="ev_com_a18"},
{"text"},
text={
ja={
{
"Al decir eso, Wakata me dio la botella de whisky.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja ya las estupideces! ¿Crees que voy a beber de esto?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="ev_com_a18_01",sync=0,face=1,time=400,path=":ev/ev_com_a18/",set="ev_com_a18"},
{"text"},
text={
vo={
{"vo",file="man_wkd_000008",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Vamos... Tengo tapas y todo para acompañarlo... Qué aburrido eres.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tapas?...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Había un montón de contenedores de butadon amontonados como una montaña\nalrededor de Wakata.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué demonios es eso?...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_wkd_000009",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Mm? Una fiesta a mi estilo... Bien suntuosa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, algo desenfrenada parece, pero...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_wkd_000010",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“También hay butadon de kimchi.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Qué bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_wkd_000011",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ni creas que te voy a dar.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ni la más mínima esperanza de que me convides algo tan caro...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_wkd_000012",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ya veo, estás en todo lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Parece que estás bien borracho.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_wkd_000013",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Mm? Pues sí... Bueh, hay momentos en los que hay que emborracharse.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que te faltaba decir 'para los adultos'.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_wkd_000014",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Jajajajaja... La edad no tiene nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es así?...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_wkd_000015",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por otro lado, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_a18_02",sync=0,face=1,time=400,path=":ev/ev_com_a18/",set="ev_com_a18"},
{"text"},
text={
vo={
{"vo",file="man_wkd_000016",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Te daré esto, así que llévatelo.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Me volvió a acercar la botella de licor de hace un momento.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuántas veces tengo que repetírtelo? Yo no bebo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_wkd_000017",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No tiene por qué ser ahora. El whisky lo puedes conservar por todo el tiempo\nque quieras...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_wkd_000018",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Puedes beberlo cuando quieras hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="ev_com_a18_03",sync=0,face=1,time=400,path=":ev/ev_com_a18/",set="ev_com_a18"},
{"text"},
text={
ja={
{
"Al decir eso, puso la botella en mis manos e hizo que la agarrara.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre te la pasas quejándote de que no tienes dinero, ¿no te importa de\nverdad? Un licor de estos debe ser bien caro para alguien tan pobre como tú,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_wkd_000019",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No solo es caro para mí... Obsérvalo bien.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Reviso la etiqueta pegada a la botella.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, pero qué viejo es este licor. ¡Es de hace 36 años! No sé mucho acerca\nde licores, pero esto es caro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_wkd_000020",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“El embotellado fue hace 18 años, lo que está escrito en la etiqueta fue el año\nen el cual lo metieron a la barrica. En fin, es edición especial, de barrica\núnica.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Veo el número de años escrito en la etiqueta.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Y mientras tanto Wakata me observa, sin cambiar ni un poco su expresión.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wakata――”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"¿Qué clase de licor es este?...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Iba a decir eso, pero...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Me retraje.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que no te emborrachaste con esto, eh...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"La botella estaba abierta ya, pero tenía casi todo su contenido adentro.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Seguramente bebió solo un poco...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_wkd_000021",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Este fue el que estuve bebiendo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Al decir eso, Wakata señaló una botella plástica de whisky que tenía escrito\n'4L'.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es de tamaño económico. Parece justamente del tipo de licores que son\npésimos para el cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_wkd_000022",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Idiota, no hay ningún licor malo para el cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que sí...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_wkd_000023",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Obvio que no. Esa es la verdad absoluta.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué clase de ridiculeces estás... En fin, guardaré este licor por ahora...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_wkd_000024",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Nada de guardar. Eso es tuyo ya. Tómatelo cuando quieras.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuando quiera?...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_wkd_000025",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No me importaría si te lo tomas hoy mismo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, no incites a tus estudiantes a beber alcohol.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_wkd_000026",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Entonces ábrelo cuando llegue el momento en que puedas beberlo... Así es el\nwhisky.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así es?...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="man_wkd_000027",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Así es. Es igual a la felicidad.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_wkd_000028",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No espero que un mocoso lo entienda.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se9010",id=1,vol=60},
{"fg",ch="若田",size="z1",time=500,sync=1,my=40,mode=3,resize=1,path=":fg/wak/z1/",file="wak_z1e0000",face="e0002",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000029",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Creo que me iré ya...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="若田",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9012",vol=50,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Wakata se llevó el montón de contenedores de butadon a la sala de\npreparativos.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"En la sala de preparativos está la nevera que este tipo se trajo, así que es\nposible almacenar alimentos allí.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Por supuesto, también hay una cocinita y un microondas, al igual que todo tipo\nde instrumentos y utensilios de cocina.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Está de más que lo diga ahora, pero este es uno de los tres hombres que\nconforman el diario plan malévolo de los mediodías.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Seijiro Wakata.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Es un profesor de tiempo parcial soltero.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="若田",size="z1",mx=40,mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0009",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000030",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por cierto, el almuerzo de hoy estaba mejor de lo usual. ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será porque tenía brotes de bambú adentro?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0011",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000031",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ahh, así que eran brotes de bambú. Ciertamente, me di cuenta que no era\ncarne...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Y como pueden ver, es un soltero alejado en todos los sentidos de la palabra\n'cocina'.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0005",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000032",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No te vayas a comer los butadon. Son mi valiosa fortuna.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no me los comeré. Pero si lo dejas ahí alguien más podría hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0006",head="wak_z1e",lv=4,id=9},
{"fgact",ch="若田",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000033",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¡El culpable serías tú!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0003",head="wak_z1e",lv=4,id=9},
{"fgact",ch="若田",act="うんうん",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000034",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Jejeje, ¿quieres escuchar mi deducción?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de todo vas a decir que se debe a que soy el único que sabía que había\nbutadon adentro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0004",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000035",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¡Así es!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera pensaría que hay algo dentro del refrigerador, ¿no crees?... Si así\nde importante es para ti, entonces ponle candado.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0011",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000036",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Tooonto. Si cierro con llave algo tan importante, no podré sacarlo en los\nmomentos más importantes. Aunque eres solo un niño, así que seguramente no\ndebes entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene nada que ver con que sea un niño o no.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En fin, me voy ya! Cierra bien las puertas.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0007",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000037",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Demonios, no quiero que un estudiante me diga esas cosas...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no te emborraches, profesor.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="若田",size="z1",mode=3,path=":fg/wak/z1/",file="wak_z1e0000",face="e0008",head="wak_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wkd_000038",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Está bien, está bien. Rayos, Naoya, siempre sacas la lógica por delante, eh.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"No es un problema de si es algo lógico o no...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",time=1000,file="black",path=":bg/"},
{"se",id=1,file="se1279"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"text"},
text={
ja={
{
"Aunque es raro.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Wakata es un profesor bien descuidado y algo irresponsable, pero no es del tipo\nde personas que bebería alcohol dentro de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Aún como lo ven así, en el fondo es un profesor serio.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"La razón por la cual se emborrachó...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",time=1000,file="white",path=":bg/"},
{"msgoff"},
{"bg",file="ev_uni_c03_03",path=":ev/ev_uni_c03/",set="ev_uni_c03",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1500},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"bg",time=1500,file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios, ¿es que acaso no se cansan todos?...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Aun cuando no me canso de repetir que odio las cosas deprimentes...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Saco de la mochila la botella que recibí de Wakata.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"El líquido de color ámbar contenido en la botella brilla ante la luz del sol de\nla tarde. Brilla como si dentro del ámbar hubiera otro sol.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta que llegue el momento...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Ya la botella había sido abierta, y había perdido una muy pequeña parte de su\ncontenido.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Solo tomó un pequeño sorbo... Eso parecía ser...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se9004",id=1},
{"bg",file="zeveningsky_winter",id=9,lv=9,speed=320000,rule="083r",vague=40,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Atravieso a un lado el Anfiteatro y ando por el camino de cerezos.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"El bosque de cerezos continúa desde acá hasta la colina Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"En el totalmente despejado cielo del oeste se podía ver el 'rojo' que quedaba\nde los rayos solares del atardecer.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"El crepúsculo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Todos ven este momento como algo hermoso.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Sin embargo, en lo que transcurra un corto instante de tiempo, entraremos en la\nhora conocida como 'Magatoki'.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"El Magatoki se refiere al omagatoki. Cualquier persona, aún perteneciente a la\nsociedad moderna, sentiría algo tétrico al escuchar ese nombre.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Vuelvo una vez más a elevar la botella de whisky al aún enrojecido cielo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"El cielo que estaba siendo consumido por el azul oscuro se pintó en color\námbar.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Vi una sombra tras ese ámbar.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"cgdel",id=-1},
{"bg",file="eveningsky_winter",id=9,lv=9,time=500,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Veo la silueta de alguien en el fondo del líquido ámbar.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"En el japonés, la etimología de la palabra crepúsculo (Tasogare) viene del\n'Tasokare' (¿Quién eres tú?).",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Tal como lo sugiere la palabra, de no acercarse, no hay manera de saber de\nquién se trata.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Deja entonces que me acerque y vea si eres ella, a quien la trémula luz del\nanochecer me permitió discernir vagamente en las flores de belleza\ncrepuscular'...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Susurro las palabras que aprendí en las clases de literatura antigua, sin\nningún propósito en particular.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Me acerco a la silueta.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"cgdel",id=-1},
{"bg",file="ev_com_a19_01",path=":ev/ev_com_a19/",set="ev_com_a19"},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000114",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede, por qué sigues acá a esta hora? Ya es la hora de regresar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_a19_02",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000115",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Hoy pasé por varios clubes y ahora estoy cansada.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás cansada y por eso descansas ahora leyendo?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Hay un libro sostenido en uno de los brazos de Rin.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000116",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, cuando vi las flores de cerezo de acá, me dieron ganas de leer...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Leo el título de la cubierta del libro.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Es una fábula bastante famosa.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'El príncipe feliz'... Oscar Wilde, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000117",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es.\nNao-kun, ¿has leído a Oscar Wilde?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez me leyeron 'El príncipe feliz' de un libro con dibujos para niños, pero\nsolo eso.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué obras ha escrito Wilde?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000118",ch="rnd"},
},
ja={
{
name={"Rin"},
"“'Salomé', 'El retrato de Dorian Grey', 'El crítico artista', 'La decadencia de\nla mentira'...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aparte de Salomé, no he escuchado de las otras.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"No, en realidad me da la sensación de haber oído antes de las últimas dos...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000119",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque me parece que así está bien. Creo que podrías llegar a odiar a\nWilde.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="ev_com_a19_01",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000120",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Porque tú y Wilde son bastante distintos.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? No conozco mucho a Wilde, ni tampoco sé mucho de su manera de\npensar, así que no sé cómo reaccionar mucho a esa afirmación.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000121",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero aun así, hay algunos símbolos interesantes también.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Símbolos interesantes?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000122",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe feliz trata de lo siguiente.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000123",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En la columna más alta del pueblo se alzaba la estatua del príncipe feliz.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000124",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Su cuerpo estaba cubierto de finas hojas de oro, tenía dos grandes y\ndeslumbrantes zafiros por ojos, y en el puño de su espada resplandecía un\nenorme rubí.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000125",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este hermoso príncipe era el gran orgullo de la gente del pueblo, admirado por\ntodos.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000126",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Una noche, una golondrina que buscaba abrigo trató de dormirse en el pedestal\ndel príncipe, cuando de repente una enorme gota cayó desde arriba.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000127",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La sorprendida golondrina vio hacia arriba, y se dio cuenta que la cara del\npríncipe feliz estaba recubierta de lágrimas.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000128",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe feliz, quien estaba parado en el lugar más alto del pueblo, podía\nverlo todo. Por eso el príncipe estaba triste por todos los males e\ninfortunios que agobiaban a las personas del pueblo.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000129",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe le pidió el favor a la golondrina. Quería que le llevara cada una\nde sus joyas a aquellas personas infelices.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000130",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La golondrina tenía que viajar rápidamente de ese totalmente gélido pueblo\nhacia el sur, sin embargo, le dio pena ver lo triste que estaba el príncipe.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000131",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal como el príncipe se lo pidió, la golondrina tomó el rubí de la espada del\npríncipe y se lo llevó a una pobre madre que tenía un pequeño niño enfermo.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000132",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe le pidió después a la golondrina que le diera un zafiro a un joven\nestudiante dramaturgo que estaba pasando penuria, y el otro a una pequeña\nniña que vendía cerillas.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000133",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La golondrina lloró, exclamando que no podría hacer algo tan atroz como robarle\nde sus dos ojos al príncipe. Sin embargo, movida por la fuerte voluntad del\npríncipe, llevó los zafiros a los lugares encargados, sin ninguna otra\nopción.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000134",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe feliz le dijo entonces a la golondrina: 'Debes irte ya al sur'.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000135",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sin embargo, la golondrina dijo esto: 'Has perdido los ojos que usabas para\nverlo todo. Así que decidí permanecer por siempre a tu lado'.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000136",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La golondrina voló por el pueblo, en lugar del ahora ciego príncipe, y le\ninformó de la situación del pueblo.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000137",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debido a que aún habían muchas personas desafortunadas, el príncipe le pidió a\nla golondrina que arrancara las hojas de oro de su cuerpo y las repartiera\nentre ellos.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000138",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La golondrina arrancó las finas hojas de oro del príncipe, una a una.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000139",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y así, las hojas de oro fueron llegando a las manos de los pobres, y las risas\ny sonrisas comenzaron poco a poco a inundar el pueblo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000140",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sin embargo, el príncipe, quien había terminado de darlo todo, estaba ahora\nraído y gris.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000141",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así como el príncipe había tomado ahora esa desastrada forma, el cuerpo de la\ngolondrina se fue debilitando rápidamente con el frío.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000142",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero aun así, la golondrina no trató de alejarse del príncipe. Lo amaba\ndemasiado ahora.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000143",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sin embargo, en el anochecer de un cierto día, la golondrina, sabiendo que el\nmomento de su muerte se acercaba, sacó sus últimas fuerzas y voló hacia uno\nde los hombros del príncipe.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000144",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y entonces, la golondrina le dijo lo siguiente al príncipe.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000145",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Adiós, príncipe. Permíteme besar por última vez tu mano.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000146",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pequeña golondrina, estoy feliz. ¿Por fin decidiste partir al sur? Ya estuviste\nmucho tiempo acá. Pero me he enamorado de ti, así que no beses mi mano, sino\nmis labios.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000147",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me voy a la morada de la Muerte. Porque la Muerte es la hermana del Sueño.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000148",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y al besar los labios del príncipe, la golondrina cayó a sus pies y murió.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000149",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En ese instante, sonó un extraño crujido, como si se hubiera roto algo de entre\nla estatua.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000150",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad es que en este instante, su corazón hecho de plomo se había roto en\ndos. Esa fue una terriblemente fría, fría noche.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000151",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La siguiente mañana, las máximas autoridades del pueblo encontraron al ahora\ndestartalado príncipe.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000152",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero qué estatua tan andrajosa. No podemos dejar esto en medio del pueblo.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000153",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las máximas autoridades del pueblo bajaron a la estatua del príncipe feliz de\nsu columna, y la fundieron en un horno.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000154",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sin embargo, por alguna razón, solo el corazón del príncipe permaneció sin\nderretirse. El primer oficial de fundición, extrañado y algo desagradado,\ndecidió tirar el corazón del príncipe en la montaña de basura.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000155",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En la montaña de basura donde fue tirado el corazón también yacía el cuerpo de\nla golondrina muerta.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000156",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ambos fueron tirados, como destinados a estar juntos.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000157",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y entonces, Dios le ordenó lo siguiente a uno de sus ángeles.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000158",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tráeme las dos cosas más preciosas de esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000159",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El ángel le presentó posteriormente a Dios, el corazón de plomo del príncipe y\nel cuerpo de la golondrina.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000160",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y entonces, Dios dijo lo siguiente.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000161",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Has elegido bien.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000162",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y entonces, sus dos espíritus vivieron felices por siempre en el país eterno.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_a19_04",time=1500,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000163",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fin.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En qué parte de esa historia dices que hay algo en común conmigo?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bg",file="ev_com_a19_02",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000164",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dónde será, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Rin sonríe.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000165",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En las historias de Wilde están ocultos todo tipo de pecados y crímenes entre\nvarias complicadas metáforas.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000166",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso arreglé un poco la historia.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crímenes?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_a19_01",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000167",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, crímenes.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000168",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wilde pasó sus últimos años cautivo en prisión, viviendo una vida triste y\nsolitaria.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000169",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En todo momento sentía sus propios pecados, y por esos pecados estaba extasiado\ncon la vida. Por eso escribió varias grandes obras, pero por otro lado vivió\ntambién una vida llena de inmoralidades.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé mucho de Wilde, así que quisiera que me contaras cuál fue su pecado.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000170",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Amar.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Amar? ¿El amor fue su pecado?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000171",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, un amor siniestro. Un amor indecente, tanto que ni siquiera fue enjuiciado\npor ello en la corte. Él cometió ese crimen, y fue castigado por ello.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un amor siniestro...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_com_a19_01",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000172",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ¿pero sabes? Él creía que su amor era tal que había sido traído por el\npropio Dios.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000173",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Justamente es proclamado eso en su última obra, 'Balada de la Cárcel de\nReading'.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cada vez entiendo menos. ¿En qué parte está su punto en común conmigo?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000174",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No lo sabes?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000175",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo único que sé, es que no puedo ser la pequeña golondrina ni el príncipe...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000176",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El príncipe que lo dio y lo perdió todo. Y la pequeña golondrina que sirvió al\npríncipe y murió.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a19_02",path=":ev/ev_com_a19/",set="ev_com_a19"},
},
},
text={
vo={
{"vo",file="fem_rnd_000177",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo no estoy dentro de esta hermosa historia.\nPero ¿se podría decir lo mismo de ti, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, menos relación tengo yo con eso.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000178",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso pensé que dirías, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es totalmente distinto a mí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000179",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya me decidí. Ya decidí qué es lo que voy a hacer de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Piensas hacer algo?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="ev_com_a19_01",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000180",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tuve una corazonada. Y quisiera creer en esa corazonada.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"bg",file="ev_com_a19_03",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000181",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Life imitating art...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_a19_04",sync=0,face=1,time=400,path=":ev/ev_com_a19/",set="ev_com_a19"},
{"text"},
text={
ja={
{
"Ella susurró algo. Sin embargo, y sin quererlo, la sonrisa que Rin puso\njustamente después me pareció aterradora.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Y eso es porque la oscuridad del anochecer ocultaba su rostro...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Eso fue lo que sentí. O más bien, quizás creí.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"De repente me sentí de esa manera.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"A medida que me sumía más y más en ese sentimiento, me pareció sentir terror de\nalgún lado y sin sentido alguno, aparté mi mirada de Rin.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿no vas a regresar?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000182",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, estaré acá hasta el instante en que no pueda seguir leyendo este libro.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se te van a dañar los ojos.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000183",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es solo una superstición. Los ojos no se deterioran aunque leas en lugares\noscuros.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000184",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así que... adiós por hoy.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Me fui del lugar donde Rin estaba.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1d0000",face="d0003",head="kei_z1d",lv=4,id=9},
{"bgm",file="bgm011"},
{"text"},
text={
vo={
{"vo",file="man_ked_000558",ch="ked"},
},
ja={
{
name={"Kei"},
"“Fuh~, sin duda alguna, al entrar a la tina siento que el día realmente ha\nterminado. Esto es maravilloso.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0007",head="kei_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0003",head="kei_z1d",lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000559",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡En especial hoy, me maquillaron y me hicieron varias cosas, y fue un día\nterrible, así que el baño se sintió especialmente refrescante! ¡Qué hacemos,\n¿eh?!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé cómo responderte si me preguntas de repente '¿Qué hacemos?'.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Kei entró a la sala con una pinta algo desordenada, secando su cabello\nalegremente.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No va al caso, pero ¿no te parece que tus baños son demasiado largos? Me da la\nimpresión de que entraste hace un largo rato...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0008",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000560",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Kei respondió a mi casual pregunta con una voz un tanto estirada.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai y Shizuku se tardan 40 minutos por lo general, pero... ¿No te estás tardando\ncomo 1 hora y media?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0006",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000561",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eh, eso es lo normal. Son ellas las que se bañan muy rápido.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... 1 hora y media es suficiente para ver una película... Qué desperdicio de\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0003",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000562",ch="ked"},
},
ja={
{
name={"Kei"},
"“No importa. Total, aun si no veo la película puedo pasarla en la tina.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Parece que Kei odia el secador de cabello, así que prensa su cabello mojado con\nla toalla y lo seca. Esto también toma bastante tiempo.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Si juntamos ese tiempo con el tiempo que Kei se toma en el baño, llegamos a la\nconclusión de que Kei se toma más de 2 horas solo para bañarse y arreglarse.\nEsto es increíble.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo intención alguna de meter mis narices en la manera en que los demás\nusan su tiempo, pero... Eso es bastante repugnante para ser un hombre. ¡Deja\nde hacerlo!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0005",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000563",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¡¿Pero qué rayos es eso?!! ¡Estás metiendo completamente tus narices!”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera no piensas seguir mi consejo, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0001",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000564",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por cierto...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0002",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000565",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pudiste reconciliarte con Rin-chan, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Reconciliarme?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna manera nos reconciliamos, ni tampoco habíamos peleado. Aun cuando\nllevábamos tanto tiempo sin vernos...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0007",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000566",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es que dije algunas estupideces, y pensé que estabas evadiendo a Rin-chan por\neso... Eso me tenía angustiado.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te estás preocupando por eso? ¿Es que acaso eres idiota? Eso es raro\nde ti.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0004",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000567",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota... ¿Por qué deberías preocuparte por eso?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0002",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000568",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tienes razón. Si llegara a preocuparme demasiado entonces quizás se haría algo\nincómodo de ahora en adelante cada vez que tú y Rin-chan estén juntos...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Actúa de manera natural.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0003",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000569",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, me esforzaré... Ajaja.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Kei se ríe, un poco arrepentido.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Si alguien que no conociera a Kei lo viera, probablemente se sorprendería de\nesta expresión que tiene ahora...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Sin embargo, Kei es así.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Siempre hace como si no estuviera atento a nada, pero en realidad siempre está\npendiente de varias cosas.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Y entonces, piensa, piensa bastante, y luego se preocupa.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Los Natsume han venido pasando trabajo con eso.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"La sonrisa de Kei no es solo una sonrisa despreocupada.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Incluso alguien tardo como yo podía darse cuenta de eso.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
