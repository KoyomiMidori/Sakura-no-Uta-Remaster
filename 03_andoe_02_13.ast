astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm102"},
{"text"},
text={
ja={
{
"El dueño de la tienda de pintura me consiguió algunos de los pigmentos que le\nencargué. No todos, pero tengo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mañana me los llevaré a la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Obviamente, al taller.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="明石",size="z1",mx=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=100,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x2=100,x=0,lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=2},
},
},
text={
vo={
{"vo",file="man_wtd_000719",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“*hii*, *hii*, qué pesado está esto. ¿Qué demonios hay en estas cajas?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000109",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es lo que Naoya encargó. Yo tampoco sé por qué pidió esto.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque lo necesitaré. Entren rápido, si merodean mucho por el jardín los\nNatsume se darán cuenta.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000110",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="se2264"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Abro una pesada puerta.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Y enciendo las luces.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",id=1,file="se2580"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000111",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Este es... el estudio de Kenichiro Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Muy diferente al de Nueva York, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000112",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, aunque es algo muy normal ver a artistas poco populares trabajando en\ngarajes. El lugar no es lo que me sorprende.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? ¿Qué te asombró entonces?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000113",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Me asombré al darme cuenta de lo que piensas hacer.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio? ¿Solo con entrar acá te diste cuenta?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000114",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, aunque aun después de encargarme 4 docenas de resortes de entrenamiento\najustables no sabía todavía qué planeabas hacer.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x2=0,x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000720",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿De qué hablan? No estoy entendiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es normal, nadie en su sano juicio descubriría eso solo con entrar acá. Más\nbien se podría decir que Fridmann no es normal.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000115",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En realidad no es eso. Yo también he llegado a pensar varias veces en cómo\nreproducir el toque y fuerza del pincel de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera es sorprendente que te hayas dado cuenta.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000116",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Quisiera saber más bien cómo se te ocurrió esto, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde muy pequeño me obligaron a usar estos resortes de entrenamiento. Tengo\nmucha cercanía con ellos.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando era un niño llegué a probar colgando los resortes, y funcionó mejor de\nlo que esperaba. Digamos que fue jugando.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000117",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ya veo. Supongo entonces que este método no se te ocurrió de la noche a la\nmañana, ¿es así?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, esta vez necesito hacer más ajustes. Ya no se trata de solo un juego.\nAdemás, no tengo mucha fe en que este truco barato pueda reproducir los\ntrazos de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000118",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pero lo harás, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Bien, ¿me ayudan?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000721",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Ayudar?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, a montar el mecanismo para fabricar falsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se3679",id=1},
{"text"},
delay={
[200]={
{"se",file="se3679",id=2},
},
},
text={
ja={
{
"Fijo clavos en las cuatro esquinas del depósito.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"De no tener los enormes pilares del depósito no hubiese podido logrado esto.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"se",file="se0897s",id=1},
{"text"},
text={
ja={
{
"Anclo los resortes en los cuatro clavos que acabo de fijar.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Los resortes de entrenamiento son pequeños, pero se pueden unir uno con otro.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Finalmente, los estiro hacia el centro y los uno a un objeto con forma de\nanillo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Lo importante entre todo esto es que pueda alterar la elasticidad de cada uno\nde los resortes. Al aflojar alguno y estirar su lado opuesto, es posible\ndesplazar el punto de intersección entre los cuatro resortes.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_wtd_000722",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Q-Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un aparato diseñado para reproducir el mismo toque de los trazos de Kenichiro\nKusanagi. Aunque aún no está listo.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000119",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El brazo dominante de Kenichiro es muy fuerte. Se dice que el toque en sus\npinceladas se le debe a esa fuerza.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchos dicen que sus trazos tienen bastante suavidad y delicadeza. Al manejar\nsolo con los dedos un pincel descomunalmente largo, es capaz de crear trazos\núnicos.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000723",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Trazos fuertes, pero suaves...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes experiencia pintando Akashi, sabes de lo que estoy hablando, ¿no?\nManejar un pincel larguísimo solo con los dedos. Eso significa que el brazo\nestá completamente inerte durante todo el movimiento.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La extraordinaria fuerza de su brazo es lo que sostenía esos pinceles. Y solo\nde sus dedos nacían esos peculiares y delicados trazos.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esa peculiar delicadeza llevada a su límite lo que le dio vida a 'Cerezos\nrecostados'. Fue la anormal fuerza del brazo de Kenichiro Kusanagi lo que\nmaterializó esa imagen de muerte fugaz.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000724",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y-Ya veo, así que ese era el secreto de esos trazos. Es por eso que vas a usar\nel refuerzo de los resortes para pintar los cuadros.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000725",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, eso suena útil. ¡Entonces con algo elástico se pueden copiar esos\ntrazos!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Útil? ¿Es que tienes en mente copiar los trazos de Kenichiro Kusanagi, Akashi?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000726",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“N-No, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sus pinceladas requieren una técnica muy especial, no te la recomendaría mucho.\nIncluso usando estos resortes necesitas técnica.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000120",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Me lo imagino... Supongo que ahora tendrás que hacer bastantes ajustes, ¿no es\nasí?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente. Usaré toda esta noche para ajustar los resortes. Ver cuánto se\npueden mover en el plano, y cómo debería mover el lienzo y trazar.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, va a ser toda una labor tediosa.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0004",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000121",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Y después? Ya sé cómo vas a falsificar las obras, ¿pero has pensado en lo más\nimportante? El concepto de las siete obras. Nadie va a tragarse eso de que\nestas son obras de Kenichiro Kusanagi simplemente pintando otros seis cuadros\nde cerezos.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000122",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tienen que tener un valor combinado de más de 600 millones. 100 millones por\ncuadro, en promedio. Ni siquiera una obra real de Kenichiro Kusanagi\nalcanzaría normalmente ese valor.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro. Más de 100 millones por cuadro, eh... no suena nada fácil. Pero ya\nel concepto lo tengo pensado.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000123",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Ya tienes algo en mente?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo tengo. Dicen que 'Cerezos recostados' describe el instante de la muerte.\nImagino que lo sabes.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000124",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, lo sé. ¿Qué pasa con eso?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese cuadro tiene plasmado muy fuertemente en sí una imagen subjetiva de la vida\ny la muerte. Es justamente ese aspecto lo que le dará base al concepto de las\nfalsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siendo un hombre tan educado me imagino que debes conocer los 'Kusozu',\nFridmann.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000125",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡¿'Kusozu'?!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000727",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Q-Qué es eso de 'Kuso, zu'?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000126",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Kukuku, ya veo. Sí, es un buen concepto.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Fridmann, quien no suele reír mucho, estaba ahora soltando una pequeña risa.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué le parece, señor curador de la Fundación Moore?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000127",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Más que suficiente. Solo basta con que cumplas con los requisitos mínimos\ntécnicos de una buena falsificación y no habrá problema.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alivia escuchar eso de la boca de un profesional.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000128",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque, no queda mucho tiempo. Haz lo que puedas para convertir los Kusozu en\nuna serie de siete obras originales.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Haré lo posible.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000129",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Debo decir que nunca paras de sorprenderme con todas tus ideas, Naoya Kusanagi.\nEres, en cierta forma, un artista como pocos.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me sobrestimas. Simplemente he estado pensando en varias cosas, es todo.\nDigamos que sé un poco de todo.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000130",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Un poco de todo, eh. Tendré eso en mente.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"El primer día me gasté toda la noche solo ajustando los resortes que había\nfijado en los cuatro puntos.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Debo ser igual, o quizá más prudente aun haciendo esto que con la elaboración\nde los cuadros como tal. Si no obtengo buenos trazos es posible que todos los\ncuadros que elabore se vayan a la basura.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Terminé a tempranas horas de la mañana. Fue entonces que decidí tomar una\nsiesta.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"El dolor me hizo despertarme.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"El suelo del depósito es duro.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Una cobija?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"En ningún momento me moví de acá al tomar la siesta, y sin embargo estaba\ncálido ahora, con una cobija encima y un hibachi al lado.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo esto...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000403",ch="kzd"},
},
ja={
{
name={"???"},
"“¿Ya despertaste, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000404",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces aquí?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000405",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Yo solía vivir aquí, en la residencia Natsume. Es fácil entrar en este\ndepósito.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun así me sorprende que supieras que yo estaba acá. ¿Fuiste a saludar a los\nNatsume?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0009",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000406",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No. Aún no sé qué sucederá conmigo, así que no lo hice.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"mwact",act="びっくり",time=400,size=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Me levanto.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"A pesar de solo tomar una siesta, no tengo casi sueño. Mi cabeza se siente\nligera.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Volviste a tragarte mis sueños?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000407",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio? ¿No te pasó nada? ¿No tuve ninguna pesadilla o algo de ese\nestilo?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000408",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000409",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Aunque tampoco fue un sueño erótico...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te hizo daño?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000410",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No fue un mal sueño. Más bien fue uno bueno.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un buen sueño? ¿Qué sueño tuve?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000411",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No fue algo realmente concreto como para explicar tanto...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000412",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Fue un sueño donde florecían cerezos. Solo los veías. De eso trataba.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000413",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué te ríes?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues porque es eso justamente lo que tengo en la cabeza ahora... Es la imagen\nque tengo de lo que crearé.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000414",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿La imagen de lo que crearás?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, justamente ahora estoy intentando hacer florecer unos nuevos cerezos.\nQuizás sea por eso...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Haré florecer los cerezos que estaba viendo en mi sueño.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000415",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Sí vas a pintar entonces, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo haré.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000416",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eso, debes hacerlo... por mí?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no creo, la verdad. Realmente no lo hago por alguien en particular.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando pinto, es siempre por mí, y para mí...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000417",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por ti?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Por mí.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, creo que comenzaré a trabajar ya.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0003",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000418",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Puedo quedarme viendo?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque no será nada muy divertido de ver. Por más que vaya a pintar, a\nfinal de cuentas serán falsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"msgoff"},
{"fg",ch="雫",sync=1,mode=-1,lv=4,id=9},
{"se",id=1,file="se2580"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Enciendo las luces del taller y me paro frente al lienzo.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000419",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ese lienzo es enorme.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue hecho a medida.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000420",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Pintarás sobre este enorme lienzo?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Solo el boceto va a tomar una buena cantidad de trabajo.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Comienzo a trazar el boceto sobre el lienzo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Mi brazo izquierdo es suficiente por ahora para reproducir sus dibujos.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No en vano tengo grabadas todas sus pinturas en la cabeza...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Seguí dibujando por una semana.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Tomé el pincel, casi como poseído por algo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Al tomarlo en mi mano, toda clase de sentimientos se cruzaron en mi corazón.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Y no eran nada buenos.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"No, más bien eran de los malos. Terribles sentimientos calaban por todo mi\ncuerpo.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"La duda y la incertidumbre intentaban detener mi mano.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Sí, es esta sensación...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Conozco muy bien esta sensación.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Lo que significa crear un cuadro.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Lo que significa crear algo que hasta ahora nunca había existido.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Toda una oleada de sentimientos se desbordan como agua de una tetera hirviendo.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Sentimientos negativos.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Ira, vergüenza, desesperanza, impotencia...",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Todos esos sentimientos surgen al momento de crear algo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Pero no suelto el pincel.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"No puedo soltarlo.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm039"},
{"text"},
text={
ja={
{
"Y una semana después, en la mañana.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Los invité a entrar al taller.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000728",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Este lienzo es gigantesco...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es, fue difícil conseguirlo. Tengo que agradecerle al señor de la tienda de\npintura.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000131",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Lograste darle forma a tu idea?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los convoqué justamente para que vieran lo que he hecho.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000132",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pinturas de un cadáver... Veamos que has logrado con eso.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000729",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Cadáver? ¿Pinturas de un cadáver?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. El Kuzosu describe la muerte del humano y la forma en que su cuerpo\nse descompone.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una pintura budista que describe la descomposición de un cuerpo abandonado a\nla intemperie en nueve etapas.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tal como su nombre lo indica, describen las nueve transiciones que se\nexperimentan después de morir.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La primera pintura muestra un hermoso esbozo del cuerpo justamente después de\nmorir.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La primera fase de esa muerte, en nuestro caso, sería 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La segunda fase se llama 'Chousou' (La fase de la hinchazón), y describe de una\nmanera horrible la forma en que el cadáver se hincha.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta fase busca, muy seguramente, mostrar como el cuerpo se hincha por los\ngases que se producen debido a la descomposición.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La siguiente fase, 'Esou' (La fase de la destrucción), muestra como la piel se\npudre y se deshace al avanzar la descomposición, mostrando la carne.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Le sigue 'Kechizusou' (La fase del desangrado), donde la descomposición del\ncadáver avanza aún más, la carne comienza a abrirse, la grasa se deshace y la\nsangre y los fluidos internos manchan el suelo.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Luego sigue 'Nouransou' (La fase de la putrefacción) , donde el cadáver se\ndisuelve por completo.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sigue 'Shouosou' (La fase violácea), donde el cadáver toma un color morado.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Luego 'Tansou' (La fase de las moscas). Gusanos, moscas y todo tipo de insectos\nque se alimentan de los muertos aparecen.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Sansou' (La fase de la dispersión), donde todas las piezas del cadáver\ncomienzan a dispersarse.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Kotsusou' (La fase de la esqueletización), donde el cadáver se esqueletiza.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y finalmente 'Shousou' (La fase de las cenizas), donde lo único que quedan son\ncenizas.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000730",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“V-Vaya pintura tan tétrica... ¿Cómo es que existe semejante creación?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, supongo que habrán querido expresar la transitoriedad del mundo... En\nfin, el Kusozu usa a una hermosa mujer como base. Su concepto es,\nbásicamente, mostrar como algo hermoso se convierte en algo horripilante.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y de ahí es que 'Cerezos recostados' coincide muy bien con este tema,\nconsiderando que lo han descrito como una muestra de una 'hermosa muerte'.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las fases del Kusozu que acabo de describir son solo un estándar, y en realidad\nhay diversas variaciones. Variaciones que no siempre consisten de nueve\ncuadros, de hecho.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es decir, es posible crear una serie de 'Sakura nanasouzu' (Siete fases de los\ncerezos).”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que bueno, ahora que vieron la foto de la primera fase, 'Cerezos\nrecostados', quiero que vean esto ahora.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta es la segunda de las siete fases del Nanasouzu. 'Sakura no esou' (Cerezos\nen destrucción).”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"mwact",act="うなづく"},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Retiro la manta que cubría el lienzo.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000731",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000133",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este segundo cuadro toma el concepto del avance de la descomposición, y la\ndescripción de la piel pudriéndose y desprendiéndose, dejando ver la carne...\nen cerezos.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siguiendo el estándar, debí haber comenzado con 'Chousou', pero decidí no\ntomarlo para la serie de siete.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La hinchazón por descomposición se aleja mucho de la imagen de los cerezos, y\nel 'Esou' es más efectivo en mostrar la brecha de la hermosa imagen descrita\nen 'Cerezos recostados', empleando más bien esbozos de piel y carne\nexpuestos.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000732",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000134",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿es que no tienen ni un solo comentario? Fridmann, dime si encuentras\nalgo que deba corregir. Todo ajuste que esté a mi alcance lo haré.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000135",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Corregir algo? No seas idiota...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000136",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué se podría corregir de esto?... Es sencillamente impactante. Quién diría\nque esos hermosos cerezos podrían ser pintados de esta manera tan siniestra y\natroz...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedo entonces asumir que este cuadro tiene suficiente nivel como para pasarlo\npor falsificación?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000137",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Falsificación... No puedo creer que esto sea una falsificación...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000733",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“K-Kusanagi... Creo que estoy obligado a cambiar la imagen que tengo de ti...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué manera?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000734",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“P-Pues... sé lo mucho que te han aclamado como niño prodigio, y debo admitir\nque también he visto 'Fantasía de un día de cerezos' varias veces... pero,\nnunca llegué a comprender completamente la verdadera extensión de tu talento.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quedaste decepcionado?",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000735",ch="wtd"},
},
ja={
{
name={"Akashi"},
"¡No seas imbécil! ¡¿Por qué dejaste de pintar?! No cualquiera puede crear\ncuadros así. Los cuadros de Toritani y de Kei no le llegan ni a los pies a\nesto.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"Te equivocas. Esto es una falsificación. De no tener una obra tan grande como\n'Cerezos recostados' de base no hubiese podido obtener el impacto que tiene.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"Más bien soy yo quien no le llega a los pies a esos dos. Puedo crear todas las\nfalsificaciones que quieras, pero algo original no. Así son las cosas.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0005",head="aka_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000736",ch="wtd"},
},
ja={
{
name={"Akashi"},
"Por supuesto que no, es increíble la forma en que personificaste a los cerezos\ny muestras el interior como hechos de carne y órganos... cuando a simple\nvista lo único que se ve es un árbol botando savia por un hueco en su\ntronco...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000138",ch="frd"},
},
ja={
{
name={"Fridmann"},
"Comparado a la imagen del cuadro original, ciertamente es algo tétrico. Pero\ntiene toda la esencia del arte moderno.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"Definitivamente. Aunque en ese sentido, quizás se vea algo corriente.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000139",ch="frd"},
},
ja={
{
name={"Fridmann"},
"Sería más fácil hacer pasar esto por falsificación si eso fuese verdad...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿De qué hablas?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000140",ch="frd"},
},
ja={
{
name={"Fridmann"},
"No es nada. Bien, ¿qué hay de las demás?",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"Decidí no insertar 'Shouosou' ni 'Kotsusou', así que pintaré con las cinco\nfases que quedan. El problema es el tiempo.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000141",ch="frd"},
},
ja={
{
name={"Fridmann"},
"Sí, ya usaste una semana. El reloj no para de contar.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"Trabajaré de noche también.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000142",ch="frd"},
},
ja={
{
name={"Fridmann"},
"¿No bajará la calidad si trabajas de noche?",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"Podría ser, pero he estado todo este tiempo sin pintar. Creo que si uso todas\nesas ganas en estas dos semanas podré lograrlo.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000143",ch="frd"},
},
ja={
{
name={"Fridmann"},
"*fuh*, realmente no entiendo por qué dejaste de pintar.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué no entiendes?",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000144",ch="frd"},
},
ja={
{
name={"Fridmann"},
"Tal cual dije. Solo ahora te dignas a volver a pintar, para ayudar a alguien...\nY vaya que a pesar de eso creaste algo bastante atrevido.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000145",ch="frd"},
},
ja={
{
name={"Fridmann"},
"Este cuadro muestra sin revestimiento alguno el espíritu combativo de su autor.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues me alegra escuchar eso. Una pintura sin pasión no puede cautivar los\ncorazones de otros.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000146",ch="frd"},
},
ja={
{
name={"Fridmann"},
"*fuh*, de verdad que se parecen los dos. No sé cómo es que siempre andan con\nesa modesta actitud...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"Bueno, bueno, eso no importa. Quedan dos semanas para las negociaciones con los\nNakamura. Pondré toda mi sangre y sudor en esto.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así que los encargo a ustedes con eso, eh.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000147",ch="frd"},
},
ja={
{
name={"Fridmann"},
"No te preocupes.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000737",ch="wtd"},
},
ja={
{
name={"Akashi"},
"¡Yo también haré todo lo que pueda, sí señor!",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"bg",file="black",path=":bg/"},
{"bgm",stop=1,time=30000},
{"text"},
text={
ja={
{
"Seguí pintando, sin parar, día tras día.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Aquellos pensamientos que me distraían cada vez que tomaba el pincel.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"bgm",stop=1,time=10000},
{"text"},
text={
ja={
{
"A partir de cierto punto fueron desapareciendo, desvaneciéndose con el paso de\nlos días.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Entre cada pincelada que daba todo iba vaciándose dentro de mí. Sentía esas\ndistracciones desaparecer de mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Como si mi cuerpo fuera un pincel, mi corazón un lienzo, y todo mi ser se\nvolviera uno solo.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Siento como el pincel se mueve con facilidad en mi mano.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Es la primera vez en mi vida que siento tanta facilidad con el pincel.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué será?...",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"De cierta manera, ya sé por qué.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Poco a poco voy entendiendo.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"La razón por la cual estoy pintando estos cuadros.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"'¿Para salvar a Kuzu?'",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Se supone que ese era mi objetivo.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Pero eso no basta para alcanzar este estado mental.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"A medida que avanzo en la creación de estos seis cuadros voy tomando más\ncerteza de algo.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bgm",stop=1,time=5000},
{"text"},
text={
ja={
{
"Claro.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"'Cerezos recostados' fue pintado en honor a mi madre, Mizuna.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Es distinto a 'Fantasía de un día de cerezos', de mi creación.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ante la muerte, siempre podemos hacer más que simplemente despedir o recordar a\nalguien. Hay mucho más, definitivamente.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Es teniendo enfrente a la obra de ese monstruo llamado Kenichiro Kusanagi que\nentro en cuenta de eso.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Está repleta de todo ello.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Esta obra me cansa, me hace sufrir, me dan ganas incluso de huir. Pero aun así,\nestar acá me agrada.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Estando acá, incluso el propio sufrimiento se me hace plácido.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"se",id=1,file="se2264"},
{"text"},
text={
ja={
{
"Alguien abrió la puerta del depósito.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Y despierto de mi sueño.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"excall",file="03_andoe_02_14"},
{"text"},
linkback="block_00239",
},
