astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm105"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg028c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003223",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este lugar...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Al darme cuenta, estábamos ahora parados en donde alguna vez estuvo la mansión\nde Rin.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Por supuesto, por mera casualidad.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Aunque, igualmente, de haber seguido corriendo sin parar, en cualquier momento\nhubiésemos llegado acá.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Sin embargo, una vez más calculé mal las cosas.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Para mí, este lugar ha sido siempre 'las ruinas de la mansión tras el\nincendio'. Sin embargo, para ella, es la primera vez que ve esto como 'las\nruinas de la mansión tras el incendio'.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003224",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Rin corre con dirección al edificio, aún en construcción.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldita sea.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"se",stop=1,id=1,time=500},
{"msgoff"},
{"bg",file="znightsky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",id=2,file="se0888"},
{"text"},
text={
ja={
{
"Debajo del azulado brillo de la luna, el sonido de las escaleras de hierro\nsuena alrededor.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Rin va subiendo rápidamente las escaleras de emergencia, aún desnudas en acero.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Esa vista se me pareció a una espiral ascendiendo hacia la luna.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"cgdel",id=-1},
{"se",stop=1,id=2,time=500},
{"bgm",stop=1,time=500},
{"bg",file="ev_com_c10_01",path=":ev/ev_com_c10/",set="ev_com_c10"},
{"bgm",file="bgm106"},
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"Un fuerte viento sopla.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Demasiado le faltaba a este lugar como para poder llamarle azotea.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Una gran cantidad de vigas estaban expuestas al aire, y por supuesto, no había\nninguna valla o cerca.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Sin embargo, no parecía haber duda de que eso era una azotea. Más allá de este\nlugar no habían más plataformas de soporte para la construcción.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003225",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Recuerdo... recuerdo este paisaje...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003226",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi casa no era tan alta como este edificio, pero... aun así, el paisaje que se\npuede ver desde acá es el mismo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003227",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El mismo que aquel día...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin... regresemos.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003228",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Regresar? ¿A dónde podría regresar yo?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003229",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No puedo regresar... ¿Crees que de verdad puede haber algún lugar a donde yo\npueda regresar?...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"se",file="se9015",vol=51,id=1},
{"text"},
text={
ja={
{
"Al acercarme un paso, Rin se aleja otro.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"se",file="se9019",vol=51,id=1},
{"text"},
text={
ja={
{
"Rin se acerca cada vez más al borde de la azotea.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ese lugar es peligroso, ven acá...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003230",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De verdad es sorprendente lo tranquila que pude vivir aún después de haber\nhecho trizas el talento de alguien como tú, Nao-kun... Si fuera otro caso, la\nsensación de culpabilidad debería haberme matado ya.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003231",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En otro caso, no hubiera podido vivir con tanta pena. Normalmente así serían\nlas cosas...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003232",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estar por ahí libre, sin ningún castigo, aún después de haber cometido ese\ncrimen.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003233",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay forma de que algo así pueda ser perdonado...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Rin se habla y se responde sola, como si estuviera poseída por algo.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"¿'Alguien' le metió esas ideas en la cabeza?...",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Solo hay una persona capaz de haber hecho eso.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"La imbécil de Nagayama... Así que fue ella quien le metió esas palabras a Rin\nen la cabeza...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, escucha.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003234",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eres bondadoso, Nao-kun... Y por eso, eres capaz de mentirme tanto como sea\nnecesario.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003235",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eres capaz de sacrificarte a ti mismo tanto como sea necesario, para hacerme\nsentir tranquila.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003236",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y así como lo digo, has venido sacrificándote por mí hasta el día de hoy,\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003237",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque todos te preguntaran por qué ya no pintas, siempre seguiste insistiendo\nen que fue tu sola responsabilidad.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003238",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para no herirme... para protegerme...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003239",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fue por eso mismo también que tomaste distancia de mí.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003240",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pretendiste hacer parecer que no me contactabas solo por pura pereza... y en\nrealidad, te alejaste de mí solo para protegerme...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003241",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creíste que de hacer contacto de manera descuidada conmigo, podrías hacer que\nrecordara mi pasado, y pensaste que no podría aguantar el peso de mi crimen\nde suceder eso. Y por eso te alejaste a propósito...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003242",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y luego regresé a esta ciudad, sin siquiera entender ese gesto de bondad de tu\nparte...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas. Escucha, Rin--”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003243",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En qué me equivoco? Estuviste sacrificándote por mí, ¿no es así, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"De todas las maneras que podría haber de recordar el pasado, esta es la peor\nforma que a cualquiera se le podría ocurrir.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Y es que por mi propio descuido, dejé que Nagayama entrara a la habitación.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Ella le enseñó la verdad a Rin. Y de una forma que provocara que Rin sintiera\ntodo el peso de ese supuesto error.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"No, en realidad, si solo le hubiera dicho la verdad, tal vez no habría tanto\nproblema. Sin embargo, dentro de esa verdad están mezcladas unas cuantas\nruines mentiras.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡Escúchame primero!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy a responderte una por una a todas tus aseveraciones.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, es completamente falso que tú fuiste la asesina de tu madre.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que Nagayama te habrá dicho que el fuego comenzó en tu habitación al\nhaber leído ese artículo, pero esa no era tu habitación.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu mansión era enorme. Ya para entonces la habitación infantil no era usada por\nningún miembro de la familia, y ya estabas muy grande como para seguir\nquedándote en ella.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo sucedió hace 6 años. La habitación infantil fue simplemente una habitación\nque se usó hace mucho antes.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, la causa del fuego no fue culpa tuya, ni de nadie.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El fuego fue causado por un corto circuito en las conexiones eléctricas. Esa\nfue la realidad.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es toda una absurda y ridícula mentira aquello de que mataste a tu madre.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003244",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, eres tan bueno...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003245",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aún hasta ahora, has seguido protegiéndome, así como lo haces ahora...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Mierda...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"No me cree aún.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"No puedo negar que es lo más natural.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Sea cual sea la razón que tuviera, es un hecho que estuve engañando a Rin todo\neste tiempo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Para Rin, ahora, a medida que mis palabras sean más y más bondadosas, más\ndifícil se les hace creerlas.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Si ese es el caso...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="zev_com_c10_01",x=380,y=80,zoom=70,sync=0,face=1,time=400,path=":ev/ev_com_c10/",set="ev_com_c10",ax=1920,ay=1080,bx=-960,by=-540},
{"quake",size=5,mode="mw"},
{"se",file="se9015",vol=51,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Acorto la distancia entre los dos rápidamente.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"De verdad que no llegué a creer que Rin avanzaría más allá del borde de la\nazotea.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Pero la realidad traicionó mi expectativa.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_uni_c43_01",path=":ev/ev_uni_c43/",set="ev_uni_c43"},
{"text"},
text={
ja={
{
"La luna se me hizo enorme.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Y además, espeluznante.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"¿Por qué será? De alguna forma sentí miedo por ese cuerpo esférico, con su\nirradiante luz azulada.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Y en ese instante.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bgm",stop=1,time=1000},
{"se",id=1,file="kazenari"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003246",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah--”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Al haber acortado al distancia entre los dos, Rin se echó hacia atrás, solo por\nun instante.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Y en ese preciso momento, un viento sopla, casi como si hubiera estado\nacechando por ese instante.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Un increíblemente fuerte viento se produce por la azotea, que todavía seguía\nsiendo un rompecabezas de vigas entrelazadas.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Un viento lo suficientemente fuerte como para poder levantar a Rin, quien solo\nse había echado hacia atrás.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Rin va desapareciendo de mi vista.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"La luna nos ilumina a los dos.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Nos ilumina a los dos casi a propósito, como si fueran las luces del escenario\nen un acto de una obra de tragedia.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"se",id=1,file="se0744s"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Me lanzo hacia adelante y trato de agarrar a Rin.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Un edificio casi tipo torre, muchísimo más alto que aquella mansión.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"No hay forma de que se salve cayendo desde esta altura.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Y por eso, yo――.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"se",file="se3130",id=1},
{"bg",rule=105,time=100,file="black",path=":bg/"},
{"ex",time=3000,func="wait"},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
".....",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"Después de un momento de silencio, pude escuchar el fuerte sonido del viento.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Pude percibir la sensación de su toque.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Pude sentir, con toda certeza, su calidez en el brazo derecho que extendí en\nese cortísimo instante de tiempo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_c11_01",time=2000,path=":ev/ev_com_c11/",set="ev_com_c11"},
{"bgm",file="bgm107"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003247",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldita sea... no puedo meterle fuerza a mi mano...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003248",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, ¿por qué tu mano está tan cubierta de sangre?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Rin se queda asombrada al ver mi mano cubierta de sangre.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Se supone que no es el momento para hacer eso.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Incluso aún estando parada en la línea entre la vida y la muerte, ella se\npreocupa primero por mi mano que por sí misma...",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003249",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Qué le sucedió a tu mano derecha?! ¡Estás gravemente herido, tienes que\nrecibir atención médica ya!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Idiota! ¡No es el momento para que te preocupes de eso!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003250",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Por qué me dices idiota?! Es la misma mano derecha que yo me encargué de\nlastimar...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La única forma en la que se puede llamar a una idiota es 'idiota'! ¡Y eres\ntremenda idiota!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003251",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿P-Pero qué estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Solo te lo voy a decir una sola vez, estúpida Rin! ¡Y escúchame muy bien!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"No siento nada en mi mano.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"De saber que esto pasaría, hubiera sido mejor no cometer esa ridiculez de hace\nrato.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Si no hubiera golpeado la pared, quizás hubiera podido agarrar bien a Rin.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Pero ahora, siento que en solo pocos segundos terminaré dejándola caer.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Así que lo diré.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Diré algo que está en el polo opuesto de lo que se podría denominar bondadoso.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Le diré a Rin aquello que pienso, y que siento.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Fuiste tú quien me robó mi mano derecha! ¡¿No es así?!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003252",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Así es... y por eso mismo, suelta ya tu mano, por favor. No quiero que\nlastimes más tu mano derecha.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me jodas! ¡Fuiste tú quien me robó la mano! ¡Y por culpa tuya es que ahora\nno puedo seguir agarrándote más!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003253",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No quiero soltar tu mano!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero tenerte lejos de mí, jamás.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ahora... no tengo la fuerza como para hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pasarán ni minutos para que termine soltándote...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi mano derecha ya no tiene fuerza alguna.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y fuiste tú quien me quitó esa fuerza! ¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003254",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si es así, entonces encárgate tú de agarrar mi mano!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No puedo agarrar nada, no puedo apretar nada! ¡¡Así que usa tu mano, y agarra\nla mía!!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Eso es lo mínimo que podrías hacer!!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quieres creer que fuiste tú quien me quitó la mano derecha, puedes hacerlo.\n¡Puedes pensar eso si quieres! ¡¡Pero si ese es el caso, entonces asume tu\nresponsabilidad!!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Haz aquello que mi mano derecha no puede hacer!!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Haz aquello que yo no puedo hacer!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Haz lo que te estoy pidiendo!!",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, quiero alejarme de ti... Así que agarra tú mi mano derecha... agárrala, por\nfavor...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agárrala... y no la dejes ir.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Agárrame con tus propias manos, y abrázame!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Ya no puedo darle fuerza a mi mano.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"se",file="se3130",vol=50,id=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"Justo cuando creí que había llegado el peor momento, siento una fuerte presión\nsobre mi mano.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"La mano de Rin está agarrando fuertemente mi brazo.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003255",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja las lágrimas para después! Agarra mi brazo y trepa. No tengo fuerza ahora\nni para levantarte.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se me torcieron los pies cuando salí a perseguirte. Tuve que caminar después\ntodo un buen rato, y la verdad es que no doy más. No puedo meter más fuerza\nen ellos.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que hazlo rápido.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin agarra fuertemente mi mano.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y va trepando con fuerza hacia arriba.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"¿Es esta la misma niña que atrapé y sostuve aquel día?",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Rin va subiendo, en dirección recta, hacia mí.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Y entonces, me abraza.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",file="se0897s",id=1},
{"msgoff"},
{"bg",file="znightsky_summer",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=-960,y2=-540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Desmoronándose en lágrimas.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Lo único que hice fue abrazarla mientras tanto.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdí mi brazo derecho para protegerte...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me robes eso ahora. Te lo ruego...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin... vive, por favor...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por mí...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por tu madre también...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003256",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Perdón, perdóname... Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
