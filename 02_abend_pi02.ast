astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm007"},
{"bg",file="eveningsky_spring01",id=9,lv=9,path=":cg/"},
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde que comenzó el verano, ha parecido estar muy ocupada.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Traté de pensar en alguna otra persona que pudiera salvarme de este aprieto,\npero terminé llegando a la conclusión de que Toritani era la indicada.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Parece estar terriblemente ocupada últimamente, pero, no estaría tan mal darle\nla libertad a Toritani de que me pida ayuda en algún momento a cambio de que\nme ayude a conseguir el camino de vuelta.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"La verdad, no quisiera acabar de nuevo repartiendo folletos de la misma manera\nque se hizo durante la búsqueda de nuevos integrantes. Aunque, Toritani\nparece haberse pensado bien las cosas después de ese día, así que seguramente\nno volverá a tratar de ejecutar esa clase de ideas tan excéntricas.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",id=1,file="se1343"},
{"text"},
text={
vo={
{"vo",file="fem_ans_000001",ch="ans"},
},
ja={
{
name={"Contestadora"},
"“Deje su mensaje después del tono...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Me atendió la contestadora. ¿Será que está trabajando en Quimera?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
"Se me hace algo incómodo cortar la llamada sin decir nada, así que le dejo un\nbreve mensaje explicando de manera simple mi situación y corto.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué hago ahora?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"¿Me pongo a buscar a otra persona que pueda ayudarme? ¿O será que busco alguna\nmanera de regresar por mi cuenta?",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",id=1,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001007_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Hola? ¿Kusanagi? ¿Te perdiste?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay de ti? ¿No estás trabajando?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001008_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Justamente ahora estoy afuera, haciendo algunas compras para la tienda. Tuviste\nsuerte, si no fuera por esto hubiera dejado el teléfono dentro del casillero\nhasta el final de mi turno.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, parece que sí tuve bastante suerte.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001009_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estuve trabajando en la caja hasta hace un rato. Disculpa que no haya podido\natender.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si estás afuera ahora entonces me es más fácil pedirte el favor. Tal como lo\nmencioné en mi mensaje, estoy desesperadamente extraviado. Ayúdame, te lo\nruego.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001010_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Mmmm?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001011_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me quedé pensando un momento, pero, sí, esa forma de pedir ayuda sin tanta\nreserva es muy de ti, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos andas diciendo? De llegarme a meter en problemas no dudaría jamás en\npedir ayuda.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001012_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, supongo que tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001013_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueh, está bien. No es nada que no pueda hacer además. Pero lo sabes, ¿no?...\nLo que implica haberme elegido.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Voy a quedar en gran deuda contigo por esto. Te ayudaré en lo que\nsea tanto como lo puedas necesitar. Así que ayúdame ahora, por favor.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001014_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001015_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será que estoy imaginando demasiado? No pareces muy alegre de quedar en deuda\nconmigo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son solo cosas tuyas, tu imaginación. Bien, ¿cómo puedo regresar a la ciudad de\nnuevo entonces?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001016_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Espera un momento...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"Un breve instante después, Toritani apareció. A pesar de haber ido de compras,\nno parece llevar muchas cosas encima.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001017",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, pudiste quedarte esperando quietecito. Muy bien.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera es capaz de quedarse quieto esperando por alguien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001018",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tanto, la verdad. Hay casos en desastres y tragedias, por ejemplo, en la que\nla persona atrapada en medio de la nada trata de moverse sin conocer el\nlugar, solo para no causar molestias, y termina haciendo más difícil su\nbúsqueda.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estuve atrapado en medio de la nada?...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001019",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De cierta manera lo estabas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, gracias por venir. Me sacaste de un aprieto. Te pagaré esta deuda con\ntoda seguridad.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001020",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien. Uhm, sí, para comenzar, ¿será que te pongo a ayudarme con las\ncompras?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Camino ahora al lado de Toritani, quien me puso un montón de bolsas encima.\nDebido a que se trataba de una compra grande, me llevó a caminar por varios\nlugares.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Toritani camina con soltura, llevando solo unas pequeñas cajas.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Sin embargo, la carga que llevo ocupa bastante volumen, pero no es realmente\ntan pesada.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿cómo es que pudiste llegar hasta donde yo estaba?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Suelto la duda que tenía en mente desde hace un rato.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001021",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace un rato me diste el nombre de la cuadra que observaste en el letrero\npegado al poste telefónico, ¿no? Basta después con ver el mapa para llegar\nhasta allá sin problemas.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Poder leer un mapa es como poder hacer hechicería.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001022",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, tampoco estamos en medio de las montañas... Cualquiera es capaz de\nhacerlo. Aprende de una buena vez a leer los mapas, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás en todo lo correcto, sí. Pero... piénsalo un momento, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001023",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pensar en qué?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando la pésima desorientación de alguien alcanza un nivel tan terrible como\nel mío, uno podría pensar que eso es en realidad alguna especie de habilidad\nespecial. Quizás podría servir de algo.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te parece que sería un desperdicio acabar con un talento de esa magnitud?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001024",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmmm. Dame un ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, podría entender cómo se sienten mis otros camaradas... ¿o algo así? No\nexiste ninguna habilidad inútil en este mundo, para que lo sepas.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001025",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Camaradas?... ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás pueda referirme a todos ellos como la población desorientada. El grupo\nde todas aquellas personas desorientadas, capaces de hacer de su ciudad un\nlaberinto. Por lo general solo la misma persona puede aprovechar esa\nhabilidad, pero a veces llega a involucrar a los demás en sus extravíos.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001025b",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Deja de decir idioteces y abre los ojos a la realidad.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdón...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001026",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, ya estoy acostumbrada a las personas con un horrible sentido de\norientación.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo dices, la forma en que actuaste y viniste a ayudarme fue bastante\nrápida.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001027",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, sí, tengo un familiar que también es así. La población desorientada,\n¿dijiste?... Sí, ciertamente, a veces no logro entender lo que las personas\ndesorientadas dicen...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001028",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué será que confían más en sí mismos que en un GPS?... Aun cuando a cada\nmomento se pierden. No logro entender eso, me parece totalmente ilógico.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... en mi caso, yo conozco muy bien los estragos que conlleva tener un\npésimo sentido de orientación, y además no confío en mí mismo en lo que a\norientarme respecta.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001029",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tienes razón. Y por eso mismo, ¿no crees que quizás puedas arreglar eso\nalgún día? Lo de ella ya es un caso perdido, no doy para más...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe ser un caso bien terrible como para que digas eso.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001030",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Casi siempre que la llamo cuando necesito que regrese, nunca atiende... Jaa...\nComo me gustaría que fuera un poco más consciente de su responsabilidad como\ngerente.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Espera, será que esa persona que tanto sufre de desorientación es...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001031",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, es la dueña.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, espera, en pocas palabras, ¿la dueña es familiar tuya?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001032",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿es que acaso no te lo dije antes?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estoy enterando ahora.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001033",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno, no hacía falta mencionarlo, así que tal vez por eso no lo dije. La\ndueña de Quimera es mi prima. Tiene unos cuantos años más que yo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, es esa cercanía que tienen como familiares la razón por la\ncual te encargó la tienda a ti, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001034",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No solo eso, me está dejando vivir en el segundo piso también. Si no ofreciera\neso no valdría la pena aceptar la tarea, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001035",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es así, entonces esta deuda que contraje debe ser bien grande, eh. No cabe\nduda de que voy a ser bastante explotado. Con toda seguridad.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001036",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Deja de decirlo de esa forma, ¿sí?... Por Dios, vas a hacer que me arrepienta\nde haberte dejado en deuda conmigo.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no me convendría mucho.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",file="se1296",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"Mientras hablábamos, levanto un poco la carga que llevaba en uno de mis brazos\ny la redistribuyo al otro.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001037",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pesa tanto, pero hace bulto, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la verdad que sí. Por cierto, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001038",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres? No voy a darte ningún receso, por si se trata de eso. Llévalo\ntodo de una vez hasta Quimera. Si lo haces entonces quizás te dé un vaso de\nagua.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, me refiero a eso.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Después de dejar toda la carga sobre una de mis manos, extiendo mi otra mano\nhacia Toritani.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001039",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está pesado eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001040",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pesa. Además, no tiene ni una décima del volumen de lo que tú estás\nllevando.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me doy cuenta por la forma en que estás usando los músculos de tu brazo. Pesa\nbastante, ¿verdad? Vamos, yo me encargo de llevarlo, dámelo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001041",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Por eso es que no puedo con personas tan observadoras como tú.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Saber observar el movimiento de los músculos es una de las básicas de las\nartes, ¿no? Y además, también quiero pagarte de vuelta la deuda.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001042",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Pesa bastante, ¿estás seguro de que quieres hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué es lo que te preocupa, pero te digo que tengo suficiente fuerza como\npara cargarte sin tanto problema. ¿Quieres intentarlo?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0013",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0025",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001043",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Está bien! ¡No hace falta! Por Dios... siempre diciendo cosas tan fuera de\nlo normal... Toma.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Toritani me pasa las bolsas, algo renuente. Siento un fuerte peso caer sobre\nmis manos.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"cgact",stage="bg013",act="いいえ",lv=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uoh!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Esto está bien pesado.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Vaya que pudo cargar esta cosa tan pesada con esa cara tan impasible. De verdad\nque es muy buena fingiendo normalidad aún pasando trabajo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001044",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te fuerces tanto, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo te digo yo a ti. Por cierto, ¿qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001045",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son piedras base para fabricar esmalte cerámico. Por lo general las ordeno por\nInternet, o me llegan junto al café y las tazas que me envían, pero, habían\njusto las que quería en oferta allá, así que... no pude resistirme.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque ahora que lo mencionas, ¿la dueña no solo te manda tazas y café, también\nte manda material para hacer esmalte cerámico?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001046",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ella es también una coleccionista. No solo de tazas, sino también de café.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001047",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cierto, también me manda la paja que uso para obtener las cenizas que se\nmezclan junto al esmalte cerámico. Gracias a ella he podido reunir una buena\ncantidad de materia base muy curiosa que me ha servido bastante.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La dueña también trabaja con alfarería?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001048",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, aunque ahora solo tiene ojos para el café. Es gracias en parte a su\ninfluencia que cogí interés por la alfarería también.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, debe haber sido entonces una gran influencia para ti, me imagino.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001049",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Ella ha sido como una hermana para mí, aunque su influencia sobre mí\ntampoco fue tan enorme. Al final, fui yo quien tuvo el interés y tomó la\ndecisión de comenzar a practicar la alfarería.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que la dueña también practica alfarería... Juraba que practicaba\ncaligrafía, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001050",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Caligrafía? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues la escritura que se ve en el letrero de Quimera está fabulosa.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001051",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, sí... Según he escuchado, los Toritani solían practicar y tomar lecciones\nen distintas actividades artísticas y ceremoniales hace un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Actividades artísticas y ceremoniales? ¿Te refieres a ceremonias de té,\narreglos de flores y todo eso?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001052",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, eso mismo. Son conservadores, anticuados... Aunque bueno, ahora no es más\nque una familia sin nada más que una larga historia.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001053",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La escritura que muestra en las postales que manda a veces es hermosa, así que\nsupongo que habrá practicado caligrafía hace un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001054",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque todo lo que escribe siempre parece un acertijo, la verdad... y por eso,\nno sé ni dónde está, ni a dónde fue.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debes estar pasando bastante trabajo...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001055",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tanto.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Mientras caminábamos, pasamos frente a la tienda departamental.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh--”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Me paro y veo hacia arriba, para leer la pancarta vertical colgada del\nedificio. Hoy tienen... una exhibición de colchas, y otra de productos de\nHokkaido.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre hacen eventos bastante interesantes aquí, eh.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001056",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, vaya que sí. El organizador tiene unos gustos bastante descabellados,\naunque entretenidos, y también muestran productos no muy populares. No tiene\ntan mal ojo, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me gustaron las piezas de cerámica que vi hace poco en el sitio de eventos de\nesta tienda.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001057",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, sí, esa exhibición estuvo muy buena. La temática fue bastante interesante,\ny además exhibieron también productos de talleres pequeños.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Diez tonos de blanco'. Así se llamaba, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Muchos pensarán que solo hay un color blanco, pero en realidad hay varios. Esa\nfue una exposición de artículos generales de uso diario pintados en varias\ntonalidades de blanco.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"A pesar de que eran artículos de uso diario, habían muchos productos de muy\nalto nivel, obras propias de buenos talleres. Y sin embargo, el hecho de que\nestuvieran hechos con énfasis en el uso diario les valió muy buenas críticas\ny comentarios por parte de todos.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En mi caso, me arrepentí de no comprar algo y terminé ordenándolo por Internet.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también fuiste a ver la exhibición, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001058",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, me llamó la atención y fui a dar un vistazo.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será que fuiste a echarle un ojo a los productos de 'Conejo de Luna'?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0012",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001059",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Cómo es qué conoces ese fabricante tan poco... popular, Kusanagi? Además,\nno eres el tipo de persona que se interesa mucho por artículos de uso diario,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No subestimes el valor que pueden llegar a tener las piezas de uso diario, en\nespecial las de ese fabricante. A pesar de que sus artículos están diseñados\npara acompañar el día a día de los usuarios, tienen cierta voluntad, cierto\npropósito encerrado en ellos, pero eso sin afectar de ninguna forma su uso\npráctico.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No cualquier artista puede lograr eso.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001060",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿H-Hmph--?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muh...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-275,file="zbg013f",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0011",head="mak_z2b",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Veo fijamente a Toritani, examinando su expresión.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0008",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001061",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué?... ¿Por qué me ves así?...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani... Al principio pensé que eras fanática de esas tazas, pero... ¿será\nque--”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0012h",head="mak_z2b",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001062",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será que prefieres algún otro fabricante? ¿Tal vez no te gusto mucho que\nhalagara tanto los productos de 'Conejo de Luna'?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, ciertamente no eres tan intolerante con las opiniones de los\ndemás... pero, ser fanático de algo implica tener un fervor y entusiasmo que\nte hace perder la objetividad al ver las cosas, y...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0010",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001063",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Jaa.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001064",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es nada de eso, y tampoco me parecen tan malas esas tazas. Simplemente me\nsorprendí de que las conocieras, considerando lo poco populares que son.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Poco populares? ¿Lo dices en serio?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001065",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las cosas buenas no dejan de ser buenas aunque nadie las conozca, ¿no? No estoy\ntratando de ofender o desprestigiar las tazas que tanto te gustan, así que no\nte confundas.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues yo tampoco soy capaz de malentender las cosas de esa manera, pero...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001066",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que ya perdimos mucho tiempo hablando acá, vámonos ya.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",file="se9004",id=1},
{"fg",ch="真琴",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani comienza a caminar de nuevo rápidamente, y me apresuré para seguirla.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_pi03"},
{"text"},
linkback="block_00152",
},
label = {
top={block="block_00000",label=1},
},
}
