astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c07_01",path=":ev/ev_eye_c07/",set="ev_eye_c07"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Esta es la historia de Shizuku y yo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Quizás esté de más decirlo ahora, pero ese día...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a07_01",path=":ev/ev_com_a07/",set="ev_com_a07",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Ese día que nos vimos en la colina de Yumenouki, con los cerezos arreciando, no\nfue nuestro primer encuentro.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Fue nuestro reencuentro.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"O podría decir también, mi primer encuentro con Shizuku Natsume.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Eso fue.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Su nombre es 'Shizuku'.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Si lo conviertes a hiragana, se lee Shi-zu-ku.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Si lo inviertes, obtienes 'Ku-zu-shi'.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Pero a ella no le agradaba una de las sílabas de ese nombre.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"'Shi'.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"'Shi' significa también 'muerte'.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Y en ese tiempo, era la muerte de un hombre lo que más le costaba aceptar a\nella.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Un hombre que quiso y cuidó de ella.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"No, no solo a Shizuku, sino también a los Natsume.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Shizuku no quería aceptar la muerte de ese hombre.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Y por eso retiro el 'shi' de 'Kuzushi'.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Convirtiéndose en 'Kuzu'.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Al principio se hacía llamar Kuzu Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Lo que voy a contar ahora es la larga, un tanto larga historia de nuestro\npasado. De Kuzu y yo.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Parecerán simples historias de recuerdos pasados, pero tiene mucha importancia.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"'Una espléndida confusión de epitafios.'",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Eso fue lo que él dijo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"“",
{"txruby",text="Una"},
"A",
{"txruby"},
" ",
{"txruby",text="espléndida"},
"Nice",
{"txruby"},
" ",
{"txruby",text="confusión"},
"Derangement",
{"txruby"},
" ",
{"txruby",text="de"},
"of",
{"txruby"},
" ",
{"txruby",text="epitafios"},
"Epitaphs",
{"txruby"},
"”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Así es, esta es la historia de los epitafios de cierto artista.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Y de su espléndida, maravillosa confusión.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Una confusión de epitafios.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Una historia del pasado.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=3000,func="wait"},
{"bgm",file="bgm019"},
{"text"},
text={
ja={
{
"Era un día de invierno.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"El día después de que Kenichiro regresara a Japón, e ingresara de emergencia al\nhospital.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Estaba yo parado, en su habitación.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"user",mode="conf",ch="健一郎"},
{"bg",file="ev_com_f02_06",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000577",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eh, hijo mío. ¿Cómo andas?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, supongo.\nMejor que tú, viejo.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000578",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Así le llamas a tu padre? Diablos, vaya mocoso irrespetuoso en que te has\nconvertido.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No debería ser sorpresa que terminara así considerando tu negligencia.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
},
},
text={
vo={
{"vo",file="man_kid_000579",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Negligencia? ¿Pero qué disparates dices? Te di una educación de primera, ¿o me\nlo vas a negar?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo para la pintura, eso sí. Fuiste un desastre en todo lo demás.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_kid_000580",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para todo lo demás también te enseñé muy bien. Tantas veces que te dije,\n'¡ponte a mis espaldas y observa bien cómo lo hago!'.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso lo único que aprendí es que estás algo jorobado.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
},
},
text={
vo={
{"vo",file="man_kid_000581",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No vayas a imitar eso. Procura siempre llevar buena postura.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, procuraré no terminar siendo un jorobado como tú.\n¿Y bien? ¿Qué quieres?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000582",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, sí.\nNo me queda mucho tiempo ya.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo así me imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_kid_000583",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ya te habías dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé muy bien lo mucho que odias los hospitales.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vuelves de repente y de inmediato te hospitalizan.\nObviamente no se trataba de nada bueno...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000584",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo. Pues bueno, supongo que mi educación no fue tan mala después de todo.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso me implantaste una habilidad especial para predecir la muerte de\nmis progenitores?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000585",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, no me tomes el pelo...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000586",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo dije en el sentido de que eres capaz de aceptar la muerte del único pariente\nque te queda.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que quería mucho más a mi madre, así que realmente no me causa\nmucho impacto el anuncio de tu muerte.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000587",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Auch, auch.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, llevo años viendo la manera en que trabajas.\nNo esperabas vivir mucho después de todo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000588",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahhh, la verdad es que sí. Es algo extraño, esperaba vivir unos cuantos años\nmás, por lo menos diez.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debiste haber ido entonces con un maldito doctor humano.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000589",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, que la gente se enferma es cuando va al doc'.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. ¿Qué clase de idea retorcida tienes en la cabeza?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000590",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ni tan retorcida, eh. Ehm, ¿mecánica cuántica era que le llamaban? Eso que\ncuando hay incertidumbre no puedes definir nada, o algo así. Por lo tanto,\nenfermarme o no es solo una probabilidad mientras no vaya al hospital.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota no eres, no digas estupideces.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000591",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Claro que lo soy.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Idiota tú? Je...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Observo los alrededores de la habitación.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Había la típica montaña de libros con la que lo veía siempre.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso al hospital traes un montón de libros, y de los complicados. ¿De que es\nel libro que tienes al lado de la almohada? ¿Filosofía? ¿Matemática?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000592",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ni idea. No entiendo casi nada de lo que dice.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun hospitalizado no paras de leer, eh.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000593",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y qué?... Tu cara lo dice todo, eh... 'A un paso de la tumba y este viejo\nsigue leyendo'...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No era eso lo que tenía en mente...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000594",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, por cierto, también estoy leyendo libros del mundo del más allá.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Del más allá? ¿Es que andas leyendo historias paranormales?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000595",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Realmente no. Estoy leyendo el Sutra del Loto.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El Sutra del Loto?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000596",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. ¿Sabes? Quisiera un 'papel verde de mandala comprimido doblado en cuatro\ndel tamaño de una tarjeta postal' que me permita ir a donde sea en 'este\nmágico e incompleto tren de la Vía Láctea de la cuarta dimensión'.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué diablos dices?... Lo que Giovanni le dio al conductor en 'El tren nocturno\nde la Vía Láctea' era solo un 'papel verde doblado en cuatro, como del tamaño\nde una tarjeta postal'. ¿Qué es eso de mandala comprimido?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000597",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Oh? Vaya, qué sorpresa. Te diste cuenta de que hablaba del tren nocturno.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo vas a encontrar el término de 'Tren de la vía láctea' ahí, o en el Expreso\n999.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000598",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De igual forma me sorprende. Es asombroso que recuerdes la novela favorita de\ntu padre hasta el pie de la letra.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo recuerdo al pie de la letra, solo que la escena del boleto me quedó en la\nmemoria.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000599",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Volviendo al tema, ¿por qué rayos andas leyendo el Sutra del Loto?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000600",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pueees, tampoco es que comencé a leerlo así como así, pero digo, ahora que me\nno me queda casi vida por delante debería aprenderme el nembutsu, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000601",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por algo dicen que el nembutsu es lo que nos sostiene.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000602",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa? Vamos, quita esa deprimente cara, vas a hacer que me deprima yo\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué quieres que haga? Vine porque me lo pediste. Dime ya qué quieres.\nNo me habrás llamado para hablar de esas ridiculeces, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000603",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Obviamente no. Te llamé por algo más importante.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="zev_com_f02_01",zoom=160,x=1900,y=-1180,sync=1,path=":ev/ev_com_f02/",set="ev_com_f02",ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=500,func="wait"},
{"se",file="se9010",sync=0,id=1},
{"bg",file="zev_com_f02_08",zoom=160,x=1900,y=-1180,sync=1,path=":ev/ev_com_f02/",set="ev_com_f02",ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=1000,func="wait"},
{"bg",file="ev_com_f02_08",sync=1,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000604",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Toma, te daré todo lo que esta ahí.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Kenichiro me lanzó algo.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?...\n¿Una libreta?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_f02_13",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000605",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tu herencia.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás mal de la cabeza? Aún no has muerto, no puede haber herencia.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_f02_08",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000606",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Al parecer salen menos costosos los impuestos si transfieres la fortuna aún con\nvida.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, eso es cuando lo transfieres poco a poco a largo plazo, entre 10 y 20\naños. Si me lo das así de una vez los impuestos se llevaran una buena tajada.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_f02_11",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000607",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Cómo es que sabes todo eso con esa edad?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No por algo esta es la segunda vez que tengo que lidiar con un impuesto de\nsucesión... Maldita sea, lo único que aprendo son cosas inútiles.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_f02_09",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000608",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bueh, la verdad es que no conozco muy bien lo del impuesto por transferencia de\npropiedad. Aunque parece que el límite superior cambia por período.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Tomo la libreta que me lanzó.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuánto hay aquí--”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qué carajo es esto?! ¡Hay demasiados ceros en este monto! ¡Mierda,\ntienes más de 800 millones! ¡Casi 900 millones de yenes!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000609",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todo es para ti. Llevátela.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué significa esto?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_f02_05",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000610",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué significa qué?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que fuiste a los Estados Unidos y nunca regresaste de vuelta porque\nquerías acumular dinero para hacer algo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000611",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene sentido entonces. Se supone que este dinero lo ahorraste para algo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000612",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Algo así.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ese dinero tiene que ver algo con los Nakamura y los Natsume.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_kid_000613",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estás en lo cierto.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuviste buscando dinero donde fuera en Nueva York, sin preocuparte siquiera\nque te llamaran estafador. Y todo para luchar con los malditos Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000614",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene sentido entonces que me des todo ese dinero justo ahora, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_kid_000615",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Concuerdo contigo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué haces esto?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000616",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ese dinero lo reuní con un propósito en mente.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces--”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000617",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero ya me voy a morir. Y no pude reunir lo que necesitaba.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera un momento, ¿qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000618",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo que tengo no alcanza, así que no me sirve de nada ya. Te dejaré con lo que\nreuní. Podrías vivir sin trabajar el resto de tu vida, o emprender en algo,\nlo que quieras. Nada mal, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso podría decir si no fuese porque hay algo más.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000619",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué tiene de malo entonces?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente eres retorcido, eh.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000620",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por supuesto que no. Soy un hombre muy cálido y amable.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime dónde está ese hombre, porque no lo veo. Te gastaste toda tu vida\ntrabajando y haciendo dinero. Pero justo antes de cumplir tu objetivo te\ndiste cuenta que estabas por morir.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000621",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Correcto.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ahora estás diciendo que me darás ese dinero a mí.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kid_000622",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Porque eres mi único pariente, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldito viejo... ¿En qué lío planeas meterme?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000623",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Lío de qué? Le estás buscando las cinco patas al gato. Además, no te he pedido\nnada, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, me quedaré con esta libreta.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000624",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te la doy, es tuya.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Y la usaré como me plazca.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_kid_000625",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para eso te la di.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Demonios! ¡Tanto tiempo sin verte la cara me hizo olvidar la mierda de persona\nque eres!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000626",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué se supone que soy una mierda? Te acabo de dar casi 900 millones.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creas que no sé nada. Solo por si lo olvidas, soy tu hijo, y además bisnieto\nde la mismísima Kotoko Natsume.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000627",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo he olvidado.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé también a lo que nuestra familia se ha enfrentado todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_kid_000628",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué orgullo escuchar eso. Hijo mío tenías que ser.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000629",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vale. Otra cosa, ¿podrías encargarte de esa muchachita? Disculpa que te lo pida\nde repente.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿M-Muchachita?",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Apenas proceso lo que escuché, volteo.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"¿Por qué no me di cuenta antes?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Justo detrás de mí estaba una muchacha.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Con sus manos apretujando el borde de su vestido.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1f1201",face="f0001",head="shz_z1f",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién es esta muchacha?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_kid_000632a",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hmmph...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Mi padre se levanta de la cama.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_kid_000630",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Puedes presentarte?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fgact",ch="雫",act="うなづく",size=8,lv=4,id=9},
{"text"},
text={
ja={
{
"La muchacha asiente.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000001",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me llamo Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kuzu? ¿Ese es su nombre?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000631",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuzu por kuzumochi. No tiene nada que ver con el carácter de basura.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Vas a decirme quién es?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000632b",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ha estado viviendo conmigo todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Contigo? ¿Es entonces estadounidense?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000633",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es japonesa. Solo que pasaron unas cuantas cosillas y tuve que traérmela.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Unas cosillas? Cosillas, eh.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y cuál es su apellido?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000002",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"bgm",file="bgm007"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡B-Bastardo! ¡¿Es que embarazaste a alguna mujer por allá?!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0006",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="びっくり",size=8,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000634",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Claro que no, diablos. Mi corazón solo le pertenece a Mizuna. ¡No necesito a\nnadie más!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tiene entonces el apellido de Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0009",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000635",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No te acabo de decir que pasaron unas cosillas?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cosillas, cosillas, ¿qué clase de cosillas?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000636",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Después te explicaré.\nPor ahora quiero que la resguardes por unos meses.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Dónde?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000637",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En casa. Hay bastante espacio en ese apartamento, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera un segundo, sí hay bastante espacio y todo, pero es peligroso que me\npongas a vivir bajo un mismo techo con una muchacha que apenas conozco.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_000638",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eso crees? ¿Quién le metería mano a una muchacha que apenas conoce? ¿O es que\neres tan depravado que serías capaz de ignorar eso y ponerle las manos\nencima?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Justo tenías que hacer énfasis en eso?! ¡En fin, no puedo vivir bajo el mismo\ntecho con una muchacha que no es novia ni nada mío!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No tiene nada que ver lo de meterle mano o no!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000639",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ah?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Después de ponerse a pensar un momento, Kenichiro susurró algo.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000640",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya mentalidad anticuada que has desarrollado, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A eso se le llama tener sentido común, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0011",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000641",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De verdad? No creo que hoy en día hayan tantos muchachos así de preocupados\npor su castidad, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que los hay!...\nO eso pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"¿O no? La verdad es que no lo he pensado mucho...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000003",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya, ¿perderás la razón y me violarás?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qué diablos dices?! ¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000004",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Entonces no habrá problema. No tienes nada de qué preocuparte.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no me refiero a eso--”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0012",head="shz_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000005",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Entonces a qué?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-A qué?...\nUgh...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Apenas le di la cara a la muchacha, me di cuenta de algo.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kid_000642",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Justo ahora se te pasó por la cabeza lo hermosa que es, ¿a que no?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Claro que no!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_kid_000643",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No te parece preciosa entonces?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues tiene una linda cara. Es preciosa, nadie lo podría negar.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0001",head="shz_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000006",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"... *baja la cabeza*.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"La muchacha llamada Kuzu me hizo, por alguna razón, una reverencia.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué haces eso?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0002",head="shz_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000007",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Expreso mi agradecimiento por el cumplido.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo preguntaba por eso...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0009",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_000644",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La muchacha no tendrá dónde quedarse si no te la llevas. ¿Vas a dejar morir en\nla calle a esta pura e inocente criatura?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué tonterías dices?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ah.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah! ¡Claro! Ya, ya lo vi todo.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldición, sí sabía que había algo más, pero no pensé que me asomaras la\nrespuesta tan pronto.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000645",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que de qué hablo? No me tomes el pelo con esa cara de yo no sé nada,\ndemonios...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000008",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Naoya? ¿Te enojaste conmigo?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, contigo no.\nSolo con el idiota que tengo de padre.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000009",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Kenichiro es una buena persona.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buena persona, eh...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, santo cielo. Está bien, ya entendí.\nMe encargaré de cuidarla.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000646",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Volveré a venir unas cuantas veces, próximamente.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_000647",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Con todo gusto los recibiré. Y qué bueno que te preocupas por tu padre.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no es por eso. Estoy bien seguro de que me acabas de meter en\notro de tus problemas, así que necesitaré un poco de tu sabiduría.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000648",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué sabiduría vas a encontrar en este cuerpo a punto de pisar la tumba?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo qué sé.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000649",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me alegra que seas perspicaz.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siendo tu hijo es fácil darse cuenta. Cuando me pediste que 'cuidara' de esta\nmuchacha te referías a que la ocultara, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000650",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Correcto～”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dilo desde un principio entonces.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000651",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo sé, ¿pero sabes?... No quería ponerte en peligro.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues entonces no me pidas que venga!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_000652",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué no? Me parece algo muy normal que un padre quiera ver la cara de su\nhijo antes de morir.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me llamas para que me ocupe de tus líos, y vienes ahora con eso?...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000010",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Será que, estoy causando muchos problemas?...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? Eso no importa ya.\nEn fin, ¿Kuzu es que te llamabas? Vámonos.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0012",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1201",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000011",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_kid_000653",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Duerme y come bien, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0002",head="shz_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1f1201",face="f0003",head="shz_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000012",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, está bien... Tú también, Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En ese momento, mis oídos no captaron ese nombre que se escuchó solo por un\ninstante.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=1500,func="wait"},
{"excall",file="03_andoe_02_2"},
{"text"},
linkback="block_00233",
},
label = {
top={block="block_00000",label=1},
},
}
