astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0810",face="a0015",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001337",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, de verdad que está bien, no me importa.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001338",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No tienes por qué disculparte de rodillas.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, esto es un problema moral que me concierne a mí. ¡Déjame disculparme de\nrodillas, por favor!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001339",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si sigues haciendo eso me pesará, sube la cabeza, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, me aproveche de tu confianza por mí y observé detenidamente tu zona genital\ncon una mirada sucia.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001340",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-N-N-No digas eso! M-Me harás sentir avergonzada.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es la realidad. ¡A pesar de que lo hiciste todo por la confianza que tenías\ndepositada en mí, no pude controlar mis más bajos sentimientos y me quedé\nabsorto viendo! ¡Hice que abrieras tus piernas hasta más no poder, y me quedé\nobservando la zona de tus genitales mientras la tela de tu traje de baño era\njalada y se adhería a ella!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001341",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿H-Hasta más no poder?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, hasta más no poder! ¡Hice que abrieras tus piernas hasta más no poder,\npara hacer que se tensara tu traje de baño! ¡Y sí, tanto incluso como para\nque se viera también la línea de tus genitales! ¡Y entonces, me quedé viendo\nfijamente!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001342",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿F-Fijamente?!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, debes sentir desdén por mí ahora mismo! ¡Hice provecho de tu confianza y\nme quedé observando la zona entre tus piernas tanto que podría haber abierto\nun hueco con mi mirada, o no, más bien lo hice deseando incluso que de verdad\nse abriera ese hueco!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001343",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿T-Tanto así estuviste viendo?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo estuve. ¡Estuve tan concentrado viendo que incluso pudiera haber grabado\nen mi mente el detalle del sombreado de tu zona genital!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001344",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Na, N-N-N-Nao-kun... ¿Estuviste, viéndome... con esos ojos, a mí?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, estuve viéndote! ¡Me quedé hechizado viéndote!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Vi, y vi bastante! ¡Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",loop=10,size=5,time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001345",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, Nao-kun estuvo... viendo, mi... viendo mi...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
"Debe estar desdeñándome ahora, seguramente.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Rin se me queda viendo, con sus ojos entrecerrados.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"¿Estará viéndome como un sinvergüenza? Su cara está totalmente enrojecida.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Debe estar molesta, frustrada, irritada. Sus ojos están humedecidos ahora.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y por acción de esa ira, su respiración está agitándose.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0014j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",loop=-1,size=8,time=450,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001346",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun estuvo, viéndome, a mí... esa expresión, era por verme a mí... no\npuedo creerlo... que Nao-kun, estuviera, viéndome de esa... Ahh... Auhh...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0015j",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001347",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La expresión de Nao-kun... la expresión de Nao-kun... A-Aun con lo seria que se\nveía... en realidad, estaba viéndome, viéndome a... Kuh, A-A mí... Kufuuh.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Rin siguió hablando sola sin parar.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Para estar enfadada, se ve algo extraña. Sus ojos parecieran estar algo\ndesenfocados... y, su respiración está ciertamente agitada, pero...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0800",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Estás bien? ¿Será que se te subió mucho la sangre a la cabeza y te empezaste\na sentir mal?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Toco ligeramente los hombros de Rin.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0015j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001348",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001349",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Ah.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0015j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",loop=6,size=2,time=550,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001350",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="稟",act="停止",lv=5,id=9},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001351",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Ahhhh.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Rin?!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001352",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, ¡s-sí!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Te lo ruego, perdóname!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001353",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y-Ya te lo dije, por haberte visto con ojos sucios!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0004",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001354",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡Ah, s-sí, cierto!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cierto? ¡¿Nada más eso?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0008",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0011",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001355",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ajaja. E-Eso no importa ya. E-Estoy bien. Realmente lo estoy. No importa con\nqué ojos me veas, puedo permanecer tranquila... P-Puedo aguantarlo. De ahora\nen adelante lo aguantaré...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No tienes por qué aguantarlo!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001356",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, me refiero a aguantar el placer...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A aguantar el placer?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",loop=9,size=8,time=700,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001357",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es nada. ¡No es nada! Y-Ya veo. Jee, no me lo esperaba. Así que también\ntenías algo de interés por alguien como yo. ¡Ya veo! Ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fgact",ch="稟",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sentiste desdén, ¿no?! ¡Desdéñame! ¡Así de basura soy como hombre!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0810",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001358",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para nada, no podría... desdeñarte. Además, eso es algo normal en los chicos,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero en este caso tú confiaste en mí!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001359",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Aunque, n-no sabía. Así como los chicos normales lo hacen... Nao-kun\ntambién... conmigo...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001360",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, te excitaste conmigo...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, me excité! ¡L-Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",time=400,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0002",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0011",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001361",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, sí, está bien! ¡P-Pero, no me di cuenta para nada! Más bien te veías más\ncalmado de lo normal, así que...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, yo también quedé asombrado! ¡En medio de todo comencé a ver tus genitales\ncon una mirada sucia, de forma calmada, inmutable, como si me hubieran metido\notra personalidad adentro!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001362",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿C-C-Con una mirada sucia?!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡L-Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001363",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0800",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se levanta de repente.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Pensé que me pisaría, pero...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",speed=1000,mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0015",head="rin_z1a",x2=0,x=1500,lv=4,id=9},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="dotabatan"},
{"text"},
text={
ja={
{
"De repente salió corriendo, y cerró la puerta fuertemente.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Pues, era de esperarse... Pero, justo en el instante después de que pensé\neso...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"se",stop=1,time=500,id=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001364",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No hay ningún problema! ¡Solo iré al baño un momento! ¡Nao-kun, no has hecho\nnada malo, solo quédate allí por un momento, por favor!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, ehm...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001365",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Hazte en casa y relájate un poco por los momentos! ¡Por favor!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Sus palabras eran delicadas, pero de cierta forma me vi avasallado por la\nincomprensible presión de Rin.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué te pasó?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001366",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Q-Qué querrás decir?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... solo que me dio curiosidad por lo que estabas haciendo en el baño...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001367",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No es la gran cosa. E-Esto, solo que traté de calmar cierta necesidad\nnatural, pero fallé en el intento. Ejeje, ¿habrá sido por aguantar tanto?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo dices, te fuiste corriendo rápidamente al baño, eh.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0004",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001368",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es. Llevaba rato aguantando las ganas de ir, así que me fui corriendo.\nSí.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001369",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Me apresuré para lavar también el traje de baño. No tenía nada que ponerme en\nel baño. Ah, pero es un baño modular prefabricado, así que no me faltó nada\npara lavarlo.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Me sorprendí al escuchar el sonido del agua correr con bastante fuerza del baño\nmientras esperaba... Así que de eso se trataba...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Aunque, por otro lado...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué explicarlo tan detalladamente...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001370",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, t-tienes razón. Ajaja...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Aunque ciertamente, fui yo quien preguntó primero...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001371",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque, creo que de verdad esta manera de aprender no es buena. No, no lo es.\nDebo admitir que es bastante didáctica, pero no es muy apropiada.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001372",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y además, ya me enseñaste gran parte en lo que abarca los alrededores de las\npiernas, sí.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001373",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Puedo ponerme la ropa para lo demás?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001374",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, iré a cambiarme entonces, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001375",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... solo por si acaso, no vayas a verme mientras me cambio, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por supuesto que no lo haré.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001376",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, eso me daría mucha pena...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y creo que iré afuera un rato.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001377",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bgm",stop=1,time=1000},
{"bg",time=500,file="black",path=":bg/"},
{"se",vol=50,id=1,file="se1961"},
{"msgoff"},
{"bg",file="bluesky_spring",id=9,lv=9,time=1000,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo... esto ha sido un gran meollo, eh.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O al menos, eso siento...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"No es que nunca hubo nada de un principio.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Simplemente estuve pretendiendo hasta ahora que no lo había.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso, solo basta con que mis sentimientos se inclinen un poco, y que\nllegue el momento... para que todo lo demás caiga por su propio peso...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"En este momento, estuve comenzando a sentir un gran cambio en mis sentimientos\npor ella.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1c0300",face="c0001",head="rin_z1c",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"fgact",ch="稟",act="いいえ",time=800,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001378",ch="rnd"},
},
ja={
{
name={"Rin"},
"～♪",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Rin está preparando el almuerzo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Sucedieron varias cosas hasta ahora, pero después de eso pude calmarme y\nexplicarle tranquilamente.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"(Aunque, por otro lado...)",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Incluso yo mismo quedé asombrado. No pensé que de verdad fuera capaz de ceder\ncon tanta facilidad ante la lujuria...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Pero, aun así...",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fgact",ch="稟",act="いいえ",time=800,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001379",ch="rnd"},
},
ja={
{
name={"Rin"},
"～♪",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Al ver a Rin de espaldas tarareando mientras cocinaba, pensé (debo admitir que\nlo hice tratando de justificarme) que verdaderamente, era inevitable no\nresistirse.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"fg",ch="稟",size="z2",speed=120000,time=1000,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0310",face="a0002",head="rin_z2a",y2=-300,y=0,lv=5,id=9},
{"text"},
text={
ja={
{
"Realmente se volvió hermosa.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Su cara también, por supuesto, pero su cuerpo no deja nada que desear.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Y además, en principio nunca me ha caído mal Rin.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Más bien, de niño sentía un pequeño amor por ella.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Probablemente, si hubiésemos permanecido juntos, dudo que hubiésemos\npermanecido como simples amigos de la infancia.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Posiblemente no hubiéramos podido seguir en esa misma relación...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Aunque, en realidad, después de eso nos separamos por completo, así que\nrealmente no tengo idea de cómo hubieran resultado las cosas de permanecer\njuntos.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Pero, y por lo menos ahora, lo único que puedo decir es que no tengo mucha\nseguridad de poder permanecer de esta forma en esta relación por mucho tiempo\ncon ella.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que tengo que tener cuidado, pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"De verdad que no puedo creer lo descuidado que fui... o, cómo podría ponerlo...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"De verdad que estoy en aprietos ahora.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1b0300",face="b0004",head="rin_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001380",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya está lista la comida.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, te ayudaré a servir.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0003",head="rin_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001381",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay problema, puedo llevarlo todo yo sola.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"msgoff"},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=220000,time=500,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Comemos juntos.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La comida casera de Rin.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Ya la he probado numerosas veces, pero realmente es deliciosa.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Tal como podía esperarse de ella, aun en este corto período de tiempo, comenzó\na ajustar la sazón de sus platos a mi paladar.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puhaa, vaya que comí...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001382",ch="rnd"},
},
ja={
{
name={"Rin"},
"“I-Increíble... No pensé que fueras a comértelo todo. Gracias...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien preparó la comida para mí, así que soy yo quien debe dar las\ngracias, ¿no? Y además, obviamente tengo que comer todo lo que me sirvan.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001383",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, respecto a la cantidad, no me agradaba la idea de que quedaras con hambre,\nasí que preparé bastante...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería un despilfarro que sobre algo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001384",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Preparé todo para que las sobras pudiesen cocinarse de nuevo y comerse\ndespués...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, jamás llegué a ver las cosas de esa manera... ¿Cómo lo haces?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001385",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si viertes salsa demi-glace sobre este pot-au-feu, quedará como un estofado, y\nsi metes eso en un plato para gratinar, pones queso por encima y lo calientas\nen el horno--”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí, se convertiría en un gratinado con salsa demi-glace, eh.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001386",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... a medida que lo pones a secar, termina cociéndose también por un buen\nrato, así que queda muy bueno...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm... Vaya que tienes trucos bajo la manga. Realmente eres muy buena con las\ncosas de la casa, Rin.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001387",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, sí, muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería bien cómodo vivir contigo, eh.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001388",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿V-Vivir conmigo? Ajajaja. ¿De verdad? La verdad es que soy bastante\ndesordenada en casa...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta no es la habitación de alguien desordenado...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001389",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es porque no hay nada... Ejeje.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ahora que lo dices.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001390",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",size=2,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001391",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Las mejillas de Rin están más rojas de lo normal. Así ha estado desde que\nentramos a esta habitación los dos, pero ahora incluso pareciera tener los\nojos humedecidos...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Su manera de hablar también está un poco más desarticulada de lo normal...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, no tienes fiebre, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",size=2,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001392",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Eh? Ah, no, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Está bien entonces, supongo...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0310",face="b0004",head="rin_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001393",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Mira nada más, así de enérgica estoy~”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Al decir eso, Rin hace una pose flexionando los brazos.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Ya esto pasó antes, eh...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que esa pose no indica mucho si estás bien o no...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0300",face="d0009",head="rin_z1d",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001394",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-En fin, traeré algo de té!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, si es por eso yo puedo hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0006",head="rin_z1b",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0003",head="rin_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001395",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué estás diciendo? Hoy eres el invitado, Nao-kun. Y además, eres el profesor\nque vino a enseñarme pintura. Siéntate nada más y quédate cómodo.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin se desapareció rápidamente dentro de la cocina.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Está caminando normal.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Supongo que no es una gripe entonces...",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Pero entonces, esos ojos humedecidos son...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Creo que mejor dejo de pensar tanto...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Dejando eso de lado, realmente es bastante atenta, sirviendo té justo en este\nmomento. Así es ella en el colegio, pero incluso ahora que estamos solos,\nrealmente sigue igual de atenta...",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Pensé vagamente eso mientras observaba su espalda.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da cosa quedarme acá sin hacer nada... Creo que por lo menos puedo ayudarla\na recoger todo, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"cgact",stage="bg025",act="うなづく"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Comienzo a juntar los documentos esparcidos sobre el tatami.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejaré todo esto en algún lugar...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Arreglo todos los libros sobre su escritorio de estudio.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=960,y=-360,file="zbg025a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este escritorio rosado es el mismo que ha venido usando desde niña...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Realmente que cuida bastante de sus cosas.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Hay una estampilla pegada por debajo del escritorio.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Si no mal recuerdo, vino en uno de los regalitos incluidos en una de las cosas\nque compré en la tienda de golosinas.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Quién diría que hasta esto se ha conservado.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Qué nostalgia.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Su habitación de aquellos tiempos... Todo se perdió ya, pero por lo menos este\nescritorio...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Muevo mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"¿Pero qué clase de ridiculeces estoy recordando ahora?",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se me hace nostálgico este escritorio... Ya con eso es suficiente.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Vuelvo a deslizar mis manos sobre el escritorio.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"La gaveta más inferior del escritorio no está completamente cerrada...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Trato de cerrar esa gaveta... pero.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"se",file="se_bafu",id=1},
{"cgact",stage="zbg025",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa con esto? ¿No tiene como que algo metido?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Al tratar de cerrarla, la gaveta vuelve a abrirse un poco, como si algo la\nempujara hacia afuera.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay algo atascado en la parte interna de la gaveta...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Deslizo ligeramente hacia afuera la gaveta.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"fgact",ch="稟",act="icon",lv=4,id=9,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001396",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ehhhh! ¡¿Qué estás haciendoooo?!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"se",file="se3130",vol=50,id=1},
{"cgact",stage="bg025",act="いいえ",size=20},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0014",head="rin_z2a",lv=5,id=9},
{"quake"},
{"text"},
text={
ja={
{
"Rin se para frente a mí, viniendo corriendo.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, es que la gaveta no cierra...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001397",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, e-es que... Es que está algo viejo ya, así que no se puede hacer mucho. Sí.\nAsí que aléjate de allí, ya...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué lo dices en forma imperativa?...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001398",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿De forma imperativa? ¿D-De verdad hice eso? Pero, no quise decir eso. Por\nfavor. Sí, por favor.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí, ciertamente la culpa la tengo yo por abrirla sin permiso alguno...\nLo siento.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うんうん",time=400,size=20,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001399",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Para nada, no hay ningún problema. Vamos, vamos, siéntase y póngase cómodo\nsobre este zabuton, señor.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
[500]={
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014",head="rin_z1a",x2=0,x=-570,lv=4,id=9},
},
[1300]={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-570,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"Al alejarme del lugar, Rin abre la gaveta por completo y saca algo.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=-570,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
[500]={
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x2=-570,x=0,lv=4,id=9},
},
},
text={
ja={
{
"Rin metió eso dentro de su vestido y se alejó rápidamente.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001400",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, ahora sí se puede cerrar bien la gaveta.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Rin está cargando algo que tiene más o menos el tamaño de un cuaderno.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"No sé qué es, pero debe haber sido algo que no quiere mostrarle a las otras\npersonas.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001401",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, aquí está el té...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001402",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Rin... ¿no se te hace difícil beber así?",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Deben ser unos cuantos cuadernos lo que tiene debajo. Se puede ver incluso por\nafuera como su ropa está abombada",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Debe ser toda una labor tomar té teniendo esa cosa encima del estómago...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Oye... Rin.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001403",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, dígame.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedes prestarme el baño?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001404",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale... lo siento.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"msgoff"},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=240000,time=500,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",id=1,file="se1961"},
{"text"},
text={
ja={
{
"Por los momentos, entro en el baño y le doy tiempo a Rin para que permanezca a\nsolas.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Durante ese rato seguramente esconderá eso en algún lado.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, de verdad que esto me saca de onda.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"La amiga de la infancia de la cual estuve todo este tiempo alejado.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Tal como lo dice Rin, es difícil manejar la distancia entre los dos.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para esa época los dos aún éramos unos niños...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Dentro de su escritorio no había ningún secreto.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Sin embargo, ha pasado un largo tiempo desde entonces... No sería nada extraño\nque ahora tenga varios.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"cgdel",id=-1},
{"bgm",stop=1,time=500},
{"bg",file="bluesky_spring",id=9,lv=9,time=500,path=":cg/"},
{"quake",mode="mw"},
{"quake"},
{"se",id=1,file="se1293"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001405",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kyah.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Junto al sonido de algo desmoronándose, se escucha un chillido de Rin.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00225",
