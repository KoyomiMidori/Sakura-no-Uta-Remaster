astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm003"},
{"bg",file="nightsky_summer",id=9,lv=9,time=500,path=":cg/"},
{"text"},
text={
ja={
{
"Observo el hospital.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo veo de nuevo, ciertamente se puede observar perfectamente esta\npared desde la habitación del hospital...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_wtd_000367",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así que te encontraste al padre Masada... Eso quiere decir que debería asumir\nque has descubierto todo mi plan.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues solo en gran parte, y dentro de lo que sé...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000368",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Me asombra que hayas podido averiguarlo todo hasta este punto...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no lo hice yo solo. Si no fuera por Toritani no me hubiera dado cuenta.\nAunque, realmente te has metido a hacer algo bien complejo y elaborado, eh...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000369",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues claro, hasta ahora estuve avanzando con el plan sin que nadie se diera\ncuenta. Hubiera sido todo un desastre si hubieran descubierto mi plan de\nforma previa y me hubieran castigado con expulsión.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay forma de que alguien se pudiera enterar de eso...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000370",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No se dieron cuenta ustedes? Por eso mismo, las posibilidades no son nulas.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000371",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pero por otro lado, lo que más tenía en mente al realizar esto en secreto eran\ntú y Toritani. Ustedes dos son sagaces, extraordinariamente agudos, nya~ Me\ncostó bastante.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque te descubriéramos no te hubieran expulsado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000372",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Quién sabe. Aunque no me expulsaran, igualmente hubieran, quizás, acabado con\nmi plan. En especial Toritani.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues tratándose de un plan que podría llevarte a la expulsión, es probable que\nToritani hubiera tratado de detenerte...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000373",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y? ¿Cuándo se dieron cuenta de mi plan?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el caso de Toritani, ¿no habrá comenzado a sospechar cuando reuniste ese\nmontón de uwabaki defectuosos? Ella siempre te observa con mucho más cuidado\nque yo...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por el otro lado, yo me di cuenta hace poco. Hace poco fui casualmente a la\ntienda de materiales de pintura de Sakuragahara. Y ese día, el viejo de la\ntienda me contó que hubo un tiempo durante el cual estuviste buscando\ndisolventes orgánicos.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000374",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Disolventes orgánicos, eh... Esos disolventes despertaban fácilmente sospecha,\nfue todo un gran fracaso. Me alteré y terminé haciendo algo que pudo haber\npuesto todo mi plan al descubierto. Normalmente no se me ocurriría tratar de\ncomprar esa clase de cosas...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para un pintor, los disolventes orgánicos son productos que están un tanto\ncercanos a uno mismo. Puedo entender que se te ocurriera usar acetona para\nderretir goma.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000375",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. La acetona se usa como solución removedora para las pinturas de óleo.\nEn la explicación referente a la acetona mostrada en los libros de referencia\nde pintura al óleo, está escrito que esta disuelve plástico y goma...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Aunque nunca llegaste a usarla.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000376",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Más que disolver la goma, la deteriora. Aunque a fin de cuentas, no la derritió\nde la manera que yo quería.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. Sería más bien terrorífico que algo usado para remover pintura\nal óleo pudiera derretir goma como si fuera queso crema.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000377",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, probé con todos los disolventes orgánicos que pude obtener, pero fue en\nvano. Pensándolo bien, sería todo un problema que la acetona usada como\nremovedor de esmalte fuera también tan peligrosa como para poder derretir\ngoma...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fue por no poder encontrar unos uwabaki que pudieran derretirse?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000378",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hace más o menos 2 años escuché rumores de que unos uwabaki importados de mala\ncalidad tenían una goma que se hacía pegajosa y los hacía inútiles. Contacté\na todo lugar posible.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A juzgar por como lo dices, pareces haber buscado bastante...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000379",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aún a pesar de gastar 2 años, no logré encontrar nada. Encontré muchos con\ncolores sencillos, como rojo o azul, pero no lograba dar con colores ideales.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, entonces te angustiaste y fuiste a por los disolventes orgánicos...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de tanto sufrir, finalmente pudiste conseguir los tan rumoreados\nuwabakis de goma derretible. Y al ponerlos al calor de la estufa...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000380",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. Estos uwabaki se derriten de forma ideal. Servían perfectamente al\nsecarlos tras derretirlos y adherirlos. Es como si hubieran sido fabricados\npara este plan.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"“Pues estuvo buscando por 2 años completos... No es extraño que llegara a dar\ncon ese tipo de producto...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Desde cuándo has estado planeando esto? Desde hace bastante, ¿no es\nasí?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo menos, ya debiste haber estado planeando esto desde el momento en que\nvolaste con esa muñeca inflable, o cuando compraste ese pulidor industrial.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="明石",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000381",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No es una muñeca inflable! ¡Es la Love Pillow Kaga*i Hiraki-chan!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya está bien con eso...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000382",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh, hasta en eso me descubriste... Pero qué poder de deducción tan asombroso\ntienes.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en lo que eso respecta, todo fue gracias a Toritani. Ella tenía los\ndocumentos que elaboraste mientras volabas y que el colegio te confiscó.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000383",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿QUÉ? ¡Nunca llegaron a devolvérmelos! Dijeron que se habían perdido.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, quizás Toritani se los cogió a algún profesor. No, diría que es mucho\nmás factible que Wakata se los haya dado a Toritani...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000384",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Gunununuhh... Sí lo es, y por eso no puedo perdonárselo...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿no tuviste problema aún después de que te confiscaran esos\ndocumentos? A pesar de que tuviste que pagar con una fractura para\nelaborarlos.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000385",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sin duda alguna, toda una labor perdida. Realmente no salí completamente\nairoso, pero por andar escribiendo y tomando apuntes en un lugar tan peculiar\ncomo lo es en el aire, terminé concentrándome bastante. Mi cabeza lo organizó\ntodo tan bien que memoricé una buena parte de lo que escribí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso uno tiene mejor memoria cuando está en el aire?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000386",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Entonces tal vez es que soy muy inteligente.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna forma...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, toma esto.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2b0000",face="b0002",head="aka_z2b",lv=5,id=9,sync=0},
{"extrans",time=500},
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Al decir eso, le di aquellos documentos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0006",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000387",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohh, ¿pero no son estos los apuntes que tomé en el aire?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está de más tenerlos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000388",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, me serán de buena ayuda.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, aquella vez que puliste el suelo hasta dejarlo como un espejo, ¿fue\neso de práctica? Para pulir las paredes y el piso de la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quisiste usar un instrumento al cual no estás acostumbrado como lo era ese\npulidor, ¿no? Y por eso usaste los pasillos del colegio para practicar\nusándolo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000389",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, me quedé asombrado con eso. No pensé que el suelo llegaría a ponerse como\nun espejo. Aunque gracias a eso pude agarrarle el truco al uso del pulidor.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues así parece, eh. Y gracias a eso, la iglesia quedó con un acabado tan\nmaravilloso que incluso llegué a creer que había sido reformada\nrecientemente.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000390",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Quedó hermosa, ¿no? Como si viniera de paquete.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, muy hermosa. Casi como si fuera nueva.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue lo que te llevó a hacer tanto?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000391",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sabes quién fue, ¿no? La persona que diseñó la reforma de esa iglesia.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kenichiro Kusanagi. Mi padre.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000392",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Parece que el padre te lo dio, eh. La parte de la herencia de Kenichiro\nKusanagi...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la recibí. Aunque no pensé que aún quedara parte de su herencia regada por\nallí...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000393",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque se podría decir que la herencia más grande, la verdadera herencia, es\nesta edificación...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún incompleta, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000394",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En ese sentido también, realmente es la verdadera herencia...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000395",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El momento en que vi eso... temblé. Realmente temblé...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es inevitable ponerse a temblar al ver ese plano con la iglesia incompleta\nenfrente...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_wtd_000396",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Normalmente, los vitrales son diseñados para tomar la luz de afuera, para ver\nhacia afuera desde adentro...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero sus vitrales, más que tomar la luz externa, resaltan la oscuridad del\ninterior vista desde afuera. Tomando la pared de la iglesia como un lienzo...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000397",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, un mural. Estos vitrales son una parte del mural. Y por ser una parte, es\nque tienen su función y propósito.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Es exactamente eso...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los vitrales parecieran haber sido colocados en una parte recortada\nespecíficamente para ello. Pero en realidad no se trata de ningún recorte,\nson simplemente parte de un lienzo más grande.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000398",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y en lo que eso respecta, no se podía esperar menos de Kenichiro Kusanagi, eh.\nEsa idea, junto a la técnica, habilidad y talento requeridos para hacerla\nrealidad... Todo y cada uno de esos aspectos suyos eran excepcionales...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000399",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Será? Pero si eres tú quien mejor lo sabe. Después de todo, seguramente tú\ntambién te emocionaste cuando viste ese plano de diseño, ¿o no?...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000400",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0004",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000401",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Vete! Aunque aún diciéndote eso no lo harás, me imagino.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien que lo sabes.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0004",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000402",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Igual, vete.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en broma, no quiero.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar este asunto no te corresponde a ti. La persona que diseñó esta\nreforma fue mi padre, Kenichiro Kusanagi. El hecho de que hayas visto ese\nplano no implica de ninguna forma que tú debas culminar su obra.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2b0000",face="b0001",head="aka_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000403",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Keh, aún después de tratar a tu propio padre como un extraño todo este tiempo,\n¿vas a decir eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así mismo. No tengo nada de interés por él, pero sí por sus obras\ninconclusas. ¡Y obviamente, tratándose de sus obras, el derecho de herencia\nme pertenece a mí!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2b0000",face="b0004",head="aka_z2b",lv=5,id=9},
{"fgact",ch="明石",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000404",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiota estúpido, esa obra quedó como una donación de Kenichiro Kusanagi al\ncolegio. No tienes ningún derecho de herencia sobre ella.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quedó como una donación de su parte, entonces tampoco hay razón para que tú\nvengas a hurtadillas a hacer esto, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás Kenichiro Kusanagi haya tenido la intención de donar esto al colegio,\npero el colegio no aceptó eso. Y peor aún, lo despidieron tras haber\nreformado la iglesia sin permiso alguno.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000405",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Te equivocas...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En qué me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_wtd_000406",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No fue al colegio... Kenichiro Kusanagi le donó esto al padre... esta iglesia...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lamento decirte esto, pero el propietario legal de esta edificación es este\ncolegio. Kenichiro Kusanagi no estaba en posición para donarle esta obra al\npadre...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0004",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000407",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso ya lo sé! ¡Pero aun así, esta obra fue dedicada al padre! ¡Y por eso seré\nyo quien la culmine!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿En qué lógica te basas para decir que tú vas a culminar esta obra solo porque\nfue dedicada para el padre?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000408",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No me importa en lo mínimo la lógica. ¡Simplemente yo me encargaré de crear\nesta obra y ya!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es por Komaki y Kosachi?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000409",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“... Eso no te importa.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, parece que por más que trate de discutir contigo no llegaremos a ninguna\nparte...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_wtd_000410",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, así parece...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes tiempo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000411",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso es porque me estás interrumpiendo.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... En fin, solo te diré esto ahora.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo terminaré la obra inconclusa de Kenichiro Kusanagi. Me importa un bledo qué\nrazones tengas de tu parte. ¡Mira esto!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000412",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este es el plano de diseño original que Kenichiro Kusanagi fabricó y que tú\nsolamente pudiste copiar. Está en mis manos ahora.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000413",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Y qué hay con eso?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo culminaré la herencia de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000414",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fui yo quien reunió todos estos materiales. No trates de meterte ahora sin\nhaber hecho absolutamente nada, idiota.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, quizás tengas razón...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así, actuaré bajo mi propia cuenta. Si me quieres detener entonces hazlo\na la fuerza. Sin embargo, te advierto que cuando digo que voy a hacer algo,\nlo hago, y sin fallo alguno.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000415",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000416",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pareciera que los papeles de siempre se invirtieron ahora... No me encaja mucho\nesto, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, ciertamente esas palabras te quedarían mejor a ti.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000417",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y eso que todos piensan que eres del tipo frío, distante y que siente tedio por\ntodo, eh...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hecho de que piensen eso de mí les impide venir a fastidiarme, y realmente\neso me conviene bastante.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000418",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aun cuando eres tú el que mete siempre las narices, eh...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así soy y nací yo. En primer lugar, no tengo simpatía alguna por los problemas\nen los que los demás me metan. Pero si se trata de un problema en el cual yo\nquiera meterme, pues con todo gusto meto el hocico.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú muy bien sabes que mi personalidad es así, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000419",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh, nos podrían expulsar.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, tal vez... Aunque bueno, en el mejor de los casos, expulsión. En el\npeor caso, arrestados por la policía. Si no mal recuerdo, rayar paredes está\npenado como daño a la propiedad, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000420",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ni idea, no lo sé. Simplemente quise completar esta obra. No me importa recibir\nel castigo que sea por crear esta obra.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000421",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque el arte sea considerado como un acto antisocial, aunque sea considerado\ncomo un acto punible, si ese arte representa la verdadera 'belleza',\n¡entonces daré mi vida por ella! ¡Eso es lo que pensé desde un principio!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puh.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000422",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Por qué te ríes?! ¡Se supone que debí haberme visto muy bien diciendo eso!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada. Simplemente no pareces ser el mismo de siempre... O no, de\ncierta forma pensé que realmente eran unas palabras muy altisonantes, muy\ntípicas de ti... y me dio risa.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000423",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Es por ser yo! ¿La grandilocuencia me queda muy bien, no crees?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿es que acaso puedes hacer toda esta labor tú solo en una noche?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que pude ver del plano, es imposible para una sola persona hacerlo en una\nsola noche. Incluso con dos sería muy difícil.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000424",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, se necesitarían unas cuantas personas con bastante fuerza y resistencia\nfísica...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no puedes hacerlo solo, tonto.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000425",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Idiooota, estoy diciendo que para una persona común sería imposible. Para\nalguien fuera de lo común como yo no lo es. ¡Soy yo, Wataru Akashi, el que\nhace posible lo imposible!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? Pero qué ridiculez. Obviamente que no puedes...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000426",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh... ¿Podrás seguir diciendo lo mismo cuando veas esto? ¡Bien, Kusanagi!\n¡Abre tus ojos y contempla!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bgm",stop=1,time=500},
{"se",id=1,file="se3130"},
{"bg",time=300,file="white",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"msgoff"},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans"},
{"text"},
text={
ja={
{
"De repente, Akashi se quitó el horriblemente caluroso abrigo que lleva todo el\ntiempo, quedando desnudo de la cintura para arriba.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000427",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Qué te parece... Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes un cuerpo bien enclenque, eh.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="明石",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000428",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Cállate! ¡¿Qué parte de este escultural cuerpo es enclenque! ¡Mira nada más!\n¡Estos hermosos herculeanos músculos!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si estás en los huesos.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_wtd_000429",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Di más bien que tengo un cuerpo bien sólido!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Qué pasa con ese sólido cuerpo?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0009",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000430",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kusanagiii. ¿Es que acaso no captas el significado del hecho que yo me haya\nquitado mi abrigo? ¿No entiendes el terror que se esconde detrás? ¿Ahn?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000431",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Keh, fui un idiota al creer por un solo momento que de verdad eras un hombre\nsagaz. Después de todo tú también eras otro más del montón. Keh, insecto de\nmierda.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"se",id=1,file="se2192"},
{"fgact",ch="明石",act="うなづく",time=75,lv=4,id=9},
{"quake",mode="mw"},
{"fg",ch="明石",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0009",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000432",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“E-Eso dolió... ¿Por qué me golpeas?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que ya deberías dejar de una buena vez de dártelas de víctima a pesar de\nser tú quien le busca pelea a los demás. Si sigues usando el mismo chiste tu\ncuerpo no aguantara mucho.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="明石",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000433",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Aguantaría si tú no me golpearas!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tenía que hacerlo... En fin, qué más da. Y bien, ¿qué significado hay detrás de\ntu semi-desnudo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000434",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Es que acaso no lo entiendes? ¡¡¿No entiendes lo que significa llevar un\nabrigo incluso en pleno verano?!! ¡Esta resistencia al calor que desarrollé\ndurante tan largo tiempo! ¡Quitarme el abrigo es lo mismo a que Goku-sa se\nquite un peso de entrenamiento de 40 toneladas de encima!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000435",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Lo es.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha un momento...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, está bien, ya entendí. Supongamos que de verdad hayas desarrollado una\nbuena resistencia contra el calor. Aun así, eso no cambia el hecho de que\nesta labor no es una que una sola persona pueda terminar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000436",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no hay tiempo. Hay que apresurarnos.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000437",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eh, pero qué haces sin mi permiso...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quieres detenerme, hazlo, aunque no hay tiempo para que lo hagas.\nProbablemente ni siquiera entre los dos podamos culminar esta cosa.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000438",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso lo sé muy bien! ¡Ahh, no te muevas como te dé la gana! Yo me encargaré de\nderretir los uwabaki. Tú encárgate de pegar los uwabaki fundidos a la pared.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bgm",stop=1,time=500},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000439",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Bien, aquí vamos...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="明石",size="z2",mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",lv=5,id=9},
{"fgact",ch="明石",act="おじぎ",lv=5,id=9},
{"se",file="se9010",id=1},
{"bgm",file="bgm027"},
{"text"},
text={
ja={
{
"Akashi saca un enorme pincel.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Es de esos enormes pinceles que usan en las demostraciones de caligrafía\njaponesa.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000440",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“La primera pincelada la daré yo. No tienes problema con eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00160",
