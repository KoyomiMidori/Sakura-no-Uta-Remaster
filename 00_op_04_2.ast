{"se",stop=1,id=-1,time=500},
{"vostop",stop=1,time=500},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=500,file="white",path=":bg/"},
{"cacheclear"},
{"ex",time=0,func="wait"},
{"movie",file="op"},
{"bgm",stop=1,time=5000},
{"se",stop=1,id=-1,time=5000},
{"vostop",stop=1,time=5000},
{"ntclear"},
