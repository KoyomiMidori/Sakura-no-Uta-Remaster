astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_com_a12_01",path=":ev/ev_com_a12/",set="ev_com_a12"},
{"se",id=1,file="se2308"},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000233",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Venga, todos ustedes! ¡Están haciendo mucho escándalo! ¡Siéntense ya!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkx_000001",ch="jkx"},
},
ja={
{
name={"Alumna A"},
"“¡Kya~! ¡Ai-chan, hoy también estás muy linda~!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_nst_000001",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Uoohh, pero qué suerte haber quedado en el mismo salón que la profe!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000001",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¡Ahh, pero qué mona y pequeñita eres, Ai-chan~~!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_itm_000001",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¡¡Te amo, Ai-sensei!!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bg",file="ev_com_a12_02",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000234",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu... Ya los escuché. Pero cállense, hacen mucho ruido, cállense.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkx_000002",ch="jkx"},
},
ja={
{
name={"Alumna A"},
"“¡Profe~, su cara cuando se enoja también es linda~!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_nst_000002",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡La profe es tan tierna que no puedo calmarme!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_aid_000235",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por Dios... ¿Por qué habrá resultado todo de esta manera?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_itm_000002",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¡Profesora, haga lo de siempre! ¡Lo de siempre!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_aid_000236",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu... Si llego a hacerlo me van a quitar la licencia de profesora.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_itm_000003",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¡Haz que me calme~!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_aid_000237",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ah~, pero qué escandaloso!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_nst_000003",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Cálmenos con lo mismo de siempre~!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"quake",mode="mw"},
{"bg",file="ev_com_a12_04",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000238",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Hmph!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",y=90,x=-640,file="zbg048a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="fg_ai01",id=6,lv=6,x=100,y=300,speed=400,path=":cg/",x2=500,ax=1132,ay=869,bx=-172,by=-329,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=-940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"cgdel",id=-1},
{"bg",y=90,x=-640,file="zbg048a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="fg_ai01",id=6,lv=6,x=100,y=300,path=":cg/",ax=1132,ay=869,bx=-172,by=-329,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=940,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=-940,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"bg",file="閃光大",id=9,lv=9,rule=105,time=80,path=":cg/battle/",set="battle"},
{"quake"},
{"se",id=2,file="se1743"},
{"ex",time=80,func="wait"},
{"cgdel",id=-1},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"bg",file="ev_com_a12_04",zoom=100,speed=200,time=100,sync=0,z2=150,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"quake"},
{"text"},
text={
ja={
{
"El alumno sale rodando por el suelo con el golpe de Ai.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkx_000003",ch="jkx"},
{"vo",file="fem_jky_000001",ch="jky"},
{"vo",file="fem_jkz_000001",ch="jkz"},
},
ja={
{
name={"Chicas"},
"“¡Kyaaah! ¡El golpe de Ai-sensei!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_a12_02",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000239",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaa... siempre lo mismo cada año... Pero qué muchachos.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Ai pone una cara difícil.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Cualquiera se inquietaría en esa situación.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Ai le da un golpe al alumno. Esto se ha vuelto ya una tradición.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="reco",id=9,lv=9,time=500,path=":sys/"},
{"text"},
text={
ja={
{
"Todo comenzó el día en que Ai vino a este colegio por primera vez como\nprofesora.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Parece que todo se originó con una pregunta de uno de los alumnos: 'Profesora,\n¿qué tanta fuerza tienen sus golpes?'.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"La pequeña Ai. Parece que practica artes marciales. Y quería saber qué tan\nfuerte era.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Una vez que se armó el alboroto entre los estudiantes, comenzaron a\nabarrotarse, diciendo 'Pégueme, por favor'.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Siendo su primer trabajo como profesora, Ai se puso nerviosa e hizo lo que le\npidieron, golpeando a uno de los alumnos.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"La Ai de ahora ya no se pone nerviosa como en esos tiempos, pero apenas estaba\ncomenzando a ejercer para ese entonces. Y además, parece que no había tenido\ncontacto alguno con muchachos del sexo opuesto.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_aid_000240",ch="aid"},
},
ja={
{
"'En ese momento, estaba ya lista para recibir una pena de despido\ndisciplinario.'",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Eso fue lo que Ai habia dicho respecto a ese momento.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Sin embargo, todo resultó totalmente al contrario.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"El alumno que recibió el golpe comentó lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"'Siento como si me hubieran llevado del Infierno hacia el Cielo.'",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Al ver la cara de inmensa felicidad de ese alumno al desmayarse después de\ncomentar eso, todos los demás alumnos se abarrotaron diciendo '¡Yo también\nquiero recibir un golpe de Ai-sensei!'.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Parece que el asunto no pasó a mayor inconveniente gracias al profesor\nencargado de la clase en ese entonces.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Y, por alguna razón, el incidente del golpe terminó convirtiéndose en una\ntradición del inicio de los nuevos períodos.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Solamente una sola vez en el año se podrá recibir ese golpe.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Solamente un elegido del salón del cual Ai esté encargada.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Solo ese elegido es capaz de convertirse en una especie de 'Fukuotoko' (Hombre\nafortunado) de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Vaya que es un colegio extraño.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Tan pronto el alumno que obtuvo la felicidad (?) de ser golpeado por Ai\nrecuperó la consciencia, la calma regresó por fin al salón.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"No es de sorprenderse que Ai se vea tan aquejada.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Aunque bueno, eso indica lo mucho que Ai es amada por todos.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"cgdel",id=-1},
{"bg",file="ev_com_a12_03",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a12_01",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
},
},
text={
vo={
{"vo",file="fem_aid_000241",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ejem... E-Ehm... Soy Ai Natsume, y me han encargado con este salón.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_aid_000242",ch="aid"},
},
ja={
{
name={"Ai"},
"“Planeo esforzarme al máximo, así que espero que podamos llevárnosla bien,\nmuchachos.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_aid_000243",ch="aid"},
},
ja={
{
name={"Ai"},
"“Creo que ya lo saben, pero mi especialidad es Lengua.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_nst_000004",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Y también las motocicletas! ¡Monta una Mach III! ¡Y también el karate!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_a12_02",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000244",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaa... Ya terminamos con el pequeño evento, así que baja la voz.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_com_a12_01",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000245",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hoy tengo un anuncio importante que hacerles...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_jkx_000004",ch="jkx"},
},
ja={
{
name={"Alumna A"},
"“¿Eh? ¿Un anuncio importante? Ai-sensei, ¿te vas a casar?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_itm_000004",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“Ahh... nos descubrieron... No puedo mentirles, la verdad es que se casará\nconmigo.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_a12_04",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"quake",size=5},
{"quake",size=5,mode="mw"},
{"se",file="se2192",id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_000246",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Escuchen! ¡Me voy a enojar de verdad! ¡Y no van a querer verme enojada!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Ai golpea con algo de fuerza el escritorio.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Todos se quedan en silencio ante el empeño que pone Ai.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Por supuesto, no es por miedo. Es por lo linda que se ve.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Es tierno ver a la pequeña profesora enojarse en el estrado del salón.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y no quieren contaminar ese momento con ruido.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"¿Será que están pensando eso?",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Todos los estudiantes observan a Ai con ojos de ternura.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_a12_02",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a12_03",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
},
},
text={
vo={
{"vo",file="fem_aid_000247",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿P-Por qué ponen esas caras?... E-En fin, antes de comenzar la guiatura de hoy,\nquiero presentarles a una nueva estudiante.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Los murmullos se extienden rápidamente por el salón. No es de extrañarse,\npuesto que esa frase de Ai es la misma que usa siempre para presentar a\nestudiantes nuevos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Puse mis ojos sobre el asiento sugestivamente vacío que estaba frente al\nestrado.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"... Una nueva estudiante, ¿eh?",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_jkz_000002",ch="jkz"},
},
ja={
{
name={"Alumna C"},
"“Ai-chan, será que te refieres a...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_a12_01",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12",zoom=100},
{"text"},
text={
vo={
{"vo",file="fem_aid_000248",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, tal como lo estás pensando, una nueva estudiante.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-240,x=-40,zoom=70,file="zbg048k",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0017",head="kei_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",lv=5,id=9},
},
vl02={
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000403",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Oh?! ¡Ohhhh! ¡Naoya! ¡Una nueva estudiante! ¡Vino una nueva estudiante!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, sí... Ya entendí, así que, si no es molestia, ¿podrías alejarte, Kei?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000404",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué me tratas de repente de manera tan distante?!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... ¿no te estás dando cuenta de que me estás escupiendo? Eso es\ndesagradable.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000405",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No digas esas crueldades!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_aid_000249",ch="aid"},
},
ja={
{
name={"Ai"},
"“Misakura, entra.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",file="se9006",id=1},
{"bgm",stop=1,time=500},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿M-Misakura?...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Al escuchar las palabras que Ai-sensei soltó, las miradas de todos se posaron\nsobre la puerta frontal del salón.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
"La puerta se abre silenciosamente... Y la persona que al parecer estuvo\nesperando en el pasillo, entró nerviosamente al salón.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="zev_com_a12_06",speed=60000,path=":ev/ev_com_a12/",set="ev_com_a12",x2=920,y2=-540,x=920,y=-390,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"Una cabellera que se movía tan suave y ligeramente que daba la ilusión de que\nno existiera la gravedad a su alrededor. Sus dos ojos que recorrieron el\nsalón en un instante parecían tener dos grandes y oscuros cristales.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Al voltear a vernos a todos, ella retrajo su mentón e hizo una pequeña\nreverencia.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Ai se pone de puntillas y comienza a rozar la tiza en la pizarra. Al terminar\nde escribir, con una hermosa letra, 'Rin Misakura', palmoteó sus manos y\nregresó de nuevo al estrado.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_a12_10",path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000250",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ella es Rin Misakura. Acaba de ser transferida, pero parece que vivió en esta\nciudad cuando aún era una niña. Trátenla bien.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"No pude evitarlo, toda mi mente se apagó.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Me vi incapaz de seguir pensando ante la ridiculez del asunto.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin... Misakura.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_a12_07",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
ja={
{
"Se me hace familiar ese nombre...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"No, es algo en una dimensión completamente distinta a simplemente 'familiar'.\nYo conocía claramente ese nombre.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_ked_000406",ch="ked"},
},
ja={
{
name={"Kei"},
"“Oye... Naoya...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_ked_000407",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esa muchacha, es idéntica a la muchacha de la foto... Será que ella es...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="man_ked_000408",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esto... Oye, el nombre de esa chica es...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_ked_000409",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Naoya?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Una broma de mal gusto.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Eso, o un destino de muy mal gusto.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"De ayer para hoy.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"La muchacha que hasta ayer estaba en los rincones más lejanos de mi memoria\nes...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"La muchacha que estaba parada frente a mis ojos era, sin duda alguna, ella...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Había crecido más respecto a aquella época, su cabello se había alargado, y\ntenía en su cara la gracia característica de su edad, pero――era, sin duda\nalguna, Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_000251",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, Misakura, preséntate.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"user",mode="conf",ch="稟"},
{"bg",file="ev_com_a12_08",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000001",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, s-sí.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000002",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-S-Soy Rin Misakura. Es un placer conocerlos.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_aid_000252",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estás demasiado nerviosa, Misakura.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000003",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡L-Lo siento mucho! H-Ha pasado tanto tiempo, así que...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_aid_000253",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mucho tiempo... Tienes razón, ciertamente viviste acá cuando eras una niña.\nQuizás haya algún viejo conocido tuyo en este salón...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="man_nst_000005",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“Yo, yo, yo la conozco. Es mi amiga de la infancia.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_a12_09",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000254",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ja, estás mintiendo, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="man_nst_000006",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“Sí, solo mentía.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_ked_000410",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué significa esto?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"No puedo ni siquiera ver la cara de Kei.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Su voz transmite la emoción que tiene en este momento.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"No es de sorprenderse, pues la muchacha que había visto ayer en el álbum y por\nla cual se había interesado tanto estaba ahora frente a sus ojos.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Pero en lo que respecta a mí...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bg",file="ev_com_a12_10",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000004",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ehm, mientras estuve fuera de esta ciudad, cambiaron muchísimas cosas.\nY, estoy muy alegre... de poder haber vuelto.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000005",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Desconozco muchas cosas, y soy totalmente inútil para otras, pero, espero que\nnos podamos llevar bien.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",file="ev_com_a12_11",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"text"},
text={
ja={
{
"Al terminar su presentación, el salón se llenó de risas.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_aid_000255",ch="aid"},
},
ja={
{
name={"Ai"},
"“Misakura... No viniste a casarte, así que sinceramente, esas palabras me dejan\nmucho que pensar.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_a12_12",sync=0,face=1,time=400,path=":ev/ev_com_a12/",set="ev_com_a12"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000006",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ajajaja... T-Tiene razón... Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=180000,path=":cg/",x2=0,y2=0,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"De repente, observo las afueras desde la ventana.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Me mareo un poco ante el aún incesante brillo del sol.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Desde el oscuro salón observo cómo los rosados pétalos tocan y se alejan del\nsuelo.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Mientras veía a un lado los pétalos cayendo y volando irregularmente, cerré mis\nojos silenciosamente.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Kei no paró de alborotarse durante toda la clase, pero me mantuve desinteresado\nigualmente hasta el final.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Un pasado del cual debemos desprendernos.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Unos lazos de los que debemos olvidarnos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"A veces existen cosas así...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_ked_000411",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"No sé si el perpetuamente torpe pero aun así un tanto agudo Kei sospechó de\nalgo, o si simplemente se aburrió, pero dejó de hablarme tan frecuentemente.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Al final, hasta que terminó la clase... No pude, desde la última fila del\nsalón, observar otra parte de Rin que no fuera su espalda.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Al terminar la clase de guiatura se terminaron todas las clases del día.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"El primer día sirve, en la vida escolar, para vernos y aprendernos las caras de\nlos demás...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=50,file="zbg048i",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0012",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Un gran tumulto de muchachas se aglomeró alrededor de Rin, la nueva estudiante.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Y alrededor de todas ellas comenzaron a rodearla, también, los hombres de la\nclase.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_jkx_000005",ch="jkx"},
},
ja={
{
name={"Alumna A"},
"“Oye, oye, ¿por dónde queda tu casa?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_jky_000002",ch="jky"},
},
ja={
{
name={"Alumna B"},
"“Tu cabello es increíblemente hermoso～ ¿Qué marca de champú usas?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_jkz_000003",ch="jkz"},
},
ja={
{
name={"Alumna C"},
"“Dame tu número telefónico y tu dirección de correo~”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000412",ch="ked"},
},
ja={
{
name={"Kei"},
"“Increíble. La nueva estudiante está tan rodeada por la barricada humana que ya\nni se puede ver.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000413",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No te importa?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000414",ch="ked"},
},
ja={
{
name={"Kei"},
"“Se conocen, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000415",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Te enfadaste por haberme emocionado tanto?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería enfadarme por eso?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000416",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Entonces no deberías por lo menos saludarla?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ahora en adelante seremos del mismo salón, ¿no? De ser así, entonces en\ncualquier momento tendré que saludarla.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_ked_000417",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera, no se me ocurre nada que pueda decirle tras atravesar esa\nbarrera de gente.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es mejor esperar a que todo se calme un poco más para hablarle...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000418",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, tienes razón, pero...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no vas a ganar nada con seguir viendo al grupo de gente. Vámonos.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000419",ch="ked"},
},
ja={
{
name={"Kei"},
"“S-Sí... Está bien.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Nos fuimos del salón, mientras veíamos a un lado cómo Rin era bombardeada con\npreguntas por los demás.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bgm",stop=1,time=1000},
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"se",file="se1279",id=2},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,id=2,time=500},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
"En los pasillos se podía sentir el bullicio característico del inicio del nuevo\nperíodo.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Ya habían comenzado las actividades de invitación de nuevos integrantes por\nparte de todos los clubes. Algunos repartían folletos por todos los salones,\nmientras que por la ventana se podía ver a los clubes de deportes haciendo\ndemostraciones en el patio.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_jkx_000006",ch="jkx"},
},
ja={
{
name={"Alumna A"},
"“¡Si crees que cocinas muy bien, entonces únete al club de investigación de\ncocina! ¡No solamente aprenderás a cocinar mejor, también tenemos tours\ngourmet por el barrio chino en verano!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_nst_000007",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡¿No te encantaría unirte a nosotros y sobreclockear hasta el límite?! ¡Solo\naquellos que saquen llamas de sus computadores se pueden llamar verdaderos\nadultos! ¡Vamos, bienvenidos todos al club de informática!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"De cada uno de los rincones del pasillo se escuchan unas animadas y fuertes\nvoces de invitación. Cada uno de los distintos clubes usa un tema distinto\npara invitar y atraer a nuevos miembros.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Por cierto, según Toritani, el club de arte también buscará nuevos integrantes\ndurante estos días.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Lo cual quiere decir que...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei... Planeo irme por la puerta trasera.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000420",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es peligroso hacerlo por el portón frontal.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000421",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Por qué, por qué?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta época es peligrosa. Todos los años me agarran a mí también a pesar de no\ntener nada que ver...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000422",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Te agarran?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bgm",stop=1,time=500},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="zbg046a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0200",face="a0001",head="mak_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000097",ch="mkd"},
},
ja={
{
name={"???"},
"“¡Espera un momento, guapo!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",time=500},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm012"},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0026",head="mak_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000098",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu... Pero qué desagradable, volteaste cuando te llamé guapo. Así que\nestás total y completamente seguro de que lo eres, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? Ese no es el problema.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000099",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No voy a aceptar ninguna excusa!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000423",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah... Makoto... ¡Eh! ¡Ahh, cierto!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demasiado tarde, idiota...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000100",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A juzgar por tu reacción, ya sabes lo que te va a tocar hacer hoy, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000101",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, no te quedes parado ahí como un tonto y ayuda tú también a repartir los\nfolletos. Toma, esta es tu parte de hoy.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",mode=-2},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0200",face="d0002",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"se",id=1,file="se2497"},
{"text"},
text={
ja={
{
"Toritani me pasó animadamente el bulto de folletos.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Por supuesto, mis ánimos desaparecieron al instante.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000102",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué pones esa cara como si te hubieran chupado toda la energía?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, me siento como si me la hubieran chupado de verdad.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0015",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0001",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000103",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás diciendo? Te la pasas 364 días del año con los ánimos por el piso,\n¡sácalos afuera por lo menos hoy! Estamos comenzando el nuevo periodo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0003",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0004",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000104",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Vamos, con ánimo! ¡Con gusto! ¡Ve y caza muchos nuevos integrantes para el\nclub!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Nuevo periodo. Toritani-san me obliga a animarme.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"¿Por qué alguien que se la pasa 364 días al año con los ánimos por el piso\ndebe, de repente, animarse justamente el día en el que inicia el nuevo\nperíodo escolar?",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Hay que estar bien loco como para pasarse 364 días del año tranquilo y echarse\nlos ánimos al cielo el día del nuevo período.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Es imposible sacar ánimos como un loco nada más en este día.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0003",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000105",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué andas murmullando?! ¡Vamos, saca todo tu ánimo!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sacar todo mi ánimo?...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"No me queda de otra... Tendré que cumplir con lo que me pide y animarme de\nalguna manera.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Yo, quien me la paso 364 días al año desanimado (según los estándares de\nToritani), trato de animarme lo más posible.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Bien! ¡Aprovecharé la oportunidad de rechazar la propuesta con bastante ánimo!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"¡RECHAZARÉ CON BASTANTE ÁNIMO!",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"se",id=1,file="se2192"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0018",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gyah...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"¡ME GOLPEARON CON BASTANTE ÁNIMO!",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No me golpees con tanto vigor. Eso dolió un poco...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0013",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0008",head="mak_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0009",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000106",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“L-Lo siento... Pero cualquiera reaccionaría con un golpe si le dijeran eso con\nesa sonrisa... No solo soy yo...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000424",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ciertamente, esa sonrisa fue una sonrisa animada, al 100 % de pureza. Incluso\nyo, estando a su lado, me molesté...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se irritan ante una sonrisa animada? ¿Acaso piensan meterse con el\nConsejo de Publicidad de Japón?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000425",ch="ked"},
},
ja={
{
name={"Kei"},
"“Creo que a cualquiera le irritaría ese tipo de sonrisa en ese preciso\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me importa el momento! ¡Rechazo este trabajo! ¡Lo rechazo con bastante\nánimo! No me cansaré de repetirlo, yo no pertenezco al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000107",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Di eso cuando dejes de usar la sala del club como si fuera tu casa, ¿sí?\n¡Además, hace poco tumbaste un montón de caballetes y te fuiste sin\nrecogerlos!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Ahora que lo menciona, el día en que fui a buscar el caballete que Kenichiro\nKusanagi usaba, tumbé un montón de caballetes y los dejé sin recogerlos.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Eso fue porque--!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000108",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Nada de nada, no voy a escuchar ninguna excusa tuya! ¡Toma estos folletos!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"se",id=1,file="se2497"},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
ja={
{
"Toritani puso otro bulto de folletos encima de los que ya tenía en la mano.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... son bastantes.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0028",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000109",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pues eso es porque el destino de nuestro club está en juego, es obvio!”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde debería repartir todos estos folletos?...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000110",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Puedes repartirlos en la plaza central? Esa es la zona donde es más violenta\nla lucha por atraer a los nuevos estudiantes.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La plaza central, eh...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000426",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Voy yo también?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000111",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Kei, tú vienes conmigo.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000427",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿A dónde vamos?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000112",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo una misión pensada para ti que solo tú eres capaz de cumplir. Para\nmañana.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000428",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Una misión que solo yo puedo cumplir? Eso es genial.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Kei está alegre.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"¿Es que este tipo no tiene capacidad de aprendizaje alguna?",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"La tragedia que se repite todos los años... o más bien, comedia.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"La misión que le encargan es siempre la misma todos los años...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, tenías que ser tú, Kei~ Esta misión es solo para ti~ Es un trabajo muy,\nmuy importante, que ni Toritani ni yo podemos cumplir~ Suerte.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000429",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! ¡Naoya, ¿tú también me apoyas?! ¡Lo haré lo mejor que pueda!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0003",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000113",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bien! ¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Los dos desaparecen dentro del edificio del colegio.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Kei, directo al matadero...",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="cg_zbg055e",id=9,lv=9,speed=140000,path=":cg/",x2=-480,y2=480,x=-960,y=480,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
"Por alguna razón, dentro del terreno del colegio Yumihari hay una iglesia.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Son muchos los estudiantes que aplican a este colegio solo porque lo consideran\ngenial.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Frente a esa iglesia hay una especie de plaza, la cual sirve de lugar de\ndescanso y ocio para los estudiantes.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Un escenario de teatro de forma semicircular, llamado Anfiteatro.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Parece que se usa para obras de teatro, conciertos y presentaciones de\nvocalistas, pero jamás he visto que lo usen para eso en otro momento que no\nsea el festival cultural.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"El Anfiteatro es usado, por lo general, como el lugar de reunión y ocio de los\nestudiantes.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"En fin, pasar el tiempo charlando y tomando té acá en las tardes (por lo\ngeneral, con té negro de botella plástica) es, al parecer, el estilo genial y\nelegante de los jóvenes de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Ellos disfrutan su elegancia y su estilo genial...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Sin dudar por un momento en por qué, a pesar de que en el colegio Yumihari se\nadoptó una arquitectura del estilo gótico de la edad media europea, se\ninstaló, sin sentido alguno, un Anfiteatro basado en la arquitectura romana.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Y por lo tanto...",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg055e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está repleto de personas.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estarán haciendo?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"En la plaza ya había una cierta cantidad de alumnos, cada uno matando el tiempo\na su manera.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Jóvenes discutiendo acerca de la vida, jóvenes tocando guitarras acústicas y\nreclamando el fin de las plantas nucleares, jóvenes leyendo libretas\ntelefónicas, y jóvenes hablando acerca del nuevo volumen de los eventos que\nse acercan en primavera.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Y como rodeando a ese grupo de jóvenes que consumían y quemaban la juventud de\nla cual tanto gozan, estaban floreciendo los cerezos. ¿No es acaso como si\nestuvieran bendiciendo este infierno de jóvenes en este calvario?",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"No sé si es porque mi corazón está tan frío, pero no se me ocurre nada bueno.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"¿Por qué será que se reúnen en este lugar?...",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Se podrían ir ya a sus casas...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Si no hubiera personas en el colegio, aún tratándose de Toritani, no se le\nocurriría repartir folletos.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Es por culpa de que haya tanta gente que a Toritani se le ocurrió repartir\nfolletos.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, hagamos esto rápido y regresemos...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bluesky_winter",id=9,lv=9,path=":cg/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Los rosados pétalos tocan mi hombro y luego se alejan.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Mientras veía a un lado los pétalos cayendo y volando irregularmente, fui\nrepartiendo silenciosamente los folletos que me quedaban.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Al ir haciéndolo silenciosamente, en cierto momento ciertas cosas innecesarias\ncomenzaron a invadir mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Por supuesto, aquello que se apoderó de mi mente no era el hecho de\nconcentrarme en repartir los folletos del club de arte, o la estrategia de\nToritani para atraer nuevos miembros.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Eso que no quería pensar, eso que no quería recordar, estaba ahora invadiendo\nmi corazón.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"――Acerca de mi vieja amiga de la infancia que apareció, de repente, en mi\nvida de nuevo.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"¿Por qué habrá regresado de repente a esta ciudad?...",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"¿Por qué aparté mi vista de ella?...",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... Qué cobarde soy.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bgm",stop=1,time=500},
{"se",id=1,file="se2340"},
{"bg",time=200,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En ese instante―",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c08_01",path=":ev/ev_uni_c08/",set="ev_uni_c08",sync=0},
{"extrans",time=1500},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"El viento sopló.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"E hizo volar los pétalos de flor de cerezo al aire.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"En ese instante, mi visión fue completamente invadida por un mundo rosado.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Y un repentino viento robó un folleto de mi mano.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Al instante extendí mi mano, pero mis dedos ni siquiera rozaron el folleto, y\neste voló al vacío con bastante ligereza.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Persigo el folleto con mis ojos.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"El viento perdió su fuerza, y por fin el folleto comenzó a bajar su altura y\ndescender lentamente hacia el suelo. Estimé el lugar de caída del folleto, y\ncomencé a perseguirlo lentamente mientras iba descendiendo.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"bg",file="zev_com_a13_01",speed=30000,path=":ev/ev_com_a13/",set="ev_com_a13",x2=960,y2=-540,x=860,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"*...*",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Al soltar un seco sonido, el folleto cayó al suelo.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Me incliné y traté de tomarlo.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Traté de tomarlo―",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"bg",file="zev_com_a13_01",speed=120000,path=":ev/ev_com_a13/",set="ev_com_a13",x2=-280,y2=-540,x=-280,y=-90,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Sin embargo, había una mano que lo tomó antes que yo.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"La persona que tomó el folleto se volvió hacia mí―",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Y esos ojos se dirigieron directamente a mí.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Y como si hubiera salido de entre ese mundo rosado, esa persona dio un paso\nhacia mí y me extendió suavemente la mano con el folleto.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",file="ev_com_a13_01",time=2000,path=":ev/ev_com_a13/",set="ev_com_a13"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000007",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya regresé... Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Solo el rosado que fluía alrededor...",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Pintó al mundo, y al tiempo.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"bgm",stop=1,time=5000},
{"se",stop=1,id=-1,time=5000},
{"vostop",stop=1,time=5000},
{"ntclear"},
{"cgdel",id=-1},
