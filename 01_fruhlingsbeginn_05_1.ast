astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c02_01",path=":ev/ev_eye_c02/",set="ev_eye_c02"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",mode=-2,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm014"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000700",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad no tienes ningún problema?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000360",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000701",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con que tú también trabajes de modelo, Rin-chan. Rin-chan, tú también eres una\nnueva integrante del club, se supone que este año deberías formar parte de\nlos bienvenidos.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000361",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Aunque sea nueva, yo ya soy una integrante del club de arte del colegio\nYumihari, ¿no es así? ¿O es que acaso aún estoy en período de prueba?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0012",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000702",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, por supuesto que eres una integrante legítima.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000362",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces, como integrante de este club, es natural que colabore con la búsqueda\nde nuevos integrantes. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000703",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero aun así... No tenías por qué ponerte esa ropa tampoco. Incluso a alguien\ncomo a mí me afecta la sensación de culpabilidad al ponerte a hacer cosplay y\ntrabajar de modelo aun cuando acabas de entrar.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000363",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sensación de culpabilidad? ¿Por qué? Este traje es bastante lindo. No me\ndesagrada para nada. Creo que me gusta incluso llevarlo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000704",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me alivia que me digas eso...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000364",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No te preocupes por eso, por favor. Quizás no sirva de mucho mi ayuda, pero\nharé todo lo que esté al alcance de mis posibilidades.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000705",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no es cierto, claro que serás de ayuda. Rin-chan, eres absolutamente\npopular, realmente me ayuda bastante que sirvas de modelo hoy.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000365",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muchas gracias. Lo haré lo mejor que pueda.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Ya había visto a Rin vestida de maid en Quimera, pero aún viéndola de nuevo\nasí, debo decir que se ve muy bien.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Cómo podría ponerlo... Tiene bastante gracia, bastante fineza... No desprende\nesa sensación de '¡Sin duda alguna, es un cosplay!' que transmiten otras\nmaid.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Siento incluso que se parece a esas maid que aparecen en los relatos y\naventuras.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"¿Será eso gracias a la forma apacible y serena que tiene Rin de tratar con los\ndemás?...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000366",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? ¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada. Solo que pensaba que debe ser duro que te pongan a vestirte\nde maid cuando apenas acabas de entrar al club.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",size=4,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000367",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya se los dije, eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0001",head="kei_z1c",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000791",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es. ¡Todos los que trabajen de modelo hoy tienen que llevar esto! ¡No es\njusto que solo yo lleve traje de maid! Rayos, ¿por qué nada más eres\nconsiderado con Rin?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues porque Rin es una chica. ¿No es acaso natural ser considerado con las\nchicas?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0018",head="kei_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000792",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Lo sería si no fuera por el hecho de que me están obligando a llevar un traje\nde maid!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿cuál es el problema? Total, todos los años te pones ese traje.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000793",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡El problema no es el número de veces que lo haga!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_000706",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, sí, lo siento, lo siento, esto lo compensaré después de alguna manera, así\nque mejora ese humor y sonríe frente a los clientes, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000794",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Compensación? Si no está al nivel de unas rosquillas de crema y rosquillas de\nmiel entonces no te lo perdonaré.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0025",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000707",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, entonces te compraré unas rosquillas de crema y unas de miel.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000795",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿En serio? ¿Me comprarás unas rosquillas de crema y de miel? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"¿Con eso estás bien?",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, no puedo creer que hayas conseguido tomar prestados los trajes de\nmaid del café.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000708",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De la tienda? Ahh, no los he tomado prestado.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De veras? Pero, se parecen a los uniformes de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000709",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues Thomas me los dio.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Thomas? ¿Por qué llevas esa clase de cosas contigo?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000024",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Coleccionar artículos de la cultura de Japón es mi razón para vivir, DESU.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De la cultura de Japón? Pero Quimera es solo un restaurante local sin mucha\npopularidad. ¿Por qué entre tus artículos de cultura japonesa tienes\nuniformes de Quimera?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0002",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000025",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Porque son KAWAII.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Creo que esta conversación ya no tiene coherencia alguna.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Este tipo conoce los uniformes de Quimera que, por lo general, solo conocen los\nresidentes de esta localidad. ¿De verdad vino de Francia?",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y además, por qué llevas ya rato con ese palo?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0009",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="浮遊",loop=-1,time=600,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000026",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¿Esto? Esta es una herramienta para hacer florecer el arte.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Piensas usar ese palo al dibujar?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000027",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"¿Por qué necesitas un palo para dibujar?",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fgact",ch="トーマス",act="停止",lv=4,id=9},
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0210",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000075",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si hubieran más prendas, nosotras también hubiéramos podido participar...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000107",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es que solo habían tres prendas. Yo también quería verte vestida así, Rina...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000108",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero no creo ser capaz de permitir que extraños te violen con la mirada, así\nque no estoy inconforme del todo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000076",ch="rna"},
},
ja={
{
name={"Rina"},
"“Escucha, Yuumi, nadie ha solicitado esa clase de opinión.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"excall",label="flagon01",cond="g.rinclear==1&&g.makclear==1"},
{"excall",label="flagoff01"},
{"text"},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"select",label="label01",text="select"},
{"select",label="label02",exp="f.rna=f.rna+1",text="select"},
{"select",name="select01_05_1",mode="sys"},
{"text"},
select={
ja={
"Si Hikawa también se vistiera de maid quizás los clientes se alegrarían aún más.",
"Son de primer año, no hay necesidad de que Hikawa haga esto.",
{"rt2"},
},
},
labelcount=1,
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, si Hikawa también se vistiera de maid quizás los clientes se\nalegrarían aún más.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0005",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000368",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No podemos hacer eso, Kusanagi-kun. Rina-chan y Yuumi-chan son de primer año.\nSomos nosotros, los de tercer año, los que debemos encargarnos de esta tarea.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"excall",label="join1"},
{"text"},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, son de primer año, no hay necesidad de que Hikawa haga esto.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0210",face="a0017",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000109",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A juzgar por esa manera de hablar, parecieras estar diciendo que Rina no tiene\nencanto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al contrario, es al contrario. Hikawa es bastante encantadora, así que los\ndemás podrían terminar aún más enloquecidos.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"excall",label="join1"},
{"text"},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, ¿saben lo que significa trabajar de modelo? Tienen que permanecer 2\nhoras tomando la misma pose, sin poder moverse. La verdad es que ni siquiera\nestoy seguro si una principiante como Rin pueda hacerlo.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000369",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si es por el cansancio, no hay problema. Así como me ven, tengo bastante\nconfianza en mi capacidad física. He acumulado algo de entrenamiento hasta\nahora.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Entrenamiento, eh... Sin duda alguna, a juzgar por ese ippon seoi tan bien\nejecutado, debe haber entrenado bastante.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Aunque, el hecho de que esa Rin estuviera practicando judo no encaja con mi\nimagen previa de ella.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los modelos son observados mientras dure la sesión, así que de alguna u otra\nforma podría inquietarte un poco.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0011",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000370",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, quizás eso me ponga algo nerviosa en el momento. Pero llevaré ropa encima,\ny además no tendré que hacer ninguna pose muy sugestiva, así que creo que\npodré esforzarme un poco y lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ropa, eh... Pues sí, si se tratara de una sesión de dibujos al desnudo me\nimagino que lo rechazarías.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000371",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, creo que no podría hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0010",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000110",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Si es por ver la sesión de dibujo al desnudo de Misakura-senpai, podría\ningresar 2 o 3 o más veces al club!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000372",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, me alegra escuchar eso, pero aunque una misma persona entre 2 o 3 veces\nal club, no aumentará el número total de integrantes.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000111",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Quiero decir que así de maravilloso me parece eso!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000373",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias, no pensé que me halagaras tanto.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うんうん",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000112",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Por supuesto! Misakura-senpai, eres muy hermosa.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0016",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000374",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por más cumplidos que me des no te daré nada a cambio. Ah, pero si me halagas\ntanto entonces tal vez podría hacer una sesión solo para ti, Yuumi-chan.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000113",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Solo... para mí?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"se",id=1,file="se1081"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0022",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"ex",time=50,func="wait"},
{"fgact",ch="優美",act="icon",lv=4,id=6,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000114",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Mm?! ¡Gufuh!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0013",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="icon",loop=-1,lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000375",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",size=4,time=400,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000115",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000116",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Unuru. No puedo creer que dejé que esto sucediera...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000376",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estás botando sangre por la nariz. Toma este pañuelo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0015",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000117",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gracias por tu amabilidad, pero no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Kawachino saca poco a poco varios pañuelos y se limpia la nariz. Después de\nlimpiársela meticulosamente, observó con una mirada penetrante a Rin.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0013",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0011",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000377",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000118",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Respecto a lo que acabamos de hablar, ¿lo decías en serio?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0009",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000378",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000119",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Respecto a lo que dijiste, de que en mi caso sí posarías desnuda para mí y me\ndejarías dibujar todos los rincones de tu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0011",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",size=6,time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000379",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, no sé, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000120",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Era una broma? ¿Era en serio?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0010",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",time=600,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0009",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000380",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, solo por si acaso, lo dije como una broma, pero... ¿Quizás no debí haber\ndicho eso como broma?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, normalmente cualquiera pensaría que se trata de una broma.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000121",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh... Y-Ya veo... Entiendo. Creo que es mejor así.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Kawachino susurra 'Es mejor así' con una expresión de bastante lamento. No\nsiento que nada esté bien ni mejor al verla así.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000381",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0018",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000122",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, simplemente que esta mujer que está acá se imaginó una escena en una sesión\nprivada de dibujo al desnudo con Misakura-senpai y sufrió de una erección.\n¡Aun cuando tengo a Rina en mi corazón!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0015",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000077",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué será que aparezco en esa conversación? ¿Qué clase de cosa representaré\nyo para ti?...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000123",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡La única persona que me causa una erección al imaginarla!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0017",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000078",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000124",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Material para autocomplacerme!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000079",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Bien! ¡¿Será que vamos un momento a la azotea, Yuumi Kawachino?!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000125",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué? ¿Vamos a aplacar el calor de nuestros cuerpos?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000080",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tengo mucho que comentar respecto a eso, pero en fin, ¿qué quieres decir con\n'nuestros cuerpos'?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000126",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mi deseo sexual es del tipo de inicio rápido, así que no requiero de ninguna\ncarga previa.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000081",ch="rna"},
},
ja={
{
name={"Rina"},
"“A nadie le importa cómo funciona tu deseo sexual.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="優美",mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000382",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, vamos, hay dos muchachos acá, así que dejen las conversaciones referente\na su relación íntima para después, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0014",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000082",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No tenemos esa clase de relación, es todo un malentendido!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000383",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo sé, solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000083",ch="rna"},
},
ja={
{
name={"Rina"},
"“Umuh~, no digas eso en broma, por favor...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000384",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Perdóname, ¿sí? Pero me pareció que si no decía eso no terminarían nunca.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000385",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero todos saben que es una broma.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000386",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Verdad, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, solo yo, eh.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
