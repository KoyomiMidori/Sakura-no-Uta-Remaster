block_00116={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0002",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="浮遊",loop=-1,time=400,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000028",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“S-Su deseo sexual es de inicio rápido... Jaa, jaa.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero también hay tipos así.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fgact",ch="トーマス",act="停止",lv=4,id=9},
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0001",head="yum_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000387",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y por eso, Kawachino-san, no es bueno que hables mucho de esa clase de\ntemas con chicos frente a ti. Si llegan a escucharte diciendo eso, puede que\nalgún desconocido termine imaginándose cosas muy raras.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0011",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000127",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Sí, lo entiendo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000388",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me entendiste?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000128",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Creo que si llego a ver a Misakura-senpai desnuda, podría convertirme incluso\nen Renoir!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"fgact",ch="稟",act="icon",lv=4,id=6,icon="icon04z1",x=25,y=-525},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000389",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Parece que volvimos al tema anterior, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0002",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",size=5,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000129",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, quiero decir, siento que con toda la conversación que acabamos de tener, me\nterminaste gustando aún más, Misakura-senpai. Solo quería hacerte saber eso.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000390",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Con la conversación que acabamos de tener? La verdad es que no entiendo muy\nbien...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Yo tampoco entiendo muy bien, pero sí entendí perfectamente que Kawachino es\nuna muchacha muy rara.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="優美",mode=-1,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Cómo se realizará la sesión de dibujo de hoy?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000710",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Normalmente hubiera preferido 2 horas, pero eso los aburriría a todos, así que\nplaneo dejarlo en una sola hora.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que, después de todo, los novatos no tienen suficiente poder de\nconcentración como para estar pintando más de una hora, con eso debe bastar.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000711",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bien, por los momentos, estos son los folletos de la sesión de dibujo\nabierta. Ayer en la noche los hice de manera apresurada, así que no los he\npodido repartir aún, pero los pegué en la cartelera.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000391",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ojalá que vengan bastantes visitantes.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema por eso. Todos estaban rumoreando de que trabajarías como\nmodelo, así que seguramente vendrán bastantes. Y entre todo esto, parece que\ntambién están corriendo rumores de aquella misteriosa hermosa chica que\naparece solo durante la búsqueda de nuevos integrantes y en el festival de\ncultura.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0004",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000712",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente. No se podía esperar menos de Rin-chan. Y tampoco del 'otoko no ko'\ninternacional, Kei Natsume.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",lv=4,id=5},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000796",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿De qué demonios va ese titulo tan extraño?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0003",head="mak_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000713",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bien, Kusanagi, para ti está esto.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"msgoff"},
{"se",file="se9012",vol=59,id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=5},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0900",face="b0003",head="mak_z2b",lv=5,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=5},
{"se",file="se9010",vol=80,id=1},
{"text"},
text={
ja={
{
"Al decir eso, me dio un esmoquin.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000714",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así como lo ves, un esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No habías dicho que no querías a las personas que venían por mí?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0025",head="mak_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0008",head="mak_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000715",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque vengan solo por ti, no tengo problema con meter a aquellos que vengan\ndispuestos a dibujar de verdad. Así que, ¿podrías hacerme el favor?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque sus motivos no sean los más apropiados, no hay problema siempre y cuando\nhagan lo que tienen que hacer. ¿A eso te refieres?...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0002",head="mak_z2a",lv=5,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000716",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien, entendido.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0016",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000717",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás algo comprensivo, eh.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos los años te ayudo únicamente durante las búsquedas de nuevos integrantes,\nlo cual quiere decir que esto será tu último capricho, ¿no es así? Qué más\nda, te ayudaré con esto.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0029",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000718",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias, dentro de todo, estoy agradecida contigo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, confía en que haré un buen trabajo.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"select",label="label05",exp="f.mak=f.mak+1",text="select"},
{"select",label="label06",text="select"},
{"select",name="select01_05_3",mode="sys"},
{"text"},
select={
ja={
"Dentro de todo, yo también estoy agradecido.",
"Si no hago esto ahora, no sé que podrías venir a reclamarme después.",
{"rt2"},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dentro de todo, yo también estoy agradecido contigo.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"excall",label="join3"},
{"text"},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no hago esto ahora, no sé que podrías venir a reclamarme después.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"excall",label="join3"},
{"text"},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0012",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000719",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El material de esto, no es como que algo diferente al de siempre?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000720",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? Debería ser el mismo de siempre.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, debe ser mi imaginación entonces...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fgf",frame="frame_ss",bg="black",cg=":cg/tho01",cgx=-600,cgy=-150,disp="出右",bgpx=":bg/",cgbx=-960,cgby=-540,mode=3},
{"text"},
text={
vo={
{"vo",file="man_tmd_000029",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“... Renoir.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Me dio la sensación de que los ojos de Thomas brillaron por un momento.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
