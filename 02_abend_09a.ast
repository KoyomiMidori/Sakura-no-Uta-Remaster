{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm003",time=10000},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000897",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es un gusto conocerte, Shizuku-chan.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0012",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000360",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Shizuku se quedó paralizada por un momento al ver la cara de Rin. Sin\nembargo――",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000361",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es un gusto, Rin Misakura-san.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000898",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Cómo sabes mi nombre?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000362",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kei nii-san y Naoya me han contado de ti...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000899",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Las dos se quedan viéndose una a la otra.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0009",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000363",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",id=1,file="se3356"},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0009",head="shz_z1a",x2=-345,x=-45,lv=4,id=5},
{"text"},
text={
ja={
{
"En el momento en que pareció que diría algo, Shizuku abrazó a Rin.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0022",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000900",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah--? ¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000364",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal como me lo han contado, eres bastante linda.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000901",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para nada, tú eres mucho más linda, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000365",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De ninguna forma.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000902",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="lr",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000903",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Eih!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0012",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000366",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Rin abraza de vuelta a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000904",ch="rnd"},
},
ja={
{
name={"Rin"},
"“R-Realmente no pareciera ser la primera vez que nos vemos, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=-45,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000367",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... en verdad...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bgm",stop=1,time=1000},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x2=-45,x=0,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x2=345,x=570,lv=4,id=6},
{"fg",ch="優美",size="z1",mx=-40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=-570,lv=4,id=3},
{"bgm",file="bgm012"},
{"text"},
delay={
