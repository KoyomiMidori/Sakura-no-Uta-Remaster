{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_yum_000639",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nununuh... S-Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000368",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000640",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Podrías entrar conmigo a los vestidores?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",x=0,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000369",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, de ninguna forma.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0022",head="yum_z1b",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="icon",lv=4,id=3,icon="icon16z1",x=0,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000641",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*gaaan*.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_rna_000301",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es normal que el rechazo te impacte tanto diciéndole eso a alguien que conoces\npor primera vez?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0020",head="yum_z1b",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000642",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me sentí capaz de decirlo con la emoción del momento.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000370",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque no me importaría ir con Rin.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0013",head="rin_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000905",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Ir juntas a los vestidores?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
