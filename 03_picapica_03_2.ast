astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg060a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Toritani estaba trabajando en el horno escalado. ¿Estará preparando una nueva\nobra de práctica?",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ey.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002109",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es en serio?... Por Dios, sé que declararon la clase como hora para estudio\nindividual, pero aun así no había razón para que te escaparas del salón como\nsi estuvieras saliendo por la puerta de tu casa.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo siento.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002110",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es momento para venir con disculpas, ¿no crees? Y más aún con las\ncalificaciones tan horrendas que llevas.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues solo para aclarar, era una sesión de estudio individual de matemáticas, y\nme va bien en esa asignatura, así que me salí...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002111",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ese no es el problema!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002112",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estabas hablando con la directora, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo hablamos de cosas banales. De las noticias en la TV, y eso.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002113",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pretendo tomarme a la ligera tu advertencia. Solo que habían unas cuantas\ncosas que me causaban curiosidad...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002114",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me enoja que hayas ignorado todo lo que te dije, Kusanagi. No tengo razón\npara hacerlo. Puedes hacer las cosas como tú quieras.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002115",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te conviene mucho más así. Por lo general siempre termino haciendo las cosas\nmal.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002116",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estoy achicándome ni nada de eso. Cuando me pongo a pensar en lo que hice\npara aumentar el número de miembros del club de arte y mantenerlo con vida,\nme doy cuenta de que no salió bien.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002117",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Acabas de decir que estuviste hablando de las noticias de la TV con la\ndirectora, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002118",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo también las vi... Parece que la Farmacéutica Nakamura obtuvo en sus manos 6\nobras de la serie de 7 obras de Kenichiro Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002119",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre hay alguien peleando y batallando a mis espaldas. Las intrigas y\nambiciones de muchas personas, y el sentimiento de querer proteger a\nalguien...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002120",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquel con buen ojo podría entender lo que realmente son esas 7 obras...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002121",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es que no podré hacer nada esta vez tampoco?...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde se fue la Toritani que yo conozco?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002122",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo fue una pregunta retórica. Después de decir '...¿será que no podré?' se\nsupone que viene 'por supuesto que sí'.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002123",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque tal como te lo dije esta mañana, en el mundo hay brechas de talento que\nno pueden ser cerradas de ninguna forma.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=500000,file="zbg060a",path=":bg/",x2=960,y2=-300,x=-600,y=-300,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002124",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Conoces 'La luna y seis peniques'? De Maugham.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002125",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ella aparece un artista inspirado casi de manera ridícula en Paul Gauguin.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002126",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este artista se aprovecha del aprecio que le tenía un artista de tercera clase\nfascinado por su talento, acostándose con su esposa y finalmente llevándola\nal suicidio.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002127",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, el talentoso artista no mostró ni un poco de arrepentimiento, y el\nhombre que quedó enamorado de su talento termina además perdonándolo.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque hay varias diferencias entre el genio artista que aparece en la obra de\nMaugham y el propio Gauguin...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002128",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero me parece una obra fabulosa.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002129",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Describen muy bien también la escena en la cual Maugham, genio literario a la\npar de Gauguin, lo confronta.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002130",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Maugham vivió como un escritor de literatura popular. Y se enorgullecía de eso.\nSin embargo, el genio artista inspirado en Gauguin fue el último u solemne\nartista genio capaz de ignorar a las masas por su cuenta.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002131",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es imposible que existan artistas tan solemnes como Gauguin en esta época. Los\nartistas no son más que bufones.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002132",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hacer arte ahora es solo interpretar el papel de 'artista', en una especie de\ncirco teatral.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002133",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero a final de cuentas, ¿se podría decir que Maugham fue igual?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002134",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me parece encantadora la malicia que había en ese último genio, y en aquel\nartista popular.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002135",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A pesar de la diferencia en talento que tenía con Gauguin, Maugham pudo ponerse\nuna vez más de pie. Sin embargo, aquel artista de tercera solo pudo servir\npara ser usado y manipulado.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"msgoff"},
{"bg",file="bg060a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, ¿no estarás tratando de decirme que esa eres tú, o sí?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002136",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... Aunque también está eso que dicen, de que el que se enamora primero\npierde.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo dijiste ayer.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002137",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ayer acabaste con la conversación después de haberte alterado por esa frase...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002138",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al ver ese cuadro de Naoya Kusanagi, Makoto Toritani decidió dejar de pintar en\nóleo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002139",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, al ver ese cuadro Kei decidió ir más allá.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002140",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y como prueba de eso, la época en la cual Kei obtuvo más premios fue justamente\nen los años después de que tu obra fue publicada, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que después de eso no llegó a presentar muchas obras más a exposiciones,\nsegún supe.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002141",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te gustaría visitar la casa de la familia Toritani?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ahora mismo?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002142",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, veamos... espera un momento. Voy a contactar con los muchachos de turno.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002143",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero que veas algo lo más rápido posible.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg071a",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"La habitación a la cual Toritani me había llevado estaba repleta de cuadros.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002144",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No solo son estas. En el cuarto de enfrente también hay más. Aun después de que\nKei se convirtiera en Kei Natsume, todas sus obras han seguido siendo\nadministradas por la familia Toritani.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ninguna de estas obras fueron publicadas?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002145",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Y lo mismo podría suceder en esta Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002146",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no lo parezca, Kei se preocupa por el acabado y la estructura de sus\ncuadros.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002147",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo que él produce es un recorte de ese mundo que él ve, del mundo que sus ojos\nsiempre ven.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002148",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es casi como un impulso.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002149",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para Kei, 'belleza' es que el límite del mundo y su propio límite sean el\nmismo. Para él, dibujar representa una acción con el objetivo de ver un poco,\nsolo un poco más allá de ese límite.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002150",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero que veas esto.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani se desaparece en la habitación de al lado y regresa luego cargando\nvarios cuadros en sus brazos.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"se",file="se9010",vol=50,id=1},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002151",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estas son las pinturas que Kei produjo cuando aún era Kei Nakamura. Deberías\npoder darte cuenta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Parecen verse iguales, pero hay algo definitivamente distinto en ellas.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002152",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Fue al conocer tu pintura que Kei decidió buscar aún más perfección en\nsus obras. Basta con ver esto para darse cuenta, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002153",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es por eso que ninguno de los dos genios puede estar sin el otro. Sin embargo,\neso no es solo por el bien de Kei.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Veo cada una de las pinturas que llenan la habitación. Siento una vívida\nrespiración venir de cada una de las partes que las componen.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Estas no son solo unas simples pinturas. Es la propia vida de Kei plasmada en\ndistintos lienzos.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay de tus cuadros, Toritani?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002154",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí no están.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las tienen guardadas en otro lugar?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002155",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Y las más recientes están en la sala de arte. En estos últimos años no he\npintado casi.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002156",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Regresamos ya? Me da pena hacer esperar tanto al personal de medio tiempo.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",speed=8000,mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x2=0,x=-1000,lv=4,id=9},
{"se",file="se9002",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg070a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Vamos caminando por los pasillos de esa enorme casa.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es realmente inmensa esta casa.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"No sé si es por haber recibido tantas ampliaciones, pero los pasillos están\nintrincadamente conectados, y aún no logramos llegar hasta la entrada.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002157",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo es. Toritani llegó a ser una familia bastante adinerada. Hace tiempo vivía\nmi abuela, así como los hermanos de esa mujer, pero...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002158",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todos se independizaron y abandonaron la casa, y su única residente es ella\nahora. Parece que también viene de vez en cuando una empleada doméstica a\nayudar, y a veces hablo con ella.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una chacha o algo así?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002159",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002160",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cuando mi abuela murió, propusieron vender la casa y construir un edificio por\nesta zona, pero no sé qué sucedió después.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002161",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La casa sigue aún aquí, así que supongo que el plan del edificio terminó siendo\ndescartado.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que llegaste a tener tu abuela contigo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002162",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... no era una mala persona.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002163",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me recibieron precisamente con los brazos abietos, pero a medida que pasamos\nel tiempo bajo el mismo techo, comenzó a tratarme con algo más de cariño.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002164",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tenía sentimientos, prejuicios, así como su propio sentido común. Para bien o\npara mal, era una persona normal.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"msgoff"},
{"bg",y=-80,x=-960,file="zbg070a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",mx=-40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0011",head="mak_z2b",lv=5,id=9},
{"text"},
text={
ja={
{
"De repente, Toritani se detuvo frente a una puerta.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0009",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0011",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002165",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No... no es realmente nada.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0027",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0027",head="mak_z2a",x2=0,x=20,lv=5,id=9},
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Toritani extendió su mano y tocó ligeramente la manija de la puerta.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",x=20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002166",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te conté que a veces hablo con la empleada doméstica, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0003",head="mak_z2a",x=20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002167",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le encanta hablar. Pero, también tiene también una gran ética profesional, y\npor eso siempre busca querer hablarme de las cosas que suceden en la casa\nToritani.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",x=20,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0008",head="mak_z2a",x=20,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002168",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que hace poco trataron de robar, y se armó un escándalo. Aunque bueno,\nterminó como solo un intento.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe haber sido un gran lío, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0015",head="mak_z2b",x=20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002169",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí, lo fue.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0008",head="mak_z2b",x=20,lv=5,id=9},
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0008",head="mak_z2b",x2=20,x=-20,lv=5,id=9},
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Después de soltar un suspiro, Toritani alejó su mano de la manilla de la\npuerta.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0001",head="mak_z2b",x=-20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002170",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me contaron que después de ese incidente, comenzaron a pasarle llave a esta\npuerta. Y me doy cuenta que de verdad lo están haciendo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, ¿alguien estaba buscando entrar a esta habitación?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0002",head="mak_z2b",x=-20,lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002171",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay algún gran tesoro adentro escondido o algo así?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0016",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",x=-20,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002172",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es eso, pero parece que alguien tiene una obsesión por lo que hay adentro.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"... ¿Una obsesión?",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Alguien no puede estar obsesionado por una habitación vacía. Le habrán dicho\nque fue un intento de robo, pero no parece haber sido solo un robo.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es un depósito o algo así?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",x=-20,lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002173",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Esta es la habitación de esa mujer.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"De esa mujer... De la directora, eh.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te sientes mal llamándola así? Como si fuera solo una extraña.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0006",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002174",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo es. Es una extraña con quien comparto la misma sangre.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Después de decir eso con un tono fuerte, Toritani se quedó en silencio, con una\nmirada incómoda.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",x=-20,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002175",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perdón... No puedo creer que estoy descargándome contigo ahora, soy de lo peor.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes hacerlo, si quieres.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",x=-20,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002176",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, esperaba que dijeras eso. Sé que no mientes, y por eso mismo no puedo\naferrarme a tu buena voluntad.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hay algo que quieras contarme, puedes hacerlo. Si no lo quieres hacer,\nentonces no lo hagas. Así de simple.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002177",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",x=-20,lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",size=5,lv=5,id=9},
{"se",file="se_koton",vol=30,id=1},
{"text"},
text={
ja={
{
"Toritani tocó suavemente la puerta, y apoyó su frente sobre ella. Después de\nalgo de silencio, unas débiles palabras se escaparon de ella.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",x=-20,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002178",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Hace un tiempo... entré aquí. Solo una vez.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Toritani no es la clase de persona que usualmente habla acerca de sí misma o de\nsu pasado. Pero...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Ha venido cambiando, poco a poco.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Y ese catalizador fue el incidente con la directora y el mural.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Desde que terminaron las vacaciones de verano, he llegado a observar en más\noportunidades a Toritani comportarse de manera inestable. Y eso mismo está\ncambiando ahora, poco a poco, la relación entre nosotros dos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"msgoff"},
{"bg",file="bg070a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002179",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Lo siento, vámonos, ¿sí?",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"Está bien.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Toritani se aleja de la puerta y comienza a caminar.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"Oye, Toritani. Siento un cosquilleo por dentro cada vez que te disculpas\nconmigo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002180",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Un cosquilleo? ¿De qué estás hablando?",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo tampoco lo sé muy bien... Es como, si me dejaras atónito... No digo que sea\nuna molestia, para ser sincero, eso me pone feliz.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002181",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Q-Qué estás diciendo?...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, estoy dándote a conocer mis más sinceros sentimientos.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002182",ch="mkd"},
},
ja={
{
name={"Makoto"},
"M-Me pones, mal... diciéndome eso.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Mal?",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002183",ch="mkd"},
},
ja={
{
name={"Makoto"},
"... No lo sé, pero, cuando me dices eso, siento que muchas cosas comienzan a\ndar vueltas dentro de mi cabeza, y... me, pones, en una grave situación.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"se",file="se9002",vol=50,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1c0100",face="c0001",head="mak_z1c",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani camina más y más hacia adelante, y de repente se para a mitad de\ncamino. Me quedo observando su espalda. Se me hizo bastante pequeña.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002184",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Oye, Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Toritani susurra eso, sin voltear.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002185",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Querer que otra persona sepa más de sí mismo... ¿Qué significa realmente eso?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002186",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Querer que esa persona sepa de mí, de mis verdaderos sentimientos... de mis\nsentimientos... de mi dolor... ¿Es justamente por hablar? ¿Es por hablar y\npor creernos que conocemos bastante al otro que queremos que esa persona sepa\nmás?",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002187",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Qué sentido tiene creer saber cómo es la otra persona? ¿No es eso solo una\nilusión compartida? Una ilusión cuya única garantía es el pasado...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Es necesario pensarlo tan complicadamente? Para mí, compartir el pasado y\ncompartir la piel... no tiene mucha diferencia.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002188",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Eh...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Toritani voltea repentinamente.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002189",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿D-De verdad...? ¿¿¿De verdad, es así???",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Toritani me pregunta con una cara angustiada, haciendo que me angustie yo\ntambién. No pensé que reaccionaría de manera tan sensible ante la parte de\n'compartir la piel'.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí, o no, bueno, no tengo experiencia en eso, así que no puedo dar una\nexplicación muy detallada.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004h",head="mak_z1a",lv=4,id=9},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0004h",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002190",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Ah, ya veo... P-Por supuesto, no hay forma de que alguien como tú haya\nexperimentado algo así, a-ajaja...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Al ver la claramente aliviada cara que puso Toritani, me siento terriblemente\nlastimado.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Eso me lastimó bastante! ¡Tú tampoco lo has experimentado! ¡¿O sí?!",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0014h",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011h",head="mak_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002191",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¡Por supuesto que no! No he tenido a nadie con quien pudiera hacer eso, Y-Y...\naaahhhh, demonios... de nuevo con estos temas... ¡¡Dios!!",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"En fin, ninguno de los dos tiene experiencia en eso, así que estamos iguales.\nTampoco sabemos si realmente es verdad o no lo que dije. Así que déjalo así\nhasta que llegues a experimentar eso de verdad.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002192",ch="mkd"},
},
ja={
{
name={"Makoto"},
"E-Está bien...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002193",ch="mkd"},
},
ja={
{
name={"Makoto"},
"... Siento que últimamente todas nuestras charlas han venido tomando un giro\nbastante raro, por más serias que comiencen.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vamos, déjalo así y vive con algo más de soltura. Siempre te lo tomas todo muy\nseriamente.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002194",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Pues, lo admito, pero... está bien, bueno... vamos.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"(... ¿Mm?)",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Me detengo frente a la rotonda de la estación mientras me dirigía a Quimera.\nVeo una pequeña silueta dirigiéndose a la parada del bus... Esa es...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002195",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Qué sucede?",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ahh, no, solo que recordé algo que tenía que hacer. Sigue tu y luego te\nalcanzo. No es ninguna excusa para no estudiar ni nada de eso, así que no te\npreocupes.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002196",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No me preocupa eso, pero... bueno, está bien.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Aprecio bastante que acceda siempre a marcharse sin preguntarme nada en estos\nmomentos.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Bien, veamos...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Voy caminando dando grandes zancadas, dirigiéndome a la parada de buses cercana\na la rotonda.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Solo puedo verla de espaldas, pero muy probablemente es ella.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Es la niña que conocí hace poco en el hospital. Va caminando lentamente,\napoyada de un bastón.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"¿Estará regresando del hospital? Aunque hoy parece estar sola. ¿Su madre no\nvino a buscarla?",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Bueno, supongo que también tendrán sus propias circunstancias. Eso no importa\nahora... pero...",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"se",file="se9004",id=1},
{"bg",y=-450,zoom=100,x=-310,time=0,speed=2000,file="zbg013f",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"text"},
text={
ja={
{
"Voy acelerando mis pasos, pero sin ser muy indiscreto. Detrás de la niña con el\nbastón hay un hombre acercándose directamente a ella.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"En medio del montón de gente, me acerco de forma discreta a la espalda del\nhombre. No tengo certeza aún, pero si el hombre sigue avanzando a esa\nvelocidad...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"El hombre, ahora justamente detrás de la niña, levanta ligeramente uno de sus\npies. Justo lo que me imaginaba.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"cgact",stage="bg013",act="うなづく"},
{"se",file="se_bafu",vol=70,id=1},
{"text"},
text={
ja={
{
"En ese instante, puse mi mano sobre el hombro del hombre.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",time=200,file="bg013f",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",file="se2766",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_man_000001",ch="man"},
},
ja={
{
name={"Hombre"},
"¡¿?!",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"El hombre se sobresalta y voltea. Le sonrío alegremente.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Profesor! ¡¿Cómo está?!... Eh, ah, lo siento, me equivoqué de persona.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_man_000002",ch="man"},
},
ja={
{
name={"Hombre"},
"...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"El hombre se queda en silencio, lanzándome una mirada agresiva, para luego irse\nrápidamente.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"El brazo del hombre estuvo por golpear a la niña, así que la cargué rápidamente\npara que no se cayera, y la bajo de nuevo enseguida.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="寧",size="z1",mode=3,resize=1,path=":fg/nei/z1/",file="nei_z1i0000",face="i0006",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000019",ch="nei"},
},
ja={
{
name={"Nei"},
"Ah...",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"En sus ojos, ahora viéndome desde abajo, hay algo de sorpresa, pero no\nsospecha. Parece que se acuerda de mí.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Qué alivio. Si no se hubiera acordado de mí, hubiera quedado como todo un tipo\nsospechoso ante los demás.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"Lo siento, ¿te asusté?",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000020",ch="nei"},
},
ja={
{
name={"Nei"},
"No...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"La niña hace una reverencia con su cabeza. Su nombre era... Nei, sí.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Los bancos de la parada del bus estaban justo frente a nosotros. Nei se sienta\ndespacio.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000021",ch="nei"},
},
ja={
{
name={"Nei"},
"Muchas gracias.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Mm? Ah, sí... era demasiado obvio que haría eso.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0005",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000022",ch="nei"},
},
ja={
{
name={"Nei"},
"Sí. Hay muchas personas que se acercan por detrás de esa forma y patean mi\nbastón. Y no solo por detrás. Hay otras que lo hacen por delante también.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, llegué a escuchar historias parecidas cuando estuve en el pabellón de\nrehabilitación. Por alguna razón, hay personas que se enojan cuando no te\ntropiezas al patearte.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000023",ch="nei"},
},
ja={
{
name={"Nei"},
"Sí. No sé por qué lo hacen, pero las hay. Y tampoco sé por qué, pero así son.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"Entiendo.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"No está pretendiendo hacerse la sabihonda. Ni tampoco lo dice con frialdad. Su\nmanera de hablar no está carente de cualquier sentimiento, simplemente está\ndescribiendo la realidad como es, de forma llana y sobria.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000024",ch="nei"},
},
ja={
{
name={"Nei"},
"Ya estoy acostumbrada. Pero, de igual manera, muchas gracias.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, discúlpame a mí más bien. No logré asegurarme rápidamente de las\nintenciones de ese hombre y esperé hasta el último momento. Y en eso terminé\nasustándote.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0006",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000025",ch="nei"},
},
ja={
{
name={"Nei"},
"Pero...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000026",ch="nei"},
},
ja={
{
name={"Nei"},
"No hay nada de lo que tenga que disculparse.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero a mí si me parece.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",size=10,time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000027",ch="nei"},
},
ja={
{
name={"Nei"},
"... Sí.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Nei asiente silenciosamente.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Observo la tabla de horario del bus. Parece que tardará un poco en venir.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Hoy te toca regresar sola?",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000028",ch="nei"},
},
ja={
{
name={"Nei"},
"Sí. mamá está ocupada, así que... le dije que regresaría por mi cuenta.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0005",head="nei_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000029",ch="nei"},
},
ja={
{
name={"Nei"},
"Sí. Mamá está muy ocupada, y me da pena molestarla. Por eso quisiera que se\nolvidara un poco de mí de vez en cuando y tomara algo más de tiempo para\nella.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"Has estado esforzándote bastante, eh.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0005",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000030",ch="nei"},
},
ja={
{
name={"Nei"},
"Eso no es cierto. A veces la rehabilitación es tan dura que me dan ganas de\nllorar.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, te entiendo. Dan ganas de salir corriendo y huir.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0004",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0005",head="nei_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000031",ch="nei"},
},
ja={
{
name={"Nei"},
"Sí... y por eso soy una mala niña. Me da pena pensar en huir, a pesar de todo\nel dinero que cuesta la rehabilitación...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"Quizás esté de más que diga esto cuando en realidad no he visto nada de lo que\nhas vivido, pero, me parece que has estado haciendo las cosas bien. No tienes\npor qué presionarte tanto a ti misma.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0004",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000032",ch="nei"},
},
ja={
{
name={"Nei"},
"... Sí.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"se",file="se2658",id=1},
{"text"},
text={
ja={
{
"El bus llega y se detiene lentamente frente a la parada. El bus era de piso\nbajo, así que Nei no tendrá problemas en montarse aun con el estado de sus\npiernas.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000033",ch="nei"},
},
ja={
{
name={"Nei"},
"Muchas gracias por hoy.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"msgoff"},
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",lv=4,id=9},
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
{"ex",time=1500,func="wait"},
{"fg",ch="寧",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Nei hace una pequeña reverencia bajando la cabeza, y se sube al bus. Al tomar\nasiento, voltea hacia atrás y se despide de mí moviendo la mano a los lados.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Me vuelvo hacia Nei y muevo mi mano yo también. El bus comenzó a alejarse,\ncorriendo lentamente.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Mientras veo el bus alejarse, me meto la mano a mi bolsillo, pero no había\nnada.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"bgm",stop=1,time=1000},
{"excall",file="03_picapica_03_3"},
{"text"},
linkback="block_00216",
},
label = {
top={block="block_00000",label=1},
},
}
