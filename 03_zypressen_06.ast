astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c09_01",path=":ev/ev_eye_c09/",set="ev_eye_c09"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Paso mis ojos lentamente por la obra.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Umuh.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Está muy bien hecha.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es de sorprenderse... Akashi y los otros pusieron su alma en ella...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Es la obra que nuestro club de arte culminó durante el verano. La herencia de\nKenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_000900",ch="yum"},
},
ja={
{
name={"???"},
"“¿Qué se supone que hace fuera del salón alguien que tuvo que recibir clases\nsuplementarias en verano por haber reprobado?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rna_001737",ch="rna"},
},
ja={
{
name={"???"},
"“Escaparse de clases es malo, senpai.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Al voltear, me encuentro con Hikawa y Kawachino paradas frente a mí.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, eran ustedes dos. No es la gran cosa, simplemente quise venir a revisar\nalgo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001738",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Revisar algo?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cosas mías, no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001739",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora que lo recuerdo, el mural estuvo cubierto con una lona durante todo lo\nque quedó de las vacaciones. Fue apenas hace unos días que la retiraron.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001740",ch="rna"},
},
ja={
{
name={"Rina"},
"“Supongo que por eso no tuviste la oportunidad de verlo con cuidado.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tuve una el día del campamento.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001741",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ese día tuviste que limpiar la piscina, cocinar y estudiar. Además, luego en la\nnoche fuimos a ver los fuegos artificiales. No había forma de que pudieras\nverlo con calma.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si con eso no bastaba comenzó el alboroto con el mural al terminar las\nvacaciones.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001742",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, parece que incluso en las horas de descanso muchos se agolpan acá para\nverlo. 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000901",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, así que te saliste de clases simplemente para contemplar esto.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, a eso vine.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, me pregunto por qué la directora habrá esperado justamente a que\ncomenzara el nuevo período para mostrar la obra. Si es por reunir a los\nmedios le hubiera convenido más hacerlo durante las vacaciones...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0016",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001743",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién sabe? Quizás quería mostrársela primero a sus propios estudiantes. De\nvenir mucha gente de los medios los alumnos no podrían verla.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me parece que sea la clase de persona capaz de hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001744",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees? La directora es muy amable.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces a la directora?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001745",ch="rna"},
},
ja={
{
name={"Rina"},
"“No exactamente. Pero me la encuentro con frecuencia en la azotea.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En la azotea?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001746",ch="rna"},
},
ja={
{
name={"Rina"},
"“He estado pintando en la azotea desde que comenzaron las vacaciones de verano,\npara preparar la obra que presentaré en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has estado trabajando en ella desde verano?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001747",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, aunque bueno, digamos que lo de la Exposición Moore es solo una excusa.\nPinto allí simplemente porque hay algo en ese lugar que quiero pintar...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001748",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es por eso que he tenido varias oportunidades de encontrármela.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001749",ch="rna"},
},
ja={
{
name={"Rina"},
"“La directora suele venir a fumar a la azotea.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Heeh, no sabía.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001750",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tienes buenas relaciones con la directora, senpai?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos? ¿De verdad eres capaz de creer que esa señora y yo nos\nllevamos bien?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001751",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No? La directora parecía saber bastante de ti...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo... es que sabe de mí?...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001752",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea, la verdad es que no sé. Pero de tanto tiempo conociéndote sé que\nsueles meterte en los asuntos de mucha gente, senpai, así que no sería nada\nraro.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0016",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001753",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás la directora y tú tengan algún vínculo, de algún lugar. Nadie sabe.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, a esa mujer no la conozco de ningún lado.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001754",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000902",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahhh, ahora que lo recuerdo, la directora mencionó algo de que haría lo posible\npara expulsar a Naoya Kusanagi antes de que terminara este período.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es en serio eso?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001755",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está mintiendo. La directora nunca llegó a hablarnos de sus asuntos privados.\nSolemos ir a la azotea a pintar, y a veces nos encontramos con ella, solo\neso.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es la directora?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001756",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es una buena persona. Y además tiene bastante estilo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000903",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se ve muy bien con un cigarro en mano. Esa sonrisa cínica que muestra a veces\nme excita...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿'Me excita'?...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000904",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es preciosa, muy de mi tipo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino, no me digas que ves con ojos lujuriosos a esa señora...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000905",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues sí, supongo que el pequeñín Kusanagi no es capaz de comprender los\nencantos de esa gran mujer. Pero tranquilo, nada te impide que sigas\ncomplaciendo tus oídos con los excitados y aduladores balbuceos de tus\nfanáticas aún en pañales.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo había olvidado ya. Gracias por esa, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000906",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿D-De qué me estás agradeciendo?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que eran toda una molestia. Venían y venían sin parar, no se\nacercaban mucho pero tampoco se alejaban. Quería gritarles algo, pero así\ncomo estaban no podía.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",x=0,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000907",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Jaa! ¡Imbécil, esta es la única oportunidad que tendrás en tu vida para ser\npopular con las mujeres, deberías dejar de decir eso y simplemente\ndisfrutarlo!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jaa! Pues siento contradecirte. ¡Mi alta popularidad con las mujeres viene\ndesde el primer período!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000908",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cuántas veces tendré que repetirte que eran asesinas que habían venido por ti?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000909",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues qué más da, un torpe e insensible como tú jamás entenderá el verdadero\nvalor de las chicas, así que no pierdas tu tiempo y ve y cómete a alguna\nzorra por ahí.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, soy un idiota que no sabe distinguir una chica verdaderamente buena,\npero aun a pesar de eso tengo todo el derecho a elegir.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000910",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debe haber alguna chica que te guste entre toda esa manada de fieras.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues déjame decirte que en primer lugar, no me gustan las mujeres que hacen ese\ntipo de cosas.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0006",head="yum_z1b",x=0,lv=4,id=6},
{"fgact",ch="優美",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000911",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Aún virgen y pretendes sacar tu orgullo acá?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Justamente por ser virgen todavía es que me aguanto con mi orgullo!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000912",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y qué tanto tratas de aguantar? Deberías aprovechar de que tienes un pe*e y\nfollarte a toda mujer que se te acerque.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo por el hecho de tener un pene todos los hombres hicieran eso este país\nsería una nación de criminales.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000913",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eso dices? No tengo pene, así que no entiendo muy bien cómo piensan los\nhombres, pero si tuviera uno me gustaría metérselo a alguien.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y crees que yo no? Yo también quiero meterlo, demonios.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000914",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si tanto quieres meterlo entonces podrías metérselo a alguna mujerzuela por\nahí.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Solo se lo meteré a la mujer que me robe el corazón! ¡Una vagina para toda la\nvida! ¡Ese es mi ideal a seguir, y también la razón por la cual sigo siendo\nun maldito virgen!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=0,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000915",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uwah, ¿no te da pena decir eso?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa para nada, por más vergonzoso que sea. ¡Y además, no hay ninguna\nrazón para que estés tan pendiente de mi virginidad!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001757",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... tiene razón.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Parece que Hikawa no toleró mucho el nivel de vulgaridad de nuestra\nconversación, contestando solo con una sonrisa forzada.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Volviendo al tema, no pensé que ustedes dos conocieran a la directora.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001758",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tampoco es que la conocemos, simplemente nos la hemos encontrado casualmente en\nla azotea unas cuantas veces.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001759",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y ahora que recuerdo, aun antes de que se culminara el mural se la pasaba\nviendo con frecuencia la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000916",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, siempre parecía estar viéndola.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001760",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Será que quizás tiene algún fuerte apego con ella?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Aunque, sí me da la impresión de que algo pasó con esta iglesia hace\ntiempo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001761",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cuál es la temática de este mural?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La temática?... Probablemente los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001762",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, no sé realmente qué tenía Kenichiro Kusanagi en mente, pero para\nAkashi fue esa la temática.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en su caso, más que simplemente adoptar la temática, intentó reproducir\nlos cerezos milenarios en el mural.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001763",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Reproducirlos?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Supongo que habrá tenido sus razones para crear una obra que diera la\nilusión de que realmente existen.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000917",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Una obra que le diera vida a los cerezos milenarios?...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso mismo. Es eso lo que me llama un tanto la atención.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001764",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué exactamente te llama la atención?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen que aquellas obras creadas con fervor y corazón poseen el mismo poder que\naquello que buscan reproducir.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001765",ch="rna"},
},
ja={
{
name={"Rina"},
"“Como la historia de la pintura que cobró vida cuando le dibujaron los ojos,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. 'Garyou Tensei'.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Existe un mito de un pintor que vivió en el territorio de Liang durante la era\nNanbokucho, cuyo nombre era Cho So You. La historia trata de cómo el dragón\nque pintaba se escapó de su pintura al dibujarle ojos.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La gente a su alrededor no paraba de insistirle en que le agregara ojos al\ndragón. Sin más opción, Cho accedió. Y en el instante en que lo hizo, el\ndragón saltó de la pintura y rompió el techo, emprendiendo vuelo hacia los\ncielos.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Percibo algo similar en estos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y me da algo de mala espina.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001766",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mala espina?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque bueno, nada extraño puede ocurrir de esta pintura de por sí. Pero,\nsi los sentimientos puestos en ella llegaran a resonar con los cerezos\nmilenarios...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001767",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cada vez que hablas de la leyenda de los cerezos milenarios lo haces como si de\nverdad existieran, senpai.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como si de verdad existieran? No me hagas reír, Hikawa. No hay cosa que yo\nodie más que esa clase de cuentos esotéricos.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000918",ch="yum"},
},
ja={
{
name={"Rina"},
"“Realmente odias todo lo que tenga que ver con los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, los odio.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿no deberían irse ya de vuelta a la clase? Supongo que salieron porque\nme vieron afuera, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como pueden ver, no fue por gran cosa que salí.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001768",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así parece. Bien, ¿nos vamos de vuelta, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000919",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"se",file="se9004",id=1},
{"fg",ch="里奈",mx=40,mode=-1,lv=4,id=5,sync=0},
{"fg",ch="優美",mx=40,mode=-1,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Las dos se van caminando de vuelta al edificio de salones.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hm...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Los pétalos que vi aquel día en el Templo de Hakuki son los mismos que vi años\natrás. No me cabe duda.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"¿Será una señal de que los cerezos milenarios están por florecer de nuevo?...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es así, entonces tendrían que resonar con el corazón de alguien...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Los cerezos milenarios florecen al resonar con el corazón de alguna persona.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tan solo espero que esta pintura no termine convirtiéndose en el combustible de\nesos sentimientos...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Le vuelvo a dar un vistazo al mural.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Todos los sentimientos que Akashi puso en esta obra me recordaron, justamente,\na aquellos con los que resuenan los cerezos milenarios para florecer.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vámonos ya...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Considerando el desastre de esta mañana, decidí regresar un poco más temprano\nde lo que debería.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La última clase es de geografía, así que no hay problema...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg044a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Me paro frente al portón del colegio, solo.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quizás me preocupé de más?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Pensé que habría alguien esperándome para emboscarme en la entrada, pero no hay\nnadie, al parecer.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Aunque bueno, sería ya de terror si fuera alguien capaz de salirse de clases\nsolo para perseguirme.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bgm",stop=1,time=500},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",speed=300,file="zbg038a",path=":bg/",x2=390,y2=0,x=590,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="香奈",size="z2",speed=300,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0013",head="kan_z2a",x2=-200,x=0,lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"quake"},
{"se",file="se3130",id=1},
{"extrans",time=200},
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000234",ch="knd"},
},
ja={
{
name={"???"},
"“¡Ah~! ¡Ahhhh~! ¡Kusanagi-kuuun!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",zoom=60,speed=60000,file="zbg038a",path=":bg/",z2=100,x2=590,y2=0,x=150,y=-130,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="香奈",size="z2",zoom=130,speed=60000,mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0013",head="kan_z2a",y2=0,z2=100,y=100,lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg038",act="びっくり",size=2,time=500,loop=-1},
{"fgact",ch="香奈",act="びっくり",size=5,loop=-1,time=270,lv=5,id=9},
{"se",file="se9055",id=1,loop=1},
{"text"},
text={
ja={
{
"Escucho una voz a lo lejos.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Veo la silueta de alguien corriendo por la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? P-Pero qué.... ¿quién es?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"La muchacha va corriendo con fuerza la colina. Va a llegar agotada si sigue a\nese ritmo...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"se",stop=1,id=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Esta termina de llegar, parándose justo frente a mí.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bgm",file="bgm031"},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",time=300,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000235",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jaa, jaa, jaa, t-tanto tiempo, sin vernos. Soy yo, Kana Nagayama, ¡vaya\ncoincidencia encontrarnos acá!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Coincidencia?... Muchacha, te acabo de ver subiendo la colina corriendo,\nibas bien rápido...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0020",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000236",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? P-Por supuesto que no, claro, en lo absoluto. Y, ¿muchacha? Mi nombre es\nKana Nagayama, por si no escuchaste bien.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"¿Kana Nagayama?",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quién eres?",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0012",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0009",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000237",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Que, quién soy? No lo puedo creer... Estuvimos en el mismo colegio en la\nprimaria y la secundaria, ¿no recuerdas? Llegamos a tocar en la misma clase\nvarias veces, además.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De veras?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000238",ch="knd"},
},
ja={
{
name={"Kana"},
"“De veras. ¡Y mira nada más, lo increíble que pueden ser las coincidencias! Hoy\ncasualmente se me ocurrió pasar por aquí y te encontré.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Pasó casualmente por aquí, eh...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Así que casualmente pasó por un camino sin bifurcación alguna, y casualmente\ntambién me encontró y corrió a agarrarme.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000239",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, quiero decir... esto, ehm. ¡Ah, Kusanagi-kun, así que volviste a pintar!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que volví a pintar?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000240",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, me agarró por sorpresa la noticia. Siempre, siempre me han gustado tus\npinturas, y cuando me enteré de que habías dejado de pintar quedé muy triste.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000241",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Lo vi todo en la tele! Es increíble. Apenas los vi pensé, 'solo Kusanagi-kun\npodría hacer algo así'. ¡Y es verdad, nadie más podría lograr semejante\ncreación! Es absolutamente increíble.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"¿De nuevo con esto?...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Seguramente vio el reportaje que hicieron del mural.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Por Dios, no fui yo sino Akashi quien lo hizo...",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"¿Qué solo yo podría hacer algo así? Vamos...",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las huellas de los cerezos...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0012",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000242",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Las huellas de los cerezos?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es esa, ¿no? La que han estado transmitiendo por TV.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bgm",stop=1,time=1000},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000243",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, eso...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Apenas escuchó la muchacha el nombre de 'Las huellas de los cerezos', el ánimo\nen su voz bajó.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bgm",file="bgm026"},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000244",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues... sí, digamos que como obra no está nada mal, pienso yo. Pero, eso de\nsacar una obra bajo el apellido Kusanagi cuando una de sus partes más\nimportantes la pintó otra persona, no me parece...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000245",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero es una obra impresionante, solo a simple vista. Solo viendo su diseño se\nnota la genialidad de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000246",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero ese tronco no me agrada mucho...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-El tronco?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000247",ch="knd"},
},
ja={
{
name={"Kana"},
"“Supongo que la persona quien lo hizo practicó mucho, pero... ese tronco no lo\nhizo Kenichiro Kusanagi, ni tampoco Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000248",ch="knd"},
},
ja={
{
name={"Kana"},
"“A mi parecer, es una mala imitación.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"El tronco, una imitación...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000249",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, ¿pero qué insolencias estoy diciendo? ¡Aun así es una gran obra! ¡Es\nabsolutamente fenomenal!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"¿Qué demonios le pasa a esta mujer?...",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Insinúas que esa obra no es mía?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000250",ch="knd"},
},
ja={
{
name={"Kana"},
"“Supongo que también tú habrás participado en su creación, pero... decir que esa\ncosa representa tu retorno al arte, no me convence.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Que acaso no estás hablando de 'Las huellas de los cerezos'?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0001",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000251",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Esa obra no es de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Entonces a qué demonios te refieres cuando hablas de la obra mía que\npresentaron en la TV?! Que yo sepa no hay ningún otro reportaje circulando\npor ahí.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000252",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eh~, vamos, no te hagas el tonto. Has estado conmocionando al mundo del arte.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000253",ch="knd"},
},
ja={
{
name={"Kana"},
"“Lo de 'Las huellas de los cerezos' solo ha salido en las noticias locales, pero\n'eso' ha estado conmocionando al mundo entero.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Insinúas, que fui yo quien pintó eso?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0002",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000254",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Solo Naoya Kusanagi podría hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Imbécil, tú...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0008",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000255",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿Q-Qué sucede? ¿Por qué me hablas con esa voz tan amenazadora?...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién rayos eres?... ¿Te enviaron los Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0010",head="kan_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0012",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000256",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Los Nakamura? Ahh, ¿los propietarios de esos cuadros? No tengo relación alguna\ncon esa familia de millonarios.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"¿Quién demonios es entonces?...",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Se supone que eso quedó como un secreto entre Akashi, Fridmann y yo...",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0009",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000257",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no eres de los Nakamura, ¿entonces por qué estás averiguando mi vida?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0010",head="kan_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000258",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Que por qué? Hmmm, ¿por qué será? Digamos, que soy tu acosadora,\nKusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acosadora, dices?...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0004",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000259",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí. Me muero por saber de ti. Quiero conocer todo acerca de ti.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0002",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000260",ch="knd"},
},
ja={
{
name={"Kana"},
"“Acerca, por ejemplo, de por qué dejaste repentinamente de pintar.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0008",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000261",ch="knd"},
},
ja={
{
name={"Kana"},
"“En ese entonces escuché rumores de que habías sufrido un accidente...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0011",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000262",ch="knd"},
},
ja={
{
name={"Kana"},
"“No sé realmente si fue por un accidente que dejaste de pintar, pero...",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0006",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000263",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero si de verdad dejaste de hacerlo por una razón tan absurda, entonces la\npersona que causó ese accidente debería pagar varias decenas, cientos, miles\nde millones en compensación.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0010",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000264",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Fue culpa de alguien en carro? ¿Quedaste con alguna secuela? Ahora que lo\nrecuerdo, en esa época te ausentaste del colegio por varias semanas...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0012",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000265",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y por cierto, en esa mismas fechas...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lárgate...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0009",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000266",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vaya, qué miedito...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué buscas, pero no vuelvas a aparecerte frente a mí.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0005",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",loop=2,time=400,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000267",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué, por qué? Vamos, no puedo hacer eso. ¿Volviste a tomar el pincel?\n¿Cuándo pintarás de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No estoy pintando una mierda! Ni pienso pintar de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0012",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000268",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿No piensas pintar?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, y ahora que lo sabes lárgate de una buena vez de mi vista!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000269",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, no me grites de esa forma tan espeluznante. Pero, ya veo. Así que no\npiensas pintar...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0009",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000270",ch="knd"},
},
ja={
{
name={"Kana"},
"“Perooo, ¿será verdad eso? Déjame recordarte que sí pintaste.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo ya no pinto. Para ya con las mentiras.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0005",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000271",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Mentiras? ¿Vas a negar acaso que pintaste?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000272",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pintaste, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Esta mujer...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001769",ch="rna"},
},
ja={
{
name={"???"},
"“¡Senpai! ¡¿Tienes un segundo?!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Escuché una voz venir de lejos. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"se",file="se0744",id=1},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=300},
{"fg",ch="里奈",size="z1",sync=1,mx=40,mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006",head="rna_z1d",x=345,lv=4,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001770",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, senpai, es urgente.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000273",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Ah? ¿Y tú, quién eres?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_001771",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, solo soy una kouhai. ¿Senpai, qué estás haciendo? El profesor te está\nbuscando. Si se llega a dar cuenta de que estás jugando acá se enfadará.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0018",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",loop=3,time=250,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000274",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Vas a... responderme? ¿Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_001772",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿yo? A mí solo me mandó el profesor. ¡Y me pidió que llamara a senpai, así\nque con su permiso--!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0007",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000275",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Esp-, espera un momento, tú!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",mode=-2},
{"se",file="se0744s",id=1},
{"text"},
text={
ja={
{
"Hikawa me jala de la mano y corre.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Nagayama estaba haciendo un alboroto detrás, pero Hikawa siguió corriendo con\nfuerza, como si nada.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bg047a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うんうん",time=500,lv=4,id=6},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001773",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, jaa... Llevaba tiempo sin correr, siento que por poco se me sale el\ncorazón por la boca...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hikawa, cómo es que?...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001774",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy en mi hora de gimnasia...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De gimnasia?... Pero... tu uniforme... Ah, claro... en tu caso no estás\nobligada a participar.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001775",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Vi que una extraña te estaba molestando por la entrada, así que decidí\nactuar...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me salvaste de esta...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001776",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién era esa muchacha, senpai? Se te escuchaba la voz desde lejos...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijo que se llamaba Kana Nagayama, o algo así... No la recuerdo bien, según\nella fuimos compañeros de clase hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y parece que está intentando averiguar acerca de mí...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001777",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Era otra de las fanáticas por lo del mural?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, parece que no tiene nada que ver con eso.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé cómo demonios, pero descubrió que yo no soy el creador del mural. No sé\nsi es que tiene buen ojo, o si obtuvo la información de algún lado...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001778",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece ser alguien muy tediosa de lidiar...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, pero considerando también lo que sucedió esta mañana, quizás haya que\ntomar algo de precaución...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001779",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Lo que sucedió esta mañana?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el alboroto de esta mañana, cuando Kawachino me abrazó.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue por eso que te enfadaste con ella, ¿verdad? Te preocupó que quizás se\npodría meter en algún problema después de eso.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001780",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... así que te habías dado cuenta ya. Tan perspicaz como siempre,\nsenpai...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta el más torpe se daría cuenta de eso.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001781",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero no diste ningún indicio de haberte dado cuenta en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque para entonces todavía no sabía. La cabeza se me hizo un desastre cuando\nKawachino me abrazó de repente.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero sí, después me lo pensé bien y me di cuenta. Digo, no hay otra razón por\nla cual te pudieras haber enfadado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001782",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No dudes en pedirme ayuda si algo llega a pasarle a Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001783",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué no se lo dices directamente a Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees que Kawachino va a pedirme ayuda como si nada si se lo digo\nyo? Más bien se pondrá más terca de lo que es.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001784",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso es seguro.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001785",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque creo que estás siendo un tanto excesivamente precavido...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no lo niego. No me preocuparía tanto si fuera otro el caso, pero la\nmuchacha esa me tiene algo alertado. Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001786",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿La muchacha de hace un rato?...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé por qué, pero me da la impresión de que no me dejará tranquilo todavía...\nY me preocupa que a Kawachino llegue a sucederle algo por eso.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001787",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no puedo estar siempre vigilando a Kawachino. Sé que tú sabrás cuando algo\nle suceda.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001788",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que bueno, cuida de Kawachino por mí mientras puedas, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001789",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien. Y, gracias por preocuparte por Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Hikawa hace una reverencia.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué estás haciendo?... La culpa de todo la tengo yo en principio...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001790",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero me alegra de que te preocupes por ella.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001791",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Bien...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Te vas ya?”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001792",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues sí, se supone que debería estar en clases ahora mismo...\n¿Es que necesitas algo más?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada, realmente, solo que últimamente no hemos hablado mucho los dos solos.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001793",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ahora que lo mencionas... Sí, todo el tiempo estoy con Yuumi al lado.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así que, si tienes algún problema del cual me quieras hablar...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001794",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues creo que ninguno por ahora...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001795",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso quiere decir que en el caso contrario de no tener ningún problema del cual\ndiscutir no puedo hablarte?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no. Si no te importa, pues, podríamos hablar de cualquier cosa.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0015",head="rna_z1d",lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_001796",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, de ser así... *ejem*”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="里奈",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="里奈",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001797",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre tan popular con las chicas, ¿eh, senpai?...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿A qué viene de repente el tema?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001798",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es que la muchacha que se hacía llamar Nagayama dijo... escuché solo un poco,\npero dijo que era tu acosadora.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, más que acosadora, simplemente está buscando información\nconcerniente a mí.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001799",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y es que los acosadores no hacen eso también?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí, tal vez, pero...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001800",ch="rna"},
},
ja={
{
name={"Rina"},
"“Podemos decir que tu extrema popularidad con las mujeres ha puesto en peligro a\nYuumi.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, eso no es así. En primer lugar, fue Kawachino quien...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0003",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001801",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi es una muchacha muy buena, senpai. Se dio cuenta de que yo no encontraba\nmanera de hablar contigo, y por eso es que hizo eso.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡¿Fue por esa razón que cometió esa barbaridad!”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001802",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Esta mañana eras como una especie de idol, era imposible hablarte, y fue\nentonces que Yuumi hizo eso. Por mí.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, pudieron haberme hablado como de usual, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001803",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te parece? Creo que, tal vez la decisión de Yuumi fue correcta. Solo basta con\nver todo el odio que se ha ganado de las otras muchachas después de hablarte.\nSi hubiera intentado hacerlo yo entonces me habría pasado lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, fue ella la que se sobrepasó con su actuación. Si me hubieran\nhablado normalmente no hubiese sucedido nada.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001804",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Aunque estaba algo difícil hablarte como de usual.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_001805",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hay nadie con las agallas para intentar hablarte en esa clase de\nsituación... O no, tal vez Rin-senpai si pudiera haberlo hecho.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene que ver Rin en esto?...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001806",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada en especial. Pero, es hermosa, ¿no, Rin-senpai?”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada, una cosa no tiene que ver con la otra...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="いいえ",size=5,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001807",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que sí. Incluso Yuumi está muy encariñada con ella.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino, a Kawachino le gustan las caras bonitas...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001808",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues deberías saber que Yuumi también está encariñada conmigo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues si de caras bonitas hablamos, obviamente tenías que estar tú también.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001809",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hmmm, ya veo. Me pone feliz escuchar eso.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pareces estarlo para nada.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001810",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy muy feliz, onii-chan ♪”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001811",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Está mejor así?”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así? ¿Es que estás bromeando?”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0003",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001812",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno, supongo que tomaré con un 50 % de seriedad tus palabras, senpai.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero de qué estás hablando?...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001813",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo digo con razón. Desde que entré a Yumihari me he enterado de que has estado\nmetiendo las narices en muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, Rin me dijo lo mismo. No sé por qué, considerando que no es cierto...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0015",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001814",ch="rna"},
},
ja={
{
name={"Rina"},
"“No estás consciente de que lo estás haciendo.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001815",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, has levantado tantas banderas como el protagonista de un eroge o una\nnovela ligera.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con que estoy levantando banderas?...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0017",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001816",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los protagonistas de hoy en día se la pasan ayudando a chicas en problemas,\nlevantando banderas como si no hubiera un mañana. ¿Por qué lo hacen? ¿Es que\nacaso sienten la responsabilidad de hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué me hablas.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001817",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sentido de responsabilidad... Supongo que será eso...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Hikawa baja la cabeza y sonríe un poco.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001818",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las pinturas son realmente curiosas, ¿no te parece? No tienen ni una sola\npalabra en ellas, y sin embargo, te hacen sentir algo que las palabras no\npodrían provocarte.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001819",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque claro, no todas las obras son capaces de hablarle al espectador. Y no\ntodos pueden entender lo que ellas transmiten.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001820",ch="rna"},
},
ja={
{
name={"Rina"},
"“El encuentro con una obra es como el encuentro con una persona... o no, tal vez\nincluso más. Algo que va más allá de las palabras.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001821",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fantasía de un día de cerezos... Ya veo. Ahora entiendo mucho mejor eso que\ncuando vi aquel cuadro por primera vez.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001822",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y es así. No soy la única. Cualquier muchacha con algo de agudeza te tendría\nrecelo, senpai...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos dices? ¿Es que acaso me has venido tratando con cautela?”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001823",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues sí. He tenido que hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué? ¿Es por lo que dice Kawachino? De que soy un pervertido y eso.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0015",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001824",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Un pervertido? Si lo ponemos en esos términos, se podría decir que eres algo\nde aún peor calaña.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De peor calaña que un pervertido?...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001825",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Has escuchado alguna vez de esta maldad?”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001826",ch="rna"},
},
ja={
{
name={"Rina"},
"“De esa que es peor a una violación. Y que a pesar de eso, no es penada.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no... ¿Es que existe algo así?”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001827",ch="rna"},
},
ja={
{
name={"Rina"},
"“Violar a alguien implica tomar a la fuerza el cuerpo de esa persona. Eso es\nalgo terrible, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es. He escuchado que la pena por hacerlo es tan fuerte como la de un\nasesinato.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001828",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, la violación es un crimen grave. Sin embargo, jamás han castigado a nadie\npor hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con 'eso'?”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001829",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si tomar a la fuerza el cuerpo de alguien es algo terrible, ¿no es terrible\ntambién entonces robar un corazón?”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene nada malo, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001830",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo es, claro que sí. Quizá aquellos a los que se les fue robado el corazón a la\nfuerza sufren tantos como aquellos cuyos cuerpos han sido tomados\nforzosamente...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001831",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y peor, cuando te roban ambos. Y cuando a pesar de eso, no te corresponden...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001832",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es por eso que creo, que más que de los pervertidos, debemos cuidarnos del\namor.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Del amor?”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001833",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, en particular, del amor puro. Y para ser más específicos, de la más pura\nfilantropía.”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001834",ch="rna"},
},
ja={
{
name={"Rina"},
"“La filantropía es el mal del cual toda chica debe tener mayor cuidado.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso entonces Cristo y Buda son peores que el peor de los\ndepravados...”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001835",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni idea. No sé mucho de personajes históricos.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0015",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001836",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero sí creo que cualquier muchacha debería tratarte con cautela.”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya. No entiendo muy bien por qué, pero me has hecho entrar en cuenta de que\nme tienes cautela.”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001837",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me reconforta saber que lo entiendes...”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=6},
{"se",id=1,file="se_school_chime"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001838",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ya va a terminar la clase. Si no regreso ya se darán cuenta de que estuve\nafuera.”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Hikawa se apresura a bajar las escaleras.",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Procuré decirle esto antes de que bajara.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que me odias~?”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
vo={
{"vo",file="fem_rna_001839",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Qué tonterías andas diciendo?! ¡Yo a ti te quiero demasiado, senpai!”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Qué bueno saber eso.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="fem_rna_001840",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno no es. ¡Beh~!”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"Me sacó la lengua.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"excall",label="label01",cond="f.yum==1"},
