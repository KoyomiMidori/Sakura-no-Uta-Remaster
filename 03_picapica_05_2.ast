astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="bluesky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Qué calor.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Al terminar la hora de tutoría e intentar regresar, Toritani me llamó y me\nasignó una extraña misión.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Gracias a eso pude vivir una ligera experiencia maratónica por el vecindario,\nyendo de allí a allá escalando y caminando muros.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Me dijo que me daría la razón para esto cuando yo llegara a Quimera, pero...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"El contraataque de calor hace que el sudor corra por mi cuerpo tras moverme\nintensamente. Por lo menos sé que estaré más fresco en Quimera.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Y además, tengo que estudiar...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"... Supongo que iré.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Abro la puerta de Quimera. Trato de dejar caer mi cuerpo en las gélidas manos\nde la frescura que tanto estaba esperando, y――",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Vaya.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"No siento ninguna frescura.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Toda esa expectativa se me devuelve en forma de sudor saliendo de todo mi\ncuerpo. ¿Qué? ¿Pero qué pasa? ¿Es que acaso Quimera se unió a la onda\necológica y prohibieron el uso del aire acondicionado?",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002525",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienvenido, d-disculpe... nuestro aire acondicionado está ahora... eh, pero si\neres tú, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpa que no sea un cliente, eh.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002526",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, más bien me alegro que seas tú. ¿Y espera, por qué estás sudando tanto? Ah,\ndisculpa, dale un poco de agua.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_bit_000013",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Entendido～”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Toritani está encima de unas escaleras, al parecer peleando ahora con el aire\nacondicionado.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"No es de esos aires acondicionados industriales que se instalan en el techo,\nsino uno de uso doméstico pero de buen tamaño.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy bañado en sudor gracias a esa rara misión que me mandaste a cumplir.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0003",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0004",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002527",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, así que cumpliste con mi misión. Muy bien, muy bien, eso me pone feliz.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijiste que me darías el motivo cuando llegara a Quimera.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_bit_000014",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Aquí está el agua～”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, gracias.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo me trajo una jarra cervecera llena de agua.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"El volumen es realmente absurdo para la cantidad normal de agua que se le sirve\na un cliente en los cafés, aunque no podría estar más agradecido ahora por\nesta cantidad.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_bit_000015",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Y aquí tienes una toalla～”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Al dar las gracias y tomarla, disfruto de la fresca y gélida toalla. Este\nrefrescante frío me es infinitamente preciado.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002528",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estás más calmado ya?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Después de refrescarme y calmarme un poco Toritani me habla mientras retira el\nfiltro del aire acondicionado.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Está de espaldas a mí, montada sobre la escalera, así que no debería poder ver\nrealmente cómo estoy...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"De verdad que realmente siempre es bastante sagaz.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Y tan considerada que esperó a que me refrescara para hablarme.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Me asignó una misión totalmente descabellada y usualmente finge que nada le\nimporta, pero es difícil encontrar a una persona tan atenta como ella.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. ¿Se dañó el aire acondicionado?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002529",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... sí. Hace un rato llamé a servicio al cliente y parece que vendrán a\nrepararlo mañana, pero... con este calor...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Toritani se limpia el sudor de su barbilla, mientras continúa con la labor.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002530",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay veces que se arreglan cuando los limpias, así que se me ocurrió intentar\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo lo hago.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002531",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué dices?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Toritani baja de la escalera suavemente, sin hacer casi ningún sonido.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"La falda de su atuendo de maid revolotea ligeramente. Mis ojos se deslizan\ninstintivamente hacia sus bien formadas piernas, pero trato de apartar mi\nmirada de la forma más natural posible.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002532",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, lo siento, pero regresa ya a casa y estudia allá. Aprovecha el tiempo\nque tengas para estudiar, hasta el último segundo.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que esto es acaso también otra disputa de préstamos y deudas?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ti tampoco te convendría que bajaran las ventas en Quimera, ¿no? ¿Qué tal si\nasumes tu posición como representante de la gerente y te pones como prioridad\ncumplir con tu responsabilidad como tal?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002533",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo digo por eso. Simplemente no quiero robar de tu valioso tiempo de estudio\npara los exámenes de ingreso con esto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002534",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vas a terminar estrellándote muy duro si no te tomas en serio los exámenes.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me estoy tomando los exámenes a la ligera, y deja que yo me encargue del\naire acondicionado.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002535",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, solo quédate ahí y observa. Si nos quedamos discutiendo entre hacer algo\no nada acabaremos perdiendo nuestro tiempo los dos.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002536",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Jaa, está bien.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por cierto, hay algo que me enseñó el técnico cuando mi aire acondicionado se\naverió hace un tiempo. Probemos con eso.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002537",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, tengo que ver eso.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo hay que desenchufarlo y dejarlo por 10 minutos desconectado.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002538",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002539",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, tú. Puedes entrar en receso mientras dejamos el aire desconectado.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_bit_000016",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Waa, muchas gracias～”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002540",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay aire acondicionado en el cuarto de empleados, así que puedes ir allá, o si\nquieres puedes salir también.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_bit_000017",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Entendido～”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo se dirige al cuarto de empleados, alegre.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quieres puedes irte tú también a alguna habitación con aire acondicionado.\nAunque bueno, supongo que no tiene mucho caso que te lo diga.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002541",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si es por eso entonces yo misma podría encargarme de desconectar y limpiar el\naire acondicionado.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Resultará más eficiente que lo hagamos entre los dos, ¿no? Primero\ndesenchufamos...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ahora, a darle una pequeña limpieza. Aunque parece que ya lo tienes bastante\nlimpio.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002542",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Manejamos clientes adentro del local, así que suelo limpiar con frecuencia el\naire acondicionado.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002543",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, espera un segundo, iré a abrir las ventanas y la puerta. Es mejor que entre\nalgo de viento, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Toritani abre las ventanas y la puerta del local. El viento que sopla adentro\nda a sentir el otoño que se acerca.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002544",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa la espera, ¿comenzamos ya?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, terminemos rápido con esto. Y dame un buen café helado como recompensa\ncuando acabemos.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002545",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro. También te pagaré por el tiempo de trabajo, así que no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mejor trato no podría pedir, eh.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Excelente.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",id=1,file="kanki"},
{"text"},
text={
ja={
{
"*booo*――――",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Al escucharse el débil sonido de un motor arrancando, aire frío comienza a\nsalir del equipo de aire acondicionado.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0004",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002546",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo lograste!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hice la gran cosa como para decir que lo arreglé, pero bueno, parece que\nfuncionó.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002547",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejé lista una toalla fría y algo de agua allí, así que ponte cómodo.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Cuando me dispuse a volver a su lugar los instrumentos de limpieza para el aire\nacondicionado, me di cuenta que ya Toritani se había encargado de guardarlos\ntodos.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La puerta y las ventanas estaban ya cerradas de nuevo.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Toritani agarró los instrumentos de limpieza y trató de ir al fondo, así que\npongo mis manos sobre la escalera.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a guardar la escalera también, ¿verdad? Yo la llevo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Y al hacer eso, Toritani volteó rápidamente y con bastante ímpetu me arrebató\nla escalera.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002548",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ya está bien! Ya trabajaste lo suficiente, ¿no crees? ¡Vamos, siéntate ya!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",file="se9012",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani deja provisionalmente los instrumentos de limpieza en el suelo y se\nlleva primero la escalera.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Es mejor dejar que haga lo que quiera en este momento.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"La manera en que carga con pasos lentos pero firmes la escalera inspira\nbastante confianza.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Aunque bueno, la alfarería de por sí exige bastante resistencia física, y el\ntrabajo en Quimera, estando todo el día en traje de maid, exige bastante\ntambién, como básicamente lo hace cualquier negocio de comida y bebida.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Aunque sus horas de sueño y consumo alimenticio es menor al promedio general.\nMás que digno de admirar, ya es realmente un misterio. ¿De dónde saca tanta\nfuerza?",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Aunque bueno... supongo que quedarme aquí parado y dejar que se ponga tibio el\nfrío pañuelo que me preparó no sería muy buena idea.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Al posar mis piernas en el mismo asiento de siempre, disfruto del pañuelo, el\nagua y el frescor del aire acondicionado.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",id=1,file="se2225"},
{"fg",ch="霧乃",size="z1",mx=40,mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_krd_000014",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Oh, vaya, así que arreglaron el aire acondicionado.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, acabamos de arreglarlo, así que llegó justo en buen momento.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_bit_000018",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Sea bienvenida～”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Quimera va retornando a sus labores normales. Creo que fue buena idea haber\nreparado rápidamente el aire acondicionado.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002549",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Debes estar cansado. Toma, café helado.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Toritani regresa, poniendo una bandeja con un vaso de café helado frente a mí.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohh, café helado.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Tomo un sorbo antes de agregarle el sirope de azúcar.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bueno.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Al comentar eso, vierto el sirope.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"El sirope está contenido en una jarra, y no en un empaque individual. Me han\ncontado que el sirope de azúcar lo hacen también acá en Quimera.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002550",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En un rato te prepararé algo ligero, así que espera con ansias. Eso es también\nparte de la paga por el trabajo, así que acéptalo sin preocuparte tanto.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me preocuparé si me garantizas que el salario viene de parte de Quimera. No\nsigas tratando de pagarme de tu propio bolsillo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002551",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya llamaste para rechazar la reparación de mañana?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002552",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes todo en regla, hasta el más mínimo detalle.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002553",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, aunque me parece que eso es lo normal. En fin, date un respiro. Y\ndespués de que descanses un rato--”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A estudiar, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002554",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal cual. Esfuérzate bastante, mi amo.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohh---”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"No puedo contener la emoción al ver cómo esa Toritani hace un gesto típico de\nmaid en su traje.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002555",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto también es parte del servicio especial. Nos vemos en un rato.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"se",file="se9012",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Quizás lo dijo aparentando normalidad, pero me puedo dar cuenta de que está\nalgo avergonzada.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Por supuesto, es de esa clase de gestos de vergüenza difíciles de discernir de\nno llevar tiempo conociéndola. Esos gestos de Toritani son realmente tiernos.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"La campana de la puerta anuncia la llegada de un cliente.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002556",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienve――”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bgm",stop=1,time=500},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002557",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... nida.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"El vívido y elegante saludo de bienvenida de Toritani cambió justo en el\ninstante en que se dio cuenta quién era el cliente. No de manera tan obvia,\npero sí lo hizo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="紗希",size="z1",mx=40,mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000189",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vamos, no pongas esa cara. Te recuerdo que soy una clienta más.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="紗希",time=350,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002558",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tiene razón. Bienvenida. ¿Viene sola?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000190",ch="htd"},
},
ja={
{
name={"Directora"},
"“En un rato vendrá alguien más. Dame un café helado.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002559",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entendido. Bien--”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000191",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, no hace falta que me lleves a la mesa. Me sentaré en cualquier lugar por\nallí.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",mode=-2},
{"se",file="se9012",vol=50,id=1},
{"text"},
text={
ja={
{
"La directora se dirige al asiento de la ventana. Elige su asiento, sin\nvacilación alguna y sin siquiera observar el interior de la tienda. Antes de\nsentarse deja el pequeño paquete que llevaba entre su brazo en la silla libre\ndel otro lado de su mesa.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Se me hace difícil creer que es la primera vez que viene al local al verla\nmoverse así. Probablemente ya conocía Quimera.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002560",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Poco después, Toritani vuelve con un café helado. Su expresión está aún un\ntanto tiesa.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Muy seguramente sabe que está fallando en su intento de fingir indiferencia.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002561",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpe la espera, aquí está su café helado.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"Toritani coloca el vaso de café helado frente a la directora, de la misma\nmanera que lo hace siempre.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000192",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Son los granos de Shizuru?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002562",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Son perfectamente aptos para ser consumidos, así que puede beberlo sin\npreocupación alguna.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000193",ch="htd"},
},
ja={
{
name={"Directora"},
"“Eso no me preocupa en lo absoluto. ¿Aún sigue de trotamundos?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002563",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Normalmente atiende las llamadas, le recomiendo que la llame y le pregunte\nusted misma.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000194",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pero hay veces que no atiende, ¿no? Aun teniendo un teléfono satelital.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002564",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que su teléfono se descarga frecuentemente y no se da cuenta. Disfrute\nde su café.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",mode=-2},
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"Justo cuando Toritani trató de irse, la campana de la puerta volvió a sonar, y\nuna mujer entra.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Me parece haber visto su cara en alguna parte... No, más bien es la silueta de\nsu cuerpo lo que se me hace familiar. Es la mujer que estuvo con la directora\nanteriormente.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Y también la mujer que conducía el automóvil donde se montó aquella pusilánime\nclienta frecuente.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"La directora se para y camina a recibir a la mujer.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000195",ch="htd"},
},
ja={
{
name={"Directora"},
"“Disculpa que te haya hecho venir hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_obs_000005",ch="obs"},
},
ja={
{
name={"???"},
"“No se preocupe, yo también estoy algo interesada.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"se",file="se9012",vol=50,id=1},
{"fg",ch="紗希",mx=40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"La directora camina, guiando a la mujer al asiento. Realmente no pareciera ser\nsu primera vez en Quimera.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Ambas se pararon frente a una pintura colgada en una pared al fondo de la\ntienda.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Hablan en voz baja, acercando sus caras. No hay forma de observar sus labios\ntampoco. Supongo que no hay manera de saber lo que están hablando desde acá.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",file="se2225",id=1},
{"text"},
text={
ja={
{
"Un rato después, ambas salieron del local. Hablaron alrededor de 5 minutos.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"La paga por el café helado, del cual no se había bebido ni un sorbo, estaba\nsobre la mesa.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Después de que ambas salieron, me paro y camino hacia el cuadro de la pared.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"msgoff"},
{"bg",speed=240000,file="zbg031a",path=":bg/",x2=960,y2=120,x=960,y=580,ax=1920,ay=1126,bx=-960,by=-586},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Una urraca...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Sabía que había un cuadro algo grande allí, pero supongo que al estar al fondo\ndel local nunca llegué a verlo con atención.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Allí había un pueblo rural en invierno, un paisaje de blanca nieve, junto a una\nurraca. Una diversidad de blancos, mezclados con un contraste entre el blanco\ny el negro.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"El cuadro era, casi sorprendentemente, muy parecido a 'La urraca' de Monet.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"La urraca de Monet tiene más de 1 metro de ancho, así que este cuadro es\nbastante pequeño en comparación.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Sin embargo, el toque y el uso de los colores está muy bien realizado. Se\npodría decir que es incluso inusual.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002565",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este cuadro lo pintó ella.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La directora?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002566",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Asombroso. Ah, ahora que lo recuerdo, había mencionado que vino de una\nuniversidad de artes.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Y además, comentó también que había estudiado en el mismo salón con Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002567",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se especializó en pintura japonesa, y a pesar de eso... esta fue la única\npintura en óleo que produjo mientras estuvo en la universidad.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Llegaste a hablar de eso con la directora?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002568",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Ni ella ni yo llegamos a tener nunca una relación muy elocuente, aun yo de\npequeña.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002569",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que la dueña recibió este cuadro en una ocasión especial. Eso es lo que\nescuché.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que la dueña y la directora tienen una relación cercana...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002570",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... la razón primordial por la cual la dueña está cuidando de mí ahora es\nporque ambas se llevan muy bien.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002571",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa mujer y la dueña son tía y sobrina respectivamente. Parece que se llevaban\nbien aun antes de que yo naciera.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que este es el único cuadro que produjo en la universidad... Realmente\ntiene bastante talento.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002572",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al parecer imitó a Monet muy premeditadamente. Cuando hablamos de Monet, más\nfamosos son sus nenúfares, digo yo... Hay un enorme número de ellos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002573",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El interés de Monet estaba en la luz. Esa luz que yace en el color que cambia\njunto al tiempo y las estaciones.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002574",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Desde joven hasta sus últimos días Monet se dedicó a crear una gran serie de\npinturas, comenzando por los nenúfares, con el objetivo de darle forma\ntangible al cambio del tiempo y las estaciones.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002575",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque 'La urraca' como tal es una de sus primeras obras...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002576",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y ciertamente, para 'Mujer con sombrilla', pintada 5 o 6 años después de 'La\nurraca', existe un retrato pintado 10 años después con la misma temática y\nuna estructura muy cercana.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002577",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé si esta 'Urraca' fue también parte de una serie o solo una obra de\npráctica... pero en fin, fue pintada como parte de esa temática... Parece que\nse basó en ese concepto.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿no está como que muy elaborada como para haber tratado de pintar un\nsimple cuadro de óleo?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002578",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Parece que hay bastantes circunstancias tras este cuadro. No conozco muy\nbien lo que pasó, pero parece que fue parte de una especie de broma que ella\nmisma planificó...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una broma...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"No puedo creer que haya pintado semejante obra solo para una broma.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Seguramente Kenichiro Kusanagi estuvo rodeado de una gran cantidad de talentos\ny genios, así como los hay ahora en el club de arte del colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿por qué la dueña tiene ese cuadro en su posesión ahora?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002579",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, eso...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Toritani suelta un ligero suspiro.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Ese gesto me provoca más curiosidad.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002580",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh... digo, es que se me ocurrió que quizás los Toritani realmente llevan esos\nrasgos en la sangre.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres con rasgos?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002581",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Digamos que son una familia muy bromista. Y realmente le ponen empeño en sus\nfechorías.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no puedo imaginarme eso viendo a la directora como está ahora.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002582",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me lo imagino... Por eso mismo es que yo también quedé asombrada cuando lo\nsupe.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, quizás sí se podría decir eso de la dueña... tal vez. De lo que\nhe escuchado, parece ser una persona bastante rara.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002583",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... Quizás es la fuerte particularidad de cada uno de los miembros del\nclub de arte lo que me hace verla como alguien relativamente normal, pero\nciertamente es algo rara.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh... los miembros del club de arte, eh... No lo niego.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Sí. Cuando te acostumbras a ellos, la gran mayoría de las personas se te hacen\nnormales y sencillas.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002584",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En mi caso siempre trato de pensar bien las cosas, e igualmente termino\ntropezándome en algún momento. Pero tanto la dueña como esa mujer tienen la\ninteligencia y el dinamismo suficiente como para hacer cualquier cosa a la\nperfección.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002585",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabías que la dueña creó una obra inspirada en esa pintura y trató de engañar\na alguien cuando aún estaba en la preparatoria? En conmemoración de eso fue\nque recibió este cuadro de esa mujer.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Engañar a alguien? ¿Es que acaso se robó algún dinero o algo así?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002586",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ni idea. La verdad es que en lo que a eso concierne no conozco muy bien la\nhistoria.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué es que no preguntaste justamente la parte más interesante? ¡Me muero\ntanto por saber que ahora solo podré dormir en las noches!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002587",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Basta con que duermas en las noches, ¿no?!... Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Toritani voltea la cabeza y aparta su mirada a un lado. No sé si es mi\nimaginación, pero luce algo enfurruñada... Esto es raro, eh.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002588",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No tengo muchas ganas de escuchar historias que tengan que ver algo con esa\nmujer.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Parece que la relación entre la directora y Toritani ha estado muy mal desde\nhace un buen tiempo.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002589",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fabricó un jarrón. Esa mujer debería tenerlo ahora. Le dio este cuadro a la\ndueña a cambio de él.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002590",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo que la dueña hizo para fabricar el jarrón fue sencillamente, increíble...\nParece que se tomó sus vacaciones de verano para irse a Francia.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A Francia? ¿Pudo ir sin problema alguno?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002591",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo pudo ir durante las vacaciones de verano, así que parece que contrató a un\nguía para poder aprovechar al máximo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un guía... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="skylimoges",id=8,lv=8,path=":cg/",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500,sync=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002592",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Fue a la ciudad de Limoges.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La meca de la porcelana, eh.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002593",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es. Fue hasta Limoges y llegó incluso a negociar con un taller para\nfabricar el jarrón. Sé que usó un guía, pero igual es increíble lo que\nhizo... Más que admirada, quedé perpleja.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero quedaste admirada por la energía con la que llegó a hacer eso, y también\nte sentiste emocionada al escuchar su historia. ¿Me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002594",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002595",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues no te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002596",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Después de escuchar toda la historia le comenté a la dueña que todo lo que hizo\nhabía sido demasiado elaborado como para una simple broma. Al escuchar eso,\nmusitó que la factura por haber engañado tanto le había salido cara.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La factura, eh...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002597",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y a pesar de eso, disfrutó tanto de su viaje a Francia que se volvió adicta a\nviajar. Recuerdo que entre risas dijo que uno nunca sabe lo que puede ocurrir\nen la vida.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002598",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es lo único que sé respecto a este cuadro. Regresaré ya al trabajo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue una historia realmente divertida. Gracias.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002599",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tienes nada de qué agradecerme. Simplemente te conté porque quería hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=6},
{"text"},
text={
ja={
{
"Toritani se dirige a la mesa de la directora a recoger el café helado. Y\nentonces, la mano con la que trataba de colocar el vaso en la bandeja se\ndetuvo de repente.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Al acercarme y preguntarle, Toritani únicamente dirigió su mirada a la razón\npor la cual se detuvo. Había un paquete envuelto en un pañuelo.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002600",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que olvidó algo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a llevárselo?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0005",head="mak_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0015",head="mak_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002601",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace falta. Si lo necesita, debería venir por él. Y además...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0011",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002602",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Posiblemente lo dejó a propósito.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que fingió olvidarlo a propósito?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0005",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002603",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tratándose de ella seguramente está tramando algo.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"se",id=1,file="se2225"},
{"text"},
text={
vo={
{"vo",file="fem_obs_000006",ch="obs"},
},
ja={
{
name={"???"},
"“Disculpe.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002604",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienvenida... ah, es usted.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Fue la mujer que vino a verse con la directora hace un rato la que entró.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_obs_000007",ch="obs"},
},
ja={
{
name={"???"},
"“Vine a buscar algo que se quedó acá.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002605",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es esto?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_obs_000008",ch="obs"},
},
ja={
{
name={"???"},
"“Sí, muchas gracias. Aunque no es mío.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0006",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002606",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿La directora la envió a buscarlo?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_obs_000009",ch="obs"},
},
ja={
{
name={"???"},
"“Sí, estoy cumpliéndole el mandado.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002607",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"La mujer tomó en sus manos el paquete que estaba sobre la silla.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_obs_000010",ch="obs"},
},
ja={
{
name={"???"},
"“¿Quisiera ver lo que es?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002608",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Por qué yo? No encuentro la razón por la cual debería verlo.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_obs_000011",ch="obs"},
},
ja={
{
name={"???"},
"“Tienes razón. Pero me gustaría que lo viera. Seguramente servirá de algo,\nquizás.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002609",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La mujer desamarró rápidamente el nudo del pañuelo.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002610",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Esto es...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Adentro había una pintura ukiyo-e. Era un dibujo de un paisaje nevado y una\nurraca.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"La estructura era exactamente igual a la de aquella pintura de óleo que tanto\nse asemejaba a la de Monet, y que decora ahora la pared de Quimera.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"La directora debió haber pintado ese cuadro en óleo mientras observaba este\nukiyo-e. O en su defecto, pintó el ukiyo-e mientras observaba aquel cuadro.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Debió haber hecho lo uno o lo otro. De lo contrario, sería imposible que se\nparecieran tanto.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002611",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este seudónimo...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Toritani susurra eso mientras frunce su ceño. El seudónimo que adornaba el\ncuadro era 'Kariyama Seiro'.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este nombre, me parece haberlo visto en algún...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002612",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es el mismo nombre que está en el letrero de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"La mujer le habla sonrientemente a Toritani, quien estaba ahora de brazos\ncruzados y con una expresión complicada en su rostro.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Una característica insignia brilla sobre su pecho. Una balanza, junto a un\ngirasol de 16 pétalos -- Es la chapa de abogado.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_obs_000012",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Es usted la señorita Makoto Toritani, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002613",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es... ¿Por?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"La abogada sonrió con un gesto suave.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_obs_000013",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Hace unos días tuve la oportunidad de ver el Catálogo Uji. Quedé cautivada con\nlo maravillosa de su pieza.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002614",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Unas profundas arrugas se dibujaron fuertemente en la frente de Toritani.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002615",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues no. Para mí, esa creación fue un fracaso.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_obs_000014",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Es usted bastante humilde. Sus tazas de uso cotidiano son extraordinariamente\nbuenas, pero deseo con todo fervor que siga desarrollando su talento en ese\ncampo al igual.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_obs_000015",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Con esto me despido. Con permiso.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"La abogada cargó de nuevo y con mucho cuidado el paquete en el pañuelo y se\nfue.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0006",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002616",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Toritani apretó fuertemente sus puños.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿qué demonios fue eso?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0018",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002617",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Toritani mueve su cabeza a los lados, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Explícamelo de manera que yo entienda, si es que puedes.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002618",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí, te lo diré. Todo lo que sé.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002619",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El catálogo que esa abogada mencionó, es el mismo del cual descubriste hace un\ntiempo mi verdadera identidad... Bueno, quizás sea algo exagerado ponerlo de\nesa manera. En fin, es el catálogo del cual descubriste que yo era Hakushuu\nUsagiko.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah... el catálogo que enviaron por correo aquel día. Si no mal recuerdo, habías\ndicho que era de un negocio de artes antiguas, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002620",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Aparte de piezas de arte antiguo, en ese catálogo también aparecen una gran\ndiversidad de obras que se ganaron el buen visto de aquel hombre. Una de mis\ncreaciones está listada allí.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002621",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero, esa obra jamás debió haber llegado a la luz pública. Tal como lo dije\nhace un momento, para mí esa pieza fue un fracaso.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002622",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y luego... respecto a lo otro...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kariyama Seiro.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002623",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Ese es el seudónimo que estaba escrito en ese ukiyo-e.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El mismo que se encargó del letrero de Quimera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002624",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sabiendo eso deberías poder darte ya la idea de su verdadera identidad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo hay una sola persona con el talento en caligrafía, pintura japonesa y la\nsuficiente cercanía con la dueña que pudo haberle otorgado ese letrero en\nconmemoración de la apertura de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kariyama Seiro es la directora Toritani.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002625",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Respuesta correcta. Mi abuela me contó que cuando esa mujer era aún una niña no\nmostraba esmero por ninguna de sus actividades extracurriculares. Exceptuando\npor, parece, las clases de caligrafía a las que asistía con tanta dedicación.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002626",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo llegó a usar ese seudónimo cuando estaba en la universidad, y por un\nperíodo de tiempo muy corto... Por eso es que no pude conectar rápidamente\nese nombre con esa mujer.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... así que tiene tantas habilidades como tú.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002627",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A las personas como nosotras nos dicen aprendices de todo y maestras de nada.\nAunque bueno, en fin.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0006",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002628",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El problema está en lo que yo no sé. No sé por qué me mostraron esa pintura, ni\ntampoco cuál es la relación entre ese ukiyo-e de la urraca y el cuadro de\nóleo...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay algo que sepas?”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002629",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé nada.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002630",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé nada, pero así como sucede ahora, siempre hay cosas dando marcha a mi\nalrededor sin yo darme cuenta.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002631",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre hay alguien peleando y batallando a mis espaldas. Las intrigas y\nambiciones de muchas personas, y el sentimiento de querer proteger a\nalguien...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Esas fueron las palabras que Toritani llegó a susurrar anteriormente.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002632",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al igual que tú.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh--”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002633",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... En fin, no importa.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"No sé qué pretendió Toritani.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Pero es un hecho que después de mencionarme tan súbitamente en la conversación,\nla atmósfera alrededor no se prestaba para seguir hablando del mismo tema.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_05_3"},
{"text"},
linkback="block_00299",
},
label = {
top={block="block_00000",label=1},
},
}
