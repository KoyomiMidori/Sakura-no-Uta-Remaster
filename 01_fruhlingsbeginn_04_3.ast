},
block_00039={
{"select",label="label01",text="select"},
{"select",label="label02",exp="f.shz=f.shz+1",text="select"},
{"select",name="select01_04_1",mode="sys"},
{"text"},
select={
ja={
"¡Esto es un malentendido!",
"¡Yo no soy ningún homosexual! ¡A mí me gustan las mujeres!",
{"rt2"},
},
},
labelcount=1,
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡T-Te equivocas! ¡Esto es un malentendido!”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"excall",label="join1"},
{"text"},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No es así! ¡Yo no soy ningún homosexual! ¡A mí me gustan las mujeres!”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0013",head="shz_z1b",x=800,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0005",head="shz_z1b",x=800,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_szd_000123",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad? Desde hace un buen rato he estado dudando de si realmente eres\nheterosexual o no. Pareces ser demasiado resistente a la tentación a veces.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso es simplemente porque siempre procuro controlarme a mí mismo!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"excall",label="join1"},
{"text"},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",x=800,lv=4,id=2},
{"fgact",ch="雫",act="うんうん",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",x=800,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_szd_000124",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jeje... No te preocupes. No le diré a nadie. Desde lo más profundo de mi\ncorazón deseo que conserven y cuiden bastante de su relación.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡NO TE PONGAS A PENSAR ESAS COSAAAASS!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Es, espera, Shizuku!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
