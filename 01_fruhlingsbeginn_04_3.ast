astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm011"},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1d0000",face="d0001",head="kei_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"Kei entró a la sala con una pinta algo desordenada, secando su cabello\nalegremente.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mientras estaba en la sala recogiendo la ropa lavada, dirigí mi mirada a Kei,\nquien estaba pasándose la toalla sobre su cabello como un gato limpiándose.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0006",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",time=600,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000777",ch="ked"},
},
ja={
{
name={"Kei"},
"“Rayos, todos ustedes son verdaderamente malvados.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué quieres que hagamos? Esa sesión de dibujo se propuso justamente por el\ntema de la gente que entró al colegio por ti.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0004",head="kei_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000778",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero aun así, ¿por qué se supone que tengo que vestirme de mujer?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, eso me atormenta un poco también. Es peligroso que se reúna un grupo\nde gente cuyo único objetivo sea simplemente verte vestido de mujer.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0009",head="kei_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0003",head="kei_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000779",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya, ¿será que estás preocupado por mi seguridad?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa en lo absoluto tu seguridad, pero si llegaran a aglomerarse ese\nmontón de homosexuales, mi seguridad también estará en peligro.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"quake",mode="mw"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0010",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000780",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Qué malo eres!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque de igual manera, son puros hombres que gustan de verte envuelto en\ntrapos de mujer, seguramente no mostrarán interés por alguien con tanta\nhombría como yo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0005",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000781",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Jaa! ¡Yo tengo mucha más hombría! ¡No me llegas ni a los pies en hombría,\nNaoya!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Observo a Kei. Este Kei que acaba de salir de la ducha parece mucho menos un\nhombre que de usual.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0006",head="kei_z1d",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0010",head="kei_z1d",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1d0000",face="d0005",head="kei_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000782",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Eh, pero qué pasa?! ¡¿Por qué esa risa burlona?! ¡Uwaaan! ¡Qué cruel eres!\n¡¡Naoya!!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es que... con ese cuerpo que tienes...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2d0000",face="d0010",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="いいえ",loop=-1,time=500,lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000783",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaaan, te mataré! ¡Voy a matarte!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡I-Idiota! ¡N-No te me acerques semidesnudo, t-tonto!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No te me montes encima medio desnudo! ¡Eres repugnante!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="圭",act="停止",lv=5,id=9},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0005",head="kei_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0003",head="kei_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000784",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué tengo de repugnante?! ¡Olvida eso, mira nada más mis brazos! ¡Mira este\nbrazo flexionado! No hay ninguna mujer que tenga un brazo así de duro~”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Kei me muestra sus biceps.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0001",head="kei_z2d",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué brazos tienes...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0003",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0002",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000785",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿A que no?! Con esto cambiaste de parecer respecto a mí, ¡¿verdad?! ¡Sí! Yo\nsoy más macho de lo que todos creen.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, todo lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Me arremango la camisa y flexiono mi brazo frente a Kei.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Bueh, mis brazos no son tampoco la gran cosa... pero aun así, son tan gruesos\ncomo las piernas de Kei.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Aun habiendo una diferencia de 30 centímetros de estatura entre los dos... me\nda la impresión de que la diferencia en grosor de nuestros brazos es muy\ngrande...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0009",head="kei_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000786",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?... Q-Qué es... e-esto...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Normalmente así de gruesos se ponen los brazos cuando se flexionan. Los tuyos\nson demasiado delgados, pareces una mujer.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0007",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0005",head="kei_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000787",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eso no es cierto... ¡T-Tus brazos son demasiado gruesos, Naoya! ¡Idiota,\nhumano sobrecargado de hormonas masculinas!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú eres especial...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0010",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0005",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0010",head="kei_z2d",lv=5,id=9},
},
vl03={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0005",head="kei_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000788",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaan. ¡¿Qué pasa?! ¡¿Pero qué pasa?! ¿Vas a enfadarte conmigo ahora? ¡¿Aparte\nde enfadarte vas a criticarme también?! ¡¿Críticas a Kei?! ¡¿Es que ahora\ncomenzaron las críticas hacia Kei?!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2d0000",face="d0010",head="kei_z2d",lv=5,id=9},
{"fgact",ch="圭",act="いいえ",loop=-1,time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000789",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaaan! ¡Te mataré! ¡Te mataré de cualquier manera! ¡Te mataré dos veces, y te\nreviviré tres!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Detente... No sé qué demonios quieres decir...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="圭",act="停止",lv=5,id=9},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1d0000",face="d0009",head="kei_z1d",x=0,lv=4,id=9},
{"ex",time=0,func="wait"},
{"se",file="se9008",vol=60,id=2},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",x=800,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_szd_000121",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La imagen de una alegre familia...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bgm",stop=1,time=500},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0002",head="shz_z1b",x=800,lv=4,id=2},
{"bgm",file="bgm007"},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",x=800,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_szd_000122",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dicen que aún entre hombres deberían procurar usar 'eso' al momento de\n'hacerlo'. Espero que les vaya bien...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Espera! ¡Eh! ¡Shizuku-san!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
