},
block_00052={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡I-Idiota! ¡Trata de entender la situación! ¡Kei, idiota! ¡Shizuku! ¡Esto es\ntodo un malentendido!”",
{"rt2"},
},
},
},
linkback="block_00051",
