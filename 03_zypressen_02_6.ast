astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm110"},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001549",ch="yum"},
},
ja={
{
"El artista de los cerezos dijo eso, luciendo algo aliviado y tranquilo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que ya está listo...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque el tifón se lo llevará todo en unas cuantas horas.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1i0000",face="i0006",head="rna_z1i",x=-345,lv=4,id=5},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001477",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0007",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001478",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No todo!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_yum_001550",ch="yum"},
},
ja={
{
"Hikawa-san gritó eso.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_001551",ch="yum"},
},
ja={
{
"Y entonces, el artista de los cerezos sonrió, mostrando sus dientes.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0005",head="rna_z1i",x=-345,lv=4,id=5},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo este tiempo que pasamos haciendo arte hasta ahora fue divertido.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001479",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Lo fue!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Bien, ya nos divertimos! ¡Todos a sus casas ahora!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="black",id=9,lv=9,alpha=20,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001552",ch="yum"},
},
ja={
{
"Los dos rompieron en carcajadas.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_yum_001553",ch="yum"},
},
ja={
{
"El cielo retumba.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_yum_001554",ch="yum"},
},
ja={
{
"Las nubes corren.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=50,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001555",ch="yum"},
},
ja={
{
"La luna titila incesantemente.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=70,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001556",ch="yum"},
},
ja={
{
"Aquella noche de verano lucía alocadamente divertida,",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=80,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001557",ch="yum"},
},
ja={
{
"pero yo no encontraba forma de seguirle los pasos a ese alocado ritmo,",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_yum_001558",ch="yum"},
},
ja={
{
"ni menos aun reír junto a ellos.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=90,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001559",ch="yum"},
},
ja={
{
"Hikawa-san se ríe, dentro del bosque donde reposaba ahora el dibujo de los\ncerezos.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=100,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001560",ch="yum"},
},
ja={
{
"De una manera que jamás había visto antes.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_yum_001561",ch="yum"},
},
ja={
{
"Esos cerezos son veneno. Del más mortal.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=120,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001562",ch="yum"},
},
ja={
{
"Ni el 'UFT Sunfural S' llega a semejante nivel de letalidad.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=150,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001563",ch="yum"},
},
ja={
{
"Ese potente veneno convirtió su hermosa y melancólica sonrisa en esta\ndeslumbrante que tengo ante mí.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"cgdel",id=-1},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0003",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001480",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Kusanagi-san! ¿Podrías enseñarme a pintar? ¿Podrías ser mi maestro?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=0,lv=4,id=10},
{"fgact",ch="優美",act="うなづく",lv=4,id=10},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x2=345,x=500,lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"se",id=1,file="se0002_z"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Auch! ¡Tú, deja de atacarme a cada rato!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=0,lv=4,id=10},
{"fgact",ch="優美",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001564",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Cállate, solo muérete!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=500,lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, sería de entender que la mocosita esta se molestara, ¿pero por\nqué me golpeas tú?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001565",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Por qué le dices que no?!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=0,lv=4,id=10},
{"fgact",ch="優美",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001566",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Di por qué!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=500,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿no es algo obvio?... Es de locos tomar un discípulo teniendo esta edad.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001567",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡La edad no tiene nada que ver para eso!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehhh... Bien, mocosa, ¿es que de verdad me lo pides en serio?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0005",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001481",ch="rna"},
},
ja={
{
name={"Rina"},
"“No soy ninguna mocosa. Mi nombre es Rina Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=500,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_yum_001568",ch="yum"},
},
ja={
{
"En sus ojos brillaba una fuerte voluntad. En medio de su gentil personalidad,\nHikawa-san escondía también ese carácter firme y resoluto.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=500,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm... ¡Claro, sí, eso! Discípulo se escribe usando el kanji de hermano menor,\n¿no? ¡Eres una mujer, así que no puedes ser mi discípulo! Ese título solo se\nle puede conceder a un hombre.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=0,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001569",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pues entonces escríbelo con el carácter de hermana menor y que sea tu\ndiscípula!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=500,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se trata de eso.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=0,lv=4,id=10},
{"fgact",ch="優美",act="うんうん",size=5,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_yum_001570",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿De qué se trata entonces?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=500,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, me cuesta un poco explicarlo...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0006",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001482",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De qué se trata?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",mode=-1,lv=4,id=10},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x2=500,x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_yum_001571",ch="yum"},
},
ja={
{
"La mirada de Hikawa-san hace callar a Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué se yo. En fin, escriban discípulo con el kanji de hermano o de hermana,\neso no me importa. ¡¡Hagan lo que quieran, pero no voy a enseñarle a nadie a\npintar!!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001483",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No me enseñarás?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001484",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entonces te llamaré 'Onii-chan' a partir de hoy.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001485",ch="rna"},
},
ja={
{
name={"Rina"},
"“Acabas de decir que podíamos hacer lo que quisiéramos.\nAsí que me convertiré en tu hermanita menor.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera un momento, ¿hermanita? Ni siquiera compartimos la misma sangre.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001486",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo único que me importa es ser tu discípula, por eso lo propuse. Nada tiene que\nver si compartimos la misma sangre o no. Es algo más como una condición\nmental. Algo, así como una hermanita mental...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué se supone que es eso?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0003",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001487",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No te gusta, ¿verdad?! Pues si es así...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, qué lata. Déjalo así, está bien. Si quieres ser una hermanita mental, o lo\nque sea que sea eso, pues puedes serlo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001488",ch="rna"},
},
ja={
{
name={"Rina"},
"“U-Uhh... Eres terco...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Terco, yo?\nVamos, intenta llamarme así de nuevo. Llámame 'Onii-chan', si es que puedes.\nO será que no eres capaz de hacerlo, ¿ah?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001489",ch="rna"},
},
ja={
{
name={"Rina"},
"“Onii-chan♪.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Pero q-q--?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo dijo! ¡Se atrevió a llamarme así!\n¡Y con toda naturalidad!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001490",ch="rna"},
},
ja={
{
name={"Rina"},
"“Agregando a eso, Onii-chan, quisiera darte las gracias por todo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Gracias por qué?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001491",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sabías de mi enfermedad, ¿verdad? Tenía miedo de acceder a tomar la cirugía que\nnecesito, y preferí hundirme en el delirio, creyéndome capaz de aceptar la\nmuerte y eso...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001492",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sé que por eso decidiste hacer esta obra en conjunto conmigo... Este dibujo,\nque a su vez es una especie de carta dirigida a mí.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001572",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿A qué viene ese repentino tono amenazador? No vuelvas a tratar de\ngolpearme, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_001573",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y por qué le respondes de esa manera? Te estás haciendo el tonto, me imagino.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hacerme el tonto? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001574",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que... ¿Es que acaso no fue por saber de la enfermedad de Rina que\nterminaste este dibujo?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Cómo se supone que voy a saber eso? Nadie me ha contado nada al\nrespecto, además.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001575",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“L-Lo dijiste, ¿no? ¡Habías dicho que la temática de su dibujo era de sumisión a\nla muerte, y todo ese montón de palabrería que no entendí bien!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, uno a esta edad suele atravesar por la etapa chuuni, ¿me entiendes,\nno? Solo lo decía por decir...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001576",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No lo puedo creer. Y-Yo... Pensé que lo habías hecho sabiéndolo todo ya,\nviendo cómo viniste y decías esto, y eso, y...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Para nada, no tenía ni idea de que todo eso le estaba pasando! ¿Y bien,\nentonces la mocosita esta sufre de una enfermedad grave? ¿Es en serio? ¿Eh,\nestás bien?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001577",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Puedes guardarte tus falsas palabras de preocupación!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡T-Te dije ya que dejes la violencia!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="優美",mode=-1,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... Te llamabas Hikawa, ¿no? Para sufrir de una enfermedad tan grave, creas\ndibujos con bastante fuerza.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001493",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Es, que no quería dejarme vencer...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x=345,lv=4,id=9},
{"fgact",ch="直哉",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Aunque a fin de cuentas, es un excelente dibujo. La verdad es que al\nverlo sentí que en cualquier momento me hundiría dentro de él.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001494",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? A mí no me pareció en lo absoluto... Aunque, sentí que de alguna\nforma estaba encaminado a aquello que yo quería mostrar. Con rectitud, sin\ndesviarse a ninguna parte.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es así que los artistas intentan mostrar sus obras. Aunque no sepan qué hacer,\nintentar hacer ver que sí saben.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aunque en realidad no tengan la habilidad para hacerlo... pintan, y crean, de\nsemejante manera que ocultan eso por completo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que avanzan sin parar. Con fuerza. Sin perder la fe en sus\nexpresiones, en su arte. Eso es lo que significa ser un pintor.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001495",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque no me imaginé que no supieras nada de mi enfermedad...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0015",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001496",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me juraba que ese dibujo era un mensaje reclamándome que no huyera. De ella...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quizás no estás tan equivocada.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sabía que estabas enferma. Pero no miento cuando digo que pensé en que tu\ndibujo era muy deprimente. No me gustaba eso, quería volverlo un dibujo más\nalegre.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0003",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que hice un dibujo de mi parte, uno lleno de vida.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001497",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las pinturas sombrías no son malas, pero no van contigo.\nFue por eso que lo hice de esta forma.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No está mal, eh?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001498",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es excelente.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="black",path=":bg/"},
{"bg",file="ev_uni_c55_01",time=2000,path=":ev/ev_uni_c55/",set="ev_uni_c55"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001578",ch="yum"},
},
ja={
{
"Hikawa-san volvió a contemplar el dibujo del domo.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_yum_001579",ch="yum"},
},
ja={
{
"Era un árbol de cerezos, atravesando el cielo como si fuera un ciprés.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_yum_001580",ch="yum"},
},
ja={
{
"Magia hecha de blanco.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_yum_001581",ch="yum"},
},
ja={
{
"Lo que hasta hace poco eran llamas negras se transformó -solo cambiando la\nexpresión usada- en un suave torrente rosado dirigido al cielo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_yum_001582",ch="yum"},
},
ja={
{
"Y,",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_yum_001583",ch="yum"},
},
ja={
{
"los pétalos esparcidos alrededor del domo,",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_yum_001584",ch="yum"},
},
ja={
{
"eran como estrellas en el firmamento.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-680,lv=4,id=1,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=-210,lv=4,id=7,sync=0},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo me voy ya. Deberían irse a casa ustedes también. Sobre todo tú, que estás\nfrágil de salud.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tú, mocosa, si sigues blandiendo ese cuchillo de esa manera vas a acabar\nmatando a alguien, y te va a coger la policía.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=-210,lv=4,id=7},
{"fgact",ch="優美",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001585",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Cállate y vete ya!\n¡Fui una idiota creyendo que hacías esto por Hikawa-san!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=570,lv=4,id=4},
{"fgact",ch="直哉",act="びっくり",size=5,lv=4,id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me gusta que se hagan falsas expectativas de mí!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=-210,lv=4,id=7},
{"fgact",ch="優美",act="うんうん",size=5,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001586",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Muérete!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muérete, muérete, ¡¿Es que no sabes decir nada más?! ¡¿O es que acaso eres\nintegrante de los Shine Shine Dan?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=-210,lv=4,id=7},
{"fgact",ch="優美",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001587",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ni te atrevas a venir de nuevo!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni ustedes tampoco.\nDéjense de salir a estas altas horas de la noche, mocosas.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-680,lv=4,id=1},
{"fgact",ch="里奈",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001499",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="直哉",mx=40,mode=-1,lv=4,id=4},
{"se",file="se9004",id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001588",ch="yum"},
},
ja={
{
"Naoya Kusanagi.\nEl artista de los cerezos se fue del domo.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_yum_001589",ch="yum"},
},
ja={
{
"Dejando consigo una excepcional obra que en pocas horas desaparecería.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="里奈",speed=500,mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x2=-680,x=-210,lv=4,id=1},
{"fg",ch="優美",speed=500,mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x2=-210,x=210,lv=4,id=7},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001500",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que sabías de mi enfermedad... Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001590",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Perdón. Vi el nombre de tu medicina, y entonces...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-210,lv=4,id=1},
{"fgact",ch="里奈",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001501",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entiendo. Disculpa que no te haya explicado todo antes, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0010",head="yum_z1i",x=210,lv=4,id=7},
{"fgact",ch="優美",act="いいえ",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001591",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0011",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001502",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me operaré al terminar el verano...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001503",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tenía miedo. Solo eso...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001504",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso es que intenté prepararme para aceptar la muerte, a como de cualquier\nmanera.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001505",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pensé que, tal vez, si no me importara morir, entonces la operación dejaría de\ndarme miedo...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001506",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero... no puedo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001507",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero operarme y curarme. Quiero poder dibujar a plena luz del sol.\nAhora que presencié ese dibujo, yo...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-210,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001508",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero vivir...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001592",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Te entiendo.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0002",head="yum_z1i",x=210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001593",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Creo que eso es lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="white",id=9,lv=9,alpha=10,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001594",ch="yum"},
},
ja={
{
"Ya no siento nada revolviéndose dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_001595",ch="yum"},
},
ja={
{
"El hedor a muerte desapareció.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=20,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001596",ch="yum"},
},
ja={
{
"La sombra de la Muerte ya no le susurra más.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_001597",ch="yum"},
},
ja={
{
"Ya no había en ella esa belleza tan similar a la de la luna...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_001598",ch="yum"},
},
ja={
{
"¿Qué hay del final de las historias que me contó?",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=30,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001599",ch="yum"},
},
ja={
{
"¿Por qué el escorpión se habrá convertido en una llama roja?",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_yum_001600",ch="yum"},
},
ja={
{
"¿Por qué el chotacabras se habrá convertido en una llama azul?",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=40,time=2000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001601",ch="yum"},
},
ja={
{
"Cometieron el pecado de devorarse a otros, y por eso se volvieron llamas, y\nluego estrellas.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_yum_001602",ch="yum"},
},
ja={
{
"¿Qué hay de mí entonces?",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001603",ch="yum"},
},
ja={
{
"¿Por qué me enamoré de Hikawa-san?",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=45,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001604",ch="yum"},
},
ja={
{
"¿Es que acaso no tuve la opción de enamorarme de alguien del sexo opuesto, como\nlo hace la gente normal?",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=50,time=3000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001605",ch="yum"},
},
ja={
{
"Pero la sola posibilidad de enamorarme de alguien más nunca existió para mí. Y\nme enamoré de la chica más débil, frágil y tierna de la manada. De\nHikawa-san.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_001606",ch="yum"},
},
ja={
{
"Este es el castigo que debo pagar por mi pecado.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_yum_001607",ch="yum"},
},
ja={
{
"Y por eso estoy aquí.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=55,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001608",ch="yum"},
},
ja={
{
"El escorpión ardió en llamas rojas y se volvió una hermosa estrella.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"cgdel",id=-1},
{"bg",file="white",id=9,lv=9,alpha=60,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001609",ch="yum"},
},
ja={
{
"El chotacabras ardió en brillantes llamas azules y se volvió, también, una\nhermosa estrella.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_yum_001610",ch="yum"},
},
ja={
{
"Pero yo no puedo, ni siquiera, volverme una estrella más.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_001611",ch="yum"},
},
ja={
{
"Soy como un gusano incapaz de salir de su huevo.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_001612",ch="yum"},
},
ja={
{
"Y a pesar de todo...",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_001613",ch="yum"},
},
ja={
{
"(También se ve linda sonriendo así...)",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_yum_001614",ch="yum"},
},
ja={
{
"Eso era lo único que tenía en la cabeza en ese momento.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_001615",ch="yum"},
},
ja={
{
"En la pared del domo estaba el dibujo del bosque de cerezos resplandeciente.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_yum_001616",ch="yum"},
},
ja={
{
"Y la sonrisa que ella mostró frente a ese dibujo...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_001617",ch="yum"},
},
ja={
{
"No era la misma Hikawa-san que yo conocía.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_yum_001618",ch="yum"},
},
ja={
{
"La Hikawa-san que brillaba con una luz azul como la luna no está ya.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_001619",ch="yum"},
},
ja={
{
"Ahora está la Hikawa-san que brilla en el bosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_001620",ch="yum"},
},
ja={
{
"La nieve de primavera.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_001621",ch="yum"},
},
ja={
{
"Envuelta en la nieve rosada, su sonrisa destella.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_yum_001622",ch="yum"},
},
ja={
{
"Quizás yo no pueda brillar, pero no me importa. Me basta con que ella sí para\nyo ser feliz...",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_001623",ch="yum"},
},
ja={
{
"Y por eso, le dije...",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0003",head="yum_z1i",x=210,lv=4,id=7},
{"fgact",ch="優美",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_001624",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No te dejes vencer, Rina!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0003",head="rna_z1i",x=-210,lv=4,id=1},
{"fgact",ch="里奈",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_001509",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Gracias!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"cgdel",id=-1},
{"bg",file="white",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001625",ch="yum"},
},
ja={
{
"El que se enamora primero pierde.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_001626",ch="yum"},
},
ja={
{
"A pesar de todo, me gusta ella.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_yum_001627",ch="yum"},
},
ja={
{
"Simplemente me encanta.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_yum_001628",ch="yum"},
},
ja={
{
"Por eso es que esto no es ningún castigo.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_yum_001629",ch="yum"},
},
ja={
{
"Y es que, todavía puedo estar con ella...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=2000},
{"msgoff"},
{"ex",time=500,func="wait"},
{"bg",file="ev_txt_c15_01",time=2000,path=":ev/ev_txt_c15/",set="ev_txt_c15"},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　――Los graffitis sin terminar――",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_001630",ch="yum"},
},
ja={
{
"Después de ese día, investigué acerca del artista de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_yum_001631",ch="yum"},
},
ja={
{
"Investigué, no solo sus obras, sino también los graffitis que había pintado\nafuera.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_001632",ch="yum"},
},
ja={
{
"Por alguna extraña razón, ninguno había sido terminado. Todos habían sido\nabandonados, sin culminar.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_yum_001633",ch="yum"},
},
ja={
{
"¿Por qué fue aquel mural del domo el único por el cual el artista de los\ncerezos se preocupó por terminar?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_yum_001634",ch="yum"},
},
ja={
{
"Esa pregunta llegó a provocarme algo de curiosidad.\nPero todos los graffitis fueron borrados antes de que pudiera dar con la respuesta.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_txt_c14_01",time=2000,path=":ev/ev_txt_c14/",set="ev_txt_c14"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　――Y fue así como preferí a las damiselas――",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_001635",ch="yum"},
},
ja={
{
"Ese día, cuando estaba, como de costumbre, mascando chicle sola en el patio\ntrasero, un grupo de compañeros se juntaron a mi alrededor.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_yum_001636",ch="yum"},
},
ja={
{
"Y entonces, uno de ellos dijo lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_okz_000006",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Recuerdas lo que dijimos de desnudar a Hikawa? Quería hablarte de eso--”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_yum_001637",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No voy a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_okz_000007",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_yum_001638",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ni tampoco voy a dejar que lo hagas!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"se",id=1,file="se_punch"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001639",ch="yum"},
},
ja={
{
"Me abalancé a golpearlo.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_001640",ch="yum"},
},
ja={
{
"No sé por qué.\nLo más seguro es que solo estaba irritada.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"se",id=1,file="se_punch_rush"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001641",ch="yum"},
},
ja={
{
"Los otros muchachos corrieron a unirse a la pelea.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_001642",ch="yum"},
},
ja={
{
"Los iracundos gritos rompen mis tímpanos.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_001643",ch="yum"},
},
ja={
{
"No sé si me están golpeando, o si soy yo la que está golpeando.\nProbablemente las dos,\npero mi cuerpo ardía y no sabía nada.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_yum_001644",ch="yum"},
},
ja={
{
"Mi cuerpo se va calentando cada vez más.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_001645",ch="yum"},
},
ja={
{
"¿Si sigo calentándome podría ser llamas y una estrella?\nJusto cuando esa absurda idea se cruzó por mi mente--",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_yum_001646",ch="yum"},
},
ja={
{
"Alguien dijo 'desnúdenla'.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_001647",ch="yum"},
},
ja={
{
"Esas palabras me despojaron, en un instante, de todo mi calor corporal.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"se",file="se0897s",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001648",ch="yum"},
},
ja={
{
"Manos y más manos se acercaban de todas las direcciones,\nintentando quitarme la ropa.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_001649",ch="yum"},
},
ja={
{
"Traté de tomar el cuchillo,\npero me habían quitado ya el pantalón,\ny no podía alcanzar las cosas en mi bolsillo.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_yum_001650",ch="yum"},
},
ja={
{
"Grité, pero ni siquiera podía escuchar mi propia voz.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_yum_001651",ch="yum"},
},
ja={
{
"Todas las miradas se posaron sobre mí.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_yum_001652",ch="yum"},
},
ja={
{
"No sabía que una mirada pudiera ser algo tan violento.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_yum_001653",ch="yum"},
},
ja={
{
"Así es el karma, pensé.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_001654",ch="yum"},
},
ja={
{
"Probablemente terminen desnudándome por completo, sin poder volverme llamas\ncomo lo hizo el escorpión o el chotacabras, y expondré mi cuerpo desnudo como\ninsecto de prueba.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_yum_001655",ch="yum"},
},
ja={
{
"Me agarrarán las manos y los pies, me crucificarán,\ny me expondrán a los ojos de todos.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_yum_001656",ch="yum"},
},
ja={
{
"Por alguna razón, me acordé en ese momento de cómo las ranas son diseccionadas,\ny la forma en que se les abre las piernas para hacerlo.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_yum_001657",ch="yum"},
},
ja={
{
"Este es, realmente, el final más apropiado para un gusano como yo.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_yum_001658",ch="yum"},
},
ja={
{
"Saqué la poca fuerza que me quedaba y lancé un último grito.\nY entonces, por alguna razón, esta vez sí pude escucharme muy bien.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_001659",ch="yum"},
},
ja={
{
"Ya no se escuchan los enfadados gritos.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_yum_001660",ch="yum"},
},
ja={
{
"Al darme cuenta,\nlas miradas que hasta hace poco me estaban penetrando,\nestaban dirigidas ahora en otra dirección.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_001661",ch="yum"},
},
ja={
{
"Y allí estaba parado un muchacho.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_okz_000008",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¡No me jodan! ¡Alejen sus manos de Kawachino, desgraciados!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_001662",ch="yum"},
},
ja={
{
"Gritando.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_yum_001663",ch="yum"},
},
ja={
{
"En su mano estaba empuñado un cuchillo manchado con sangre.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_001664",ch="yum"},
},
ja={
{
"No pude entender de inmediato lo que había sucedido.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_yum_001665",ch="yum"},
},
ja={
{
"Lo cierto es que estaba el muchacho llevando mi cuchillo, uno de los hombres\ntumbado sobre el suelo, y todos -incluyéndome a mí- observando fijamente la\nescena.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_001666",ch="yum"},
},
ja={
{
"Era la primera vez que veía mi cuchillo manchado de sangre.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_yum_001667",ch="yum"},
},
ja={
{
"No recuerdo muy bien lo que sucedió después.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_001668",ch="yum"},
},
ja={
{
"Uno de los muchachos sufrió una herida de 10 puntos,",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_yum_001669",ch="yum"},
},
ja={
{
"mientras que otro fue suspendido por un buen tiempo del colegio.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_001670",ch="yum"},
},
ja={
{
"En mi caso, nada me sucedió.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_uni_c08_01",time=2000,path=":ev/ev_uni_c08/",set="ev_uni_c08"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001671",ch="yum"},
},
ja={
{
"Los años pasaron.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_001672",ch="yum"},
},
ja={
{
"Un buen tiempo pasó desde aquel suceso.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_yum_001673",ch="yum"},
},
ja={
{
"Los hombres, que para entonces eran más débiles que yo, me sobrepasaron en\naltura, y sus cuerpos se volvieron duros y musculosos, como si de otra\nespecie de ser vivo se tratara.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_001674",ch="yum"},
},
ja={
{
"Habiendo nacido antes que ellos, y habiéndome desarrollado más rápido, mi\ncuerpo era entonces superior a los suyos. Pero ahora era solo una chica más.\nUna criatura débil.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_yum_001675",ch="yum"},
},
ja={
{
"Aun si intentara pelear con alguno de ellos, no tendría forma de ganarles.\nAunque, ya para este momento las golpizas con ellos se habían acabado.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_yum_001676",ch="yum"},
},
ja={
{
"Todavía me trataban como antes, pero ahora no como un amigo hombre más, sino\ncomo una mujer.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_yum_001677",ch="yum"},
},
ja={
{
"Y es que mi cuerpo evolucionó también, aunque de una manera totalmente distinta\na la de ellos.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_yum_001678",ch="yum"},
},
ja={
{
"Había llegado el día de la graduación.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_yum_001679",ch="yum"},
},
ja={
{
"Y un muchacho confesó sus sentimientos por mí.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="man_okz_000009",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Kawachino, todo este tiempo, yo...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_yum_001680",ch="yum"},
},
ja={
{
"No se sintió nada mal.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_yum_001681",ch="yum"},
},
ja={
{
"Pero yo...",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_yum_001682",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me das ganas de vomitar.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_yum_001683",ch="yum"},
},
ja={
{
"Respondí eso, riéndome.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_yum_001684",ch="yum"},
},
ja={
{
"El muchacho se me quedó viendo, con su cara algo retorcida.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_yum_001685",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, siempre has sido mi amigo. Y quiero que lo sigas siendo...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_yum_001686",ch="yum"},
},
ja={
{
"Conozco el nombre de este muchacho.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_yum_001687",ch="yum"},
},
ja={
{
"Sabía que siempre ha estado enamorado de mí.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_yum_001688",ch="yum"},
},
ja={
{
"Y también, que fue suspendido del colegio por haberme protegido aquel día.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_yum_001689",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo siento, pero me gustan las chicas. Es así desde hace bastante tiempo, y eso\nno cambiará...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_yum_001690",ch="yum"},
},
ja={
{
"El muchacho respondió 'lo sé' mientras lloraba.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_yum_001691",ch="yum"},
},
ja={
{
"Ya se había dado cuenta, desde un principio, que Rina me gustaba.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_yum_001692",ch="yum"},
},
ja={
{
"Y por eso quiso humillarla frente a todos.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_yum_001693",ch="yum"},
},
ja={
{
"Pero ya vieron lo que sucedió.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_yum_001694",ch="yum"},
},
ja={
{
"Me atacaron. Intentó defenderme, y en eso terminó hiriendo a alguien.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_yum_001695",ch="yum"},
},
ja={
{
"Hay un hombre que fue capaz de enamorarse de una mujer como yo.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_yum_001696",ch="yum"},
},
ja={
{
"Verdaderamente me da pena por él. Pero no se puede hacer mucho.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_001697",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hay chicas mucho mejores que yo. Olvídate de mí.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="man_okz_000010",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Claro que no, idiota. ¿De verdad crees que hay alguien mejor que tú?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_yum_001698",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo sé.\nPero no puedo verte como algo más que un amigo.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_yum_001699",ch="yum"},
},
ja={
{
"El muchacho bajó sus hombros, susurrando solo 'Maldita sea, maldita sea'.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_yum_001700",ch="yum"},
},
ja={
{
"Él sabía muy bien cómo terminaría todo, aun antes de decir todo lo que tenía\nque decirme.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_001701",ch="yum"},
},
ja={
{
"Las personas no pueden evitar enamorarse, aun así sepan de antemano el\ndesenlace que tomarán las cosas.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_yum_001702",ch="yum"},
},
ja={
{
"Así se trate de un amor no correspondido, no pueden contener sus sentimientos.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_001703",ch="yum"},
},
ja={
{
"Eso lo sé muy bien.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_yum_001704",ch="yum"},
},
ja={
{
"Escuché una voz a mis espaldas.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_001705",ch="yum"},
},
ja={
{
"Una muchacha vino corriendo, huyendo del bullicio de un montón de gente.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_rna_001510",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Yuumi, vámonos! ¡Comamos algo de vuelta a casa!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_yum_001706",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, vale...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_yum_001707",ch="yum"},
},
ja={
{
"Me pareció escuchar a las muchachas alrededor de Rina decir que era injusto que\nsiempre me la llevara conmigo.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_yum_001708",ch="yum"},
},
ja={
{
"¿Injusto? No me hagan reír. El afecto que puedan tener ustedes por ella no\ntiene comparación alguna con el amor que le tengo.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_yum_001709",ch="yum"},
},
ja={
{
"Ese día de primavera me gradué.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_yum_001710",ch="yum"},
},
ja={
{
"Con cerezos de verdad floreciendo por encima de nosotras.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_001711",ch="yum"},
},
ja={
{
"Rina Hikawa me sonríe, tan radiante como siempre.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_yum_001712",ch="yum"},
},
ja={
{
"Y yo, me quedo a su lado.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bgm",stop=1,time=2000},
{"bg",file="ev_txt_c16_01",time=2000,path=":ev/ev_txt_c16/",set="ev_txt_c16"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　　――Fin――",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_02_7"},
{"text"},
linkback="block_00253",
},
label = {
top={block="block_00000",label=1},
},
}
