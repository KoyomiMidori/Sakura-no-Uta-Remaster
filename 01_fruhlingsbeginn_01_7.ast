astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm007"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg055e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Por ahora, nos dirigimos a la plaza central, donde estaba el Anfiteatro en el\ncual se reúnen normalmente muchos alumnos después de clases.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"... Por supuesto, mientras mantenía una distancia fija de Kei.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0009",head="kei_z1c",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000513",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya... Estás tomando demasiada distancia respecto a mí... De verdad que no\ntienes ni un poquito de compasión.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a decir eso ahora? No pienso otorgarte ni un poquito de mi compasión...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000514",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... Naoya, realmente eres estricto conmigo...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Ya habían varias personas de los otros clubes en la plaza frente a la iglesia,\niniciándose de una vez la guerra para atraer a nuevos integrantes, siendo los\nnuevos de primer año las presas principales.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Se necesita bastante valor para unirse a esta guerra de búsqueda de nuevos\nintegrantes bajo estas condiciones tan severas...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Por supuesto, no puedo tirar los folletos al pote de basura y huir como si\nnada.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Soltamos un ligero suspiro y decidimos apostarnos en un lugar cercano a la\nentrada de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_a16_01",path=":ev/ev_com_a16/",set="ev_com_a16"},
{"bgm",file="bgm014"},
{"text"},
text={
vo={
{"vo",file="man_ked_000515",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jaa... Bien, repartamos estos folletos de una vez para irnos rápido.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, modelo estrella.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"mwact",act="うんうん",time=400},
{"text"},
text={
vo={
{"vo",file="man_ked_000516",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, sí... Ya realmente siento que no me importa nada.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_ked_000517",ch="ked"},
},
ja={
{
name={"Kei"},
"“Demonios... Makoto debería encargarse de hacer esto ella.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿por qué ella no lo hace?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_ked_000518",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo también le reclamé eso, y entonces me dijo 'Siempre hago lo mismo en el\ntrabajo así que el nivel de rareza de mis gestos es bajo y no tiene valor\npara los demás'. ¿No te parece absurdo? Ni que el colegio estuviera repleto\nde clientes habituales de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es una excusa sin sentido alguno, eh.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Aún diciendo eso, seguramente la verdad es que está abarrotada con las labores\nburocráticas que implica haberse vuelto la nueva jefa del club.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Dijo que no había peligro alguno de que cerraran el club, pero es imposible que\npermanezca tan despreocupada teniendo solo dos miembros, incluyéndola a ella.\nSeguramente está esforzándose bastante en las sombras, sin que nadie se dé\ncuenta.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Bueh, Makoto Toritani es ese tipo de persona.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Al ver a mi alrededor, la gran mayoría de los clubes estaban entregándole los\nfolletos a los alumnos que caminaban por las cercanías, casi a la fuerza.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Kei estaba haciendo lo mismo, extendiéndole los folletos a todo aquel alumno\nque pasara frente a sus ojos. Firmemente, como si hubiera perdido la pena.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_ked_000519",ch="ked"},
},
ja={
{
name={"Kei"},
"“Club de arte, deberías entrar.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Las personas que eran ofrecidas los folletos tampoco podían rechazarlos,\nviniendo de una 'chica' tan hermosa.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"No solo los de primer año, sino también los estudiantes de segundo y tercer año\nrecibían felizmente los folletos de Kei.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Yo también me pongo a repartir folletos.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, para hacer brillar aún más tus maravillosos ojos es necesario darle un\nservicio estético a tu mente.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría dibujar juntos un plan futuro de amor en el lienzo? Hagamos una\nobra única en el mundo con la pintura de nuestros sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_ked_000520",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-Naoya, estás usando esas mismas líneas de las cuales tanto te burlaste...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Esto? Si de verdad puedo reunir a seguidoras mías con esto, entonces no\nme importa para nada entonar este vanidoso hechizo.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_ked_000521",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Hechizo?...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"se",id=1,file="se0728"},
{"text"},
text={
ja={
{
"Un viento un tanto fuerte trae hacia acá los pétalos de los árboles de cerezo\nque florecen en las esquinas del jardín del colegio.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"El viento se lleva también hacia arriba las flores de cerezo que estaban en el\nsuelo, tiñendo los rincones de mi vista con varios puntos rosados.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="ev_com_a16_02",path=":ev/ev_com_a16/",set="ev_com_a16"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000522",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Wa, wawah, mi falda!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Justo al mismo tiempo que ese viento que se cruzaba, la modelo estrella sostuvo\nel borde de su falda.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_com_a16_03",sync=0,face=1,time=400,path=":ev/ev_com_a16/",set="ev_com_a16"},
{"text"},
text={
vo={
{"vo",file="man_ked_000523",ch="ked"},
},
ja={
{
name={"Kei"},
"“Auh~, es increíble como pueden pasar sus días llevando esto encima~ Las mujeres\nson realmente heroicas, ¿verdad, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya llevas un buen rato haciendo eso... Espera, no me digas que debajo\ntambién...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_a16_01",sync=0,face=1,time=400,path=":ev/ev_com_a16/",set="ev_com_a16"},
{"text"},
text={
vo={
{"vo",file="man_ked_000524",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Qué pasa, Naoya? ¿Te llaman la atención mis boxers?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajaja... Te voy a matar, imbécil...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"――Fue en ese momento, mientras estábamos teniendo esa triste conversación.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000094",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"La plaza donde revoloteaban las flores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Una llamativa cabellera vuela en medio de los pétalos.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg055e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Rin Misakura apareció de repente dentro de la plaza repleta de gente.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, juraba que estabas aún rodeada por tus seguidores.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000095",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No son seguidores. Esa manera de llamarlos es muy descortés. Simplemente son\namables conmigo por ser nueva.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No, no, eso no es más que una amabilidad con intenciones escondidas.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué andas haciendo, Rin?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000096",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estuve explorando un poco el interior del colegio. El colegio Yumihari tiene\nmuchas estructuras arquitectónicas bastante raras.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. ¿Te interesa la arquitectura?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000097",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es tanto interés, pero hay bastantes cosas que me llaman la atención, así\nque...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cosas que te llaman la atención? ¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000098",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, por ejemplo, la capilla.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, la capilla. Ciertamente, es raro ver colegios que tengan capilla.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Aunque me parece que es más raro el hecho de que haya un anfiteatro...",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000099",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quedé cautivada al ver lo diferentes que son el diseño exterior e interior de\nesa capilla.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo diferente del diseño exterior e interior? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000100",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, lo siento. Simplemente es mi opinión subjetiva. No tengo nada de\ncultura en lo que concierne al arte, así que, probablemente, simplemente me\npareció rara. ¿Y qué estás haciendo tú, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como lo puedes ver... O eso quisiera decir, pero... *ejem*.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000101",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0210",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para hacer brillar aún más tus maravillosos ojos es necesario darle un servicio\nestético a tu mente.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría dibujar juntos un plan futuro de amor en el lienzo? Hagamos una\nobra única en el mundo con la pintura de nuestros sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0210",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000102",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Eeehh.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0210",face="a0014",head="rin_z1a",x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000525",ch="ked"},
},
ja={
{
name={"Kei"},
"“Rin-chan quedó repugnada...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="icon",lv=4,id=9,icon="icon03z1",x=50,y=-550},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000103",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fuwaaan... C-Con todo gusto...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000526",ch="ked"},
},
ja={
{
name={"Kei"},
"“Espera, ¿quedaste cautivada? ¡¿T-Te gustó eso?!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno, ando haciendo esa clase de idioteces en este momento. Vestido de esta\nmanera.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000104",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero te ves bastante apuesto con ese esmoquin, Kusanagi-kun. ¡Personalmente,\nsentí como si me hubiera ganado un premio con tus palabras! ¡Mi corazón se\nsobresaltó!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Me alegra que me digas eso, aunque solo sea un cumplido vacío.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000527",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué bien, ¿verdad, Naoya? ¡Te dijeron que te ves apuesto!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0008",head="rin_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000105",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿Me permites un momento?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0012",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000528",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0004",head="rin_z1b",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000106",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gusto en conocerte. Me llamo Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000529",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puh...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000530",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿E-En conocerme?!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0008",head="rin_z1d",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000107",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ehm... ¿Me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, por supuesto que no, esta es la modelo estrella del club de arte,\nKeiko Natsume.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000531",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0013",head="rin_z1d",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0012",head="rin_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000108",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Keiko Natsume-san? ¿Eh? Eso significa que... Esto, será posible que...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000532",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡N-No, te equivocas! ¡No es cierto!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000109",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eres la hermanita de Kei Natsume-san?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0010",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000533",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Vaya que te diste cuenta, Rin! ¡Así es, es la hermanita del Kei Natsume que\nconociste en la mañana!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000534",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡N-Naoya! ¡¿Q-Qué demonios estás--?!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0004",head="rin_z1d",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000110",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Realmente me pareció que Keiko-san es idéntica a su hermano.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0021",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000535",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Nyaaah! ¡¡¿Por qué estás diciendo eso?!!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"A manera de interrumpir a Kei, antes de que comenzara a dar excusas, le extendí\nun folleto a Rin.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llévate uno. Quizás llegue a ser de utilidad para tu vida en algún momento,\nRin.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000111",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, un folleto. Gracias, lo guardaré con bastante cuidado.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguramente el que hizo estos folletos se alegraría de escuchar tus palabras.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000112",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000536",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No! A-Antes que nada, Rin-chan... ¡Mugyuh! ¡Mugyuhguh!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Me paro frente a Kei, justo cuando trataba de explicarlo todo, echo mi mano\nhacia atrás y le aplico un clawhold sobre la cara, de manera que pudiera\ntaparle la boca sin que Rin se diera cuenta.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",file="se3130",id=1},
{"fg",ch="圭",mx=1280,mode=-1,lv=4,id=6},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",x2=-345,x=0,lv=4,id=9},
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_ked_000537",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Muh, mu~mu~mu~!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, tenemos que repartir esto ahora, así que nos vamos ya.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",x=0,lv=4,id=9},
},
vl02={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000113",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo siento por quitarles su tiempo... Aún no he terminado de explorar el\ncolegio, así que me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Al bajar la cabeza y hacer una reverencia, Rin desapareció entre el montón de\ngente, folleto en mano.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="稟",sync=1,mx=40,mode=-1,lv=4,id=9},
{"fg",mode=-2},
{"se",stop=1,id=1,time=500},
{"cgact",stage="bg055",act="いいえ"},
{"se",file="se3130",id=2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000538",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡N-Naoya, maldito!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000539",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¡¿Cómo que qué pasa?!! ¡Rin-chan se fue sin haber aclarado el malentendido!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh... ¿Entonces quizás hubiera sido mejor decirle la verdad?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei Natsume es un pervertido que le encanta travestirse. Si no lleva una falda\nencima no puede calmarse... ¿Debí haberle dicho eso?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000540",ch="ked"},
},
ja={
{
name={"Kei"},
"“Realmente eres bien cruel... Aún sabiendo que no llevo estas fachas por querer\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera, si apenas en la segunda ocasión que se ven Rin llegara a\ndescubrirte con ropa de mujer, no cabe duda alguna de que pensará que eres un\ndepravado. ¿De verdad no te importa eso?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000541",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... Eso no me gustaría para nadaaa.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, qué más da. Repartamos los folletos que quedan rápido, o no podremos\nirnos.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000542",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000001",ch="yum"},
},
ja={
{
name={"???"},
"“¿Podrías darme un folleto?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_a17_01",path=":ev/ev_com_a17/",set="ev_com_a17"},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
"Una muchacha se paró y extendió su mano. Parecía ser una nueva estudiante, pero\ntenía un aire silencioso, que por alguna razón se me hacía como una actitud\nprepotente.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, para hacer brillar aún más tus maravillosos ojos es necesario darle un\nservicio estético a tu mente.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría dibujar juntos un plan futuro de amor en el lienzo? Hagamos una\nobra única en el mundo con la pintura de nuestros sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"se",file="se2497",id=1},
{"bg",file="ev_com_a17_02",path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000002",ch="yum"},
},
ja={
{
name={"???"},
"“... ¿Estás tratando de acosarme sexualmente?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es ningún acoso sexual.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_000003",ch="yum"},
},
ja={
{
name={"???"},
"“Entonces... ¿Qué se supone que es eso?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"La muchacha a la cual le había dado el folleto me ve con una cara perpleja, en\ntotal sospecha.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, ahora que me preguntas eso...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_yum_000004",ch="yum"},
},
ja={
{
name={"???"},
"“No hagas cosas sin sentido. Es realmente desagradable.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_a17_03",sync=0,face=1,time=400,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000005",ch="yum"},
},
ja={
{
name={"???"},
"“Y bien, este folleto es del club de arte de Yumihari, ¿cierto?...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. ¿Estás interesada?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_yum_000006",ch="yum"},
},
ja={
{
name={"???"},
"“Eso quiere decir que eres un miembro del club de arte de Yumihari, ¿verdad?\nQuisiera preguntarte algo. ¿Conoces a la persona que hizo la pintura que fue\ncolocada en el ayuntamiento?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿De qué me estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_yum_000007",ch="yum"},
},
ja={
{
name={"???"},
"“Esa enorme pintura de flores de cerezo colocada en el ayuntamiento. Es\nconsiderablemente famosa, la han publicado también en los panfletos\nmunicipales...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conozco nada de esa pintura colocada en el ayuntamiento.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_000008",ch="yum"},
},
ja={
{
name={"???"},
"“¿De verdad? Había escuchado que la había pintado un estudiante de este colegio,\n¿será que no se trata de alguien del club de arte?...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será un egresado? Jamás he escuchado de que alguna pintura de alguien de\neste colegio haya sido adornada en el ayuntamiento.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_com_a17_04",sync=0,face=1,time=400,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000009",ch="yum"},
},
ja={
{
name={"???"},
"“Había escuchado con toda certeza que se trataba de un estudiante activo.\nCiertamente, se llamaba Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kenichiro Kusanagi? Él es egresado de este colegio, pero ninguna de sus\npinturas está en el ayuntamiento.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_a17_05",sync=0,face=1,time=400,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000010",ch="yum"},
},
ja={
{
name={"???"},
"“Incluso yo sé que Kenichiro Kusanagi ya murió. No es ninguna obra de él.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces seguramente escuchaste mal. No hay ninguna persona llamada Kusanagi\nque haya hecho esa pintura.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000282",ch="mkd"},
},
ja={
{
name={"???"},
"“Fue Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_a17_03",sync=0,face=1,time=400,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Naoya? ¿Qué? ¿Eh, Naoya Kusanagi? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg055e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000283",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vine a espiarlos a ver si estaban haciendo su trabajo, pero bueno, parece que\nsí lo están haciendo, eh.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida eso, Toritani. ¿Qué hay de esa pintura que está en el ayuntamiento?...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000284",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios... Preocúpate por averiguar por lo menos dónde colocan tus pinturas.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, en primer lugar, ¿por qué mi pintura está en ese lugar? ¿Y cuál de\ntodas es?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000285",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La obra que pintaste hace 6 años. Tu última obra, 'Fantasía de un día de\ncerezos'.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Fantasía de un día de cerezos'... Ahh, ¿esa pintura de flores de cerezos? ¿Por\nqué la tienen en ese lugar?...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000543",ch="ked"},
},
ja={
{
name={"Kei"},
"“Durante esa época, un día vino un viejo que quería esa pintura, ¿no recuerdas?\nTe pidió que se la vendieras.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000544",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, accediste alegremente y se la vendiste.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por cuánto?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000545",ch="ked"},
},
ja={
{
name={"Kei"},
"“Si no me falla la memoria, creo que habías dicho 10000 yenes.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buena ganancia que me hice en ese entonces.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000286",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Buena ganancia? ¿De qué estás hablando?... Un tiempo después esa pintura fue\nrevendida por 1 millón y tanto de yenes.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000287",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Supongo que también habrá influido el hecho de que la haya pintado el hijo de\nKenichiro Kusanagi. Incluso se llegó a anunciar por los medios.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? No tenía idea alguna.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000546",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es que, aparte de no ver nunca la tele, rechazaste todas las invitaciones de\nreportaje, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Reportajes? No recuerdo haber recibido ninguna invitación a eso...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000547",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo malentendiste todo, creyendo que te estaban preguntando por tu papá... No\nimportara lo que te preguntaran, siempre respondías 'No sé', 'Pregúntenle al\nviejo'...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No recordaba que había pasado eso...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Mumumuh... A pesar de no tener interés alguno por los asuntos de la sociedad,\nno puedo creer que hubo una época en la cual estremecí a esa misma\nsociedad...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"¿Por qué pusieron tanto su atención sobre mí?... De verdad que no lo entiendo.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000288",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Después de eso, la obra fue donada al ayuntamiento. Aún está colocada al lado\nde su entrada.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De verdad?! ¡Pero qué vergüenza eso! ¡Voy a ir a arrancarla de ahí!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000289",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Idiota, no puedes hacer eso. ¿Tienes cómo pagar más de 1 millón de yenes?\nAdemás, en primer lugar, fuiste tú quien la vendió.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... e-eso es cierto, pero...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Esa pintura, aun cuando creí que 10000 yenes era ya bastante por ella, no me\nimaginé que valiera más de 1 millón...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Mierdaaa... Ese abuelo me engañó. Pero qué tipo tan inescrupuloso, vendiendo\npor más de 1 millón algo que compró en 10000 yenes.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",mode=-2},
{"bg",file="ev_com_a17_02",time=500,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000011",ch="yum"},
},
ja={
{
name={"???"},
"“¿Fuiste tú quien hizo esa pintura?...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. No lo he visto con mis propios ojos, así que no sé, pero... parece que\nes así.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_a17_04",sync=0,face=1,time=400,path=":ev/ev_com_a17/",set="ev_com_a17"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000012",ch="yum"},
},
ja={
{
name={"???"},
"“Ya veo... Lo cual quiere decir que tus aires han cambiado bastante desde\naquella época, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que mis aires han cambiado? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg055e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0015",head="yum_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm037"},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0017",head="yum_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000013",ch="yum"},
},
ja={
{
name={"???"},
"“No es nada, solo hablaba sola. Ahora que te veo bien, sigues con la misma cara\nde idiota de siempre.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cara de idiota?!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0017",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000290",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejemos eso de un lado. Tú. Quedaste con una cierta impresión en mente después\nde haber visto la pintura del ayuntamiento, tienes aptitud. ¿Cómo te\nllamas?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"user",mode="conf",ch="優美"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000014",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yuumi Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Kawachino... ¿Qué será esto? Siento de alguna manera que se me hace familiar\nese nombre...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"... No, no recuerdo a esta mujer de ningún lado.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000291",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Yo soy Makoto Toritani, la jefa del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000015",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Entiendo... ¿Naoya Kusanagi no es el jefe?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy jefe, y menos aún integrante del club.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000016",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad? Así que Naoya Kusanagi no pertenece al club de arte. Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000292",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te parece que eso no está bien?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000017",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, la verdad es que no me parece tan mal...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0012",head="mak_z1b",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000293",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000018",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Por otro lado, creo que deberían atender al grupo de mujeres que tienen\ndetrás...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0013",head="mak_z1b",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000294",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_jka_000001",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Estooo, estooo, acabo de escuchar el apellido Kusanagi. ¿Será que se trata de\neste muchacho en esmoquin?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000002",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“El hijo de ese famoso artista reconocido a nivel internacional que murió hace\npoco, esto, ehm, ¿era Naoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000001",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“Es idéntico al Kenichiro Kusanagi que vi en la tele. Eres su hijo, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_jka_000002",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Kyah, ¿en serio?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000003",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Increíble, eres el que hizo la pintura del ayuntamiento, ¿verdad? ¡Hace poco lo\ndijeron en la tele!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000002",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“Dijeron que era más quisquilloso y exigente que su padre.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, ¿de verdad?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000004",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Pero se ve bastante amable~”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy algo amable... Sobre todo con muchachas tan lindas como ustedes...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000005",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Kyah~, nos dijo que somos lindas~”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así que...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para hacer brillar aún más tus maravillosos ojos es necesario darle un servicio\nestético a tu mente.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría dibujar juntos un plan futuro de amor en el lienzo? Hagamos una\nobra única en el mundo con la pintura de nuestros sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Les reparto unos folletos al grupo de chicas, con una sonrisa en mi cara.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000003",ch="jka"},
{"vo",file="fem_jkb_000006",ch="jkb"},
{"vo",file="fem_jkc_000003",ch="jkc"},
},
ja={
{
name={"Chicas"},
"“Kyah~, qué apuesto~”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0024",head="mak_z1a",lv=4,id=7},
{"fgact",ch="真琴",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000295",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esperen, esperen un momento! Todas ustedes son aspirantes a ingresar al club,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000004",ch="jka"},
{"vo",file="fem_jkb_000007",ch="jkb"},
{"vo",file="fem_jkc_000004",ch="jkc"},
},
ja={
{
name={"Chicas"},
"“¡Por supuesto!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0004",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000296",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿podrían venir conmigo entonces? Tenemos unos cuantos procesos de\nselección para entrar.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000005",ch="jka"},
{"vo",file="fem_jkb_000008",ch="jkb"},
{"vo",file="fem_jkc_000005",ch="jkc"},
},
ja={
{
name={"Chicas"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"se",file="se9004",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=7},
{"text"},
text={
ja={
{
"Aparte de las nuevas estudiantes que andaban relinchando entusiasmadamente,\notro grupo más de mujeres siguió a Toritani.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué demonios... Cada vez son más...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0001",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000548",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No te lo dije?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... Así que realmente existen...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0001",head="kei_z1c",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000549",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, y son muchas más que el año pasado. Parece que llegaron a hablar del asunto\ndurante varios días seguidos en los programas de variedad desde que se\nrealizó el funeral de Kenichiro Kusanagi-san, pero no pensé que también\nhubieran mostrado tu pintura en la tele.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente se quedaron sin más temas de qué hablar en la tele. Bien... creo que\nme iré ya.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0012",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000550",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Te vas ya?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya reunimos esa gran cantidad de personas. No deberíamos necesitar más,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000551",ch="ked"},
},
ja={
{
name={"Kei"},
"“Creo que estrictamente no es un problema de cantidad...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani solo quiere una cierta cantidad de gente para asegurar la\nsupervivencia del club, ¿no? Si es así, entonces basta con esto.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0001",head="kei_z1c",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000552",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quizás, pero... Dijo también que harían una selección ahora. Muchas de tus\nfanáticas están reunidas ahí, ¿no sería buena idea que participaras tú\ntambién?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0017",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000553",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues son tus fanáticas que se convertirán pronto en tus seguidoras. ¿No\npreferirías elegir a las chicas más lindas o las más dóciles y tranquilas?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000554",ch="ked"},
},
ja={
{
name={"Kei"},
"“Entonces--”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso se encargará Toritani. Seguramente ella podrá elegir a todos los\nmiembros necesarios. No por nada es la jefa del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0012",head="kei_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000555",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? Pero eso...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, vámonos ya. Seguramente con esa cantidad de gente ya la continuidad del\nclub de arte está garantizada.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000556",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Espera, ¿será posible que lo de querer seguidoras era mentira, y en realidad\nlo hiciste por el club de arte?!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, simplemente que ya me aburrí de que me adularan. No es nada más, así que\nvámonos ya.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2c0000",face="c0004",head="kei_z2c",lv=5,id=6},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000557",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
