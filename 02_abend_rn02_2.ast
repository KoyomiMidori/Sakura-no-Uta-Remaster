{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000644",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... ya volví...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="znightsky_winter",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=0,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Rin, soltando lágrimas.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Shizuku, quien parece estar como siempre.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Pero al observarla bien, se veía cómo su boca estaba fuertemente apretada.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así está bien...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Probablemente no soy solo yo.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"No, no hay forma alguna de que solo se trate de mí.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Por eso es que Shizuku está igual también.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"No es un problema del cual debamos permanecer cautivos siempre.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Así es...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Debemos tratar de caminar en lo posible hacia adelante...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Pues, Rin regresó de nuevo a estas tierras...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Shizuku abraza suavemente los hombros de Rin mientras lloraba.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",time=500,mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0016",head="shz_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2d0300",face="d0004",head="shz_z2d",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000187",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*bui*",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Por alguna razón, Shizuku me hace un gesto de la letra V.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"¿Qué tan indescifrable puede ser esta muchacha?...",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=1000},
{"excall",file="02_abend_rn02b"},
