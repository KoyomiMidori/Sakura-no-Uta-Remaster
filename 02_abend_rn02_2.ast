astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000609",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hemos llegado a las inmediaciones del lugar destino. ¡Finalizando la\nnavegación!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias por la navegación.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000610",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A la orden... Bien, creo que me iré ya a casa.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Puedes esperar un poco?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000611",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Pues, está bien...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Shizuku! ¡Estás ahí, ¿cierto?!”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Alzo fuertemente la voz frente a la entrada.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-450,y=10,file="zbg001d",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"cgact",stage="bg001",act="びっくり",size=2},
{"se",id=1,file="se2815"},
{"text"},
text={
ja={
{
"Y la puerta de la misma tiembla un poco.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de cerca estabas?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_szd_000151",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Estaba preocupada por ti.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, ¿entonces por qué andas espiando desde ese lugar?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_szd_000152",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Es que...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, sal.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_szd_000153",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, también está Rin.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"msgoff"},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",file="bg001d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000612",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-san estaba esperando para recibirte, Kusanagi-kun. Pero ahora no sabe\nqué hacer teniendo a una desconocida cerca como yo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000613",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, Kusanagi-kun, muchas gracias por hoy, ¡me iré ya!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, se supone que soy yo quien debe dar las gracias, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000614",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? En fin, creo que estoy siendo un estorbo así que me iré ya. Pude\nademás traerte hasta acá sano y salvo. Sí.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_szd_000154",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡E-Eso no es verdad!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000615",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000155",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Ja?! E-Esto... ehm... ¡Wah!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos estás haciendo tras la puerta?... A juzgar por ese sonido, te\ncaíste, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_szd_000156",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Pero creo que ese fue el sonido que hizo el stand de paraguas al tumbarlo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces moviéndote tanto por la entrada?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_szd_000157",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quedé asombrada ante mis propias palabras.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, sal ya.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_szd_000158",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me tropecé violentamente, y mis piernas quedaron abiertas y mis pantaletas se\nven por completo, así que no puedo salir.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Párate y arréglate la ropa entonces! Por lo menos puedes hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_szd_000159",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo siento mucho. Los paraguas se me enredaron alrededor... y no puedo cerrar\nmis piernas.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué forma de enredarse es esa?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_szd_000160",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estoy ahora sola, en estado sadomaso. Tu excitación explotará al verme con las\npiernas abiertas, Naoya. Ah, ¿es por eso que quieres abrir?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Claro que no!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000616",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, Kusanagi-kun, es malo forzar a Shizuku-san a hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Forzar? ¿Cómo que forzar?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000617",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que no quiere encontrarse con otras personas.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y crees que alguien así se pondría a espiar en la entrada?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000618",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estaba esperando para recibirte, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, Shizuku no se la pasa siempre esperándome acá. ¿Verdad, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000161",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Shizuku nunca miente ni trata de aparentar las cosas. Es una muchacha\nextremadamente honesta.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así como lo escuchas, Rin.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000619",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000620",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm, quizás sea algo desvergonzado decir esto, pero...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000621",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podemos ser amigas?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_szd_000163",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000622",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sé que quizás, pedir esto con tanta ligereza a alguien tan famosa como tú deje\nmucho que desear, pero pensé en que quisiera ser tu amiga.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000623",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podría... abrir la puerta?...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_szd_000164",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si abres ahora, Naoya verá mis panties. Y es más, mi ropa interior está tan\nestirada que presiento la posibilidad de que incluso se vea algo más.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja de una buena vez de andar con la misma pose!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_szd_000165",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es la misma pose de hace un rato.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_szd_000166",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está ahora empeorando... Ya no es algo que se le pueda mostrar a las personas.\nMás bien, es la clase de poses que garantizaría la fuerte excitación de esas\npersonas de 'aquellas' inclinaciones sexuales.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás empeorando de esa forma?...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_szd_000167",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo también me agito a veces, y cuando lo hago, incluso esto puede suceder. Ahh,\nahh. Auhh. M-Me está jalando bastante...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000624",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Retira los paraguas con calma. Y sí, ciertamente, es también posible que los\nmangos de los paraguas se enreden con la ropa.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"mwact",act="おじぎ"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000168",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, aunque, después de todo, creo que esto me está haciendo abrir los ojos a un\nnuevo mundo, así que quizás, creo, se siente algo bien. Auuh.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Una voz un tanto melosa.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Abrir los ojos a un nuevo mundo?... ¿A-A cuál... mundo?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_szd_000169",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y, después de decir cosas al azar con algo de actuación entremezclada, Naoya\nreaccionará sensiblemente y deberá terminar con sus genitales hinchados\ndespués de considerar de qué manera su amiga de la infancia lo verá al\ncomportarse así.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se me van a hinchar los genitales!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0017",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000625",ch="rnd"},
},
ja={
{
name={"Rin"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡No! ¡Te equivocas! ¡No se me paró!",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000626",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Entonces por qué ocultas esa parte?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te parece descabellado que alguien diga '¡No se me paró!' y luego muestre\nla zona de los genitales?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000627",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ciertamente... t-tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",sync=1,mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Unos segundos después, Shizuku sale de la entrada.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000628",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Buenas noches, Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000170",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000629",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, soy Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000171",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Shizuku toma y aprieta las manos de Rin.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000172",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres Rin...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0004",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000173",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres Rin, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000630",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Rin se sorprendió por un instante, pero luego apretó de vuelta las manos de\nShizuku.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000174",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es un gusto conocerte... Rin.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000631",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El gusto es mío, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000175",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, volviste a esta ciudad, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000631b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, volví.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000177",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entiendo... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000632",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se siente un tanto curioso al tomarnos de las manos así, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000178",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es como el comercial de los butsudan...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000633",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, recuerdo ese comercial.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000634",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Junta manito y manito~”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2d0300",face="d0004",head="shz_z2d",lv=5,id=6},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_szd_000179",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y hagamos explotar ácido cianhídrico...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"¿Por qué se queda en silencio esperando por alguna reacción en esa parte?...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2d0300",face="d0004",head="shz_z2d",lv=5,id=6},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_szd_000181",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Y HAGAMOS EXPLOTAR ÁCIDO CIANHÍDRICO!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"¡¿Para qué lo dices alzando la voz?!",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Tanto Rin como yo te escuchamos. Este silencio dice que la broma realmente no\ndio risa.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bgm",file="bgm110"},
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000636",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Puh... pupupuh...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0016",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000182",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*niyari*",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000637",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajajajaja... Se supone que en esa parte es 'Felicidad'. Además, el ácido\ncianhídrico es un gas letal, así que todos morirían antes de que explotara.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"(¡Pero q--! ¿Se supone que la réplica a ese chiste requería un conocimiento tan\navanzado de química?)",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000183",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En este caso se supone que explotará después de que todos mueran.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000638",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso sería demasiado siniestro. Ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0019",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000639",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, eres muy divertida... Ajajaja... ¿Eh, arere?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0020",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000640",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000641",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por andar diciendo cosas tan cómicas se me salieron las lágrimas.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000184",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0019",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000642",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué estoy llorando?...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0004",head="shz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000185",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así de divertido e inteligente fue mi chiste. Y de tal manera, quedamos ambas\nen buenos términos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000643",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal... vez...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000186",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Bienvenida de vuelta.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
