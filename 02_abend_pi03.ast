astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"se",file="se9026",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"El sonido del tono del celular acaba con mi sueño de la mañana. Este patrón me\nrecuerda a algo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",id=1,file="se3434"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm024"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy yo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001067_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Buenos días, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Aun antes de tomar el celular tenía de cierta forma el presentimiento de que\nera ella.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Primero ayer, y ahora de nuevo me llamas a estas horas de la mañana, ¿qué\nquieres?...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001068_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A estas horas de la mañana? Ya pasaron las ocho... Por Dios... Por cierto,\n¿aún sigue valida la deuda de ayer?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La deuda de ayer? Ahh, te refieres a la ayuda que me diste cuando me perdí.\nPues claro.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001069_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quisiera entonces que me ayudaras con algo antes de que vayas a tus clases\nsuplementarias.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, aunque iré a la misma hora que ayer.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001070_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ven entonces a Quimera. Te espero.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Sea cual sea la razón, es fantástico que Toritani esté tratando de pedirle\nayuda a alguien.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Me salgo del futón.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Supongo que iré a lavarme la cara primero.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bluesky_spring",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"cgdel",id=-1},
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Entro a Quimera antes de su hora de apertura.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mx=-40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001071",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Buenos días, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001072",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo siento, ya dentro de poco vendrán a buscar el cargamento, así que quisiera\nque comenzaras ya.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cargamento? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001073",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos a enviar unos cuantos productos que vendimos por encargo. Tendrás que\nhacerlo en mi habitación, lo siento. Ven.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",size="z1",time=500,sync=1,mode=3,path=":fg/mak/z1/",file="mak_z1c0100",face="c0001",head="mak_z1c",lv=4,id=9},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Toritani se da la vuelta al decir solo eso y comienza a regresar al segundo\npiso. Ciertamente, se ve ajetreada.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿vamos a entrar a tu habitación?...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Entre la explicación del cargamento y todo lo demás, Toritani no pareció\npreocuparse en lo más mínimo por eso, pero... Sea lo que sea, ella es otra\nchica más que apenas va culminando con la pubertad, ¿realmente está bien que\nentre a su habitación?",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Sé que es solo por trabajo, pero igual, eso de quedarme en una habitación, solo\njunto a una chica...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"¡No, está bien! ¡No hay problema! Es la misma Toritani la que me está\ninvitando.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Además, dijo que era por trabajo. Sí, solo para ayudarla con su trabajo. Así\nes, nada más.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~.. *ejem*.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Doy un tosido muy deliberado y comienzo a subir las escaleras.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Al terminar de subir las escaleras me topo con dos puertas, y la más cercana\nestaba medio abierta.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Siento la presencia de alguien trabajando adentro, así que esta debe ser la\nhabitación de Toritani.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Ya veo... así que esta es la habitación de Toritani... Da la impresión de oler\nbien adentro.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Sea lo que sea que trate de decirme a mí mismo, es inevitable que me sienta\nalgo tenso.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estoy exhausto...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Dejo caer mi cabeza sobre el escritorio, completamente cansado. Esa extraña y\ndulce sensación que tenía antes de entrar a la habitación... se esfumó al\nprimer minuto después de entrar.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"¿La labor? Una montaña de paquetes que requerían prepararse para enviar.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Ya Toritani había empacado casi todo, así que lo único que hice fue sellarlas\ncon cinta adhesiva.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Pegaba y pegaba cinta adhesiva, mientras que Toritani, junto con la muchacha de\nmedio tiempo, vino después para llevar todo al piso de abajo. Fue básicamente\nel tipo de labor mecánica que se ven en las líneas de ensamblaje, pegando\nfacturas a las cajas.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Según, parece que el contenido de las cajas eran tazas. Y cuando pregunté qué\ntipo de tazas, me dijeron que eran despachos de tazas que se venden en\nQuimera.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Toritani está ahora hablando en el primer piso con la muchacha encargada del\nenvío. Vaya trabajo que va a pasar la muchacha con toda esa carga...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sin embargo, de alguna u otra forma logramos terminar a tiempo antes de que\nQuimera abriera. Así como la hora de cierre, su hora de apertura también es\ntarde.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001075",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias por la ayuda. Creo que te puse mucho trabajo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no fue la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001076",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Baja cuando te recuperes un poco. Algo de tiempo te debe quedar para tomarte un\ncafé antes de ir a las clases suplementarias, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, en el interior de Quimera hay un rincón donde se\nexpenden café y tazas.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Según dicen, parece que la dueña es la que trae la mercancía, o algo así...\nDebido a que Toritani está ahora recluida en la cocina, me pongo a caminar un\npoco, y le echo un ojo al rincón de ventas.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Vaya.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001077",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué raro, jamás te había visto observando ese rincón.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, espera un momento, esto!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001078",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué pasa?...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿No es esta una taza de 'Conejo de Luna'?!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001079",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ahh... sí. Pues sí, la dueña las compra para luego venderlas acá.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya veo! ¡Tu prima realmente tiene muy buen gusto, vaya que sí! Oh, esto es...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿no es esta de la primera serie que salió? Aun con lo difícil que son de\nconseguir en internet, quién diría que se podrían conseguir aquí... Estoy\nasombrado.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001080",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es lo mismo a que si encontraras un modelo de Gund*m bastante raro en una\npequeña juguetería en medio del campo, ¿no? Y además, muy poca de la gente\nque viene acá le atrae...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no atrae casi gente?... ¿No acabas de mandar una pila de cargamento de\nestos productos hace un momento?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0012",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001081",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh, e-es que... no sé por qué, pero parece que el negocio va muy bien en\nInternet... Seguramente es por lo bien que se ven en las fotos, sí,\nseguramente.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, la intención de compra que podría tener alguien que simplemente viene a\nvisitar al café es completamente distinta a la que podría tener alguien con\nun claro interés por tazas y vasijas buscando en Internet.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001082",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, bueno... sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen por ahí que es muy distinto lo que se puede vender por Internet a lo que\nse puede vender en persona... En fin, ¿podrías reservarme esta?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001083",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Vamos, no tienes por qué hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? Se supone que esta mercancía no es tuya, ¿no? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001084",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ahh, sí, creo que de tanto ajetreo me confundí un poco. Entendido, reservaré\nesto, sí.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excelente, después te traigo el dinero.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001085",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Dinero?... ¿Es que tienes dinero para gastar en esta taza?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... ahora que lo dices...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001086",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, no importa. Lleva un buen rato ahí sin venderse, así que la pondré\ncomo vendido.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad lo siento, y gracias, esto me alegra bastante...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001087",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás exagerando...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, para nada, de verdad me encantan estas tazas.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001088",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... así parece.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las tazas de café son para tomar café. Para eso. Estas tazas están creadas\nhaciendo bastante énfasis en esa idea.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El agarre de la asa se ajusta perfectamente a la mano, así que no hay ningún\nriesgo de que se caiga.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El peso de la taza está bien calculado, de manera que a la hora de llenarla de\ncafé conserve un peso adecuado para el usuario.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sin embargo, el peso de la taza vacía no es poco fiable, ni tampoco\ninestable.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene una forma simple, pero que no aburre, y una textura agradable a la mano.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esta fina elección de colores, que no solo suaviza el color negro del café,\nsino que además hace ver aún más apetitoso el humo que este despide.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El diseño no es tan impactante, así que se puede usar como una simple y\npráctica taza de café, pero en caso de agradarte el diseño, te da una gran\nsensación de plenitud que te invade en cada oportunidad que la tengas en\nmano.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sobre todo, es realmente fácil limpiarla. Es sin duda alguna, una taza\ndiseñada para la vida diaria. Es maravillosa...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001089",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Debes estar bastante encantado con ellas, ¿no?... Tanto como para hacerte\ndar ese discurso tan fervoroso...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de verdad admiro bastante al fabricante. Es completamente diferente a mí.\nNo sé si es un hombre o una mujer, pero seguramente es toda una persona\nmadura, de una buena edad, con una cálida personalidad.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001090",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Es que acaso puedes saber todo eso solo viendo una taza?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en realidad no, pero soy libre de pensarlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001091",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Toritani mueve su mirada alrededor, intranquila y sin mucha calma.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001092",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejando eso de lado, debes estar cansado después de tanto trabajo, ¿no? Te\npreparé algo dulce en agradecimiento, lo dejé allá.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Al dar un vistazo, puedo ver que hay algo puesto en los asientos cercanos a la\nbarra. No hay muchos clientes aún, y en los asientos de la barra no hay ahora\nnadie.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Agradecimiento? Se supone que vine a ayudarte para pagarte de vuelta la deuda.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001093",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo sé, pero trabajaste un poco de más, ¿no? Y además, es solo un prototipo de\npostre, así que no te preocupes por eso. Preparé bastante.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001094",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque si quieres saciar el estómago con un gyuudon o algo así, lo tendrás que\npagar tú. Acá tenemos mejores precios que otras cadenas de tiendas, así que\nno deberías tener problema.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso haré.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"En la barra había una docena de tazas alineadas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gelatina de café...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Mencionó que era un prototipo, aunque, ciertamente sí preparó bastante.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Por lo general, la gelatina de café se sirve en recipientes de vidrio, pero\nestos eran de cerámica.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estas son tazas soba choko?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001095",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Definitivamente eres conocedor de cosas bien raras... Sí, lo son.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001096",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace tiempo les llamaban soba choko, pero debido a lo práctico de su forma y\nespacio, últimamente las venden ahora bajo el nombre de 'multi-cup'.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001097",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay con diseños de rayas, diseños nórdicos, y así como estas tazas, hay también\nmuchos diseños simples de un solo color.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Aunque, dejando a un lado lo de la taza, te pregunto, ¿era necesario\nhacer un prototipo de gelatina de café? ¿Estás buscando acaso la proporción\nideal de gelatina y café para conseguir la mejor elasticidad posible, o algo\npor el estilo?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001098",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es que también conoces cómo se prepara la gelatina de café? Bueno, la verdad\nes que siempre busco un buen acabado final, de poder, pero lamentablemente\nesta vez no lo hago por eso.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001099",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta gelatina está hecha con café ruso.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Café ruso...?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001100",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Ya te mencioné que la dueña suele enviar café de distintas regiones,\n¿no? Y a veces no necesariamente manda especies de buen sabor, sino nuevas,\nraras especies, entre las cuales hay algunas que son realmente increíbles...\nen el sentido de que cuando las pruebas, no parecieran ser realmente café.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, una gelatina de café con un café bastante raro... Será café ruso, pero\nsupongo que tampoco tan peligroso como una ruleta rusa...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001101",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Anoche, cuando iba a preparar todas las muestras juntas, la muchacha de medio\ntempo se equivocó y usó ese peligroso café...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001102",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y de ninguna forma podemos servirle esto a los clientes aún, así que las\nmuchachas y yo nos lo comeremos, pero antes, decidí darte un poco a ti\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001103",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si todo salió bien, entonces podrías terminar disfrutando de una deliciosa\ngelatina de café. ¿Qué tal? ¿Quieres intentarlo? No tienes por qué hacerlo si\nno quieres, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No, espera un momento, esta taza...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001104",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es esta taza fabricada también por 'Conejo de Luna'?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Sí, ciertamente, tiene una forma simple que me recuerda a las tazas de 'Conejo\nde Luna', además de un suave color blanco, pero... jamás había visto estas\ntazas antes.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001105",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, si es por eso...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani levanta suavemente la taza, procurando no derramar su contenido, y me\nmuestra la marca por debajo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001106",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El sello del alfarero es distinto, ¿lo ves?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"El sello del alfarero es, como el mismo nombre lo indica, un sello, que varía\nentre alfarero y fabricante.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"En las vasijas de 'Conejo de Luna' está impreso un sello de alfarero, con un\ndibujo de un conejo y una luna caricaturizados.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Sin embargo, el sello de esta taza dice... pica-pica.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Picapica?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001107",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así se lee.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que son distintos... Aunque se me hacen parecidos, pero... no, tal\nvez sí son diferentes.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001108",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes cuál es la diferencia?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, siento que en forma son bastante parecidos, pero el esmalte cerámico usado\nes distinto. No tiene ese particular color blanco 'Usagiko'.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001109",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Qué es eso?...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, el color blanco del esmalte cerámico usado en los productos de 'Conejo de\nLuna' es algo peculiar.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El creador nunca llegó a emplear ese nombre, pero el color en sí es hermoso,\nsuave, cálido y moderado... Así que se le llama 'blanco Usagiko', haciéndole\nhonor a esa imagen y al nombre del fabricante.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001110",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je, así que de esa forma le llaman...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_bit_000002",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Ah, pero, Makoto-san, tú también vendes piezas de alfarería, ¿verdad～?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo se une a la conversación de manera casual.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001111",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es asombroso, ¿qué clase de piezas vendes? ¿Las venden acá en Quimera\ntambién?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001112",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No son la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001113",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Últimamente se han vuelto populares las páginas de manualidades y eso, ¿no?...\nEsas páginas donde se pueden vender accesorios y decoraciones hechas a mano.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la primera vez que escucho de eso, la verdad. Así que existen también esa\nclase de sitios...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001114",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Existen algunos sitios famosos en la red donde cualquier persona puede\nregistrarse y vender de manera individual sus creaciones.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001115",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay una gran variedad de artículos, desde el tipo de creaciones realizadas por\nseñoras y abuelitas, hasta productos de acabado profesional de cuero o plata,\ny también artículos de cocina, por supuesto, e incluso venden muebles.\nRealmente vale la pena darles un vistazo.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001116",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es fácil y sencillo registrarse, así que cualquiera que tenga interés en\nhacerlo puede meterse, supongo.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú también vendes tus artículos en esos sitios?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001117",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, bueno... de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, eso se escucha genial. Muéstrame tu página.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001118",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No quiero! Me da pena...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te da pena? Quizás esté un poco difícil que llegues al nivel de fama de\n'Conejo de Luna', pero con la habilidad que tienes para la alfarería, podrías\nllegar bastante lejos, pienso yo...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_bit_000003",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“¿Eh? Pero eso--”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001119",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",mx=-40,mode=-1,lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000004",ch="bit"},
},
ja={
{
name={"Muchacha"},
"*mogaa*",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"De repente, Toritani le tapa la boca a la muchacha de medio tiempo, y la\narrastra lentamente hacia la cocina.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001120",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No es nada, ajajajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000005",ch="bit"},
},
ja={
{
name={"Muchacha"},
"*moga*, *moga*, *moga*.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001121",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Puedes comer todo lo que quieras de esa gelatina de café! ¡¿Está bien?! ¡Nos\nvemos en un rato!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_bit_000006",ch="bit"},
},
ja={
{
name={"Muchacha"},
"¡*mogamoga*～～～～～!",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Se fue...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Veo las tazas de gelatina de café alineadas una con la otra. Es algo triste\njugar a la ruleta de café ruso solo.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Así que, pequeñas tazas, quédense acá y esperen a ser repartidas entre Toritani\ny las muchachas de medio tiempo.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Al observar el reloj, veo que aún quedaba bastante tiempo para el comienzo de\nlas clases suplementarias de hoy.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Creo que tengo suficiente tiempo como para ir a matar ese asunto pendiente que\nacabo de recordar.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_05"},
{"text"},
linkback="block_00163",
},
label = {
top={block="block_00000",label=1},
},
}
