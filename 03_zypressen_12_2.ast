astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm103"},
{"se",vol=30,id=1,file="se_roofdoor_open"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002494",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hmm, hmm. Parece que realmente se fueron. Se me ocurrió que quizás podrían\nestar espiándonos del otro lado de la puerta...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rina? ¿Qué haces?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002495",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no es nada. Solo quería verificar de que esas dos no estuvieran\nespiándonos.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002496",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"excall",label="yesextrascene",cond="s.scene==1",call=0},
{"excall",label="noextrascene",cond="s.scene==0",call=0},
{"bgm",file="bgm103"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"se",file="se_kacha",id=1},
{"text"},
text={
ja={
{
"Rina saca una enorme llave.",
{"rt2"},
},
},
},
labelcount=9,
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002497",ch="rna"},
},
ja={
{
name={"Rina"},
"“He estado pidiendo permiso para pintar acá en la azotea, así que puedo tomar\nprestada la llave de la sala de profesores.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002498",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. La cerradura funciona afuera, y también adentro. Observa...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",id=1,file="se_roofdoor_lock"},
{"text"},
text={
ja={
{
"Al decir eso, Rina cerró diestramente la puerta.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002499",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y gracias a esto, puedes evitar que cualquier persona viniendo de afuera entre.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002500",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora sí estamos solos, Naoya-san.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002501",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué harás ahora, Naoya-san? Ya no puedo huir.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? La llave la tienes tú.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002502",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Toma entonces.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Apenas dijo eso, Rina me dio la llave.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002503",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya no tengo escapatoria.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002504",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mentiiira. ¿Te lo creíste?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001j",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rina me abrazó cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002505",ch="rna"},
},
ja={
{
name={"Rina"},
"“No necesitas llave alguna... No huiría, así no hubiese cerradura.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002506",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jamás sería capaz de huir de ti...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002507",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero un beso ahora. Y quiero que después me des mucho, mucho más amor.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009j",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=400,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002508",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hazme muchas cositas pervertidas. Mucho más pervertidas que un beso.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002509",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy caliente. Por ti...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No eres la única.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016j",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002510",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, vaya pareja calenturienta que somos. Somos unos tontos los dos.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así son las parejas al comenzar, ¿o no? Dos ingenuos.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002j",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002511",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, ya estás recuperando la frialdad. Estás retornando al Naoya-san de\nsiempre.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pareciera... Bien, voy a besarte.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002j",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002512",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tienes por qué pedirme permiso una y otra vez. Me habías prometido que me\nbesarías cada vez que cerrara los ojos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Rina cerró sus ojos lentamente.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002513",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh... mmm...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"La tomo en mis brazos. Sus hombros brincaron un poco.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_rna_002514",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm... *chuu*... *muh*, *chuu*, *rero*.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"La caliente lengua de Rina se abre paso entre mis labios.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Todavía algo renuente, doy un paso adelante y saco mi lengua yo también.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, *chuu*, kuh.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rna_002515",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chuu*... *rero*... *chuuchuu*... mmm... Naoya-san...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Jaa... Jaa... Dime.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rna_002516",ch="rna"},
},
ja={
{
name={"Rina"},
"“Iremos... más allá de los besos, ¿verdad?... Haremos, cosas más pervertidas...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"se",file="se_bafu",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002517",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Wah, kyah!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_rna_h03_01",path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002518",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me has tumbado.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso he hecho...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_rna_h03_02",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002519",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Ser tumbada, de esta manera... se siente, algo bien.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rna_002520",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ya recordé por qué. Le dicen 'yukadon', y es cuando el hombre acorrala a la\nmujer golpeando el suelo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy precisamente golpeando el suelo.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_002521",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero recuerdo que era algo parecido a esto. Además, se me apretó el pecho\ncuando lo hiciste...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Se te apretó el pecho.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"El pecho, eh...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bg",file="ev_rna_h03_03",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002522",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Siento una mirada debajo...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que ahora que los veo... me doy cuenta, de lo realmente enormes\nque son...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rna_002523",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mis pechos?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_rna_h03_02",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002524",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, sí, dicen que son grandes. Por mi parte, realmente no lo sé...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no sabes? ¿Cómo no podrías darte cuenta?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rna_002525",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo sé. Las mediciones lo confirman, pero siempre he estado en este cuerpo...\nNunca me he preocupado mucho al respecto.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, quizás sea eso entonces.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_rna_h03_03",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002526",ch="rna"},
},
ja={
{
name={"Rina"},
"“M-Me está dando algo de pena.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rna_002527",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me avergüenza, que... te fijes tanto en mis pechos.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“También estoy viendo tu cara, por si no te has dado cuenta. Estoy alternando\nentre tu cara y tus pechos.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rna_002528",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eso es lo más vergonzoso del asunto!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rna_002529",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No me veas tanto a la cara... Cada vez que me ves, me muero de la\nvergüenza...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está algo difícil cumplir ese pedido... No con lo linda que eres.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Paso mi lengua por el cuello de Rina.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_rna_h03_01",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002530",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm, auh, ahn, kuh, e-eso fue algo imprevisto...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez, *rero*.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002531",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nghhhh.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente tienes una hermosa piel.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_rna_h03_02",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002532",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kuh, huu... P-Pues, sí, desde pequeña he procurado cuidarme del sol...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Debe ser eso.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que disfrutaré un poco más de ella, entonces.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rna_002533",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahn, ngh, ah, m-me haces cosquillas.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No se siente bien?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rna_002534",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm, jaa, jaa, ahn, no lo siento, precisamente allí, ngh, pero, me gusta.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_002535",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm, si no me gustara, jaa, jaa, no creo, que se me agitara tanto la voz.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rna_002536",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero... ¿Te basta con esto, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_rna_002537",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te basta con solo lamer mi cuello?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_002538",ch="rna"},
},
ja={
{
name={"Rina"},
"“Deseo más, Naoya-san. Quiero que me hagas muchas, muchas cosas sucias...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"se",file="se0897s",vol=30,id=1},
{"text"},
text={
ja={
{
"Rina comienza a mover los brazos y las piernas.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"No sé si era mi imaginación, pero parecía estar arqueando su espalda para\nacentuar sus pechos.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y cosas sucias haré, no hace falta que lo pidas.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rna_002539",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Bueno.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Viendo un poco de reojo a Rina, quien había apartado su mirada de la vergüenza,\ncomienzo a desabotonar la camisa de su uniforme.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Mis dedos estaban temblando ligeramente.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Mi respiración se me hacía más ruidosa de lo normal.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Al desabotonar la camisa con mis temblorosos dedos, su sujetador salió a la\nvista.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_rna_002540",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿T-Te gusta?...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Te ves, pre, preciosa...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_rna_002541",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, me lo quitaré, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"V-Vale...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Rina pasó sus manos sobre su sujetador.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Y los pechos, fuertemente apretujados entre el sujetador, salieron afuera como\ndisparados.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"cgdel",id=-1},
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_rna_h03_04",path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto es increíble...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rna_002542",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... Es sencillamente maravilloso.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_002543",ch="rna"},
},
ja={
{
name={"Rina"},
"“Q-Qué bueno que me digas eso. Me siento algo agradecida ahora de haber nacido\ncon este cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquier hombre se asombraría de ver estos pechos.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rna_002544",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sí? Pero, me es suficiente con que te guste a ti.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Toco los senos de Rina.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bg",file="ev_rna_h03_05",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*biku*, *biku*",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rna_002545",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nnghhh.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te duele?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_rna_h03_04",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002546",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, no me duele. Pero se siente algo extraño...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Primera vez que toco unos, así que no sé aún cómo hacerlo bien. Dime si llega a\ndolerte.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rna_002547",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me duele para nada... Más bien... s-se siente bien.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bueno saber eso.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_rna_002548",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que, no me molestaría... que me toques más.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni que lo pidas, eso haré.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Siempre imaginé que los pechos de las mujeres eran suaves y tiernos... pero no\npensé que tanto.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Es una suave, firme y tersa sensación. Siento como si... envolvieran mis manos\nmientras los acaricio.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Toco y jugueteo con ellos hasta más no poder.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002549",ch="rna"},
},
ja={
{
name={"Rina"},
"“Auuhhh... ¡¡¡¡S-Si sigues tocándome así, yo---!!!!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te duele?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_rna_002550",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me duele, no me duele nada... Todo lo contrario... esto... se siente, muy\nbien... ahn.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Aliviado por esas palabras, toco la zona colorada sobre la punta de cada uno de\nsus pechos.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"――*kunyuh*...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_rna_h03_05",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002551",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Nfuh, ahaaa!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikun*!",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Sus hombros dieron un fuerte brinco.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Me dispuse a lamer esos rosados montículos.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_rna_002552",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ahh! Ngah, ngh... mm, fuh, jaa, jaa... ¡Ahhhh!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"A la vez que acariciaba los pechos de Rina, me llevé sus pezones a mi boca.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rna_002553",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Nggh, e-eso, yo!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Rina mueve la cabeza a los lados, con su mirada puesta sobre mí.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo los lamí por encima, ¿no te gusta que lo haga?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rna_002554",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hyaan, ngh, p-por supuesto que sí. S-Se siente, mucho mejor, cuando m-me lames\nahí.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_rna_h03_06",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
ja={
{
"Ahora que los había lamido, sus pezones estaban... cada vez más duros y\nparados...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Estaban rojos, hinchados y apuntando hacia arriba.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Pasé a morderlos suavemente, mientras escudriñaba cada una de sus reacciones.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*biku* *bikun*",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rna_002555",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahn, jaa, jaa, huuun... nnnnngh, hauh, hauuuh, y, a-ahora, me muerdes, ngh.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dolió?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_002556",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No, no, claro que no, ngh. Para nada, solo que, ngh, no pensé, que se\nsentiría tan bien.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Probablemente es la primera vez que sus pezones hacen esto.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Quizás jamás se los ha tocado ella sola como lo estoy haciendo yo ahora.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Los erectos pezones de Rina parecían estar más sensibles ahora, temblando por\nla estimulación de mi lengua.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bueno saber eso... Ahm.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002557",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, ah, mmm, jaa, jaa, ngh, N-Naoya, sa-...n.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rna_002558",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... nmm... n-no... n-no chupes, mis pechos, como si fueras un bebé.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Los pezones de Rina van parándose cada vez más.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_rna_h03_07",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es increíble... Tus pezones, mira como están... No puedo contenerme...\nentran, tan fácilmente en mi boca.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rna_002559",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahhn, nnngh, n-no hables, con mis pezones, en tu boca, ngh, harás, que me\nvuelva, locaa.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rna_002560",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahhh, ngh, gah, se siente, jaa, jaa, tan bien, esa, vibración, ngh, haan.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina... ¿Te gusta?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rna_002561",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, mm, s-sí, c-claro, a-auh, se siente muy bien, ngh, augh, nnmmm.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*biku*, *biku* *bikun*",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Con su espalda arqueada, Rina estaba ahora con sus pechos tendidos hacia\narriba.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Pareciera como si su cuerpo quisiera más.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rna_002562",ch="rna"},
},
ja={
{
name={"Rina"},
"“H-Hauh, N-Naoya-san, ngh, ¿te gustan, mis pechos?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me encantan.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rna_002563",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, jaa, jaa, ahn, q-qué, b-bueno. P-Puedes... ngh, chupar... nmm, más,\nentonces... hiiin.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Chupo con más fuerza los pezones de Rina.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*biku*, *biku* *bikun*!!",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_rna_h03_08",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002564",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hauuh... aahh... Jaa, jaa, siento corrientazos por mi cuerpo... Mis pechos\nestán calientes, muy calientes... Siento, que estoy por perder... la\ncordura...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Rina se retuerce en placer.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002565",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¡¡Hyaauuuunn!!! A-Ahn, jaa, jaa... kyaauun... ah, se siente, demasiado\nbieeen... ¡¡nm, ah, augh, jaa, jaa, jaa, ahhhhh!!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*, *bikun*",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"El cuerpo de Rina se retuerce sin parar.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rna_002566",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nha, se siente, tan bien que, jaa, jaa... ngh... siento, que terminaré loca...\npero, si tanto te gusta, ngh, me esforzaré, por aguantar.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aguantar?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rna_002567",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, ah, jaa, jaa, intentaré, no venirme, nnggh.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto... lo sientes en los pechos?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rna_002568",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Síí. A-Al parecer, soy algo sensible allí... hauh.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que te contengas entonces...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rna_002569",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, ahn, nmmm, pero, mmm, si me vengo, ngh, y sigues tocándome, jaa, jaa,\nrealmente, terminaré loca--”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002570",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, mmm, ah, ah, si sigues, chupándome así, ahn, mm, realmente, ah, ah, ahhhh,\nngh, me vendré--”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes correrte.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002571",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hauh, ahh, ahh, nnn, las mordidas, ngh, que me das, mm, y las vibraciones, ngh,\ncuando, hablas--”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_rna_002572",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ahhh, ngh, muerde, más, ngh, chúpame, más, mmm.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_002573",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ah, ahhh, ngh, ahora sí, kuh, ahaa, ngh, me voy, ngh, me vengo, ah, ah,\nno--”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_rna_h03_09",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002574",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me voy, me voy, ngh, me vengo, ahhhhh, nghhh.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡¡¡*bikubikubikubikun*!!!!",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_rna_h03_09",sync=1,time=1000,vague=100,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002575",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kuh... ¡¡Jaaaaaaaaaaaaaaa!! Nmmmmmmmmmmmmmm.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"――*biku*, *biku*...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rna_002576",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngah, jaa, ngh, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te... viniste?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"bg",file="ev_rna_h03_08",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002577",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo... Jaa... Jaa... así... parece... Jamás, creí... que podría, venirme...\nsolo, con mis pechos...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni yo.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_rna_h03_06",sync=0,face=1,time=400,path=":ev/ev_rna_h03/",set="ev_rna_h03"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002578",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... a-ajajaja, a-así de sensibles, se vuelven... cuando la persona que\namo, los toca... S-Soy algo extraña, ¿verdad? ¿Te di asco?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Te ves hermosa cuando pierdes el control. Tanto que\nquisiera ver más de ti así.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rna_002579",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... me alegra, que me digas eso, pero... quisiera, descansar un poco\nahora... fuh...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Descansar?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rna_002580",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... Me diste mucho placer con mis pechos... y ahora quisiera regresar el\nfavor.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con regresar el favor?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Todavía jadeando, Rina sonríe. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rna_002581",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Es mi turno ahora de hacerte sentir bien a ti, Naoya-san.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se_zubon_out_long"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002582",ch="rna"},
},
ja={
{
name={"Rina"},
"“Considéralo como una breve pausa antes de que vuelvas a tumbarme al suelo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_002583",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora serás tú quien disfrutará, Naoya-san.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Sin mediar palabra, Rina me bajó el pantalón y los calzoncillos.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_rna_h08_01",path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002584",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Hn.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rna_002585",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sabía ya que se vuelven grandes, pero no pensé que tanto. Y además, ya está\nmojado...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me excité escuchando tus gemidos...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_002586",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? E-Es un tanto vergonzoso eso, pero... debo admitir que me alegra.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te... alegra?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rna_002587",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ehm, imagina por un momento esto.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rna_002588",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo... mojando mi ropa interior pensando en ti. ¿No te alegraría eso?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Como no tienes idea!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rna_002589",ch="rna"},
},
ja={
{
name={"Rina"},
"“Oh, vaya. Parece que tu pene reaccionó con alegría también. Ya veo por qué le\nllaman miembro, comparte las mismas emociones que tú...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi compañero es más honesto que yo, podría decir.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rna_002590",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tiene un aspecto sorprendente... pero es un buen muchacho.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tienes miedo?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_rna_002591",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es que me dé miedo... pero, es la primera vez que veo uno así de cerca.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De cerca... ¿Eh? ¿Es que ya has visto otros?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_rna_002592",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No es lo que piensas! Me refiero al David de Miguel Ángel, y ese tipo de\nmiembros.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro, entiendo. Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rna_002593",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No es que haya visto fotos, pero, unas cuantas veces me he, ehm, calentado un\npoco, leyendo especiales de revistas de mujeres relacionados al tema.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Eh?! ¿Muestran penes en las revistas para mujeres?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_rna_002594",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, eso no. Solo que a veces publican ediciones especiales, donde muestran\ntécnicas para chicas que quieren complacer a su pareja.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, me parece haber oído de eso antes...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Al parecer hay hombres que procuran comprar justamente esas ediciones\nespeciales...",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rna_002595",ch="rna"},
},
ja={
{
name={"Rina"},
"“Después de leer, me pongo a pensar en cómo podría complacer a un chico... y me\nimagino cosas...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te excitas?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rna_002596",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, un poco...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A cuál chico te imaginaste en tus fantasías?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_rna_002597",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me vas a hacer decirlo?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo me dio curiosidad...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_rna_002598",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A quién más podría imaginarme?... O-Obviamente a ti, Naoya-san.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... M-Me pone feliz saber eso...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rna_002599",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me reconforta que me digas eso. Pero, personalmente, no creo que a alguien le\npodría agradar una chica tan sucia de mente...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bromeando? Es maravilloso que pienses en hacer todo eso conmigo.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_rna_002600",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? Te haré muchas, muchas cositas entonces ☆. Jeje.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Rina le da cariñosos toquecitos a mi pe*e con su dedo índice.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_rna_002601",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es la primera vez que alguien más te toca?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues obviamente sí. Mi primera y única amante ha sido, por largos años, mi\nmano izquierda.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_rna_002602",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Estás bien? ¿No te duele cuando te toco?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada. Tengo a la chica que amo tocándome, obviamente se siente bien.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_rna_002603",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... Qué lindas cosas me dices.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que leas esa clase de revistas. Ya con tener a mi chica\nchupándomelo... basta y me sobra.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_rna_002604",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Chupar?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No... ibas a hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_rna_002605",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pensaba... hacerlo con mis manos...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-P-Pues, seguramente tus manos se sentirán muy bien igualmente!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_rna_002606",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, mentira, mentira.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_rna_002607",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si prefieres que lo haga con las manos, lo haré, pero... no creo que pueda\nganarle a tu vieja amante de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, para nada, estoy seguro de que tu mano supera por creces a mi vieja\namante!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_rna_002608",ch="rna"},
},
ja={
{
name={"Rina"},
"“Claro, ¿y cómo olvidar que hace un rato intentaste aliviarte con esa vieja\namante?...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_rna_002609",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo bromeo. J-Jamás podría jugar contigo de esa manera, Naoya-san... Nada me\nalegraría más que hacerte sentir bien.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agh.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*, *bikun*",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_rna_002610",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, parece que tu compañero sabe responder por ti.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué puedo hacer? Por más que intente detenerlo igual habla por sí solo.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rna_002611",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ejeje, así de ansioso estará por esto, supongo...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_rna_002612",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Esto... b-bien, ehm... c-comencemos, presentándonos...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Presentándonos?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_rna_002613",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Desde hoy y por muchos años más me encargaré de servirle a tu pe*e, así que\ndebo presentarme...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Los labios de Rina se acercan lentamente a mi miembro.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"El hermoso rostro de Rina, y mi pene. El irreal contraste en esa escena me\nderretía por dentro...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_rna_002614",ch="rna"},
},
ja={
{
name={"Rina"},
"*chuu*...",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*biku*",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hiii.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"bg",file="ev_rna_h08_03",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002615",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso fue un extraño chillido...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo fue...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_rna_002616",ch="rna"},
},
ja={
{
name={"Rina"},
"“Apenas le di un besito... Realmente es sensible.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que, la misma Rina que llevo conociendo tanto tiempo, acaba de darle un\nbeso a mi pene...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_rna_002617",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Pero esto solo fue un saludo, para presentarme. También puedo hacer\nesto... *rero*”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"bg",file="ev_rna_h08_04",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gwah... ah...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Por un instante no podía comprender lo que había pasado.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Solo sé que algo tierno y mojado había pasado lamiendo mi miembro, desde el\ncuerpo hasta la cabeza.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"bg",file="ev_rna_h08_03",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahh...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
vo={
{"vo",file="fem_rna_002618",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que, esto se siente tan irreal... q-quiero decir... Acabas de lamerme\nabajo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_rna_002619",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo hice. Sentí un olor y un sabor muy sucio.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, es que fue ayer que me duché...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="fem_rna_002620",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y me gustó. Sentí ese olor y sabor que se acumula tras una noche... Ese olor me\nacelera el pulso... me hizo estremecer.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estremecer?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_rna_002621",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tal cual. Es tan sucio, este olor...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rna_002622",ch="rna"},
},
ja={
{
name={"Rina"},
"“*uuhh uuhh*... *uuhh uuhh*... ngh, mm... --- haaa... ah...”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Rina aspira el olor de mi pene.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Ahí?... Ugh...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_rna_002623",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es realmente tan, sucio, este olor... Y-Y ahora me lo chuparé todo... E-Esto me\nexcita...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te excita?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_rna_002624",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... La sola idea de que ahora chuparé todo este caliente miembro... me\nexcita... Siento, que me derrito por dentro... *rero*.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Al decir eso, Rina sacó su lengua.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"bg",file="ev_rna_h08_04",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002625",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahh... i-increíble... así es tu sabor... *rerorerorero*... Me siento, tan\nfeliz... de poder chupar, tu pe*e, Naoya-san... *rerorero*... me encanta,\neste olor... Jaa, *rerorerorero*...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_rna_002626",ch="rna"},
},
ja={
{
name={"Rina"},
"“Desde hace un rato, ha estado saliendo... un delicioso líquido, de la punta...\nEl olor se ha esparcido por todo tu pe*e, y... ngh, *rerorerorero*... es tan,\nprovocativo, este olor...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahhh... se siente, geniaaal...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*biku* *bikubikubikun*",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"La lengua de Rina se adhiere amorosamente a mi miembro. Dándome, obviamente, un\nplacer que nunca antes había sentido.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Apenas alcanzo a contener mis gemidos ante esa caliente y tierna sensación.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
vo={
{"vo",file="fem_rna_002627",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahh... qué felicidad... No puedo creer que estoy lamiendo tu pe*e... Es\ndemasiada felicidad... *rerorerorero*... Qué bien huele...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡A-A-Ahhhh!! ¡S-Se siente, demasiado bieeen!”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="fem_rna_002628",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?... Me alegra tanto que disfrutes que te chupe... es como un sueño...\n*chu*, *chuchu*, ngh, qué alegría, *rero*, *chupa*, *reru*.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, s-se siente increíble, pero no quiero que te fuerces tanto.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_rna_002629",ch="rna"},
},
ja={
{
name={"Rina"},
"“Haauh... ¿Que no me fuerce? ¿Qué quieres decir? *rero*, *chuchu*,*chupa*...\n*reorero*... *kuchuu*... *chupa*...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo pensé que quizás estabas cansada de tanto tener la boca abierta...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_rna_002630",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero qué dices... ¿Quién podría preocuparse por algo tan estúpido?... Teniendo\nenfrente el rostro de placer de la persona que tanto quieres mientras le\nchupas el pene... nghh.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_rna_002631",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, *rero*, *chupa*, ngh, ahora quisiera... solo si quieres, pero... ¿me\ndejarías, tragármelo todo?”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... ¿T-Todo?”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="fem_rna_002632",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chuu*, *rero*, *chuchuu*, sí, ngh... *reru*, *shrrr*... no me basta con\nlamerlo... quiero, sentirte, con mi boca...”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues... claro que me encantaría... pero...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="fem_rna_002633",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chuu*, *rero*, *chupa*, si te lo pido, es porque quiero hacerlo... *chu*,\n*chu*, *chu*... Es mi placer... darte placer, mi amado Naoya...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“----”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*biku*, *bikubiku*!",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
vo={
{"vo",file="fem_rna_002634",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kyah... ahn... acaba, de palpitar... ¿Tanto así lo deseas, Naoya-san?”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí... después de escuchar eso...”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="fem_rna_002635",ch="rna"},
},
ja={
{
name={"Rina"},
"“*rerorero*... Todo, lo que dije, es lo que siento... *rerorero*... *picha*,\n*kuchuu*... y además, yo también estoy excitada... mientras te hago esto...”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Estás excitada?”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="fem_rna_002636",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí... Desde hace un buen rato mi vag*na no deja de palpitar, entre cada\nlamida que le doy a tu pe*e... Probablemente mis pantis están goteando\nahora mismo...”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_rna_002637",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chuu*, *rerorero*... el chico que amo, disfruta de lo que le hago con mi\nboca... Cómo... ¿Cómo, evitar que mi vag*na lo sienta también?”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_rna_002638",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya viste la clase de chica que soy, una que se corre solo con que le chupen\nlos pechos... ¿Cómo, no podría excitarme... chupando tu pene?...”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_rna_002639",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... *rerorerureru*... nhaa... ¿Estás, decepcionado... *shrrr*,\n*rero*... de verme, así?”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cómo, crees, que podría estarlo?... Es más, que obvio... que me encantas\nasí.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="fem_rna_002640",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué, ali, vio... ngh, deja, entonces... *shurrr*, hacerte sentir mucho, mucho\nmejor, con mi bocaaa... huuh...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
vo={
{"vo",file="fem_rna_002641",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahm... *nyushrrrrr*”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"bg",file="ev_rna_h08_05",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ack?!”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikubikubikun*",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
"Una sensación completamente distinta a lo que había sentido hasta ahora me\ninvade abajo.",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"Siento mi miembro envuelto en un caliente líquido, a la vez que su lengua lo\nenvuelve.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"Sin poder evitarlo, comienzo a gemir de una manera patética.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡¡Kyaaaauuuu!!!”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_rna_002642",ch="rna"},
},
ja={
{
name={"Rina"},
"“Inqueíble'... tu pe*e, está dentro de mí... y es tan caliente.... ah, está\npalpitando, está palpitando bastante, dentro de mí...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Agh, ah, ah, ahhhh... ah.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"Líquido preseminal comienza a salir de mi miembro.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"bg",file="ev_rna_h08_04",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002643",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Shrrr?! ¡Slurrppp!... *rerorero*... *Shrrr*, ngah, e-es, asombroso, Naoya-\nsan... está, saliendo tanto... *shrrr*... es tan, sensual...”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡¡A-Ahhh, aAahhhhh!!”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="fem_rna_002644",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tus gémidos... *chuu*, *chrr*, *rerorerorero*... tu cara, lo estás\ndisfrutando... estoy, feliz... de que puedo, complacerte... haguh...”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"Rina mete más de mi miembro en su boca.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"bg",file="ev_rna_h08_05",sync=0,face=1,time=400,path=":ev/ev_rna_h08/",set="ev_rna_h08"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikubiku*",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, kaaah, a-ah, s-se siente, demasiado bien.”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_rna_002645",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... estoy feliz... de ver esa cara tuya... estoy, tan feliiiz...\n¡¡¡¡Kuuhhhhhhh!!!!”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, ah, ahh! ¡¡¡AAaahhhhhh!!!”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_rna_002646",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chrr*... *rero*... *chuchupah*, ngh, por más que lama, y lama... sigue,\nsaliendo, ngh, y en mi boca, ngh, está... ahora, impregnada, con tu sabor...\n*shrrrrrr*”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no más, R-Rina, déjame ir.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_rna_002647",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puhaaa... ¿Eh? *rerorero*, ¿por -*chupaa* qué? *chuchupaa*...”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo más... estoy, ngh, a punto de venirme.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="fem_rna_002648",ch="rna"},
},
ja={
{
name={"Rina"},
"“*chuchu*, *rero*, ngh, está bien... ngh, puedes, venirte, *reru*, *shrrrr*.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, s-si sigues haciendo eso--”",
{"rt2"},
},
},
},
linkback="block_00348",
