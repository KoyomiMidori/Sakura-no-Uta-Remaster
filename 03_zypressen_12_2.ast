linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
"Ambos estamos sintiéndonos más a gusto. Es la primera vez para los dos, y la\nverdad, la angustia de si realmente podría hacerlo bien me carcomía.",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
ja={
{
