{"rt2"},
},
},
},
linkback="block_00500",
linknext="block_00502",
},
block_00502={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se siente tan bien, que... creo que podría venirme en cualquier momento...”",
{"rt2"},
},
},
},
linkback="block_00501",
linknext="block_00503",
},
block_00503={
{"text"},
text={
vo={
{"vo",file="fem_rna_002704",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Pues, aguanta como puedas. Yo también me aguanté...”",
{"rt2"},
},
},
},
linkback="block_00502",
linknext="block_00504",
},
block_00504={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si lo saco ahora no sufrirás tanto.”",
{"rt2"},
},
},
},
linkback="block_00503",
linknext="block_00505",
},
block_00505={
{"text"},
text={
vo={
{"vo",file="fem_rna_002705",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué falta de delicadeza decir eso...”",
{"rt2"},
},
},
},
linkback="block_00504",
linknext="block_00506",
},
block_00506={
{"text"},
text={
ja={
{
"Rina me abraza.",
{"rt2"},
},
},
},
linkback="block_00505",
linknext="block_00507",
},
block_00507={
{"text"},
text={
vo={
{"vo",file="fem_rna_002706",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por fin, pudimos consumar nuestro amor... quisiera, alargar este momento lo más\nque pueda...”",
{"rt2"},
},
},
},
linkback="block_00506",
linknext="block_00508",
},
block_00508={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-En serio?...”",
{"rt2"},
},
},
},
linkback="block_00507",
linknext="block_00509",
},
block_00509={
{"text"},
text={
vo={
{"vo",file="fem_rna_002707",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además... ya el dolor pasó bastante...”",
{"rt2"},
},
},
},
linkback="block_00508",
linknext="block_00510",
},
block_00510={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En verdad? No estás fingiendo, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00509",
linknext="block_00511",
},
block_00511={
{"text"},
text={
vo={
{"vo",file="fem_rna_002708",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no. Ya puedes moverte...”",
{"rt2"},
},
},
},
linkback="block_00510",
linknext="block_00512",
},
block_00512={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00511",
linknext="block_00513",
},
block_00513={
{"text"},
text={
ja={
{
"Comienzo a mover mis caderas cuidadosamente.",
{"rt2"},
},
},
},
linkback="block_00512",
linknext="block_00514",
},
block_00514={
{"text"},
text={
vo={
{"vo",file="fem_rna_002709",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nkuhhh... Ngh, huu... ¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00513",
linknext="block_00515",
},
block_00515={
{"text"},
text={
ja={
{
"Mi pene entra y sale una y otra vez, lentamente, de la vagina de Rina.",
{"rt2"},
},
},
},
linkback="block_00514",
linknext="block_00516",
},
block_00516={
{"text"},
text={
ja={
{
"――*nyuchuu*... *nyuchuu*...",
{"rt2"},
},
},
},
linkback="block_00515",
linknext="block_00517",
},
block_00517={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... s-se siente, muy bien, pero... Jaa, jaa... R-Rina, ¿estás bien?...”",
{"rt2"},
},
},
},
linkback="block_00516",
linknext="block_00518",
},
block_00518={
{"text"},
text={
vo={
{"vo",file="fem_rna_002710",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kuh... estaría mintiendo si dijera que no me duele, pero... estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00517",
linknext="block_00519",
},
block_00519={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... por mi parte, ya estoy en mi límite...”",
{"rt2"},
},
},
},
linkback="block_00518",
linknext="block_00520",
},
block_00520={
{"text"},
text={
vo={
{"vo",file="fem_rna_002711",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Estás a punto de venirte? Vamos, aguanta un poco más.”",
{"rt2"},
},
},
},
linkback="block_00519",
linknext="block_00521",
},
block_00521={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Vas a prolongar tu dolor...”",
{"rt2"},
},
},
},
linkback="block_00520",
linknext="block_00522",
},
block_00522={
{"text"},
text={
vo={
{"vo",file="fem_rna_002712",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si insisto es porque algo mucho mejor me espera tras el dolor...”",
{"rt2"},
},
},
},
linkback="block_00521",
linknext="block_00523",
},
block_00523={
{"text"},
text={
ja={
{
"Entre cada inserción y retracción, la hinchada zona privada de Rina se hinchaba\ny se encogía.",
{"rt2"},
},
},
},
linkback="block_00522",
linknext="block_00524",
},
block_00524={
{"text"},
text={
ja={
{
"Viendo su carne moviéndose de esa manera, entro en cuenta de que realmente\nestoy dentro de ella.",
{"rt2"},
},
},
},
linkback="block_00523",
linknext="block_00525",
},
block_00525={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja... realmente, está adentro...”",
{"rt2"},
},
},
},
linkback="block_00524",
linknext="block_00526",
},
block_00526={
{"text"},
text={
vo={
{"vo",file="fem_rna_002713",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Adentro?... Kufuh... Está, entrando, y saliendo.”",
{"rt2"},
},
},
},
linkback="block_00525",
linknext="block_00527",
},
block_00527={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí, lo sé. Lo estoy viendo todo...”",
{"rt2"},
},
},
},
linkback="block_00526",
linknext="block_00528",
},
block_00528={
{"text"},
text={
vo={
{"vo",file="fem_rna_002714",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me veas tanto ahí. Podrías verme... a los ojos... por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00527",
linknext="block_00529",
},
block_00529={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No niego que es una idea romántica, pero... se me hace más excitante ver cómo\nnos unimos abajo...”",
{"rt2"},
},
},
},
linkback="block_00528",
linknext="block_00530",
},
block_00530={
{"text"},
text={
vo={
{"vo",file="fem_rna_002715",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kuh... ¿v-vas, a salir con eso?...”",
{"rt2"},
},
},
},
linkback="block_00529",
linknext="block_00531",
},
block_00531={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo puedo evitar, realmente es excitante... Solo pensar que mi pe*e está\nentrando dentro de ti ahora... es, como un sueño...”",
{"rt2"},
},
},
},
linkback="block_00530",
linknext="block_00532",
},
block_00532={
{"text"},
text={
vo={
{"vo",file="fem_rna_002716",ch="rna"},
},
ja={
{
name={"Rina"},
"“No te preocupes, si fuese un sueño no dolería tanto...”",
{"rt2"},
},
},
},
linkback="block_00531",
linknext="block_00533",
},
block_00533={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sabía, sí te duele.”",
{"rt2"},
},
},
},
linkback="block_00532",
linknext="block_00534",
},
block_00534={
{"text"},
text={
vo={
{"vo",file="fem_rna_002717",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dolía hasta hace poco... pero ahora...”",
{"rt2"},
},
},
},
linkback="block_00533",
linknext="block_00535",
},
block_00535={
{"text"},
text={
ja={
{
"Rina vuelve a cruzar sus brazos sobre mis caderas.",
{"rt2"},
},
},
},
linkback="block_00534",
linknext="block_00536",
},
block_00536={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00535",
linknext="block_00537",
},
block_00537={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*zuchuu*, *zuchuu*, *zuchuu*!",
{"rt2"},
},
},
},
linkback="block_00536",
linknext="block_00538",
},
block_00538={
{"bg",file="ev_rna_h07_07",sync=0,face=1,time=400,path=":ev/ev_rna_h07/",set="ev_rna_h07"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002718",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hyuuh, ah, ah, ah, p-pero, ahora... p-puedes moverte... sin problema.”",
{"rt2"},
},
},
},
linkback="block_00537",
linknext="block_00539",
},
block_00539={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De... verdad?... ¿No te duele?”",
{"rt2"},
},
},
},
linkback="block_00538",
linknext="block_00540",
},
block_00540={
{"bg",file="ev_rna_h07_06",sync=0,face=1,time=400,path=":ev/ev_rna_h07/",set="ev_rna_h07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002719",ch="rna"},
},
ja={
{
name={"Rina"},
"“Escucha... ¿te parece que me duele?”",
{"rt2"},
},
},
},
linkback="block_00539",
linknext="block_00541",
},
block_00541={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*shrp*, *shrp*, *shrrr*...",
{"rt2"},
},
},
},
linkback="block_00540",
linknext="block_00542",
},
block_00542={
{"text"},
text={
ja={
{
"Más y más fluidos viscosos son despedidos del interior de Rina. Y en cada\ncontacto con mi miembro, se escuchaba un sucio y sensual, húmedo sonido.",
{"rt2"},
},
},
},
linkback="block_00541",
linknext="block_00543",
},
block_00543={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cómo suena...”",
{"rt2"},
},
},
},
linkback="block_00542",
linknext="block_00544",
},
block_00544={
{"text"},
text={
vo={
{"vo",file="fem_rna_002720",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí... creo, que estoy excitada... quizás sí duele, pero... es más intensa, la\nexcitación, y... ya no siento casi, dolor...”",
{"rt2"},
},
},
},
linkback="block_00543",
linknext="block_00545",
},
block_00545={
{"text"},
text={
vo={
{"vo",file="fem_rna_002721",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ves?... Muévete más...”",
{"rt2"},
},
},
},
linkback="block_00544",
linknext="block_00546",
},
block_00546={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00545",
linknext="block_00547",
},
block_00547={
{"text"},
text={
ja={
{
"Acelero el movimiento de mis caderas. Meto, y saco, y entre cada período el\nlíquido rojizo que estaba mezclado con sus fluidos vaginales va diluyéndose.",
{"rt2"},
},
},
},
linkback="block_00546",
linknext="block_00548",
},
block_00548={
{"bg",file="ev_rna_h07_08",sync=0,face=1,time=400,path=":ev/ev_rna_h07/",set="ev_rna_h07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002722",ch="rna"},
},
ja={
{
name={"Rina"},
"“A-Ahh... se siente, algo bien... Naoya-san, me gusta... Jaa, fuh, jaa... a-ah,\nahhnnn, ¡ahn, ahn, ah, ah, ahhh!”",
{"rt2"},
},
},
},
linkback="block_00547",
linknext="block_00549",
},
block_00549={
{"text"},
text={
vo={
{"vo",file="fem_rna_002723",ch="rna"},
},
ja={
{
name={"Rina"},
"“Increíble, es increíble, te siento moviéndote dentro de mí, Naoya-san.”",
{"rt2"},
},
},
},
linkback="block_00548",
linknext="block_00550",
},
block_00550={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡Nyuchu, nyuchu, nyuchu...!!",
{"rt2"},
},
},
},
linkback="block_00549",
linknext="block_00551",
},
block_00551={
{"text"},
text={
ja={
{
"El viscoso sonido de nuestros fluidos se mezcla con nuestras voces y mi\nrespiración.",
{"rt2"},
},
},
},
linkback="block_00550",
linknext="block_00552",
},
block_00552={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, Rina... se siente, t-tan bien, adentro...”",
{"rt2"},
},
},
},
linkback="block_00551",
linknext="block_00553",
},
block_00553={
{"text"},
text={
vo={
{"vo",file="fem_rna_002724",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, hauh... ¿s-sí?... Me alegra saberlo...”",
{"rt2"},
},
},
},
linkback="block_00552",
linknext="block_00554",
},
block_00554={
{"text"},
text={
ja={
{
"El interior de la vagina de Rina estaba cubierto completamente en un caliente y\nviscoso fluido. Sus paredes internas, tan calientes que podrían quemar mi\nmiembro, me envolvían con firmeza.",
{"rt2"},
},
},
},
linkback="block_00553",
linknext="block_00555",
},
block_00555={
{"text"},
text={
ja={
{
"Se siente extremadamente bien... Si bajo la guardia, podría venirme en\ncualquier instante.",
{"rt2"},
},
},
},
linkback="block_00554",
linknext="block_00556",
},
block_00556={
{"text"},
text={
vo={
{"vo",file="fem_rna_002725",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... Ahora que me doy cuenta, tu cara... Naoya-san, pareces estar\ndisfrutándolo bastante... Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00555",
linknext="block_00557",
},
block_00557={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... al menos yo, sí me siento, muy bien...”",
{"rt2"},
},
},
},
linkback="block_00556",
linknext="block_00558",
},
block_00558={
{"text"},
text={
vo={
{"vo",file="fem_rna_002726",ch="rna"},
},
ja={
{
name={"Rina"},
"“No te preocupes por mí... no, me duele...”",
{"rt2"},
},
},
},
linkback="block_00557",
linknext="block_00559",
},
block_00559={
{"text"},
text={
vo={
{"vo",file="fem_rna_002727",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y además... solo con verte muriéndote de placer conmigo... solo con eso, yo...”",
{"rt2"},
},
},
},
linkback="block_00558",
linknext="block_00560",
},
block_00560={
{"text"},
text={
ja={
{
"Rina me abraza.",
{"rt2"},
},
},
},
linkback="block_00559",
linknext="block_00561",
},
block_00561={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rinaaa...”",
{"rt2"},
},
},
},
linkback="block_00560",
linknext="block_00562",
},
block_00562={
{"text"},
text={
ja={
{
"La abrazo, y siento entonces el aliento que se escapaba de entre sus labios.",
{"rt2"},
},
},
},
linkback="block_00561",
linknext="block_00563",
},
block_00563={
{"text"},
text={
vo={
{"vo",file="fem_rna_002728",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me siento tan feliz, cuando me abrazas... a-ahn, ah... Jaa, jaa... Puedo\nescuchar... tu respiración... Sé, que estás excitado...”",
{"rt2"},
},
},
},
linkback="block_00562",
linknext="block_00564",
},
block_00564={
{"text"},
text={
vo={
{"vo",file="fem_rna_002729",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me siento, tan... Jaa, jaaa, jaa... ngh... feliz... hauuh.”",
{"rt2"},
},
},
},
linkback="block_00563",
linknext="block_00565",
},
block_00565={
{"text"},
text={
ja={
{
"Abrazados los dos, muevo fuertemente mis caderas.",
{"rt2"},
},
},
},
linkback="block_00564",
linknext="block_00566",
},
block_00566={
{"quake"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002730",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hiiii, Naoya-san, ah, ah, tu pe*e, se mueve, dentro de mí... ngh, qué\nfelicidad, se siente tan bien... ngh, me encan, ta, ah--”",
{"rt2"},
},
},
},
linkback="block_00565",
linknext="block_00567",
},
block_00567={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa... Rina, yo también... tu interior, está tan caliente, y mojado, se\nsiente, muy bien...”",
{"rt2"},
},
},
},
linkback="block_00566",
linknext="block_00568",
},
block_00568={
{"text"},
text={
vo={
{"vo",file="fem_rna_002731",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm, ah, jaa, s-sí... se siente tan bien, y no puedo con la felicidad... Jaa,\nuh, ngh, kuh... Jaa, jaa, ngh, estás, jaa, jaa, ah, saliendo, y entrando, en\nmí.”",
{"rt2"},
},
},
},
linkback="block_00567",
linknext="block_00569",
},
block_00569={
{"text"},
text={
vo={
{"vo",file="fem_rna_002732",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, jaa, jaa, kuh, jaa, jaa, ah, ngh, ah, mmm, mi cabeza... se derrite... Jaa,\njaa, está, en, blanco, ah--”",
{"rt2"},
},
},
},
linkback="block_00568",
linknext="block_00570",
},
block_00570={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, yo, también, ja, jaa, mmm, quería, que lo disfrutaras, pero comencé a\nmoverme, y... Jaa, mi cuerpo, ya no me obedece.”",
{"rt2"},
},
},
},
linkback="block_00569",
linknext="block_00571",
},
block_00571={
{"text"},
text={
vo={
{"vo",file="fem_rna_002733",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se siente increíble... hauun... t-todo, mi cuerpo, se siente increíble... Jaa,\njaa... así, que, muévete... ngh... como... quieraaaas.”",
{"rt2"},
},
},
},
linkback="block_00570",
linknext="block_00572",
},
block_00572={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, ngh, eso, haré.”",
{"rt2"},
},
},
},
linkback="block_00571",
linknext="block_00573",
},
block_00573={
{"text"},
text={
vo={
{"vo",file="fem_rna_002734",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... Jaa, ahn... Jaa, jaa... ngh... Naoya-san, tu pe*e, ngh, está...\npalpitando, adentro...”",
{"rt2"},
},
},
},
linkback="block_00572",
linknext="block_00574",
},
block_00574={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, sí, desde hace un rato, ngh, ha estado, palpitando, entre cada\nmovimiento... kuh... ¿L-Lo sientes?”",
{"rt2"},
},
},
},
linkback="block_00573",
linknext="block_00575",
},
block_00575={
{"text"},
text={
vo={
{"vo",file="fem_rna_002735",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaaa... se siente, como si estuvieras, pinchando mi vientre... Jaa, jaa... lo\nsiento.”",
{"rt2"},
},
},
},
linkback="block_00574",
linknext="block_00576",
},
block_00576={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, desde hace un rato he, podido sentir, tu vag*na, estrujándome adentro.”",
{"rt2"},
},
},
},
linkback="block_00575",
linknext="block_00577",
},
block_00577={
{"text"},
text={
vo={
{"vo",file="fem_rna_002736",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Ngh... ¿E-Esto?”",
{"rt2"},
},
},
},
linkback="block_00576",
linknext="block_00578",
},
block_00578={
{"text"},
text={
ja={
{
"Algo aprieta la base de mi miembro.",
{"rt2"},
},
},
},
linkback="block_00577",
linknext="block_00579",
},
block_00579={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, s-sí, eso, ngh, se siente, tan bien, cuando lo haces, que podría--”",
{"rt2"},
},
},
},
linkback="block_00578",
linknext="block_00580",
},
block_00580={
{"text"},
text={
vo={
{"vo",file="fem_rna_002737",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahn... kufuu... a-ahh... e-es que, me gusta tanto, que, no puedo evitar, jaa,\njaa, poner presión, abajo.”",
{"rt2"},
},
},
},
linkback="block_00579",
linknext="block_00581",
},
block_00581={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuuhh...”",
{"rt2"},
},
},
},
linkback="block_00580",
linknext="block_00582",
},
block_00582={
{"text"},
text={
vo={
{"vo",file="fem_rna_002738",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, Naoya-san... ¿Sientes... que te vienes, ya?”",
{"rt2"},
},
},
},
linkback="block_00581",
linknext="block_00583",
},
block_00583={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, desde que comenzamos... pero, creo... creo, que puedo... seguir, un\npoco más.”",
{"rt2"},
},
},
},
linkback="block_00582",
linknext="block_00584",
},
block_00584={
{"text"},
text={
vo={
{"vo",file="fem_rna_002739",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sí?... Pero... no te, exijas, tanto... ngh, créeme, que... ya me he sentido,\nincreíblemente bien.”",
{"rt2"},
},
},
},
linkback="block_00583",
linknext="block_00585",
},
block_00585={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa... Rina, decirle eso a un hombre, solo provocará lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00584",
linknext="block_00586",
},
block_00586={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*yub*, *yub*, *yub*...",
{"rt2"},
},
},
},
linkback="block_00585",
linknext="block_00587",
},
block_00587={
{"text"},
text={
vo={
{"vo",file="fem_rna_002740",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Hiii? Kyauuhh... mmmm... ah, ah, no, kuh... se siente, más fuerte, que\nantesss.”",
{"rt2"},
},
},
},
linkback="block_00586",
linknext="block_00588",
},
block_00588={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, por algo, te dije, que podía, seguir un poco más...”",
{"rt2"},
},
},
},
linkback="block_00587",
linknext="block_00589",
},
block_00589={
{"text"},
text={
vo={
{"vo",file="fem_rna_002741",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa... ya, veo... pero, te preocupas, tanto... por durar, que... kuuh...\naahh.”",
{"rt2"},
},
},
},
linkback="block_00588",
linknext="block_00590",
},
block_00590={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... P-Pues, solo me queda esforzarme en lo demás... Ya me dijiste que no me\nforzara tanto.”",
{"rt2"},
},
},
},
linkback="block_00589",
linknext="block_00591",
},
block_00591={
{"text"},
text={
vo={
{"vo",file="fem_rna_002742",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, jaa, jaa... ah, ahn, kuh, ya veo... eres todo un hombrecito, Naoya-san...\nah, eres tan lindo, jaa, jaa.”",
{"rt2"},
},
},
},
linkback="block_00590",
linknext="block_00592",
},
block_00592={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa manera de elogiarme no me contenta mucho...”",
{"rt2"},
},
},
},
linkback="block_00591",
linknext="block_00593",
},
block_00593={
{"text"},
text={
vo={
{"vo",file="fem_rna_002743",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me importa... Jaa, jaa, te ves tierno, cómo no decirlo... kuhaa... ah.”",
{"rt2"},
},
},
},
linkback="block_00592",
linknext="block_00594",
},
block_00594={
{"text"},
text={
vo={
{"vo",file="fem_rna_002744",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, la manera, en que te esfuerzas, moviendo tus caderas, jaa, jaa, y la\nforma, en que arrugas un poco tus cejas, jaa, jaa, te ves tan lindo.”",
{"rt2"},
},
},
},
linkback="block_00593",
linknext="block_00595",
},
block_00595={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo tienes qué repetir.”",
{"rt2"},
},
},
},
linkback="block_00594",
linknext="block_00596",
},
block_00596={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*yup*, *yup*, *yuo*...",
{"rt2"},
},
},
},
linkback="block_00595",
linknext="block_00597",
},
block_00597={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002745",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kyah, ahn, jaa, jaa, nmmm, vas, demasiado intenso, ahora--”",
{"rt2"},
},
},
},
linkback="block_00596",
linknext="block_00598",
},
block_00598={
{"text"},
text={
vo={
{"vo",file="fem_rna_002746",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm, mmmm, si me das tan fuerte, ah, ah, jaa, jaa, yo, yo--”",
{"rt2"},
},
},
},
linkback="block_00597",
linknext="block_00599",
},
block_00599={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás... por venirte?”",
{"rt2"},
},
},
},
linkback="block_00598",
linknext="block_00600",
},
block_00600={
{"text"},
text={
vo={
{"vo",file="fem_rna_002747",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, ahn, nnmm, creo, jaa, jaa, que, aun no... p-pero, se siente muy\nbien...”",
{"rt2"},
},
},
},
linkback="block_00599",
linknext="block_00601",
},
block_00601={
{"text"},
text={
vo={
{"vo",file="fem_rna_002748",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahn, nmm, jaa, jaa, ngh, ah, ahn.”",
{"rt2"},
},
},
},
linkback="block_00600",
linknext="block_00602",
},
block_00602={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, no puedo, aguantar, mucho más.”",
{"rt2"},
},
},
},
linkback="block_00601",
linknext="block_00603",
},
block_00603={
{"text"},
text={
vo={
{"vo",file="fem_rna_002749",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, ngh, está bien, pue, des, ahn, nghh, venirte.”",
{"rt2"},
},
},
},
linkback="block_00602",
linknext="block_00604",
},
block_00604={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está, bien...”",
{"rt2"},
},
},
},
linkback="block_00603",
linknext="block_00605",
},
block_00605={
{"text"},
text={
vo={
{"vo",file="fem_rna_002750",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ah, jaa, jaa, jaa, nmmmm, ah, ah, ah, nghh.”",
{"rt2"},
},
},
},
linkback="block_00604",
linknext="block_00606",
},
block_00606={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No puedo más... me... ¡¡¡Me vengooo!!!”",
{"rt2"},
},
},
},
linkback="block_00605",
linknext="block_00607",
},
block_00607={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikubikubikuuu*...",
{"rt2"},
},
},
},
linkback="block_00606",
linknext="block_00608",
},
block_00608={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002751",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kyahh, ngah, ah, ah, ahn... ¡¡¡MMmmmmmmmmmnnnn!!!”",
{"rt2"},
},
},
},
linkback="block_00607",
linknext="block_00609",
},
block_00609={
{"text"},
text={
ja={
{
"Una constricción, tan fuerte como jamás antes, me aprieta abajo.",
{"rt2"},
},
},
},
linkback="block_00608",
linknext="block_00610",
},
block_00610={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me corro...... Ahhhhh.... ¡¡¡Aghh!!!”",
{"rt2"},
},
},
},
linkback="block_00609",
linknext="block_00611",
},
block_00611={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*byuru*, *byururu*... *byurururu*...",
{"rt2"},
},
},
},
linkback="block_00610",
linknext="block_00612",
},
block_00612={
{"text"},
text={
ja={
{
"Al mismo tiempo que Rina soltó un largo gemido, me corrí.",
{"rt2"},
},
},
},
linkback="block_00611",
linknext="block_00613",
},
block_00613={
{"text"},
text={
ja={
{
"Un caliente líquido estaba siendo expulsado dentro de Rina.",
{"rt2"},
},
},
},
linkback="block_00612",
linknext="block_00614",
},
block_00614={
{"bg",id=9,lv=9,sync=1,time=500,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=500,alpha=0,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=1000,alpha=255,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_rna_h07_09",sync=1,time=1000,vague=100,path=":ev/ev_rna_h07/",set="ev_rna_h07"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002752",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, agh, ah, ah, ah... e-está... entrando...”",
{"rt2"},
},
},
},
linkback="block_00613",
linknext="block_00615",
},
block_00615={
{"text"},
text={
ja={
{
"A pesar de haberme ido, sigo moviéndome, golpeando a Rina con mi zona inferior.",
{"rt2"},
},
},
},
linkback="block_00614",
linknext="block_00616",
},
block_00616={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*yub*... *yup*... *yuuu*...",
{"rt2"},
},
},
},
linkback="block_00615",
linknext="block_00617",
},
block_00617={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00616",
linknext="block_00618",
},
block_00618={
{"bg",file="ev_rna_h07_10",sync=0,face=1,time=400,path=":ev/ev_rna_h07/",set="ev_rna_h07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002753",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, jaa... nghhh... te, viniste, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00617",
linknext="block_00619",
},
block_00619={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00618",
linknext="block_00620",
},
block_00620={
{"text"},
text={
vo={
{"vo",file="fem_rna_002754",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... jaa... se sintió... tan, bien...”",
{"rt2"},
},
},
},
linkback="block_00619",
linknext="block_00621",
},
block_00621={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... no pude lograr que te vinieras...”",
{"rt2"},
},
},
},
linkback="block_00620",
linknext="block_00622",
},
block_00622={
{"text"},
text={
vo={
{"vo",file="fem_rna_002755",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, ya me había venido cuando jugaste con mis pechos...”",
{"rt2"},
},
},
},
linkback="block_00621",
linknext="block_00623",
},
block_00623={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No funcionó con la vagina... pero sí con los pechos...”",
{"rt2"},
},
},
},
linkback="block_00622",
linknext="block_00624",
},
block_00624={
{"text"},
text={
vo={
{"vo",file="fem_rna_002756",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y-Y qué importa? Mis senos son sensibles... Hmph...”",
{"rt2"},
},
},
},
linkback="block_00623",
linknext="block_00625",
},
block_00625={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí que lo son...”",
{"rt2"},
},
},
},
linkback="block_00624",
linknext="block_00626",
},
block_00626={
{"text"},
text={
vo={
{"vo",file="fem_rna_002757",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo son... ¿Eh? Naoya-san, tu cosita... está, encogiéndose dentro de mí...”",
{"rt2"},
},
},
},
linkback="block_00625",
linknext="block_00627",
},
block_00627={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya van dos veces, y sin parar. Tenía que encogerse.”",
{"rt2"},
},
},
},
linkback="block_00626",
linknext="block_00628",
},
block_00628={
{"text"},
text={
vo={
{"vo",file="fem_rna_002758",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Yo también estoy saciada por hoy.”",
{"rt2"},
},
},
},
linkback="block_00627",
linknext="block_00629",
},
block_00629={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno.”",
{"rt2"},
},
},
},
linkback="block_00628",
linknext="block_00630",
},
block_00630={
{"text"},
text={
vo={
{"vo",file="fem_rna_002759",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero, solo un poquito más, quisiera--”",
{"rt2"},
},
},
},
linkback="block_00629",
linknext="block_00631",
},
block_00631={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00630",
linknext="block_00632",
},
block_00632={
{"text"},
text={
vo={
{"vo",file="fem_rna_002760",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quisiera, que me abrazaras por un poquito más...”",
{"rt2"},
},
},
},
linkback="block_00631",
linknext="block_00633",
},
block_00633={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo eso? Tanto como quieras.”",
{"rt2"},
},
},
},
linkback="block_00632",
linknext="block_00634",
},
block_00634={
{"text"},
text={
vo={
{"vo",file="fem_rna_002761",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, *chuu*, ngah.”",
{"rt2"},
},
},
},
linkback="block_00633",
linknext="block_00635",
},
block_00635={
{"text"},
text={
vo={
{"vo",file="fem_rna_002762",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esperaba un abrazo y terminé recibiendo además un beso...”",
{"rt2"},
},
},
},
linkback="block_00634",
linknext="block_00636",
},
block_00636={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque quería hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00635",
linknext="block_00637",
},
block_00637={
{"text"},
text={
vo={
{"vo",file="fem_rna_002763",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00636",
linknext="block_00638",
},
block_00638={
{"text"},
text={
vo={
{"vo",file="fem_rna_002764",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quisiera quedarme aquí por un buen rato, pero...”",
{"rt2"},
},
},
},
linkback="block_00637",
linknext="block_00639",
},
block_00639={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te tardas mucho...”",
{"rt2"},
},
},
},
linkback="block_00638",
linknext="block_00640",
},
block_00640={
{"text"},
text={
vo={
{"vo",file="fem_rna_002765",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi podría aparecerse en cualquier momento.”",
{"rt2"},
},
},
},
linkback="block_00639",
linknext="block_00641",
},
block_00641={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00640",
linknext="block_00642",
},
