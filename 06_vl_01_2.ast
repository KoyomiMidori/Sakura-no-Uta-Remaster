astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="zeveningsky_winter",speed=240000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Ya no me quedaban más diligencias por ese día.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Un profesor de tiempo parcial no tiene más trabajo aparte de sus clases\nasignadas.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Y tal como Sakizaki-kun señaló, fuera de mis clases asignadas mato el tiempo\nfumando en la azotea, y al terminar por el día regreso a casa, así sea de\nmañana todavía.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Por ende, cargaba siempre con una buena cantidad de tiempo en mis manos.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Con unos trabajillos adicionales podría estabilizar más mi salario, pero\nsiempre he sido flojo para eso, así que invertía mi tiempo libre en\npasatiempos.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Nada especial, eso sí. Armar maquetas plásticas, leer, o salir por ahí.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"A veces voy en las mañanas a montar las olas.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Hace unos años encontré una tabla de surf en la basura, y decidí darle un\nintento.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Era una tabla enorme, de esas conocidas como longboard, así que pude comenzar\ncon facilidad.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Si hubiese sido la convencional, esa que conocen como shortboard, probablemente\nno hubiese seguido.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Yumihari está frente al mar, y a veces, después de pasear por la línea costera,\nme iba al punto.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Uno pensaría que el surf es deporte para jóvenes de ahora, activos. Pero en\nrealidad ves más treintones, e incluso cuarentones y cincuentones.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Se trata de viejos y abuelos flotando como idiotas en el mar.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"El surf se hace solo, así que es ideal para personas sin amigos como yo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Solo tengo que flotar mientras espero una ola.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"'Baño público del mar', le llaman.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Todos esperan flotando en el tranquilo mar.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Y entre tanto flotar y ver el océano sin fin, se me vienen estas ridiculeces a\nla cabeza.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Sea en casa o afuera, por lo general estoy solo.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Pienso en todo eso mientras floto en el mar.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"cgdel",id=-1},
{"se",id=1,file="se1279"},
{"msgoff"},
{"bg",file="bg002b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“He vuelto~”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Obviamente nadie respondió.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ver, ¿qué hago con la cena?...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Por lo general siempre me compro algo en el supermercado de regreso, pero de\ntanto pensar en tonterías acabé viniendo directamente a casa.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmm...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Pues, no está mal comer afuera de vez en cuando.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"msgoff"},
{"se",id=1,sync=1,file="se1343"},
{"se",id=2,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, soy yo, Naoya. ¿No quieres ir a beber hoy?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Por qué debería pagarte la cena? Idiota. Bien, nos vemos en el local de\nsiempre.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"La llamada fue breve y concisa. Nada más, nada menos.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_j02_01",rule=139,vague=40,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000031",ch="ktg"},
},
ja={
{
name={"Hombre"},
"“Bien, quisiera unas dos cervezas~”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a brindarte.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_com_j02_02",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000032",ch="ktg"},
},
ja={
{
name={"Hombre"},
"“¿Por qué? Fuiste tú quien invitó.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es mi problema. Cervezas no, Hoppy por favor, señora.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_ktg_000033",ch="ktg"},
},
ja={
{
name={"Hombre"},
"“¿Cada quien a pagar lo suyo?... Demonios.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_j02_03",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000034",ch="ktg"},
},
ja={
{
name={"Hombre"},
"“¿Y bien? ¿Sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso necesito alguna razón para beber contigo? Por lo general o bebo solo o\ncontigo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_ktg_000035",ch="ktg"},
},
ja={
{
name={"Hombre"},
"“Pues sí, lamentablemente ninguno de los dos tiene amigos.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_j02_04",path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
ja={
{
"Este es Katagai.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Seguramente ninguno de ustedes lo recordará, pero es el tipo que llegamos a\ntratar como personaje de poca importancia.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Es cómico que si bien perdí contacto con los del club de arte, todavía sigo\nconectado con este personaje tan poco relevante.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Aunque, más que conectado, sucede que fuimos los únicos que se quedaron en\nYumihari...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_ktg_000036",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, ya sé, se acercan las graduaciones y estás sentimental, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tal vez. Año tras año, vienen y se van como si nada, esos muchachos.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_ktg_000037",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Como si nada? Ellos toman sus exámenes, consiguen sus créditos y se gradúan\ncon todas las de la ley.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes toda la razón. ¿Y tú, algo nuevo?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="ev_com_j02_05",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000038",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Vas a preguntarle a un empleado de fábrica contratado como yo por algo nuevo?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo qué sé? Jamás he trabajado como empleado contratado de fábrica.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_ktg_000039",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Diablos... Y pensar que todos los demás han conseguido buenos trabajos.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A falta de esfuerzo tuyo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_j02_06",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000040",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“De los dos.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_j02_04",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000041",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Quién diría que seríamos los únicos en permanecer acá...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú no sabes si alguno está trabajando en la ciudad ahora.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_ktg_000042",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Lo sé, pero ninguno de mis conocidos del colegio está acá.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"No tengo casi amigos.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Este tipo es el único con quien a veces salgo a hacer algo.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Y no es que hemos estado en contacto desde el colegio. Simplemente me habló un\ndía cuando, por casualidad, nos encontramos bebiendo en el mismo lugar.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Al parecer ha seguido viniendo al mismo local.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Cada quien solía venir a beber por su cuenta, y como viejos compañeros nos\njuntamos.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Sin embargo, no tenemos casi ningún punto en común en cuanto trabajo y\npasatiempos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Pero creo que eso ha sido lo agradable de juntarnos.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Total, ambos sabemos que nos juntamos por juntarnos. Es agradable.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Nos reunimos dos o tres veces al mes para beber, así como ahora.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Los temas de conversación son tonterías.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Cosas de poca importancia.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_j02_08",path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",file="se9052",id=1},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000006",ch="nnd"},
},
ja={
{
name={"???"},
"“Bueno, bueno, disculpen la demora.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_ktg_000043",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah, Nono-chan, ¿te toca turno hoy acá?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_j02_19",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000007",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ah, sí. Katagai-san, deberías venir a nuestro local también de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_ktg_000044",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sí, debería. Eh, después de esto vayamos al snack de Nono-chan.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo dinero para eso.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_j02_20",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000008",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Vamos, no digas eso, Kusanagi-san. También estás invitado a venir.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú no eres menor de edad? No quiero meterme en problemas.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_j02_09",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000009",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ah, yo no trabajo allí como tal.\nEl snack es negocio de mi familia. ¿No te había contado?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_j02_10",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000010",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ajaja, Kusanagi-san, definitivamente no tienes interés alguno por los demás...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es cierto. Es más, me sé tu nombre. Nonomi-kun, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_j02_11",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000011",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Y mi apellido?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Apellido? Apellido... eh... ah, ehm~”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_com_j02_10",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000012",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Jaa, dios mío, tanto tiempo sirviendo acá y aún no sabes mi nombre completo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_ktg_000045",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Nono-chan tiene toda la razón. Además ella conoce mucho mejor el barrio de\nbares de acá. ¡Es nuestra senpai!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_j02_12",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000013",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Bueno, no en vano nací y me crié en el barrio de Namidagawa. Desde pequeña he\nestado ayudando en estos locales.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000046",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Qué trabajadora eres, Nonomi-chan. Aun con lo linda que eres.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_j02_07",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000014",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Pues gracias por el cumpli~”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_ktg_000047",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No es cumplido, es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm, ya veo. Por cierto, Nonomi-kun, la dueña te está llamando.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="ev_com_j02_13",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000015",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Oh, rayos, cierto. En fin, vayan a mi local cuando puedan, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",file="se9023",id=1},
{"bg",file="ev_com_j02_14",sync=1,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_ktg_000048",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Qué hermosas las jovencitas, ah~ ¿Cuántos años tendrá Nonomi-chan?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000049",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Vamos, ¿ahora pretendes que no te interesa?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me interesa.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_j02_16",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000050",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues te vuelvo a preguntar lo mismo de siempre, Kusanagi, ¿no has pensado en\nsalir con alguna de tus estudiantes?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas idioteces. Son niñas, mocosas. No voy a perder mi tiempo con ellas.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_j02_17",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000051",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pero los profesores de tu edad son populares con las chicas, ¿no? Además,\ntienes buena cara también.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para ellas solo soy un viejo. Ninguna se atrevería a involucrarse conmigo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000052",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Eso crees? ¿Sabes algo? He tenido que llegar a esta edad para darme cuenta de\nlo importante que es un uniforme.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues cómprate uno y duerme con él.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000053",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No me refiero a eso. Ah, me hubiese gustado experimentar más con mi juventud en\nYumihari. Quería enamorarme de alguien. ¿Por qué no me esforcé más en ese\nentonces?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía no veo que te esfuerces.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_ktg_000054",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No hay nada en qué esforzarme... En esa fabrica solo hay hombres...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_j02_15",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000055",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“El éxito en la vida depende de si lograste experimentar el amor en el colegio,\nestoy seguro. Aquellos que lo lograron son los verdaderos triunfadores.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, no sabía que el éxito se medía por ese estándar tan mediocre.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ktg_000056",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Quiero decir, no solo quienes pudieron experimentar el amor, sino también vivir\na plenitud su juventud.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues si tanto quieres conseguir amor, podrías salir a buscar mujeres afuera,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_j02_16",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000057",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Si tuviese la actitud para eso, mi experiencia sexual actual incluiría algo más\nque prostitutas, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ahora hay aplicaciones para el celular con las que puedes conocer gente,\n¿no sabías? Han arrestado a varios tipos como nosotros por andar con menores\nde edad.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_j02_17",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000058",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Ah~, ciertamente. Pues, por conocer no habría problema. Pero yo quiero\nenamorarme...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué lata contigo, eh...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000059",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Y qué hay de ti? Jamás has tenido novia, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, nunca.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_j02_14",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000060",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues supongo que querrás enamorarte, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me interesa.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_j02_15",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="おじぎ",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000061",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Jaa... Qué cosas dices. Tanto dártelas del lobo solitario, ya me lo puedo\nimaginar.\nSentirás la presión al venir los cuarenta.\nTe darás cuenta que podrías acabar solo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja de imaginar cosas tan feas. A esa edad ya estaré casado, seguramente.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000062",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“No sabes de lo que estás hablando, para nada. La gran mayoría de hombres en sus\nveinte que jamás han tenido contacto romántico con mujeres permanecen solos\npor el resto de sus vidas. Leí unas estadísticas de eso.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, leyendo unas estadísticas? Huele a mentira.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_ktg_000063",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pues me topé con eso en la red.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En la red? Qué poca fiabilidad tu fuente...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_j02_16",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
},
},
text={
vo={
{"vo",file="man_ktg_000064",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sea lo que sea, tu momento es ahora. Tus pocos años antes de los treinta son tu\núltima oportunidad. ¿Qué tal tus alumnas? Presentame a alguna, vamos, ¡dame\nel chance a mí también de enamorarme!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me metas a mí en tus actividades criminales, idiota!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_j02_19",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",file="se9049",id=1},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000016",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Bien bien, aquí está la comida.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_j02_09",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000017",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Por cierto, Kusanagi-san, no tienes novia, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Y eso qué importa?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_j02_19",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000018",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿De verdad no tienes? A Nono no le molestaría tomar ese papel.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000065",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Q-Qué? ¿Y-Y yo?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te lo tomes en serio, es solo palabreo dulce. Por eso es que no me gusta\nconversar con empleadas de snack...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_j02_10",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000019",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Yo no trabajo en ningún snack. Es mi madre quien dirige uno.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero trabajas ahí también, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_j02_20",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000020",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ya te dije que no trabajo ahí, simplemente ayudo con las cosas de la casa. Si\nllegara a trabajar formalmente, me cogería la policía.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_ktg_000066",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Lo sabía, eres muy joven, Nono-chan. ¿Y bien, qué tal yo?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_j02_08",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000021",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Katagai-san? Uhmmm, no lo sé. Quizá si tuvieras aires de adulto.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="man_ktg_000067",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Pero si este tipo tampoco es un adulto! Tiene la cabeza de un niño.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cierra la boca. No voy a dejar que justamente tú me digas eso.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_j02_09",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000022",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Aunque ha sido una sorpresa. Realmente pensaba que eras popular con las chicas,\nKusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que me conozcas tanto como para poder afirmar eso.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_j02_08",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_j02_13",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
},
},
text={
vo={
{"vo",file="fem_nnd_000023",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Claro que sí. Eres famoso entre las chicas del salón... Ah.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Salón? ¿Qué acabas de decir?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="ev_com_j02_13",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000024",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“S-Snack. Entre las chicas del snack, sí.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Snack? Me parece que acabas de decir salón...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_j02_10",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000025",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Qué cosas dices, ajajaja. Bien, bien, a trabajar yo me voy.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_j02_14",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"se",file="se9023",id=1},
{"text"},
text={
ja={
{
"Nonomi se aleja de nuestra mesa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000068",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Kuh! ¡Definitivamente no has cambiado nada desde el colegio, Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000069",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡Siempre tú llevándote a las chicas!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te he dicho que eso no es verdad. ¿Cuántas veces debo repetirte que mis años\nsin novia equivalen a mis años de vida?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="ev_com_j02_17",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000070",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Sí, bueno. Algo que siempre me ha gustado de ti es que nunca has intentado\nconseguir novia, a pesar de tu popularidad con las chicas...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_ktg_000071",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿No recuerdas aquel día? Cuando te preguntamos por tu relación con Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_ktg_000072",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Estaban Nakasato, Ichinomiya, Toromi y yo.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_ktg_000073",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“En esos días nos llamabas alumno A, B, C y D.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Si recuerdo que parecían extras de película.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_com_j02_18",sync=0,face=1,time=400,path=":ev/ev_com_j02/",set="ev_com_j02"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000074",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Qué cruel fue eso.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_ktg_000075",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Aunque bueno, ya es cosa del pasado...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y así como ven, siempre hablamos de cosas sin importancia.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"A pesar de eso, es ameno beber con alguien.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Si bien ya estoy acostumbrado a estar solo, no es fácil estarlo siempre.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Es entretenido estar con alguien, aun tratándose de un tipo como este.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Comenzamos a beber a las seis y media, quedándonos charlando y discutiendo\nhasta las diez.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Fueron mil novecientos yenes por cada uno.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Este es de esos lugares donde puedes beber a cien yenes por jarra.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"La primera botella de Hoppy sale en unos cien yenes. Las siguientes en ciento\nochenta.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Y no es el típico combo de botella y jarra con hielo. Te preparan la bebida\ndirectamente en la jarra.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Esto me gusta.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Me gusta así.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="bg068c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",ch="片貝",size="z1",mode=3,resize=1,path=":fg/kat/z1/",file="kat_z1e0000",face="e0002",head="kat_z1e",lv=4,id=9},
{"fgact",ch="片貝",act="うなづく",lv=4,id=9},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000076",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Bueno, mañana tengo trabajo temprano. Ya me voy.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, pues nos vemos. Te vuelvo a escribir un día de estos.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",mode=-2},
{"fg",ch="ノノ未",size="z1",mode=3,resize=1,path=":fg/non/z1/",file="non_z1a0000",face="a0012",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000026",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Eh~, ¿no vendrán a mi local~?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_ktg_000077",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Tengo trabajo mañana temprano.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0000",face="a0008",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000027",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo ya estoy muy borracho para ir.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0000",face="b0008",head="non_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000028",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Vamos, ¿no les aburre venir siempre acá? Vengan a nuestro local al menos una\nvez, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_ktg_000078",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“La próxima iré, te lo aseguro.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, un día de estos que me dé por ir me acercaré.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1b0000",face="b0006",head="non_z1b",lv=4,id=9},
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000029",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Por lo que escucho, no tienes intención alguna de venir, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="man_ktg_000079",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¡No te preocupes! ¡Me encargaré de traerlo conmigo cueste lo que cueste!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0000",face="a0005",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000030",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Asegúrate de hacerlo, por favor. Quiero conversar con él.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si conversas conmigo en el local, eso te haría una empleada. La policía vendrá\npor ti.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0000",face="a0001",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000031",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¿Qué tal fuera del local entonces?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_ktg_000080",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“¿Eh? ¿Te está invitando ahora a una cita?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No seas tonto, se refiere al servicio de compañía que tienen en esos lugares.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_ktg_000081",ch="ktg"},
},
ja={
{
name={"Katagai"},
"“Pero de igual manera necesitarías ir varias veces al snack para poder recibir\nese servicio.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0000",face="a0016",head="non_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000032",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me jodan! ¡Pues nos vemos de nuevo en este bar, Nonomi-kun!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1a0000",face="a0007",head="non_z1a",lv=4,id=9},
{"fgact",ch="ノノ未",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000033",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“¡Ah, vamos~! ¡Tacaño, tacaño, tacaño~!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="znightsky_spring",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Despues de unas cuantas bebidas, me alejé del barrio de tabernas de Namidagawa\ny comencé a caminar hacia casa.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Está fuertemente penado manejar bicicleta bajo los efectos del alcohol, así que\nno puedo montar.Si la policía me pilla me despedirán del colegio al día\nsiguiente.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Salgo del barrio de Namidagawa y camino solo a la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ahora que lo recuerdo, la primera vez que caminé acá fue con Rin...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Sí, fue en su último verano en Yumihari.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Me perdí en el camino y terminé llamándola a ella.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Me vino a buscar en bicicleta hasta Namidagawa.Fue ese día que caminé por\nprimera vez por este barrio.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue tan amable que me guió por el camino...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Creo que una vez dijo que sería mi navegadora exclusiva, o algo así...",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi navegadora exclusiva, eh...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Mi pésimo sentido de la orientación ha mejorado bastante desde entonces.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Ya no me pierdo más en la calle, al menos no en Yumihari.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Ya no necesito a nadie que me haga la navegación. Ya no me pierdo más...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué hermosas están las estrellas...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"El cielo de febrero es bastante claro, y las estrellas se ven con claridad,\nhermosas.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Observo el cielo de la noche mientras intento quitarme la borrachera.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Camino por la ciudad, por esta noche donde las estrellas parecieran estar\nlloviendo.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"El mismo camino que seguí junto con Rin en aquel atardecer.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Pero ahora solo, caminando mientras observaba el firmamento.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Rin dijo esto una vez.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Las personas que ahí vivimos envejecemos... pero la ciudad se renueva, una y\notra vez.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Todo cambia, pero a la vez no cambia...",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"A veces deseo que nada cambie... e igual cambia. Estás en el mismo lugar, y sin\nembargo todo se ve distinto.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"¿Todavía verá el cielo de vez en cuando?",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"¿Tendrá el tiempo para a veces ver las estrellas de la noche con tranquilidad\nallá, en ese lejano lugar donde ahora está?",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Pienso en eso mientras bajo la colina, con el cielo de la noche encima.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
