astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Hoy me vine al colegio sola.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Parece que Rina tenía algo por hacer y se fue temprano.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Aunque bueno, es mejor así.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Fue apenas ayer que vinieron.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Podrían venir a atacarme de nuevo.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"No podría permitirme involucrar a Rina en eso.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Así que, salí sola. Pero--",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenos días, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_yum_002047",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, vaya cara desagradable que me ha tocado ver esta mañana.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000047",ch="jka"},
{"vo",file="fem_jkb_000041",ch="jkb"},
{"vo",file="fem_jkc_000019",ch="jkc"},
{"vo",file="fem_jkd_000022",ch="jkd"},
},
ja={
{
"*Susurros*...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Apenas me topo con Kusanagi-senpai comienzan los cuchicheos.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_yum_002048",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Al ver a los lados me doy cuenta de que hoy también está rodeado por su grupo\nde fanáticas.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Pero qué lata...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Si me hablas vas a meterme en otro gran rollo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"¿Por qué no eres capaz de siquiera entender eso?",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"bg",x=-200,y=-500,speed=200,sync=0,file="zbg044a",path=":bg/",x2=0,y2=-500,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="直哉",size="z2",speed=200,sync=0,mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",x2=0,x=-200,lv=5,id=9},
{"quake"},
{"se",file="se9015",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_002049",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Dénme permiso, por favor!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Intento seguir de largo.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Pero entonces...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",x=-200,lv=5,id=9},
{"fg",ch="直哉",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",x2="-200,50",x=0,lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera, Kawachino... no, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"mwact",act="ジャンプ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002050",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Me sorprendió el hecho de que me tomara del brazo, pero más aún que me llamara\npor mi nombre.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Qué demonios le pasa?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_yum_002051",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿P-Pero qué haces? Me harás enfadar...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",x=0,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue por no ser lo suficientemente claro aquella vez que te enfadaste, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002052",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... ¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jka_000048",ch="jka"},
{"vo",file="fem_jkb_000042",ch="jkb"},
{"vo",file="fem_jkc_000020",ch="jkc"},
{"vo",file="fem_jkd_000023",ch="jkd"},
},
ja={
{
"*Susurros*...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"El volumen de los cuchicheos se hace fuerte.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Dios, qué fastidio.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0005",head="nao_z2a",x=0,lv=5,id=9},
{"fgact",ch="直哉",act="びっくり",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y es por eso que dejaré las cosas claras para todas ustedes!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bgm",stop=1,time=500},
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0022",head="nao_z2a",x=0,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yuumi Kawachino es mi única y auténtica novia! ¡Si alguien llega a hacerle\nalgo no tendré compasión ni piedad alguna!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_yum_002053",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Todas se quedan heladas por un segundo. Para luego--",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm012"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000049",ch="jka"},
{"vo",file="fem_jkb_000043",ch="jkb"},
{"vo",file="fem_jkc_000021",ch="jkc"},
{"vo",file="fem_jkd_000024",ch="jkd"},
},
ja={
{
name={"Alumnas"},
"“EEEEEEHHHhhh.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000050",ch="jka"},
{"vo",file="fem_jkb_000044",ch="jkb"},
{"vo",file="fem_jkc_000022",ch="jkc"},
{"vo",file="fem_jkd_000025",ch="jkd"},
},
ja={
{
name={"Alumnas"},
"#$%&(!!$%(%!))$(/#($/(#!",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Gritan todas al unísono.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Allí estoy yo incluida también, por supuesto.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002054",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿P-Pero qué estás diciendo?! ¡¿Q-Qué dem--?!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="うんうん",lv=5,id=9},
{"se",file="se3130",vol=70,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajajaja, vamos, no seas tan penosa, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Kusanagi rodea mis hombros con su brazo y me acerca a él.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Intenté huir de sus manos, pero es bastante ágil. Volvió a agarrarme con\nfacilidad.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002055",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ughhh.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_yum_002056",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Q-Qué, demonios, haces?!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"se",id=1,file="se_dosun"},
{"cgact",stage="bg044",act="いいえ"},
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0016",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="びっくり",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"*Guooh*",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Le propino un golpe a Kusanagi en la zona del hígado.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0003",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="うんうん",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...... Ajajaja, eres toda una penosita, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_yum_002057",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Nada tiene que ver ahora si lo soy o no!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",lv=5,id=9},
{"quake"},
{"fgact",ch="直哉",act="びっくり",lv=5,id=9},
{"se",file="se_arrow1",id=1},
{"text"},
delay={
