{"se",file="se_attack09",id=4},
{"fgact",ch="直哉",act="うなづく",size=100,lv=5,id=9},
},
[1800]={
{"quake",size=10},
{"se",file="se_attack10",id=5},
{"fgact",ch="直哉",act="quake",size=30,lv=5,id=9},
},
},
text={
ja={
{
name={"Naoya"},
"“Guoh, gaw, uoh, gwah, geh.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Lanzo una ráfaga de golpes sobre su desprotegido estómago.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Pero aun así sigue de pie, riéndose.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"¿Cómo demonios es que aguanta tanto? ¿Es que acaso es inmortal?",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"cgact",stage="bg044",act="いいえ",size=50},
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",lv=5,id=9},
{"quake"},
{"se",file="se_arrow1",id=1,size=50},
{"fgact",ch="直哉",act="いいえ",size=50,lv=5,id=9},
{"text"},
delay={
[200]={
{"se",file="se_attack09",id=2},
{"fgact",ch="直哉",act="うなづく",size=100,lv=5,id=9},
},
[600]={
{"se",file="se_arrow1",id=3},
{"fgact",ch="直哉",act="びっくり",size=100,lv=5,id=9},
},
[800]={
{"se",file="se_attack09",id=4},
{"fgact",ch="直哉",act="うなづく",size=100,lv=5,id=9},
},
[1400]={
{"se",file="se_attack10",id=5},
{"fgact",ch="直哉",act="ドッキリ",lv=5,id=9},
{"quake",size=10},
},
},
text={
ja={
{
name={"Naoya"},
"“Guoh, gaw, uoh, gwah, geh, guoh, gaw, uoh, gwah, geh.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Sigo lanzando golpe tras golpe, pero aun así permanece de pie.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",file="se9010",id=1},
{"fg",ch="直哉",size="z2",zoom=120,speed=800,mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",y2=0,z2=100,y=100,lv=5,id=9},
{"fgact",ch="直哉",act="うんうん",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bien... Yuumi, ¿nos vamos?...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Todavía con su brazo puesto sobre mis hombros, Kusanagi me arrastra con él.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002058",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Suéltame! ¡¿A dónde piensas llevarme?!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",y=100,lv=5,id=9,zoom=120},
{"text"},
delay={
[800]={
{"fgact",ch="直哉",act="ドッキリ",lv=5,id=9},
{"se",id=1,file="se_dosun"},
},
},
text={
ja={
{
name={"Naoya"},
"“A-A algún lugar donde podamos estar a solas-- ¡Gwah!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bgm",stop=1,time=1500},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm009"},
{"fg",ch="直哉",size="z1",mx=40,mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"ex",time=500,func="wait"},
{"fg",time=500,mode=-2},
{"fg",ch="里奈",size="z1",time=500,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"Kusanagi me lleva a la azotea, donde por alguna razón estaba Rina esperando.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002109",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo siento, fui yo quien le pidió el favor a Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_002059",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Me ibas a matar! ¡Jamás vuelvas a golpearme sobre el hígado como si fuera un\nmaldito saco de boxeo!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_002060",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Era lo obvio de hacer después de lo que me hiciste.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tampoco es para llegar a esos extremos, o al menos no deberías!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_yum_002061",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpai, creo que deberías ser un poco más consciente de lo repulsivo que puedes\nllegar a ser...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Hablas en serio?! ¡No puedo creer que me lo digas con esa cara!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_002110",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, lo siento. Y, Kusanagi-senpai, ¡discúlpame!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, no... bueno, yo también tengo parte de la culpa... auch, auch...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_yum_002062",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pero ¿por qué haces esto?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002111",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hablé con las muchachas que te acosaron, y les pregunté por qué hicieron eso.\nMe dijeron que les desagradaba la cercanía que tenías con senpai aun cuando\nni siquiera son novios.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002112",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que esa fue la razón primordial para todo esto.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y de ahí fui yo quien propuso hacerme pasar por tu novio.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_yum_002063",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Fuiste tú al que se le ocurrió esta locura, imbécil?!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002113",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero fui yo quien se lo pidió.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_yum_002064",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002114",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedo estar tranquila sabiendo que estás en todo momento en peligro.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Así son las cosas, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no está ni tan mal, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_yum_002065",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué se supone que hay de bueno en esto?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrás golpearme todo lo que quieras y pretender que solo estamos jugueteando.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_yum_002066",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ouh, ¿eso dices? ¿Poco te pareció la fuerza de mis golpes?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0019",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada. Por eso te lo pido ahora, ten algo de compasión.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002067",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No quiero. Iré con toda intención de matarte.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya cosa... Terminaré muriendo por culpa de este plan.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_yum_002068",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El mismo plan que tú propusiste.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0014",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="うんうん",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, casi lo olvidaba.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="直哉",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="直哉",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Al decir eso, senpai sacó una mochila.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_yum_002069",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa es...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_rna_002115",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tu mochila, Yuumi. Fui a buscarla a primera hora de la mañana...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_yum_002070",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Rina, ¿fuiste a esa pocilga de colegio? ¿N-No te hicieron nada?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_002116",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, fui allá. Y sucedió que...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0019",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La seguí.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rna_002117",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuuh, en ningún momento se me ocurrió que llegarías a seguirme, senpai.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y yo no puedo creer que hayas ido sola a ese colegio, Hikawa. Toda la masa de\nidiotas y malandrines de esta zona está concentrada allí.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rna_002118",ch="rna"},
},
ja={
{
name={"Rina"},
"“No las llames así... Fueron lo suficientemente gentiles como para acordar\nresolver las cosas hablando.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0014",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hablando? ¿En qué momento? Fui yo el que tuvo que ir y quedarse firmando\nautógrafos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rna_002119",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios santo, pero qué tortura fue...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0001",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002071",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-En fin, Rina, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002120",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy perfectamente bien.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_yum_002072",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Menos mal.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa hizo todo esto por ti, como puedes ver. Nada te cuesta aguantar unos\npocos días fingiendo ser mi novia, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_002073",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todavía se me hace terriblemente desagradable la idea. Pero...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_yum_002074",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uhmmm, pues, si me dejas ir a salir a citas con Rina, podría acceder.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002121",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Conmigo? Eso lo arruinaría todo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",mode=-2},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
delay={
[800]={
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"se",id=1,file="se_dosun"},
},
},
text={
ja={
{
name={"Naoya"},
"“Pues resolvamos esto de manera justa y sencilla, vayamos los tres en una cita--\n*geh*.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_yum_002075",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya que no te cansas de proponer ideas estúpidas.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_yum_002076",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Después de pensármelo un poco...",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_002077",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No estaría tan mal.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0006",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si no te parece mal entonces no me golpees de manera automática!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rna_002122",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una cita de tres, suena divertido. Es la primera vez que haré algo así.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo será...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hacemos algo el domingo?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rna_002123",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me parece bien.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_002078",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, me haré pasar por tu novia hasta ese día... Solo cuídate de que nadie\nvenga a cortarte la garganta mientras duermes.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Procuraré cuidarme...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Dios...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Aun no puedo dejar de sorprenderme ante las absurdas ideas de Naoya Kusanagi...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Aunque no puedo negarlo, no he podido quitarme la fatiga de encima después del\nataque de ayer. Me conforta saber que podré liberarme de la presión, al menos\npor unos días.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"El cansancio me ha venido encima de manera repentina. Sinceramente, si hubieran\nseguido acosándome a diario, habría terminado mal.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"En eso estuve pensando, cada vez con la cabeza más nublada y adormecida.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=2000,func="wait"},
{"text"},
text={
ja={
{
"Un mundo cubierto en oscuridad.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Tras ese oscuro mundo se veía.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Un sueño, de hace mil años.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"cgact",stage="bg064",act="びっくり",loop=-1,size=5,time=200,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"bgm",file="bgm025"},
{"se",id=1,file="se0744"},
{"text"},
text={
ja={
{
"Estaba ahora corriendo por un sendero nocturno, privado de la luz de la luna.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"A lo lejos se podía ver las brillantes llamas de las antorchas, ondeando.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"se",id=1,file="se_run_fast"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"cgact",stage="bg064",act="びっくり",loop=-1,size=5,time=100,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"text"},
text={
vo={
{"vo",file="man_kaa_000001",ch="kaa"},
},
ja={
{
name={"Sirviente A"},
"“¿Algún rastro?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kab_000001",ch="kab"},
},
ja={
{
name={"Sirviente B"},
"“Nada por acá.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_kaa_000002",ch="kaa"},
},
ja={
{
name={"Sirviente A"},
"“¡Sigue buscando! ¡No quiero ni imaginarme lo que nos hará Housou-sama si no los\nencontramos!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"se",file="se9055",id=1,loop=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"cgact",stage="bg064",act="びっくり",loop=-1,size=5,time=200,sync=0},
{"bg",id=9,lv=9,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"text"},
text={
vo={
{"vo",file="man_yod_000113",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Jaa, jaa... Ya llegaron hasta acá... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="伯奇",size="z2",mode=3,resize=1,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000071",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ya... estoy mejor. Estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Huí hasta acá, cargando a Hakuki-dono sobre mi espalda.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="man_yod_000114",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Bien?! ¡Usted no está bien, ni siquiera puede ponerse de pie!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000072",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Housou mantuvo a Hakuki-dono encerrada desde aquel día en que vomitó las\npesadillas de mi padre.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Pero ninguna de las otras sacerdotisas disponibles tenía el talento de\nHakuki-dono, y poco tiempo después volvió a participar en las ceremonias Da.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Siguió convirtiendo las pesadillas, oscuros pensamientos de mi padre, en agua.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Pero ya no podía tragárselos.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Ni una sola gota.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Quizás, porque abrió su corazón.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Ahora con un corazón propio, ya no podía alojar en sí el de los demás.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Y desde entonces, comenzó a verse atormentada por todas aquellas pesadillas que\nestuvo tragando hasta el día de hoy.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Su cuerpo se debilitaba con cada día que pasaba, y ahora a duras penas puede\nhablar.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_yod_000115",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Por qué debe usted alojar las pesadillas de mi padre? Un verdadero samurái\ndebería ser capaz de resolver sus conflictos por sí solo.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000073",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No ponga esa cara, por favor.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_yod_000116",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡Pero es que--!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000074",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Estoy bien. Así que, Yoshisada-sama, sonría, por favor.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0001",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000075",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Se lo ruego, Yoshisada-sama. Ahora que soy capaz de sonreír, sonría conmigo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_yod_000117",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000076",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000077",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Su cara, usted está triste.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Hakuki toca suavemente mi mejilla.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000078",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Es realmente extraño. Hasta hace poco no sabía lo que era la felicidad, ni la\ndiversión, pero sí puedo detectar un rostro triste de inmediato. Es el\nresultado de haber tocado solo la parte más oscura de los corazones de los\ndemás...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_yod_000118",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Eso no...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000079",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No importa. Tengo la dicha de haber sentido su cálido corazón en mis últimos\nmomentos, Yoshisada-sama.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_yod_000119",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡Si es por eso, se lo haré sentir tanto como quiera, de ahora en adelante!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0001",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000080",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Pero ya están a punto de alcanzarnos. Si me entrega, usted podrá salvarse.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_yod_000120",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Si es por hacer eso, preferiría acabar con mi vida acá y ahora.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0006",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000081",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_yod_000121",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Huyamos, juntos. Mientras sigamos con vida, siempre habrá otra oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_yod_000122",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Cuando logremos huir sonreiré para usted, tanto como usted lo desee.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000082",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿De... verdad?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_yod_000123",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Así que de poder, quisiera que cesara esa sonrisa tan dolorosa.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000083",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Dolo... rosa?... ¿Las sonrisas pueden ser dolorosas también?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_yod_000124",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Vaya, parece que ahora tenemos más razones para huir juntos. Procuraré\nenseñarle eso también cuando estemos a salvo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0008",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000084",ch="had"},
},
ja={
{
name={"Hakuki"},
"“... Está bien.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="man_kaa_000003",ch="kaa"},
},
ja={
{
name={"Sirviente A"},
"“¡¡Los encontré!! ¡¡Por acá!!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_yod_000125",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Mm?! ¡¡Demonios!!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Intento correr, pero fue imposible. Eran muchos.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"se",stop=1,id=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"bg",id=9,lv=9,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"En cuestión de segundos estábamos rodeados por toda una multitud.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Teniendo de pared a un enorme y viejo árbol de cerezos a mis espaldas, miro con\nosadía a nuestros perseguidores.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_yod_000126",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"cgact",stage="bg064",act="うなづく"},
{"se",file="se9015",id=1},
{"text"},
text={
vo={
{"vo",file="man_hss_000018",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Vaya sorpresa...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Abriéndose paso entre sus vasallos, Housoushi hizo aparición.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_hss_000019",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“No paraba de preguntarme por qué Hakuki había abierto su corazón. Claro, ya\nveo, un hombre. Y vaya que no un cualquiera, sino un Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_yod_000127",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_hss_000020",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Con su permiso, me llevaré a Hakuki de vuelta.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_yod_000128",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Me niego.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_hss_000021",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿Te enamoraste?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_yod_000129",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="man_hss_000022",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Patético. Mátenlo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"se",id=1,file="se_katana_battou"},
{"text"},
text={
ja={
{
"Los vasallos desenfundan sus sables a la orden de Housoushi.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_yod_000130",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Desenfundo el sable que cargaba en mi cintura y miro ferozmente a mis\noponentes.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Tamaño, número, fuerza. Claramente el enemigo nos lleva ventaja en todo eso.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Pero tengo un enorme árbol detrás.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Parece que no tendré que cuidarme las espaldas.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_hss_000023",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Ah, dejen con vida a la sacerdotisa. Todavía sirve para algo. Al menos para\nparir a mis descendientes.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_yod_000131",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¡Desgraciado!!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Apenas Housoushi mostró su vulgar sonrisa, pisé con fuerza el suelo.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"se",id=1,file="se_jump"},
{"fg",mode=-2,sync=0},
{"bg",y=-100,zoom=100,speed=200,file="zbg064c",path=":bg/",z2=50,y2=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=0},
{"quake"},
{"se",file="se3130",id=2},
{"text"},
text={
vo={
{"vo",file="man_kaa_000004",ch="kaa"},
},
ja={
{
name={"Sirviente A"},
"“¡Mocoso!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kab_000002",ch="kab"},
},
ja={
{
name={"Sirviente B"},
"“¡Maldición!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",time=100,file="black",path=":bg/"},
{"msgoff"},
{"se",file="se2271",id=1},
{"bg",file="直線交差_001",id=6,lv=6,path=":cg/battle/",set="battle",sync=0},
{"extrans",time=100,sync=1},
{"ex",time=300,func="wait"},
{"quake"},
{"se",file="se2271",id=2},
{"bg",file="直線交差_002",id=7,lv=7,path=":cg/battle/",set="battle",sync=0},
{"extrans",time=30,sync=1},
{"se",file="se2271",id=3},
{"bg",file="直線交差_003",id=8,lv=8,path=":cg/battle/",set="battle",sync=0},
{"extrans",time=30,sync=1},
{"se",file="se2271",id=4},
{"bg",file="直線交差_004",id=9,lv=9,path=":cg/battle/",set="battle",sync=0},
{"extrans",time=30,sync=1},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=200},
{"se",id=5,file="se_katana_zuba2"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_hss_000024",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Los vasallos de Housoushi cayeron sin vida ante Housoushi, sin haber podido\nofrecer resistencia alguna.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_yod_000132",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Me subestimas por ser solo un niño, Housou? Seré un niño, pero también soy un\nsamurái.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"se",id=1,file="se_katana_battou"},
{"text"},
text={
vo={
{"vo",file="man_yod_000133",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“No voy a dejar que me maten tan fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="man_hss_000025",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Hmph. Niño no deja de ser niño, por más samurái que sea.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",time=100,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se_arrow2"},
{"se",id=2,file="se_gusagusa"},
{"quake",mode="mw"},
{"ex",time=200,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=200},
{"flash",time=300,alpha=128,loop=1,color="af4154"},
{"text"},
text={
vo={
{"vo",file="man_yod_000134",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Una infinidad de flechas me habían atravesado.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_had_000085",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_yod_000135",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Housou, maldito...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",id=3,file="se_walk_weak2"},
{"fg",mode=-2,sync=0},
{"bg",y=-100,zoom=60,speed=1000,file="zbg064c",path=":bg/",z2=50,y2=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg064",y=-175,act="おじぎ"},
{"text"},
text={
ja={
{
"Aun con flechas atravesadas por todo mi cuerpo, empuño de nuevo mi sable y me\nacerco a Housou.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_had_000086",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¡¡No lo hagas!!...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"se",stop=1,id=3,time=500},
{"se",id=1,file="se_arrow2"},
{"se",id=2,file="se_gusagusa"},
{"quake"},
{"quake",mode="mw"},
{"flash",time=300,alpha=128,loop=2,color="af4154"},
{"text"},
text={
vo={
{"vo",file="man_yod_000136",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"No siento dolor.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Pero entre cada flecha que me atravesaba podía escuchar un desagradable sonido\nviniendo de mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="man_hss_000026",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Donde el sable no sirve, las flechas hacen el trabajo. Aunque no pensé que\ntendría que usar mi carta secreta con un niño.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_yod_000137",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Las flechas seguían penetrando todo mi cuerpo, pero aun así seguí poniéndome de\npie y mirando a Housoushi.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Los vasallos alrededor se veían atemorizados ante mi mirada.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="man_hss_000027",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Acábenlo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Housoushi da su orden, sin compasión alguna.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_had_000087",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¡¡Detente!!...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="man_yod_000138",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡H-Hakuki!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"se",file="se9015",id=1},
{"text"},
text={
ja={
{
"Hakuki pisó el suelo con todas sus fuerzas.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"se",id=1,file="se_arrow2"},
{"bg",time=100,sync=0,file="black",path=":bg/"},
{"se",id=2,file="se_gusagusa"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_had_000088",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-540,file="zbg064c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1500,sync=1},
{"ex",time=1000,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",y=-540,file="zbg064c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=1000,sync=1},
{"ex",time=500,func="wait"},
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0006",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000089",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿P-Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Me puse encima de ella.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Ninguna de las flechas la alcanzó.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Menos mal...",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"bg",file="black",id=9,lv=9,alpha=30,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000139",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Que... por... qué?... ¿Qué explicación necesitaría para... proteger a la\nmujer que amo?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="man_yod_000140",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Aunque... vaya, que me veo... patético.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=50,time=1000,path=":bg/"},
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000090",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¡E-Eso no es cierto! Yoshisada-sama, usted...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=70,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000141",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ya... no puedo... ver su cara... Hakuki-dono...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0006",head="hak_z2a",lv=5,id=9},
{"fgact",ch="伯奇",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000091",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=80,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000142",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ya... no puedo... disfrutar... de observar su hermoso rostro...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=90,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000143",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Hakuki-dono... Hakuki-dono, ¿está usted... sonriendo, en este momento?...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000092",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=100,time=1000,path=":bg/"},
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0008",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000093",ch="had"},
},
ja={
{
name={"Hakuki"},
"“*uuhh*... Sí... Estoy... sonriendo...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=110,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000144",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿En... serio?... Me alegro... Ya... no la confundiré más... con una muñeca...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000094",ch="had"},
},
ja={
{
name={"Hakuki"},
"“*uuhh*... Sí... Con toda, seguridad... *uuhh*.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="man_yod_000145",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“... Qué... bien...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"cgdel",id=-1},
{"bg",file="black",id=9,lv=9,alpha=120,time=1000,path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_yod_000146",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Así... podré evitarle... más, descortesías... de mi... par... te...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_yod_000147",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Hakuki-dono... vi... va...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"cgdel",id=-1},
{"bg",time=1000,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"text"},
text={
ja={
{
"Mi cuerpo pierde todas las fuerzas, y me desmorono sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-540,file="zbg064c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_had_000095",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Yoshisada... sama?...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Mis ojos solo perciben oscuridad.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Y pensé... ¿Es esto... lo que llaman morir?",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000096",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama... Por fin lo he entendido... La manera... en la que lo veo a\nusted ahora... Esto es una sonrisa dolorosa...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fgact",ch="伯奇",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Ella cae de rodillas, y abraza mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000097",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Tanto... tanto, que usted... me dio a mí...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000098",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Y a cambio de eso... tuvo que recibir... tan cruel trato...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Pone sus manos sobre mis mejillas.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Su corazón se inmersa en mí.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"La mejilla de Yoshisada-sama todavía está cálida...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"y sin embargo... se siente tan... tan fría.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Hakuki-dono puso sus manos sobre mis párpados, y cerró lentamente sus ojos.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000099",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Y-Y yo, todavía... no he podido... hacer nada... ni dar nada... por usted...\n*uuhh*.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Algo se acerca, buscando salir desde lo más profundo de su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0006",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000100",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ngh... está, cálido...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Un caliente torrente se desborda de sus ojos.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000101",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama... ¿Qué... es esto?...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Hakuki-dono pregunta eso, acariciando mis cada vez más frías y pálidas\nmejillas.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"No había manera alguna de responder a su pregunta.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Pero――",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Aun así――",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000102",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Por favor respóndame, Yoshisada-sama... Es esto...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Aquello que se desbordaba de sus ojos se parecía al alma.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Alma, corazón que se desborda del recipiente.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Corría, sin parar, de sus ojos.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000103",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Es esto... mi corazón?...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Su corazón se desborda y brota de sus ojos.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Corren las lágrimas y se escurren en su boca.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0008",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000104",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama, ¿puede usted... ver mi corazón ahora?...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0002",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000105",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_hss_000028",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Hmph. De nada sirve que le hables a un muerto. Vendrás conmigo.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="伯奇",size="z1",my=40,mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_had_000106",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No iré con usted.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="man_hss_000029",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿Qué dices?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9},
{"fgact",ch="伯奇",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000107",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No. Más bien, no puedo hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="man_hss_000030",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿Que no puedes?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000108",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Abrí mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="man_hss_000031",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Eso lo sé.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"fgact",ch="伯奇",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000109",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No, usted no sabe nada.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000110",ch="had"},
},
ja={
{
name={"Hakuki"},
"“La parte de mi corazón que acabo de abrir es similar a todos aquellos que he\ntragado hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="man_hss_000032",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000112",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No tiene idea de lo que eso significa...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",style="cmul",scolor="x8d3043",file="bg064c",path=":bg/",sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"extrans",time=3000},
{"se",file="se9040",id=1,loop=1},
{"text"},
text={
ja={
{
"*tick*... *tick*...",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Una cálida sensación acobija mi piel.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="man_hss_000033",ch="hss"},
},
ja={
{
name={"Housoushi"},
"¿S-Sangre?",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_had_000113",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Sangre?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Limpio mis lágrimas.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Sin embargo, no tenían el traslúcido color que había visto en sueños.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Eran de un oscuro rojo.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Estaba llorando sangre.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"*tick*... *tick*... *tick* *tick* *tick*...",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"No solo salía de mis ojos.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Sangre se desbordaba desde cada una de las zonas de mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Desde cada uno de mis agujeros.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="伯奇",size="z2",mode=3,resize=1,path=":fg/hak/z2/",file="hak_z2a0000",face="a0001",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000114",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Mis lamentos... implican mi muerte. Es la señal de que todos los sueños están\npor ser liberados.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"se",stop=1,id=1,time=500},
{"bg",file="znightsky_summer",speed=300000,time=500,id=1,lv=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bg",file="znightsky_summer",speed=300000,style="sepia2",r=0.5,g=0,b=0,time=500,id=2,lv=2,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",id=2,file="se_gusha"},
{"text"},
text={
vo={
{"vo",file="fem_had_000115",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",mode=-2},
{"se",id=1,file="se_busha"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Traté de gritar, pero lo que salió no fue mi voz, sino un estruendoso sonido de\nalgo reventándose.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"El rojo cubre mi vista.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"¿Será esta cosa roja mi corazón?",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"En el instante en que esa idea se cruzó por mi mente...",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Pude ver sin fallo alguno, con mis ojos desprendiéndose de mi cuerpo hacia el\nsuelo, aquello.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Burbujas de todos los colores elevándose al cielo.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Las burbujas se alzaban desde lo que hasta hace poco era yo.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Nacen más y más burbujas, sin pararse por el desbordante sonido que emitía mi\ngarganta.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Llevadas por el viento, suben y alcanzan el cielo.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="fem_had_000116",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Estos son――”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"cgdel",id=2,lv=2},
{"text"},
text={
ja={
{
"Lo que hasta ahora era roja sangre se transformó en un abrir y cerrar de ojos\nen una colorida, traslúcida agua.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Traslúcida y clara agua brota con fuerza de Hakuki.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="man_hss_000034",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿Es esto todo lo que Hakuki se ha tragado? ¿Demonios de sueños?”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="fem_had_000117",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Serán estos los corazones que me he tragado hasta ahora――?”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_had_000118",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Considerando lo que he tragado hasta ahora, son realmente preciosos――”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_had_000119",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Son claros, transparentes... Sin ocultar absolutamente nada...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"Se supone que ya no tenía voz, pero pude escucharme.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Estiré mi mano hacia Yoshisada-sama.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="fem_had_000120",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama――”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"Pero antes de que sus manos se tocaran.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se_bafu",vol=50,id=1},
{"text"},
text={
ja={
{
"La consciencia de Hakuki se apagó.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_hss_000035",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“H-Háganse atrás, n-no se atrevan a tocar esta agua.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"se",file="se9039",vol=50,loop=1,id=1},
{"bg",lv=7,id=7,file="rain01",num=200,speed=80,r=4,time=0,path=":ani/",ax=1,ay=50,bx=959,by=490},
{"text"},
text={
ja={
{
"El agua de los demonios de sueños se levanta y se eleva al cielo, como si se\ntratara de un dragón.",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Los demonios de sueños alcanzan el cielo, convirtiéndose en tormenta y\nlloviendo sobre Naka no Mura.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Los sueños que alcanzaron el cielo humedecían ahora la tierra.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"Se volvieron tormenta, y ahora humedecen la tierra.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Los demonios de sueños le dan vida a las secas y muertas tierras.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
"Cada uno de los sentimientos que yacen en los rincones más oscuros del humano.\nMiedo, rencor, celos, tristeza, dolor, ansiedad...",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
"Los gritos de lamento de Hakuki llevaron todos esos negativos sentimientos al\ncielo, y están ahora dándole frescor a la tierra.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"Housou sintió terror por esta lluvia.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Sabía que quien fuera tocado por la lluvia moriría aplastado por toda esa masa\nde locura concentrada.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"Y sin embargo, nadie mojado por la lluvia enloqueció ni murió.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Lo que llegaron a ver los aldeanos en los campos tras la lluvia fue...",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Al viejo árbol de cerezos, que debía haber muerto ya, en pleno florecimiento.\nDesafiando toda lógica.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"Floreciendo fuera de temporada.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"Como si los sueños que Hakuki regurgitó hubieran impregnado todos los antiguos\nárboles a su alrededor, haciéndoles comer de sueños humanos para florecer.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"Árboles que devoran los sueños de las personas. Los cerezos milenarios.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
"Estos florecen al chupar los sentimientos de las personas.",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"Y dan a mostrar unas esplendidas, maravillosas flores.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
"Lo bello no está, a su vez, hecho de cosas bellas.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Así como el cuerpo de Hakuki se volteó y todos sus órganos salieron a la vista.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
"Al revés de lo bello se oculta siempre algo terrible.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"Yo lo sé.",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"Y lo sé porque estuve con ellos...",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"msgoff"},
{"se",stop=1,time=3000,id=1},
{"bgm",stop=1,time=3000},
{"bg",lv=7,id=7,file="rain01",num=200,speed=80,r=4,time=0,path=":ani/",ax=1,ay=50,bx=959,by=490},
{"ex",time=3000,func="wait"},
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500,sync=1},
{"text"},
text={
ja={
{
"Despierto en el salón.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
"A mi lado estaba Rina.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0100",face="b0002",head="rna_z2b",lv=5,id=9},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002124",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Dormiste bien?”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_yum_002079",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Rina me sonríe.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
"Su sonrisa era idéntica a la de Hakuki.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_yum_002080",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Rina, ¿has tenido algún sueño últimamente?",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0012",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002125",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Aquel sueño?”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_yum_002081",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0009",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002126",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... los he tenido...”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_yum_002082",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué clase de sueño tuviste?”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0011",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002127",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue uno triste... A pesar de que ambos se amaban, no lograron ser felices\njuntos...”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0008",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002128",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque fue algo distinto a lo que he escuchado en las leyendas.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0010",head="rna_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002129",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero coincidieron en lo del final triste.”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"Algo distinto a las leyendas...",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
ja={
{
"Es cierto. Lo que cuentan las leyendas de Yumihari se parecen a los sueños que\nhe tenido, pero hay algo que los separa.",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"La diferencia está en la manera en que Hakuki y Yoshisada pasaron sus últimos\nmomentos.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
"De ser así...",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
vo={
{"vo",file="fem_yum_002083",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De qué manera murió el muchacho que estaba contigo?...”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0009",head="rna_z2b",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002130",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue atravesado por un montón de flechas... Parecía estar bastante adolorido...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
vo={
{"vo",file="fem_yum_002084",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="zeveningsky_spring01",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Pero él no sufrió.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
"Y es que pudo morir abrazado por la muchacha que amaba.",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"¿Por qué Rina y yo habremos tenido los mismos sueños?",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
"¿Y por qué esos sueños difieren un poco de las leyendas?",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Aunque las leyendas fueron, después de todo, pasadas de generación en\ngeneración por mil años. Es imposible que coincidan perfectamente con la\nrealidad.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"¿Por qué habremos tenido justamente los mismos sueños?...",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"¿Y por qué fuimos separadas en hombre y mujer dentro de ellos?",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
"Supongamos que lo que ocurrió en los sueños realmente sucedió.",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
"De que Rina fue Hakuki, y yo Yoshisada.",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
"En pocas palabras, si esas fueron memorias de nuestras vidas pasadas,\nentonces...",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
vo={
{"vo",file="fem_yum_002085",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuu.”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
vo={
{"vo",file="fem_rna_002131",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yuumi? ¿Por qué esa sonrisa tan poco feliz?”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_yum_002086",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
"Claro. Un monstruo que se come los sueños de las personas y los materializa,\nhabía dicho él...",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
"Quizás lo que Kusanagi-senpai dijo era acertado, después de todo.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"¿Vidas pasadas?",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"Incluso a mí me cuesta creer en algo tan absurdo.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"Todo pareciera indicar eso.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Y si realmente fuera ese el caso...",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"No, aun así...",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"No cabe duda alguna de que es un milagro.",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"Lo que Dios haga, es milagro. Lo que el demonio haga, maldición es. Eso dicen.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
ja={
{
"Pero yo no pienso así. Por más que el resultado sea el mismo.",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
"Hasta Dios puede llegar a maldecir, y el mismo demonio puede hacer milagros a\nveces también.",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
ja={
{
"Cada quien decide qué hacer con ello.",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
"Es así que funcionan los milagros...",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
