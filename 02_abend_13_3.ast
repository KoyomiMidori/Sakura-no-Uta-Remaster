{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"cgdel",id=9,lv=9,time=400},
{"se",file="se_blood2",id=1},
{"bg",file="zpaintred",id=1,lv=1,rule=056,speed=200,x=-100,y=-600,ease="easein_cubic",path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zpaintwhite",id=2,lv=2,rule=056,speed=200,x=-100,y=-600,ease="easein_cubic",path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zpaintgreen",id=3,lv=3,rule=056,speed=200,x=-100,y=-600,ease="easein_cubic",path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zpaintblue",id=4,lv=4,rule=056,speed=200,x=-100,y=-600,ease="easein_cubic",path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zpaintyellow",id=5,lv=5,rule=056,speed=200,x=-100,y=-600,ease="easein_cubic",path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zpaintyellow",id=9,lv=9,rule=056,zoom=100,alpha=150,speed=200,x=-100,y=-600,ease="easein_cubic",z2=200,path=":cg/",x2="-1700,-1900",y2="-600,600",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=50},
{"quake"},
{"ex",time=150,func="wait"},
{"cgdel",id=1,lv=1,time=400},
{"cgdel",id=2,lv=2,time=400},
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"cgdel",id=5,lv=5,time=400},
{"cgdel",id=9,lv=9,time=400},
{"se",file="se_blood2",id=1},
{"bg",file="paintred",id=1,lv=1,zoom=100,speed=200,z2=150,path=":cg/",sync=0},
{"bg",file="paintwhite",id=2,lv=2,zoom=100,speed=200,z2=150,path=":cg/",sync=0},
{"bg",file="paintgreen",id=3,lv=3,zoom=100,speed=200,z2=150,path=":cg/",sync=0},
{"bg",file="paintblue",id=4,lv=4,zoom=100,speed=200,z2=150,path=":cg/",sync=0},
{"bg",file="paintyellow",id=5,lv=5,zoom=100,speed=200,z2=150,path=":cg/",sync=0},
{"extrans",time=50},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_wtd_000470",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Q-Qué pasa? ¿Ya te quedaste sin fuerzas?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no! ¿Qué hay de ti, imbécil? Te veo tambaleando.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_wtd_000471",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡De ningún modo! Eres tú el que está tambaleando, por eso me ves así... ¡Ahh,\nya basta de perder el tiempo hablando! ¡Corre!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"cgdel",id=-1},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa... kuh.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000472",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jaa, jaa, jaa, siguiente, ¡X, 150, Y, 120! ¡220 grados! ¡Dale con fuerza, como\ngolpeando el pincel con la pared!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, lo sé, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_wtd_000473",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sigue con X, 40, Y, 100! ¡300 grados! ¡Con suavidad, desliza unos cuantos\nmilímetros horizontalmente!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_wtd_000474",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ahora!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="znightsky_summer",id=9,lv=9,speed=150000,rule=139,sync=1,vague=40,path=":cg/",x2=960,y2=0,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Una estufa encendida en pleno verano.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Debido a la tan extensa labor, la temperatura de sus alrededores se eleva de\nforma violenta.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Akashi se ocupa nada más en derretir uwabakis. Y yo me encargo de estamparlos.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Siento como si el tiempo se fuera derritiendo y disolviendo de manera viscosa.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"¿Qué hora es ahora? ¿Cuántas horas habrán pasado desde entonces? Estoy incluso\nolvidando qué es lo que estamos haciendo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"El licuado y viscoso tiempo va avanzando.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"El tiempo va pasando lenta, lentamente, en medio del hirviente aire de verano.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"cgdel",id=-1},
{"bg",time=500,file="bg057g",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa, jaa... La próxima, orden...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000475",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¡Akashi, dame la próxima orden!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_wtd_000476",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Akashi?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"msgoff"},
{"se",id=1,file="se3356"},
{"fg",ch="明石",my=40,mode=-1,lv=4,id=9},
{"ex",time=0,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=530,y=-970,zoom=140,file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=200},
{"fg",ch="明石",size="z2",zoom=120,my=-40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",y=100,lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Akashi?!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Akashi se desploma.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"De dar un mal paso, Akashi pudo haber caído sobre la estufa. Así de cerca\nestando de la estufa, se desplomó sobre sus propios pies.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"se",file="se3130",id=1},
{"fg",mode=-2,sync=0},
{"bg",x=500,y=-970,zoom=145,speed=200,file="zbg057g",path=":bg/",z2=140,x2=530,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="明石",size="z2",zoom=130,speed=200,mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",x2=0,y2=100,z2=120,x=-30,y=150,lv=5,id=9,sync=0},
{"extrans",time=0},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi! ¡Eh, Akashi! ¡Auch!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Toco a Akashi.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Todo el cuerpo de Akashi estaba sorprendentemente caliente.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Tan caliente como lo estaría un paciente de hiperpirexia.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi! ¡Akashi! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fgact",ch="明石",act="いいえ",size=2,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000477",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Tiene respiración. Pero, no hay respuesta alguna.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, claro.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Recuerdo el termo que Shizuku hizo que me llevara.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Según dijo, adentro debería haber té frío.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abro el termo. Ciertamente, el interior estaba repleto con té frío.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué alivio...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Sirvo algo de té dentro de la tapa y se lo doy de beber a Akashi.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0007",head="aka_z2a",x=-30,y=150,lv=5,id=9,zoom=130},
{"fgact",ch="明石",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000478",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“--puh, kaah.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Despertaste?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="明石",ex03="a0097",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0009",head="aka_z2a",x=-30,y=150,lv=5,id=9,zoom=130},
{"fgact",ch="明石",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000479",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Hay alguien en su sano juicio que le dé de tomar té de repente a alguien\ndesmayado?... Me entró bastante en la traquea...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes tremenda fiebre. ¿No es esto ya un caso severo de hipertermia?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"extrans",time=300},
{"se",file="se9010",id=1},
{"fg",ch="明石",size="z1",my=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0006",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000480",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Estoy bien... ¿Oh?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",id=1,file="se3356"},
{"fg",ch="明石",my=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Akashi trató de levantarse, pero volvió a caer rápidamente.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estás nada bien... Akashi...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Tiene una terrible fiebre.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Saco mi teléfono celular.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"se",file="se3130",id=1},
{"fg",ch="明石",size="z2",my=40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000481",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Akashi agarra mi mano fuertemente.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000482",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿A quién piensas llamar?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una ambulancia. Vas a morirte de seguir así. Tu temperatura corporal está por\nel techo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000483",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No lo hagas...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qu--?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Akashi trata de pararse, tambaleándose.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"Akashi, recuéstate, de verdad estás mal.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_wtd_000484",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Cierra la boca... Atrévete a hacer una sola llamada... ¡Atrévete nada más y\nverás cómo te mato!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"se",id=1,file="se3356"},
{"fg",ch="明石",my=40,mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Al hacer eso, Akashi se desplomó por completo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_wtd_000485",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Solo un momento. Nada más déjame descansar por unos minutos y todo estará\nbien... Nada más me basta eso para recuperarme...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo crees que vas a recuperarte de ese estado?!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_wtd_000486",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No hay problema... tranquilo...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Y entonces, cerró los ojos.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mierda!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"se",file="se0744",id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"bg",rule=280,time=300,vague=40,file="bg054c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Por ahora, hidrato lo más posible a Akashi y lo arrastro hasta un lugar fresco.\nDejo una toalla mojada sobre su cabeza.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hago?...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Observo el reloj.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya está a punto de cambiar la fecha...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Los amaneceres de esta época llegan a eso de las 5 AM.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Ya no quedan sino 5 horas para el amanecer.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tendré que hacer esto solo...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"se",file="se0744",id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"bg",rule=280,time=300,vague=40,file="bg057g",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Tomo un uwabaki y lo acerco a la estufa.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué diablos?...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Está extremadamente caliente.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Obviamente, debe de estarlo. Aún tratándose de un producto defectuoso, es una\ntemperatura suficiente como para derretir la goma de uwabakis.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"¿No tendrá más de 100°C esto?",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto está mucho peor que un sauna. Ninguna persona normal podría durar 30\nminutos con esto... Hay que ver lo mucho que aguantó Akashi haciendo esto...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Al confirmar que el uwabaki estaba ya lo suficientemente caliente, salgo\ncorriendo.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"El calor me nubla la consciencia. Por poco se me enredan las piernas.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Resisto de alguna manera y logro llegar corriendo hasta la pared.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Adhiero la goma derretida a la pared.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Es muy poco eficaz esto, pero no es nada que no se pueda hacer.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Haré lo que pueda hacer solo...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Corro.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Puedo hacerlo.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"No, debo hacerlo.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Por más imposible que parezca...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡UOOOOHHHHH!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
