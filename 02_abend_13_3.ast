astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm027"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="nightsky_summer",id=9,lv=9,path=":cg/",sync=0},
{"extrans",time=500},
{"se",id=1,file="se3402"},
{"text"},
delay={
[400]={
{"se",id=2,file="se3402"},
},
[1000]={
{"se",id=3,file="se3402"},
},
},
text={
ja={
{
"Akashi sube las escaleras.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Es de las altas.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a hundir el pincel en esto, ¿no? Yo te lo sostengo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_wtd_000441",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Te va a caer pintura encima.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wtd_000442",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",id=1,file="se2405"},
{"text"},
text={
ja={
{
"Akashi enganchó algo a su correa.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos es eso?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_wtd_000443",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“La pista la obtuve de ti...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De mí?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"cgdel",id=-1},
{"bg",file="ev_uni_c24_04",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"text"},
text={
ja={
{
"Después de sonreír de forma pícara, Akashi sumerge el pincel en un líquido\nnegro.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Ese líquido que estaba contenido en una enorme cubeta tenía una viscosidad\nmuchísimo más alta a la de la tinta normal.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Akashi observa la pared de la iglesia, aún con el pincel dentro de la cubeta.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Hay cinta de enmascarar por todas las partes de la pared, así que no hay\nproblema alguno en que salpique la pintura.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Es posible mover el pincel con toda libertad. Sin embargo, esta primera\npincelada no admite fallo alguno.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Si fallamos en esto, nos convertiremos en unos simples criminales. Terminaremos\narruinando esta iglesia.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",x=980,y=750,zoom=120,file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="明石",size="z2",zoom=120,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",y=60,lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al dar Akashi un respiro...",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bgm",file="bgm015"},
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",y=60,lv=5,id=9,zoom=120},
{"text"},
delay={
vl01={
{"fg",ch="明石",mx=-40,mode=-1,lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000444",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Nun!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",time=100,sync=1,file="white",path=":bg/"},
{"se",id=1,file="se3215_1"},
{"quake"},
{"bg",file="sumi02_筆_打ち下ろしタイプ_透明",id=9,lv=9,rule=129,time=100,zoom=100,sync=1,z2=120,path=":cg/"},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
"Comienza la pincelada.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Unas salpicaduras negras, idénticas a las vistas en caligrafía japonesa, se\nadhieren al lienzo.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Fue un movimiento de pincel esplendido, con bastante fuerza.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"No hay problema alguno ni en la posición, ni en su forma o la fuerza. Todo bien\nhasta acá.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"cgdel",id=-1},
{"bg",x=980,y=750,zoom=120,file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500},
{"fg",ch="明石",size="z2",zoom=120,my=40,mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",y=60,lv=5,id=9},
{"text"},
text={
ja={
{
"Sin embargo, la parte más importante viene ahora. Para culminar con éxito la\npincelada a partir de este primer movimiento, se necesita muchísima técnica.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Hay que representar el tronco usando un solo trazo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Debemos terminar esto en una sola noche.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"quake",mode="mw"},
{"fg",ch="明石",mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0004",head="aka_z2a",y=60,lv=5,id=9,zoom=120},
{"text"},
text={
vo={
{"vo",file="man_wtd_000445",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Nuaaaaaaaaah!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",x=980,y=-240,zoom=120,speed=400,file="zbg057g",path=":bg/",y2=750,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="明石",size="z2",zoom=120,mode=3,path=":fg/aka/z2/",file="aka_z2a0500",face="a0003",head="aka_z2a",y=60,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",file="se3130",id=1},
{"quake"},
{"fg",ch="明石",my=40,mode=-1,lv=5,id=9},
{"bg",time=50,rule=216,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Saltó casi desde la misma escalera.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"O al menos eso parecía, pero su tiempo de vuelo era peculiarmente largo como\npara ser así.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Goma? ¿Un salto bungee?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Lo que Akashi se había enganchado a su correa era una cuerda de goma, como las\nque se usan en los saltos bungee.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000446",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kuwaaah! ¡Teyaaah!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bg",time=100,sync=1,file="white",path=":bg/"},
{"se",id=1,file="se3215_2"},
{"quake"},
{"bg",file="sumi01_筆_アッパータイプ_透明",id=9,lv=9,rule=086,time=100,zoom=100,sync=1,z2=120,path=":cg/"},
{"ex",time=400,func="wait"},
{"cgdel",id=-1},
{"bg",zoom=100,time=300,file="ev_uni_c24_04",z2=120,path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿L-Lo logró?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",zoom=110,y=-50,time=100,speed=300,file="bg057g",path=":bg/",z2=150,y2=50},
{"quake"},
{"se",file="se_attack06",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000447",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Nuuh?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Justo en el instante en que terminó la primera pincelada, la cuerda de goma se\nrompió, y Akashi, quien no se había preocupado por sus pies, impacta con el\nsuelo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Una caída para única y meramente dibujar una línea. No hay definición alguna de\nukemi en ese movimiento.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"se",file="se9010",id=1},
{"fg",ch="明石",size="z1",my=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0500",face="a0005",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000448",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Nuh. ¡¿Qué tal, Kusanagii!?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue espléndido. ¿Pero estás bien? Caíste terrible.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000449",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todo dentro de lo esperado...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dentro de lo esperado?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000450",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Necesitaba sí o sí tener este grado de repulsión elástica para poder dibujar\ncon más belleza el trazo...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso quiere decir que tenías pensado desde un principio hacer un salto bungee\ncon una goma con la dureza justa para que se rompiera?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000451",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No fue realmente planificado, pero... bueno, es una goma con un grueso\nobviamente rompible. Mi objetivo era incrementar mi tiempo de vuelo. Mucha\nfuerza de repulsión solo sería un estorbo...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000452",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Dejando eso de lado, ¿qué tal está mi trazo?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es absolutamente espléndido... De ninguna forma esperaba este grado de\nperfección...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Sin duda alguna, la única palabra que tengo para esto es, espléndido.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Seguramente repitió el mismo experimento una y otra vez, cambiando el grueso de\nla goma y repitiendo las caídas para poder dibujar con mayor belleza el\ntrazo.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"El momento de salto, la repulsión elástica de la goma, la forma de llevar el\npincel, la manera de aplicar y soltar fuerza. Todo, absolutamente todo, fue\nincreíblemente perfecto.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Esto no es algo que se pueda aprender practicando 1 o 2 veces.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Es, sin duda alguna, una técnica obtenida a base de esfuerzo, sudor y lágrimas.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde estuviste practicando para esto?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000453",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Más que todo, en las pilas de puentes. Al principio lo hacía en paredes que no\nse vieran fácilmente, pero de igual forma llamaba la atención. Después de\najustar varias veces el grueso de la goma, di finalmente con el método que\nacabas de ver. Lo ideal es que la cuerda pueda romperse al final.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que hasta el propio ukemi te era de estorbo?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000454",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, hasta ahora siempre he podido ejecutar bien los ukemi al final, pero...\nQuizás por ser este el momento de la verdad, me puse nervioso.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No tienes ninguna herida?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000455",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, creo que estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Al decir eso y pararse, Akashi estaba agarrando la zona de sus costillas con su\nmano.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te golpeaste muy fuerte las costillas?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000456",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No hay problema. Solo dejó un moretón...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Akashi contempla su trazo de pincel, sin prestarle mayor atención a su propio\ncuerpo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000457",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya está la primera pincelada... Lo demás es ir dibujando poco a poco cada una\nde las otras pequeñas partes...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",x=-640,y=90,file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="fg_akashi01",id=6,lv=6,x=0,y=300,speed=400,path=":cg/",x2=500,ax=795,ay=979,bx=165,by=-439,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=-940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"cgdel",id=-1},
{"bg",x=-640,y=90,file="zbg057g",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="fg_akashi01",id=6,lv=6,x=0,y=300,path=":cg/",ax=795,ay=979,bx=165,by=-439,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=940,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=-940,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"se",file="se1615_z1",id=1},
{"text"},
text={
ja={
{
"Akashi tomó un pequeño pincel (aunque aun así, mucho más grande que los\nnormales) y comenzó a dibujar las otras partes más pequeñas.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Lo que comenzó como un trazo va tomando esplendidamente la forma de un tronco,\ndel cual además comienzan a crecer ramas.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Va reproduciendo con precisión casi perfecta la ilustración del diseño sobre la\npared de la iglesia, sin siquiera ver los planos de diseño de Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Solo se le puede calificar de espléndido a esto.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"cgdel",id=-1},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero cuánto tiempo te tomaste practicando para esto?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="man_wtd_000458",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todos los días, desde el día en que vi ese plano de diseño... Cada día, cada\ndía, uno tras otro, repetí esto. Es una pincelada que no admite fallo alguno,\nde ninguna, absoluta manera.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dejaste completamente negra la pared de la pila del puente?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_wtd_000459",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Usé agua para practicar. Practique una y otra vez, hasta volverme capaz de\nterminarlo todo antes de que se secara el agua. No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino... No hay otra palabra para describir esto que esplendido... No\npensé que de verdad llegaras a reproducirlo con tan majestuosa precisión...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000460",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Es que acaso no te lo dije ya?... De que yo hago posible lo imposible...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"La verdad es que sí había previsto algo esto. De no haberlo hecho, la primera\npincelada la hubiera dado yo.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Soy yo quien mejor que nadie conoce el pincel de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Aun si tuviera que hacerlo sin mucha práctica encima, tenía la confianza de que\npodría producir un trazo muy cercano al de él. Sin embargo, eso se lo dejé a\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Akashi sabe lo que significa que yo imite las pinturas de Kenichiro Kusanagi. Y\naun así, Akashi dijo que lo haría él, y no yo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"En pocas palabras, Akashi tenía plena seguridad de que podría reproducir con\nmucha más cercanía que yo el trazo de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquella vez que me ayudaste, fue por esto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000461",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No fue por ayudar, simple y llanamente querías conocer el pincel de Kenichiro\nKusanagi. Querías conocer la manera de copiar a Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000462",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kukuku... ¿Quién sabe? Ya me olvidé de esos lejanos sucesos del pasado.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000463",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Bueno, quizás me sirvió de referencia. En ese sentido, no hay deuda ni nada por\nel estilo por lo de aquella vez, así que tal vez no tengas que preocuparte\npor eso.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000464",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Bien! Ya terminé el tronco y las ramas. Ahora iremos con los pétalos de\ncerezo. ¡Sabes cómo procederá la labor, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000465",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Yo derretiré los uwabaki. ¡Tu vas a pegar los uwabaki derretidos sobre el\nlienzo, siguiendo mis órdenes! ¡Te quedó claro, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. No te vayas a equivocar dando órdenes.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000466",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Zopenco, no hay forma de que me equivoque. ¿Cuántas veces crees que he visto ya\nese plano de diseño? Me lo memoricé por completo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien, confio en usted, jefe.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0002",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000467",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ouh!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Tomo los uwabaki que Akashi calentó.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Los uwabaki calentados en pleno verano con la estufa industrial estaban\nterriblemente calientes.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Tanto así era el calor, que incluso daba la sensación que se podrían derretir\nuwabakis normales con esto.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fgf",frame="frame_1p",bg="black",cg=":cg/fg_akashi01",cgx=550,cgy=50,rule=64,bgpx=":bg/",cgbx=-960,cgby=-540},
{"text"},
text={
vo={
{"vo",file="man_wtd_000468",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡La primera coordenada es X, 25, Y, 15! ¡Con ángulo de 320 grados! ¡Comienza\npor un lado, suavemente!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fgf",frame="frame_1p",disp="消",mode=-1},
{"text"},
text={
ja={
{
"Coordenadas cartesianas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"En la pared fueron escritas de manera precisa, con un tiralíneas, todas las\ncoordenadas.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"En el documento de diseño de Kenichiro Kusanagi también están descritas, como\nera de esperarse, las coordenadas.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Basta con cambiar la escala de esas coordenadas para revivir en la pared, la\nobra de Kenichiro Kusanagi descrita en los planos.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Este método fue empleado hace muchísimo tiempo para construir las estatuas y\nfiguras budistas.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Al emplear ese método de manera numérica y utilizar coordenadas cartesianas, se\npueden dar las instrucciones de manera oral.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Las coordenadas fueron escritas de forma precisa con un tiralíneas,\nseguramente. Basta con un poco de agua para removerlas. Al terminar la obra,\nse le pasa una manguera de agua para disolverlas.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Sea para el enmascaramiento o para este sistema de coordenadas realizado con\ntiralíneas, es imposible hacer ambas cosas en unas pocas horas sin antes\nconocer hasta el más mínimo detalle la estructura de esta iglesia.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Realmente, Akashi pasó todos estos años únicamente con esta obra en mente.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Me quedo pasmado, pero admirado ante la fluidez y nivel de perfección de sus\nmovimientos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0500",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000469",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Vamos, siguiente, siguiente! ¡Muévete rápido!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, lo sé!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Las noches de verano son cortas.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"En este corto período de penumbra debemos completar esta obra.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
