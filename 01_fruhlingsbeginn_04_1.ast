astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c02_01",path=":ev/ev_eye_c02/",set="ev_eye_c02"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg008a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm007"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai! ¡Ya es la hora! ¡Despierta!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"bg",file="ev_com_a27_01",path=":ev/ev_com_a27/",set="ev_com_a27"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000350",ch="aid"},
},
ja={
{
name={"Ai"},
"*uuuu*...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? ¿Ai, estabas despierta?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_aid_000351",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aun en esta mañana tan encantadora, ¿incluso tú vienes a arrastrarme de mis\nsueños y de vuelta a la realidad?... *uuuu*.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Qué demonios estás diciendo? Si estás despierta entonces salte del\nfutón.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000352",ch="aid"},
},
ja={
{
name={"Ai"},
"“No quiero salirrr... No quiero regresar al mundo de la soledad, donde no tengo\nni novio ni nadie a mi lado. No quiero regresarrr. *uuuu*.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"¿Aún sigue medio dormida?...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, entiendo, levántate. Vamos, no me des tanto trabajo. Si no te mueves\nvas a llegar tarde...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_aid_000353",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por lo menos pon algo de tu tiempo en mí... Yo también soy una chica. ¿No\npodrías por lo menos gastar algo de tu tiempo y esfuerzo conmigo?... *uuuu*.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué estás hablando, vamos, vamos...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"bg",file="ev_com_a27_02",sync=0,face=1,time=400,path=":ev/ev_com_a27/",set="ev_com_a27"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000354",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhh... hace frío, hace mucho fríooo...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, levántate, Ai.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_aid_000355",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hay ni un solo fragmento de amabilidad ni cariño. Este mundo es de hielo,\ncomo una tormenta de nieve.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja de hablar en tus sueños y levántate, o llegarás tarde.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Comienzo despertando a Ai.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Aún como la ven, entre los integrantes de la familia Natsume ella es una de las\nque se levanta con mayor facilidad en la mañana.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Por unos minutos actúa siempre atolondrada por el sueño, pero luego retorna a\nla misma Ai de siempre.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Después de eso, voy despertando a cada uno de los otros Natsume. Aunque por lo\ngeneral no suelen despertarse en la primera vuelta.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Mientras adelanto la preparación de la comida, me detengo varias veces para ir\na despertar a Shizuku y Kei.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000356",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, discúlpame por hoy también...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Por hablar disparates mientras estabas medio dormida? Ya estoy totalmente\nacostumbrado a eso, ¿no podrías dejar de disculparte todo el tiempo por lo\nmismo?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000357",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, pero siempre es lo mismo todas las mañanas, y...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que ya me acostumbré.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000358",ch="aid"},
},
ja={
{
name={"Ai"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Ai siempre ha vivido de manera recta y rígida, como la mayor de la casa\nNatsume.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Los integrantes de la familia Natsume no recibieron el apellido Natsume por una\nrazón cualquiera, ni tampoco viven en esta mansión así como así.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Por eso es que hay un significado bastante importante en el hecho que Ai asuma\nese apellido.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Aquellos que no saben nada probablemente pensarían que las palabras a medio\ndormir de Ai fueron solo eso, unas tontas palabras en medio de un sueño, pero\nen mi caso, que conozco la casa Natsume y a Ai, percibí eso como un quejido,\nuna muestra de debilidad.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0012",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000359",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Kusanagi? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada. Mejor nos apresuramos ya, o llegaremos tarde.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0003",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000360",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="圭",size="z1",mx=-40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0003",head="aix_z1h",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000729",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hay problema. Con mi motocicleta--”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000361",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota, si sigues manejando de esa manera contra el reloj van a terminar\nmultándote y suspendiéndote la licencia.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000730",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tampoco manejo de forma tan bruta.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sea lo que sea, yo me voy en tren. Si no me apuro llegaré tarde.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000362",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, cierto. Kusanagi, ¿no quisieras ir hoy al colegio en mi motocicleta?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedo hacer eso? Siento que no está bien que un estudiante vaya al colegio en\nla motocicleta de su profesora.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000363",ch="aid"},
},
ja={
{
name={"Ai"},
"“No te preocupes por eso. Nuestro colegio es bastante flexible, no hay ninguna\nregla respecto a eso. Además, Kei también va en moto al colegio.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Bueh, supongo que es más cómodo que tener que caminar a la estación e ir en\ntren...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"O al menos aún en este momento estaba pensando eso de manera ingenua.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, Kei había dicho esto.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0001",head="kei_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000731",ch="ked"},
},
ja={
{
name={"Kei"},
"“El nombre formal de la motocicleta que Aneki monta es KAWASAKU- 500SS Mach III.\nEs una motocicleta salvaje, fabricada hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_ked_000732",ch="ked"},
},
ja={
{
name={"Kei"},
"“Parece que los hombres de antaño eran respetados por solo montar en esa moto,\nal claramente no valorar su propia vida.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_ked_000733",ch="ked"},
},
ja={
{
name={"Kei"},
"“Según dicen, parece que el equilibrio de peso entre la parte frontal y trasera es\nterrible, la moto se queda haciendo caballito al acelerar hasta tercera, y al\nagarrar las esquinas en la máxima velocidad siempre volará un momento por el\naire...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_ked_000734",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es toda una leyenda de motocicleta, conocida por emitir una cantidad copiosa de\nvapor blanco del escape que le impedía el paso a los vehículos por detrás, y\nque hacía imposible también a las bandas de motorizados que corrieran de\nmanera descontrolada en grupo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0018",head="kei_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000735",ch="ked"},
},
ja={
{
name={"Kei"},
"“En fin, no es una máquina que un humano pueda montar, así que si llegas a\nmontarte en ella morirás. Te recomiendo que te cuides.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"text"},
text={
ja={
{
"Kei es un idiota, así que siempre exagera con todo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Por lo tanto, seguramente Kei mezcló algunas mentiras con todo eso, y no debe\nser realmente la gran cosa...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Eso pensaba.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"se",file="se1747",id=4},
{"quake"},
{"bg",file="連続直線爆発",rule=46,time=100,id=9,lv=9,path=":cg/battle/",set="battle"},
{"ex",time=100,func="wait"},
{"cgdel",id=-1},
{"se",file="se9005",id=1,loop=1},
{"bg",y=60,zoom=80,x=570,speed=200,file="zbg030a",path=":bg/",z2=50,x2=0,y2=20,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=8,id=8,file="line2",time=400,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg030",y=100,act="ゆらゆら",size=0.3,time=100,loop=-1},
{"bgm",file="bgm015"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“GYAAAAAAAAAAAAAAAAAAAAAAAAAAHH.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"se",file="se9022",id=2},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
{"exfont",size="f4"},
"“GYAAAAAAAAAAAAAAAAAAAAAAAAAAHH.”",
{"exfont"},
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡NO, NO, VIENE UN CARRO POR LA IZQUIERDA, POR LA IZQUIERDA!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",file="se9022",id=3},
{"bg",y=500,zoom=100,x=-300,speed=200,file="zbg030a",path=":bg/",z2=80,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=8,id=8,file="line2",time=400,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg030",y=100,act="ゆらゆら",size=0.3,time=100,loop=-1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
{"exfont",size="f4"},
"“GYAAAAAAAAAAAAAAAAAAAAAAAAAAHH.”",
{"exfont"},
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡NO, NO! ¡LA RUEDA FRONTAL, LA RUEDA FRONTAL ESTÁ AL AIRE! ¡¡ESTO PASA POR\nANDAR CORRIENDO CON UNA RUEDA AL AIRE!!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"se",stop=1,id=1,time=500},
{"se",stop=1,id=2,time=500},
{"se",stop=1,id=3,time=500},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"La moto se quedó en caballito hasta llegar a tercera, cada vez que agarramos\nlas esquinas en máxima velocidad flotábamos en el aire, y por culpa del humo\nblanco no se pueden ver los carros que vienen detrás.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Justo como Kei me lo dijo.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"La motocicleta de Ai era justamente así...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Y entonces, cerré por completo la puerta de mis recuerdos...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000364",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, Naoya, sé que te despertaste temprano, pero no te duermas. Ya llegamos.\nQué chico tan peligroso eres, eh, durmiéndote en una motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg043e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm037"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La peligrosa eres tú...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000365",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Estabas despierto?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0016",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000366",ch="aid"},
},
ja={
{
name={"Ai"},
"“Siempre te las das de tipo calmado, pero aún montado en esa motocicleta pudiste\ndormir serenamente. Eres asombroso.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me las doy de tipo calmado, ni tampoco me quedé dormido...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente me desmayé.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000367",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Te habías desmayado?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por poco creí que moriría. En fin, pude llegar a tiempo, así que de igual\nforma te lo agradezco...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000368",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Tan terrorífico fue el viaje? Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, supongo que motocicleta es motocicleta...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0008",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000369",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, la próxima vez manejaré más lentamente.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, parece que a estas motocicletas viejas hay que hacerlas correr\nbastante o de lo contrario la bujía dejará de prender y no se moverá más,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0013",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0011",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000370",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me sorprende que sepas eso. Pues sí, es exactamente así.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué motocicleta tan complicada, eh. Si no la echas a correr deja de moverse.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0001",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0013",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000371",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... Ah, pero de ahora en adelante trataré de correr más lentamente.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Aunque de igual forma, la verdad es que no quisiera montarme de nuevo.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-240,x=-40,zoom=70,file="zbg048k",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0011",head="kei_z2a",lv=5,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="圭",act="いいえ",time=500,lv=5,id=5},
{"bgm",file="bgm011"},
{"text"},
text={
vo={
{"vo",file="man_ked_000736",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uh~, me siento algo cansadooo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fgact",ch="圭",act="停止",lv=5,id=5},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0018",head="kei_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000737",ch="ked"},
},
ja={
{
name={"Kei"},
"“Nuestra juventud se pudrirá si seguimos metidos en este salón aún con este\ndespejado y radiante día de primavera afuera. ¿Verdad, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=5},
{"fgact",ch="圭",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000738",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Oye, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cállate.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0009",head="kei_z2a",lv=5,id=5},
{"fgact",ch="圭",act="いいえ",time=500,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000739",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Vamos~, qué pasa? Estás tan frío como siempre~”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fgact",ch="圭",act="停止",lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estamos a mitad de clases...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000740",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Entonces dejarás de ser frío cuando terminen las clases?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muérete.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0012",head="kei_z2a",lv=5,id=5},
{"fgact",ch="圭",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000741",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kya_000001",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Ustedes, allí, dejen el escándalo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",lv=5,id=5},
{"fgact",ch="圭",act="ジャンプ",size=50,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000742",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Es solo su imaginación!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_kya_000002",ch="kya"},
},
ja={
{
name={"Profesor A"},
"“Por Dios, ustedes dos...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bgm",stop=1,time=1000},
{"fgact",ch="圭",act="びっくり",lv=5,id=5},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0018",head="kei_z2a",lv=5,id=5,sync=0},
{"extrans",time=100},
{"se",file="se2192",id=1},
{"bg",rule="216r",time=300,file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm037"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por tu culpa me azotaron a mi también, imbécil...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000743",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué lugar tan cruel es este colegio, no puedo creer que aún empleen castigo\nfísico. Parece el ejército en medio de una guerra.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000629",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué estás diciendo? Es obvio que el profesor se molestará si le dicen\neso. Si estuvieran en el ejército ya los hubieran matado a los dos.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000744",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo, entonces quizás debería descartar de mis posibilidades entrar al\nejército. Sería bastante deprimente que me mataran una y otra vez nada más\npor decir eso.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si existiera algún ejército donde tipos como tú pudieran alistarse, entonces\nprobablemente terminen derrotados aún antes de salir al frente.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000745",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Querrás decir el enemigo, eh!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Pero qué cara de fanfarrón tiene en este momento.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, entonces alístate al ejército. Salte de este colegio y alístate de una\nbuena vez...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000746",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, no puedo ir a esa clase de lugar y dejarte solo aquí.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000630",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De igual manera, ustedes dos no servirían de nada en el frente.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="圭",mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000337",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero me parece que es mejor así, ¿no creen? El ejército parece ser un lugar\nbastante duro.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000631",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque Rin-chan si serviría muy bien en combate.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000338",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000632",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El lanzamiento de ayer fue increíblemente bueno. Jamás había visto a una\npersona volar por el aire con tanta gracia.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000339",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso solo fue pura casualidad. Akashi-senpai corrió hacia mí con bastante\nimpulso, así que lo único que tuve que hacer fue emplear esa fuerza contra\nél.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero me pareció ver que lo lanzaste procurando que no sufriera de ninguna\nherida.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000340",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quién sabe? ¿No será más bien que ese Akashi-senpai en realidad tiene muy\nbuenas habilidades motrices? Según pude ver, tomó un ukemi casi perfecto a la\nhora de caer.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0015",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000633",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, pues, hablando de habilidades motrices, ese hombre suele ser golpeado y\nlanzado a cada rato. Así que quizás sea bueno ejecutando todo tipo de ukemi.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no pensé que tuvieras esa habilidad especial, Rin.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0008",head="rin_z1d",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0002",head="rin_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000341",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, más que habilidad especial, diría que... Por alguna razón, apenas entré a\nla secundaria comencé a practicar judo. No conozco bien esa razón, pero en\nese momento quería ser capaz de tomar bien los ukemi.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000634",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Comenzaste a practicar judo para mejorar tus ukemi? Qué razón tan extraña, eh.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="man_ked_000747",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero no está mal, ¿no? Parece que los de judo son capaces de ejecutar ukemi al\ninstante cuando ocurre algún accidente durante las prácticas.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0012",head="rin_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000342",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Pero ¿por qué habré comenzado a preocuparme por mis ukemi de repente? Ahora\nque me pongo a pensarlo, se me hace misterioso.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000635",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues también existen razones misteriosas como esa. Las personas nunca saben\nqué es lo que querrán hacer de un día para otro.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000343",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Además, también dije de repente que quería comenzar a pintar en\nóleo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_ked_000748",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Qué pasa, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, no... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Rin, aún no has reunido todos los instrumentos que necesitas para\npintar en óleo, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000344",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, aún no.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000636",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, claro, hay que prepararlos todos.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_ked_000749",ch="ked"},
},
ja={
{
name={"Kei"},
"“Podríamos acercarnos hoy a la tienda de instrumentos de pintura al regresar,\n¿no? Hay instrumentos baratos para novatos también.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000345",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sería buena idea.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bgm",file="bgm011"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuh... uh、ugh.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nuwah!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"se",id=1,file="se1664"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Una vez más se cayó toda la pila de cosas que había acá. Realmente, todas las\ncosas de este lugar están desordenadamente apiladas una sobre la otra.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"A veces dicen que la suciedad de las habitaciones son como estratos geológicos,\npero si eso es cierto, entonces este lugar es el Gran Cañón.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Y tal como si estuviera excavando los fósiles más antiguos del planeta, voy\ndescubriendo varios instrumentos y obras de hace varios años.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Me encargo de, por ahora, acomodar las cosas que se desmoronaron.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Me da incluso la impresión de que estoy gastando más tiempo acomodando y\norganizando que buscando.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Perfecto! ¡Por los momentos, con esto tengo ahora 10 colores!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"De entre la variedad de instrumentos de pintura de óleo abandonados por los\nintegrantes de años pasados del club logré conseguir la última pintura que\nbuscaba.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"La última pintura estaba aún en su paquete. Valió la pena la búsqueda.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"En fin, con esto ya tengo 10 colores. Siendo un poco más avaricioso, me hubiera\ngustado encontrar 12, pero con 10 colores básicos se puede pintar de igual\nmanera.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Por ahora, logré conseguir todos los instrumentos necesarios para comenzar a\npintar en óleo.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya comenzaron las clases...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"En el receso del almuerzo, después de haber comido el mismo almuerzo de siempre\nde takikomi gohan a base de latas de yakitori, casualmente comencé a buscar\nlos instrumentos necesarios para pintar con óleo.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Ayer no pude darle las lecciones a Rin, pero ya está a punto de culminar el\ndiseño en dibujo, y pronto comenzará con el coloreo.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Le pregunte de manera indirecta acerca de los instrumentos, pero tal como me lo\nimaginaba, parece que no tiene su propio kit para pinturas de óleo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Conseguí de manera relativamente fácil el pincel, la paleta y la jarra de\naceite, pero en lo que concierne a las pinturas, fue una labor totalmente\ndistinta.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Sinceramente, esta parte fue terrible.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Conseguí fácilmente los primeros 6 colores.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Sin embargo, no podía dar con los otros 4.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"El problema de los cuatro colores.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Aun en esos momentos que parecía estar a punto de dar con ellos, no encontraba\nnada.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Aun así, logré encontrar 3 de ellos aún durante el receso del mediodía. Sin\nembargo, no encontraba de ninguna manera el último color.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Todos los que encontraba tenían la tapa ya abierta, o estaban completamente\nvacíos, o simplemente estaban endurecidos por el largo tiempo que estuvieron\nsin uso.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Un asunto al estilo de un rompecabezas. Por un momento siento que estoy por\nencontrar lo que necesito, pero luego me doy cuenta que no.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Cuando me puse a pensar acerca del último color, mi mente me forzaba a seguir,\ndiciendo 'Un poco más', 'Ya casi'.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Y al darme cuenta, la campana preliminar sonó.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Luego, la campana principal sonó.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Posterior a eso, más y más tiempo transcurrió... Hasta que llegamos al punto\nactual.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Observo el reloj.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que llegaré tarde...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Ya estaba a punto de ser la hora a partir de la cual toda entrada al salón se\ncuenta como inasistencia.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Umuh, desde que Toritani me dio aquel sermón, había procurado últimamente no\nsaltarme las clases, pero...",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque vaya ya, me tomarán como inasistente...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Por ahora, guardo el desordenado surtido de pinturas que reuní para Rin en la\ncaja.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que iré a clases de igual manera...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues las clases no son de gratis...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Y bueno, supongo que no está mal recibir algo de la influencia de Toritani...\nPor lo tanto, decidí asistir a clases.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="se2308"},
{"bg",rule="083r",vague=40,file="bg048k",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe la tardanza~”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"El profesor me observó por un instante, para luego proseguir con la clase.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Por ahora, me coloco en mi asiento tratando de no llamar tanto la atención.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"se",file="se9030",id=1},
{"mwact",act="ジャンプ",size=5},
{"text"},
text={
ja={
{
"*pomu*...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Justo en el momento en que me senté, algo vino volando desde atrás.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_a21_02",path=":ev/ev_com_a21/",set="ev_com_a21"},
{"text"},
text={
ja={
{
"Al voltear atrás, Toritani estaba viéndome fijamente.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Y entonces, hizo una señal, diciendo que recogiera lo que acababa de lanzar.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué demonios pasa?... Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Lo que Toritani había lanzado era un papel. Y en ese pedazo de papel...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000637_r",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué llegaste tarde?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_a21_03",sync=0,face=1,time=400,path=":ev/ev_com_a21/",set="ev_com_a21"},
{"text"},
text={
ja={
{
"Estaba escrito eso.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Me fastidiaba responderle, así que decidí ignorarla.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Por otro lado, la clase era de historia, y entré a mitad de clase, así que no\nentiendo nada de lo que están hablando.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Si es por esto, quizás hubiera sido mejor saltarme la clase.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Y justo cuando pensaba eso...",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_com_a21_02",sync=0,face=1,time=400,path=":ev/ev_com_a21/",set="ev_com_a21"},
{"se",file="se9030",id=1},
{"mwact",act="ジャンプ",size=5},
{"text"},
text={
ja={
{
"*pomu*...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"De nuevo algo vino volando hacia acá.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Sin voltear hacia atrás, desenvuelvo el papel que vino volando, y...",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000638_r",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me ignores.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Tenía escrito eso.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Realmente me daba fastidio, pero describí de manera breve en el papel todo lo\nque había pasado y se lo lancé de vuelta.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Después de leerlo, Toritani me vio fijamente de nuevo.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Y esta vez, me lanzó un pedazo de papel aún más grande que el anterior.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... pero qué rayos.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Fue ella la que me exigió que entrara a clases... ¿Por qué esa idiota me está\ninterrumpiendo ahora?...",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Mientras murmullaba mis quejidos, abrí ese gran pedazo de papel. Y entonces,\nallí había...",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000639_r",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Tomé apuntes para ti también, así que úsalos. Por si acaso, también agregue una\nbreve explicación de todo.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Apuntes con explicaciones incluidas...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_a21_03",sync=0,face=1,time=400,path=":ev/ev_com_a21/",set="ev_com_a21"},
{"text"},
text={
ja={
{
"La bola de papel era una pagina completa de apuntes.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Tenía escrito todo el flujo de la clase hasta ahora, acompañado de unas\nexplicaciones bastante claras y concisas. El contenido era bastante fácil de\nentender.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Ya veo, al observar esto puedo entender por qué Toritani tiene tan buenas\ncalificaciones.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Es EXCELENTE.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Al darme la vuelta para darle las gracias a Toritani,",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_a21_04",sync=0,face=1,time=400,path=":ev/ev_com_a21/",set="ev_com_a21"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000640",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"No sé por qué, pero me estaba sacando la lengua.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"¿Pero qué rayos?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_04_2"},
{"text"},
linkback="block_00205",
},
label = {
top={block="block_00000",label=1},
},
}
