astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c02_01",path=":ev/ev_eye_c02/",set="ev_eye_c02"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se2529"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000326",ch="aid"},
},
ja={
{
name={"???"},
"“¡Kyawah!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"bgm",file="bgm015"},
{"text"},
text={
ja={
{
"Temprano en la mañana. Los gritos de una mujer y una campana de fin de año\nresuenan alrededor.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"No, no hay manera de que en una mañana de abril suene la campana de fin de año.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Un estruendoso sonido metálico parecido al de una campana y el grito de una\nmujer me despiertan.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un grito? Esa voz es de...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Salgo apresuradamente de mi habitación.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",file="se3130",vol=70,id=1},
{"cgdel",id=-1},
{"bg",time=200,rule=280,file="black",path=":bg/",vague=40},
{"bg",rule=280,time=200,vague=40,file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Los gritos se escucharon de la dirección donde está la habitación de Ai. No\ncabe duda tampoco de que esa era su voz.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, ¿estás bien? ¿Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_aid_000327",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-S-Sí... E-Estoy bien... Auchh...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"No parece estar nada bien.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy a entrar, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_aid_000328",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, e-espera...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",id=1,file="se1279"},
{"bgm",stop=1,time=1000},
{"bg",time=200,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué... es esto?...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Ai estaba sosteniendo su cabeza con sus manos, encima de su futón, con lagrimas\nen los ojos.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"No hay problema con eso.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_a23_01",path=":ev/ev_com_a23/",set="ev_com_a23"},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
"El problema era la palangana de metal que rodaba en el suelo a su lado.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000329",ch="aid"},
},
ja={
{
name={"Ai"},
"“T-Te dije que estoy bien... ¿Por qué... abriste?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera abriría la puerta normalmente en estos casos, ¿no? Se escuchó un\nsonido bastante fuerte y un grito.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_aid_000330",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hay nada de qué preocuparse... ¡Auch!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_a23_01",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué no hay de qué preocuparse? Pero si tienes lagrimas acumuladas en los ojos.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000331",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, es que llevaba tiempo sin hacerlo. Creo que se me pasó la mano y tomé una\nmuy grande.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que tomaste una muy grande?... Tú...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"La palangana que estaba rodando por el suelo estaba hundida por una sola parte.\nEl tamaño de esa concavidad era justamente suficiente como para que entrara\nla cabeza de Ai.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será que estuviste despertándote todo este tiempo de esta manera antes de que\nyo llegara?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_aid_000332",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajaja... A veces me despierto usando despertadores convencionales. En tus\nprimeros días aquí me despertaba con despertadores convencionales, ¿no\nrecuerdas?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Este es tu despertador de uso especial?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Al verlo bien, la palangana de metal tenía una cuerda amarrada, y en el techo\nhabía un gancho.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"En los dos lados del reloj despertador está pegada cinta adhesiva.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Era un mecanismo tan simple que bastaba con verlo una vez para entender más o\nmenos su estructura.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Los relojes despertadores pueden ser detenidos temporalmente con solo pulsar el\nbotón. Sin embargo, eso no basta para desactivarlos completamente.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Al momento de desactivar los relojes despertadores, uno levanta,\ninconscientemente, el despertador como tal.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Una vez se levante el despertador, la cuerda que está fijada con cinta adhesiva\nse despegará... y la palangana de metal colgante caerá sobre la cabeza de Ai.\nAsí funciona.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De no llegar a esos extremos no puedes despertarte?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_a23_03",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000333",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No me veas con esos ojos de pena! Me vas a poner triste.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿será que has estado haciendo esto todo este tiempo hasta antes de que\nyo llegara a esta casa?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000334",ch="aid"},
},
ja={
{
name={"Ai"},
"“A la familia Natsume le cuesta bastante despertarse en las mañanas... Además,\nsería terrible que hasta yo me levantara tarde.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_aid_000335",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entiendo lo que quieres decir. Aunque, realmente me da pena decir esto, pero de\nno construir esta clase de aparatos no puedo levantarme...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Lanzo un profundo suspiro.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_a23_03",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000336",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Estás poniendo esa cara de nuevo!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que la pongo, tonta!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_aid_000337",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Uwan, no le digas tonta a tu profesora! Y además, no está bien que le llames\ntonto a alguien que se está esforzando.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé perfectamente que a la familia Natsume le cuesta bastante levantarse en las\nmañanas. Pero por lo menos yo no tengo problemas despertándome.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, parece que fui yo el único que se despertó con tus gritos...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_a23_01",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000338",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo siento. No debe sentirse muy bien que te haya levantado con mis gritos...\nMañana pondré todo mi esfuerzo para no gritar...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No necesito ese esfuerzo de tu parte.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_a23_03",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000339",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Si no me esfuerzo en eso no podré levantarme!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te estoy diciendo que no hace falta que lo hagas, pues yo vendré a levantarte.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000340",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Pero eso sería mucha molestia para ti...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Era mentira lo de que querías recibirme como un miembro más de la familia?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_a23_04",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000341",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Q-Qué dices de repente?! ¡P-Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no pienses en ello como una molestia. De ahora en adelante será mi\ntrabajo venir a levantarte.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000342",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Pero si hago eso estaría poniendo demasiada carga sobre ti...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, ya es suficiente con que me proporciones techo y comida. Además, no\nvale mucho la pena cocinar solo, pero sí cuando lo hago para varias personas.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000343",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_a23_01",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000344",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Uwaan! ¡¿Por qué eres un chico tan bueno y competente?! ¡Deja que Onee-san\ntambién se esfuerce un poco!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué estás diciendo...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, siempre has estado protegiendo a esta casa y esta familia, ¿no? ¿Acaso no\nte estás esforzando ya demasiado?...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_a23_02",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000345",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, cámbiate rápido.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y la próxima vez que nos veamos, cambia de nuevo a la misma onee-san estricta y\nrecta de siempre.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_aid_000346",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_a23_05",sync=0,face=1,time=400,path=":ev/ev_com_a23/",set="ev_com_a23"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000347",ch="aid"},
},
ja={
{
name={"Ai"},
"“Gracias...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué.. estás diciendo? Idiota.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"msgoff"},
{"bg",file="bluesky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Me dio algo de pena, así que terminé saliendo de la habitación de Ai casi\ncorriendo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Gracias a Ai, pude levantarme un poco más temprano de lo usual.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Hoy podré preparar el desayuno con tranquilidad.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",y=-90,speed=120000,rule=139,vague=40,file="zbg003a",path=":bg/",x2=90,y2=-90,x=-290,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm030"},
{"se",file="se9016",loop=1,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000103",ch="szd"},
},
ja={
{
"El aromático olor del café.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_szd_000104",ch="szd"},
},
ja={
{
"El sonido de los huevos friéndose encima del aceite.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_szd_000105",ch="szd"},
},
ja={
{
"El aroma de la mantequilla derritiéndose sobre las tostadas.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0003",head="shz_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera! No vengas con esa extraña narración justo al lado de alguien que está\nfriendo chicharros abiertos y preparando sopa de miso con aburaage.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000106",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa~”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, si no te apresuras llegarás tarde.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000107",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entendido~”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9002",vol=50,id=1},
{"msgoff"},
{"fg",ch="雫",sync=1,mx=40,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad habrá entendido?...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tan solo espero que no termine ahogándose en el lavabo o algo así...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0000",face="h0003",head="aix_z1h",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_aid_000348",ch="aid"},
},
ja={
{
name={"Ai"},
"“Oh, esto se ve igual de bueno que siempre.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el menú de hoy, chicharros abiertos y sopa de miso con aburaage.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000349",ch="aid"},
},
ja={
{
name={"Ai"},
"“Chicharros abiertos y sopa miso con aburaage, toda una mañana japonesa, eh.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000108",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? Shizuku, ¿ya te despertaste por fin?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000109",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... la comida cambió...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000110",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La comida es distinta...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La comida no es distinta, ni tampoco ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000111",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero hasta hace un rato estabas preparando tostadas y huevos fritos...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso fue solo una ilusión que tu propia narración procreó.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0017",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="icon",y=-500,lv=4,id=9,icon="icon02z1",x=40},
{"text"},
text={
vo={
{"vo",file="fem_szd_000112",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Ilusión?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, un desayuno ilusorio. Come rápido y vete al colegio.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000113",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0017",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000114",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jii~”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0006",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000115",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jii~”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás medio dormida aún, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000116",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tal vez? Pero si te veo despierta.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0009",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000117",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es que todo lo que veo acá no parece ser una ilusión.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ilusión?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0011",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000118",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, estos chicharros abiertos y esta sopa de miso con aburaage no parecen una\nilusión...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No son ninguna ilusión, son reales.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0013",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000119",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? Pero Naoya, hace un momento...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, no me veas con esa cara tan angustiada. Cuando dije ilusión me refería a\nlas tostadas y a los huevos fritos. Los chicharros abiertos y la sopa miso\nson reales.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Shizuku lucía extrañada, pero igualmente comenzó a comer lentamente los\nchicharros abiertos.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000120",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No sé muy bien lo que está pasando, pero... este chicharro está muy bueno...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, eso me alegra...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Shizuku traga lentamente. Se lleva incluso los huesos... mordiendo y crujiendo.\nUna forma de comer, la cual no distingo si es refinada, o enérgica y voraz.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bgm",stop=1,time=1500},
{"se",stop=1,id=-1,time=1500},
{"vostop",stop=1,time=1500},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1500,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm037"},
{"text"},
text={
ja={
{
"Inevitablemente, al haberme levantado más temprano de lo usual, mi llegada al\ncolegio también fue más temprana.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Me quedaba aún algo de tiempo antes de que comenzaran las clases, así que me\ndirigí a la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"cgdel",id=-1},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Al revisar que no estuviera cerrada con llave, deslicé toscamente hacia un lado\nla puerta, la cual no giraba muy fluidamente.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",id=1,file="se1279"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"La sala de arte, aún ligeramente a oscuras al no ser aún la hora de entrada al\ncolegio. Una ligera sombra retorciéndose apareció en los rincones de mi\nvista.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay alguien ahí?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Con una voz algo fuerte le pregunté eso a la sombra.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Después de que se escuchó el sonido del suelo rozando con algo―― La figura de\nalguien apareció.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000508",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Soy yo...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como me lo imaginaba, eras tú, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000509",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir con 'me lo imaginaba'?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, digo, eres la única que podría estar a estas horas aquí, ¿no? Por lo seria\nque eres.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000510",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir con 'seria'?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Toritani hace un mohín, quizás algo frustrada con mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna manera viniste a jugar o pasar el tiempo acá desde temprano, ¿no?\nPor supuesto, tampoco parecieras estar pintando.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que tienes en la mano es muy grande como para ser un pincel.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Toritani tiene una escoba en su mano. Claramente no está pintando nada.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000511",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué broma tan ridícula, eh... Déjame agregar que el hecho de que pienses que\n'limpieza = seriedad' demuestra tus ínfimos estándares de seriedad y\nresponsabilidad...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo limpiaras de vez en cuando quizás tuvieras razón. A alguien como en tu\ncaso, que limpia sola todas las mañanas sí se le llama 'seria', ¿no? Además,\ntambién organizas la sala después de clases, cuando todos se van.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000512",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh, d-de qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De tu día a día.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000513",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No lo hago todas las mañanas... ¡Los domingos y los días feriados no lo hago!\n¡¿E-En primer lugar, cómo sabes eso?! ¡Tú, que te la pasas siempre llegando\ncasi tarde al colegio!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que por qué?...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000514",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eso que dices de que vengo cada mañana! ¡¿Puedes explicarme en base a qué\ndices eso?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Parece que no era un tema que quería que le sacaran en cara. Toritani me\ninterroga fuertemente, con una inesperada fuerte voz y la cara completamente\nroja.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, lo siento, lo siento. Lo de 'cada mañana' lo dije por decir. No es\nque te he estado observando ni nada de eso. Pero aunque llegue siempre casi\ntarde a clases no implica que sea por llegar tarde al colegio.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cada vez que llegaba temprano al colegio te veía en la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0010",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000515",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quién diría que a veces llegas temprano, eh? No puedo creer que no me haya\ndado cuenta...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿cuál es el problema? ¿Por qué tienes que actuar a hurtadillas aun\ncuando se trata de algo bueno? Si fuera por mí, se lo contaría a todo el\nmundo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000516",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mi personalidad es totalmente distinta a la tuya, de raíz...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Personalidad, eh... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000517",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa? Esa manera de hablar fue algo sugestiva.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, sientes bastante amor por este club, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000518",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Amor? Soy la jefa, ¿acaso no es obvio?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre ha sido así, incluso antes de que te volvieras jefa. Tengo la impresión\nde que desde el primer día que entraste al colegio comenzaste a limpiar...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000519",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿C-Cómo sabes eso también?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque te estuve observando.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000520",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿P-Por qué?! ¡En esa época ni siquiera nos habíamos hablado! ¡¿No?! ¡¿Por qué\nme observaste cuando apenas acababa de entrar al colegio?!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues digamos que tenía algo de interés por este club de arte... Así que apenas\nentré al colegio, vine a espiar un poco.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yumihari es el colegio donde Kenichiro Kusanagi se graduó, y su club de arte es\nbastante famoso, así que a pesar de haber dejado de pintar me llamó la\natención.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ende, el primer día de clases no perdí el tiempo y vine a echarle un ojo al\nclub de arte. Ese día también vine temprano en la mañana.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",mode=-2},
{"bg",file="ev_com_a24_01",path=":ev/ev_com_a24/",set="ev_com_a24"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En esa época aún tenías el cabello corto, eh... Y parecías ser más pequeñita\nque ahora...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, tampoco es que has crecido tanto, así que supongo que eran más\nbien los aires que tenías a tu alrededor...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"No... hay un solo lugar que sí le ha crecido excepcionalmente, pero... Mejor no\ntoquemos ese tema.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La vi limpiando tan meticulosamente que creí que las relaciones de jerarquía en\neste club eran tan severas como las de un club deportivo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, al observar mejor, me di cuenta de que esa muchacha estaba haciéndolo\nalegremente.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y entonces pensé 'Debe ser una senpai con bastante afecto por el club'... Pero\ncuando observé con más atención, me di cuenta de que eras una estudiante de\nnuevo ingreso, que ni siquiera había aún entrado oficialmente al club...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000521",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿C-Cómo supiste que aún no había entrado al club?...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque para esa época aún no se podían consignar las planillas de ingreso a los\nclubes, ¿no recuerdas? Además, llevabas la placa de primer año... Obviamente\nno habías ingresado aún al club...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000522",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“T-Te fijas demasiado en detalles insignificantes, eh...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde aquel entonces me llamaste la atención. Te vi varias veces, y en todas\nsiempre dejabas impecable la sala...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé, ah, debe ser una muchacha de muy buena personalidad... Me imaginé eso\nsin saber realmente nada. No cualquiera podría limpiar el piso por su cuenta\ntodas las mañanas.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recuerdo cómo frotabas alegremente el suelo con el paño. Te ponías en cuatro\npatas sobre el suelo, aun cuando se te podían ensuciar las medias y las\nrodillas... Aun así, tenías una sonrisa bastante alegre.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, después que llegué a hablar contigo me di cuenta de que eras\ntotalmente diferente y me sorprendí.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Apenas nos vimos dijiste '¿Tú eres Naoya Kusanagi? ¡Tú! ¡¿Cómo puedes ser capaz\nde hacer algo tan disparatado como no entrar al club de arte?!'.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ese momento, pensé desde lo más profundo... 'La disparatada eres tú'.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bgm",stop=1,time=300},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000523",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=100,func="wait"},
{"bg",file="閃光小",id=9,lv=9,rule=119,time=100,path=":cg/battle/",set="battle"},
{"se",id=1,file="se1615_z"},
{"ex",time=100,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=-380,speed=200,file="zbg049a",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",speed=200,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0200",face="b0005",head="mak_z2b",x2=0,x=-300,lv=5,id=9,sync=0},
{"quake"},
{"quake",mode="mw"},
{"extrans",time=100},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wah!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Toritani corrió a atacarme de repente con la escoba. A duras penas logré\nesquivar el ataque.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",speed=500,mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0005",head="mak_z2b",x2=-300,x=0,lv=5,id=9},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000524",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O-Olvida todo eso... ahora mismo...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0021",head="mak_z2b",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000525",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Por todo! ¡Me dan náuseas de solo pensar que estuviste observándome todo ese\ntiempo!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Vamos, ¿acaso realmente importa? ¿O qué? ¿Acaso te da vergüenza que\nalguien descubra que en realidad tienes una personalidad bastante diligente?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",mode=-2,sync=0},
{"bg",zoom=70,x=100,speed=280,file="zbg049a",path=":bg/",z2="100,90,80",x2="-380,100,-200",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",zoom=90,speed=280,mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0005",head="mak_z2b",x2="0,200,-200",z2="100,97,94",x=200,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",id=1,file="se1615_z1"},
{"quake",mode="mw"},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uoh, s-si agitas tanto esa escoba podrías tumbar alguno de los bustos! Son\ncaros, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fgact",ch="真琴",act="停止",lv=5,id=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0019",head="mak_z2b",x=200,lv=5,id=9,zoom=90},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000526",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?... ¿Así de grande era ese secreto?...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",x=200,lv=5,id=9,zoom=90},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0021",head="mak_z2b",x=200,lv=5,id=9,zoom=90},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000527",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No era realmente un secreto, pero... ¡No pensé que me hubieran visto todo\neste tiempo mientras limpiaba! ¡¡Ahh, demonios!!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=0,speed=280,file="bg049a",path=":bg/",z2="140,140",x2="100,-350",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",zoom=100,speed=280,mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0005",head="mak_z2b",x2="200,-400",z2="90,100",x=0,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",id=1,file="se1615"},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es--, espera, si mueves eso podrías romper algo de verdad.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fgact",ch="真琴",act="停止",lv=5,id=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0007",head="mak_z2b",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000528",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Olvídalo. Olvida todo lo que viste en aquel momento.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"select",label="label01",exp="f.mak=f.mak+1",text="select"},
{"select",label="label02",text="select"},
{"select",name="select01_03_1",mode="sys"},
{"text"},
select={
ja={
"Sería un desperdicio olvidar cómo limpiabas con esa sonrisa.",
"Se me hizo tan cómico verte limpiando con esa sonrisa",
{"rt2"},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Sería un desperdicio olvidar cómo limpiabas con esa sonrisa tan\nmansa...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"excall",label="join1"},
{"text"},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Se me hizo tan cómico verte limpiando con esa sonrisa tan mansa que\nno puedo olvidarlo...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"excall",label="join1"},
{"text"},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0006",head="mak_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000529",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Nuh!”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",time=100,file="black",path=":bg/"},
{"se",file="se2271",id=1},
{"bg",file="連続斬撃_100",id=9,lv=9,rule=116,time=50,path=":cg/battle/",set="battle"},
{"text"},
text={
ja={
{
"¡La escoba se acerca sobre mí! Al instante traté de ejecutar un shinken\nshirahadori.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"cgdel",id=-1},
{"bg",time=100,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se0002_z"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuoh...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Aun con mi excepcional visión dinámica (según proclamo yo mismo) no pude\nejecutar esa técnica, y la escoba impactó directamente mi frente.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Auch!...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000530",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quizás debería eliminar de manera física las memorias de tu cabeza así como\nahora?...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien. Está bien. Lo olvidaré. Me esforzaré para olvidarlo. No te\npreocupes. ¡Ya no lo recordaré ni lo volveré a mencionar más!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0006",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000531",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Hmph! Por Dios, no puedo bajar la guardia ni un momento contigo. En fin,\nolvida todo lo concerniente a ese momento. Y no se lo cuentes a nadie más.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no se lo cuente a nadie? Llevo 2 años sabiéndolo y no se lo he dicho a\nnadie...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000532",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Entonces sigue manteniendo las cosas así!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien. No tengo intención alguna de decirle a nadie.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿por qué tratas de ocultar eso? No es nada de lo que debas avergonzarte,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000533",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es que esté tratando de ocultarlo, pero...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que lo estás. Si incluso me acabas de ordenar que lo mantenga en\nsecreto...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000534",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eso es porque tus explicaciones son poco fiables! Simplemente no quiero que\npor tu manera tan descuidada de hablar las personas crean algo distinto a la\nrealidad.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Eso me huele a mentira...",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"¿Acaso no eres el tipo de persona a la que no le importa si los demás tienen\nmalentendidos respecto a ti?...",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hahan? ¿No será que contrario a todo, esa es tu verdadera cara?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será que esa dócil y buena muchacha es la verdadera tú, y simplemente te da\nvergüenza de que los demás sepan cómo realmente eres?...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0018",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000535",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿P-Pero qué clase de estupideces estás...? ¡P-Por supuesto que no es eso! ¡A-A\nmí no me importa lo que piensen los demás! ¿Será que aún necesitas que te\ngolpee más?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, ya tuve suficiente de tanto dolor...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"¿De verdad se puede afirmar que una persona que diga conscientemente 'no me\nimporta lo que piensen los demás' realmente sea así?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Bueh, si digo algo más probablemente siga golpeándome, así que no lo diré...",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bg",file="black",path=":bg/"},
{"bg",file="ev_com_a24_01",path=":ev/ev_com_a24/",set="ev_com_a24"},
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Es imposible que alguien que no sea serio y responsable por dentro limpie de\nmanera tan esmerada al apenas recién ingresar al colegio...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Toritani siempre pretende ser del tipo que no le importa lo que los demás\nopinen, pero hay partes que sencillamente no puede cubrir ni ocultar de\nninguna manera.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Es extrañamente responsable, y también considerada con los demás...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Cuando llevas un largo tiempo conociéndola te das cuenta de que es\ninesperadamente amable...",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",time=1000,size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000536",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué?... No habrás estado pensando de nuevo en más cosas ridículas, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No... Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Me está viendo con un aspecto intimidante. Casi como si estuviera a punto de\nvenir a golpearme en cualquier momento...",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Quizás lo de 'amable' no sea totalmente cierto. Así como ven, me golpeó hace un\nmomento con la escoba.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000537",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Por qué hoy viniste tan temprano al colegio?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada en particular, simplemente me levanté más temprano de lo usual.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000538",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por eso? Podrías ponerte a pintar entonces, aprovechando que estás en la sala\nde arte desde temprano.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Respondo con una sonrisa amarga ante esa opinión tan acertada.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Hacer eso sería lo normal.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Pero yo no lo hago. No puedo hacerlo.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Se me escapó un poco la sonrisa ante lo cómico del asunto.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000539",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Por alguna razón, Toritani me observa con una cara más compuesta y seria.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000540",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bgm",stop=1,time=500},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000541",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quisiera preguntarte algo... ¿Puedo?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"La mirada de Toritani observándome. Me dio un cierto mal presentimiento.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Toritani prosigue la conversación, aún sin yo haberle contestado nada.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000542",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La razón por la cual dejaste de pintar... Por la cual no puedes pintar... Será...\nque――”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bgm",file="bgm106"},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0200",face="b0008",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000543",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será que... tiene que ver con Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Fueron tan repentinas esas palabras que no pude contestarle. Solo pude quedarme\nparalizado, sin poder negar ni afirmar nada.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000544",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Al verme de esa manera, Toritani siguió hablando, luciendo un tanto remordida.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000545",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo siento, creo que pregunté algo muy extraño de repente... Si no puedes\ncontestarme entonces no hace falta que lo hagas...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es eso, solo que...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Respondo de manera frenética. Con esta actitud que tengo, realmente no\npareciera que realmente 'no fuera eso'.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000546",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué pensaste eso?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000547",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay razón, solo fue pura intuición.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Intuición?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000548",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso lo siento, por haber dicho algo tan descuidado, solo que quise\npreguntártelo de repente... Sí, olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"se",file="se2405",id=2,loop=1},
{"text"},
text={
ja={
{
"Al decir eso, Toritani me dio la espalda y comenzó a limpiar.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Como si tratara de darle fin a la conversación...",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"se",stop=1,id=2,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbg049a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2c0200",face="c0001",head="mak_z2c",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas... Toritani.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie tiene la culpa de que yo haya dejado de pintar. El problema me concierne\nnada más a mí. ¡Eso es todo!”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000550",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Toritani suelta un suspiro, con una cara algo aquejada.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0025",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000551",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vas a decir eso ahora? Eso ya lo sé. Sé que eres ese tipo de persona.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres con 'ese tipo de persona'?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0016",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000552",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Significa justo lo que dije. Aunque, quiero que sepas que no soy tan ingenua\ncomo crees.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000553",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei también ha empezado a darse cuenta también. Acerca de, por lo menos, por\nqué dejaste de tomar el pincel...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000554",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, aun así...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2c0200",face="c0001",head="mak_z2c",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani observa la montaña de caballetes y se queda en silencio.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun así, ¿qué?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000555",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Toritani da un respiro, y luego continúa la conversación.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000556",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pintaste algo en invierno, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cómo es que sabes...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000557",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo dije y te lo diré de nuevo, no soy tan ingenua. Por supuesto, tampoco\nsoy tan perspicaz como para saberlo todo...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No me digas que fue Akashi quien te dijo que yo había pintado algo?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000558",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai no me ha dicho nada.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, por qué...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000559",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que por qué?... Cualquiera se daría cuenta. El olor a pintura que llevabas\nencima. El aspecto que tenías a diario... Esa característica atmósfera\nalrededor que tiene alguien cuando pinta...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000560",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa cara pensando en la estructura. Esa cara pensando en los pigmentos a usar.\nLa manera de actuar de alguien que pinta, es especial...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000561",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A veces también hacías gestos con la mano, como si estuvieras moviendo un\npincel en el aire...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0026",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000562",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no voy a preguntarte la razón. La verdadera razón por la cual dejaste de\npintar, ni tampoco la razón por la cual pintaste un cuadro de un día para\notro.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000563",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No parece ser el tipo de problema que pueda resolverse preguntando...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0011",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000564",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo que siempre espero con ansias con que pintes algo, así que me da lástima\nno poder haber visto el cuadro que pintaste hace poco, pero... Seguramente\nera una pintura que no podías mostrarle a los demás, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000565",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O quizás, era una pintura que no podías mostrarle a los demás, y por eso la\nterminaste a escondidas.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... Esa fue una excelente deducción. ¿Cómo se te ocurrió eso?”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000566",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuiste a la tienda de materiales de pintura en Sakuragahara a buscar pigmentos,\n¿no? Y le exigiste al dueño que no dijera nada.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El abuelo de Materiales de Pintura Sakuragahara te lo contó todo?... Ese\nviejo.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0029",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000567",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era inevitable. A él también le gustan tus pinturas. Estaba tan feliz de que\nfueras a buscar pigmento que terminó contándome a mí también.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué el hecho de que estuviera feliz hizo que te lo dijera todo?”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0004",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000568",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es acaso obvio? A mí me encantan tus cuadros. Más que a ese señor, y más\nque a nadie.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qu--”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Fue tan directa y tajante en esa confesión que no pude contestar nada.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000569",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que algún día, quisiera ver el cuadro que pintaste... Siempre pienso\núnicamente en lo mismo. No puedo esperar a que venga el día en que llegues a\npublicar una obra, un cuadro que tú hayas pintado.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás sobrevalorando... Yo no soy tan gran pintor...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0028",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000570",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú no eres el que decide si de verdad te estoy sobreestimando o no. Digas lo\nque digas, yo seguiré esperando siempre por tus cuadros. No lo olvides,\nseguiré esperando por siempre.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No esperes una obra de alguien que dice que no pintará más.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000571",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pinto... Eso es lo que te la pasas siempre diciendo, ¿eh, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000572",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero el período de validez de las palabras no es eterno.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000573",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, que no se te olvide esto. Las palabras tienen valor porque en algún\nmomento dejarán de ser válidas. No hay sentido alguno en unas palabras que\nperduren por siempre. Es igual a que si no existieran.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo lo que quieres decir...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000574",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero decir que siempre surgirán palabras nuevas. Por eso es que las promesas\ntienen valor en sí.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi decisión de no volver a pintar no es ninguna 'promesa'...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000575",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí no me importa si la razón por la cual dejaste de pintar es una promesa o\nno.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0006",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000576",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo que quiero decir es que esas palabras tuyas de 'no pintaré de nuevo' no son\nabsolutas! ¡Solo eso!”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000577",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú volverás a pintar.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En base a qué sales con eso...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, la decisión de pintar o no ahora o después me incumbe nada más a mí...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000578",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Tienes razón. No es el problema de nadie más, sino tuyo.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"se",id=1,file="se1895"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000579",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ya sonó la campana.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Si no vamos ya, llegaremos tarde.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000580",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa, Kusanagi? El mismo que nunca se preocupa por llegar temprano dice\neso ahora. ¿Tan ansioso estabas por parar esta conversación?”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Simplemente me parece un desperdicio llegar tarde a clases a\npesar de haberme levantado temprano.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000581",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente. Ahora que lo dices, quizás tengas razón.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
"Toritani sonrió amablemente.",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
