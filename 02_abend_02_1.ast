astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=180000,rule=139,sync=1,vague=40,path=":cg/",x2=0,y2=0,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Las flores de cerezo cayeron, y el tiempo transcurre...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El paso del tiempo es algo misterioso...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Y si me preguntan por qué, pues es porque nadie puede ver realmente como pasa\nel tiempo. Y aun así...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Los escenarios que estaban se pierden, y el escenario frente a nuestros ojos\npasa a convertirse en algo nuevo.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"¿A dónde irán esos escenarios perdidos?",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"A los escenarios perdidos se les llama pasado, y a aquellos que están frente a\nnuestros ojos, presente...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"¿A dónde habrá desaparecido la nieve de primavera que teñía a la ciudad?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"El escenario que se extiende ahora frente a mis ojos es algo totalmente\ndistinto...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un fuerte sol.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un verde exuberante.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El aroma de las plantas.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debajo de este cielo de verano.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que las estaciones se mueven de manera sigilosa, pero certera...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bgm",stop=1,time=10000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000833",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me importa que te hundas en el placer de tus palabrerías, pero... Kusanagi,\nrealmente eras un idiota, eh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cállate.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=-40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",time=250,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000416",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos Mako-chan, cálmate, Kusanagi-kun se sentirá mal si le dices eso.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000834",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero es que...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Esa estación que cautiva a los estudiantes de todo el mundo, la estación del\ncielo traslúcido y donde surgen los cumulonimbos.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Estamos ahora recibiendo lecciones suplementarias en el salón, sin aire\nacondicionado.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Logré superar el examen de geografía con nota reprobatoria, y estoy ahora acá.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Parece... que no lo he superado después de todo.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000417",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun, cálmate tú también y tratemos de resolver la mayor cantidad de\nproblemas que podamos, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? Claramente es Toritani quien vino a buscarme pelea.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000828",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es, no es bueno llamarle idiota a los demás, Makoto.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000835",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Acaso no eres tú igual?... ¿O, no había sido peor en tu caso? Escuché que\nsaliste fatal en casi todas las materias.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"msgoff"},
{"fg",ch="真琴",mode=-1,lv=4,id=5,sync=0},
{"fg",ch="圭",speed=500,mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x2=345,x=0,lv=4,id=6,sync=0},
{"extrans",time=300},
{"ex",time=0,func="wait"},
{"ex",time=0,func="wait"},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Esta visiblemente rara criatura que tengo a mi lado reprobó Informática,\nBiología, Inglés W, Inglés R, Literatura Moderna, Seminarios de Geografía,\nHistoria y Educación Cívica, Matemáticas, Historia de Japón B, Política y\nEconomía, y Ética, obteniendo unas calificaciones sin precedente histórico\nalguno en Yumihari.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Y así es como sus esperanzas de graduación entraron en una situación bastante\ndesesperanzadora, apenas desde el final del primer período.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Pero aun así, él...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000829",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajajaja...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Con su característica alegría, está recibiendo las clases suplementarias con\nbastantes ánimos, sin ninguna angustia ni zozobra por el futuro.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=0,lv=4,id=6},
},
vl02={
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000830",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajajaja, pero qué nombre tenía este tipo, Butaki Ishikawa. Butaki,\najajajaja. ¿Es que los padres no pensaron nada cuando le pusieron ese nombre?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Eso es lo que quisiera decirle yo a los padres que te trajeron a este mundo...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000836",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, tú tampoco puedes burlarte de Kei. ¿No te da vergüenza haber\nreprobado?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... Si no me hubiera lastimado el dedo antes del examen no habría sucedido\nesto... Cómo resiento esa herida...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0003",head="mak_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000837",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, por supuesto, ciertamente. Aquel día te cortaste muy profundamente las uñas\ny andabas ruidoso, diciendo, 'cómo duele, cómo duele', eh.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es... Tuve mala suerte.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000838",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿es que no te das cuenta de que estoy siendo sarcástica?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-570,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000418",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, con toda certeza cualquiera se distraería si le doliera algo, así que\nsigamos estudiando, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=570,lv=4,id=4},
{"fgact",ch="圭",act="うんうん",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="man_ked_000831",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, cuando hombres como tú con aires de tipo frío y reservado resultan\ntener la cabeza hueca también, ya sencillamente no les queda remedio alguno,\neh.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Preferiría que no me lo dijera un idiota por dentro y por fuera como tú.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=570,lv=4,id=4},
{"fgact",ch="圭",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_000832",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué parte de mi aspecto físico parece ser idiota?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0008",head="rin_z1b",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="うんうん",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000419",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡En fin, vamos a calmarnos! ¡Vamos, pongámonos a resolver problemas!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=570,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000839",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Por Dios, soy yo la que quisiera reclamarle a ustedes. ¿Por qué\nRin-chan y yo tenemos que trabajar supervisándolos?...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000420",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, no hay problema. Mientras estos dos no terminen con las clases\nsuplementarias no podremos seguir con las actividades del club de arte, y\nademás, me estoy divirtiendo.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
text={
ja={
{
"Rin da una palmadita con sus dos manos, con una sonrisa bastante entretenida.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo no me estoy divirtiendo!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000840",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pero qué escandaloso! ¡No estás haciendo nada! ¡Apresúrate y termina ya con\nesa guía de problemas!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",id=1,file="se2308"},
{"fg",ch="圭",mode=-1,lv=4,id=4},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=570,lv=4,id=4},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_aid_000392",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Están estudiando como debe ser?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, perfectamente. Tanto que ya no necesitamos más clases suplementarias.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000841",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se la pasa reclamando y no ha avanzado nada...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toritani!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rnd_000421",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun, creo que no sirve de nada tratar de mentir de esa manera. No has\nresuelto ningún problema...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuh...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=570,lv=4,id=4},
{"fgact",ch="藍",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000393",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mientras no terminen las lecciones suplementarias no podrán comenzar sus\nvacaciones de verano, así que trabajen con seriedad.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",mode=-1,lv=4,id=3},
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x2=570,x=345,lv=4,id=4},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000833",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajaja, así mismo, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000394",ch="aid"},
},
ja={
{
name={"Ai"},
"“Idiota, esto va en particular para ti. Ya has tratado de escaparte incontables\nveces...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0004",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000834",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué dices que me he estado escapando? Esas solo eran retiradas\nestratégicas.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0017",head="aix_z1f",x=345,lv=4,id=4},
{"fgact",ch="藍",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000395",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ohhh, ¿qué significa entonces que te retires estratégicamente en ese momento?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
},
vl02={
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
},
vl03={
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000835",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡En las batallas existe la ventaja que ofrece el terreno, el cielo, y las\npropias personas!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000842",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Deja de decir disparates y termina de una buena vez... Por Dios, realmente no\ntienes nada bueno excepto por tu habilidad para pintar, Kei...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000836",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué dices?! ¡Yo soy una especie de cofre de puras cosas buenas!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"¿Qué clase de cofre es ese?",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000396",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, perdonen por dejarlas tanto tiempo acá. Yo me encargaré de lo que resta,\nasí que no hay problema, ustedes dos. Van al club de arte, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000422",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, por mi parte no hay problema. Parece que ya van a terminar, así que\nesperaré hasta el final.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0010",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000843",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo mismo. Ya nos hicieron perder bastante tiempo, así que me quedaré hasta el\nfinal.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_000837",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ajajajaja, me acabo de dar cuenta de algo! Chi no ri (Ventaja del terreno) y\nChinori (sangre pegajosa) se parecen. Son idénticas. Se me sobresaltó el\ncorazón.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000397",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tú... Aun cuando todos están usando su valioso tiempo por ti... ¿Es que acaso\nquieres que te golpee hasta sacarte sangre de verdad?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000844",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, debo decir que es sorprendente que hayas podido entrar a Yumihari con\nestas calificaciones tan terribles. El nivel estándar de este colegio es\nrelativamente alto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000398",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, es algo vergonzoso para mí decir esto, pero Kei entró por recomendación\nespecial, así que tiene varios problemas en sus habilidades académicas.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000845",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Eso quiere decir que Kusanagi también...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mi caso es distinto!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000399",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ciertamente, Kusanagi es distinto. O más bien, se podría decir que sus\ncalificaciones entran en la categoría de 'Buenas'. Aunque no se distribuyen\ntan uniformemente...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Así es.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000846",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Entonces por qué estás recibiendo lecciones suplementarias?...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=345,lv=4,id=4},
{"fgact",ch="藍",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000400",ch="aid"},
},
ja={
{
name={"Ai"},
"“Casi todas sus calificaciones son excelentes, pero su falta de motivación para\nlas materias que odia es casi anormal. ¿Cómo es que únicamente en geografía\nsacaste 10 puntos?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000847",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿10 puntos? ¿Pero qué demonios? ¿Cómo puede hacer alguien para obtener esa\ncalificación?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues eso es...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000838",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, eso es porque Naoya tiene un pésimo sentido de dirección.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000401",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pésimo sentido de dirección?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000839",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya siempre ha tenido un mal sentido de dirección desde que era un niño. Y\nlos demás se burlaban de él por eso, así que llegó un momento en que dijo que\nno leería más mapas, y entonces realmente se volvió incapaz de entenderlos.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000423",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-La verdad es que eso no me parece que sea cierto. El Kusanagi-kun de hace\ntiempo no era así...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_ked_000840",ch="ked"},
},
ja={
{
name={"Kei"},
"“Parece que no era tan terrible antes de que se burlaran de él. Pero en el\nmomento en que los demás comenzaron a burlarse, su sentido de dirección\nempeoró aún más, y ahora la configuración de su cuerpo no le deja salir\nsiquiera de la ciudad Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000848",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Hablas en serio? ¿Pero qué configuración tan cómica es esa? Parece un RPG con\nun bug sin resolver.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000424",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Desde pequeños, pensaba que Kusanagi-kun era capaz de hacer todo,\npero parece que tiene un lado totalmente inusual...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te ríes justo ahora tan felizmente?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000425",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, perdón, perdón. No fue con ninguna mala intención.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, se supone que geografía debería ser una electiva a partir del\ntercer año. ¿Por qué este colegio obliga a los estudiantes de mención\nCiencias a tomar geografía?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000402",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hay nada que se pueda hacer, de esa manera está planificado.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch. Si no hay problema con las otras materias entonces por lo menos háganse la\nvista gorda de una simple materia reprobada.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=4},
{"fgact",ch="藍",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000403",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero es que tus conocimientos de Geografía son peores que los de alguien de\npre*scolar...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000849",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Así de terrible es?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000404",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... Kusanagi, dibuja el mapa del mundo para probar.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué debo hacer eso?!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0016",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000405",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Entonces hagamos que ese sea tu examen de reparación! Si logras hacerlo, daré\npor finalizada tus lecciones suplementarias.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedes hacer eso aunque no seas la encargada de geografía, Ai?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000406",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, no importa. Yo tomaré toda responsabilidad al respecto.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... Si es así, entonces lo haré.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya se han burlado demasiado de mí, imbéciles...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm007"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000850",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ajajajajaja! ¡¿Qué es esto?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_ked_000841",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿L-Lo ves?! ¡No tiene ningún remedio!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_uni_c18_01",path=":ev/ev_uni_c18/",set="ev_uni_c18"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q-Qué es lo que no tiene remedio?! ¡No me jodas!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_ked_000842",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Es que, tú... ¡¿Por qué Chiba es una isla?! ¡¿Por qué Chiba tiene el mismo\ntamaño que los Estados Unidos?!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Chiba no es una isla?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000851",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kyajajajajaja, ¿cómo se te llegó a ocurrir eso? ¡Los habitantes de Chiba te van\na matar!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, es que... al ir a Chiba hay que cruzar siempre por el mar, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_ked_000843",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Gyajajajajajaja, eso es un río!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000852",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, eso es porque Chiba está rodeado por el río Tone y el río Edo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Se están burlando demasiado.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_ked_000844",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ajajajaja, pero es que en tu mundo solo existe Japón, Chiba, Nueva York,\nEuropa, China y el Medio Oriente!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_aid_000407",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuu... Supongo que... tendré que comenzar haciendo que te aprendas el mapa del\nmundo primero...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_000408",ch="aid"},
},
ja={
{
name={"Ai"},
"“Porque viendo esto, sinceramente...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000426",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué el Medio Oriente está en este lugar?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Pues, el Medio Oriente se refiere al centro del este, ¿no? Así que pensé\nque... quedaba debajo de China...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000853",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto no está nada, nada bien...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"msgoff"},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000854",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, sorprende que aun con esto te vaya tan bien en las otras materias,\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000409",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi no tiene muy buenas calificaciones en todas las materias de\nSociales... Quizás sea por su terrible sentido geográfico.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000855",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con este nivel de entendimiento de mapas, tus calificaciones de Historia de\nJapón y Historia Universal deben estar por el piso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000845",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso es porque Naoya no hace de ninguna manera lo que no le gusta...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, la verdad es que ya he reflexionado un poco al respecto. Si tan solo\nme hubiera dado cuenta en secundaria y hubiera tratado de recuperarme en\nGeografía... Aunque, parece que ya es demasiado tarde...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013",head="aix_z1f",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=570,lv=4,id=4},
},
vl02={
{"fgact",ch="藍",act="うなづく",lv=4,id=4},
},
vl03={
{"fgact",ch="藍",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000410",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Nada de tarde! ¡Esfuerzate ya! ¡Este es el momento para hacerlo! Realmente\nserá tarde cuando te vuelvas un adulto.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No importa que no sea tan bueno en Geografía, aunque me vuelva un adulto...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000856",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí me parece que alguien como tú que cree que Chiba es una isla va a pasar\nbastante trabajo. Si llegas a ir a alguna otra región por trabajo, ¿no es\nacaso capaz que no puedas volver de nuevo a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Pensé que ella lo dejaría pasar de largo, pero terminó respondiéndome con\nargumentos totalmente correctos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",mode=-1,lv=4,id=3},
{"fg",ch="藍",mode=-1,lv=4,id=4},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000846",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es. No es bueno ser quisquilloso.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me lo dices tú? Seas quisquilloso o no, tus calificaciones en todas las\nmaterias son desastrosas... Realmente me sorprende que hayas podido ingresar\na este colegio.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, ¿qué es esa 'recomendación especial' que mencionó Ai? Aun en el caso de\nrecibir una recomendación hay que presentar una prueba, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=0,lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000847",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Nada de eso! ¡La entrada por recomendación especial consiste en ingreso por\ntalento excepcional!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Examen, por talento excepcional.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Esto solamente me da mala espina... Con examen por talento excepcional, se\nrefiere a ESE examen por talento excepcional, ¿no?",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En este colegio no meten a la gente por su habilidad en la kendama o algo así,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000848",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hay manera alguna de entrar a este colegio por saber usar la kendama. ¿Es\nque acaso eres tonto?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Qué alivio. No eres TAN idiota tampoco.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-345,lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000411",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque este muchacho propuso un juego de shiritori al momento de demostrar sus\nhabilidades especiales en la entrevista...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿S-Shiritori en l-la entrevista?!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fgact",ch="藍",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000412",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es... Me da vergüenza el solo hecho de recordarlo...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="man_kyb_000003",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Y bien, ¿cuál es tu nombre?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000849",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ouh, Kei Natsume. Mi hobby y mi mayor habilidad es la pintura.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kyb_000004",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Jajajaja... Muchacho, procura usar lenguaje formal... Te recuerdo que estás en\nuna entrevista.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000850",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, sí... disculpa... --peme.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_kyb_000005",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“¿Y bien? Tu campo para recomendación especial es la pintura, pero ¿tienes\nalguna otra habilidad especial?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000851",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, sí. ¿Sabes? Soy bueno en el shiritori, e incluso se rumorea en la ciudad de\nmis habilidades... de las habilidades de mi persona.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_kyb_000006",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“¿Shiritori?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000852",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí. En lo que respecta al shiritori, soy tan bueno que podría matarlos a todos,\nnadie es capaz de vencerme a mí... a mi persona.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kyb_000007",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“(Sonrisa irónica)... Shiritori, eh.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_kyb_000008",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“¿Bien, te gustaría jugar conmigo entonces?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000853",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajaja... Profesor, morirás.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"colortone",style="reset"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=4,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm016"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun siendo un examen de talento, ¿cómo es que este colegio deja ingresar a esa\nclase de persona tan peligrosa?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000413",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, por supuesto, la razón de su admisión fue por sus logros en el campo de la\npintura. Obviamente no quedó admitido por jugar al shiritori.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, nadie en su sano juicio creería que él pudiera graduarse\nescuchando esa entrevista, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fgact",ch="藍",act="おじぎ",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000414",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mmm, eso es porque Yumihari ha egresado, durante su larga historia, a una gran\ncantidad de intelectuales y artistas. Digamos que también influye el hecho de\nque son condescendientes con aquellos que tienen talento artístico...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, realmente nadie que haya entrado por la vía difícil a este colegio podría\nregocijarse al escuchar eso...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_aid_000415",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y además, Kei perdió en el shiritori contra ese profesor...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0012",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000854",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eso no es verdad, no es cierto. ¡Eso fue porque el profesor cambió las reglas\narbitrariamente! ¡Y por eso me ganó!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000855",ch="ked"},
},
ja={
{
name={"Kei"},
"“Además, ese juego tiene demasiadas reglas locales, es horrible.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué clase de reglas eran esas...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=5,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="man_kyb_000009",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Bien, ¿será que comenzamos entonces por el 'shiritori'? Comienza tú entonces,\nmuchacho, por 'ri'.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000856",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ouh, risutora (Reestructuración de personal).”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_kyb_000010",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Raimei (Trueno).”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000857",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ika (Calamar).”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_kyb_000011",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Kame (Tortuga).”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000858",ch="ked"},
},
ja={
{
name={"Kei"},
"“Meboraｰ”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kyb_000012",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000859",ch="ked"},
},
ja={
{
name={"Kei"},
"“Meboraｰ”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_kyb_000013",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Ehm... El problema no está en la pronunciación.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=5},
{"fgact",ch="圭",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000860",ch="ked"},
},
ja={
{
name={"Kei"},
"“Meboraｰ”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kyb_000014",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Espera, sí te estoy escuchando. ¿Podrías decirme qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000861",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ouh, es una persona asombrosa.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_kyb_000015",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“¿Es eso una persona?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000862",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es, puede usar magia.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_kyb_000016",ch="kyb"},
},
ja={
{
name={"Profesor"},
"“Ya veo... ¿Es algún personaje o protagonista de alguna novela?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000863",ch="ked"},
},
ja={
{
name={"Kei"},
"“No es ninguna novela. Es un hada que yo inventé. Siempre vive dentro de uno de\nlos orificios de la nariz de Nee-chan. Es la protectora de los siete sellos y\nademás una detective.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"colortone",style="reset"},
{"excall",file="02_abend_02_2"},
{"text"},
linkback="block_00171",
},
label = {
top={block="block_00000",label=1},
},
}
