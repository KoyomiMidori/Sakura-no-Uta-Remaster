astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="white",path=":bg/"},
{"se",id=1,file="se_semi"},
{"text"},
text={
ja={
{
"Estoy teniendo un sueño.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Probablemente el mismo que ella.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"¿Será eso un milagro?",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"¿O será, como Kusanagi lo describe, una maldición?",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Sea lo que sea...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",stop=1,time=500,id=1},
{"bg",time=2000,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"bgm",file="bgm025"},
{"text"},
text={
vo={
{"vo",file="man_uzn_000001",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Parece que la ceremonia del Da tuvo algo de efecto.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"bg",speed=240000,file="zbg082a",path=":bg/",x2=960,y2=-586,x=0,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_uzn_000002",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Me imagino que su alma está en más calma ahora. Ya no se le ve tan agresivo con\nlos sirvientes.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_yod_000074",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Sí, así parece. Si logra componerse ahora entonces quizás los sirvientes y el\npueblo cambie su opinión de él, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_uzn_000003",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Sí, supongo...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_yod_000075",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Tío? ¿Le sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_uzn_000004",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Sí. Estoy algo angustiado.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_yod_000076",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Angustiado? ¿Respecto a qué?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_uzn_000005",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Mi hermano se ha estado aferrando demasiado a Housoushi desde aquella\nceremonia.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_yod_000077",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ciertamente. Lo ha convocado al castillo varias veces desde aquel día.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_uzn_000006",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Así es. Al parecer quiere mandarle a realizar de nuevo la ceremonia del Da.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_yod_000078",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿De... nuevo? Pues, si eso le trae algo de paz a mi padre, no hay problema,\nquizás...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_uzn_000007",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Si lo ves de esa manera, no lo hay... pero teniendo que lidiar justamente con\nlos Housoushi...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_yod_000079",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Qué es lo que hay en esa familia que tantas angustias le provoca, tío?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_uzn_000008",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Me han informado que Housoushi es descendiente de una familia de hechiceros que\nperteneció al Tenyakuryou.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_yod_000080",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Los hechiceros del Tenyakuryou? ¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_uzn_000009",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“No es sorpresa que no lo sepas, Yoshisada-dono... El Tenyakuryou, ya disuelto,\nfue una organización perteneciente al Ministerio de la Casa Imperial,\nencargada de ofrecer tratamiento médico y medicamentos.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_uzn_000010",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“El Tenyakuryou estaba conformado por maestros de medicina, acupuntura, masaje,\ny además, hechiceros. Al parecer Housoushi es el descendiente de una familia\nde esos hechiceros.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_yod_000081",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Una organización con médicos, acupuntores... y además masajistas... ¿Era de\nfines médicos? Me sorprende que también hayan tenido chamanes.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_uzn_000011",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“No es descabellado si consideras que nuestros cuerpos están basados en los\ncinco elementos.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_yod_000082",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Acaba usted de decir que el Tenyakuryou y su división de hechiceros había sido\ndisuelta ya. ¿Eso quiere decir que los Housoushi ya habían perdido su poder y\nsu posición?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_uzn_000012",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Tal cual. El puesto de hechicero fue desplazado por el avance del departamento\nde adivinación del Onmyoudou.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_uzn_000013",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“La hechicería y el Onmyoudou pertenecen al mismo campo, a la magia... Que se le\ndé espacio a una implica el desuso de la otra.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_yod_000083",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ya veo... En pocas palabras, los Housoushi son un grupo de hechiceros que\nperdieron la lucha por el poder en el palacio imperial, y huyeron acá.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_uzn_000014",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Poniéndolo de manera sencilla, sí.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_yod_000084",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Así que llegaron a servir a la corte imperial... Su habilidad en el chamanismo\ndebe ser impresionante.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_uzn_000015",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Sí. Además, parece que también cumplieron un cargo de suma importancia hace 100\naños en el territorio de los Tang.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_yod_000085",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡En el territorio de los Tang!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"bg",file="bg082a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_uzn_000016",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Eso es lo que me tiene angustiado. Dicen que la hechicería tiene tanto poder\ncomo para alterar el orden político de la nación. Y no sé si sea bueno traer\nsemejante cosa al clan Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_yod_000086",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Piensa usted que Housoushi está tramando algo, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_uzn_000017",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Quizás haya salido abatido de todo el conflicto, pero eso no cambia el hecho de\nque sea un poderoso veterano, ya acostumbrado a las luchas de poder internas\nen la corte. Nada me extrañaría que intente tomar los hilos del clan Nakamura\npara recuperar su posición en la capital.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_yod_000087",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Pero, tío, el clan Nakamura acumuló muchas y grandes victorias en las guerras\nGenpei. Algo se debe poder hacer, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_uzn_000018",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“A los hechiceros no se les puede herir con sable, ni quemar con fuego, y son\ntemidos tanto por bestias como por espíritus malignos. Conocen las leyes y\ndisposiciones naturales, y son capaces de crear y parar todo tipo de\ndesastres. Eso dicen...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_uzn_000019",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Se dice además que... saben usar el Kodoku, y maldiciones para condenar y matar\na personas...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_yod_000088",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Así de terribles son? He llegado a ver a aquella señorita que llaman\nsacerdotisa de Yumehari, y parece ser solo una damisela normal-- no, una\nhermosa damisela...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_uzn_000020",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Es eso justamente lo aterrador de las familias de hechiceros. Las flores más\nbellas pueden ser las más peligrosas.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_yod_000089",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Eso... le parece?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_uzn_000021",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Aún eres joven, Yoshisada-dono. Te falta más experiencia.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_yod_000090",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Yo... sí, tiene razón. Me esforzaré por mejorar.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_uzn_000022",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“Uhm. Bien, parece que mi hermano me ha estado llamando, así que me retiraré.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"se",id=1,file="se_footsound_old_out"},
{"text"},
text={
ja={
{
"Mi tío asintió con un tranquilo ademán y salió de la habitación.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Y después de él salir, alguien entró.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"se",file="se9002",vol=30,id=1},
{"text"},
text={
vo={
{"vo",file="man_yod_000091",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",stop=1,time=500,id=1},
{"fg",ch="伯奇",size="z1",mx=40,mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000047",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000092",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Mm?! ¡¿H-Hakuki-dono?! ¿P-Por qué ha venido acá?...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000048",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Escuché su voz, así que decidí entrar.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_yod_000093",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“N-No, no me refiero a eso... Ah, claro. Mi padre volvió a convocar a\nHousoushi-dono hoy, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000049",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_yod_000094",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Está bien que merodee fuera de su habitación sin permiso alguno?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"fgact",ch="伯奇",act="いいえ",size=5,time=700,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000050",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_yod_000095",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Me lo imaginé.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"La alegría de su llegada fue más fuerte que la inquietud de que lo hiciera sin\npermiso.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000051",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama... está sonriendo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_yod_000096",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Eso es porque usted vino a verme, Hakuki-dono. Sería imposible que la sonrisa\nno se me escapara.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000052",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_yod_000097",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ajaja, duele un poco mi corazón ante tan inexpresiva respuesta...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000053",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Su corazón le duele?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000054",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama, ¿realmente le duele su corazón cuando está conmigo?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_yod_000098",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“No, el dolor no es simplemente por estar con usted.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_yod_000099",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Me aflige su desinterés por mí. Pero no es de sorprenderse, pues es usted la\nsacerdotisa tragasueños. Y nada puede cambiar eso...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000055",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Entiendo... Así que realmente no le duele allí...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_yod_000100",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Por qué le llama tanto la atención si me duele el corazón o no?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000056",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No es nada. Por cierto, ¿estoy sonriendo en este momento?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"La cara de Hakuki-dono al preguntarme eso era como la de una muñeca fabricada\ncon precisión milimétrica.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Hermosa. Pero con pocos trazos de humanidad.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000057",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Lo supuse. No lo estoy, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Quizás mi cara fue suficiente respuesta como para que Hakuki-dono susurrara\neso.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_yod_000101",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Hakuki-dono, ¿desea usted sonreír?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000058",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No lo sé. Pero...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_yod_000102",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000059",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Cuando veo su sonrisa, yo... ehm...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_yod_000103",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"fgact",ch="伯奇",act="いいえ",size=5,time=700,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000060",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000061",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Me duele el corazón...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000062",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Dónde estará oculto el corazón?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_yod_000104",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿El corazón? ¿No se supone que se ubica en la zona del pecho?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000063",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿En el pecho?...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"La muchacha posó su mirada en la lejanía.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Como si estuviera buscando a ese chotacabras y a ese escorpión que arden en\nalgún lugar del firmamento...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Su mirada estaba viendo a lo lejano.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Ah, claro.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Pensé, en medio del sueño.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Esta muchacha es idéntica a Rina...'",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=2000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001713",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi. Oye, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_yum_001831",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Nm, mm?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=50,file="zbg048e",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001714",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cayéndote del sueño incluso en clase... Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_001832",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí... a-así parece...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001715",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Será que tienes mucho cansancio encima?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_001833",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no, no es eso, de verdad. Estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Últimamente he tenido sueños frecuentemente.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Esos mismos sueños que Rina ha tenido.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"La muchacha llamada Hakuki que aparece en mi sueño es idéntica a Rina cuando\nera niña.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Y probablemente, el Yoshisada que ve ella en sus sueños soy yo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"No sé qué puede significar eso.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Pero sí sé muy bien que no es algo normal.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"¿Qué tanto sabrá Kusanagi-senpai de esto?...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"El olfato de ese astuto artista es capaz de descubrir muchas cosas.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Además, al parecer llegó a tener algún vínculo con los cerezos milenarios en su\npasado.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
vo={
{"vo",file="fem_yum_001834",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué tanto sabrá?...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001716",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001835",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ah, no, no es nada!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,rule="083r",sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"Espero a Rina en la azotea.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"El profesor le pidió un favor, así que está ahora en eso.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"A diferencia de mí, todos los profesores la recuerdan y la reconocen. Lo cual\ntrae sus problemas consigo.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"???"},
"“Ey.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_001836",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué quieres?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Le lanzo una mirada amenazadora al hombre que había entrado a la azotea.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001837",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No se supone que deberías estar dándole tutoría a Rin-senpai, senpai? Como\npuedes ver, Rina no está.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vine por Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_001838",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si no tienes nada que hacer acá entonces vete ya, por favor. Me distraes.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes experiencia con las pinturas en óleo, ¿verdad? ¿No te parece buena\nidea que te enseñe un poco?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_001839",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No me hace falta. No pienso presentar ninguna obra a la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? Toritani se pondrá triste.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_yum_001840",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Más triste sería tratar de fijarme un objetivo para el cual claramente no estoy\na la altura.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Eres sabia.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_001841",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y qué hay de ti, senpai? ¿No piensas pintar algo de tu parte?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",time=400,size=3,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no pienso pintar nada...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_yum_001842",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué tajante.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, han pasado muchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_yum_001843",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_001844",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No quisiera quedarme mucho rato hablando contigo, pero...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_001845",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hay algo que me ha causado curiosidad desde hace un tiempo, así que quisiera\naprovechar de preguntarte.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c50_01",path=":ev/ev_uni_c50/",set="ev_uni_c50",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm106"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001846",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Acerca del último cuadro que pintaste... 'Fantasía de un día de cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me sorprende que lo conozcas. Ni yo me acordaba de ese cuadro.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_001847",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué le llamaste 'Fantasía de un día de cerezos'?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, ¿por qué habrá sido?...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Senpai sonríe, aparentando incomodidad.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Para ser sinceros, me saca de mis casillas ese gesto.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_001848",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Fue en memoria de algún difunto?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo piensas?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001849",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Chuuya Nakahara, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, entre los poemas de Chuuya Nakahara hay uno llamado justamente\n'Fantasía de un día de primavera'.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Saco un libro de mi mochila.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Poemas de días pasados', eh...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Asiento con un ligero movimiento y paso las páginas.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_yum_001850",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En el momento en que nuestros amados mueren, la vida debemos quitarnos.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_001851",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En el momento en que nuestros amados mueren, ninguna otra alternativa tenemos.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_yum_001852",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, manchados de pecado estamos, y teniendo encima toda una vida por\ndelante...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_001853",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo queda entregarnos al altruismo. Solo nos queda entregarnos al altruismo.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_001854",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mi ser más amado murió, sí, conmigo ya no está...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_001855",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y nada puedo hacer ya, así que por él, sí, por él...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_yum_001856",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debo ser altruista. Debo ser un altruista.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_001857",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se dice que esta colección de poemas reúne todos los poemas que Nakahara\ncompuso en duelo por la muerte de su hijo.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Está incluso escrito ahí. 'Dedicado al espíritu de mi hijo\nfallecido, Fumiya'.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_001858",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“'Fantasía de un día de primavera' ahínca bastante en ese sentimiento.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la temática es bastante directa.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_001859",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué 'Fantasía de un día de cerezos'?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Pensé que evadiría de nuevo mi pregunta.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Y es que por lo general Naoya Kusanagi evita siempre todo aquel tipo de\npreguntas que le dan en la llaga.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Pensé que vendría de nuevo con otra incómoda sonrisa, pero este comenzó a\nhablar, como si nada.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="直哉",size="z2",mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi madre había muerto.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“El poema que recité aquel día frente a Rin era ese. Fantasía de un día de\nprimavera.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin se enojó bastante...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0009",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en aquel momento lo recité sin saber realmente el significado que había\nen ese poema...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿por qué se habrá enojado tanto?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué habré recitado ese poema en aquel momento?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de aquel día no podía parar de preguntarme eso, recordando siempre ese\npoema.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0019",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Preguntándome también, ¿por qué justo después de perder a su hijo Nakahara\nprodujo un poema tan extraño?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_001860",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es extraño?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es, claro que lo es. El inicio es realmente profundo, pero...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, damas y caballeros, sin excesivo júbilo, sin mucha tristeza, démonos las\nmanos, a buen ritmo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sepan que, al fin y al cabo, honestidad y rectitud es lo que nos falta.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que señores, todos juntos―― démonos las manos, a buen ritmo.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Así termina.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_001861",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así creaste un cuadro inspirado en ese poema.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Inspirado sería poco. Nunca dejé de preguntarme lo mismo...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué este poema me habrá impactado tanto?...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No paré de preguntármelo, en ningún momento.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y entre tanto preguntarme, salió ese cuadro.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_yum_001862",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cuál fue la respuesta con la que diste, senpai?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es la pregunta más estúpida que le podrías hacer a un pintor. La respuesta\nla hice pintura.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_001863",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Llegué a ver ese cuadro...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_yum_001864",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No una, sino muchas veces.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_001865",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Fue esa la vía que decidiste seguir en medio de la devastadora muerte de tu\nmadre, senpai? El altruismo... La abnegación.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0016",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Abnegación? ¿Yo? ¿Es que acaso te parece que la practico?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_yum_001866",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En absoluto.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es obvio que no es eso entonces, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_yum_001867",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que acaso Nakahara pasó el resto de su vida viviendo como un altruista como\nlo describía en su obra?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=600,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente no...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_yum_001868",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Escuché que no volviste a pintar después de terminar ese cuadro, senpai.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_yum_001869",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero ya para aquella noche que vino el tifón, tu obra había sido publicada.\nCuando convertiste el dibujo del ciprés de Rina en un árbol de cerezos ya\n'Fantasía de un día de cerezos' había salido a la luz pública.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_yum_001870",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Realmente nunca dejaste de pintar. Simplemente no llegaste a publicar nada.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_yum_001871",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De vez en cuando hago dibujos, nada más...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_yum_001872",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Solo eso? A mí me pareció ver a un niño que usaba como lienzo distintos\nlugares, dibujando desesperadamente para recobrar su toque con el pincel.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, cielos, así que de verdad eras la mocosa de aquella vez.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_yum_001873",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Exactamente. ¿No te habías dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue después que regresamos del bosque de cipreses que finalmente me di cuenta.\nRecordé lo que habías dicho, de que odiabas los cipreses porque se convertían\nen cerezos.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_001874",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Somos bien tontos los dos. Yo tampoco te reconocí cuando te vi por primera vez\naquel día...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0003",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh, sí? ¿Es que acaso me viste muy apuesto?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_001875",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No. Simplemente tenías una cara mucho más boba de la que me imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, no sabía eso.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_001876",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque has cambiado bastante en apariencia desde aquel entonces. Lo de adentro\nno ha cambiado ni un poco, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni un poquito...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_001877",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpai, ¿por qué le estás haciendo creer a todos que dejaste de pintar?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_001878",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No es eso justamente el altruismo, la abnegación de la cual hablaba Nakahara?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0013",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te parezco la clase de persona que sería capaz de dedicar todo su tiempo a\ncausas benéficas?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_001879",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo pareces. Y como ejemplo de eso está 'Las huellas de los cerezos'. Nada había\nen la culminación de esa obra que te beneficiara.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0002",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue a mí a quien le achacaron todos los honores, por eso es que me volví famoso\nahora. Si es por eso, el verdadero altruista y abnegado sería Akashi.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_001880",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eso crees? Pues de lo que he visto eres el que parece estar sufriendo más\nahora que se culminó.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? Pero qué ridiculez...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_001881",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Con qué propósito nace una obra? ¿Con qué propósito creamos esa obra?...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_yum_001882",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El porqué que nos lleva a crearla... Solo basta con no perder de vista eso...\nAun cuando el nombre inscrito en esa obra no sea el nuestro.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_001883",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso fue lo que Akashi-senpai te dijo, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0014",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que sabes--?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_yum_001884",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los estuve espiando.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0007",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Espiando?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_yum_001885",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. No le tenía confianza a ninguno de los dos, así que coloqué un micrófono en\nel abrigo de Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese idiota...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_yum_001886",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tenía toda la intención de matarlos en caso que dijeran algo que pudiera\nperjudicar a Rina.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_yum_001887",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero lo único que alcancé a escuchar fue a dos altruistas...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0011",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sigues con lo mismo, ya te dije que no lo hago por filantropía.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_yum_001888",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Para mí lo fue.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0005",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si tú también ayudaste.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_yum_001889",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque Rina ayudó también.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_yum_001890",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siendo sincera, los odio por haber metido a Rina y a Rin-senpai en tan\npeligroso rollo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Odio es lo único que parezco poder conseguir de ti, eh.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_yum_001891",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sin duda alguna. Te odio.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_yum_001892",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y de todos estos actos de altruismo, o como le digan, el que más odio es esa\npintura que convirtió el ciprés en cerezos.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0016",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál ciprés?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_yum_001893",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El mural de ciprés que Rina estaba dibujando. El cambio que le hiciste a aquel\nmural para transformarlo en cerezos.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0014",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, si lo hice fue porque me estaba divirtiendo, y--”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_yum_001894",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Recuerdas que hiciste el dibujo junto a Rina, en el parque de los cipreses?\nDijiste que te habías divertido, ¿no es así? Mentías, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0007",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0011",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=7,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, ¿por qué dices que estuve mintiendo? Recuerdo muy bien haber\ndicho que me había divertido, en aquel momento.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_yum_001895",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, lo dijiste. Solo por decirlo, pareciera.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo... por decirlo?... No me esperaba eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_001896",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No es así? ¿Es que no te dolió mucho hacer ese dibujo?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué... dices eso?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_yum_001897",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En algún momento después de pintar 'Fantasía de un día de cerezos' te\nlastimaste permanentemente tu brazo dominante, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="びっくり",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_yum_001898",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Después de aquel día no paré jamás de ver una y otra vez el cuadro, así que lo\npuedo afirmar con seguridad.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_001899",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No dejaste de pintar. Simplemente tu brazo dejó de funcionar como lo hacía. Y\ndesconozco la razón. Lo único que sé es que después de eso no pudiste pintar\nnada igual jamás.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_yum_001900",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En ese entonces te la pasabas haciendo 'graffitis' a diestra y siniestra, sin\nnunca terminarlos. Y todo porque te estabas dando cuenta de que tu brazo ya\nno servía, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_001901",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por más que pintaras y pintaras nada salía bien. Y por eso es que dejabas\ndibujos sin terminar por allí y por allá.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_yum_001902",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Puede que no lo parezca, pero te tengo mucho odio, senpai. Y por eso investigué\nbastante acerca de tus obras. Incluso llegué a buscar todos los graffitis que\nhabías pintado en ese entonces.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_001903",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y todos los que encontré estaban sin culminar.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_yum_001904",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y a pesar de que todos estaban inspirados de alguna forma en 'Fantasía de un\ndía de cerezos', eran algo completamente distinto.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_yum_001905",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Noté ansiedad, intranquilidad. La angustia de alguien que, a pesar de intentar\npintar algo similar a lo que hizo en el pasado, terminaba con algo totalmente\ndiferente.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_yum_001906",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_yum_001907",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo algo puede explicar eso. Y es que para aquel entonces ya no eras capaz de\npintar cuadros como 'Fantasía de un día de cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=500,size=7,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tan diferente el resultado que hasta alguien que no pinta es capaz de\nseñalármelo. Pero qué cosas, eh...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_yum_001908",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así, la manera en que dibujabas cuando estuviste pintando de manera\nalternada con Rina, el acabado, todo, era casi el mismo de tus mejores\ntiempos.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_001909",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo cual me ha puesto a pensar... Si hubiera sido aquel mismo Naoya Kusanagi que\npintó 'Fantasía de un día de cerezos', entonces solo una noche hubiera\nbastado para cambiar la obra de Rina.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_yum_001910",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así de enorme y avasallador era, o debió haber sido, el talento de Naoya\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_yum_001911",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y a pesar de eso, Naoya Kusanagi avanzó la obra a pasos, yendo día tras día.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_yum_001912",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por si fuera poco, el toque final, siendo también el más impactante, lo dio\nel último día. Toda la labor anterior había sido solo preparativos.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_yum_001913",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se me hizo muy extraño.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_yum_001914",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que acaso no fue por intentar usar tu ya destrozado brazo que debiste\ndistribuir la labor?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_yum_001915",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que no fue por eso que tomo tantos días?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino, me das algo de miedo.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_yum_001916",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos detalles no se revelan, por más que te hayas dado cuenta. La otra persona\npodría estar ocultándolo, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_yum_001917",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tienes razón. Y créeme que no lo revelaría, si no fuera porque no estás\nrealmente ocultándolo del todo.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues claro que lo estoy haciendo.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_001918",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué, entonces, y en ese estado, seguiste pintando junto a Rina?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_yum_001919",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué decidiste exponerte de esa manera?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=700,size=7,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que pasa...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_yum_001920",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es por aquello?... Eso del altruismo.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_001921",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Estuviste haciendo lo mismo que Nakahara después de que falleció tu madre?\nMetiendo el hocico sin necesidad alguna, como un buen altruista.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_yum_001922",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, innecesario no fue. Aceptarlo de esa manera sería negar que ese dibujo\nsalvó a Rina...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_yum_001923",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ese dibujo que pintaste, a cambio de forzar tu ya destrozada mano, salvó a\nRina...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_yum_001924",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ese dibujo que se llevó parte de la vida útil de tu mano derecha, retiró las\nsombras de la muerte que se cernían sobre Rina...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_yum_001925",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué pintaste junto a Rina?... ¿Por qué hacer tanto?...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_yum_001926",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y encima de eso, ahora que entro a Yumihari me doy cuenta de que tu brazo\ndominante cambió. Ya no puedes mover casi tu brazo derecho, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=3,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco es tan grave. En lo que respecta al brazo no hay tanto problema.\nSimplemente no siento alguno de los dedos de la mano...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedo coger palillos. Incluso lápices. Pero ya no puedo pintar como antes...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_yum_001927",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero intentaste hacerlo, durante todos esos días. Y estoy segura de que fue\nbastante carga para tu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=550,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo fue. Fue más duro de lo que esperaba... Era tremendo el talento\nque Hikawa tenía, tanto que llegué a sentir que el dibujo me tragaría\nen cualquier momento...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no mal recuerdo, en aquel entonces dije que era un dibujo bastante\ndeprimente. De que quería convertirlo en algo más alegre... Y no me equivoco.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no puedo negar tampoco que sentí un olor a muerte viniendo de ese dibujo...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_yum_001928",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Entonces sí te habías dado cuenta de que Rina estaba enferma?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los dibujos son bastante curiosos, ¿sabes? Independientemente de si son buenos\no malos, siempre puedes conseguir algo más en ellos.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tenía idea de qué enfermedad sufría Hikawa. Pero de su dibujo supe que\nestaba intentando, de alguna forma, aceptar la muerte.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso quise desaparecer ese hedor a muerte que tenía ella...”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_yum_001929",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien que te hiciste el tonto aquella vez...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego. Pero tampoco sabía qué enfermedad era, así que no fue\ntotalmente intencional todo.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, mi madre apenas acababa de morir...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no podía sacarme de la cabeza ese peculiar olor a muerte.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0017",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese peculiar olor que tienen aquellas personas que aceptaron ya su muerte...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo quería hacer a un lado esa fúnebre sombra que la envolvía...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="直哉",size="z2",mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001930",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Querías hacer eso por tratarse justamente de Rina?”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0013",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
vo={
{"vo",file="fem_yum_001931",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Vas a hacerte el tonto de nuevo? ¿O es que acaso fue solo un casual impulso\naltruista? ¿No te hubiera importado quién fuera?”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Le dejo esa respuesta a tu imaginación.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_yum_001932",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Lo hiciste por Rina?! ¡¿O es que hubieras hecho lo mismo por cualquier otra\npersona?! Ahí está el gran dilema, o al menos para mí.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=550,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es un gran dilema.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="fem_yum_001933",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso es que no puedo responderte acá.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero hay algo que sí puedo afirmar con seguridad.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En aquel momento ya había perdido casi todas las esperanzas que tenía de salvar\nmi mano derecha. Tal como lo mencionaste hace un rato.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaba ya preparado para perderla para siempre...”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquella noche que fui al parque, era para borrar un grafitti que había hecho.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue entonces que me encontré con ella...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con aquella niña vestida únicamente de blanco... sola, en la oscuridad del\nparque de cipreses...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Concentrada, dibujando sin parar el símbolo de la muerte...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuve observándola mientras dibujaba, por varios días.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_yum_001934",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A escondidas? Eres un desviado.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a negar eso.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De hecho, también llegué a presenciar el encuentro que tuvieron ustedes dos.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="fem_yum_001935",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿P-Pero qué demonios?!”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo observé el momento en que se encontraron. Tampoco soy tan degenerado como\npara espiarlas todo el rato que estuvieron juntas. Apenas comenzaron a hablar\nme fui...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero fue ahí que te vi, y pensé, 'Esta también vino acá atraída por el olor de\nesta extraña muchacha'...”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_yum_001936",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El olor de esa extraña muchacha...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa extraña muchacha, que aun con ese pequeño cuerpo no dejaba de dibujar aquel\ngigantesco, fúnebre símbolo, en aquel lugar.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su encanto era demasiado fuerte...”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="fem_yum_001937",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pero fuiste tú quien la despojó de ese encanto!”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Así es.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se me ocurrió acabar con aquel encanto, originado de la misma muerte.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0008",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mientras más encantador se me hacía, más ganas me daban de acabarlo...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que pensé que no estaría mal darle lo último que quedaba de mi mano a ella.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_yum_001938",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lo... último?...”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0001",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Lo último.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0017",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi brazo había ya perdido por completo la habilidad para crear pinturas.”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que podríamos decir que fue un milagro, tal vez. El hecho de haber podido\npintar algo capaz de acabar con la muerte que la envolvía...”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="fem_yum_001939",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa fue entonces la última obra de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0010",head="nao_z2a",lv=5,id=9},
{"fgact",ch="直哉",act="おじぎ",time=550,size=5,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Esa fue la última obra de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_yum_001940",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tuviste que dejar tu última obra allí... en ese lugar, donde el tifón se lo\nllevaría todo después.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0018",head="nao_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001941",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Naoya Kusanagi... eres bastante despreciable.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“....”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_yum_001942",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Altruismo, si tan solo hubiera sido altruismo... no estaría sufriendo tanto\nahora.”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo hubiera sido por eso me podrían poner en el mismo pedestal que a\nCristo.”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_yum_001943",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A ti?... Más bien deberían crucificarte.”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0013",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no digas eso. El dolor no me gusta.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_yum_001944",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Mentiroso!”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
vo={
{"vo",file="fem_yum_001945",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hay nadie más insensible al dolor que tú...”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="fem_yum_001946",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Has aguantado demasiado...”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="おじぎ",time=600,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco es para tanto...”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_yum_001947",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina es hermosa.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_yum_001948",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así como la luna...”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_yum_001949",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Alumbra a todos... con un melancólico, pero gentil brillo...”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es justamente su sonrisa...”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_yum_001950",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No puedo creer que esté compartiendo la misma opinión con este imbécil...”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_yum_001951",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Eres un imbécil! ¡Juraba que solo veías a Rina como una simple excéntrica\nmuchacha de primer año!”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0013",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues así se comporta siempre cuando está conmigo, ¿o vas a negarlo?”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001952",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pues si lo sabes entonces--!”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también llegué a verla, en aquel parque. Es obvio que no puedo mirarla de\nesa manera...”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tú también, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Has estado persiguiendo todo este tiempo a la muchacha que viste en aquel\nparque.”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
vo={
{"vo",file="fem_yum_001953",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En eso tienes razón. Parcialmente.”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="fem_yum_001954",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero también me encanta la Rina que vino después de esa etapa.”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé...”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="fem_yum_001955",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Incluso esa alegre sonrisa que le diste me gusta.”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, gracias.”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Valió la pena el esfuerzo de terminar el dibujo, por muy doloroso que haya\nsido.”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
vo={
{"vo",file="fem_yum_001956",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siendo honesto ahora, eh.”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0013",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A toda honra. No hay creador que no se regocije de que alguien le comprenda lo\nque sufrió para crear algo.”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
vo={
{"vo",file="fem_yum_001957",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me asquea la manera en que lo dices. Casi insinuando que simpatizo contigo.”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0003",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez sí lo es un poco.”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0010",head="nao_z1a",lv=4,id=9},
{"fgact",ch="直哉",act="いいえ",time=300,size=3,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero créeme que un simpatizante es de las cosas de más valor que un artista\npuede tener.”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
vo={
{"vo",file="fem_yum_001958",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya náuseas que me da de solo pensar que simpatizo contigo.”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás sí lo eres en realidad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
vo={
{"vo",file="fem_yum_001959",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es eso lo que más náuseas me causa.”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0018",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"fg",ch="直哉",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Kusanagi-senpai se da la vuelta.",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_yum_001960",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te vas?”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, debo ir a ver cómo le va a Rin.”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
vo={
{"vo",file="fem_yum_001961",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué pesado debe ser. Tener que venir a verme, y luego devolverte a ayudar a\nRin con su pintura.”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
"Senpai se despide solo levantando su brazo, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
"Y entonces, me quedo sola en la azotea.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
vo={
{"vo",file="fem_yum_001962",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Naoya Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"Si tan solo fuera nada más que un tonto excéntrico.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"Si tan solo fuera un simple hombre talentoso con la pintura.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Si tan solo fuera un cualquiera que apareció solo por mera casualidad. Y que\nlos sentimientos de Rina por él fueran también algo casual...",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"Pero la realidad es distinta.",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_05"},
{"text"},
linkback="block_00376",
},
label = {
top={block="block_00000",label=1},
},
}
