astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000844",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Naoya Kusanagi! ¡Espera ahí!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Nagayama me llama justamente cuando intentaba irme.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000845",ch="knd"},
},
ja={
{
name={"Kana"},
"“Quizá estás pensando que nos ganaste, pero no. Más bien debo agradecerte.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000846",ch="knd"},
},
ja={
{
name={"Kana"},
"“Debo ser honesta, nuestra obra no tenía el impacto suficiente.\nPero tú le diste un nuevo significado.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000847",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tal como lo expliqué hace un rato ante los medios, nuestra pintura no tenía\nsuficiente impacto como obra...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000848",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Pero este logro sigue siendo de nosotros! ¡De Bourbagi!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh--”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000849",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Frustrado? ¿Frustrado que tanto esfuerzo para pisotearnos terminara dándonos\nla victoria?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000850",ch="knd"},
},
ja={
{
name={"Kana"},
"“Dime, ¿acaso no es así?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0000",face="a0009",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000155",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH~, YES. ¿Frustrado, DESHO? ¿Enojadito, DESHO?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Al parecer Thomas vino siguiendo a Nagayama.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, jaja...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",mode=-2},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000851",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, kuh, ajajajaja...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000852",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Q-Qué se te hace tan divertido?!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por fin lo he entendido.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_knd_000853",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿Entender qué?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo agradezco. Por fin lo entendí.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al fin he entendido lo que él decía.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que ahora sí puedo decir que entiendo el arte tanto como él.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000854",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿D-De qué estás hablando?!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A pesar de mi largo tiempo sin pintar como artista, por fin pude...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000855",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Y qué es eso que entendiste?!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que significa crear una obra.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa crear para ti, Nagayama? ¿Ganar reconocimiento entre las\nmasas?\n¿Conmocionar a los medios?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000856",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡A-Así es!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el problema entonces? Esto es perfecto para ustedes.\nUstedes ganaron.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000156",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Pues entonces al menos aparenta estar frustrado!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué debería hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para qué hice esa obra?...\n¿Y para quién?...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No fue por alguien que ya no está, ni por alguien en particular...\nEsa fue una obra hecha por mí, y para mí.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo tanto, no tengo necesidad alguna de quedar como autor.\nNo necesito mi nombre sobre esa obra.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000857",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡S-Solo estás intentando justificarte!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No logras digerirlo?\nPues entonces como artista no eres ni de segunda o de tercera, estás por debajo de eso.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fgact",ch="香奈",act="いいえ",size=3,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000858",ch="knd"},
},
ja={
{
name={"Kana"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con qué propósito nace una obra? ¿Con qué propósito creamos esa obra?...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El porqué que nos lleva a crearla... Solo basta con no perder de vista eso...\nAsí el nombre inscrito en ella no sea el nuestro.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0004",head="tho_z1a",lv=4,id=9},
{"fg",ch="トーマス",time=100,mode=3,path=":fg/tho/z1/",file="tho_z1a0000",face="a0004",head="tho_z1a",x2="0,10,-10,10,-10",x=0,lv=4,id=9},
{"ex",time=100,func="wait"},
{"bgm",file="bgm015"},
{"se",file="se3130",id=1},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"fg",ch="トーマス",size="z2",mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0000",face="a0005",head="tho_z2a",x=0,lv=5,id=9},
{"fg",ch="トーマス",speed=150,mode=3,path=":fg/tho/z2/",file="tho_z2a0000",face="a0005",head="tho_z2a",y2="0,10",x=0,y=0,lv=5,id=9},
{"ex",time=100,func="wait"},
{"bg",time=200,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000157",ch="tmd"},
},
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Thomas balbucea algo sin sentido y corre hacia mí, intentando golpearme.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Sin embargo, mis ojos rastreaban cada uno de sus movimientos.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"bg",file="battle_004",rule=116,time=100,id=1,lv=5,path=":cg/battle/",set="battle"},
{"se",file="se2271",id=1},
{"text"},
text={
ja={
{
"Incluyendo su exagerado puñetazo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Un directo con la mano izquierda.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"cgdel",id=-1},
{"bg",file="battle_001",rule=040,time=100,id=1,lv=5,path=":cg/battle/",set="battle"},
{"se",id=1,file="se1615_z"},
{"text"},
text={
ja={
{
"Hundo mis caderas y contraataco con un gancho derecho.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Esquivo su directo y dirijo mi gancho sobre su zona lateral.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="battle_004",zoom=200,speed=100,time=100,id=1,lv=5,path=":cg/battle/",set="battle",x2=960,y2=540,x=-960,y=-540},
{"se",file="se2271",id=1},
{"quake"},
{"ex",time=80,func="wait"},
{"cgdel",id=-1},
{"bg",file="battle_001",zoom=200,speed=100,time=100,id=1,lv=5,path=":cg/battle/",set="battle",x2=-960,y2=540,x=960,y=-540},
{"se",id=1,file="se1615_z"},
{"quake"},
{"ex",time=80,func="wait"},
{"cgdel",id=-1},
{"flash",time=100,alpha=150,loop=3,color="ffffff"},
{"bg",file="交差",zoom=100,time=100,id=1,lv=5,path=":cg/battle/",z2="200,120,150",set="battle"},
{"se",file="se1747",id=1},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
ja={
{
"Se escucha un estruendoso sonido.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000158",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡¿Nuh?! Oh... oh.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"cgdel",id=-1},
{"se",file="se2869",id=1},
{"bg",file="zev_com_j07_01",id=2,lv=2,zoom=53,alpha=255,time=50,path=":ev/ev_com_j07/",z2=50,set="ev_com_j07",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_j07_01",id=3,lv=3,zoom=55,alpha=128,time=60,path=":ev/ev_com_j07/",z2=50,set="ev_com_j07",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_com_j07_01",id=4,lv=4,zoom=60,alpha=128,time=70,path=":ev/ev_com_j07/",z2=50,set="ev_com_j07",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=100},
{"ex",time=0,func="wait"},
{"se",file="se2869",id=2},
{"bg",time=0,sync=0,file="ev_com_j07_01",path=":ev/ev_com_j07/",set="ev_com_j07"},
{"cgdel",id=-1},
{"text"},
text={
ja={
{
"Nuestros brazos se cruzaron.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"El directo de Thomas no logra siquiera rozar mi mandíbula, y su mano golpea el\naire.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Por otra parte, mi gancho impacta fuertemente en su mejilla.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Thomas se había desmayado,\ncon su cara terriblemente desfigurada.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Mi golpe dio en el blanco.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"El impacto sobre mi mano derecha fue tremendo.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_j07_02",sync=0,face=1,time=400,path=":ev/ev_com_j07/",set="ev_com_j07"},
{"se",file="se3130",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Thomas termina tumbado en el suelo.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Mi mano derecha dolía todavía.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Era un dolor agradable.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"'Conque así se siente golpear a alguien con todas tus ganas', pensé.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Fue un maravilloso cross-counter.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Si bien su golpe fue lento, no pensé que mi contraataque resultaría tan bien.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Veo a Thomas tumbado sobre el suelo.\nHabía perdido el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Aun sabiendo el estado en que estaba, le grito.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_j07_03",sync=0,face=1,time=400,path=":ev/ev_com_j07/",set="ev_com_j07"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Thomas!! ¡Te voy a enseñar algo!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ser popular con las chicas no te hace fuerte! ¡¡Ni tampoco esa mierda del\nMOTE!!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La verdadera fuerza viene de entrenar día tras día tras día!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Quieres más, ah?! ¡Ven por más, falso intento de extranjero!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_j07_04_bg",id=8,lv=8,path=":cg/cg_ev_com_j07/",set="cg_ev_com_j07",sync=0},
{"bg",file="ev_com_j07_04_tho",id=9,lv=9,x=-5,path=":cg/cg_ev_com_j07/",set="cg_ev_com_j07",sync=0},
{"extrans",time=500},
{"cgact",file=":cg/cg_ev_com_j07/ev_com_j07_04_tho",id=9,lv=9,act="いいえ",loop=-1,time=100,size=5,x=-5},
{"evset",file="ev_com_j07_04",set="ev_com_j07",path=":ev/ev_com_j07/"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000159",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Hih, hiii...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Definitivamente lo grande lo tiene también de robusto.\nJuzgando por el impacto juraba que no despertaría por unos minutos, pero ya había recobrado el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Sin embargo, sus piernas no se movían y ahora no podía pararse.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Estaba ahora en pánico, sentado en el suelo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Le lanzo una amenazadora mirada a Thomas. Este responde huyendo, arrastrándose\npor el suelo.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso es todo lo que tienes, Thomas?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Thomas permanece temblando, sin contestar nada.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_j07_04_tho",id=9,lv=9,x=0,path=":cg/cg_ev_com_j07/",set="cg_ev_com_j07"},
{"cgact",file=":cg/cg_ev_com_j07/ev_com_j07_04_tho",id=9,lv=9,act="stopact",x=0},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Dónde está tu famoso MOTE, ah?!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Que no ibas a tumbarme con él, ah?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en tus sueños. Esa clase de cosas no podrá romper mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este cuerpo que he estado entrenando desde años.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cuerpo que seguí entrenando para poder pintar.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No dejé de entrenar ni un solo día.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluyendo esta mano derecha...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esta inútil mano derecha!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tus débiles puños no son capaces de hacerle un solo rasguño!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esta mano derecha es fuerte!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Observa! ¡Mira este cuerpo, este físico!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Me arranco la camisa.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bgm",stop=1,time=500},
{"cgdel",id=-1},
{"se",id=1,file="se_cloth_biri"},
{"bg",file="zev_com_j07_05",zoom=80,speed=500,time=100,path=":ev/ev_com_j07/",set="ev_com_j07",x2=-576,y2=-324,x=-576,y=324,ax=1920,ay=1080,bx=-960,by=-540},
{"quake"},
{"ex",time=700,func="wait"},
{"bg",file="ev_com_j07_05",time=300,path=":ev/ev_com_j07/",set="ev_com_j07"},
{"bgm",file="bgm008"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡MIRA, MIERDA!　¡ESTE ES EL RESULTADO DE MI ENTRENAMIENTO!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡VEN Y MIRA!!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡THOMAS!! ¡¡¡VEN ACÁÁÁááÁÁ!!!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000396",ch="htd"},
},
ja={
{
name={"Directora"},
"“¡Esp--, profesor Kusanagi! ¡El equipo de prensa está todavía presente!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_iue_000015",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Vamos, directora, déjele ser. Una vez más, el milagro lo hizo él.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Semidesnudo, persigo a Thomas, quien huía frenéticamente.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Esto es una idiotez. Pero se siente bien.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Me trae recuerdos.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"De aquella noche.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"En la que cierto idiota también se quitó la camisa para mostrar su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"A pesar de lo flaco y frágil, decía que su cuerpo era sólido.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Esa noche,\nen la que culminamos esa obra.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"La obra póstuma de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Son recuerdos tremendamente nostálgicos, y en igual magnitud, maravillosos.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Pero hoy, hoy también se siente tremendamente bien.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Seguramente el día de hoy quedará grabado en mi memoria, con casi la misma\nfuerza que aquella noche.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Una obra de luz.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"'Las huellas de los cerezos' renació.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Y ahora no como obra póstuma, sino como una auténtica obra mía.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Crear algo se siente realmente bien.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Tanto, que no puedo evitar cometer ridiculeces como esta.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Lanzando provocaciones y groserías mientras corro sin camisa.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Ya no puedo quejarme de Akashi.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Idiota, un gran idiota. Eso soy.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Y de igual manera, se siente estupendo.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_j07_06",sync=0,face=1,time=400,path=":ev/ev_com_j07/",set="ev_com_j07"},
{"se",file="se0744s",id=1},
{"text"},
text={
ja={
{
"Thomas logra pararse por fin y huye con extraordinaria rapidez.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Bien merecido.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Suficiente para pagar por el puñetazo que me dio la vez pasada.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"¿O quizá se me pasó la mano?",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Thomas cruza la puerta del colegio y atraviesa la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"¿Tanto miedo le he dado?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_knd_000859",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Todavía sigues entrenando?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_knd_000860",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues, entiendo que para manejar el pincel de la misma forma que Kenichiro\nKusanagi necesitas mucha fuerza en las manos.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_knd_000861",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sé que por eso estuviste entrenando desde pequeño.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000862",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero ¿qué caso tiene ahora? Por más que entrenes tu mano derecha no volverá.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph, ciertamente. Tal vez mi mano derecha no vuelva a su estado original.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bgm",file="bgm018"},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0001",head="kan_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero bien me sirvió para darle una paliza a Thomas.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El entrenamiento diario puede traer resultados excepcionales.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no hay desperdicio en ello si llega a servir de algo, así sea en la situación\nmás ridícula posible.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me siento orgulloso de la preparación que le he dado a mi brazo derecho.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El talento puede fallarle al mediocre,\npero la técnica nunca lo hará.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esas son palabras tuyas.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El entrenamiento es lo que sostiene la técnica.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y debo decir que definitivamente no te falla.\nAunque bueno, tampoco es que he venido entrenándome en técnicas para golpear.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... la técnica que desarrollas en el entrenamiento es genial.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"El dolor de mi mano derecha se había apaciguado.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Con una expresión de exasperación en su rostro, Nagayama procede a hablar.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0003",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000863",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hmph, esta conversación no tiene sentido alguno. Qué más da. Tienes mi\nagradecimiento, pero no mi rencor.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000864",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y es que usaré esta mediática para acercarme aún más a Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más que multipliques cero por algo, solo obtendrás cero. No lograrás vencer\nal talento real con uno falso.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000865",ch="knd"},
},
ja={
{
name={"Kana"},
"“Quizá seamos falsos, pero con una pizca de talento, muchísimo trabajo duro y\nmétodos únicos lograremos convertirnos en auténticos, con algo de suerte.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000866",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sabes qué pasa con el número 0.9 cuando le agregas cifras infinitas?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_knd_000867",ch="knd"},
},
ja={
{
name={"Kana"},
"“0.9, 0.99, 0.999... Llevándolo al infinito, obtienes 1.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.\nEs un tema recurrente en las matemáticas.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero.... si esa es tu proporción, entonces estás cometiendo un grave error.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los genios están por el 0.9.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo ser un genio no te hará llegar a 1.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un ciclo cuasi-infinito de repetición por parte de ese genio.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Combinado con niveles de sufrimiento y deleite que el mediocre jamás podría\nalcanzar.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más un torrente sin fin de emociones.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a eso le agregamos muchísimo ensayo y error.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es como transformas el 0.9 en 0.999...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el valor que se esconde tras el infinito.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En 1, o uno, como único en el mundo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun siendo un genio es difícil llegar al 1.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0018",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0001",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000868",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hmph, ya veo. Tal vez tengas razón.\nAunque eso no pasa de ser un simple juego de palabras.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, también lo podrías poner así.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000869",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tú eres――”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0002",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",size=3,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000870",ch="knd"},
},
ja={
{
name={"Kana"},
"“No es nada. Una ridiculez...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000871",ch="knd"},
},
ja={
{
name={"Kana"},
"“Estuve a punto de decir algo muy tonto...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000872",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y no voy a preocuparme por eso. Yo seguiré adelante.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000873",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hasta el fin, hasta lo más lejano...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, golondrina, golondrinita. Vuela lejos.\nO de lo contrario te consumirá un terrible frío...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0000",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000874",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Golondrina?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cosas mías.\nSolo cosas mías...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="bluesky_spring",id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Miré al cielo.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=2000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1500,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004223",ch="mkd"},
},
ja={
{
name={"???"},
"“¿Y bien? ¿Algo que decir al respecto, señorita genio?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"???"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004224",ch="mkd"},
},
ja={
{
name={"???"},
"“Volaste desde Nueva York hasta acá. Algo tendrás en mente, ¿no, Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_j08_01",time=2000,path=":ev/ev_com_j08/",set="ev_com_j08"},
{"bgm",file="bgm042"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001937",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin está pensando... Haz silencio por un momento...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004225",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno, bueno.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Rin pasa su mano por el vitral de la azotea del hospital general de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004218",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Celofán...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004226",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. De lejos pareciera ser vidrio, pero fabricar un vitral en un día es\nimposible.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004227",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero usando celofán se puede recrear un vitral fácilmente, en cuestión de\nhoras.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004219",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004228",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya genialidad la de Kenichiro Kusanagi, ¿no? Quién diría que tendría esta\ncarta escondida bajo la manga...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004220",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004229",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Al parecer fue un diseño descartado por él durante la elaboración de 'Las\nhuellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004221",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que eso es mentira.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004230",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Mentira?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004222",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si a Kenichiro-san se le hubiese ocurrido esto, lo hubiese hecho antes de\nmorir. De eso no hay duda.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004223",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así era él.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004231",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero el diseño estaba entre sus planos.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004224",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, ya veo...\nPor cierto, Toritani-san. ¿Sabías algo?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004225",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La letra de Nao-kun es idéntica a la de Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004232",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004226",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ambos se parecen incluso en su caligrafía...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004227",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta no es idea de Kenichiro-san.\nÉl jamás pintaría, ni llegó a pintar cerezos después de terminar con 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004228",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Incluso 'Las huellas de los cerezos' fue diseñada cuando Mizuna-san seguía con\nvida...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004229",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La temática de los cerezos era para él, la más importante y delicada...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004233",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces, esto...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004230",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Probablemente a Nao-kun se le ocurrió esto en el instante que se paró aquí.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004234",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que se paró aquí?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004231",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En ese preciso instante... Incluso antes de culminar 'Las huellas de los\ncerezos'.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004235",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Incluso antes de culminar el mural...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004236",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero hacerlo no es tan fácil como idearlo. Registrar el movimiento del sol y\ntodo eso debió ser difícil, además.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004232",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Y por eso creo que ha estado pensando esa idea todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004233",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parándose acá, imaginando las obras de Kenichiro Kusanagi y pensando, ¿qué\npuedo hacer yo? ¿Será posible crear algo aún más grande?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004234",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estoy segura... de que pensó en muchas otras formas de lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004237",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Otras formas de lograrlo?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004235",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por más que calcules el movimiento solar y des con la hora adecuada, si el\nclima llega a alterarse la luz solar no atravesará los vitrales.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004236",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sabrás que Nao-kun siempre se mete en los asuntos de los demás, y en esos\nmomentos siempre pareciera sacarse las ideas de un instante a otro, pero en\nrealidad no es así.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004237",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo ha sido producto de un largo, larguísimo ciclo de pensamiento e\nintrospección...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004238",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei Natsume-kun. Kenichiro Kusanagi-san. Y también yo. Entre cada obra que\npublicamos, estoy segura que él examina e investiga, pensando en qué podría\nhacer él...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004239",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En su cabeza hay una infinidad de ideas, y él tiene la técnica y la habilidad\npara materializarlas.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004238",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no ha publicado nada.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004240",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cuántos años han pasado ya desde aquel día?...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004241",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El fuego todavía arde dentro de Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004242",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso debo marcharme...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004243",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A aquel lugar donde 'yo' no podría llegar... A aquel destino prometido...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004244",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004239",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004245",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La última vez que me encontré a Nao-kun, él dijo esto...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_j08_02",sync=0,face=1,time=400,path=":ev/ev_com_j08/",set="ev_com_j08"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004246",ch="rnd"},
},
ja={
{
name={"Rin"},
"“I dwell in Possibility―",
{"rt2"},
"Vivo en la posibilidad.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004247",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A fairer House than Prose―",
{"rt2"},
"Una casa mejor que la prosa.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004248",ch="rnd"},
},
ja={
{
name={"Rin"},
"“More numerous of Windows―",
{"rt2"},
"Que tiene más ventanas.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004249",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Superior―for Doors―",
{"rt2"},
"Y puertas superiores.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004250",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Of Chambers as the Cedars―",
{"rt2"},
"Y con cedros en sus cámaras.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004251",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Impregnable of Eye―",
{"rt2"},
"Inexpugnables al ojo.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004252",ch="rnd"},
},
ja={
{
name={"Rin"},
"“And for an Everlasting Roof",
{"rt2"},
"The Gambrels of the Sky―”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004253",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y que por techo eterno tiene,",
{"rt2"},
"tejas del cielo――”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004254",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Of Visitors―the fairest―",
{"rt2"},
"La visitan solo los más hermosos.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004255",ch="rnd"},
},
ja={
{
name={"Rin"},
"“For Occupation―This―",
{"rt2"},
"Y mi trabajo es.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004256",ch="rnd"},
},
ja={
{
name={"Rin"},
"“The spreading wide my narrow Hands",
{"rt2"},
"To gather Paradise―”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004257",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Extender estas pequeñas manos,",
{"rt2"},
"y tomar el paraíso.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004258",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En ese entonces, pensaba que esas palabras eran para mí...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004259",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_szd_001938",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin... Ya es hora.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"bg",file="ev_com_j08_01",sync=0,face=1,time=400,path=":ev/ev_com_j08/",set="ev_com_j08"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004260",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004240",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vendrás de nuevo a Japón?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004261",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004241",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nos verás a todos cuando vuelvas, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004262",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004242",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004265",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias por hoy.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004266",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias por tratarme como hace tiempo, como tu amiga. Aun hasta el último\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_szd_001939",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya es hora.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004267",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nos vemos en otra ocasión.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_06_3"},
{"text"},
linkback="block_00234",
},
label = {
top={block="block_00000",label=1},
},
}
