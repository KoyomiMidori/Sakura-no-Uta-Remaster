astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans"},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, ahh, al fin se acabaron las clases suplementarias.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000971",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, duró bastante. Bastante. Demasiado.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"El último día de las lecciones suplementarias. También había el examen de\nreparación incluido, así que salimos más tarde de lo normal.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Aunque a pesar de ser un examen de reparación, fue algo bastante simple.\nBastantes clases suplementarias que tuve que recibir, hubiera sido terrible\nque por lo menos no me la pusieran fácil en el examen.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ya con esto somos libres. A partir de este momento comienzan nuestras\nverdaderas vacaciones de verano.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000972",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡A partir de ahora comienza nuestro verdadero verano! Esperen con ansias el\npróximo trabajo del maestro Naoya Kusanagi. Parece una suspensión hasta nuevo\naviso de un manga, eh~”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con lo bueno que hubiera sido que suspendieran las lecciones suplementarias.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿te vas ahora al club?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000973",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no, no sé por qué, pero parece que hoy no hay actividades en el club. Al\nparecer, por los preparativos del campamento y eso.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000974",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es. Así que creo que nadie vino hoy al colegio. Nada más tú, Makoto y yo,\nquizás.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que también hay alguien más...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mx=-40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000918",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya terminaron sus lecciones suplementarias y los exámenes de reparación,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Pero ¿por qué estás acá? Me acabo de enterar que no hay actividades hoy en\nel club.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000919",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vine a ayudar a Mako-chan. Hay muchas cosas que se necesitan para el\ncampamento.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué hay de los demás miembros? ¿Solo viniste tú?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000920",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan había dicho en un principio que todo lo haría ella sola, así que yo\nla obligué a que me dejara ayudarle.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, Toritani siempre trata de hacerlo todo por su cuenta, aun cuando\npodría pedirle algo de ayuda a los demás.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000921",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, pero he escuchado que todas las generaciones anteriores han sido así.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0006",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000975",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso no es verdad, ¿no? Akashi-senpai siempre se la pasa dejándole todo a los\ndemás.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todas las fechorías innecesarias las comete él solo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000976",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, a eso te referías.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000922",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan había dicho que eso no era verdad. Dijo que Akashi-senpai trabajaba\nbastante por el club, solo que nadie se enteraba...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000977",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De verdad? Me da la sensación de que lo único que ha causado hasta ahora son\nproblemas.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se podría decir que es la clase de tipos que resuelven problemas con más\nproblemas.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000978",ch="ked"},
},
ja={
{
name={"Kei"},
"“Algo así es.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien, Rin? ¿Si estás ayudándola entonces quiere decir que vas ahora al club\nde arte?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000923",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, iré a salir a comprar las cosas necesarias. Hay muchos materiales de\npintura que están escaseando en el club.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, realmente da la sensación de que se acerca el campamento, eh.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000924",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Kusanagi-kun, tú también vas, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000979",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, ¿qué pasa? ¿Por qué aún sigues vacilando, Naoya? También irás al\ncampamento, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, sí...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Pues quizás no sea mala idea ir de campamento. Eso si no consigo nada que\ncapture mi atención antes...",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000980",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué? ¿Tienes que estudiar? ¿Vas a decir que el verano es el punto decisivo de\nlos exámenes de ingreso a la universidad?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es por eso... fumuh...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Me quedo en silencio, sin poder contestar nada.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000925",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Ya veo, está bien. Bueno, tengo que ir a hacer las compras, así que me iré\nya.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000981",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, Rin-chan, te puedo llevar en mi motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000926",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las tiendas quedan cerca, así que no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías llevártelo, por lo menos te será útil para cargar las cosas, ¿no?\nAunque las motocicletas de la familia Natsume son peligrosas, así que te\nrecomiendo que no te montes en ella.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000982",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué estás diciendo? Mi motocicleta es bastante segura. Al montarla, te\nsientes tan seguro que parecieras estar en los brazos de Dios. Tanto así que\nhasta le llaman 'el mito de la seguridad'.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"¿'El mito de la seguridad'? Pero qué rayos... Esa es una flag de que un gran\naccidente ocurrirá...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sea de quién sea la motocicleta, no pueden ir de a dos. Es peligroso.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000983",ch="ked"},
},
ja={
{
name={"Kei"},
"“Demonios, Naoya, qué aprensivo. Bueno, qué más da, iré para ayudarte a cargar\nlas cosas.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000927",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ciertamente son bastantes cosas... Pero ¿qué harás tú, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, tengo un asunto pendiente por resolver.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000928",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, me imagino que no debe ser nada fácil, pero espero que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Ya todos deben estar dándose cuenta de qué estoy investigando algo...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Aunque es de esperarse, después de andar merodeando de forma tan obvia por la\niglesia...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000929",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bueno, nos vemos después, si nos llegamos a encontrar.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=5},
{"fg",ch="圭",mx=-40,mode=-1,lv=4,id=9},
{"se",file="se9023",id=1},
{"text"},
text={
ja={
{
"Rin y Kei se fueron trotando hacia el primer piso.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"se",file="se0728",id=1},
{"ex",time=500,func="wait"},
{"bg",file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me dio la sensación de que el viento sopló.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Un viento que pareciera haber sido soplado desde las escaleras...",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Volteo.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"¿Hay alguien parado allí?...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sui?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-20,zoom=120,speed=240000,file="zbg047b",path=":bg/",x2=-1050,y2=-400,x=-1050,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="fg_sui01",id=7,lv=7,x=300,y=750,zoom=65,speed=120000,path=":cg/",y2=500,ax=1151,ay=1927,bx=-191,by=-1387,sync=0},
{"bg",file="black",id=8,lv=8,x=-1000,y=0,speed=1500,path=":bg/",x2=-260,sync=0},
{"bg",file="black",id=9,lv=9,x=1700,y=0,speed=1500,path=":bg/",x2=960,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Los colores alrededor van hundiéndose, pasando del bermellón al azul verdoso.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"El crujido de la arboleda afuera desaparece,",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"y el mundo abrasado en rojo anaranjado va tiñéndose sigilosamente al azul con\nverde.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"A medida que se siguen las escaleras hacia arriba, se ve como aún arriba están\npintadas en un fuerte rojo.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Esa piel de blanca porcelana está bañada en los colores del sol vespertino.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"E indiferentemente de ello, de esa cara se podía sentir una blanquecina\nbelleza.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y unos labios fuertemente cerrados, como si estuviera conteniendo todo tipo de\nsentimiento.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Su expresión, con ojos bajos, daba una impresión fría...",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Realmente... es Sui?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Los aires que se ciernen a su alrededor son completamente distintos.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Hay algo diferente... a la misma estúpida Sui de siempre.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"La mirada de esa muchacha estaba ahora... observando hacia el pasillo,\nfijamente.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"La mirada de Sui estaba siendo depositada sola y únicamente en un solo punto.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está viendo a alguien?...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Observo el punto donde se dirigía la mirada de Sui.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Una tarde en plenas vacaciones de verano, son pocas las siluetas que alcanza\nesa mirada.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Allí solo estaban Rin y Kei.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La mirada de Sui estaba, sin duda alguna――",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"cgdel",id=-1},
{"se",id=1,file="kazenari"},
{"bg",rule="280r",time=400,sync=1,file="black",path=":bg/"},
{"bg",y=80,zoom=130,x=-1450,file="zbg047b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",y=-100,lv=5,id=9,sync=0},
{"extrans",rule="280r",time=450},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡――!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"¿Es que acaso había alguna ventana abierta?",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"El balance del sonido se rompe, y mi vista se tiñe de una reverberación.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"El viento que se eleva hacia arriba me hace perder la visión por un momento.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Ella dio una pisada en dirección hacia la nada...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"O eso me pareció, pero... la realidad no era nada así de ilusoria, y...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"msgoff"},
{"fg",ch="吹",time=500,mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",x2=0,x=50,y=-100,lv=5,id=9},
{"fg",ch="吹",time=250,mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0001",head="sui_z2a",y2="-100,-90",x=50,y=-100,lv=5,id=9},
{"ex",time=300,func="wait"},
{"se",file="se3130",vol=50,id=1},
{"fg",ch="吹",my=40,mode=-1,lv=5,id=9},
{"ex",time=0,func="wait"},
{"msgoff"},
{"bg",file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh--”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡OYE!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bgm",stop=1,time=500},
{"msgoff"},
{"bg",zoom=200,x=-960,y=-580,speed=250,file="bg047b",path=":bg/",z2=100,x2=0,y2=0,ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=0},
{"bg",rule=105,time=250,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Sui cayó desmayada de las escaleras.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Cayó de una forma casi impecable...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Y entonces, trato de agarrar a Sui y terminó cayendo de las escaleras yo\ntambién, protegiéndola.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"msgoff"},
{"bg",file="bg047b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0010",head="sui_z2a",lv=5,id=9,sync=0},
{"extrans"},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tú...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fgact",ch="吹",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000119",ch="sud"},
},
ja={
{
name={"Sui"},
"“... Kuh...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh... ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0015",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000120",ch="sud"},
},
ja={
{
name={"Sui"},
"“... Gurururururururururu.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="吹",mode=3,path=":fg/sui/z2/",file="sui_z2a0110",face="a0015",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000121",ch="sud"},
},
ja={
{
name={"Sui"},
"“T-Tengo hambrita...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ja?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",rule=139,vague=40,file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... fuu...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se supone que tengo que hacer esto?...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Solo por si acaso, la traigo a la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Parece haberse desmayado, así que se me ocurrió también llevarla de una vez a\nla sala de profesores para pedirle una ambulancia, pero...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Murmulló que tenía hambre, así que la traje hasta acá.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm... Parece que ni Toritani ni Wakata están.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun cuando pensé en dejársela a alguien y largarme...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Por ahora, recuesto a Sui sobre la mesa.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Perdió el conocimiento... o más bien, pareciera estar simplemente dormida.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Su respiración al dormir es bastante calmada.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos pasa con esta muchacha?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000122",ch="sud"},
},
ja={
{
name={"Sui"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_sud_000123",ch="sud"},
},
ja={
{
name={"Sui"},
"“... Mm... mm...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Después de agitar un tanto la respiración, los ojos de Sui se abren lentamente.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Esos humedecidos ojos se dirigieron al objeto que tenía enfrente... es decir, a\nmí.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás consciente ya?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000124",ch="sud"},
},
ja={
{
name={"Sui"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_sud_000125",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Quién eres tú?...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy el mismo que hace dos días se vio obligado a asistir al colegio contigo,\ndespués de que tú te le acercaste a hablarle.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000126",ch="sud"},
},
ja={
{
name={"Sui"},
"“A-Ahh... ahora que lo mencionas, me parece haberte visto en alguna parte.\nCiertamente, tú nombre era... ¡Tanaka-kun! ¡Kakuei Tanaka-kun!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en primer lugar aún no te he dicho mi nombre...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000127",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es eso cierto? Aunque estaba convencida de que te había recordado como\nTanaka-kun, o como Takahashi-kun, o Suzuku-kun o Satou-kun...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que estás haciendo es mencionando los apellidos más comunes de Japón.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000128",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo. ¿Qué deberíamos hacer con tu nombre entonces?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No deberíamos hacer nada. ¡No hace falta discutir eso contigo, yo tengo un\nnombre ya y es Naoya Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000129",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, Naoya Kusanagi... Nada más tu nombre tiene bastante estilo. Suena a una\nespada.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué imagen tan parcializada tienes en esa cabeza? Imaginándote la\nKusanagi no tsurugi (espada Kusanagi) al escuchar Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0004",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000130",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué te parece la idea de cambiarte el nombre a Kusanagi Notsurugi? Me parece\nque suena muy bien. Incluso alguien como tú podría atraer a las muchachas con\nese nombre.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suena raro cuando no nombras apellido y nombre a la vez. ¿Y de qué demonios\nviene ese nombre de Notsurugi?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000131",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es tu nombre.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mi nombre es Naoya!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000132",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es eso verdad? Hasta el día de hoy pensé que eras Notsurugi-san. Lo siento\nbastante. Me disculparé con toda sincera voluntad.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta el día de hoy nunca te preocupaste por mi nombre, ¿no es así?...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000133",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fuh... Dejando eso de lado, ¿por qué Sui se habrá mareado de repente?...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No fue por tener hambre, acaso?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000134",ch="sud"},
},
ja={
{
name={"Sui"},
"“Esa es una teoría bastante interesante. Te pido que me expliques más al\nrespecto.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay ninguna explicación, simplemente lo dijiste en medio del delirio.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000135",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, tienes un poder de deducción bastante impresionante. Probablemente esa\nes la respuesta correcta.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000136",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero quedarse solo en la deducción y no ir más allá deja mucho que desear,\npersonalmente.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000137",ch="sud"},
},
ja={
{
name={"Sui"},
"“Un detective que solo hace deducciones y no resuelve el caso. Eso no es nada\nmás que un chiste. Un detective de chiste.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No son todos los detectives de las novelas detectivescas así? Solo hacen\ndeducciones y ya.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000138",ch="sud"},
},
ja={
{
name={"Sui"},
"“Solo se le puede tildar de excelente detective a aquellos que resuelven los\ncasos de raíz.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás escuchando lo que te estoy diciendo?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000139",ch="sud"},
},
ja={
{
name={"Sui"},
"“Solo a modo de referencia.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni siquiera por referencia me estás escuchando...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000140",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero qué descortés. ¡Sui es una mujer capaz de escuchar a los demás a modo de\nreferencia!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"¿Es algo de lo que debas sentirte tan orgullosa? ¿De que eres una mujer que\nsolo escucha a los demás por referencia?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo lo que quieres decirme. No es nada que no pueda resolver.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000141",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, eso es algo para regocijarse.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ahora espérame acá, no te muevas mucho. Me vas a dar bastante trabajo si te\nvuelves a desmayar.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000142",ch="sud"},
},
ja={
{
name={"Sui"},
"“Está bien. Sui esperará sin moverse demasiado.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",rule="083r",vague=40,file="bg050b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Abro la nevera de Wakata. Adentro están las cosas que él se trae por su cuenta.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"A imagen pública, se supone que es para almacenar materiales especiales de\npintura que deben mantenerse fríos, pero por supuesto, eso es una gran\nmentira.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Ni una sola vez han sido almacenados esos muy especiales materiales en esta\nnevera.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Por lo general solo hay butadon adentro.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijo que si alguien se los comía, lo mataría, pero no soy yo el que va a comer\nasí que no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"excall",file="02_abend_11_2"},
{"text"},
linkback="block_00157",
},
label = {
top={block="block_00000",label=1},
},
}
