astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c11_01",path=":ev/ev_eye_c11/",set="ev_eye_c11"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm106"},
{"text"},
text={
ja={
{
"Miro al cielo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"No me puedo concentrar mucho en el panorama...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_rna_002036",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003433",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Rina-chan, ¿puedo sentarme a tu lado?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rna_002037",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah... Rin-senpai.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Apenas despierto de mi trance me encuentro con Rin-senpai frente a mí. Ni me di\ncuenta.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003434",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhm.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Se sienta ahora a mi lado.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003435",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está despejado el cielo hoy...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_rna_002038",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo está.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003436",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El clima ha estado muy bueno últimamente. Eso me tiene de buenos ánimos...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_rna_002039",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... ¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003437",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero tú no pareces estarlo, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_rna_002040",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Ah, no es eso precisamente...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003438",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Precisamente sí, diría yo. Has estado en la luna desde ayer.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_rna_002041",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Ah, jaja, ¿de, verdad?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003439",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Rina-chan, ¿le dijiste no a Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002042",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿C-Cómo sabes eso? ¿Acaso senpai dijo?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003440",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun jamás le contaría eso a alguien. Solo basta con ver la manera en que\nlos dos se han comportado en estos días para darse cuenta.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_rna_002043",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿La manera, en que nos hemos comportado?...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003441",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. No es que sepa lo que pasó entre los dos, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rna_002044",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es que lo haya rechazado...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003442",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Le diste el sí entonces?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002045",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No somos eso.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003443",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Supongo entonces que realmente no te gusta tanto Nao-kun, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_rna_002046",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Por qué, lo dices?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003444",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun se te confesó, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rna_002047",ch="rna"},
},
ja={
{
name={"Rina"},
"“No fue... algo tan serio como para llamarlo confesión...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003445",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sea lo que sea no pudiste darle una buena respuesta, por lo visto.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002048",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003446",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente no te gusta Nao-kun, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_rna_002049",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003447",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué me puedes decir? Al menos eso quisiera saber.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_rna_002050",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003448",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vaya, ¿ni una palabra?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_rna_002051",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003449",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez debería confesarme yo, entonces.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rna_002052",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Confesarte?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003450",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre me ha gustado Nao-kun. Tanto que incluso decidí transferirme a este\ncolegio.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003451",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me encantaría ser su novia, de tener la oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rna_002053",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-En tu caso, creo... que se verían muy bien juntos, Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003452",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te parece? Pero Nao-kun tiene muchísimas pretendientes tras él.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rna_002054",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues... tú también los tienes, Rin-senpai... N-Nadie, sería capaz de quejarse,\nsi... si llegaran, a volverse novios.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003453",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? ¿De verdad crees que nadie dirá nada?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rna_002055",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, por supuesto...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003454",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Perfecto!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z2",my=40,mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin-senpai se pone de pie.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003455",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nao-kun tiene el corazón roto, debe sentirse solo! ¡Quizás esta sea la\noportunidad para ganarme su corazón! ¡Sí, este es el mejor momento para\nconfesar mis sentimientos!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003456",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Considerando el estado en que se encuentra, si le doy algo de cariño\nseguramente caerá rendido ante mis pies.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003457",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Bien, me iré ya!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=210,lv=4,id=9},
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Rin-senpai intenta irse.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002056",ch="rna"},
},
ja={
{
name={"Rina"},
"“R-Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003458",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_002057",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=210,lv=4,id=9},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x2=210,x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003459",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Tu cara dice todo lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_rna_002058",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Senpai, ¿viniste acá solo para decirme eso?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003460",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Solo eso? ¿Solo por eso? Me extraña que digas eso, Rina-chan. Para mí,\nconfirmar si realmente rechazaste o no a Nao-kun es un asunto de gran\nprioridad.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003461",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si realmente lo rechazaste entonces quizás tenga chance yo ahora, ¿no? Saber\neso es de importancia para mí.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_rna_002059",ch="rna"},
},
ja={
{
name={"Rina"},
"“... K-Kusanagi-senpai... jamás haría eso. Creo...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003462",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? ¿No haría eso? ¿Hacer qué?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_rna_002060",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Jamás saldría con una chica por consolación!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003463",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro, claro, tienes razón. Quizás deba dejar entonces la confesión para\ndespués, y simplemente darle algo de mi cariño mientras tanto.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003464",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Poco, a poco... Así seguramente podré hacerlo mío.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rna_002061",ch="rna"},
},
ja={
{
name={"Rina"},
"“De igual manera él...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003465",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De igual manera qué? ¿De igual manera no buscará irse con otra mujer? ¿Eso es\nlo que quieres decir, Rina-chan?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002062",ch="rna"},
},
ja={
{
name={"Rina"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003466",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí realmente es eso lo que quisiste decir, entonces eres una chica muy cruel,\nRina-chan. Lo dejaste ir, aun sabiendo que por más lastimado que pueda estar\nno se irá con alguna otra mujer...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003467",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Peor aun, ni siquiera puedes aclarar si lo amas o no.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003468",ch="rnd"},
},
ja={
{
name={"Rin"},
"“'Nao-kun nunca duda en lo que quiere, así lo dejé ir seguramente volvera por\nmí'. No habrás estado pensando eso, ¿o sí, Rina-chan?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002063",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Eso no...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003469",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso no, qué?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rna_002064",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003470",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_rna_002065",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo pensé de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003471",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo lo pensaste entonces?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rna_002066",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003472",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te preocupa Yuumi-chan?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rna_002067",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003473",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, solo para aclarar, no sé qué ha sucedido entre las dos. Pero no puedes\nnegar que Yuumi-chan te ve más que como una simple amiga, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003474",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sé qué tanto haya entre los tres, pero se me ocurrió que quizás hayas\nrechazado a Nao-kun por eso...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rna_002068",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003475",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si realmente dejaste a Nao-kun en la espera por tan estúpida razón, yo\nharé lo que sea para hacerlo mío.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002069",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003476",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No en vano, pues es por eso que vine de vuelta...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_002070",ch="rna"},
},
ja={
{
name={"Rina"},
"“R-Rin-senpai, ¿volviste a Yumihari para tener a Kusanagi-senpai para ti?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003477",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no fue por eso.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003478",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay unas palabras que no he podido jamás quitarme de la cabeza...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rna_002071",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Unas palabras?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003479",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En el momento en que nuestros amados mueren, la vida debemos quitarnos.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003480",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En el momento en que nuestros amados mueren, ninguna otra alternativa tenemos.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_002072",ch="rna"},
},
ja={
{
name={"Rina"},
"“He escuchado eso antes.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003481",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es un extracto de 'Fantasía de un día de primavera', de Chuuya Nakahara.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003482",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun susurró eso poco después de que su madre muriera. Cuando todavía éramos\nniños...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003483",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aquella vez me enfadé, no entendía bien todavía lo que realmente significaban\nesas palabras.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003484",ch="rnd"},
},
ja={
{
name={"Rin"},
"“'¿Por qué dices cosas tan tristes?', le pregunté.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003485",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fui una tonta... No llegué a pensar ni un momento en lo que Nao-kun podría\nestar sintiendo en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rna_002073",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero a nadie le gustaría que le dijeran que la única opción que queda después\nde que un ser amado muere es suicidarse... y menos aun cuando se trata de la\npersona que te gusta...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003486",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Pero el poema continúa.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003487",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, manchados de pecado estamos, y teniendo encima toda una vida por\ndelante...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003488",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo queda entregarnos al altruismo. Solo nos queda entregarnos al altruismo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003489",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi ser más amado murió, sí, conmigo ya no está...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003490",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y nada puedo hacer ya, así que por él, sí, por él...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003491",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debo ser altruista. Debo ser un altruista.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003492",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nakahara perdió a su amado hijo todavía joven. 'Poemas de días pasados' expresa\nbastante lo que sintió en ese entonces, en especial 'Fantasía de un día de\nprimavera'.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003493",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El poema transmite el dolor que se siente al perder a un ser amado.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003494",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes? Todo este tiempo estuve pensando en por qué Nao-kun habrá recitado esas\nestrofas en aquel preciso momento.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003495",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso vine a Yumihari. Para buscar una respuesta convincente a esa pregunta.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003496",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para eso regresé acá...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_002074",ch="rna"},
},
ja={
{
name={"Rina"},
"“La última obra de senpai se llama justamente 'Fantasía de un día de cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003497",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, probablemente el nombre lo tomó de ahí.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003498",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Presiento... que Nao-kun es incapaz de amar cuando se trata de su propio\ninterés...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rna_002075",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Senpai es incapaz de amar a los demás?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003499",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Naoya Kusanagi es, diría yo, un altruista hasta los huesos...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003500",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso... es que siempre está metiéndose en todo tipo de situaciones...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003501",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me puse a investigar respecto a varias cosas apenas regresé a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003502",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y me enteré de unas cuantas.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003503",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al parecer Nao-kun había dejado bocetos en varios lugares para cuando te\nconoció, Rina-chan...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003504",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Su última obra oficial fue 'Fantasía de un día de cerezos', pero aun después de\neso siguió pintando una gran cantidad de bocetos.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003505",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En lienzos, papel de construcción, e incluso sobre paredes...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003506",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque parece que casi todos los dibujos fueron borrados. Por él mismo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003507",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Como si estuviera intentando ocultar algo...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rna_002076",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Aparte de paredes también lo hizo en otros objetos?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003508",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, fue por coincidencia que me enteré. Conocí a un viejo conocido de Kenichiro\nKusanagi, quien resultó tener en su posesión unas cuantas de las obras que\nNao-kun no alcanzó a destruir.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rna_002077",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo eran?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003509",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todas estaban incompletas... y además, estaban hechas un desastre por encima,\narrugadas.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003510",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Desconozco la razón. Pero ya no podía pintar de la misma manera que lo hizo con\n'Fantasía de un día de cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003511",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es lo único de lo que tengo certeza...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003512",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque, de cierta manera, algo dentro de mí conectó eso con el altruismo del\ncual habla Chuuya Nakahara...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003513",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y pensé, ah, quizás ha estado intentando ocultar el dolor de la muerte de su\nmadre todo este tiempo usando el altruismo...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003514",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esa idea no ha dejado de dar vueltas en mi cabeza...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003515",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y me pone a pensar que, quizás, toda muestra de amor de su parte sea solo un\nproducto de ese altruismo...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rna_002078",ch="rna"},
},
ja={
{
name={"Rina"},
"“De ser realmente así, sería muy triste...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003516",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Por eso es que Nao-kun necesita alguien que lo ame.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003517",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo, quizás, que perdió la facultad para amar al perder a su madre... Y por\neso mismo me parece que necesita a alguien que le dé amor.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003518",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que si no estás dispuesta a amar a Nao-kun,\nentonces lo haré yo, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rna_002079",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003519",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso... es lo que tengo en mente.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003520",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si no lo haces tú, lo haré yo. Si nadie lo hace, Nao-kun nunca podrá liberarse\nde la cruz que ese mismo altruismo representa para él...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002080",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y-Yo!...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003521",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_rna_002081",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yo, pienso, que eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003522",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso dices?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rna_002082",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡S-Senpai es capaz de amar a los demás!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rna_002083",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo no creo que la muerte de su madre lo esté perturbando todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rna_002084",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Él es perfectamente capaz de amar a los demás!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003523",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... ¿En base a qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_rna_002085",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_rna_002086",ch="rna"},
},
ja={
{
name={"Rina"},
"“Realmente no sé por qué. Pero cada pincelada, cada trazo en sus obras está\nlleno de un amor que simplemente no se puede describir con simple altruismo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rna_002087",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eso de que senpai no es capaz de amar a los demás son solo ideas tuyas,\nRin-senpai!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_002088",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Yo pienso lo contrario!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003524",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Yo también podría argumentar que lo que dices son solo ideas tuyas,\nRina-chan.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rna_002089",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás. Pero... ¡a mi parecer eres tú la que está equivocada, senpai!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bgm",stop=1,time=1000},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",x=0,lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003525",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vaya...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003526",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003527",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes una muy buena mirada en este momento...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rna_002090",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003528",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me gustó esa mirada, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rna_002091",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mi mirada?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003529",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre has sido una buena muchacha, Rina-chan. En ningún momento das a ver lo\nque realmente sientes.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003530",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero justo ahora mostraste odio por mí. Se notaba en tu cara.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rna_002092",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿O-Odio?... S-Senpai, yo nunca har--”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うんうん",time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003531",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No mientas. Ya es muy tarde para las excusas. Esa mirada que tenías ardía de\nodio por mí.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003532",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero es lo debido.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003533",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No debes tomar por cierto todo lo que dije.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003534",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay la posibilidad, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003535",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero aquella persona que esté dispuesta a amarlo debe ser capaz de creer\ntambién en sus sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003536",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya es hora de que Kusanagi-kun se libere de la cruz del altruismo...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003537",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya es hora de que supere la muerte de su madre... y acepte la de su padre... Ya\nes momento para que supere todo eso...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003538",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y creo que Kusanagi-kun es ya capaz de amar.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003539",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo... que ya encontró a alguien a quien puede amar.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rna_002093",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003540",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun te encanta, ¿no es así, Rina-chan?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002094",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003541",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No te quedes callada!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rna_002095",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rna_002096",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003542",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, me gusta que seas honesta. Pensé por un momento en tirarte al suelo de\nescuchar otra más de tus respuestas ambiguas.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rna_002097",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hubiera preferido eso...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003543",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo no. Si lo hiciera tendría que pelear con Yuumi-chan, y a ella la quiero\nmucho.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_rna_002098",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja... Senpai, a Yuumi sí...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003544",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003545",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y en tu caso, Rina-chan, odié la manera en que te comportaste hace un momento,\npor cierto.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_002099",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003546",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero debo decir que no odio la Rina-chan que veo ahora.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rna_002100",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003547",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es injusto que intentes huir de un 'me gustas'.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003548",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun te eligió a ti, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003549",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En mi caso, se me hace difícil alegrarme del todo por eso. Pero aun así me\nparece bien.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003550",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al menos podré ver a Kusanagi-kun amando a alguien...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003551",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás no sea yo ese alguien... pero igualmente me parece que valió la pena\nregresar a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rna_002101",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003552",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? Dime.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Senpai me responde cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rna_002102",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai, Rin-senpai, yo, yo--”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"No puedo conectar bien mis palabras. Me quedo trabada, repitiendo lo mismo una\ny otra vez.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rna_002103",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",loop=2,time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003553",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, vamos, vamos, no me veas de esa forma! ¡Me harás parecer más patética aún!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002104",ch="rna"},
},
ja={
{
name={"Rina"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003554",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No es que tenga una piedra por corazón. Tampoco soy una santa, que se\npreocupa solo por los demás...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003555",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Soy una persona como cualquiera, solo una humana... Yo...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003556",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003557",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo ni siquiera, quería hacer esto...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003558",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si es por la felicidad de Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Rin-senpai conserva todavía su sonrisa, pero su voz se estaba acercando más a\ngemidos.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Sus ojos se estaban llenando de lágrimas.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Esta muchacha es...",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Es... tan buena...",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Sentí una punzada en mi pecho.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003559",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cualquiera puede amar...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003560",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cualquiera puede enamorarse...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003561",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero que te correspondan, y que puedas unirte en amor con esa persona, no es\nfácil...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003562",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Y por eso, por eso es que debes hacer lo que debes hacer!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rna_002105",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Tienes... razón.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003563",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De lo contrario, terminarás haciéndole aún más daño a los que te rodean.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003564",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No solo a Yuumi-chan.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003565",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Amar a una persona implica herir a otra a veces.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003566",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y por qué? Pues porque así de grande es aquello que llamamos amar...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003567",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso mismo es que no debes huir de lo que sientes solo por el miedo de herir\na alguien.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003568",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debes ser honesta con lo que sientes.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003569",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque eso termine hiriendo a los demás...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_rna_002106",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003570",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que eso se escuchó como un sermón. Perdón...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_rna_002107",ch="rna"},
},
ja={
{
name={"Rina"},
"“Para nada...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003571",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero debía decirlo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003572",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Como una advertencia a la ganadora. Por parte de la perdedora...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003573",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, olvídalo, lo de la advertencia es solo una mentira. Simplemente quise\nconfiarte aquello que yo no pude hacer...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003574",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es lo menos que puedo pedir...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003575",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Rina-chan... haz feliz a Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"msgoff"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",size=5,lv=4,id=9},
{"ex",time=500,func="wait"},
{"se",file="se9004",id=2},
{"fg",ch="稟",speed=10000,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=1000,lv=4,id=9},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y con esas palabras, Rin-senpai salió corriendo de la azotea, sin siquiera\nesperar por mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Rin-senpai es, realmente, una persona muy peculiar...",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"¿Por qué pensaré esto ahora? Si cuando apenas la conocí parecía ser una simple,\ngentil y cariñosa muchacha con rasgos de consejera.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Y en realidad, su personalidad, su forma de ser va mucho más allá de eso.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"¿Podría hacer yo lo mismo de estar en su lugar?",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"¿Realmente senpai es capaz de elegirme a mí, teniendo a alguien como ella\ncerca?",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"¿Habrá alguien capaz de sentir tanto amor por él como Rin-senpai?",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rna_002108",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Si yo...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_zypressen_09"},
{"text"},
linkback="block_00236",
},
