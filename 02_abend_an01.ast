astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"bgm",file="bgm007"},
{"bg",file="eveningsky_spring01",id=9,lv=9,path=":cg/"},
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde que comenzó el verano ha estado bastante ocupada.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"A pesar de estar estudiando para los exámenes de ingreso, también ha estado\ntrabajando bastante en lo referente al club. Toritani es la que más ha estado\nlaborando hasta ahora...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, ahora está planificando un campamento. Aun con todo el tiempo que\ntoma elaborar algo de esa magnitud.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Otra opción es Akashi.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Ni en broma.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Hikawa podría ser una buena opción.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Lleva un buen tiempo viviendo en Yumihari. Debe conocer bien el lugar. Es\nademás perspicaz y espabilada como Toritani.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa no es mala opción tampoco, pero... umumuh.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da miedo de que Yuumi llegue a enterarse de que llamé a Hikawa y se enoje...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, Hikawa... y, la otra opción es...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Rin.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"No ha pasado tanto tiempo desde que regresó, pero parece sentir apego por\nYumihari. Y entre todas es quien mejor me podría ayudar. Con el mismo empeño\ncon el que me ha ayudado con los estudios.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero creo que Rin nunca ha sido muy conocedora de estos lugares...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"¿Qué hago?...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Con esa pregunta en la mente, sigo caminando.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Sigo caminando, con rapidez.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Mientras más camino más se infla mi angustia.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo quedarme pensando por siempre.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Decido, por los momentos, llamar a Rin.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"se",id=1,file="se1343"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No atiende...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que en momentos como estos es raro llamar a amigos... Lo más lógico\nsería...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Decidí llamar a casa.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"msgoff"},
{"se",sync=1,id=1,file="se1343"},
{"se",id=1,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001842",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buenas tardes, familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, esa voz, debes ser Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_szd_001843",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, la misma. ¿Hubieras preferido a alguien más?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quise decir eso...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"¿Se habrá dado cuenta del ligero tono de decepción en mi voz cuando atendió?...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me perdí... aunque supongo que no conocerás mucho el lugar donde estoy.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_szd_001844",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si fuera tú, no subestimaría tanto a Shizuku. Sé de todo un poco.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, pero Shizuku, hasta hace poco tú--”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_szd_001845",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hasta hace poco?...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, me equivoqué con eso.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_szd_001846",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh, ¿aún no entras en cuenta de que Shizuku y tú apenas acaban de conocerse?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_szd_001847",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin, descríbeme lo que ves adelante y a los lados, y hazlo cada treinta\nmetros.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001848",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo tengo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Ya sabes dónde es?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_szd_001849",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, busqué en internet lo que me describías mientras observaba el mapa de la\nciudad. Ya tengo una idea de dónde estás.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_szd_001850",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De verdad.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hago ahora?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_szd_001852",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sigue caminando en la dirección que vas, deberías dar con una calle de bares.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una calle de bares?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_szd_001853",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, eso debería haber. Sigue caminando hacia allá.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, haré como me indicas.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_szd_001854",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, dame unos minutos...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Unos minutos? ¿Qué vas a hacer?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"No sé qué piensa hacer. Por ahora, sigo caminando tal como me lo indicó.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"se",file="se9026",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? Alguien está llamando...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Sonó mi teléfono. Observo la pantalla, y quien estaba llamando era...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, probablemente vio mi notificación y decidió llamar...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
"Pulso el botón y atiendo.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003919",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hola? ¿Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy yo.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003920",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Había una notificación en mi teléfono de que me llamaste, y...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, es que me perdí.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003921",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-En serio? ¿Y decidiste llamarme?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, iba a pedirte ayuda, pero...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llamé a casa y ya me ayudaron.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003922",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Supongo entonces que, ya estás de vuelta en camino?...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente no. Estoy caminando mientras sigo las indicaciones que me dan,\npero... estoy ahora en una calle de bares que jamás había visto...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Mientras hablo con Rin sigo caminando como Shizuku me lo indicó, y llego a un\nlugar que jamás había visto.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conocía este lugar...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003923",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Una calle de bares... Ah, ¿por casualidad hay el letrero de una calle comercial\ncerca?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Letrero? ¿De una calle comercial?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003924",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, si la memoria no me falla, el único lugar por acá donde hay una calle de\nbares es en la calle comercial de Namidagawa...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"cgdel",id=-1},
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, tienes razón. Dice Namidagawa. Vaya que conoces esto por acá, eh.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003925",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por estos lugares solo está el distrito comercial de la estación de\nSakuragahara y el de Namidagawa. Y supongo que ya conoces bien el de\nSakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003926",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, menos mal. ¡Bien, hablamos después!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos? Me acaba de cortar.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhmmm... ¿Qué es lo que está pasando?...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"No entiendo qué le pasa a Shizuku y a Rin. ¿Es que no podían ayudarme un poco\nmás?...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Sea lo que sea, no entiendo nada de lo que pasa.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",id=1,file="se3628"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Escucho el chirrido de los frenos de una bicicleta.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Al voltear, veo a Shizuku con una bicicleta.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku... Qué haces...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estás cubierta de sudor...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001855",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Pero mi cara está fresca, ¿a que no?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, como siempre. Pero no pensé que vendrías hasta acá...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001856",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pedaleé con bastante intensidad, así que estoy algo cansada.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No hacía falta que te apresuraras tanto.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001857",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me necesitabas, y por eso vine con toda rapidez.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_001858",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Toma.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Al decir eso, Shizuku me dio una toalla.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está fría...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001859",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Supuse que estarías acalorado, así que la remojé en agua helada y la traje\nconmigo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que eres considerada...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001860",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí? Gracias. Bien, perdóname un momento, yo también...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku comenzó a secarse el sudor con un pañuelo. Se me hizo\nalgo sexy la escena.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_szd_001861",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué estás viendo?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0012",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001862",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Jaa? ¿Será que tienes tanta sed que te dieron ganas de beber de mi sudor?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No conozco a nadie capaz de hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001863",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué alivio. Traje bebidas, pero nada hubiera podido hacer si pedías mi sudor, y\nno poder cumplir con eso me avergonzaría bastante.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, no debería darte pena no poder cumplir con eso.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0012",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001864",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí? En fin, menos mal. Te imaginé chupando de mi pecho y mi cuello pidiéndome\npor más líquido, y me excité en secreto...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Te excitaste?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001865",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Era broma.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que era una broma?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001866",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero si llegaras a pedirme que lo hiciera, mojaría mis pantis al instante.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mojarías tus pantis?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001867",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quieres probar?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Probar, qué?...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0002",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001868",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Probar a que lamas mi pecho detrás del callejón, y compruebes después si mis\npantis se mojaron o no...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Sabes la cantidad de problemas contenidos en esa propuesta?!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001869",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te parece? Yo con solo imaginármelo siento que podría mojarlos en cualquier\nmomento.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viendo cómo va esto me imagino que es otra de tus bromas.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0003",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001870",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quién sabe? Solo podría decir que queda de ti probar si lo es o no.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No has cambiado nada, eh... Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0300",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001871",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hm, hm? ¿Quién es Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? L-Lo siento, me equivoqué.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001872",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien, no hay problema siempre y cuando estemos a solas.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, si nos ponemos a hacer eso, acabaré descuidándome y llamándote Kuzu frente a\nlos demás.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001873",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ciertamente. Mi nombre real es Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Te llamas Shizuku Natsume, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001874",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Shizuku sonrió, un tanto feliz.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",mode=-2},
{"bgm",stop=1,time=500},
{"se",id=1,file="se3628"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Mm?",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Vuelvo a escuchar el sonido de los frenos de una bicicleta, detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001875",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Shizuku? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Shizuku se queda paralizada, viendo algo.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Sigo con mis ojos la mirada de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bgm",file="bgm105"},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0013",head="shz_z1b",x2=0,x=345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=-40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003927",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-Eh? V-Vaya, Nao-kun, estabas... acompañado.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001876",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Al ver a Rin, Shizuku dio un paso hacia atrás.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",x=345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003928",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¡l-lo siento!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Al ver la expresión de Shizuku, Rin baja su cabeza y se disculpa.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003929",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento. No me imaginé que Shizuku-san vendría a buscarte...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Parece que Rin recordó la cara de Shizuku, aun después de solo haberla vista\npor un momento en la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo tampoco me lo imaginé...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003930",ch="rnd"},
},
ja={
{
name={"Rin"},
"“B-Bueno, creo que sobro acá. Sí, lo siento, me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=5},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Rin intenta montarse en su bicicleta.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Pero en ese momento, Shizuku agarró la manga de su camisa.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"msgoff"},
{"fg",ch="雫",speed=300,sync=1,mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",x2=345,x=210,lv=4,id=9},
{"fg",mode=-2,sync=0},
{"bg",file="zbg068b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"se",file="se9010",id=1},
{"fg",ch="稟",size="z2",mx=40,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0012",head="rin_z2a",x=-345,lv=5,id=5},
{"fg",ch="雫",size="z2",mx=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0300",face="b0011",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003931",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0013",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001877",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Probablemente Shizuku actuó sin pensarlo. Se veía igual de sorprendida que Rin.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Pero de igual manera, comenzó a hablar.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0010",head="shz_z2b",x=345,lv=5,id=6},
{"fgact",ch="雫",act="いいえ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0011",head="shz_z2b",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001878",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“D-Disculpa, por lo de la vez pasada... N-No fui capaz de siquiera saludar, aun\nteniéndote en mi propia casa...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0011",head="rin_z2b",x=-345,lv=5,id=5},
{"fgact",ch="稟",act="いいえ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0010",head="rin_z2b",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003932",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no te preocupes. La culpa la tuvimos nosotras por ir sin previo aviso. Era\nnatural que te desconcertaras.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0009",head="shz_z2b",x=345,lv=5,id=6},
{"fgact",ch="雫",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001879",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es eso.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0008",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001880",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, yo--”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0012",head="rin_z2b",x=-345,lv=5,id=5},
{"fgact",ch="稟",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003933",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sabes... cómo me llamo?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0009",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0008",head="shz_z2b",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001881",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, esto... Nii-san me habló de ti. Y Naoya-san, también...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0002",head="rin_z2b",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003934",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0002",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001882",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sip...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Shizuku permanece sin moverse, todavía con la manga de Rin en su mano.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",x=345,lv=4,id=4,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003935",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001883",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dime, Rin.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0004",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003936",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... ¿Te molestaría... si me presento de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=4},
{"fgact",ch="雫",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001884",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003937",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi nombre es Rin Misakura. Viví hace mucho tiempo en esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fgact",ch="雫",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001885",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... lo sé...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003938",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Lo sabías?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001886",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, Naoya me lo dijo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003939",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Una vez más ambas se quedan en silencio.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001887",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=4},
{"fgact",ch="雫",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001888",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo soy Shizuku Natsume. La hija menor de la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003940",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ya me habían contado.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fgact",ch="雫",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001889",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Espero que podamos llevarnos bien...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003941",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Rin toma la mano de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001890",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0001",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003942",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás... sea muy atrevido pedirle esto a una celebridad... pero...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003943",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-san, ¿quisieras ser mi amiga?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0013",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001891",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0300",face="d0013",head="rin_z1d",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0300",face="d0008",head="rin_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003944",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Aunque bueno, entiendo que tal vez no puedas.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0006",head="shz_z1b",x=345,lv=4,id=4},
{"fgact",ch="雫",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001892",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Por supuesto que sí!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0300",face="d0012",head="rin_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003945",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Shizuku contesta con un tono poco característico de ella.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0009",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001893",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Si no te molesta, quisiera ser tu amiga...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0004",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003946",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Si eso dices, me encantaría!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001894",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003947",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así me llamo...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0004",head="shz_z1b",x=345,lv=4,id=4},
{"fgact",ch="雫",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001895",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es un gusto conocerte... Rin.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0004",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003948",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El gusto es mío, Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001896",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que decidiste volver...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003948b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0004",head="shz_z1b",x=345,lv=4,id=4},
{"fgact",ch="雫",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_001898",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo... sí.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"msgoff"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0012",head="rin_z1b",x=-345,lv=4,id=5},
{"se",id=1,file="se3356"},
{"fg",ch="雫",time=300,mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0004",head="shz_z1b",x2=345,x=0,lv=4,id=4},
{"quake"},
{"fg",mode=-2},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Shizuku abraza a Rin.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Rin se asombró por un momento, pero luego le regresó cariñosamente el abrazo a\nShizuku.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_szd_001899",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bienvenida otra vez... Rin.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003949",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aquí estoy de nuevo... Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Un 'gusto en conocerte', seguido por un 'Bienvenida otra vez'.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Vaya que es una forma rara de presentarse entre las dos, pero supongo que es lo\nmás apropiado para la relación que tienen...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003950",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eres realmente hermosa, Shizuku-san.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_szd_001900",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, no tienes que usar honoríficos conmigo.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003951",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me cuesta un poco llamarte solo por tu nombre. ¿Puedo llamarte Shizuku-chan?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001901",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, está bien así. Me gusta que me llames así.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003952",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"El abrazo se repite, esta vez por parte de Rin.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001902",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Shizuku extiende sus brazos lentamente y devuelve el abrazo... o eso parecía,\npero――",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",mode=-2},
{"fg",ch="稟",size="z2",my=40,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0022",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003953",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Hyaah!”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_szd_001903",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Muhhh, Rin, qué grandes se te han vuelto...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0014",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うんうん",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003954",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wa, wawah, estás tocando mis pechos.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_szd_001904",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Umuh, estoy tocándolos.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0016",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003955",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si haces eso yo también contraatacaré, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001905",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Hyaah!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003956",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uwah, qué esbelta estás... Y estas caderas...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Ambas se abrazan. A plena vista de todos, en un barrio de los bajos.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Y como era de esperarse...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="man_osa_000001",ch="osa"},
},
ja={
{
name={"Señor A"},
"“Ohhh, ¿pero qué hay aquí?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Los hombres alrededor comienzan a agruparse, uno por uno.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Era de esperarse. Dos jóvenes chicas abrazándose y tocándose entre sí en esta\nclase de lugar. Era obvio que vendrían los hombres a ver.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="man_osb_000001",ch="osb"},
},
ja={
{
name={"Señor B"},
"“Venga, venga, este no es lugar para hacer esas cosas, pequeñas.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es eso, solo que hubo una escena algo emocional entre las dos, y\nbueno... ¡Eh, Rin, Shizuku!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",my=40,mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003957",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nos vamos ya! ¡Se acabó la presentación!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0022",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001906",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin～”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Venga, ya está, vámonos, vámonos!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Jalo a las dos y las separo, para luego irnos de ese lugar.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"se",file="se1135",id=1},
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=5},
{"fg",ch="雫",mx=-40,mode=-1,lv=4,id=6},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... Hombre...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué penoso fue eso.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003958",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tengo excusa alguna, lo siento mucho.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001907",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Umuh, yo también me dejé llevar un poco.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, tengo que decirlo, no pensé que vendrías, Rin.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003959",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es que cuando hablamos, me di cuenta de inmediato dónde estabas...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Rin también estaba tan sudorosa como Shizuku.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Estas muchachas... Jaa, vaya...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001908",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué tienes ahí, Rin?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003960",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah, esto? Ah, creo que es lo mismo que trajiste tú.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_szd_001909",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero tienes compresas frías...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003961",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, las traje pensando que quizás servirían de algo, y bueno... ¿Les sirve?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, a mí sí, y bastante. Caminé un buen rato llevando carne cruda.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003962",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Qué bueno. Aunque en un principio había pensado en dártelo enrollado en\nuna toalla para que lo usaras tú.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Meto las compresas frías que Rin trajo en la bolsa con las compras.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_szd_001910",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Todavía tienes más cosas.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003963",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí, té de cebada también.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te pesó bastante?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003964",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para eso traje la bicicleta. Gracias a ella pude traerlo todo.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001911",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Deberías aprovechar que Rin trajo té y tomar algo, Naoya. Podrías estar\ndeshidratado.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003965",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es buena idea. Nao-kun, ¿no te gusta el té de cebada?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo crees?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003966",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Menos mal.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"se",file="se9025",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin me sirvió algo de té de cebada de su cantimplora.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Me tomo el té con gusto, haciendo sonar mi garganta.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"mwact",act="びっくり",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pwaaah... He vuelto a la vida.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003967",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué bueno.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_szd_001912",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, vayamos entonces.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003968",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí. Bien, yo me voy ya...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001913",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, tú también...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"se",file="se9010",id=1},
{"fg",ch="雫",speed=500,mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x2=345,x=245,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",time=250,lv=4,id=6},
{"text"},
text={
ja={
{
"Shizuku agarra la manga de Rin.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_szd_001914",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De igual forma planeabas acompañarlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003969",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí... pero ya viniste tú, así que...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0009",head="shz_z1a",x=245,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001915",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, pero... Rin.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003970",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí, creo que mejor me voy! Bueno, con esto me retiro.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=245,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001916",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero, Rin--”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003971",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, debes cumplir con el propósito para el cual viniste y llevar a\nNao-kun de vuelta a casa. Yo vine acá porque quise, así que no importa.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",x=245,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001917",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si es por eso, yo también...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003972",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"msgoff"},
{"fg",ch="稟",speed=400,sync=1,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",time=500,sync=1,mode=-2},
{"se",file="se0897s",id=1},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0012",head="shz_z2a",lv=5,id=6},
{"text"},
text={
ja={
{
"Al decir eso, Rin abraza a Shizuku y lleva su cabeza a su pecho.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_001918",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003973",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sé por qué, pero... siento algo de nostalgia cuando te veo, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001919",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003974",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso... Olvídalo. No es nada. Bueno, me voy ya, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001920",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, quiero estar un ratito más contigo...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003975",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, cómo me alegra escuchar eso. Pero ya terminé lo que vine a hacer.\nAdiós para ti también, Nao-kun. ¡Nos vemos mañana!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vale...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=5},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Después de decir eso, Rin se montó en su bicicleta y se esfumó entre las\ncalles.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001921",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos le pasa?... Pudo haber venido con nosotros...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001922",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es eso. Rin es, muy buena... y tal vez consideró que era lo mejor para los\ndos. Creo...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Muy buena?”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001923",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin, es mejor que aceptemos la buena voluntad de Rin y regresemos ya.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"msgoff"},
{"se",file="se9004",id=1},
{"bg",file="zeveningsky_spring01",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku comenzó a caminar.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Shizuku. ¿Cómo es que conoces este lugar después de tanto tiempo\nestando fuera?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_szd_001924",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Porque a Kenichiro Kusanagi le encantaba venir acá...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_szd_001925",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Más sorprendida estoy yo de que no lo supieras.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te puedo jurar que nunca supe mucho de su vida privada.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_szd_001926",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aun con lo mucho que se parecen...”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así?”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_szd_001927",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Son idénticos...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_szd_001928",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me enteré que Kenichiro-san venía con frecuencia a este local, por lo barato\nque es.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je, aquí...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="ノノ未",size="z1",time=500,sync=1,mode=3,resize=1,path=":fg/non/z1/",file="non_z1i0000",face="i0003",head="non_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000001",ch="nnd"},
},
ja={
{
name={"???"},
"“Bienvenidooos.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Al asomarme a ver el local, una muchacha un tanto pequeña de estatura salió a\nrecibirnos.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no somos clientes.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1i0000",face="i0004",head="non_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000002",ch="nnd"},
},
ja={
{
name={"???"},
"“¿No? Aunque sí, definitivamente no conozco sus caras.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás ayudando a tu madre o a alguien de la familia con el trabajo, pequeña?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1i0000",face="i0002",head="non_z1i",lv=4,id=9},
{"fgact",ch="ノノ未",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000003",ch="nnd"},
},
ja={
{
name={"???"},
"“Nono, Nonomi trabaja acá.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Trabajas acá? ¿Con lo joven que eres?”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1i0000",face="i0003",head="non_z1i",lv=4,id=9},
{"fgact",ch="ノノ未",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nnd_000004",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Tengo bastante experiencia en esta industria.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"La pequeña infla su pecho con orgullo.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Bueno, vendré de nuevo cuando tenga edad para beber alcohol.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1i0000",face="i0002",head="non_z1i",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="ノノ未",size="z1",mode=3,path=":fg/non/z1/",file="non_z1i0000",face="i0003",head="non_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nnd_000005",ch="nnd"},
},
ja={
{
name={"Nonomi"},
"“Ya veo, así que aún no tienen edad para tomar. Bueno, esperamos que vuelvan a\nvisitarnos～”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fgact",ch="ノノ未",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"La pequeña hace una reverencia.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"msgoff"},
{"fg",ch="ノノ未",sync=1,mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se acercó a hablarme.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0012",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001929",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, la gente de esta zona suele ser muy amable... y qué linda la niña que te\natendió.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Atravesamos la calle comercial de Namidagawa.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"bg",file="eveningsky_spring01",id=9,lv=9,time=500,path=":cg/"},
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"Solo con girar a la izquierda pasé de una urbanización desconocida a una zona\nque con toda certeza atravieso con frecuencia.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, conque aquí nos lleva esa calle.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="fem_szd_001930",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Ahora que sabes, podrás venir a tomar a Namidagawa sin problema alguno\ncuando te vuelvas adulto.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La idea de decidir desde ya la taberna donde beberé de adulto no me agrada\ntanto...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Guiado por Shizuku, pude emprender mi camino de vuelta a casa.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_an02"},
{"text"},
linkback="block_00312",
},
label = {
top={block="block_00000",label=1},
},
}
