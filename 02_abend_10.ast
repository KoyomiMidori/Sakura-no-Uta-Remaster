{"vo",file="fem_snd_000015",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No quiero.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
