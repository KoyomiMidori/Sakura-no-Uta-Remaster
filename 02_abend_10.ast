astver = 2.0
astname = "ast"
ast = {
block_00000={
{"fg",mode=-2,sync=0},
{"bg",file="bg017a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0020",head="yum_z1b",x=-570,lv=4,id=3,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0013",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",time=0},
{"bgm",file="bgm012"},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=0,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000371",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0006",head="yum_z1a",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000643",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡P-Pero q--! ¡¿Q-Qué significa eso?! ¡Rin-senpai!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000906",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"¿Oh? Siendo amante de las mujeres, ¿es que acaso Kawachino ve ahora como una\nrival a Shizuku?",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000644",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Debería asumir que las dos se llevan muy bien, ¡¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=0,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000372",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, yo quiero mucho a Rin.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015i",head="yum_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000645",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kyun.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004j",head="yum_z1b",x=0,lv=4,id=9},
{"fgact",ch="優美",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",my=40,mode=-1,lv=4,id=9},
{"se",file="se2766",id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000646",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Ahh... ¡La combinación de Rin-senpai y Shizuku-san! Esto es genial, es\nincreíblemente buenooo, ¡buhaa!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="里奈",size="z1",mx=-40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0110",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000302",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwah... ¿Tanta fue la excitación que hasta te salió sangre de la nariz? No\npodía esperar menos de esa cabeza tan yuri.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",my=40,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004i",head="yum_z1b",x=345,lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000647",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“L-Lo siento demasiado. Mi excitación superó su nivel crítico ante semejante\nencantadora y hermosa parejita.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000303",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, realmente solo tienes yuri en tu cabeza.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000649",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, no hacen falta los hombres. Debería caer un retrovirus sobre el planeta que\ninfecte solo a los hombres para que se extingan por completo.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Qué deseo tan agresivamente peligroso.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000650",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“O no, más bien yo misma me dedicaré a crear ese retrovirus en el futuro.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0006",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000304",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque provocarás que la humanidad se extinga.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"No era un deseo peligroso, era un objetivo peligroso.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",file="bgm004"},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000651",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jum, recobrando un poco la calma y retornando al tema de los trajes de baño,\n¿no les gustaría probárselos ya?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000305",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... No inspira nada de confianza que te calmes de repente tras el frenesí\ntan anormal que acabas de tener...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000652",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No tengo ninguna intención oculta. ¡Si es por eso, entonces yo seré la primera\nen cambiarme!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"se",id=1,file="se1641"},
{"fg",ch="優美",mx=40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Al decir eso, Kawachino cerró de un golpe la cortina del vestidor.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000306",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi realmente eligió su traje de baño al azar...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001335",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, no hay ningún problema. ¿Por qué no nos cambiamos nosotras también?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000907",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, sería buena idea.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"se",id=1,file="se1641"},
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mx=40,mode=3,path=":fg/yum/z1/",file="yum_z1b0800",face="b0003",head="yum_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0004",head="yum_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000653",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Misakura-senpai, ¿vas a probarte tu traje de baño?! ¡Ya tengo preparada la\ncámara del celular!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000307",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Qué rápida!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001336",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué tan rápida eres cambiándote?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0002",head="yum_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000654",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues mi objetivo es capturarlas a todas en traje de baño con la cámara de mi\ncelular.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000908",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No, espera, realmente no te entiendo muy bien... Yuumi-chan.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2b0810",face="b0001",head="yum_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000655",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y bien, Kusanagi-senpai, ¿qué clase de trajes de baño te gustan?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué me preguntas a mí de repente?...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0002",head="yum_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000656",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya le di mi opinión a todas, así que queremos escuchar ahora la opinión de\nnuestro peligrosamente ero-contaminado Kusanagi-senpai. Además, en principio\nse supone que era eso lo que haríamos.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm, pues sí...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé, la verdad, pero te ves bastante linda en traje de baño, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0017i",head="yum_z2b",lv=5,id=6},
{"fgact",ch="優美",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000657",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"se",id=1,file="se1641"},
{"fg",ch="優美",mx=40,mode=-1,lv=5,id=6},
{"text"},
text={
ja={
{
"Kawachino cierra las cortinas.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_000658",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Pero qué estás diciendo?! ¡No tienes por qué fijarte en mí! ¡O más bien, no\nme veas!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? Pero de verdad tienes buena figura, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_yum_000659",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Cállate. Cierra la boca, acosador-senpai.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-570,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000308",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Vas a decir eso tú?...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001337",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, vamos, primero a cambiarnos. ¡Vayamos a cambiarnos ya!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=570,lv=4,id=4},
{"fgact",ch="雫",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000373",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, vayamos.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"se",id=1,file="se1641"},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x2=-570,x=-680,lv=4,id=3},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x2=0,x=-210,lv=4,id=9},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x2=570,x=210,lv=4,id=4},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0810",face="b0004",head="yum_z1b",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0022",head="yum_z1b",x=680,lv=4,id=2},
{"fgact",ch="優美",act="うなづく",lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_yum_000660",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Shizuku-san, ¿tú también?! ¡Qué error de cálculo tan inesperado pero alegr--,\nbuhaa!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=210,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000374",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Algo te está saliendo de la nariz. ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0003",head="yum_z1b",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000661",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esto es el sudor del corazón, no te preocupes. Vamos, pueden ir a cambiarse\ntodas. Pueden ponerse todas en traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Ese sudor era muy rojo como para ser verdaderamente sudor...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bg017a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0003",head="yum_z1b",x=-345,lv=4,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
vo={
{"vo",file="fem_yum_000662",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rin-senpai, ¿aún no~? Ya estás lista, ¿verdad~?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000909",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm, esto...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000663",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Voy a abrir~”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000910",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Wah! ¡Wahwah! ¡Espera un momento!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",id=1,file="se1641"},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0014",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000664",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero si ya terminaste de cambiarte.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000911",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues sí, pero... Pero es muy cruel que abras de repente la cortina...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2b0810",face="b0002",head="yum_z2b",x=-345,lv=5,id=5},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0810",face="a0013",head="rin_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000665",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y bien, ¿qué tal, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, no sé qué responder a esa pregunta...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",mode=3,path=":fg/rin/z2/",file="rin_z2a0800",face="a0011",head="rin_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000912",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, no creo que sea realmente necesario que me veas de tan cerca...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente no tenía esa intención...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0016",head="yum_z2b",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000666",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y? ¿Qué opinas?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no está nada mal este look deportivo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0018",head="yum_z2b",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000667",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... Pensé que Rin-senpai elegiría algo más femenino y lindo, pero esto no\nestá nada, nada mal.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Tiene razón, tenía en mente una imagen de un traje de baño más suelto y con\nvolantes...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0003",head="yum_z2b",x=-345,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0004",head="yum_z2b",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000668",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y bien, Rina, ¿ya? ¿Qué hay de ti, Rina?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"se",id=1,file="se1641"},
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0001",head="shz_z1b",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000375",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué tal así?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000669",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Buh-- Shizuku-san me tomó de sorpresa con su traje de babababa--”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0001",head="shz_z1b",x2=0,x=-345,lv=4,id=4},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0013",head="mak_z1d",x=345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001338",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estás bien? Has estado desde hace rato con la sangre saliendo por la nariz.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_000670",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya, vaya, Toritani-senpai, tienes unos enormes melones, como era de\nesperarse. Ahh, colirio, colirio para mis ojos. *kasha*, *kasha*.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"se",id=1,file="se2893r"},
{"flash",time=750,alpha=255,loop=2,color="ffffff"},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0810",face="d0006",head="mak_z1d",x=345,lv=4,id=10},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001339",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Eh, por qué me estás fotografiando?!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_yum_000671",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Son de recuerdo, de recuerdo. No hay ningún problema. ¡Solo serán para mí!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0007",head="mak_z1d",x=345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0005",head="mak_z1d",x=345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_001340",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Por supuesto que sí! ¡Espera, aun así no voy a permitir que te las quedes solo\npara ti, Yuumi! Dame eso.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000672",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No quiero!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0002",head="shz_z1b",x=-345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000376",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, ¿qué tal me veo yo, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Ouh...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0016",head="shz_z1b",x=-345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000377",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te están bailando los ojos.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? O-Oouh...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Aunque me diga eso, no puedo verla directamente.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0016",head="shz_z1b",x2=-345,x=-680,lv=4,id=4},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0810",face="b0001",head="yum_z1b",x=-210,lv=4,id=1},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0800",face="a0001",head="rin_z1a",x=210,lv=4,id=8},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0005",head="mak_z1d",x2=345,x=680,lv=4,id=10},
{"text"},
text={
ja={
{
"No solo a Shizuku, tampoco a Kawachino, ni a Rin o Toritani. Con este\nespectáculo de trajes de baño frente a mí, comienzo a sentirme cada vez más\nangustiado respecto a mis partes bajas.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"No va a resultar nada bueno si mis partes inferiores reaccionan en este lugar.\nTerminaré como un verdadero cerdo acosador.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Mis respuestas se van volviendo cada vez más cortas y vagas.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="雫",mode=-1,lv=4,id=4},
{"fg",ch="真琴",mode=-1,lv=4,id=10},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0001",head="yum_z1b",x2=-210,x=-345,lv=4,id=1},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0001",head="rin_z1a",x2=210,x=345,lv=4,id=8},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0016",head="yum_z1b",x=-345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000673",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué sucede? Has estado muy pendiente de la parte inferior de tu cuerpo desde\nhace un rato...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0004",head="yum_z1b",x=-345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000674",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque bueno, es natural que te suceda eso de estar rodeado de tantas chicas\nlindas en traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0003",head="yum_z1b",x=-345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000675",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué lastimoso es ser hombre en estos momentos, ¿no? ¡Se nota a leguas que estás\nexcitado! ¡Y por más que yo las vea, no tengo ningún inconveniente! *kasha*\n*kasha*.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",id=1,file="se2893r"},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",x=345,lv=4,id=8},
{"fgact",ch="優美",act="うんうん",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000913",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No nos tomes fotos mientras te pones a decir *kashakasha*, por favor.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"se",id=1,file="se2893r"},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0001",head="yum_z1b",x=-345,lv=4,id=1},
{"fgact",ch="優美",act="うんうん",lv=4,id=1},
{"text"},
text={
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"se",stop=1,time=500,id=1},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0014",head="rin_z1a",x=345,lv=4,id=8},
{"fgact",ch="稟",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000914",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Da más miedo cuando lo haces en silencio!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_rna_000309",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ehmmm.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rna_000310",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eih.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",id=1,file="se1641"},
{"text"},
text={
ja={
{
"Se escucha el sonido de otra cortina abriéndose.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="里奈",size="z1",mx=40,mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0001",head="rna_z1b",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000677",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Mi preferida, la que esperaba! Ha venido Rina~”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“H-Hikawa...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0004",head="rna_z1b",lv=4,id=3},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000311",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué te parece? Kusanagi onii-chan♪”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera! ¡¿Después de tanto tiempo vas a volver ahora a tu autoproclamado papel\nde hermanita?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0011",head="rna_z1b",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0004",head="rna_z1b",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000312",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, es que si no digo esto me daría mucha pena... Ajaja.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001341",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uwaah... Desde hace un tiempo se me hacían grandes, pero... Rina, realmente\ntienes los pechos gigantescos.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0012",head="rna_z1b",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000313",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? Sinceramente nunca me he fijado tanto en ellos...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0012",head="rna_z1b",x2=0,x=-345,lv=4,id=3},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000378",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te ves muy linda.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0003",head="rna_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000314",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0800",face="b0004",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000379",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dame tus pechos.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0013",head="rna_z1b",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0004",head="rna_z1b",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000315",ch="rna"},
},
ja={
{
name={"Rina"},
"“C-Creo q-que eso es imposible...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="雫",mode=-1,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0001",head="yum_z1b",x=345,lv=4,id=1},
{"fgact",ch="優美",act="うんうん",lv=4,id=1},
{"se",id=1,file="se2893r"},
{"text"},
text={
ja={
{
name={"Yuumi"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0017",head="rna_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000316",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwah~ ¡¿Qué haces tomándome fotos sin decir ni una sola palabra?!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0003",head="yum_z1b",x=345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000679",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quédate tranquila, Rina. Haré de estas fotos mi tesoro.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0006",head="rna_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000317",ch="rna"},
},
ja={
{
name={"Rina"},
"“No entiendo nada~ ¿Por qué vas a atesorar mis fotos?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0004",head="yum_z1b",x=345,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000680",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes, dicen por ahí que cada persona tiene su propio tesoro\ndistinto. Si te preocupas, pierdes.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0015",head="rna_z1b",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000318",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues prefiero perder entonces.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0018",head="yum_z1b",x=345,lv=4,id=1},
{"fgact",ch="優美",act="おじぎ",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0002",head="yum_z1b",x=345,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000681",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuu... ¿Qué opinión tienes desde tu punto de vista, Kusanagi-senpai? A mi\nparecer, Shizuku es hermosa, Rin-senpai es linda, Toritani-senpai es pechuga.\nY la mejor es Rina.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0015",head="rna_z1b",x2=-345,x=-570,lv=4,id=3},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0002",head="yum_z1b",x2=345,x=0,lv=4,id=1},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1b0800",face="b0005",head="mak_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001342",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Decir que yo solo soy pechos es muy vulgar de tu parte, Yuumi. Además, Rina los\ntiene más grandes que yo, probablemente.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0004",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0810",face="b0002",head="rna_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000319",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, ¿de verdad? No suelen decirme eso así que me siento algo feliz. Aunque\nno puedo llevar un traje de baño tan expuesto como este...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0800",face="a0012",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001343",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Por qué? ¿Es que eres un caso de muchacha extremadamente penosa?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0003",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000320",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no es eso, solo que por una enfermedad que sufro... no me hacen muy bien\nlos rayos del sol.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0800",face="a0008",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001344",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0002",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000321",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que si llegamos a ir a la playa, tendré que llevar algo que oculte más mi\npiel o de lo contrario no podré salir del parasol.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2b0810",face="b0001",head="yum_z2b",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000682",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque por otro lado, Kusanagi-senpai, estás apartando tu mirada cada vez más,\n¿eh?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Da igual, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0016",head="yum_z2b",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000683",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero qué difícil ser hombre, ¿no? Todos tienen algo que se les hincha de manera\nfísica. No son ni capaces ni tan hábiles de hacerse una erección mental.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos se supone que es una erección mental?...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0800",face="b0016",head="yum_z2b",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000684",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh, ¿es que acaso no lo puedes ver? ¡Es claro que aún no eres un experto\ndepravado cuando aún no puedes ver tu pene mental!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No entiendo nada de lo que dices!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0800",face="b0006",head="yum_z2b",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000685",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Quiero decir que si eres un depravado, entonces mastúrbate con tu pene mental!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy entendiendo cada vez menos.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Se supone que pasaría un rato de felicidad estando rodeado de chicas en traje\nde baño, pero ahora que de verdad sucedió, la realidad es otra.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"A final de cuentas, de comienzo a fin me sentí bastante avergonzado.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oigan... ¿Podemos irnos ya?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me siento muy cómodo estando en el rincón de trajes de baño para mujeres...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2b0810",face="b0004",head="yum_z2b",lv=5,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000686",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué estás diciendo?! ¡Ahora es que viene lo bueno!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_snd_000001",ch="snd"},
},
ja={
{
name={"???"},
"“Ehm... Onee-sama. ¿Qué haces formando semejante escándalo en este lugar vestida\nen traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0810",face="b0013",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000687",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¡Esta voz!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=500},
{"fg",ch="鈴菜",size="z1",sync=1,mx=40,mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1i0000",face="i0005",head="suz_z1i",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000688",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Suzuna, ¿por qué estás acá?!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000002",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Me trajeron hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_000689",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_000968",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al fin llegaste, Kei... Qué alivio.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rld_000001",ch="rld"},
},
ja={
{
name={"???"},
"“Howaaa, Kusanagi-chan, tiempo sin verte~”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="ルリヲ",size="z1",mx=40,mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=-570,lv=4,id=3},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, ehm, hermanita de Hikawa. Tiempo sin vernos.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0015",head="rur_z1i",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000002",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Podrías dejar de llamarme hermanita de Hikawa? Ruriwo tiene su nombre y es\nRuriwo.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_000969",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me encontré a mitad de camino con la hermanita de Hikawa, y dijo que vendría\ntambién, así que me vine caminando a mitad de trayecto.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001345",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que tardaste tanto.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_000970",ch="ked"},
},
ja={
{
name={"Kei"},
"“No podíamos montarnos los tres en la motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rna_000322",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ruriwo-san, ¿por qué viniste?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=-570,lv=4,id=3},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000003",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Me dieron ganas de ver la cara de Kusanagi-chan después de tanto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0004",head="suz_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000003",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ruriwo-san, es muy descortés de tu parte que prosigas la conversación sin\npresentarte ante todos primero.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0014",head="rur_z1i",x=-570,lv=4,id=3},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rld_000004",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, sí. Hola a todos, soy Ruriwo Hikawa~”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rld_000005",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Hoy vine a ver a Kusanagi-chan!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0800",face="a0001",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001346",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Incluso con las niñas eres popular, eh... Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no precisamente popular, simplemente nos conocíamos ya.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000004",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ya veo, así que este es el tan rumorado Kusanagi-sama...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0001",head="mak_z1d",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001347",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ehm, ¿esta es?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0003",head="suz_z1i",lv=4,id=9},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000005",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Disculpen mi tardanza para presentarme, es un gusto conocerlos. Me llamo Suzuna\nKawachino. Les agradezco por cuidar siempre de mi hermana.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"La muchacha bajó la cabeza rápidamente en señal de reverencia.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0013",head="mak_z1d",x=570,lv=4,id=4},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000915",ch="rnd"},
{"vo",file="fem_mkd_001348",ch="mkd"},
},
ja={
{
name={"Rin, Makoto y Naoya"},
"“Ehhh~”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0012",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000916",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eres la hermanita de Yuumi-chan?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0003",head="suz_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_snd_000006",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000917",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, de cierta manera...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0800",face="d0009",head="mak_z1d",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001349",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás sea un poco descortés que diga esto, pero...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes dos, como hermanas, tienen personalidades completamente opuestas, eh...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0005",head="yum_z1b",x=-210,lv=4,id=7},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_yum_000690",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A qué te refieres con eso?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, es que...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0009",head="suz_z1i",x=210,lv=4,id=8},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0008",head="suz_z1i",x=210,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_snd_000007",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Fuh, comparado a hace unos años, es justo decir que se comporta con más\ntranquilidad y educación ahora...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0800",face="b0006",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_000691",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Suzuna!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0010",head="suz_z1i",x=210,lv=4,id=8},
{"fgact",ch="鈴菜",act="うんうん",time=150,lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0005",head="suz_z1i",x=210,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_snd_000008",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, está bien, me callaré. Pero, onee-sama, te pido que dejes de alborotar la\ntienda vestida en traje de baño. Como tu hermana menor, se me hace algo\nvergonzoso.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0002",head="rna_z1b",x=-680,lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_rna_000323",ch="rna"},
},
ja={
{
name={"Rina"},
"“Suzuna-chan, sigues pareciendo la mamá de Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que no solo Hikawa sino que también Kawachino tiene una hermanita...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=680,lv=4,id=10},
{"fgact",ch="ルリヲ",act="びっくり",time=150,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000006",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Cierto! Rina onee-chan, si vas a comprar un traje de baño entonces Ruriwo\ntambién quiere uno.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0008",head="rna_z1b",x=-680,lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_rna_000324",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eh~, Ruriwo-san, aún te sirve el traje de baño reglamentario del colegio.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0004",head="rur_z1i",x=680,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000007",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“No quiero.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_snd_000009",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“De comprarlo con sus propios ahorros entonces no hay ningún problema, ¿no es\nasí?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0015",head="rna_z1b",x=-680,lv=4,id=16},
{"fgact",ch="里奈",act="いいえ",lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_rna_000325",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, espera, Suzuna-chan. Esta niña no es como tú. Siempre que recibe algo de\ndinero se lo gasta en golosinas, no hay forma de que tenga para comprar eso.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0003",head="suz_z1i",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_snd_000010",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Si a eso se debe, entonces no hay nada de qué preocuparse. He procurado que\nRurio-san también ahorre.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=680,lv=4,id=10},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000008",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es. ¡Ruriwo ha ahorrado mucho, mucho!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0013",head="rna_z1b",x=-680,lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0004",head="rna_z1b",x=-680,lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_rna_000326",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡E-Eso es increíble! ¡También has estado cuidando de Ruriwo! ¡Suzuna-chan,\nrealmente pareces una madre!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0015",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_000692",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rayos, esta niña realmente salió demasiado perfecta...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0006",head="suz_z1i",x=210,lv=4,id=8},
{"fgact",ch="鈴菜",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_snd_000011",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Pero qué estás diciendo, onee-sama? Yo me siento orgullosa de ti.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0008",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_yum_000693",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso no lo sé... Para ti solo soy una hermana buena para nada...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0005",head="suz_z1i",x=210,lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=210,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_snd_000012",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Qué estás diciendo?... Es verdad lo que digo, ¿no, Hikawa onee-sama?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0012",head="rna_z1b",x=-680,lv=4,id=16},
{"fgact",ch="里奈",act="びっくり",lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0011",head="rna_z1b",x=-680,lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_rna_000327",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? P-Pues, sí, supongo...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0003",head="yum_z1b",x=-210,lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0810",face="b0004",head="yum_z1b",x=-210,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_yum_000694",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿De verdad? ¡¿Rina, te sientes orgullosa de mí también?! ¡Dilo otra vez~,\npor favor~!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0800",face="b0015",head="rna_z1b",x=-680,lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_rna_000328",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwa~, por esto es que no quería decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0003",head="suz_z1i",x=210,lv=4,id=8},
{"fgact",ch="鈴菜",act="うんうん",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_snd_000013",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Jaja... ¿Podemos ir a elegir nuestros trajes de baño nosotras también?”",
{"rt2"},
},
},
},
linkback="block_00175",
