},
block_00177={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=680,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rld_000009",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Esto~, entonces~, Kusanagi-chan, elige tú también el traje de baño de Ruriwo~”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, de verdad no estoy eligiéndole el traje de baño a todas!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=210,lv=4,id=8},
