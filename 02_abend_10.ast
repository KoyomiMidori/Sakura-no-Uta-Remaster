{"text"},
text={
vo={
{"vo",file="fem_snd_000014",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Vamos, cálmense. Bien, ¿será que yo también compro algo?...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=680,lv=4,id=10},
{"fgact",ch="ルリヲ",act="ジャンプ",lv=4,id=10},
{"text"},
text={
