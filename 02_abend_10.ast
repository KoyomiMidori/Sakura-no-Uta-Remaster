},
ja={
{
name={"Ruriwo"},
"“¡¿Tú también, Suzuna?! ¡¿De verdad?! ¡Compremos unos corte alto!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0003",head="suz_z1i",x=210,lv=4,id=8},
{"text"},
