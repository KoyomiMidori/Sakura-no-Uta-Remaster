astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c02_01",path=":ev/ev_eye_c02/",set="ev_eye_c02"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Ya lo sabía desde hace un buen rato, pero una vez más me doy cuenta de esa\nrealidad.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Todos los residentes de la casa Natsume son débiles a las mañanas.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",file="se9010",id=1},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0700",face="e0022",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000273",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah... Buenos días, Kusanagi... Qué mañanerooo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es tan temprano tampoco.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0023",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0024",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000274",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad~? ¿No es tan temprano~? Mm~, tal vez tengas razón~ Je~y, Kei～,\nlevántate~”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0022",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0024",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000275",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi vino a buscarte desde temprano~ Se tomó la molestia de venir a\nbuscarte, y hasta se metió a la casa para preparar el desayuno~”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, estás completamente atolondrada por el sueño...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai... Nadie vino a buscar a nadie, ni tampoco entré a la casa sin permiso a\npreparar la comida.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llevo más o menos 1 semana viviendo acá gracias a que así lo dispusiste.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0022",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000276",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Fueh? ¿Viviendo aquí?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Llevo alrededor de 1 semana como huésped en esta casa.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a cambio de eso, todos los días preparo el desayuno.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y así son las cosas, así que vete a la sala. Me interrumpes teniéndote en la\ncocina. Y ya casi está listo el desayuno.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0025",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000277",ch="aid"},
},
ja={
{
name={"Ai"},
"“No digas que te interrumpo, eso me pone tristeee...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",id=1,file="se2766"},
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡Eh! ¡Ai!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_aid_000278",ch="aid"},
},
ja={
{
name={"Ai"},
"“ZZZZZZZZZ...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, me asustaste...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai... No va al caso, pero si te duermes en ese lugar vas a agarrar un\nresfriado.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, creo que debería ir ya despertándolos uno por uno...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bgm",stop=1,time=5000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que iré a despertar primero al idiota más complicado...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg006a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
{"bgm",file="bgm007"},
{"fgact",ch="圭",act="いいえ",time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000570",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Ehh? ¿Eh? Pero si es Naoya. ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pasa nada. Levántate ya.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0008",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000571",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm~? ¿Eh~? ¿Hoy teníamos planes para ir a pasar el rato en algún lugar~?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay absolutamente ningún plan de salir a ningún lado.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy es un día completamente normal de semana. Así que levántate ya.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0009",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000572",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm~? ¿Día de semana? ¿Qué rayos?...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, te lo repetiré una vez más. Imbécil, tienes que ir al colegio. ¡Deja de\nflotar por las nubes y cámbiate ya!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000573",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué estás hablando con ese tono tan aterrador~? Qué miedo das, ahh.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios, si sigues parado ahí como un tonto, vas a llegar tarde.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000574",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Llegar tarde~?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, llegarás tarde.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000575",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué dices?! ¡Mi motocicleta es como el viento! ¡No hay forma alguna de que\nllegue tarde!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja de complicar el asunto metiendo otro tema tan disparatado!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0005",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0006",head="kei_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0022",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000576",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Disparatado?! ¡Me estás insultando a mí y a mi motocicleta! ¡Por más que se\ntrate de ti, déjame hacerte saber que hay cosas que te puedo perdonar y otras\nque no! ¡Kyeeeee!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwaah, detente! ¡Suelta!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000577",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000578",ch="ked"},
},
ja={
{
name={"Kei"},
"“ZZZZZZZZZ...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡VAMOSSSS! ¡¡DESPIERTA!!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"se",id=1,file="se1793z"},
{"fg",mode=-2,sync=0},
{"bg",y=150,zoom=80,file="zbg006a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0700",face="a0021",head="kei_z2a",lv=5,id=9,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg006",y=150,act="いいえ",size=500,time=580,loop=-1},
{"fgact",ch="圭",act="いいえ",size=10,time=580,loop=-1,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000579",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaaaah... El mundo da vueltas...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Levántate! ¡Levántate! ¡Levántate!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0012",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="quake",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0021",head="kei_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000580",ch="ked"},
},
ja={
{
name={"Kei"},
"“Funyaahhhh... Naoya, si me mueves tanto, *upuh*, m-me vas a hacer sentir mal...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso no me incumbe a mí, idiota!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0020",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Así que ya despertaste. Quizás esté de más decírtelo, pero estás\ndesprendiendo un olor ácido, anda a tomar una ducha. Idiota.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0008",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000581",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... No digas eso. Es culpa tuya por andar moviéndome con tanta fuerza a\nplena mañana. Y tengo sueño...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún tienes sueño?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Ahora que lo pienso, ¿cómo es que les cuesta tanto a los Natsume levantarse en\nlas mañanas?",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"¿Cómo demonios hacían para despertarse cuando yo no estaba?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, veamos, tocino, tocino...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Huevos, huevos... listo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="fem_szd_000085",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ji~”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"se",file="se9030",id=1},
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0017",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000086",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jii~”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bgm",file="bgm031"},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0017",head="shz_z1b",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Waah! Ah, Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Al fijarme, Shizuku había entrado silenciosamente a la cocina, con su mismo\nandar lleno de gracia como siempre.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"A simple vista se ve normal, pero ella también es terriblemente débil a las\nmañanas. No puedo descuidarme.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿pudiste levantarte sin problemas?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000087",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nima~ Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Buenos días...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000088",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Huevos, eh. Estas friendo huevos, eh.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, huevos, estoy friendo huevos. ¿Qué sucede con eso?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000089",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Lo sabías?!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0003",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000090",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Los huevos contienen bastante vitamina D!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000091",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El pudín Futten usa muchos de esos huevos~”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás... presentando un comercial sola?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0016",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
},
vl02={
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000092",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“EN☆POCAS☆PALABRAS☆.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En pocas palabras?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0010",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000094",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“ZZZZZZZZZ...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, se durmió parada...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será que la gente de esta casa no puede quedarse tranquila sin tener que\nsoltar chistes a medio dormir?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, Shizuku. Oye, Shizuku, ¿me permites?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9032",id=1},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0007",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000095",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Hauu!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿despertaste?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000096",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo siento mucho. Me quedé medio dormida...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, realmente te quedaste esplendorosamente medio dormida.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0011",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000097",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo siento bastante.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no importa.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0005",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0006",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000098",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí importa. No es momento para andar medio dormidos. ¡Observa! ¡Mientras\nestamos acá!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mientras estamos acá?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000099",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Las cintas transportadoras no paran de moverse.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las cintas transportadoras?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0016",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",loop=-1,time=800,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000100",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así esss. Van y vienen, van y vienen... De allí nace el pudín Futten, y... van\ny vienen...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Quizás nazca allí, pero... obviamente no se quedan yendo y viniendo... Si fuera\nasí, el pudín se pudriría.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fgact",ch="雫",act="停止",lv=5,id=9},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0010",head="shz_z2b",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... ¿Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000102",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nima~”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no hace falta que sonrías, escucha...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",file="se9002",vol=20,id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Shizuku desapareció dentro de su habitación, envuelta en su pijama.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si está despierta o dormida. Fumuh, está realmente difícil saberlo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, si después de unos minutos no parece salir de su habitación, entraré a\ndespertarla...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún estando medio dormida entona las líneas de ese comercial...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justo cuando pensaba que realmente tenía un gran surtido de expresiones...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Desde que llegué a esta casa, jamás llegué a ver ningún tipo de emoción en sus\nexpresiones.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"¿Quizás debería denominarla como una muchacha extremadamente inexpresiva?",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"excall",label="flagon01",cond="g.rinclear==1&&g.makclear==1&&g.rnaclear==1"},
{"excall",label="flagoff01"},
{"text"},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"select",label="label01",exp="f.shz=f.shz+1",text="select"},
{"select",label="label02",text="select"},
{"select",name="select01_02_1",mode="sys"},
{"text"},
select={
ja={
"Se siente bien ver poder ver a Shizuku medio dormida.",
"La expresión que Shizuku tiene medio dormida es bastante jovial y animada.",
{"rt2"},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se siente bien ver poder ver a Shizuku medio dormida...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al verla medio dormida me siento de cierta manera aliviado...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"excall",label="join1"},
{"text"},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La expresión que Shizuku tiene medio dormida es bastante jovial y animada...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Aunque es bastante irónico que esa expresión tan animada venga de las líneas de\nun comercial...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"excall",label="join1"},
{"text"},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
