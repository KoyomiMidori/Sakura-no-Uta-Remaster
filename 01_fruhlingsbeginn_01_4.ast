astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bluesky_winter",id=9,lv=9,path=":cg/",sync=0},
{"extrans",rule=139,vague=40},
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
"Un largo tiempo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Las primeras clases después de terminar las vacaciones se sienten bastante\nlargas.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Pero poco a poco me voy acostumbrando a eso.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Con decirle a mi mente que debe rendirse y concentrarme en los estudios... El\nreceso del mediodía llega más rápido de lo que me esperaba.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"El receso de mediodía que he estado esperando tanto... O al menos debería ser\nasí, pero...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este panorama... realmente me irrita.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está repleto de gente...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"El receso del mediodía.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Los nuevos estudiantes compran con alegría los panes de la cantina, nueva para\nellos.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Sin embargo, esa proporción baja a medida que van avanzando de año.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Cuando lo comes te das cuenta de que es un simple pan. Realmente no es el tipo\nde comida por la cual se debería agolpar tanta gente para comprarlo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"A medida que uno sube de año, deja de esforzarse tanto para comprar algo acá.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Aun así, me mezclo con los nuevos estudiantes y visito la cantina.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"La comida de la cafetería es más barata que las tiendas afuera...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y lo barato es la ley.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Aún diciendo eso... no compro ningún pan.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Si es por comprar pan, entonces es preferible traerme unos bizcochos de corteza\nde pan y algo de ensalada.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Me hago mi camino apartando y empujando a los nuevos estudiantes y le pido mi\norden al viejo de la cantina.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Le hablo al viejo sentado al lado de la abarrotada cantina.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viejo, lo mismo de siempre.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_oys_000001",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Sí, esto, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Al ver por un momento de lado a su señora ocupada vendiendo, el viejo sacó una\nlata del fondo de la tienda.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe que lo moleste siempre...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_oys_000002",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Está bien, no importa. Toma.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto es...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_oys_000003",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Solo son 60 yenes por tu parte.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Habla en serio? ¡Pero si es una lata G7!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"El viejo me sonríe de manera pícara.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Increíble, es de 260 gramos. Solo en contenido tiene 200 gramos, es todo un\nproducto premium. Debe haberle costado conseguir esto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_oys_000004",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Un poco. Pero bueno, con esta cantidad todos podrán comer bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Lo que el viejo me dio fue una lata de yakitori Hotoi. Sabor con salsa de tare.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"La conocen como el rey de los yakitori enlatados.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Aun dentro de esa línea de productos, las latas G7 son una leyenda. Es 3 veces\nmás grande que las normales.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Por supuesto, no es del tipo de cosas que vendan en la cantina.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Y de hecho, no es el tipo de cosas que un estudiante pobre podría comer.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"El viejo las compra al mayor y me las vende a mí a un precio bastante módico.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Por supuesto, normalmente no debería recibir un trato tan especial.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Sin embargo, la relación que tenemos yo y este viejo no es nada normal.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_oys_000005",ch="oys"},
},
ja={
{
name={"Viejo"},
"(Bien, te dejo encargado de lo demás)",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"(Sí, no hay problema...)",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Nos comunicamos con los ojos.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Así funcionan las relaciones construidas en las sombras.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Es algo que no puede ser visto con los cristales del sentido común del mundo de\nla sociedad normal.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, vamos a preparar esto rápido.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1279"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000114",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Viniendo de nuevo?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Al abrir la puerta del salón de arte, Toritani estaba adentro.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"En el colegio esta mujer vive, por lo general, en la sala de arte. Hay que ver\nque ama bastante al club de arte...",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Aunque, ciertamente es un lugar bastante acogedor.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000115",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me digas que viniste a cocinar de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que adivinas, eh. No te preocupes, no voy a hacer nada que pueda causarte\nmolestias.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000116",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué estás diciendo? El hecho de que cocines ya me causa molestias. ¡El\nolor después de cocinar se queda en la sala!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El olor... Ah, claro, ahora que lo mencionas...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Rozo mi dedo ligeramente sobre el marco de las ventanas.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000117",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás haciendo?...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que veo que el salón de arte está tan limpio como siempre...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000118",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero qué de mal gusto fue eso. Pareces una suegra de la época Shouwa...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso. Simplemente que realmente entiendo por qué no quieres que deje\nolorosa la sala de arte que tanto te has esmerado en mantener limpia.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000119",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“T-Tampoco es que la mantengo tan cuidada...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, no pienso volver a dejar oliendo esta impecable sala de arte de nuevo.\nSolo necesito la cocina de gas de Wakata y 6 raciones del arroz que tiene\nguardado. Si tan solo me prestas eso puedo hacer lo demás afuera.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000120",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Afuera? Ahora que lo veo, hoy vienes por 6 raciones, eh. ¿No son 2 raciones\nmás de lo usual?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bien que te diste cuenta. El plato de hoy será de tamaño jumbo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Al decir eso, le muestro la lata G7 de yakitori.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000121",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je, es la primera vez que veo una lata de yakitori de esa forma...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es un producto exclusivo. Aunque, ¿por qué estás mostrando interés por mi\ncomida?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Toritani se quedó viendo la lata de yakitori que llevaba conmigo.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000122",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una lata de yakitori, eh... Hmm, ¡está bien!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo agradezco. ¡Bien, préstame los instrumentos para cocinar, por favor!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Toritani observa el reloj de la sala de arte, como si no hubiera escuchado mi\npedido.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000123",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás diciendo?... No tienes tiempo para ir a cocinar esto afuera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El tiempo se puede crear. ¡Aquellos que dicen que no tienen tiempo simplemente\nno saben administrarlo bien!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000124",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siento que lo que dices es cierto, pero solo las palabras que dices... Si\ntomamos en cuenta tu manera usual de actuar, no tienen nada de fiabilidad. A\nfinal de cuentas simplemente piensas llegar tarde a las clases de la tarde,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Si me sobra el tiempo no llegaré tarde!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000125",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De dónde sacas tanta confianza?... ¿No te estoy diciendo acaso que no te queda\ntiempo? No vas a llegar a tiempo si sales y te pones a cocinar afuera ahora.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000126",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, ya había previsto esto en gran parte... Así que iré directo al grano.\nTe autorizo para que cocines hoy en la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000127",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué viene la sorpresa? ¿Acaso no te acabo de decir que te autorizo para que\ncocines acá?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso sería perfecto, pero... Estás planeando algo, ¿no? No hay manera alguna de\nque digas algo así sin pedir nada a cambio.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000128",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Sin duda alguna, es imposible que lo haga de gratis.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que quieres entonces?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000129",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ejejen. Pues sí. ¡A cambio de usar la sala de arte para cocinar, quiero que me\ndes una ración a mí! Creo que esa es mi condición.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que te dé una ración? Esa condición es injusta.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000130",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo que es injusta? Hoy piensas cocinar más de lo normal, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, pero tenemos una regla implícita de que cuando se cocine más de lo\nnormal, se agrande la ración de cada uno. En fin, no voy a aceptar esa\ncondición tan injusta y arbitraria.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000131",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Injusta? Vaya forma de hablar que tienes después de que te la pasas todos los\ndías dejando la sala de arte oliendo a tare de yakitori, eh. Podría acusarte\ncon la dirección del colegio.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tienes razón, me disculparé por eso... No me había dado cuenta.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero de hacer eso eres tú la que quedaría mal. Pues uno de los involucrados en\neste plan es nada más ni nada menos que el supervisor del club de arte,\nWakata. En el peor de los casos es posible que el club de arte deba cerrar.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0010",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000132",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tch, lo sé... Por Dios... el profesor Wakata tiene demasiados puntos débiles, y\neso me es bastante problemático...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000133",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, era broma lo de acusarte con el colegio. Pero lo del trato es en serio.\nMe quedaré con una ración.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no puedo hacer mucho aun si me dices eso...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Mi trabajo fluye gracias al apoyo de un cierto grupo de cómplices.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Ninguno de los tres tiene dinero para actuar con libertad, y siempre tenemos\nhambre.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Uno de esos soportes es, de hecho, el supervisor de este club de arte, Seijiro\nWakata.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Él es el encargado de aportar el arroz y los instrumentos de cocina.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Mientras que es el viejo quien aporta los otros ingredientes.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Y yo me encargo de cocinar todo eso.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"En pocas palabras, no soy el único que puede decidir eso.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh, el plato de hoy es grande... Podría darte una ración.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000134",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, vaya, estás comprensivo ahora.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, no puedo dártelo de gratis. Eso sería un acto de traición contra\nlos otros.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000135",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te acabo de decir que será a cambio de dejarte usar la sala de arte?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El salón de arte no te pertenece. Ergo, no tengo deber ni responsabilidad\nalguna de pagarte por el lugar.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000136",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si es por pagar el lugar, estás ocupando mi territorio, así que sí tienes deber\nde pagarme, ¿no? No importa de quién sea la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Dices que no importa de quién sea la sala de arte pero exiges que te pague por\ntratarse de tu territorio! ¡¿Es que acaso eres de los Yakuza?!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000137",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, solo bromeaba. Eso te pasa por andar diciendo eso de 'pagar por el lugar'.\nY bien, ¿qué tal esto entonces?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0200",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"se",file="se1296",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Toritani sacó un contenedor de plástico de su bolso.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0022",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000138",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No está nada mal como tarifa de participación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Al abrir ese enorme contenedor plástico, adentro había...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0003",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000139",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Brotes de bambú. Crecen en esta época en el bosque de bambú que hay en la casa\nde mi familia.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Brotes de bambú... Se ven deliciosos, eh. Y pensar que tienes un bosque de\nbambú en el jardín de la casa de tu familia. ¿Es que acaso tu familia es en\nrealidad millonaria?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0016",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000140",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé cómo están las cosas allá, pero juzgando por la manera de actuar que\ntengo siempre, ¿podrías aun así afirmar que tengo dinero?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente... Pero dicen que mientras más adineradas las personas, más tacañas\nson.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0017",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0003",head="mak_z2b",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000141",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No llames tacaño a los demás, hay que ver que eres bien descortés, eh. En fin,\n¿qué tal? Es suficiente con estos brotes de bambú, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Brotes de bambú, eh...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que ya están cocinados, se podrían usar en cualquier momento...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0004",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000142",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son brotes de bambú moso de este año. Están justo en temporada, son deliciosos.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jum, ciertamente, estamos en la época de los brotes de bambú... Y sin duda\nalguna, parecen ser de muy buena calidad... Umumuh...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0016",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000143",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No va al caso, pero creo que no te queda mucho tiempo para pensar al respecto,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo mencionas...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Tal como dijo ella, no tengo mucha holgura en el tiempo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0002",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0003",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000144",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Veo que tienes una lata de yakitori más grande que las de siempre, pero aun así\nel sabor es el mismo, ¿no? ¿No crees entonces que estos buenos brotes harían\nun buen complemento?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0016",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000145",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es mala condición, ¿no? Vamos, decídete rápido.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Su expresión era de como si lo hubiera adivinado todo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Me irritó un poco esa cara, pero es difícil rechazar el encanto de los brotes\nde bambú.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Los brotes recién cosechados en primavera deben ser deliciosos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Es tal como Toritani lo dice.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Al tener frente a mí esos brotes de bambú, el arroz con yakitori de siempre se\nme hace algo ordinario y sencillo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Si es por tener estos brotes de tan buena calidad, seguramente los otros dos\ntambién estarán de acuerdo.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Está bien, en fin, no hay tiempo! Toritani, corta los brotes en pedazos\npequeños con esa tijera.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000146",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Con tijera? ¿Qué hay del cuchillo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que tenemos algo así acá? Córtalos rápido.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",loop=1,id=1,file="se9054"},
{"text"},
text={
ja={
{
"Lavo el arroz. Esta vez uso una cantidad para 6 raciones, más de lo normal.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toritani, la olla de arroz!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",size="z1",mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0009",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000147",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Qué explotador eres, aún no he terminado de cortar los brotes así que espérate\nun momento! Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani prepara la olla de arroz.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Y mientras tanto, yo preparo la cocina.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Vierto en la olla el arroz y la cantidad adecuada de agua.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Echo encima de eso los brotes de bambú que Toritani cortó... y encima de todo,\nel yakitori con sabor a tare. Volteo la lata y vierto desordenadamente todo\nel contenido adentro.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000148",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque es sorprendente que hagas el arroz en olla, eh...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es fácil cuando te acostumbras. Además, el arroz preparado en olla sabe mucho\nmejor. La intensidad del fuego es distinta al usar gas que al usar\nelectricidad.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000149",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso escucho con frecuencia, ¿pero es verdad que sabe mejor preparándolo en olla\ncon gas que en arrocera eléctrica?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, incluso el arroz normal agarra un sabor al nivel del arroz Koshihikari.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000150",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No debería ser tan diferente, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, opina después de que lo pruebes. Bien, voy a ponerlo a hervir de una vez.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000151",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cuánto tarda para comenzar a hervir?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo general 5 minutos. Aunque hoy hay más de lo usual, así que\nsobreestimando, diría que 7 minutos...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1185"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"La tapa de la olla comienza a saltar. Es el sonido de que el vapor la está\nhaciendo subir.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya casi está...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Ajusto ligeramente el fuego, de manera que la tapa no se suba, pero que siga\nsaltando un poco.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Y encima de eso, coloco un jarrón de aceite como peso.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000152",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ese jarrón de aceite... ¿Lo has estado usando para eso?...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ¿esto? Tiene mala fama de ser muy pesado y tener un diseño muy intrincado,\npero es perfecto como peso para cocinar arroz.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Con jarrón de aceite me refiero al contenedor donde se echa el aceite diluyente\npara pintar con óleo.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Debido a que por lo general se colocan al lado de las paletas, los fabrican con\naluminio ligero, pero este jarrón está hecho de latón, y además es\nterriblemente grueso.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000153",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente... Es tan pesado que cualquiera pensaría que es un jarrón de aceite\npara hacer ejercicio.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, originalmente tenían ese propósito...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000154",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, solo hablaba solo.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Y mientras hablábamos de eso, dejó de salir casi vapor de la tapa. Es la prueba\nde que ya no queda casi agua adentro.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Bajo aún más el fuego. Si lo dejo cocinando en fuego alto, terminará muy\nquemado.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000155",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás bien acostumbrado a esto, eh...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, una de las pocas cosas que sé hacer bien es preparar comidas baratas.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000156",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una de las pocas cosas que sabes hacer, eh... Si los pintores de Japón llegaran\na escuchar esas palabras, tratarían de matarte de verdad, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es ridículo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000157",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es totalmente factible.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, oh, no es momento de andar hablando tonterías.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"El instante en el cual ya ha desaparecido casi toda la humedad.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Pongo el fuego al máximo por un momento, y luego lo apago por completo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Poner el fuego al máximo al final sirve para convertir la humedad remanente en\nvapor.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000158",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ya está listo?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, no lo toques. Falta dejar que se cocine con el vapor ahora. Faltan más\no menos 10 minutos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000159",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“10 minutos... ¿No te parece que no quedará tiempo para comer entonces?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y por eso llegaremos tarde.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0013",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000160",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa? ¿Qué estás diciendo? ¡Y-Yo no tengo intención alguna de llegar tarde a\nclases!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces no vas a comer? Qué pena, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000161",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Claro que no!! ¡Ah, cierto! ¡Mételo en este contenedor!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Toritani sacó el contenedor de hace rato donde había guardado los brotes de\nbambú.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, ¿pero es que piensas comer después como lo hacen los otros dos?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Con los otros dos me refiero, obviamente, a Wakata y al viejo de la cantina.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Wakata suele comer al momento, pero el viejo no puede venir acá sino hasta\ndespués del receso del mediodía. Tiene que comer después de que culminen por\ncompleto las labores en la cantina.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0015",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0001",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000162",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo ganas de llegar tarde a clases tan despreocupadamente como lo haces\ntú. Toma esto.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Por qué me das dos contenedores plásticos?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000163",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uno es para ti.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, ¿qué estás diciendo? No necesito eso. Yo tengo mi propio bol de arroz.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0018",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000164",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Idiota! ¡Te prestaré uno de estos contenedores, así que meterás la comida acá\ny vendrás conmigo a clases! ¡Y cuando terminen las clases, comeremos!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? Déjalo así, no te preocupes por mí.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000165",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna manera. En primer lugar, ¿no te parece que hacer eso es un\ndespilfarro de la matrícula?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, quizás, pero...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000166",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa? ¡Yumihari es un colegio privado! La matrícula es mucho más alta que las\npúblicas.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón, pero...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000167",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, siempre te la pasas diciendo que no tienes dinero, pero a final de cuentas\neso es todo. ¿Será que realmente no eres tan pobre como para romperte la\ncabeza por la matrícula?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa ser tan pobre que deba incluso romperme la cabeza por la\nmatrícula?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000168",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ahh, cállate! ¡Me refiero a que a pesar de andar diciendo siempre 'pobre',\n'pobre', 'no tengo dinero', 'no tengo dinero', eres tan descuidado con el\ndinero! ¡Eres del típico tipo de personas que termina en la ruina!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con qué razón tienes que decirme esa clase de cosas...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000169",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo creer que a pesar de no tener dinero despilfarras la matrícula del\ncolegio. ¡La falta de planificación de los pobres es justamente la manera de\npensar de aquellos que terminan en el fondo!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Y mientras discutíamos esa clase de cosas inútiles, 10 minutos pasaron.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Ya pasó el tiempo necesario para dejarlo cocinando al vapor. Así que por fin,\nya está listo.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tata~n. Takikomi gohan con yakitori.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0200",face="a0017",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000170",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*traga saliva*... R-Realmente se ve bueno, eh...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que está bueno. Nosotros tres pasamos casi la mitad de la semana\ncomiendo estos takikomi gohan.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0015",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000171",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siento que les faltan muchos otros nutrientes necesarios...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero esta vez tenemos también brotes de bambú recién cosechados de primavera.\nNo solo es sabroso, sino que también debe aliviar un poco la falta de\nnutrientes.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0016",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000172",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No hay manera de aliviar la falta de nutrientes solo agregando brotes de\nbambú!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, eres una idiota, Toritani. Es un desperdicio no comer esto recién\ncocinado...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0011",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0008",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000173",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... ¿A-Así de rico sabe recién cocinado?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Fue cocinado en olla, obviamente que el mejor sabor lo tiene es\nrecién cocinado. Es tan bueno que es incomparable al sabor cuando está frío.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000174",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ven, dame el contenedor, voy a servirte allí. Cómelo con gusto en el próximo\nreceso.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0018",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0200",face="a0017",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000175",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh... E-Está bien, sírveme.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no tienes tiempo, ¿verdad? Te lo serviré todo en este contenedor, así que\npuedes disfrutar de tu arroz frío después.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Toritani me ve con una mirada penetrante.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Creo que se me fue la mano... La mirada de Toritani da algo de miedo.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Por ahora, sirvo la ración de Toritani en su contenedor plástico.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ya sonó la campana. Si no te apresuras y regresas ya al salón, llegarás\ntarde...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0017",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000176",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh... S-Solo un bocado...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Acaso escuché 'solo un bocado'?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"bg",file="ev_com_a15_01",path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000177",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿D-De qué te estás riendo?! Qué hombre tan desagradable eres. ¡Voy a probar un\nbocado antes de ir! ¿Algún problema?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, problema ninguno. Eso si puedes conformarte con SOLO un bocado, eh.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000178",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Por supuesto! ¡Es solo un bocado!... *come*... *mastica*... *mastica*...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué tal...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="ev_com_a15_02",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000179",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"La mano de Toritani que sostenía sus palillos estaba temblando.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Es perfectamente normal. Si después de hacerla tanto esperar come ahora un\nbocado de takikomi gohan recién hecho con yakitori... No podrá resistirse.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Seguramente está gritando esto en su mente ahora.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000180_mix",ch="mkd"},
},
ja={
{
name={"Makoto"},
"(Se me salen las lágrimasss... ¡Esto es criminal! ¡Está demasiado bueno!)",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000181_mix",ch="mkd"},
},
ja={
{
name={"Makoto"},
"(Está... entrando lentamente en mi cuerpo... ¡Si es por tener más de este\ntakikomi gohan con yakitori de Hotoi, haría lo que fuera, incluso robaría!)",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"No podrá resistirse.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Ante ese sabor...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Ante ese deseo...",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"cgdel",id=-1},
{"bg",file="ev_com_a15_03",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000182",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estarás pensando en cosas ridículas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"bg",file="ev_com_a15_04",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000183",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo para que lo sepas, soy aspirante al premio de asistencia perfecta. No\npuedo llegar tarde a clases solo por esto.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000184",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente está muy bueno, pero no es como para hacer de lado el premio de\nasistencia perfecta...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bg",file="ev_com_a15_01",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000185",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué pones esa cara tan extrañada? ¿Acaso no es obvio?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, es que a mí no me importa llegar tarde a clases con tal de comer este\nplato...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bg",file="ev_com_a15_05",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000186",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es por lo débil que eres de voluntad... No trates de ponerme en el mismo\nlugar que tú, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, eras aspirante al premio de asistencia perfecta. Eres\nbastante seria y diligente.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000187",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es que sea seria... Solo que no quiero despilfarrar el dinero... Solo en\nmatrícula pago 600000 yenes anualmente, y por cierto, al primer año te cobran\nuna tarifa adicional de 200000 yenes.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“600000 yenes al año... ¿Cuánto cuesta entonces una clase?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"bg",file="ev_com_a15_06",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000188",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, están los gastos de ingreso, junto a otros gastos más, así que no puedo\ndar un monto concreto, pero... Solo en matrícula, 500 yenes, creo.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“500 yenes... Es bastante caro.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"bg",file="ev_com_a15_01",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000189",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso deja de saltarte las clases. A pesar de andar siempre con el asunto del\ndinero, si sigues siendo tan despreocupado con eso, no lograrás ahorrar nada.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, ¿pero no te parece que este sabor no tiene precio? Vale mucho más que unos\n500 yenes, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_com_a15_03",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000190",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo sé. Me parecen más importantes las horas de clase, así que me v--”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bg",file="ev_com_a15_07",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000191",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Justo en el preciso instante en que trató de pararse, la campana que anunciaba\nel inicio de las clases sonó.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Creo que vas tarde... Toritani...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"bg",file="ev_com_a15_01",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000192",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Eso es porque te pusiste a extender tanto la charla con esos temas tan\nraros!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te apresuras podrías llegar aún. Por supuesto, son muy altas las\nposibilidades de que no lo logres...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"se",id=1,file="se2790"},
{"cgact",file="ev_com_a15_01",act="うなづく",lv=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000193",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Toritani, quien se había parado ya de su asiento, comenzó a acercarse con una\nterrorífica expresión en su cara.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Toritani puso una mano al aire.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"¡Me va a golpear!",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"O eso pensé, pero...",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"bg",file="ev_com_a15_04",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000194",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sírveme un poco más.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Con la mano que puso al aire agarró el contenedor plástico y lo extendió hacia\nmí.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"bg",file="ev_com_a15_01",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000195",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Llegaré tarde por culpa de tu parloteo, así que dame un poco más.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si no es solo por mi culpa... Pudiste simplemente haberme ignorado y\nhaberte ido al salón...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000196",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Si hubiera podido hacerlo lo hubiera hecho! ¡Pero no pude hacerlo y por eso\nestá sucediendo esto ahora! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Creo que se enojó.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Y además... Tú sí eres capaz de hacer por lo menos eso, ¿no?",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"En base a lo que conozco de ella, se supone que es un 'personaje' más\nindiferente a los que los demás le dicen.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"bg",file="ev_com_a15_04",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000197",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, comeré un poco más.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te sirves tanto te vas a sentir mal después... Por lo general siempre comes\npoco, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000198",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una clase vale 500 yenes. Si no cobro el monto equivalente sentiré que de\nverdad estoy despilfarrando el dinero.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_01_5"},
{"text"},
linkback="block_00268",
},
label = {
top={block="block_00000",label=1},
},
}
