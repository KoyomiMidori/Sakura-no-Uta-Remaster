astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohh, aquí está, lo encontré.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Logré desenterrar algo de acetona de mi propio apartamento.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Me había dado la impresión de que quedaba algo, pero aparte de ser un removedor\nmuy raramente usado, ya yo no pinto.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Originalmente no debí haber conseguido nada de ella, pero la persona que\narregló y organizó la casa hace medio año me hizo una libreta especificando\ntodo lo que había.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Parece que todos los disolventes orgánicos que habían en la casa habían sido\ncolocados juntos. Qué buen favor que me hicieron.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, qué alivio poder haberla conseguido. Con esto podré arreglar la pintura\nde Rin...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Observo el reloj.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Aún queda algo de tiempo para la hora de las clases suplementarias.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un poco temprano aún, pero qué más da...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",id=1,file="gatya"},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bgm",stop=1,time=500},
{"se",file="se1193",id=1,loop=1},
{"msgoff"},
{"bg",file="bg020a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Espero el elevador en el pasillo de mi piso.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Se pueden escuchar el sonido de las vigas.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Parece que hoy también están construyendo al lado...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"se",file="se0888f",id=2},
{"msgoff"},
{"bg",file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
"Al bajar el edificio se escucha de al lado aquel peculiar sonido de las\ntuberías metálicas puestas una sobre las otras, para armar los andamios.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hacen bastante ruido.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"No molesta tanto en los pisos más altos, pero por lo que puedo escuchar, las\npersonas que viven en los pisos de abajo deben estar pasando un mal rato...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La construcción...",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, había una mujer bien extraña en el sitio de construcción\nla otra vez.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Había dicho que la construcción hacía bastante ruido y que la detendría, o algo\nasí, creo...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Ciertamente, está bien ruidoso esto.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, no creo que esté hoy también, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",stop=1,id=1,time=500},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No puede ser...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"No puede ser que esté...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg027a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"extrans"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Sí está...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bgm",file="bgm031"},
{"fgact",ch="吹",act="びっくり",size=10,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000070",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tú eres...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de verdad no creí que estuvieras...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fgact",ch="吹",act="びっくり",size=30,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000071",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Eres, con toda certeza, un ocioso! ¡¿Cierto?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
"¡Eso es lo que se supone que debería decirte yo a ti!",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Quise replicarle eso, pero ciertamente, así como para mí Sui es 'una ociosa que\nvino de nuevo acá', yo también soy, para Sui, 'un ocioso que vino de nuevo\nacá'.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué haces tú aquí?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000072",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso no tiene importancia alguna...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Algo de importancia debería de tener el hecho que estés acá, ¿no?",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000073",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Y qué estás haciendo tú?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy en camino a resolver un asuntillo ridículo.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fgact",ch="吹",act="おじぎ",time=350,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000074",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Un asuntillo ridículo? Ciertamente, tu cara tiene un aspecto ridículo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hecho de que tenga una cara ridícula no tiene nada que ver con que tenga un\nasunto ridículo o no.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0017",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000075",ch="sud"},
},
ja={
{
name={"Sui"},
"“Solo bromeaba. ¿Es que ni de eso te puedes dar cuenta? En primer lugar, tu cara\nno es para nada ridícula. Diría más bien que estás favorecido de cara.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Por cosa extraña, esta vez ella dijo algo con sentido. Ciertamente, mi cara\ntiene buen aspecto.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000076",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Favorecido, sí, para espantar a las personas con ella!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo alguien va a estar favorecido con una cara de espanto?! ¡Pero qué\nabsurdamente descortés eres, eh!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000077",ch="sud"},
},
ja={
{
name={"Sui"},
"“Y bien, ¿qué es ese asuntillo?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues tal como ves, llevo el uniforme puesto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fgact",ch="吹",act="icon",y=-350,x=100,lv=4,id=9,icon="icon02z1"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000078",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué es un uniforme?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? Observa, ves a ese grupo de chicas caminando vestidas con\nuniforme, ¿no? Aunque bueno, son de otro colegio...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fgact",ch="吹",act="停止",lv=4,id=9},
{"fgact",ch="吹",act="びっくり",time=300,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000079",ch="sud"},
},
ja={
{
name={"Sui"},
"“Jaa, así que eso es un uniforme... Son bastante enigmáticos...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, ¿cómo va a ser misterioso un uniforme?...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000080",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Así te parece? Me parece curioso que todos lleven la misma ropa. ¿Será que\nestán de moda esos trajes llamados 'uniformes?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"¿Pero qué demonios está diciendo?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"¿Realmente no sabe lo que es un uniforme?...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"No, seguramente vendrá de nuevo con lo de 'era una broma'...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No conoces tampoco lo que es un uniforme?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000081",ch="sud"},
},
ja={
{
name={"Sui"},
"“P-Pero qué descortés, eh. Se relata que Sui es una autoridad en lo que ropa y\nlos trajes concierne.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"¿Se relata?... ¿Pero es que eres alguna criatura fantástica legendaria o algo\nasí?...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000082",ch="sud"},
},
ja={
{
name={"Sui"},
"“Espera solo un momento, por favor. ¡Procederé a sacar eso que llaman uniforme!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="吹",my=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sacar?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"se",id=1,file="se1296"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000083",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es esto, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Después de voltear y hacer algo de ruido, Sui se volvió e izó triunfante con\nsus manos un traje.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es eso. Quizás sí sea un uniforme, pero es uno de enfermera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0017i",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018i",head="sui_z1a",lv=4,id=9},
},
vl03={
{"fgact",ch="吹",act="うなづく",hoho="i",time=200,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005i",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000084",ch="sud"},
},
ja={
{
name={"Sui"},
"“Uhh... eso solo fue una pequeña finta. Simplemente buscaba probarte. Me\nsorprende que no cayeras en mi truco.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"La verdad es que no había manera de caer en eso...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que puedes sacarte un traje de la nada?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",time=150,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000085",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui lleva normalmente todos sus trajes a todas partes.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dices que a todas partes?... ¡Pero qué enorme esto!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Detrás de Sui apareció una maleta grande con ruedas, como la que llevaría\nalguien para viajar al extranjero.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces con esa maleta tan grande? ¿Es que te escapaste de casa?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018",head="sui_z1a",lv=4,id=9},
},
vl03={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000086",ch="sud"},
},
ja={
{
name={"Sui"},
"“Qué palabras tan groseras. ¡A mí me encanta mi casa! ¡Si pudiera hacerlo, me\nencantaría quedarme viviendo en mi casa por toda la vida!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No me gustaría de ninguna forma tener de hermana a una muchacha como esta...",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0000",face="a0003",head="sui_z2a",lv=5,id=9},
{"fg",ch="吹",my=40,mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0003",head="sui_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_sud_000087",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Este es el uniforme!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero uno de azafata, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0005",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0018",head="sui_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0006",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=9},
{"se",file="se3130",id=1},
},
},
text={
vo={
{"vo",file="fem_sud_000088",ch="sud"},
},
ja={
{
name={"Sui"},
"“Nununuh... Entonces... ¡Este es!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es un traje de maid...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué andas por allí con trajes de cosplay?...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Al ver todo esto, en lugar de ropa, sería más correcto que anda por allí\ncargando con trajes de cosplay.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0008",head="sui_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="ジャンプ",time=200,lv=5,id=9},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
},
},
text={
vo={
{"vo",file="fem_sud_000089",ch="sud"},
},
ja={
{
name={"Sui"},
"“Mm~, ¿es este?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Pensé que volvería a sacar otro traje extraño, pero esta vez sacó un uniforme\nnormal.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Y además, ese uniforme era...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que eras estudiante del colegio Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fgact",ch="吹",act="icon",y=-350,x=100,lv=4,id=9,icon="icon02z1"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000090",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Colegio... Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es así? ¿Por qué llevas entonces un uniforme de mi colegio? ¿Sí es para\nhacer cosplay?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fgact",ch="吹",act="停止",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
vl03={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000091",ch="sud"},
},
ja={
{
name={"Sui"},
"“Cosplay, cosplay, ya me tienes harta con eso. ¡Esta es una prenda de vestir, y\ncon todas las de la ley!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Si es por eso, los trajes de cosplay también son ropa...",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, si me quedo acá parado llegaré tarde, así que me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000092",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Llegar tarde?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000093",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es eso algo indebido?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente que lo es, llegar tarde es malo para cualquier persona.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000094",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo... entonces es necesario ir con prisa.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por eso es que me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0013",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000095",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Cómo se te ocurre dejarme acá?! Acabaré llegando tarde.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Tú también vas al colegio en verano?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000096",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ese no es el problema. Es indebido que llegue tarde, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no está bien, pero...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0006",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000097",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Entonces tenemos que apresurarnos!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes toda la razón, pero ¿tú también tienes algo que hacer en el colegio? Ir\nal club o alguna otra cosa...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000098",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No deberías cambiarte entonces? Si vas tarde deberías cambiarte rápido.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0017",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000099",ch="sud"},
},
ja={
{
name={"Sui"},
"“No esperaba menos de una bestia como tú. Así que piensas desnudarme y ejecutar\nmi cambio de ropa acá...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué se supone que debo encargarme de tu cambio de ropa?! No estoy\nentendiendo nada de lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000100",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, así que de eso se trata todo. En pocas palabras, mi cambio de ropa no\nse hará acá, ¿es así?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. ¡Además, es nada más asunto tuyo dónde te cambias! ¡Eso no me\nincumbe a mí! ¿Tu casa no queda por acá cerca, tras del hecho?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000101",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo... Así que todo lo concerniente a mi cambio de ropa será realizado\núnicamente a merced mía.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué estás diciendo? ¿En qué parte del mundo hay alguien que dejé en manos\nde extraños su cambio de ropa?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl03={
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0018",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000102",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ahora que lo dices, me da la sensación de que es así. ¡Sui se decidió entonces!\nMe cambiaré en tu casa.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué deberías?!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000103",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tu casa queda en este vecindario, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí es parte del vecindario, pero...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, tú también eres del vecindario, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000104",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo soy.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No eras del vecindario?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tuvo que suceder esto?...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Observo el reloj, irritado y ansioso.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y eso que salí con bastante ventaja de tiempo...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"La hora se va acercando, segundo tras segundo.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el peor de los casos, puedo ir caminando al colegio Yumihari desde mi casa,\npero...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Toma alrededor de 20 minutos ir caminando desde este edificio hasta el colegio\nYumihari.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Aún corriendo, es bien difícil llegar dentro de los 10 minutos.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Si no salgo con más de 10 minutos de ventaja, llegaré tarde con toda seguridad.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Ai, quien renunció a sus vacaciones para dar clases, me va a matar...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué rayos tengo que estar yo metido en este lío?...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Oye! ¡Sui!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_sud_000105",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Qué es lo que sucede?! ¡Estás haciendo mucho escándalo!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya estás lista? ¡De verdad vamos tarde!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_sud_000106",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Lista? ¿Está bien así?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"se",id=1,file="gatya"},
{"fg",ch="吹",size="z1",mx=40,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Sui aparece de la entrada de mi apartamento.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Siempre llevaba un enorme vestido con volantes ondeantes, así que en ese\nmomento no me había dado cuenta, pero tiene un cuerpo sorpresivamente\nesbelto.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Para ser francos, un cuerpo plano (sobre todo sus pechos).",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000107",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Has quedado cautivado con mi cuerpo vestido en uniforme?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... Simplemente me quedé absorto ante la manera tan relajada y tranquila con\nla que saliste aún habiéndote cambiado tan rápido.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000108",ch="sud"},
},
ja={
{
name={"Sui"},
"“Es muy feo ir por allí agitada y nerviosa. Podríamos decir que es parte de los\naires de realeza de Sui.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja de hablar! ¡Piensa por un momento en mí y en como voy a llegar tarde por\nandar tú metiéndome en tus locuras! ¡Te advierto que no tengo intención\nalguna de llegar tarde!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos vamos ya, rápido.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000109",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Por qué tan agitado?...\nFuh. Está bien. Aceptaré tu reto.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Cállate y vámonos ya!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="lock"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Cierro la puerta de la casa apresuradamente.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ahh?! ¡El elevador está bajando a los pisos inferiores!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000110",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Aún insistiendo en que tienes prisa te atreves a esperar esa cosa? Qué\nridículo.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",id=1,file="se1135"},
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Y al decir eso, Sui comenzó a bajar rapidamente las escaleras.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eres idiota? Estamos en el piso 10.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_sud_000111",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui piensa que puedes irte con toda tranquilidad al colegio, si así lo deseas.\nSui se irá ya.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué mierda estás diciendo...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Por andar esperándote a ti es que estoy en peligro de llegar tarde, imbécil...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Aún con ese corpiño tan enclenque te atreves a decirle eso a alguien que\nentrena diariamente como yo?!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"se",id=1,file="se0888f"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=100,y=30,speed=300,file="zbg020i",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=0},
{"quake"},
{"cgact",stage="zbg020",act="びっくり",size=2,time=100,loop=-1},
{"text"},
text={
ja={
{
"Comienzo a bajar corriendo las escaleras yo también.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, ¿ohhh?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Jamás había bajado corriendo las escaleras de mi edificio con tanta prisa,\npero...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Para ser sincero, bajar las escaleras corriendo a esta altura es como andar en\nuna montaña rusa, y está de terror.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"se",id=1,file="se0888f"},
{"fg",mode=-2,sync=0},
{"bg",zoom=120,x=100,y=40,speed=300,file="zbg020i",path=":bg/",z2=100,x2=100,y2=30,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=0},
{"quake"},
{"cgact",stage="zbg020",act="びっくり",size=2,time=100,loop=-1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wa, wawawawaaahwa!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Bajo con toda mi velocidad, pero no logro alcanzar a Sui de ninguna forma.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"¿Pero qué rayos tiene esta mujer?",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",time=200,file="black",path=":bg/"},
{"se",file="se0744",vol=100,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=0,y=0,speed=500,file="bg022a",path=":bg/",z2=170,x2=0,y2=0,ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=100},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",stop=1,time=500,id=1},
{"fg",ch="吹",size="z1",mx=40,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000112",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué sucede? ¿Te has cansado ya?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-Ni en broma, solo que no estoy muy acostumbrado a las escaleras y me asusté\nun poco.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000113",ch="sud"},
},
ja={
{
name={"Sui"},
"“Esa cosa que llaman colegio está en la misma dirección en la cual caminan\naquellas muchachas con uniforme, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Espera, ¿es que no te conoces el vecindario?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bgm",stop=1,time=1000},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000114",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vamos entonces.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"se",file="se0744s",id=1},
{"bgm",file="bgm015"},
{"fg",ch="吹",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Sui vuelve a correr.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qu--?!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",file="se0744s",id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Y vuelvo a perseguirla al instante.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero cómo demonios hace esto?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Una velocidad, absolutamente increíble. ¿Es que acaso Sui está en el club de\natletismo o algo así?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",rule=280,time=300,vague=40,file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tchh.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",stop=1,time=500,id=1},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000115",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vaya de lento que estás. Soy yo la que llegará tarde si sigo acompañándote.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Cállate!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"se",file="se0744s",id=1},
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Sigo su espalda con todo mi empeño.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Qué velocidad tan absurda.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Se mueve con una ligereza tal que pareciera tener alas, como si su cuerpo no\ncontuviera masa alguna.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡MALDITA SEA!!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"se",file="se0744s",id=1},
{"bg",zoom=200,x=-250,y=130,speed=3000,file="bg015a",path=":bg/",z2=100,x2=0,y2=0,ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=0},
{"quake"},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"se",file="se0744s",id=2},
{"bg",zoom=100,x=-250,y=130,rule=280,time=300,speed=2000,sync=0,vague=40,file="zbg015a",path=":bg/",z2=80,x2=-200,y2=80,ax=1920,ay=1126,bx=-960,by=-586},
{"cgact",stage="zbg015",act="びっくり",size=2,time=100,loop=-1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="びっくり",size=3,loop=-1,time=150,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0017",head="sui_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000116",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Jadeando ahora? ¿Dónde quedo la fuerza y energía que tenías al principio?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Cállate...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"msgoff"},
{"fg",ch="吹",size="z2",time=200,mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0016",head="sui_z2a",lv=5,id=9},
{"ex",time=200,func="wait"},
{"fg",ch="吹",mx=40,mode=-1,lv=5,id=9},
{"se",file="se0744s",id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=0,y=0,speed=500,file="zbg038a",path=":bg/",z2=200,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"quake"},
{"extrans",rule=280,time=300,vague=40},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0009",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="おじぎ",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_sud_000117",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Hasta cuándo piensas seguir jadeando?...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Cualquiera terminaría exhausto si lo obligaran a correr de esa manera tan\nviolenta. Y además, llegamos en menos de 10 minutos... ¿Quién rayos eres tú?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0001",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000118",ch="sud"},
},
ja={
{
name={"Sui"},
"“Soy Sui. ¿Sucede algo con eso?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo es muy poco para lo que tengo que decirte...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bgm",stop=1,time=500},
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0012",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000654",ch="rnd"},
},
ja={
{
name={"???"},
"“¿Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg038a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"bgm",file="bgm006"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000655",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué sucede? ¿Por qué jadeas tanto?...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo que... esta idiota...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000656",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Esta idiota?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún, con ese cuerpito tan pequeño, tiene muchísima fuerza física...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000657",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Muchísima fuerza física?...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Aún superior... a la mía.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000658",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso es bastante raro, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es todo un talento bastante raro.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_ked_000940",ch="ked"},
},
ja={
{
name={"???"},
"“Pues no hay nada que sorprenderse. ¡Pues se trata de nada más ni nada menos que\ndel eterno rival del genio Naoya Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Siento que la voz de Sui se transformó en una voz que se me hace bien\nfamiliar...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Una voz molestamente ensordecedora... que llevo escuchando desde hace bastante\ntiempo...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000659",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es bastante raro que hables así de Natsume-kun... Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
vl02={
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000941",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues sí soy más pequeño que Naoya, pero sin duda alguna tengo un poder capaz de\nsuperarlo con creces. Sí.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces aquí?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000942",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué es lo que estás diciendo? Se supone que estoy obligado a venir al colegio,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es por eso, ¿no se supone que deberías estar en las clases suplementarias de\nlas otras materias?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6},
},
vl02={
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
vl03={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000943",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, es que... es que estoy en receso. La clase de ahorita terminó rápido hoy.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cambiando de tema, Rin, ¿no viste a una chica por acá? Una bastante pequeña.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000660",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... no. No la he visto. ¿Esa chica es amiga tuya, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no lo es, pero...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000944",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué pasa, otra mujer nueva? Realmente eres bien bueno consiguiéndote novias\nnuevas.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas las cosas con ese tono tan malinterpretable.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000945",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eso crees? ¿Es que acaso no es así? Cuando comenzó el año también estuviste\nrodeado por un monton de muchachas nuevas.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso solo fue al principio.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000946",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso te pasa por andar tratándolas mal. Si las trataras con cariño las tendrías\na todas en bandeja para ti.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000661",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-En bandeja...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"La expresión de Rin está retorciéndose un poco.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, realmente no las tengo en bandeja ni nada de eso. Ni siquiera hablo con\nellas.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0016",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000662",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, Kusanagi-kun, siempre has sido popular con las chicas, y la verdad, me\nparece que es exactamente así.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000663",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000664",ch="rnd"},
},
ja={
{
name={"Rin"},
