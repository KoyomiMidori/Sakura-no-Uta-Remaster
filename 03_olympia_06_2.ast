block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002846",ch="rnd"},
},
ja={
{
"¿Por qué entonces papá no me dejó estar con mamá en sus últimas horas?...",
{"rt2"},
},
},
},
