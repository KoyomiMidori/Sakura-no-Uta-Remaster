astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm016"},
{"msgoff"},
{"bg",file="bluesky_summer",id=8,lv=8,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"Al momento de subir por la colina Yumenouki, el sol comenzó a ponerse.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Comparado al verano, la hora de la puesta del sol estaba ahora mucho más\nacelerada de lo normal.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg038b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002761",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La puesta del sol se ha venido acelerando cada vez más, ¿no les parece?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. En fin, ¿por dónde comenzamos a caminar?...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002762",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque oscurezca se puede buscar dentro de las edificaciones, pero en las\nafueras, sobre todo aquello que está dentro de estas arboledas, dejará de\npoder verse pronto. Había un templo un poco más adelante, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el Templo Hakuki... Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002763",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vayamos allá.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Por propuesta de Rin, decidimos dirigirnos al templo antes de que el sol se\npusiera por completo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",speed=1000,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=-345,x=-1045,lv=4,id=5},
{"fg",ch="吹",speed=1000,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x2=345,x=-355,lv=4,id=6},
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000431",ch="sud"},
},
ja={
{
name={"Sui"},
"“Un templo... No sabía que existiera esta clase de lugar también...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002764",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sui-chan, ¿no lo conocías?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000432",ch="sud"},
},
ja={
{
name={"Sui"},
"“La verdad no lo sé... Pareciera conocerlo, pero luego me pareciera que no...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿echamos un vistazo?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Al decir eso, y justo cuando traté de dar un paso hacia adelante, la silueta de\nuna persona aparece de entre los recintos del templo.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ese es...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"¿Habrá sido mera casualidad? ¿O acaso alguna guía divina o algo por el estilo?",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"No, seguramente no son ninguna de las dos, y a la vez, sí lo son.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La persona tras esa silueta se quedó inmóvil en el instante en que nos vio,\ncomo si hubiera quedado paralizado.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"msgoff"},
{"fg",time=500,mode=-2},
{"bg",zone="0x000000",file="bg063b",path=":bg/"},
{"fg",ch="稟父親",size="z1",ex03="a0097",time=1000,mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"ex",time=300,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002765",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Papá.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000081",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002766",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Rin baja su mirada.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"El padre de Rin se quedó parado donde estaba, y en medio del bosque, con el sol\ncomenzando a ponerse, era difícil discernir su expresión, pero a pesar de\neso, las sombras que se cernían en su rostro tenían un aspecto algo triste.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Habrá soltado una amarga sonrisa ahora? Después de que sus hombros temblaran\nligeramente un momento, trató de irse del lugar.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Lo único que pude hacer yo fue observar, también en silencio, como se iba.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000433",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿No es esta persona un conocido tuyo, Rin?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",mode=-2},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0005",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000082",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000083",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿Q-Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Con una expresión de asombro cercana a miedo, el padre de Rin observa por un\nínfimo instante a Rin para luego verme a mí, pidiéndome tácitamente una\nexplicación.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Sin embargo, no hay ninguna explicación de mi parte. No tengo forma de explicar\nesto.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000084",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Y-Ya veo... Así que con esto te referías a esos 'fenómenos enigmáticos'...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, en realidad no pensé que lo fuera tanto como su expresión pareció\nmostrarlo...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000085",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002767",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, vámonos...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000086",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No, esperen, vinieron aquí a hacer algo, ¿no? Me iré ya de una vez, no hace\nfalta que ustedes se vayan.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000434",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Mmmm? Rin, conoces a esta persona, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002768",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, eh, sí... lo conozco. O, digo, más bien... es mi padre...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0110",face="a0004",head="sui_z2a",lv=5,id=6},
{"se",file="se9010",id=1},
{"fgact",ch="吹",act="うなづく",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000435",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡O-Ohh! ¡¿Es usted el papá de Rin?! ¡Pero qué gusto en conocerle!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",time=0,sync=1,mode=-2},
{"fg",ch="稟父親",size="z2",ex03="a0097",sync=1,mode=3,resize=1,path=":fg/mtt/z2/",file="mtt_z2a0000",face="a0005",head="mtt_z2a",lv=5,id=9},
{"se",file="se9015",id=1},
{"fg",ch="稟父親",size="z1",ex03="a0097",my=40,mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0005",head="mtt_z1a",lv=4,id=9},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_mtt_000087",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Al acercarse Sui al padre de Rin, este retrocedió un paso al instante.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_sud_000436",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_sud_000437",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Sucede algo? Sui no tiene intención alguna de atacar.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000088",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Ah, no, disculpa...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002769",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta es la clase de padre que tengo... Sui-chan...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_sud_000438",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Esta clase de padre?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002770",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es una persona que no puede entender el corazón de los demás...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_sud_000439",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es verdad eso, señor padre de Rin?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000089",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“S-Sí... así es. Así soy yo...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_sud_000440",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Sui cruza sus brazos y se pone a pensar. Y entonces, da un golpecito con sus\nmanos, como si se le hubiera ocurrido algo.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000441",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Eso es absurdo, señor padre de Rin!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0003",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000090",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_sud_000442",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Puede alguien incapaz de entender el corazón de los demás referirse a sí mismo\ncomo tal?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000091",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Por ser así es que lo digo, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_sud_000443",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso es extraño. Si es por eso, ¿entonces qué significa realmente entender el\ncorazón de los demás?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fgact",ch="稟父親",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000092",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No tengo idea. No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_sud_000444",ch="sud"},
},
ja={
{
name={"Sui"},
"“Por lo menos, a mis ojos, me pareció verlo a usted tratando de defender a Rin,\nevitando negar lo que ella misma dijo. ¿Se puede decir que una persona así\nrealmente 'no puede entender el corazón de los demás'?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000093",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Pues, quién sabe... Aunque puedo decir que no soy la clase de persona que\nmerece ser defendido por ti.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_sud_000445",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sui no está defendiéndolo a usted. Simplemente dije lo que pensé.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000094",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_sud_000446",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No me parece que usted sea una mala persona!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",mode=-2},
{"bg",y=-290,speed=300,sync=0,file="zbg063b",path=":bg/",x2=-600,y2=-290,x=-800,ax=1920,ay=1080,bx=-960,by=-540},
{"fg",ch="稟",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0007",head="rin_z2a",x2=200,x=0,lv=5,id=5},
{"quake"},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",x=0,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002771",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí lo es! ¡Es un despiadado! ¡Es la clase de persona capaz de pisotear los\ncorazones de los demás!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟父親",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000095",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Sí, tienes razón... Discúlpenme ustedes dos, por haberlos metidos en este clima\ntan hostil... Me iré de una vez ya...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Al dejar dicho eso, el padre de Rin intentó irse del Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"se",file="se9004",id=1},
{"fg",ch="稟父親",speed=500,mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",ex03="a0097",head="mtt_z1a",x2=0,x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002772",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Idiota...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Rin dice eso en un bajo tono de voz.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002773",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De nuevo tratando de evitar confrontarme, así como ahora...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000096",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002774",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de decirte todas estas cosas tan crueles... no haces el mínimo esfuerzo\npor refutarme...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0004",head="mtt_z1a",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000097",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No lo hago, y es porque he sido el peor de los padres para ti...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002775",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Rin mira ferozmente a su padre.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Una expresión totalmente inimaginable de la Rin que anda siempre con una\nexpresión suave en su rostro.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"A pesar de eso, su padre no intenta verla.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002776",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente eres muy cruel...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Las lágrimas caen de las mejillas de Rin.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_mtt_000098",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Disculpen el escándalo...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",file="se9004",id=1},
{"fg",ch="稟父親",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"El padre de Rin desapareció por la colina Yumenouki, sin voltear una sola vez.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002777",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhh.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Rin se tapa la boca. Parece que está tratando de contener los sollozos que\nestán por escapársele...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0019",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000447",ch="sud"},
},
ja={
{
name={"Sui"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, Sui, ¿podríamos dejarlo hasta acá por hoy?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000448",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, parece que eso es lo mejor...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",time=450,size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002778",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Perdón...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000449",ch="sud"},
},
ja={
{
name={"Sui"},
"“No tienes por qué disculparte. Probablemente ya lo sabes ahora. Así como yo...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002779",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000450",ch="sud"},
},
ja={
{
name={"Sui"},
"“Probablemente sabes ya qué es lo que estamos buscando...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002780",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000451",ch="sud"},
},
ja={
{
name={"Sui"},
"“Y... Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000452",ch="sud"},
},
ja={
{
name={"Sui"},
"“A final de cuentas, ¿aquello que fue una vez olvidado realmente debería ser\nbuscado?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ni idea. Quizás no hay ninguna respuesta correcta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo menos así lo pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo podemos elegir una opción al momento de decidir el futuro, entonces sea\ncual sea el resultado de esa elección, solo ese único futuro será el correcto\npara nosotros.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está fuera de todo lugar tratar de pensar en otros futuros.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto, tal vez después terminemos arrepentidos, lamentándonos de lo que\nhicimos, pero... creo que las cosas no pueden funcionar así.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002781",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene caso alguno arrepentirnos de las elecciones que hicimos. Puesto que no\nhay otro futuro para nosotros sino aquel que caminamos en base a nuestras\npropias elecciones.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que define lo correcto o lo incorrecto no son nuestras elecciones, sino la\nactitud con la que asumimos sus resultados...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo importante no es el hecho de elegir, sino de aceptar el hecho de que hicimos\nuna elección. Aceptar el futuro como debe ser.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002782",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000453",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo. Tienes un novio muy confiable, Rin.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002783",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sui-chan...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000454",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bien, Sui se retirará ahora. Espero verlos de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="吹",speed=500,mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x2=345,x=570,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002784",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Esto, Sui-chan!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000455",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002785",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=570,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=570,lv=4,id=6},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=570,lv=4,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000456",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Muchas gracias por acompañarme en mi búsqueda hoy! ¡Hasta otro día!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"se",file="se9004",id=1},
{"fg",ch="吹",mx=40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Sui interrumpe a Rin, quien parecía querer decir algo, y se despide.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=5},
{"text"},
text={
ja={
{
"Y entonces, quedamos solo Rin y yo en ese lugar.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Recordaste algo?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",x=0,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002786",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... un poquito...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002787",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, hace un tiempo me preguntaste si odiaba o no a papá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo hice.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002788",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya lo sabes, ¿verdad? Aunque es un tanto obvio...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ni idea cuánto sé en realidad, la verdad... De no preguntártelo todo no\ncreo que pueda saberlo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=0,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002789",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me lo imaginaba. Jamás te he contado esto.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002790",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi mamá sufría de una enfermedad...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002791",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Era una enfermedad que le impedía mover sus extremidades. En ese tiempo aún no\nsabía bien qué clase de enfermedad era, pero... parece que era una enfermedad\nen la cual el cuerpo va perdiendo su movilidad gradualmente...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002792",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Después, cuando investigué qué era, supe que era una enfermedad del sistema\nnervioso, cuyo síntoma principal era la ataxia... Una enfermedad incurable\ncon la medicina actual...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002793",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Poco a poco el cuerpo va perdiendo su movilidad... y al final, incluso la misma\nrespiración se detiene...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002794",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y... por eso quise llevar a mamá a todos aquellos lugares a los que deseara ir,\nmientras tuviera conciencia aún...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",blur=3,file="bg036a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002795b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todos esos lugares eran zonas donde los cerezos florecían, y... justo en esa\népoca estaban floreciendo los cerezos, así que recorrí varios de los lugares\nde Yumihari de donde podían verse los cerezos junto a mamá...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002796",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace un rato mencionaste los 'lugares donde florecen los cerezos', ¿recuerdas?\nFue al escuchar eso que lo recordé...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002797",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los lugares que recorrimos con Sui-chan ayer, fueron los mismos lugares que\nrecorrí junto a mamá...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002798",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero pensé que solo era casualidad. En ese tiempo caminé por aquellos lugares\ndonde florecían los cerezos, y pensé que, tal vez, solo por casualidad,\nSui-chan tenía algo que buscar en esos lugares...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002799",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero hace un momento, al hablar con papá, recordé algo muy, muy importante...\n¿Por qué habré olvidado algo tan importante como esto?...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002800",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estoy algo loca. Es raro, ¿no te parece? Ya te habías dado cuenta de eso, ¿no\nes así, Nao-kun? Por eso es que me preguntaste si recordaba algo respecto al\nnombre 'Sui', ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... tal vez.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002801",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces lo sabías, ¿verdad? Que el nombre de mi mamá es Sui Misakura...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque no desde un principio. Y es que normalmente no me aprendo el primer\nnombre de las madres de mis amigos, así que en esa época solía llamarla 'mamá\nde Rin'.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002802",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero lo sabes.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y eso porque asistí al funeral. No pensé llegar a conocer el primer nombre\nde la madre de una amiga en ese tipo de situación...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002803",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En qué momento lo recordaste?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuándo... No lo recuerdo muy bien. Sin embargo, lo confirmé ayer cuando me\nencontré con tu padre.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002804",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces sí te encontraste con mi padre, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002805",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De cierta forma sentí que era eso. Por lo extrañamente raro que te veías hoy...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdóname por no haberte dicho nada...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002806",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien, no importa. Probablemente pensaste que no debías decirme, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así lo pensé.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002807",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eres tú quien debe encontrar aquello que está al final de esta\nbúsqueda... No soy yo quien debe darte esa respuesta.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002808",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero estuviste indeciso todo este tiempo... de si debía realmente buscarse o\nno ese algo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vacilé. Estuve indeciso todo este tiempo... Probablemente, desde aquel\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002809",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Aquel momento?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no sé cuál será la respuesta que conseguirás. Ni tampoco qué\ndesenlace traerá esa respuesta...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002810",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, la verdad es que esa respuesta no importa. Realmente me da igual si llegas\na conocer o no esa respuesta.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo que, no me parece bien que tú y tu padre sigan como están ahora.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002811",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, quisiera que tú y tu padre se reconcilien.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002812",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque soy tu novio.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002813",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... es mi...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué pones esa cara de desconcierto? Los dos estamos en una relación... No,\nrealmente no es algo tan ligero como simplemente tener una relación.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002814",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué significa eso?...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiera pasar el resto de mi vida contigo. Para mí, tener una relación con una\nmujer implica eso...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que, por lo menos yo, planeo estar junto a ti por el resto de\nnuestros días.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mientras no termines odiándome y pidiéndome que cortemos, planeo pasar el resto\nde mi vida contigo...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás creas que soy un hombre ridículo y latoso, diciendo esa clase de cosas\nen estos tiempos, pero, pues bueno, los Kusanagi somos fieles de por vida por\nnaturaleza. Parece que no tuviste buena suerte eligiendo novio, Rin.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0019",head="rin_z2a",lv=5,id=5},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002815",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué injusto eso...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002816",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, eso es injusto...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0020",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002817",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me crees... capaz de no sentirme feliz al escuchar esas palabras?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no tenía seguridad de que pudieras sentirte así... La verdad, pensé\nincluso que llegaría a irritarte un poco.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002818",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me veo como la clase de mujer capaz de hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="おじぎ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002819",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La latosa soy yo... Aun con todo el esfuerzo que invertiste para cortar nuestra\nrelación, nunca pude llegar a olvidarte.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002820",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No solo no pude olvidarte, sino que además regresé de nuevo a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="おじぎ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002821",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aún cuando probablemente solo tratabas de evitarme por bondad... yo misma\nterminé pisoteando esos buenos sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002822",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo... por querer verte...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, te equivocas. No fue por bondad, simplemente estaba perdido, sin saber qué\nhacer.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente no tenía confianza en mí mismo...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ya no volveré a vacilar. Te protegeré, con mis propias manos.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=2000},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002823",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002824",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Yo... odio a mi papá.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002825",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A ese mismo padre que me robó a mamá...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="ev_com_c08_01",path=":ev/ev_com_c08/",set="ev_com_c08",sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"msgoff"},
{"colortone",style="reset"},
{"bg",file="ev_com_c08_01",path=":ev/ev_com_c08/",set="ev_com_c08",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm002"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002826",ch="rnd"},
},
ja={
{
"Su última estación. Era la época en la que los cerezos estaban floreciendo.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002827",ch="rnd"},
},
ja={
{
"Estuve recorriendo todos aquellos lugares donde florecían los cerezos junto a\nmi empequeñecida madre, en silla de ruedas.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002828",ch="rnd"},
},
ja={
{
"Y es que por culpa de su enfermedad, mi madre había enflaquecido lo suficiente\ncomo para poder llevarla afuera por mi cuenta, aún siendo yo una niña\npequeña...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002829",ch="rnd"},
},
ja={
{
"Mamá no podía hablar muy bien, así que no solía decir mucho, pero aun así\nrecuerdo que lucía feliz.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002830",ch="rnd"},
},
ja={
{
"Puesto que le encantaban los cerezos...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002831",ch="rnd"},
},
ja={
{
"Aparte de recorrer y contemplar los cerezos, también nos íbamos de compras las\ndos.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002832",ch="rnd"},
},
ja={
{
"Al estar confinada en silla de ruedas, casi todas las tiendan ponían mala cara\nal vernos, pero entre todas esas tiendas, hubieron algunas donde nos trataron\namablemente.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002833",ch="rnd"},
},
ja={
{
"Pasé el escaso tiempo restante de mi madre junto a ella, empujándola en su\nsilla de ruedas.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002834",ch="rnd"},
},
ja={
{
"Pensé en acompañarla, aún hasta su último momento.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002835",ch="rnd"},
},
ja={
{
"Y, sin embargo...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bg",file="black",path=":bg/"},
{"bg",file="ev_uni_c41_01",path=":ev/ev_uni_c41/",set="ev_uni_c41"},
{"text"},
text={
vo={
{"vo",file="man_mtt_000099",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No puedo permitir que sigan juntas las dos.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002836",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Por qué?! ¡Mamá ya no puede moverse!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_mtt_000100",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“No, ese no es el problema. No pueden permanecer juntas por siempre. De hacer\neso, irás empeorando cada vez más.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002837",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué quieres decir con que empeoraré? Es mi madre, ¿por qué no debería\nacompañar a mi madre enferma?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_mtt_000101",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Debí haber tomado esta decisión más pronto... No tiene caso seguir haciendo\nesto...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002838",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué es lo que no tiene caso? ¿Por qué? ¡No, no te lleves a mamá!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_mtt_000102",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Perdóname, Rin...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002839",ch="rnd"},
},
ja={
{
"De repente un día, mamá y yo fuimos separadas una de la otra.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002840",ch="rnd"},
},
ja={
{
"Desconozco la razón. Y es que, nunca llegó a decirme nada... Papá me quitó a\nmamá con la simple y arbitraria excusa de que no podíamos seguir juntas.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002841",ch="rnd"},
},
ja={
{
"Él me quitó a... mi mamá, enferma y sin capacidad alguna para moverse.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002842",ch="rnd"},
},
ja={
{
"Muy poco después de eso, fue que me anunciaron la muerte de mi madre.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002843",ch="rnd"},
},
ja={
{
"Sabía que mi madre sufría de una enfermedad.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002844",ch="rnd"},
},
ja={
{
"Y también... que era una enfermedad sin cura...",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002845",ch="rnd"},
},
ja={
{
"Sin embargo, jamás pensé que mamá moriría unos pocos días después de haber sido\nyo alejada de ella.",
{"rt2"},
},
},
