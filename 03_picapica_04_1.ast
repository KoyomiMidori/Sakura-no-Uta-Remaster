astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Perfecto, perfecto.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Terminé con los preparativos del desayuno. Preparé los almuerzos también. Lo\núnico que me queda por hacer es esperar a que sea buena hora para ir al\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Al ir a la sala de arte, me encuentro con Rin limpiando.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003626",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Buenos días, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Después de colocar el trapo que estaba usando para limpiar el piso en una\nesquina de la cubeta, Rin se para.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003627",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pensaste que era Mako-chan?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm, sí. Limpiar la sala de arte es parte de su rutina diaria.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003628",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se veía muy ocupada con su pieza de práctica para la Exposición Moore, así que\nle propuse encargarme yo de la limpieza en su lugar.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Perdona que tengas que hacer esto.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003629",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué te disculpas, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, no, bueno, ¿por qué será?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003630",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Rin sonríe un tanto entretenida.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003631",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan y tú se ven muy naturales juntos. Como si fueran el uno para el otro.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003632",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Eso me da un poquito de envidia.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, hemos sido compañeros de clase por 3 años seguidos. No ha habido nada\nespecial entre los dos, pero... sí, supongo que nos la hemos pasado juntos\ntodo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003633",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es justamente el hecho de que se junten sin ninguna razón en particular lo que\nhace tan natural que estén juntos, pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003634",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, habías dicho que tenías algo que preguntarme, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te puedo explicar lo que quieras con más tranquilidad después de clases, pero\nsi es algo rápido puedo ayudarte ahora mismo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003635",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Jeje.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que se te hace tan cómico?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003636",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no es nada. ¿Sabes?... Tengo algo que quisiera preguntarte...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003637",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te preocupa Mako-chan?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿¿Mm?? ¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003638",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"¿Por qué surge Toritani en el tema ahora? ¿No quería preguntarme algo respecto\na su pintura?",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"... ¿Será que todo este tiempo estuve convencido de que Rin quería preguntarme\notra cosa?",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Claro. Ya veo. Solo viendo lo que acaba de suceder, no me sorprende ahora que\nme acusen de no tener interés por mí mismo.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Rin está esperando por mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh... pues...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"En el caso de Rin, una respuesta muy ambigua seguramente tendrá el efecto\ncontrario.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Últimamente la he visto muy cansada... y...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... supongo que sí. Estoy preocupado por ella.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003639",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... sí, me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿B-Basta con eso?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003640",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso era lo que querías saber?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003641",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Los hombros de Rin se relajan un poco.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Al darme cuenta de eso, entendí que a pesar de aparentar normalidad hasta\nahora, Rin estaba algo tensa.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003642",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003643",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya no tienes que venir a ayudarme después de clases, ¿está bien? Trataré de\npensar yo solita y pintar por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... está bien.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003644",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Bien, iré a limpiar un poco más entonces.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Rin toma la cubeta y trata de caminar hacia el lavabo. La cubeta llena de agua\nparece ser pesada.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te ayudo?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Al tratar de estirar mi mano para tomar la cubeta que Rin llevaba, esta la\nesquiva rápidamente.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0003",head="rin_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0110",face="b0002",head="rin_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003645",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias. Pero soy bastante fuerte, aunque no lo aparente.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003646",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. ¿Sabes, Nao-kun? Puede que Mako-chan esté por el mural.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, está bien. Gracias.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003647",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vale. Nos vemos después entonces, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Nos vemos.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Tal como Rin dijo, Toritani estaba frente al mural. Es aún temprano, y no hay\nningún estudiante alrededor.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llegaste temprano, eh.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002258",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿pero qué te pasó hoy? El Kusanagi que conozco nunca llega al colegio\ntan temprano. No digo que llegues tarde siempre, pero por lo general llegas a\ncualquier hora.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me di cuenta que viniendo a esta hora podría ver el mural sin que nadie me\ninterrumpiera.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002259",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces procura venir temprano y deja de escaparte de clases.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Desayunaste?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002260",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No tienes una forma menos obvia de evadir mi pregunta?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Trataré de no escaparme tanto.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002261",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No percibo mucha honestidad en esas palabras... Jaa, por Dios.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy a comer. ¿Me acompañas?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Le doy el envase a Toritani.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002262",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Toritani alterna su mirada entre el envase y yo.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está de rechupete, eh. Aunque bueno, fui yo quien lo preparó.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002263",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya he tenido varias oportunidades para darme cuenta de eso, no hace falta que\nlo menciones.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002264",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dime algún deseo que quisieras que te cumpla.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ninguno.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002265",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me da igual ya, puede ser lo que sea. Si quieres incluso, podría mostrarte\nmis... p-pantis...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002266",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es que, cada vez se hace más grande la montaña de deudas que tengo contigo. Si\nhay algo más que pueda hacer para pagarte de vuelta, preferiría esa otra\nalternativa, pero... por ahora, no sé qué quisieras pedirme...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002267",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, parece que has tenido una fijación por ver mis pantis, así que...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm. Bien, entonces dejemos que se agrande la caja de ahorros de deudas.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002268",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y cuando acumule unas cuantas más, muéstrame algo mucho mejor que tus\npantis.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002269",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A-A qué te refieres con eso?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú, en una pose vergonzosa... ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008h",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002270",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esp--, ¿d-de verdad estás diciendo eso en serio?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002271",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Toritani, algo agitada ahora, pone sus brazos alrededor de su pecho, como\ntratando de ocultarlo, y escudriña mi expresión.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Ya veo, sus pechos. Ahora que lo recuerdo, Toritani tiene un buen par de\nellos. No podría estar más de acuerdo con Rin y su comentario respecto a que\nToritani es una muñeca erótica.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Pero, bueno, por supuesto que me encantaría ver sus pantis también.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0007h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005h",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002272",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-Ni creas que te mostraré algo! I-Idiota...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué lástima...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Aunque, para decir la verdad, más que el propio acto de ver eso, quizás me\nguste mucho más hablar con Toritani acerca de cosas eróticas, así como ahora.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"... Por supuesto, si pudiera ver lo que hay tras su ropa, sería absolutamente\nfenomenal.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se9045",id=1,vol=20,loop=1},
{"msgoff"},
{"bg",file="bg048g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Cuando llega esta hora, el humo de cigarro comienza a elevarse al aire, casi\ncomo si fuera una señal. Desde la azotea, como de costumbre.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe, debo ir al baño.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"se",stop=1,id=1,time=500},
{"se",file="se1279",vol=50,id=2},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"bgm",file="bgm035"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000129",ch="htd"},
},
ja={
{
name={"Directora"},
"“Eres toda un alma libre, muchacho.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"La directora susurra con algo parecido a admiración al verme subir a la azotea.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hago lo posible para que así sea.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000130",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"La directora devuelve su mirada hacia el mural, sin más nada que decir.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"La mirada con la cual ve el mural se asemeja un tanto a la que Toritani mostró\nhace unos días. Como si estuviera atravesando el mural y viendo algo más.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Si hay algo que la directora podría estar viendo ahora, eso es...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fue para completar ese mural que usted se apropió del colegio Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000131",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"La directora no mostró casi vacilación ante mi pregunta.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000132",ch="htd"},
},
ja={
{
name={"Directora"},
"“Completar ese mural era mi más ferviente deseo, y también mi redención.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está tratando de decirme que se apropió del colegio, eliminó a todas aquellas\npersonas que se pusieron en su camino, solo para quedarse esperando después a\nque Kenichiro Kusanagi regresara?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000133",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estaba segura de que algún día regresaría para completar ese mural.\nLamentablemente, esa certeza terminó esfumándose sin llegar a volverse\nrealidad.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000134",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sin embargo, y como cosa misteriosa, fuiste tú, su hijo, quien lo culminó.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Señora directora, la vez pasada dijo que a fines prácticos había sido usted\nquien había despedido a Kenichiro Kusanagi, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000135",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. También fui yo quien recibió su carta de renuncia.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue hace bastante tiempo que Kenichiro Kusanagi comenzó a ocuparse en el diseño\nde ese mural.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más que en ese entonces usted estuviera en vínculo maritales con la familia\nNakamura, me cuesta creer que tuviera la autoridad como para hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000136",ch="htd"},
},
ja={
{
name={"Directora"},
"“Justo después de graduarme de la universidad me volví una Nakamura, y aun\nestando en mis veinte ocupé el puesto de jefa de profesores. Así que pude\ninvitarlo a que viniera al colegio como profesor de tiempo parcial.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yumihari es un colegio de prestigio. Por más que Kenichiro Kusanagi se\nconvirtiera después en un artista con fama internacional, para entonces aún\nera un don nadie. Es difícil conseguir un puesto de profesor en Yumihari, así\ncomo así.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000137",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tal cual. Si no fuera por mi recomendación, hubiera sido terriblemente difícil\npara él obtener el puesto de profesor, aun siendo de tiempo parcial.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tanto esfuerzo para traer a Kenichiro Kusanagi como profesor?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000138",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Que por qué, eh.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,time=1000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"La directora fuma lentamente de su cigarro. El humo que esta expulsó va\nsubiendo hacia el cielo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"El humo deja su estela mientras se eleva al aire... Recordé un poco de lo que\nsucedió en primavera.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La directora había dicho que asistió al funeral de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_htd_000139",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué fue lo que esperaba yo de él en ese entonces?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_htd_000140",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Expectativas?... Sí, expectativas. Inconscientemente, terminé haciéndome\nexpectativas, y por eso fue que lo invité a venir.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_htd_000141",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pensé que tal vez él podría hacer algo para resolverlo todo...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_htd_000142",ch="htd"},
},
ja={
{
name={"Directora"},
"“Kenichiro Kusanagi era el tipo de persona del cual no podías evitar hacerte esa\nclase de expectativas. Así era él. Tal como eres tú ahora.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000143",ch="htd"},
},
ja={
{
name={"Directora"},
"“En cierta forma, él hizo las cosas mucho mejor de lo que yo esperaba.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000144",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y luego, abandonó este colegio. Yo misma recibí su carta de renuncia.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000145",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para ponerlo en términos sencillos, lo usé y luego lo tiré a la basura. Así fue\ntoda la historia.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Lo usó, y luego se deshizo de él...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"La directora se apoderó de este colegio para esperar a que viniera ese hombre.\nEl mismo del cual se deshizo de la manera en que lo acaba de describir. Eso\nes lo que me está diciendo.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Invirtió la mitad de su vida en ello, aun a costa de deteriorar su relación con\nsu verdadera hija.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"No parece estar mintiendo. Aunque no haya contado todo, eso es, sin duda\nalguna, lo que la directora verdaderamente sintió y vivió.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Podríamos incluso decir que se trató de una confesión.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000146",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo fue la relación entre usted y Kenichiro Kusanagi, señora directora?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"La directora me observa fijamente, aún con el cigarro en su boca.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000147",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Es que acaso... no has escuchado nada al respecto?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en un principio ni siquiera sabía quién era el director del colegio\nYumihari...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000148",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo, lo cual quiere decir que no tenías interés alguno al respecto...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, básicamente.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000149",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000150",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué es lo que te trae ahora a preguntarme tanto?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay dos razones. La primera es que usted parecía ansiosa por hablar al\nrespecto.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000151",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Y la otra?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ayer fui a la casa de la familia Toritani. La casa donde usted está viviendo\nahora.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000152",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, así me lo reportó la empleada doméstica.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani me mostró las pinturas que Kei ha elaborado, desde que nació hasta\nahora. Y me fijé que en esa casa no había ningún cuadro de Toritani.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ella se detuvo frente a la puerta de una cierta habitación. Dijo que hace un\ntiempo, llegó a abrir la puerta de esa habitación.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000153",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"La directora toma su ya empequeñecido cigarro y lo presiona dentro de su\ncenicero portátil.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0004",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000154",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo... Así que esa muchacha sigue aún estancada allí.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000155",ch="htd"},
},
ja={
{
name={"Directora"},
"“Esa es mi habitación. Aunque en realidad es algo así como un depósito. Un\ndepósito de pura chatarra, la verdad. No hay nada interesante allí.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000156",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sin embargo, hay unas escaleras.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Escaleras? ¿Es alguna metáfora, o algo así?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0003",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000157",ch="htd"},
},
ja={
{
name={"Directora"},
"“Nada más ni nada menos que eso. Escaleras.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000158",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ahora que lo recuerdo, ese cuadro tuyo está colgado en el ayuntamiento... Es\nuna pieza fabulosa.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“J-Jaa... ¿G-Gracias?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000159",ch="htd"},
},
ja={
{
name={"Directora"},
"“Hay unas palabras que se me vienen a la mente cuando veo tus pinturas y las de\ntu padre... 'Hisureba, hana nari' (Del secreto, la flor). Son famosas, debes\nhaber escuchado de ellas alguna vez, me imagino.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, las he escuchado.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000160",ch="htd"},
},
ja={
{
name={"Directora"},
"“'La flor, lo atractivo, la rareza, el mismo espíritu estas tres son'. Tanto tú\ncomo Kenichiro Kusanagi son del tipo capaz de producir esa misma flor.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000161",ch="htd"},
},
ja={
{
name={"Directora"},
"“Este muchacho también posee algo así, pero de una forma bastante mucho más\ncompleja e intrincada. Ehm... Se llamaba Akashi, ¿no? Él tiene algo parecido.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000162",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tiene algo que ni Kei ni esa muchacha tienen.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000163",ch="htd"},
},
ja={
{
name={"Directora"},
"“Las pinturas de Kei son una mirada que observa al mundo.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000164",ch="htd"},
},
ja={
{
name={"Directora"},
"“Mientras que las pinturas de ella son... rígidas, fieles. Es ese profundo\nsentimentalismo característico de la pubertad lo que a duras penas... hace\nque las pinturas de esa muchacha sean algo 'que se pueda contemplar'.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000165",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sus creaciones no están hechas para el arte.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene usted muy buen ojo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000166",ch="htd"},
},
ja={
{
name={"Directora"},
"“Soy egresada de una universidad de artes, por si no lo sabes. Llegué incluso a\nrecibir una oferta para trabajar de curadora en un museo.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000167",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque tuve que rechazarla debido a que me casaría justo después de graduarme.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y es por eso que resguarda todos los cuadros de Kei en la casa de la familia\nToritani?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000168",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, respecto a eso, yo misma las compré todas. Pensé que sería una buena idea\nadministrar las pinturas de Kei en un lugar que pudiera tener siempre bajo mi\nsupervisión... Eso fue lo que pensé al momento de divorciarme.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000169",ch="htd"},
},
ja={
{
name={"Directora"},
"“La forma de tratar con sus pinturas es algo complicada. Hay partes que no\nresultan muy sencillas de lidiar.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Eso implica también que tratar con Kei es difícil.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso tiene que ver también con el hecho de que usted y Toritani no se lleven\nbien?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000170",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000171",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sin embargo, yo misma perdí el derecho a hacerme llamar madre. Así que no sé\nrealmente cuál es la respuesta correcta.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo dice como si estuviera hablando de alguien más.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000172",ch="htd"},
},
ja={
{
name={"Directora"},
"“De ninguna forma. Justamente por tratarse de mí es que puedo decirlo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se atrevió a sacrificarlo todo para apoderarse del colegio Yumihari? ¿Incluso\na costa de la relación con sus hijos?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000173",ch="htd"},
},
ja={
{
name={"Directora"},
"“Supongo que sí.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para los Nakamura, la familia Toritani debió haber tenido algún valor de uso\ncomo para haberse atrevido a establecer un vínculo marital entre las dos\nfamilias. Sin embargo, la familia Toritani no tiene ahora ni siquiera una\npizca de ese valor.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse que no se me viniera nada a la mente al escuchar el apellido\nToritani.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000174",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para cuando yo me casé, Toritani aún era una empresa comercial con considerable\nfama. Y también un negocio de bastante antigüedad que había sobrevivido desde\nla era Meiji.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000175",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque ahora es, a duras penas, solo un pequeño local del cual mi hermano se\nencarga.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0005",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000176",ch="htd"},
},
ja={
{
name={"Directora"},
"“El colapso de la burbuja económica influyó en que sucediera eso, pero más que\ntodo fue por mi divorcio que la familia Nakamura puso sus ojos sobre el\nnegocio familiar de los Toritani.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000177",ch="htd"},
},
ja={
{
name={"Directora"},
"“A pesar de que ya no tienen el poder influyente del cual gozaban hace tiempo,\nes imposible manejar un negocio en esta región con los ojos de los Nakamura\nencima. La familia Toritani cayó en la ruina, como si nada.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Usted acabó con su propia familia y destruyó la relación con su hija, todo\nsolo para completar ese mural. Para cumplir su enternecido deseo, y para\nllevar a cabo su redención.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El costo en el cual incurrió para pagar el pecado de haber usado y luego\nhaberse deshecho de ese hombre fue demasiado alto. ¿Qué la llevó a hacer\ntanto por ese hombre?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000178",ch="htd"},
},
ja={
{
name={"Directora"},
"“A veces preguntas cosas difíciles, eh.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Le parece?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000179",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Somos nosotros mismos quienes menos nos entendemos.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es así?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000180",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es así. Aunque bueno, podría explicártelo de una manera más sencilla, si así lo\nprefieres.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo mucho interés al respecto, pero ¿le molestaría explicarme de igual\nforma?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0011",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000181",ch="htd"},
},
ja={
{
name={"Directora"},
"“Escuchando lo que acabas de decir me quitas las ganas de contarte...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces déjelo así.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000182",ch="htd"},
},
ja={
{
name={"Directora"},
"“No hay tanto problema en no entender aquello que no es importante. El problema\nes no entender aquello que sí lo es.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es esa su respuesta simplificada?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000183",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Así te pareció?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000184",ch="htd"},
},
ja={
{
name={"Directora"},
"“Jejeje.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Después de soltar una insinuante sonrisa, la directora miró de reojo a mis\nespaldas.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1c0000",face="c0001",head="sak_z1c",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000185",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien... creo que debería irme ya...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000186",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, cierto.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"La directora se detiene justo después de comenzar a caminar, y se voltea.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000187",ch="htd"},
},
ja={
{
name={"Directora"},
"“Él y yo teníamos la misma edad. Cursábamos distintas carreras, pero\npertenecimos a la misma universidad, y llegamos a tomar algunas clases\njuntos.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000188",ch="htd"},
},
ja={
{
name={"Directora"},
"“Nos vemos en otra ocasión, jovencito.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"se",file="se9004",vol=50,id=1},
{"fg",ch="紗希",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Observo a la directora mientras va saliendo de la azotea. En su silueta\nalejándose ya no quedaba rastro alguno de aquella inocente y desprotegida\nmuchacha que alguna vez llegó a ser.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,time=1000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Somos nosotros mismos quienes menos nos entendemos', eh...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Lo que tiene que ver con nosotros es lo más importante, y por eso mismo es que\nno logramos entenderlo por completo.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"No, justamente por tratarse de algo importante es que nos trae tantos problemas\nel hecho de no entenderlo.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Eso es lo que realmente quiere decir 'El problema es no entender lo que sí es\nimportante'.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Puede que alguien conduzca alguna extraña y descabellada investigación en\nalguna parte del planeta. Supongamos que no sepamos para qué demonios sirve.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"En ese caso, sería tan incomprensible para nosotros que terminaríamos por no\ndarle la más mínima importancia.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Por ejemplo, saber cuántos escarabajos peloteros están rodando pelotas de\nestiércol en el otro lado del globo. Es algo del cual desconocemos el por qué\ny el para qué, y que sencillamente le da igual a muchos.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"'Yo misma perdí el derecho a hacerme llamar madre'.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Ayer escuche unas palabras similares.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Era 'soy un fracaso como madre...'. Esas palabras se parecen a las de la\ndirectora, pero no significan lo mismo.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Sentí que esa sutil diferencia daba a entender la certera y definitiva\ndiferencia entre la forma de vivir que han llevado las dos.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Meto mis manos en los bolsillos, y comienzo a caminar de manera relajada y\ndespreocupada hacia la entrada de la azotea.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"msgoff"},
{"bg",zone="0x000000",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm106"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que estás ahí.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002273",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"msgoff"},
{"fg",ch="真琴",size="z1",time=1000,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"ex",time=300,func="wait"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Toritani apareció detrás de la columna. Su expresión se veía repleta de dudas,\npero también parecía estar algo vacilante.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002274",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Toritani volvió a callarse. Más que estar dudosa de hablar o no, me pareció que\nestaba buscando por dónde comenzar a preguntar.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002275",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te estás juntando con ella, por querer saber más de Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Toritani saca el tema de repente, con un rostro inexpresivo.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Me dan ganas de decirle que no piense las cosas de manera tan complicada. Que\nno tiene por qué tocar el tema como si estuviera lidiando con una especie de\ntumor intocable.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso. Simplemente llegó a convertirse en una de las razones a medida\nque avanzó la conversación.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hubiera la necesidad, investigaría y averiguaría por mi cuenta. Si no\ninvestigué nada hasta ahora, es porque no tuve interés en el tema.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se podría decir que es casi como una especie de favor de mi parte.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002276",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿F-Favor?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así como lo dije hace un rato, la directora parecía querer hablar, así que yo\nsolamente me ocupé de escucharla. Aunque eso no es más que algo secundario.\nHay otra y verdadera razón.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002277",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dijiste que habían dos razones, ciertamente... No llegaste a revelar la otra.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002278",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué? ¿Cuál es la otra razón?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es acaso obvio? Es porque me llamas la atención. Tú y lo que te sucede.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012h",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002279",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ehh.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"msgoff"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014h",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",speed=150,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014h",head="mak_z2a",y2="0,-10",y=0,lv=5,id=9},
{"se",file="se9010",vol=60,id=1},
{"ex",time=500,func="wait"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011h",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",speed=150,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011h",head="mak_z2a",x2="0,-5,5,-5,5",x=0,y=0,lv=5,id=9},
{"ex",time=1800,func="wait"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008h",head="mak_z2a",x=0,y=0,lv=5,id=9},
{"ex",time=500,func="wait"},
{"fg",ch="真琴",size="z1",time=500,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Me agito un tanto ante Toritani, quien claramente trató de ocultar su\nsobresalto y falló en el intento.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, me refiero a ti y a Kei, y a la familia Natsume... supongo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",x=0,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002280",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, s-sí... si es por eso... puedo entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Aún después de decir eso y asentir, la cara de Toritani se veía ligeramente\nruborizada.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002281",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes?...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Toritani lucía algo nerviosa al comenzar a hablar.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002282",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que ya te lo he dicho varias veces, pero no tienes por qué preocuparte por\nmí. Realmente no es la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no es la gran cosa? ¿Aun habiéndote marchado de tu propia casa?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002283",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Ya te dije que eso es mi problema, y...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Desde cuándo has estado viviendo sola?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027h",head="mak_z1a",x=0,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002284",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué viene eso de repente?... Más o menos cuando ingresé al colegio Yumihari.\nQuimera me queda más cerca del colegio que mi casa.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has estado tratando de cubrir tú sola tus gastos de manutención y matrícula?\nSolo déjame preguntarte algo. Tienes muchos sentimientos en conflicto dentro\nde tu cabeza, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No me habías dicho que preferías resolver siempre todo de inmediato y quitarte\nrápidamente todos los pesos de encima?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",x=0,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002285",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Sí, lo dije! ¡¡Pero!!”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde que terminamos el mural y la directora comenzó a aparecer te la pasas\ndisculpándote todo el tiempo... Has estado muy dispersa, e incluso a veces te\nmuestras demasiado mansa.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Preferiría que resolvieras de una vez ese conflicto que llevas por dentro y\nvuelvas a ser esa misma chica con aroma a libertad, a la que no le importa un\nbledo lo que los demás piensen o digan. Si no lo haces pronto, no sabré cómo\nlidiar contigo.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002286",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Con aroma a libertad? Lo dices como si hablaras de una especie de aderezo...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y no lo es acaso? Esa no es tu verdadera esencia, después de todo.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a negar lo que acabo de decir, pero debo decir que te ves muy tierna\ncuando te dispersas. No me sienta tan mal que te pongas así.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002287",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué, estás tratando de decir?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Míralo así. La chica frente a mis ojos que usualmente pretende ser imponente y\nagresiva muestra de vez en cuando su verdadera y mansa personalidad. ¿No es\neso ya suficientemente moe?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005h",head="mak_z1d",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002288",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué dices?!”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Venga, venga, no te enojes. Si te enojas ahora solo lograrás darme la razón.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018h",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002289",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuu～～～～～～”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Toritani hace temblar sus puños y su cuerpo en cortos intervalos.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002290",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Toritani lanza un largo suspiro.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Es casi ejemplar lo sensato de su personalidad. Pensé que se dejaría llevar por\nla ira y me lanzaría una de sus patadas altas. Qué lástima.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Pero bueno, Toritani es así. Una chica extremadamente sensata.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002291",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dame la espalda.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La espalda?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=0,y=0,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002292",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Sí, voltéate ya!”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Entendido!”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"se",file="se9010",id=1,vol=60},
{"bg",y=100,x=0,speed=1000,zone="0x000000",file="zbg053a",path=":bg/",x2=300,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me doy la vuelta, dándole mi espalda. Por un breve momento, nada sucedió. Me\nquedo allí parado, sin voltear.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"se",file="se9010",vol=50,id=1},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=1,lv=5,id=9},
{"text"},
text={
ja={
{
"*ton*.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Algo cálido tocó mi espalda. Parece que Toritani puso su frente sobre mi\nespalda.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",mode=-2,sync=0},
{"bg",y=100,file="zbg053a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0,x=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9,sync=0},
{"bg",lv=9,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002293",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy preocupada.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002294",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo soportar quedarme sin hacer nada mientras veo cómo esa directora, la\nmisma que una vez fue una Nakamura, le trae problemas a los Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viendo nada más la manera en que te encargas del club de arte se hace obvio,\npero debo reiterar que realmente eres buena cuidando a los demás.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Toritani me reveló hace poco que todo su esfuerzo en el club de arte era\ntambién parte de su plan para ayudar a los dos genios. ¿Será que todas las\nacciones de Toritani tienen de raíz esa causa?",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Los dos genios...",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Esa es la realidad que Toritani ve, pero no necesariamente la misma realidad\nque ve el mundo. Aunque Kei es indudablemente un genio, eso sí.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Sin embargo, para Toritani, tanto Kei como yo... o para ser más precisos, las\npinturas que Kei y yo producimos, tienen tanto valor como para ponerlas en la\nbalanza con su vida escolar.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué más carga piensas poner sobre tus hombros ahora? Preocupándote por Kei y\npor mí y olvidándote de ocuparte de ti misma.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002295",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no es cierto. Yo solo actúo por cumplir mis caprichos.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso que llamas capricho no es ningún capricho, si necesitas algo simplemente\ndímelo y ya. Y úsame a tu antojo como siempre lo haces.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002296",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dios... Kusanagi, son justamente esas cosas que dices que...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002297",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002298",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002299",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Crees... que he logrado mantener mi fachada de fortaleza?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tu fachada de fortaleza? ¿De qué rayos hablas?”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002300",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, es que hace un momento mencionaste algo de la debilidad que muestro a\nveces, o algo así.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No mencione debilidad, dije 'mansa', ¿no?”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002301",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estar dispersa, mansa y sin poder valerme por mí misma. ¿Qué otra manera de\nllamarle hay aparte de 'debilidad'?”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso que muestras a veces no es debilidad, es simplemente tu verdadera cara.\nEres muy rígida con todo y te fuerzas demasiado por igual, y sin embargo se\nnota que no eres tan fuerte. Pero...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Créeme que lo has logrado. Te has mantenido fuerte hasta ahora. Te aseguro que\nnadie te ve como una debilucha.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002302",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo... menos mal entonces...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya llevamos 3 años de habernos conocido. No sé tú, pero pienso que deberías\nrelajarte y soltarte un poco más al estar con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002303",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No soy así porque quiera...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero igual estás tratando de vivir bajo la apariencia de fortaleza, incluso\nforzosamente, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002304",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues...”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé por qué tratas de vivir así, pero sea como sea, me parece linda esa\ndebilidad que muestras de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002305",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Entonces sí estoy mostrando debilidad?”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tanto. Y es por eso que estoy tratando de convencerte en que no hay problema\nalguno con que la muestres. Y mucho mejor si solo lo haces conmigo.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002306",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué... quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, obviamente estoy tratando de decir quiero a esa linda y frágil Toritani\npara mí.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0018",head="mak_z2a",lv=5,id=9},
{"quake"},
{"se",file="se2192",vol=50,id=1},
{"text"},
text={
ja={
{
"¡*dokoo*!",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿Oguh?!",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"¿Qué demonios fue eso, una embestida de cabeza? ¿¿¿Es que acaso me embistieron\nen la espalda con la cabeza???",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002307",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ahh! ¡¡Siempre tú!!”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"se",file="se9010",id=1},
{"mwact",act="rl"},
{"text"},
text={
ja={
{
"Toritani va empujándome con fuerza por la espalda.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, escucha, no tienes que empujarme tanto, puedo caminar solo.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Al tratar de voltear, una terrorífica voz llega a mis oídos.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002308",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si volteas te mato.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué palabras tan violentas.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002309",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Cállate y sigue caminando!”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien, ya entendí.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Ceso toda resistencia y sigo caminando mientras dejo que Toritani me empuje por\nla espalda.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002310",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002311",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te dolió, ¿verdad? Perdóname.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"se",file="se9010",vol=20,id=1},
{"text"},
text={
ja={
{
"Las manos que empujaban mi espalda se deslizan y comienzan a sobar la parte\ndonde recibí la embestida con la cabeza.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no dolió tanto. Y además, yo... también tuve parte de la culpa.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002312",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú no tienes culpa de nada...”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy consciente de que revelé demasiado mis verdaderos sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002313",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Tus... verdaderos... sentimientos?...”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, quiero hacerte solo m--”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002314",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Y-Ya, está bien!! ¡¡No hace falta que lo digas!!”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"se",file="se9038",vol=60,id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Toritani me empuja una vez más por la espalda, expulsándome de la azotea.\nOculta tras la puerta, me exigió a regañadientes que me fuera a clases.",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",vol=60,id=1},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002315",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
"Me apoyo de la pared de la azotea y caigo sentada al suelo, arrastrándome de la\npared. Seguramente tengo la cara tan roja que cualquiera que me viera se\nsorprendería.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002316",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Crees... que puedo asistir a clases con esta cara?...”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002317",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002318",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente eres... un tonto.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
