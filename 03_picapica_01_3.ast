astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="nightsky_spring",rule="083r",sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001846",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esp--, espera, yo solo pensaba en venir a ver a Kei por un pequeño rato...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, vamos, deja de quejarte. Ya llegamos acá, no hay problema con que te\nquedes un rato, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001847",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Un rato? No, esp--, deten--”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001848",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",id=-1},
{"se",file="se1279",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Siento a Toritani frente a la mesa del comedor, a la fuerza.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien? Te pusiste a ofrecer resistencia y acabé usando más fuerza de la\nque pensaba usar sin querer.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001849",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Físicamente estoy bien. Pero, quedarme a cenar no es...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000617",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, acepta la invitación. No está de más que vengas a comer de vez en cuando\nacá.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001850",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000618",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaa, siempre tan formal y distante con los demás como siempre, eh. No somos\nningunos extraños, y te estamos ofreciendo que te quedes a cenar, así que es\nde cortesía que aceptes la invitación.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001851",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pues, tal vez sea así, pero...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000619",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y además, la comida de Kusanagi es deliciosa.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001852",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Toritani se rinde de una buena vez por todas gracias a las palabras de Ai.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te hagas tantas expectativas, tampoco es que puedo preparar cosas tan\nelaboradas. En fin, dame unos 30 minutos.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",file="se9002",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=0,speed=200000,file="zbg003c",path=":bg/",x2=960,y2=0,x=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me meto rápidamente en la cocina.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Ya el arroz estaba cocinado, así que preparo todo lo demás sin mayor problema.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",file="se9016",id=1},
{"text"},
text={
ja={
{
"Frío la carne de res en tiras delgadas con algo de aceite, y luego rápidamente\necho setas de cardo, maitake, y champiñones. Al cocinarlas un poco, vierto\nleche.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Agrego algo de sal, pimienta, y como condimento secreto, garam masala y un poco\nde salsa. (Recomiendo el garam masala a aquellos que tengan algo de holgura\nen sus billeteras)",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Las cebollas saben mucho mejor cuando agarran un color marrón ligero, pero toma\ndemasiado tiempo saltearlas sin quemarlas. No me gustaría dejar esperando a\nToritani después de obligarla a quedarse.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Tomo además la lechuga que compré, le arranco las hojas y la lavo. Corto el\nrepollo en tiras, y lo acompaño con perejil y jamón.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"El perejil tiene un valor nutricional muy alto. En los restaurantes lo suelen\nservir como acompañante, pero es un desperdicio usarlo solo para eso. Es un\ntanto agrio, pero sirve muy bien como ingrediente para ensalada.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Normalmente no incluyo jamón, pero bueno, el plato de hoy está dedicado para\nnuestra huésped. Con agregar algo de jamón el sabor de la ensalada de\nlechuga, repollo y perejil mejora bastante.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Se podría también usar huevos hervidos picados en rodajas en su lugar.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",stop=1,time=500,id=1},
{"bg",time=500,file="bg003c",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, listo esto.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"No me alcanzó el tiempo para arreglar un menú de sopa y tres contornos, pero me\nparece que logré preparar algo nutritivo y balanceado.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Aunque bueno, la prioridad hoy es la velocidad. Logré preparar todo en menos de\n20 minutos.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"A veces me asombro de mí mismo.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",file="se9002",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpa la espera.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001853",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“G-Gracias...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000571",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que viniste a cenar hoy con nosotros, Toritani-san.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001854",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000572",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya se iba acercando la hora de la cena, así que bajé.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿qué hay de Kei?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000573",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Llamé a nii-san varias veces, pero dijo 'voy después'.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Otra vez?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001855",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Lo ha hecho con frecuencia últimamente?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni tan recientemente. Siempre que no puede alejar su manos al pintar deja la\ncomida para después. Aunque bueno, al final termina comiendo, así que no es\npara tanto.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001856",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x2=-345,x=-570,lv=4,id=9},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="藍",size="z1",mx=40,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000620",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque esta noche tenemos a Toritani acá, creo que por lo menos hoy deberíamos\nobligarlo a que venga a comer.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-570,lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001857",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, está bien. Prefiero que Kei siga pintando...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0010",head="aix_z1e",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_aid_000621",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Entiendo... Aunque yo quería que cenáramos todos juntos...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Iré de igual forma a avisarle que vino Toritani...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Me dirijo con dirección al depósito, donde está el atelier.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"se",file="se9004",id=1},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001858",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Y entonces, me doy cuenta de que Toritani ha venido siguiéndome.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Vuelve y come.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001859",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo haré, pero... quisiera ver cómo está Kei yo también.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pasa nada en particular, es el mismo Kei de siempre.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001860",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero se ha quedado encerrado en el atelier, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Aunque, siempre sucede lo mismo cuando está pintando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001861",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estará avanzando con su obra?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Aunque parece estar pasando bastante trabajo...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001862",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco lo he estado observando tanto, así que no sé realmente. Pero, a juzgar\npor la expresión que ha tenido en estos días, las cosas no parecen estar\nyendo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001863",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se2308"},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, hora de comer~”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei?... ¿Que no puedes responder tampoco?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001864",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Toritani agarra el borde de mi uniforme.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0003",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001865",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está durmiendo.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Durmiendo?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",file="bgm010",time=5000},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Al ver con cuidado, pude notar como Kei estaba respirando de manera periódica y\nserena, durmiendo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y además, muy hábilmente, sentado encima de la silla sin espaldar.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001866",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, dejémoslo tranquilo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Toritani colocó silenciosamente la bolsa con las rosquillas en un lugar donde\nKei pudiera notarlas al despertarse, pero donde además no hubiera peligro de\nque las pisara.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué está dormido?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Toritani señala algo con su dedo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Allí estaban apretujados todos los lienzos que hasta hace poco estaban\ncompletamente en blanco, todos ahora con algo escrito y dibujado.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero qué demonios... son demasiados...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0028",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001867",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei nunca se para a pensar. Simplemente pinta. Pinta y sigue pintando. Así es\nél.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... aunque, esta cantidad...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001868",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Seguramente aún no logra dar con algo que lo satisfaga. Dejemos que descanse.\nProbablemente no ha dormido casi nada, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",speed=1000,mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",x2=0,x=400,lv=5,id=9},
{"se",file="se1279",vol=40,id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001869",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque debo decir que este lugar es perfecto para pintar.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues son muy pocas las casas que realmente cuentan con un atelier. Aunque esto\nen realidad es un depósito.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001870",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero todo está dispuesto de manera muy bien calculada. Nada que sorprenda,\ntratándose del lugar de trabajo de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo usó hace mucho tiempo atrás.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001871",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001872",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, iré a comer para regresar.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya debe haberse enfriado la comida. Iré a calentarla de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001873",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Toritani y yo regresamos a la mesa del comedor.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001874",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Al fondo del pasillo de la entrada está aquella enorme pintura de desnudo.\nToritani estaba parada frente a ella, rígida.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que estabas acá.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001875",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si, vine porque no me dejaste ayudar lavando los platos, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy eres huésped en nuestra casa, puedes sentarte y relajarte sin tener que\nhacer nada. Y además, de igual forma has estado trabajando demasiado.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001876",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Realmente, cada vez tengo más y más deudas contigo.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No seas exagerada, solo fue una simple cena.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001877",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es ninguna exageración. El costo en alimentos, el costo en trabajo humano,\nel costo en luz y gas... Es un hecho que incluso para una simple cena, hay\nvarios costos involucrados.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001878",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y sí... Me has venido ayudando en todo tipo de tareas, desde las más\nimportantes hasta las más triviales...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues yo no recuerdo ninguna.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001879",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No es así como pasa siempre? Sea un acto para bien o para mal, la persona que\nlo hizo no suele recordar casi... o, simplemente no recuerda nada.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... bueno, quizás sea como dices.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001880",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, seguramente lo es.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Al susurrar eso, Toritani volvió a ver hacia arriba, donde estaba el cuadro de\n'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Su mirada era seria, y por alguna razón, me recordó a la misma mirada que tuvo\nal ver el mural.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Como si esa misma mirada atravesara la pintura y estuviera observando algo,\nalguna otra cosa――",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001881",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Toritani se vuelve hacia mí.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001882",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si, si yo realmente llegara a acceder a servir de modelo para un dibujo al\ndesnudo, ¿me pintarías?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Sentí como si su mirada me penetrara. Ni en su voz o expresión se sentía\nintención alguna de bromear.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani soltó un repentino suspiro, como si tratara deliberadamente de liberar\nla tensión contenida dentro de sí.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001883",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo siento, ignora eso. Olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001884",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Porque es injusto.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No se supone que eras capaz de hacer lo que fuera para cumplir tus objetivos?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001885",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es, lo que sea. Pero ¿sabes?--”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Toritani sonríe delicadamente. Me quedé sin palabras por un instante ante la\nclaro y pura de esa sonrisa.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001886",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun haciendo eso, no podré obtener lo que realmente quiero. Y aunque lo obtenga\nde una forma injusta y tramposa, no podré estar satisfecha con eso, de\nninguna forma.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001887",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y si eso llegara a pasar, me volveré incapaz de amar incluso aquello que logre\nobtener... No me gustaría para nada que eso pasara.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani vuelve a ver a 'Olympia'. Su mirada es distinta a la de hace un\nmomento. Está ahora contemplando el cuadro como tal.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001888",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es fantástica. Pero, la temática es ligeramente distinta... ¿Por qué le habrá\nhecho este cambio?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pudiste ver la diferencia de esta pintura con la original? Asombroso.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Es imposible ver la sutil diferencia que Toritani indicó de no conocer muy bien\nla obra verdadera.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001889",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, me gusta algo Manet. He reproducido algunas de sus obras, aunque no esta.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",mode=-2},
{"bg",file="ev_uni_c11_01",path=":ev/ev_uni_c11/",set="ev_uni_c11"},
{"text"},
text={
ja={
{
"Contemplo yo también a 'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"La mirada retadora de la mujer da una sensación de nobleza en ella, aun a pesar\nde ser una prostituta... Una diferencia muy sutil, eh... Por supuesto, el\ncambio que hizo fue premeditado y calculado. Pero ¿por qué Kenichiro Kusanagi\nhabrá forzado ese cambio?...",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"......",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esta pintura la pintó Kenichiro Kusanagi para su compañera de vida.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001890",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Su compañera de vida? ¿Eh, tu mamá?",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, también la puedes llamar así.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo tampoco conozco mucho de lo que sucedió, pero... según, parece que pintó\neste cuadro para salvar a mi madre.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001891",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Para salvarla?... Eso no suena muy bueno.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"Hay muchísima historia y circunstancias rodeando a esta casa, y a las personas\nque viven en ella también.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001892",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Sí, me lo imagino...",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"msgoff"},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001893",ch="mkd"},
},
ja={
{
name={"Makoto"},
"...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001894",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Aunque, a juzgar por lo que dices, parece que realmente tampoco sabes mucho de\nlo que verdaderamente sucedió.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"... ¿Qué quieres decir con eso?",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001895",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Yo también sé un poco, solo un poco, respecto a Kenichiro Kusanagi. Y también,\nacerca de Kotoko Natsume.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¿Sabes algo de la abuela Natsume?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001896",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Pues sí. Aunque parece que por tu lado no sabes nada respecto a la relación que\ntengo yo con la familia Natsume.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"Espera, espera, ¿es que tienes alguna relación con la familia Natsume?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001897",ch="mkd"},
},
ja={
{
name={"Makoto"},
"La tengo. No es directa, pero la tengo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001898",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Por eso es que lo sé. Sé que a todos ustedes les gusta meterse en los problemas\nde los demás y ayudar. Y sé también lo increíblemente amables y buenos que\nson...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001899",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Los Kusanagi son también de la familia Natsume, ¿no? En un principio.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"No me importa si es así en principio o no, mi apellido es Kusanagi. Nada más,\nni nada menos.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001900",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No me refiero a eso.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Entonces a qué?",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001901",ch="mkd"},
},
ja={
{
name={"Makoto"},
"......",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001902",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Hmm, ya veo. Claro.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué pasa ahora? ¿Por qué pones esa cara, como si de repente lo hubieras\nentendido todo?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001903",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Ah, lo siento, ¿quizás lo tomaste a mal? No lo dije en ese sentido, de\nverdad... Simplemente, sentí algo de envidia, ¿tal vez?",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Envidia? ¿Envidia de qué?",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001904",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Kusanagi, siempre hablas de tu padre como si fuera un extraño más, y has\nmencionado que realmente no llegaron a verse mucho, pero... de igual forma\npuedo sentir un vínculo de unión bastante fuerte en tu familia.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué rayos dices?",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001905",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Aunque bueno, no tengo intención alguna de abrir mi boca acerca de los asuntos\nde una familia que no conozco.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, sí, tal como lo dices, la relación que hay entre nuestra familia es\nbastante extraña. Todos se ven entre sí como rivales. El padre a su abuela,\nel hijo a su padre, y por el otro lado también. Y a pesar de eso, nos\nprotegíamos el uno al otro.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"Me parece que somos una familia bastante rara.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001906",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Eso es lo que me da envidia.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"No todo es color de rosa, también hay muchas dificultades al ser parte de esta\nfamilia. Para comenzar, nuestra millonaria abuela no le dejó ni un centavo a\nKenichiro Kusanagi, y Kenichiro tampoco me dejó nada a mí.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001907",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Oh, vaya, pero había escuchado que tú habías rechazado la sucesión de bienes.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"Uh... pues, no estás errada, pero...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001908",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Hmmm. Así que también en ese aspecto hay muchas circunstancias por detrás.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡N-No, espera, fui yo quien la rechazó, por mi propia voluntad! ¡No había\nninguna circunstancia o razón alguna para eso, para nada!",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001909",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No tienes por qué tratar de convencerme con tanto empeño. Nadie está negando lo\nque dices.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"T-Tienes razón...",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001910",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Fufufu, ah, vaya, qué familia tan misteriosa la tuya.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué quieres decir?",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001911",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Justamente por tenerse absoluta confianza entre todos es que a los ojos de los\ndemás se ven absurdos y misteriosos. De no ser así, entonces cualquier\nfamilia así terminaría desmoronándose fácilmente...",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"......",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"De no ser así, entonces cualquier familia se desmoronaría fácilmente', eh... Lo\ndice como si realmente supiera del asunto...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001912",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Supongo, que esta pintura también... es uno de los vínculos que une a tu\nfamilia.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani se da la vuelta, y le da la espalda a 'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001913",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Solo pensaba en pasarme un breve rato acá, pero... parece que me quedé\ndemasiado tiempo. Me voy ya, nos vemos.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"Te acompaño. Es peligroso que camines sola de noche.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"En ese instante.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"ex",time=200,func="wait"},
{"se",id=1,file="se1712"},
{"bg",file="連続斬撃_001",id=9,lv=9,rule=059,time=200,path=":cg/battle/",set="battle"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"Casi como volando, algo rozó mi flequillo a una velocidad que ni el mismo ojo\npodía captar. Fue ese sonido de '*ton*' que hizo Toritani al bajar su pierna,\nque finalmente me di cuenta que se trataba de una patada.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"cgdel",id=-1},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"Eso, fue...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001914",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No puedes subestimar las patadas altas que he venido perfeccionando con Thomas.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, espera, ¿eso no haría que tus pantaletas se muestren al momento de patear?",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",time=100,size=5,lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001915",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No pudiste verlas, ¿cierto? Adiós.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"se",file="se1279",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani agita sus manos y se marcha. Veo como se va caminando, sin miedo y con\naplomo.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"La conversación que tuve con Toritani en julio se cruza de repente por mi\nmente.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001003",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Aunque tú no lo pienses así, yo no puedo quedarme tranquila.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001004",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¡Una vida sin deudas con nadie!",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001005",ch="mkd"},
},
ja={
{
name={"Makoto"},
"De no lograr eso no puedo comportarme como realmente soy yo, la chica que no se\npreocupa por lo que los demás digan o piensen, ¿no te parece?",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"cgdel",id=-1},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Una vida sin deudas, no por nadie más, sino por ella misma. Es justamente esa\nvoluntad la que le da confianza a su andar.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Ahora solo, vuelvo a ver a 'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",file="ev_uni_c11_01",path=":ev/ev_uni_c11/",set="ev_uni_c11"},
{"text"},
text={
ja={
{
"La razón por la cual esta pintura fue creada... su significado...",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Para qué es creada una obra... Para quién es creada...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Esa razón...",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"msgoff"},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Volteo, pero ya Toritani no está.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"......",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001882",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Si, si yo realmente llegara a acceder a servir de modelo para un dibujo al\ndesnudo, ¿me pintarías?",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Las palabras de Toritani... su expresión, su mirada... eran muy serias.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Aprendí la lección. No, ya lo sabía desde un principio. Solo que ahora, la\nrealidad me restregó la verdad de nuevo frente a mis ojos.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Toritani está dispuesta a hacerlo.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Toritani posee una especie de pulcritud. Una pulcritud ante lo sexual, que se\npodría calificar de característica de una jovencita.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Por eso es que ella puede también, separar por completo lo sensual del arte.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"No cabe duda de que ella no sería capaz de sentir ni una pizca de lujuria ni\ndeseo al momento de realizar un dibujo al desnudo.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Aunque, bueno, en un principio, dibujar al desnudo es una situación en la cual\nno hay tiempo alguno para sentir deseo sexual. Ese aspecto también influye.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Si fuera en un lugar solitario y privado, en una sesión de uno a uno, entonces\nno podría negar por completo la posibilidad de que suceda algo, pero...\ndejando eso a un lado...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"A juzgar por la personalidad de Toritani, ella no diría esa clase de cosas sin\nque se tratara de una decisión firme y resoluta.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Así de fuerte es el deseo de Toritani de que yo pinte.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_02_1"},
{"text"},
linkback="block_00200",
},
label = {
top={block="block_00000",label=1},
},
}
