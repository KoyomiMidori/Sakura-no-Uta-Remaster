astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c04_01",path=":ev/ev_eye_c04/",set="ev_eye_c04"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm004"},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002097",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Buenos días. Creo que esta vez ninguno de los dos pudo dormir bien, ¿no?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no dormí casi...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002098",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues sí, fue al ver que el cielo estaba aclarándose que nos apresuramos a\ndormir...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Aunque aún después de eso tampoco pude dormir...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Mierda... y para más colmo, este empalme matutino está duro de sobrellevar...\nTeniendo a Rin acá, tampoco puedo masturbarme.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Después de todo lo que sucedió ayer, terminamos acostados en el mismo sofá,\ntoda la noche. Ya no sé si de verdad es un empalme matutino esto, o una\nerección de verdad, pero sea lo que sea, siento que voy a morirme si no me la\njalo una vez por lo menos.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002099",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uaaahh... qué sueño tengo. Iré a preparar el desayuno, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-30,x=790,file="zbg023a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z2",mx=40,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2c0100",face="c0001",head="rin_z2c",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002100",ch="rnd"},
},
ja={
{
name={"Rin"},
"～♪",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Rin, quien se levantó antes que yo, se aseguró de que yo despertara para luego\nentrar a la cocina de lo más normal.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Y mientras tanto, estuve viendo a Rin mientras se iba.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"De la sala se puede ver toda la cocina. Por supuesto, también puedo ver a Rin\ncocinando.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9002",id=1},
{"text"},
text={
ja={
{
"Me voy al lavabo.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Seguramente podré calmarme un poco lavándome la cara con agua fría.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Encuentro el lavamanos.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Al tratar de agarrar mi cepillo de dientes, veo que también está el set de\ncepillo dental que compré ayer en la tienda de conveniencia junto a Rin,\nantes de prepararnos para dormir.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Es de color rosado. Un color que nunca llegó a verse en esta casa...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Ese cepillo de dientes está justo al lado del mío.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué es esto?... Esta sensación de felicidad...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=0,speed=240000,file="zbg023a",path=":bg/",x2=960,y2=0,x=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al regresar a la sala, me siento en la mesa del comedor, sin tener nada que\nhacer.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te ayudo en algo?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002101",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hace falta. Espera solo un poquito más, ¿sí~?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Me siento en el escritorio de la sala, pero igualmente no tengo nada que hacer.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad no hace falta que haga algo?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002102",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que no. Ya terminé casi todo. Ah, Nao-kun, ¿tomas café por las\nmañanas?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo hago. Dame a mí un expresso, si puedes.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002103",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A su orden.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"No teniendo nada que hacer, prendo la TV sin propósito alguno. Están pasando\nlas noticias matutinas, pero no puedo concentrarme tanto como para prestarles\natención.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mx=-40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002104",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te importa si ocupo el frente?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, está bien...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Distintos platillos van ocupando la mesa del comedor.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se ven deliciosos, eh.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002105",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento, solo pude preparar lo que conseguimos ayer en la tienda de\nconveniencia, así que no pude cocinar nada muy elaborado...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, tranquila, ya con esto es suficiente...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002106",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, no tienes ningún gusto en específico, ¿verdad? ¿Tienes alguna alergia\no algo por el estilo?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay de qué preocuparse. Puedo comer lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002107",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Eso me tranquiliza.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"El menú de hoy es sopa Miso con tofu y wakame.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Natto.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Omelet.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Ensalada de rábano con salsa de umeboshi.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"No es ningún menú lujoso, ni muy suntuoso.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Pero ¿qué será esto? Esta indescriptible sensación de felicidad...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se_koton",id=1},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002108",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Toma, aquí está tu café. Y perdóname, el menú acabó como una mezcla de cocina\noriental y occidental...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, no me importa en lo absoluto.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002109",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Comamos entonces. Buen provecho.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buen provecho.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Tomo un sorbo de sopa Miso.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"El sabor no es aquel del caldo en polvo. El dashi para el Miso lo sacó de\nniboshi en agua.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está muy bueno, el caldo adquirió muy bien el sabor de la base.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002110",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Según vi, usan akadashi acá en tu casa, ¿no, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me gusta el akadashi.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002111",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es raro. ¿Aunque, no se supone que el caldo de katsuo combina mejor con el\nakadashi?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, pero el niboshi es más barato.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002112",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Realmente esa habilidad tuya para valerte por ti mismo es\nasombrosa, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002113",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Digo, solo pensaba que no hay nadie de tu edad que se preocupe por el precio de\nlos ingredientes al cocinar...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así son todos los que viven solos y sin dinero, ¿no? Aunque en mi caso, tengo\nmucho más tiempo y experiencia en esto que aquellos estudiantes\nuniversitarios que apenas comienzan a vivir por su cuenta, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002114",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ahora que lo dices, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, mamá era bastante estricta con el dinero. Supongo que de ahí habré\nsacado un poco también.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002115",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo haces con el dinero?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy usando los ahorros del dinero que papá le enviaba a mamá. Aunque sí,\nconsiderando la cantidad de dinero y el tiempo que me queda hasta que pueda\nbuscar empleo, supongo que no hay necesidad de vivir de esta forma tan\naustera...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002116",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, entonces ese es el resultado de la educación que te dio tu mamá.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, puede que economizar sea una especie de pasatiempo para mí. Y, bueno,\nToritani se burla de vez en cuando, diciéndome que después de todo lo mío es\nsolo un hobby.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002117",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que las cosas para Mako-chan están muy difíciles, ¿no? En lo que a\nmanutención se refiere.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al parecer peleó con su madre, así que ahora está cubriendo la matrícula y\ntodos los demás gastos por su cuenta. También estudia con frecuencia... De\nverdad, me pregunto en qué momento dormirá...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002118",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que también se salta las comidas con frecuencia.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a pesar de eso, cuando tratas de brindarle algo, comienza con lo mismo de\nsiempre. No quiero deudas, no quiero préstamos, blah, blah, blah.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002119",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así parece. Ya me ha pasado lo mismo con ella.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, supongo que también estará pasando por mucho... Según, es además\nla hija de esa directora.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002120",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La directora parece ser una buena persona, ¿no crees? Es muy hermosa, además.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hermosa? Pero si es una vieja.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002121",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te equivocas. Para la edad que tiene, es realmente hermosa. Y en primer lugar,\nesa forma de referirte a ella es muy descortés, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues tal vez, pero...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002122",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también quisiera envejecer así de hermosa...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de hermosa?...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"La madre de Rin era una mujer preciosa.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Así que tú también envejecerás con bastante hermosura, seguramente...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Quisiera decirle eso, pero no puedo.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"En parte por vergüenza, pero sobre todo eso, porque hablar de esta clase de\ntemas con Rin está prohíbido.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Observo a Rin.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Rin en unos cuantos años más, eh...",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Si sigo junto a Rin, podremos pasar el resto de nuestros días de esta forma...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Levantándome en las mañanas con Rin preparando la comida, para luego sentarnos\njuntos a comer.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Esa indescriptible sensación de plenitud.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Para mí, a quien la palabra 'cocinar' evoca solo la única idea de hacerlo todo\nyo mismo, me resultó sumamente agradable experimentar lo que es simplemente\nestar sentado esperando mientras alguien más prepara la comida.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"En especial, me resulta especial el hecho de poder pasar este breve pero\nplacentero rato en la mañana los dos, juntos.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002123",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? ¿Qué sucede? ¿Por qué me ves con esa cara?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"quake",mode="mw"},
{"excall",label="yesextrascene",cond="s.scene==1",call=0},
{"excall",label="noextrascene",cond="s.scene==0",call=0},
{"bgm",file="bgm004"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
labelcount=10,
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué cara tenía puesta?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002124",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo podría ponerlo? No era exactamente una sonrisa... era, como si estuvieras\ndisfrutando de algo...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Vaya que diste en el blanco, eh.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí lo estaba haciendo... no es de sorprenderse.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002125",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué estabas disfrutando?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, digo, ehm... pensaba, en lo feliz que soy ahora... Teniendo una novia tan\nlinda como tú, y que, además... me está preparando ahora el desayuno, en la\nmañana...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002126",ch="rnd"},
},
ja={
{
name={"Rin"},
"～～",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Rin, quien hasta ahora estuvo hablando con voz normal, baja la cabeza de\nrepente. Y entonces, con una voz muy débil...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002127",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es un honor para mí escuchar eso...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002128",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Me permitiste pasar la noche acá, y pudimos pasar todo este tiempo juntos...\nAún a pesar de que me hiciste tu novia hace tan poco...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, yo fui quien tuvo la culpa, no había nada de qué darte permiso...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002129",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... Ayer sucedieron bastantes cosas. Aunque también en parte por error mío...\nLlegaste a verme dos veces sin pantis, por ejemplo...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002130",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... ehm... es que...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002131",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Hay una razón por la cual esperé a levantarme del sofá después que Rin lo\nhiciera al despertarnos en la mañana.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Y sí, una razón muy obvia.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Los hombres entenderán que en las mañanas, pase lo que pase, nuestras partes\ninferiores despiertan con todas las pilas puestas.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Y para más colmo, de ayer a hoy.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"No había indicio alguno de que se calmaría, así que me lavé la cara con agua\nfría.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Y en eso, las cosas abajo se calmaron un poco, así que por ahora, lo único que\nestoy haciendo es fingir normalidad...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha... ehm, cómo podría decir esto... eh...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Así que, ahora que Rin me recordó de 'lo que sucedió ayer', mis partes privadas\nentraron de nuevo en posición de combate.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002132",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué pones de repente tus manos debajo de la mesa? No podrás comer así.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, digo, cómo podría explicarlo...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002133",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? ¿Qué pasa? ¿Estás escondiendo algo?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Rin echa un ojo por debajo de la mesa.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bgm",stop=1,time=1000},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002134",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0014",head="rin_z1a",lv=4,id=9},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002135",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002136",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Esto... será que...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo es.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002137",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿Es ese fenómeno que sucede en las mañanas y que provoca que se pare?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no exactamente... Al recordar como estabas ayer, se puso así...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002138",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Como estaba ayer...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Como estabas, sin pantis...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002139",ch="rnd"},
},
ja={
{
name={"Rin"},
"～～",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Perdóname...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002140",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... quisiera, preguntar algo...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002141",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hay forma... de calmar eso?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... por lo general logro calmarlo con algo de fuerza de voluntad...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, si me la jalo una vez, creo que debería calmarse...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002142",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿J-Jalar?!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no me prestes tanta atención. No es jalar, m-me refería a ir al baño.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002143",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Al tratar de levantarme de la silla e irme, Rin me agarra el brazo.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002144",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Quieres decir... que vas a 'hacerlo' por tu cuenta?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no realmente tengo que ir al baño. A-A orinar, sí.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002145",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estás mintiendo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, de verdad no estoy mintiendo...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002146",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De igual forma, no creo que puedas hacer pis en ese estado. Esto, cómo podría\nponerlo, eh... está, apuntando hacia arriba...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso lo sé... algo haré al respecto, tranquila.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002147",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Algo? ¿Qué piensas hacer? Si vas en ese estado el pis saldrá hacia arriba.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehh, ¿si me paro de cabeza, quizás funcione?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002148",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es imposible.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Si me la jalo una vez antes de eso se calmará.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002149",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que sí pensabas hacerlo solo, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah... eh...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Rin agarra mi mano, mientras yo titubeaba.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002150",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces, a-acá...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002151",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No podrías... liberarlo todo, acá?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002152",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, sería descabellado que entráramos los dos al retrete.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002153",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que, si voy a ayudarte, entonces sería mejor agarrar un lugar más amplio\ncomo este...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué se supone que ahora debes ayudarme?!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002154",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que, eso... es por mi culpa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que por tu culpa, diría que es tal vez gracias a ti, pero... realmente no\nsé cuál de las dos.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002155",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si es así, entonces yo lo haré.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Digo eso con una cara algo exasperada.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, escucha, Rin, la cuestión no es de quién es la culpa acá. El hecho de que\nsientas responsabilidad por algo como esto me pone en una situación algo\ncomprometedora.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes de qué preocuparte, yo mismo haré algo para solucionar esto.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hii.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Siento su mano sobre la punta de mi pene.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Sin querer, termino soltando la voz.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bgm",stop=1,time=1000},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002156",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De verdad que no tengo remedio...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",file="bgm103"},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002157",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002158",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En realidad no es por sentir responsabilidad ni nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Q-Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002159",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sabes, Nao-kun... yo, simplemente... Esto... quiero, ayudarte. S-\nSimplemente, quiero hacerlo y ya.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002160",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Así que, Nao-kun, si de verdad te desagrada, dejaré de hacerlo. Lo siento...\ncreo que quizás, me emocioné mucho...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Rin, ahora frente a mis hinchados pantalones, me observa desde abajo con una\ncara agobiada en preocupación.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002161",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que realmente soy una pervertida.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que de verdad me desagradaría?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002162",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso ahora, tu mano está tocando mi punta... y se siente muy bien.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0022",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002163",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Eh, ah, lo siento mucho!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Rin aleja su mano, alterada.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿No fue a propósito acaso?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002164",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento, solo tenía la intención de tocar la zona de tu estómago...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... Asume tu responsabilidad entonces.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002165",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Responsabilidad?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Digo, ehm... se sintió muy bien cuando me tocaste... Si alejas la mano como\nacabas de hacerlo, siento que no podré conservar la calma.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002166",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡A-Ah, sí!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",mode=-2},
{"bg",file="ev_rin_h04_01",path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002167",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Sentí de nuevo una suave presión sobre mis genitales.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002168",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002169",ch="rnd"},
},
ja={
{
name={"Rin"},
"... ¡*traga saliva*!",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que tuviste un lapso bien largo, eh...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002170",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, eso fue el tiempo que el asombro tardó en llegar a mi cerebro...\n¿supongo?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene de asombroso?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002171",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... la verdad, es que se me hace algo difícil elaborar la explicación\npara esa pregunta. Aunque, de verdad llegan a ponerse de esta forma... Son\niguales a los que salen en los mangas pervertidos, así que me sorprendí.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tus estándares son en base a mangas eróticos?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002172",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues es que, el único conocimiento que tengo vienen de ellos. Ah, pero hay\nmuchas cosas que se pueden aprender de los mangas. Con lo hinchado que está\nahora, no se apaciguará tan fácilmente, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es así. Así que no tienes por qué forzarte tanto a hacer esto...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_rin_h04_02",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002173",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No estoy forzándome a nada. Estoy haciéndolo porque quiero y porque me gusta.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio eso?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002174",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que lo es. Me gusta tocar tu cuerpo, Nao-kun... me gusta tanto que\npor eso terminaste enojándote conmigo ayer, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cuando estábamos en las lecciones de pintura ayer... Te regañé porque\nestábamos aún en medio de la lección...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, tocar esa parte en específico es algo totalmente distinto a tocar los\nmúsculos.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002175",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es completamente diferente. Esto es aún más excitante...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002176",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo basta que digas 'para ya' y me detendré... Así que, ¿me permitirías\ntocarte?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002177",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quiero tocar todos los rincones de tu cuerpo, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"No hay forma de que pueda rechazar esa oferta después de escuchar todo eso...\nAsentí ligeramente.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",file="ev_rin_h04_03",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002178",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waa, qué duro está...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002179",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así de duro se pone... Jaa, jaa... jaaaaa.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Rin manosea y toquetea agitando su respiración, sin vacilación alguna por poner\nsus manos sobre mi erección.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002180",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaaa... fuu... fuuuu... increíble, realmente se pone duro.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Otra opinión basada en los mangas?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002181",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí. Y también, creo que de parte de mi imaginación también.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tu imaginación?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002182",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. ¿No recuerdas como buscábamos mangas pervertidos juntos, Nao- kun? Era\ninevitable que acabara imaginándome cosas.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Imaginar qué?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002183",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Imaginarte y meterte en las historias, Nao-kun. Mientras leía esos mangas\npervertidos, pensaba... 'ah, ¿será que Nao-kun también se pone así?'.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002184",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, creo que realmente buscarlos y leerlos junto a ti fue una experiencia\ntemprana muy impactante y fuerte... Una experiencia de carácter sexual para\nmí...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002185",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh, es tal como lo imaginaba... Increíble. Jaa, jaa, jaaaa... Así que, así se\npone tu cosa cuando estás excitado...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"De la respiración de Rin se puede notar como su excitación va acrecentándose.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bg",file="ev_rin_h04_04",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002186",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Acaba de moverse, como palpitando... Se movió.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002187",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Esta clase de cosas sucede inconscientemente?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ni idea. Jamás me he puesto a pensar al respecto.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002188",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, aunque yo tampoco sé muy bien cuándo exactamente me da una contracción,\nasí que supongo que sí lo será... Ngh, mn... mmm.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Rin empuja fuertemente mi pene con la palma de su mano y lo frota junto con el\npantalón, con tanto impulso que se puede escuchar fuertemente el sonido del\nroce de la ropa.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"bg",file="ev_rin_h04_03",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002189",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta sensación de algo sobresaliendo de tu ropa, es algo sucia...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Eso piensas? En mi caso, es parte de mi propio cuerpo, así que no tengo\nforma de saberlo bien... Ngh.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"A duras penas pude encubrir el hecho de que mi voz está agitándose ante los\nfuertes estímulos que me invaden.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002190",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te dolió?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002191",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Se sintió bien entonces?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002192",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿quizás no debería preguntarte eso?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es que no puedas, pero...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002193",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da vergüenza responder eso.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"bg",file="ev_rin_h04_05",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002194",ch="rnd"},
},
ja={
{
name={"Rin"},
"*zokuzoku*...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué sacas una sonrisa?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002195",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Estaba sonriendo?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue una gran sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002196",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, ya veo, así de fácil se notó en mi expresión...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por completo, diría yo.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bg",file="ev_rin_h04_03",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002197",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, es que, al ver cómo te sentías avergonzado, un temblor corrió por mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un temblor?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002198",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, un temblor.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Rin acerca su cara a la zona de mis genitales, como si fuera a frotar sus\nmejillas sobre ellos.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, n-no hagas eso...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002199",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero desde hace rato está latiendo fuertemente dentro de mi mano...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002200",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Esta es la prueba de que has acumulado mucha tensión, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Rin me observa como de reojo, deslizando sus ojos hacia arriba.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿V-Vas a... decir eso ahora?...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002201",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿estás muy tenso?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002202",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De ser así, creo que no vas a lograr calmar las ansias a menos que te toque\ndirectamente con mi mano.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa? ¿Pretendes ahora comenzar un juego sexual de humillación?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002203",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no es eso. Es un simple favor que quisiera pedir de mi parte.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un favor?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002204",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Solo quiero pedirte que me permitas hacer lo que quiero hacer.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",file="ev_rin_h04_05",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002205",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quiero tocar directamente tu pe*e, Nao-kun. Nao-kun, déjame tocar tu pe*e\ndirectamente, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gh...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Rin me observa. La verdad es que para estar pidiendo un favor, su mirada es\nalgo retadora...",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002206",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muy bien. Nao-kun, puedo quitarte esto entonces, ¿verdad? Voy a ver todo lo que\ntienes debajo, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... n-no vengas ahora con esa forma tan vergonzosa de decir las cosas.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"bg",file="ev_rin_h04_03",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002207",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es cierto, solo estoy pidiéndote el favor. Nao-kun, muéstrame tu pe*e,\npor favor.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"se",file="se_zubon_out_long",id=1},
{"text"},
text={
ja={
{
"No tengo ni la más recóndita idea de quién realmente está pidiéndole el favor a\nquien ahora. Rin afloja la correa de mi pantalón, y lo desengancha...",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_rin_h04_06",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002208",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waah...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Te sorprendiste?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002209",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, creo, que me sorprendí...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Lo que acabas de ver no era lo que te imaginabas? ¿Es eso?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002209b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no es eso. ¡Era justo como lo imaginaba!”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“J-Justo como lo imaginabas... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002210",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, en los mangas dicen que el pe*e es distinto de persona en persona, y el\núnico conocimiento que tengo de esto viene de los mangas, así que pensé, 'Ah,\nen realidad el de Nao-kun debe ser totalmente distinto'.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002211",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero al tocarlo ahora me di cuenta de que era igual a como me lo imaginé\ncuando lo acaricié por encima del pantalón.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Igual a como lo imaginaste al acariciarlo por encima? Qué imaginación tan\nvivida tienes.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002212",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mis capacidades fantasiosas están a un nivel superior.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y? ¿Qué opinión tienes ahora al saber que fue justo como lo imaginaste?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002213",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mi opinión? Mmmm. Cómo podría decirlo...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Rin baja la cabeza.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002214",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, ¿puedes ver mis piernas desde donde estás?”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tus piernas? Pues, de que puedo, puedo...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002215",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Mis piernas, se están tambaleando, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Ahora que lo menciona, las piernas de Rin están temblando.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002216",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace un rato te pregunte si tu cosa se movía de forma inconsciente, aunque\nparece que esa fue una pregunta muy estúpida.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002217",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y es que, eso mismo está ocurriendo ahora en mi cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002218",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tengo ninguna opinión ni nada al respecto. Mi cuerpo reaccionó más rápido\nque mi cabeza, y lo está haciendo ahora, palpitando.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002219",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002220",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Así que, ¿podrías mostrarme mejor?”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, si así lo deseas...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"bg",file="ev_rin_h04_07",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002221",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaaa... increíble, esto es increíble...”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"Después de recibir mi permiso, Rin acercó más su cuerpo hacia mí.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002222",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mira nada más... Jaa... haaaa... pero qué forma tan sucia y pervertida tiene...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"La voz de Rin va alterándose.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002223",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ¿puedo... tocarlo ya?...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"bg",file="ev_rin_h04_08",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"quake",size=4,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ah, uwaah.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002224",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah!...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002225",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Brincó... así que de esta forma es que brinca... Asombroso, está bastante\ncaliente dentro de mi mano...”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh... uh.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"A pesar de tener la cara roja, la sensación de la palma de su mano es más\ngélida de lo que esperaba. Y esa sensación se imprime con fuerza en lo más\nprofundo de mi cerebro.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"bg",file="ev_rin_h04_09",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002226",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa... pareciera que toda la sangre del cuerpo estuviera acumulada aquí.\nRealmente está congestionado de sangre. Tan rojo, y tan caliente...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Rin empuja la palma de su mano sobre mi pene una, y otra, y otra vez, como si\ntratara de palpar y revisar su forma.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002227",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nm... haaaa, qué caliente.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
"Va rozando sus dedos desde abajo hasta arriba, acariciando lenta y suavemente\nla zona curva de la corona del glande.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002228",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waah, qué sensación tan sucia. ¿Puedo tocarlo con algo más de fuerza?”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Asiento ligeramente.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"bg",file="ev_rin_h04_10",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mnn!”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Al ella agarrarme firmemente la base de mi pene, se me escapó un gemido.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002229",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ah... increíble.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso fue por el estímulo tan súbito que me diste...”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002230",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te dolió?”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no duele... Kuh.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002231",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, Nao-kun, así que tú también gimes... Haaa... ese gemido fue tan sensual.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No lo digas de esa forma...”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"bg",file="ev_rin_h04_11",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002232",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, puedes soltar más la voz, no hay problema. Quiero escuchar más de esos\ngemidos.”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-A mí no me gustan para nada los gemidos de los hombres...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002233",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿no te gusta hacerlo? Pero, esta parte acá está soltando unos sonidos\nmuy sucios.”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"La mano de Rin comienza a deslizar mi miembro lenta, pero seguramente.",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002234",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Presta atención, ¿puedes escuchar ese sonido? Es como *kuchu*, *kuchu*. Es\nbastante sucio ese sonido. Fuuu... creo que ahora siento un olor muy\npervertido viniendo de ti, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, kuh... ¡Uh!”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002235",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se te escapó la voz de nuevo. Creo que de verdad me estremece tu voz, Nao-kun.\n¿No podrías darme a escuchar un poco más tus gemidos de placer?”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya, te dije, que a mí eso no me... Kuh.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002236",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que las palpitaciones venían con mayor frecuencia, pero parece que no. Y\nademás, cada vez que palpita, un líquido muy sucio sale de adentro. Qué\nindecente esto. No sabía que el cuerpo de los chicos fuera tan sucio.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Rin rodea sus dedos alrededor de la cabeza de mi miembro y lo pincha, ya este\ncomenzando a humedecerse con líquido preseminal.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002237",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo tu cuerpo palpitó. La punta de tu pe*e está tan hinchada ahora... Ahhh,\n¿qué hago? ¿Qué pasaría si te soplo acá?”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera... ¡Ngh!”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002238",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fuuu...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, kuh...”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002239",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Se siente bien? ¿Se siente bien nada más con mis soplidos?”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que... Uah.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002240",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo estoy soplando, más nada. Así de sensible está entonces, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque estás agarrándolo fuertemente con los dedos...”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002241",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, apreté esta sucia parte de la punta. Creí que haciendo eso se pondría más\nsensible.”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002242",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿puedo mover la mano?”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, e-espe--, kuhhhh.”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002243",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, lo siento, terminé moviéndolo. Pero, Nao-kun, mira nada más lo mojado y\nsucio que está esto. Mis dedos no pudieron evitar moverse...”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, auh... ah.”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002244",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Asombroso, está soltando un sonido líquido, como chapoteante. Qué sucio... así\nque de esta forma se comporta el pe*e. No es muy diferente a las partes\nprivadas de las chicas.”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"Con los dedos pinchando la punta con una agradable presión, ella comienza a\ndeslizar lentamente mi miembro hacia arriba y hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa... kuh.”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002245",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh, tu respiración está tornándose más sucia a medida que muevo mis manos.\nJaa, jaa, qué sensual la forma en que respiras ahora, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso no...”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
"A pesar de que el roce no es tan fuerte, siento como si me estuviera chupando\ntoda la cordura.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002246",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quizás debería aprovechar el impulso de la muñeca?... ¿Así, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002247",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así... frotando hacia arriba y hacia abajo... Wah, volvió a palpitar, y salió\nmás de ese sucio líquido.”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Rin mueve sus dedos, como tratando de inspeccionar algo, mientras observa mi\nreacción.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002248",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble... ¿Tu pene siempre se pone así?”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-La verdad es que, no tanto así cuando lo hago sol-- kuh.”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002249",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, me lo imagino. Sería laboriosa la limpieza después de masturbarte si\nsiempre saliera tanto de ese sucio líquido.”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002250",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero hoy es un día especial, ¿sí? Y por eso puedes ensuciar todo lo que\nquieras. Puedes ensuciar mi mano con tu cosa todo lo que quieras, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auuh.”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002251",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaaa... asombroso, asombroso. Tu pe*e está totalmente mojado. Esto es tan\nsucio... Nao-kun, te ves tan indecente...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
"La expresión de Rin demostraba diversión, pero también consideración por mí.",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
"El placer del movimiento de sus dedos, que se movían a un tempo intermedio\nentre una masturbación forzada y una servicial, va recubriendo poco a poco mi\nconciencia.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002252",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble, tengo la mano pegajosa y mojada. Nao-kun, tu pe*e es verdaderamente\nsucio. Kuh... uhh...”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"La respiración de Rin va agitándose cada vez más.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"La sola idea de que Rin se saliera con la suya sin yo poder contraatacar de\nalguna forma me sacó de quicio.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Y mientras observa firmemente mi pene, como si tratara de grabárselo en su\nmemoria, le pregunto.",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin, ¿piensas 'hacerlo' por tu cuenta después recordando lo que estamos\nhaciendo ahora?”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"bg",file="ev_rin_h04_12",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002253",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eh...”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"bg",file="ev_rin_h04_13",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002254",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002255",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... ¿Me crees... capaz de no hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002256",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es demasiado obvio. No hay forma de que no termine haciéndolo luego yo sola,\ndespués de verte así, Nao-kun... Jaa, jaaaa... asombroso. Nao-kun, tu cosa...”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
"Rin pasa su mirada entre mi cara y mi pene, ahora derramando fluídos\npreseminales.",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002257",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Jaa, haaaa... está tan caliente...”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002258",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... no pensé que tu cuerpo hubiera crecido tanto... Jaa, jaaa...”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"bg",file="ev_rin_h04_14",path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002259",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Mm, mm... Jaa, jaa, jaaa...”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
"La respiración de Rin va alterándose cada vez más mientras esta frota mi pene\nhacia arriba y hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"bg",file="ev_rin_h04_15",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002260",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mm... mm, m...... ng, ng, ng...”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002261",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... nnn...... Fuuh... fuhhh... nngh... nmmm.”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002262",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahn... fuh... fuhhh, fuu, fuu... fuu, fuu, fuu... nmm... ngh...”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002263",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngaaahhh...”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, R-Rin... ¿Estás... haciéndolo sola...?”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002264",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, ¿me descubriste? Kuh... fuh... nggh.”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002265",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es que... no hay forma de poder resistirme a esto... ngah... fuh... fuuuh,\nngaahh... no puedo, resistirme, al verte actuar de esta forma tan sucia,\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Te excitaste tanto que no puedes aguantarte ahora? Kuh.”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002266",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kuuh... l-lo sientoooo...”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002267",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... No puedo desperdiciar la oportunidad, déjame hacerlo, por favor.”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que quieres que te deje hacer?”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"bg",file="ev_rin_h04_14",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002268",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te parece injusto que sea yo el único humillado en este juego? Kuh... Dime\nclaramente, qué es lo que quieres hacer...”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"bg",file="ev_rin_h04_15",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002269",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? No me hagas estooo. Fuh... fuh, fuh, fuh... ngh.”",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres que te deje hacer?”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"bg",file="ev_rin_h04_16",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002270",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Mast... ¿D-De verdad tengo que decirlo? Ng, nmmm...”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya empezaste a mover tu mano, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"bg",file="ev_rin_h04_15",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002271",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... no puedo detener mi mano... kuh... hauun... fuh... fuh, fuh, fuh...\nngh.”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces dilo.”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002272",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, eres muy malicioso... Ya lo sabes, no me hagas decirlo... Jaa,\nhauhh... fuh, hau... ngh.”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
"Aun en este instante, la mano de Rin seguía moviéndose con afán dentro de sus\npantaletas.",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tanto es que sepa, sino que puede verse por completo desde acá... kuh.”",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"La mano de Rin frotando mi pene se acelera.",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002273",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaaa... es que, está tan caliente, y duro... y mojado, y sucio...”",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y eso te encendió?”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002274",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh, ahhhh... no, he estado así desde un principio... nm, nmm, nghh...\nperdóname... Jaa, jaa, jaaa...”",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"bg",file="ev_rin_h04_17",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002275",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, el olor... *kunkun*, conque así huele... Jaa, haaaa... nm, nnn...”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
ja={
{
"Rin hace sonar su nariz y acerca su cara hacia mi miembro, tanto que ya casi\nhace contacto físico con él.",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002276",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Desde hace un buen rato me llamaba la atención. Pero, pensé que me verías como\nuna rara si me observaras oliéndolo de esta manera tan evidente... Kuh...\nhauun... hauh... fuh, fuh, hauh... ngh.”",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002277",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ya no puedo resistirlo más. Nao-kun, ¿podría oler más de tu cosa?”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002278",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*kunkun*... *inhala*, *exhala*, este, olor, es increíblemente obsceno. Es tan,\nsuciooo. Kuh... fuun... hauh... hauh.”",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
ja={
{
"Rin olfatea todos y cada uno de los rincones de mis genitales.",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"bg",file="ev_rin_h04_17",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002279",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, me, estoy derritiendo... me estoy derritiendo aún más que antes...\nJaa, haaa, qué sucio. Es, tan sucio...”",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002280",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*kunkun*... *kunkun*... ngh, nn... mmm... haaaa... ah...”",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"text"},
text={
ja={
{
"El sonido de su nariz olfateando se entremezcla con el sonido de su mano\nchapoteando dentro de sus mojadas bragas.",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin, ¿tú también lo estás disfrutando?”",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002281",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... es increíble. Siento que en cualquier momento mi cuerpo podría\nderretirse...”",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Masturbándote?”",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002282",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, se siente asombroso masturbarme mientras froto tu pe*e, Nao- kuuun...\nHauun, fuh... fuh, fuh... nnm.”",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Al fin usaste la palabra 'masturbación'... Kuh.”",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002283",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es que, al oler tu pe*e... mi cabeza se paralizó, y... es que, tu cosa, es\ntan sucia, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y entonces sin pensarlo, se te salió de la boca.”",
{"rt2"},
},
},
},
linkback="block_00428",
linknext="block_00430",
},
block_00430={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002284",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaaa... aún, con lo vergonzoso que es...”",
{"rt2"},
},
},
},
linkback="block_00429",
linknext="block_00431",
},
block_00431={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002285",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso... es que quizás, estoy sintiéndolo con más intensidad que de lo\nnormal... kuh.”",
{"rt2"},
},
},
},
linkback="block_00430",
linknext="block_00432",
},
block_00432={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Más de lo normal?”",
{"rt2"},
},
},
},
linkback="block_00431",
linknext="block_00433",
},
block_00433={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002286",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las otras veces no se comparan a ahoraaa. Está tan, tan pegajoso... mi...”",
{"rt2"},
},
},
},
linkback="block_00432",
linknext="block_00434",
},
block_00434={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002287",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00433",
linknext="block_00435",
},
block_00435={
{"text"},
text={
ja={
{
"Rin no puede contestar entre solo jadeos y gemidos.",
{"rt2"},
},
},
},
linkback="block_00434",
linknext="block_00436",
},
block_00436={
{"text"},
text={
ja={
{
"Mueve su boca, cerrándola y abriéndola, para decir algo.",
{"rt2"},
},
},
},
linkback="block_00435",
linknext="block_00437",
},
block_00437={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002288",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... va, gi... na...”",
{"rt2"},
},
},
},
linkback="block_00436",
linknext="block_00438",
},
block_00438={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002289",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auuhh, esto me da tanta penaaaa... kuhaa.”",
{"rt2"},
},
},
},
linkback="block_00437",
linknext="block_00439",
},
block_00439={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002290",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero se siente bien... Jaa, jaa, kuun... hauh... fuh, nnn.”",
{"rt2"},
},
},
},
linkback="block_00438",
linknext="block_00440",
},
block_00440={
{"text"},
text={
ja={
{
"Rin saca su mano de sus bragas y las extiende hacia mí, con una expresión de\nabsorto éxtasis en su rostro.",
{"rt2"},
},
},
},
linkback="block_00439",
linknext="block_00441",
},
block_00441={
{"text"},
text={
ja={
{
"Ese pegajoso y traslúcido fluido se engancha entre sus dedos, formando hilos.",
{"rt2"},
},
},
},
linkback="block_00440",
linknext="block_00442",
},
block_00442={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00441",
linknext="block_00443",
},
block_00443={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002291",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así estoy ahora... Soy una pervertida, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00442",
linknext="block_00444",
},
block_00444={
{"text"},
text={
ja={
{
"Sus dedos, de vuelta de nuevo ahora en su ropa interior, me hacen llegar hasta\nmis oídos el sonido de sus fluidos chocando.",
{"rt2"},
},
},
},
linkback="block_00443",
linknext="block_00445",
},
block_00445={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002292",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero no puedo detenerlo. Después de haber sentido tu cosa, no puedo detenerme\nahora... Jaa, jaa, jaa, jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00444",
linknext="block_00446",
},
block_00446={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002293",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh... kuun... fuh... ngh, N-Nao-kun, tu cosa, ya está lista, para hacer el\namor, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00445",
linknext="block_00447",
},
block_00447={
{"text"},
text={
ja={
{
"Al asentir con la cabeza sin decir una palabra, los ojos de Rin se entrecierran\npoco a poco, dando un aspecto extasiado.",
{"rt2"},
},
},
},
linkback="block_00446",
linknext="block_00448",
},
block_00448={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002294",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si es así, entonces esto... debería entrar...”",
{"rt2"},
},
},
},
linkback="block_00447",
linknext="block_00449",
},
block_00449={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002295",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está tan grueso... y largo, y tan duro... ahhh, tan caliente... ¿Qué pasaría,\nsi esto entrara acá?...”",
{"rt2"},
},
},
},
linkback="block_00448",
linknext="block_00450",
},
block_00450={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002296",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahah, ¿debería rozarlo de esta forma? O... ngh...”",
{"rt2"},
},
},
},
linkback="block_00449",
linknext="block_00451",
},
block_00451={
{"text"},
text={
ja={
{
"Rin vuelve a mostrarme una vez más la mano que tanto empapaba dentro de sus\nbragas.",
{"rt2"},
},
},
},
linkback="block_00450",
linknext="block_00452",
},
block_00452={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002297",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... son mis, asquerosos fluidos...”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002298",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así como tú... no, están aún más mojados...”",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002299",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que... observa, mezclaré mis fluidos... con los tuyos, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
block_00455={
{"text"},
text={
ja={
{
"Y entonces, agarró firmemente mi pene con su mano bañada en sus líquidos.",
{"rt2"},
},
},
},
linkback="block_00454",
linknext="block_00456",
},
block_00456={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002300",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aahhh... se mezcló con tus líquidos, Nao-kun... Es tan sucio esto...”",
{"rt2"},
},
},
},
linkback="block_00455",
linknext="block_00457",
},
block_00457={
{"text"},
text={
ja={
{
"Rin mueve su muñeca violentamente una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00456",
linknext="block_00458",
},
block_00458={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera...”",
{"rt2"},
},
},
},
linkback="block_00457",
linknext="block_00459",
},
block_00459={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002301",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Prefieres que lo haga rápido?”",
{"rt2"},
},
},
},
linkback="block_00458",
linknext="block_00460",
},
block_00460={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al, al revés... d-desde hace un buen rato estoy conteniendo las ganas de venirme,\nkuh.”",
{"rt2"},
},
},
},
linkback="block_00459",
linknext="block_00461",
},
block_00461={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002302",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no hace falta que hagas eso... vamos, al salir sonará algo así como *pyuu*,\n¿verdad? Suéltalo todo, ¿sí? Quiero ver cómo eyaculas, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00460",
linknext="block_00462",
},
block_00462={
{"text"},
text={
ja={
{
"Ella acelera el movimiento de su mano derecha, tratando de ponerme contra las\ncuerdas aún más.",
{"rt2"},
},
},
},
linkback="block_00461",
linknext="block_00463",
},
block_00463={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002303",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sácalo todo afuera haciendo *pyuuu* y disfrútalo... ng, ngh, ngh... ah, ahhh...”",
{"rt2"},
},
},
},
linkback="block_00462",
linknext="block_00464",
},
block_00464={
{"text"},
text={
ja={
{
"Rin concentra todo su ser en mi pene, luciendo casi a punto de babearse.",
{"rt2"},
},
},
},
linkback="block_00463",
linknext="block_00465",
},
block_00465={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002304",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, haaa... ah, ah, increíble... yo también, yo también estoy vuelta un\ndesastre, por dentro... ah, Jaa, jaa, haaa... ya no logro discernir nadaaa.”",
{"rt2"},
},
},
},
linkback="block_00464",
linknext="block_00466",
},
block_00466={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tanto?”",
{"rt2"},
},
},
},
linkback="block_00465",
linknext="block_00467",
},
block_00467={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002305",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues... ngaah, Jaa, jaa, y-ya está tan mojado por dentro, y tan sensible... que\nya no sé dónde está nada, y tanto, que la ropa interior no pareciera,\nservirme de nada... ahh, ngah, ngah, nngahh...”",
{"rt2"},
},
},
},
linkback="block_00466",
linknext="block_00468",
},
block_00468={
{"text"},
text={
ja={
{
"Sus gemidos se volvieron aún más fuertes y largos. La cara de Rin, quien está\nclaramente excitada, está tras mi pene.",
{"rt2"},
},
},
},
linkback="block_00467",
linknext="block_00469",
},
block_00469={
{"bg",file="ev_rin_h04_18",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002306",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahhh, aaaahhhh... cosas sucias... estoy... haciendo, cosas sucias... cosas\nsucias, con, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00468",
linknext="block_00470",
},
block_00470={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah... espera... ¡ngh, nn!”",
{"rt2"},
},
},
},
linkback="block_00469",
linknext="block_00471",
},
block_00471={
{"text"},
text={
ja={
{
"Estuve a punto de venirme. Rin, al verme aguantar con todas mis fuerzas\npresionando mi abdomen, comenzó a acelerar aún más su muñeca.",
{"rt2"},
},
},
},
linkback="block_00470",
linknext="block_00472",
},
block_00472={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002307",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, jaa, ¿sientes que te vas a ir?... ¿Puedes irte? ¿Sientes que te vas\ncon esto?”",
{"rt2"},
},
},
},
linkback="block_00471",
linknext="block_00473",
},
block_00473={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... S-Sí.”",
{"rt2"},
},
},
},
linkback="block_00472",
linknext="block_00474",
},
block_00474={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002308",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aahh, vas a correrte, ¿verdad?... Nao-kun, vas a eyacular gracias a mi mano...\nhauun... kufuuh... fuh... hauh... ngh...”",
{"rt2"},
},
},
},
linkback="block_00473",
linknext="block_00475",
},
block_00475={
{"text"},
text={
ja={
{
"El sonido de nuestros fluidos corporales chocando y enredándose entre sí y el\nde nuestras agitadas respiraciones resuena dentro de la habitación.",
{"rt2"},
},
},
},
linkback="block_00474",
linknext="block_00476",
},
block_00476={
{"text"},
text={
ja={
{
"Fue Rin quien cedió primero.",
{"rt2"},
},
},
},
linkback="block_00475",
linknext="block_00477",
},
block_00477={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002309",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa... ahhh, no puedo más, no, no puedo aguantarlo más. Se siente tan\nbieeen... kuh... fun... hafuu, hafuu... ngh.”",
{"rt2"},
},
},
},
linkback="block_00476",
linknext="block_00478",
},
block_00478={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002310",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no puedo, no puedo más, más. Perdóname... yo también me voy... perdóname,\ncreo que me vendré antees.”",
{"rt2"},
},
},
},
linkback="block_00477",
linknext="block_00479",
},
block_00479={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002311",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, kufuu, auh, ¿q-qué puedo hacer? Me siento tan mal por venirme antes...\nahh, ahh, aaah... y estoy aguantando, estoy tratando, ¡pero!...”",
{"rt2"},
},
},
},
linkback="block_00478",
linknext="block_00480",
},
block_00480={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no importa ahora, disfruta del placer tú también, Rin.”",
{"rt2"},
},
},
},
linkback="block_00479",
linknext="block_00481",
},
block_00481={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002312",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, aún no... aahhh... no, ya no puedo. Ah, ah, ah, debo aguantar,\naguan-- nkih... ah, aah, no, me voy... me voooy... ¡Kuuh!...”",
{"rt2"},
},
},
},
linkback="block_00480",
linknext="block_00482",
},
block_00482={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que te corres de forma súbita cuando llega el momento, eh...”",
{"rt2"},
},
},
},
linkback="block_00481",
linknext="block_00483",
},
block_00483={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002313",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Aaahh, lo siento, perdóname. Pero, no puedo, no puedo, me voy, me voy...\nme voy... ¡Perdóname, perdóname!”",
{"rt2"},
},
},
},
linkback="block_00482",
linknext="block_00484",
},
block_00484={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también... ¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00483",
linknext="block_00485",
},
block_00485={
{"text"},
text={
ja={
{
"Y mientras Rin me observa con la cabeza hacia arriba, su expresión se retuerce\nen sensual anhelo...",
{"rt2"},
},
},
},
linkback="block_00484",
linknext="block_00486",
},
block_00486={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002314",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aahh, Nao-kun... m-- ¡¡Guh!!”",
{"rt2"},
},
},
},
linkback="block_00485",
linknext="block_00487",
},
block_00487={
{"bg",id=9,lv=9,sync=1,time=500,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=500,alpha=0,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=1000,alpha=255,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_rin_h04_19",sync=1,time=1000,vague=100,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"quake",size=6,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002315",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngghh...... ¡¡NNNNNnnnnnnnn!!”",
{"rt2"},
},
},
},
linkback="block_00486",
linknext="block_00488",
},
block_00488={
{"text"},
text={
ja={
{
"Mi pene es firmemente presionado. El cuerpo de Rin tembló varias veces,\nmientras se aferraba a mí.",
{"rt2"},
},
},
},
linkback="block_00487",
linknext="block_00489",
},
block_00489={
{"text"},
text={
ja={
{
"Y entonces, justo en el mismo momento en que la presión de su mano fue\naflojándose.",
{"rt2"},
},
},
},
linkback="block_00488",
linknext="block_00490",
},
block_00490={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ng... ¡¡Nkuh!!”",
{"rt2"},
},
},
},
linkback="block_00489",
linknext="block_00491",
},
block_00491={
{"text"},
text={
ja={
{
"Después de una fuerte sacudida que me hizo sentir como si todo mi cuerpo\ntemblara, expulso una enorme cantidad de semen.",
{"rt2"},
},
},
},
linkback="block_00490",
linknext="block_00492",
},
block_00492={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002316",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaaa, jaaaa... jaaa... ¿Uah? Ah, ah, aaahh... ¡Increíble!...”",
{"rt2"},
},
},
},
linkback="block_00491",
linknext="block_00493",
},
block_00493={
{"text"},
text={
ja={
{
"Envuelto en la palma de la mano de Rin, mi miembro dispara una y otra vez mi\ncaliente y lodosa lujuria.",
{"rt2"},
},
},
},
linkback="block_00492",
linknext="block_00494",
},
block_00494={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002317",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aah, aahh... está saliendo, está saliendo bastante... ¿Quieres que vuelva a\nfrotarlo? ¿Puedo hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00493",
linknext="block_00495",
},
block_00495={
{"text"},
text={
ja={
{
"Apenas Rin comienza a estrujar mi pene en medio de la eyaculación, se me va el\naire. Al ver esa reacción mía, Rin aflojó su mano y lo acaricia suavemente.",
{"rt2"},
},
},
},
linkback="block_00494",
linknext="block_00496",
},
block_00496={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002318",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaaa... estás eyaculando... Nao-kun, estás eyaculando... ahh, increíble...\nlo estoy viendo ahora... realmente estás eyaculando...”",
{"rt2"},
},
},
},
linkback="block_00495",
linknext="block_00497",
},
block_00497={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002319",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ahh... se siente extraño, creo que otra vez... Jaa, haaa... ngh, kuh...\n¡¡Nnn!! Ah, otra vez, de nuevo, no, puedo, no, kuhh, no de nuevo, higuh...\nhauun... fuh... fuh, fuh, fuh... nn.”",
{"rt2"},
},
},
},
linkback="block_00496",
linknext="block_00498",
},
block_00498={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002320",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Aahh, no puedo aguantarlo, haaauuuunnn...... ¡¡NNNNnnnn!!”",
{"rt2"},
},
},
},
linkback="block_00497",
linknext="block_00499",
},
block_00499={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_rin_h04_19",sync=1,time=1000,vague=100,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
ja={
{
"Mientras me ayudaba a eyacular, las caderas de Rin comenzaron a temblar\nligeramente de nuevo, alcanzando un pequeño climax.",
{"rt2"},
},
},
},
linkback="block_00498",
linknext="block_00500",
},
block_00500={
{"bg",file="ev_rin_h04_20",sync=0,face=1,time=400,path=":ev/ev_rin_h04/",set="ev_rin_h04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002321",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaaaaaa... Jaa, jaa, jaaaa...”",
{"rt2"},
},
},
},
linkback="block_00499",
linknext="block_00501",
},
block_00501={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será posible... que te acabas de correr dos veces?”",
{"rt2"},
},
},
},
linkback="block_00500",
linknext="block_00502",
},
block_00502={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002322",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, al ver cómo hacías *pyuu* y soltabas todo, me pareció tan sucio, y\npervertido... y no pude resistir las ganas.”",
{"rt2"},
},
},
},
linkback="block_00501",
linknext="block_00503",
},
block_00503={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vaya que te corres de una forma espectacular...”",
{"rt2"},
},
},
},
linkback="block_00502",
linknext="block_00504",
},
block_00504={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002323",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué tratas de decir?”",
{"rt2"},
},
},
},
linkback="block_00503",
linknext="block_00505",
},
block_00505={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, digo, es que hace unos días dijiste que no te masturbabas gritando o\nchillando como en los mangas.”",
{"rt2"},
},
},
},
linkback="block_00504",
linknext="block_00506",
},
block_00506={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002324",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhh, qué malo... eres.”",
{"rt2"},
},
},
},
linkback="block_00505",
linknext="block_00507",
},
block_00507={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002325",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es que, esta vez no lo hice sola... Y era obvio que me excitaría al ver tu\ncosa...”",
{"rt2"},
},
},
},
linkback="block_00506",
linknext="block_00508",
},
block_00508={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así te excitaste?”",
{"rt2"},
},
},
},
linkback="block_00507",
linknext="block_00509",
},
block_00509={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002326",ch="rnd"},
},
ja={
{
name={"Rin"},
"“V-Vamos, no hablemos más de eso. Es de muy poco tacto preguntar esa clase de\ncosas. Ah, dejando a un lado eso, aún está saliendo.”",
{"rt2"},
},
},
},
linkback="block_00508",
linknext="block_00510",
},
block_00510={
{"text"},
text={
ja={
{
"Ya había terminado de eyacular, pero el semen que quedaba adentro comenzó a\nsalirse de forma lenta y viscosa.",
{"rt2"},
},
},
},
linkback="block_00509",
linknext="block_00511",
},
block_00511={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002327",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, preferirías disparar la próxima vez sobre un lugar que más te guste,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00510",
linknext="block_00512",
},
block_00512={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un lugar que más te guste?”",
{"rt2"},
},
},
},
linkback="block_00511",
linknext="block_00513",
},
block_00513={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002328",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Esto... por ejemplo, mi cara, o mi boca, o mis senos.”",
{"rt2"},
},
},
},
linkback="block_00512",
linknext="block_00514",
},
block_00514={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002329",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O quizás... Jejeje.”",
{"rt2"},
},
},
},
linkback="block_00513",
linknext="block_00515",
},
block_00515={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quizás qué?”",
{"rt2"},
},
},
},
linkback="block_00514",
linknext="block_00516",
},
block_00516={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002330",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es un secreto... ah, volvió a moverse.”",
{"rt2"},
},
},
},
linkback="block_00515",
linknext="block_00517",
},
block_00517={
{"text"},
text={
ja={
{
"Aún con su cara colorada, Rin volvió a frotar mi pene una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00516",
linknext="block_00518",
},
block_00518={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿vas a hacerlo de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00517",
linknext="block_00519",
},
block_00519={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002331",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, es que sigue duro aún.”",
{"rt2"},
},
},
},
linkback="block_00518",
linknext="block_00520",
},
block_00520={
{"text"},
text={
ja={
{
"Ciertamente, no hay indicio alguno de que se ponga flácido de nuevo en ningún\nmomento. Sin embargo, si seguimos haciendo esto siento que terminaré\nperdiendo el control, y eso me da miedo también.",
{"rt2"},
},
},
},
linkback="block_00519",
linknext="block_00521",
},
block_00521={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002332",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo quería verlo erecto, por un poco más... y quisiera contemplarlo con más\ndetalle.”",
{"rt2"},
},
},
},
linkback="block_00520",
linknext="block_00522",
},
block_00522={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002333",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No puedo?”",
{"rt2"},
},
},
},
linkback="block_00521",
linknext="block_00523",
},
block_00523={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que no puedas, pero... ¡Hauuh!”",
{"rt2"},
},
},
},
linkback="block_00522",
linknext="block_00524",
},
block_00524={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002334",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, está sensible... iré un poco más suave entonces, ¿sí?... Fufufu, ¿se siente\nbien que te frote~?”",
{"rt2"},
},
},
},
linkback="block_00523",
linknext="block_00525",
},
block_00525={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No le des vueltas tan de repente con la mano.”",
{"rt2"},
},
},
},
linkback="block_00524",
linknext="block_00526",
},
block_00526={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002335",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero esa es la clase de cosas que estamos haciendo ahora, es inevitable que lo\nhiciera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00525",
linknext="block_00527",
},
block_00527={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002336",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Además, te ves tan tierno recibiendo placer de forma pasiva. Me di cuenta de\nque tú tampoco puedes permanecer impasible apenas te tocan aquí abajo,\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00526",
linknext="block_00528",
},
block_00528={
{"text"},
text={
ja={
{
"Quise contestarle algo a eso, pero sí, es justo como Rin lo dice. Con mi\nmiembro siendo frotado de nuevo, mi cuerpo estaba deseoso ahora de eyacular\nde nuevo.",
{"rt2"},
},
},
},
linkback="block_00527",
linknext="block_00529",
},
block_00529={
{"text"},
text={
ja={
{
"No, no puedo. Mi cordura y mi razón no pueden resistirse ante los placeres\ncarnales. Y justo en ese momento que decidí dejarme llevar por el movimiento\nde la mano de Rin y que cerré los ojos...",
{"rt2"},
},
},
},
linkback="block_00528",
linknext="block_00530",
},
block_00530={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002337",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00529",
linknext="block_00531",
},
block_00531={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00530",
linknext="block_00532",
},
block_00532={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm009"},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002338",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Estamos en aprietos! Tenemos que irnos ya al colegio...”",
{"rt2"},
},
},
},
linkback="block_00531",
linknext="block_00533",
},
block_00533={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, estamos por llegar tarde, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00532",
linknext="block_00534",
},
block_00534={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002339",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, sí, así que esto es todo por hoy!”",
{"rt2"},
},
},
},
linkback="block_00533",
linknext="block_00535",
},
block_00535={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Eh? A-Ah.”",
{"rt2"},
},
},
},
linkback="block_00534",
linknext="block_00536",
},
block_00536={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002340",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaja...”",
{"rt2"},
},
},
},
linkback="block_00535",
linknext="block_00537",
},
block_00537={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00536",
linknext="block_00538",
},
block_00538={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002341",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿querías hacerlo hasta el final?”",
{"rt2"},
},
},
},
linkback="block_00537",
linknext="block_00539",
},
block_00539={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00538",
linknext="block_00540",
},
block_00540={
{"text"},
text={
ja={
{
"A pesar de que mi razón me está exigiendo que salga pronto de casa, mis\nemociones están a punto de dejarse llevar por la voz de Rin.",
{"rt2"},
},
},
},
linkback="block_00539",
linknext="block_00541",
},
block_00541={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002342",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pude ver la cara de decepción de Nao-kun. Creo que hoy estoy de suerte.”",
{"rt2"},
},
},
},
linkback="block_00540",
linknext="block_00542",
},
block_00542={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo esa cara puesta, en realidad estoy preocupado de llegar tarde.”",
{"rt2"},
},
},
},
linkback="block_00541",
linknext="block_00543",
},
block_00543={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002343",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00542",
linknext="block_00544",
},
block_00544={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Aunque, no puedo asegurar que es únicamente por eso.”",
{"rt2"},
},
},
},
linkback="block_00543",
linknext="block_00545",
},
block_00545={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002344",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje...”",
{"rt2"},
},
},
},
linkback="block_00544",
linknext="block_00546",
},
block_00546={
{"text"},
text={
ja={
{
"Quizás al haber sido llevado hasta el orgasmo por Rin, es que siento ahora que\nella está jugando conmigo.",
{"rt2"},
},
},
},
linkback="block_00545",
linknext="block_00547",
},
block_00547={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002345",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun, espera un momento, por favor... no guardes aún 'eso'.”",
{"rt2"},
},
},
},
linkback="block_00546",
linknext="block_00548",
},
block_00548={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00547",
linknext="block_00549",
},
block_00549={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002346",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto...”",
{"rt2"},
},
},
},
linkback="block_00548",
linknext="block_00550",
},
block_00550={
{"msgoff"},
{"se",file="se9002",vol=60,id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Rin se acerca a pasitos rápidos, se para frente a mí y se arrodilla. ¿Será que\ndecidió continuar con...?",
{"rt2"},
},
},
},
linkback="block_00549",
linknext="block_00551",
},
block_00551={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002347",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aguanta un poquito mientras estemos en el colegio, ¿sí?... Ngh.”",
{"rt2"},
},
},
},
linkback="block_00550",
linknext="block_00552",
},
