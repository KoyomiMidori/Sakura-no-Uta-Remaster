{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002349",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Le di un beso a tu pene...”",
{"rt2"},
},
},
},
linkback="block_00553",
linknext="block_00555",
},
block_00555={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Un beso...”",
{"rt2"},
},
},
},
linkback="block_00554",
linknext="block_00556",
},
block_00556={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
