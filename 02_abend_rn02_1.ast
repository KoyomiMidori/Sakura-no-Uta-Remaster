astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm007"},
{"bg",file="eveningsky_spring01",id=9,lv=9,path=":cg/"},
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde que comenzó el verano, ha parecido estar muy ocupada.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Parece que ha estado estudiando para los exámenes de ingreso, pero también ha\ntrabajado bastante en lo referente al club. Es Toritani quien más está\ntrabajando ahora...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y está ahora planeando un campamento. Justamente la clase de cosa que toma\ntambién mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Luego viene Akashi.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Ni en broma.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Hikawa podría ser una candidata con bastante potencial.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Lleva un buen tiempo viviendo en Yumihari, y debe tener bastante sentido de\ndirección del lugar. Y es tan espabilada y perspicaz como Toritani.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa no está mal tampoco, pero... umumuh.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da miedo de que Kawachino se entere de que llamé a Hikawa y pueda\nenojarse...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, Hikawa... y la otra es..”.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Rin.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"No ha pasado casi tiempo desde que regresó, pero pareciera tener sentimientos\nprofundos por estas tierras. Y además, así como lo hace al ayudarme a\nestudiar, seguramente es la que me podrá guiar con más amabilidad y\ndelicadeza.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en primer lugar, ¿tan familiarizada estará Rin con este lugar?...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Qué debería hacer...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Cuando trato de pulsar el botón para llamarla, vuelvo a ponerme a pensar de\nnuevo.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"cgdel",id=-1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring01",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahora menos sé dónde estoy...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Desde ese momento, caminé unas cuantas decenas de minutos mientras seguía\ndudoso de qué hacer, y ahora el escenario alrededor se me hace aún menos\nfamiliar. No sé muy bien, pero también siento que estoy acercándome a las\nmontañas...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo quedarme pensando por siempre.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"En fin, no servirá de nada seguir pensando, así que marco el número sobre el\ncual mis ojos estaban puestos.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"msgoff"},
{"se",sync=1,id=1,file="se1343"},
{"se",id=1,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000507",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo? Kusanagi-kun, eres tú, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy Kusanagi. Naoya Kusanagi. Te llamaba, porque me surgió un leve\ninconveniente...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000508",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un leve inconveniente?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Le cuento todo lo que pasó a Rin. Rin escuchó hasta el final con seriedad, sin\nreírse ni asombrarse.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000509",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... eso quiere decir que estás por esta zona...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por esta zona?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000510",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, estaba escuchándote mientras veía el mapa, Kusanagi-kun. Pensé que quizás\npodría dar con el lugar donde estás preguntando por las horas y los detalles\ndel lugar a partir de la dirección en que caminaste por primera vez.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000511",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y creo que desde donde estás ahora se puede ver una montaña. ¿Ves una rueda de\nla fortuna tras la montaña?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una rueda de la fortuna? Ahh, ahora que lo dices, la puedo ver.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000512",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ese es el parque de diversiones que está en la ciudad de al lado.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Salí de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000513",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No has salido. Ciertamente estás algo alejado de Sakuragahara, pero aún sigues\ndentro de Yumihari. Me parece que es más rápido que vayas directamente al\npueblo Utaki a que regreses a Sakuragahara desde ese lugar.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Al pueblo Utaki? ¿No queda eso a una estación de Sakuragahara?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000514",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es. Pero ya has caminado buena parte de esa distancia, así que sería\nbastante molesto regresar. Es mejor que vayas de Utaki caminando hacia la\ncasa de Natsume-kun en Kootoha.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh, tus indicaciones las estás haciendo viendo el mapa, así que seguramente\nestás en todo lo correcto. Está bien, iré de una vez a la casa de los\nNatsume. Y bien, ¿en qué dirección debería ir?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000515",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sigue derecho por la vía que estás caminando ahora. Al hacerlo llegarás al\ndistrito comercial.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Al distrito comercial? ¿Había algo así por estos lares?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000516",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, hay una calle de bares por ahí, así que cuando llegues vuelve a llamarme.\nMe iré preparando antes de que llegues.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Preparar?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"No sé muy bien qué quiso decir, pero por ahora comienzo a caminar teniendo la\ncarretera nacional a la derecha, tal como Rin me indicó.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000517",ch="rnd"},
},
ja={
{
name={"???"},
"“Jaa, jaa, jaa.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin... tú...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg068b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mx=-40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000518",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Llegué, a tiempo... Jaa, jaa, jaa.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Viniste hasta acá nada más para ayudarme?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000519",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, pero vine en bicicleta. Vine en bicicleta así que no me tomó tanto.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Rin se limpia el sudor mientras ríe. Realmente no parece verdad eso de 'no me\ntomó tanto'...",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000520",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, toma esto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Al decir eso, Rin me dio un paño. Lo tomo.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está frío...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000521",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que quizás estarías cansado de tanto caminar, así que la dejé en agua\nhelada y la exprimí. ¿Quizás estuvo muy fría?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, simplemente me sorprendí del frío cuando la toqué. Estuve caminando todo\neste rato con todo el calor del sol encima, así que me sirve muy bien.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000522",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me alegro. Bien, con permiso entonces...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Mientras decía eso, Rin se limpió el sudor con una toalla seca.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Debe haber venido volando con la bicicleta, aun en medio del verano. Está\ncubierta en sudor.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000523",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, lo siento. Estoy toda cubierta de sudor... ¿No oleré mal?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000524",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este calor hace sudar bastante. Nao-kun, podría darte hipertermia de caminar\ntanto tiempo bajo esta temperatura.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me preocupa más esa personita que vino volando en bicicleta con esta\ntemperatura para no hacerme esperar.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000525",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-Tampoco vine volando.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? ¿No viniste pedaleando parada?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000526",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imaginé. Por Dios, si una chica pedalea parada con una falda se le verán\nlas pantis.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0005",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000527",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No se vieron! ¡Tampoco soy tan torpe!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Por cosa extraña, Rin altera el tono de su voz.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000528",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En todo caso, la parte trasera de mi falda es larga... y además cuidé de que no\nse levantara.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es una broma, solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0011j",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000529",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Me dio algo de pena ahora que lo dijiste.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no se te vieron las pantaletas, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0005j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000530",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000531",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque es verdad que vine pedaleando parada con esta falda... Así que, siento\nque tal vez no fue muy apropiado.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ninguno de los dos nació antes de la guerra, ¿qué puede tener de inapropiado\neso? Dejando eso de lado, debes estar muy cansada, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000532",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, para nada.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Mentirosa.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000533",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y bien, Kusanagi-kun, ¿no tienes hipertermia ni nada de eso? ¿No te sientes\nmal?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo diré tanto como sea necesario, estoy completamente bien. Me preocupas más tú\ny estos alimentos.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000534",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, los alimentos. Ahora que lo recuerdo, venías de regreso del supermercado,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, compré también pescado fresco, así que me tiene algo preocupado esto.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000535",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Escuché también que mencionaste eso durante la llamada, así que traje esto.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000536",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Compresas frías. Siempre las tengo enfriándose durante el verano en el\nrefrigerador. Se pueden usar para muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Rin sacó una gran cantidad de compresas frías de su mochila.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toda estas compresas tan grandes... Debe haber estado pesado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000537",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí son grandes, pero tampoco son tantas, y además vine en bicicleta. Ah, toma\nesto también.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"se",file="se9010",vol=50,id=1},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
ja={
{
"Rin sacó ahora un termo de su mochila.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000538",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Traje algo de té de cebada. Aunque supongo que habrás comprado y tomado algo ya\nde alguna máquina después de caminar por tanto tiempo bajo el sol, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... Realmente no sabes nada, eh.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",mode=-2,sync=0},
{"se",file="se9019",id=1},
{"bg",zoom=105,speed=500,file="bg068b",path=":bg/",z2=100,ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",zoom=110,speed=500,mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0012",head="rin_z2a",y2=0,z2=100,y=10,lv=5,id=9,sync=0},
{"extrans",time=0},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000539",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"se",file="se9025",vol=50,id=1},
{"text"},
text={
ja={
{
"Al tomar el termo de Rin, serví algo de té en el vaso y me lo tomé de un trago.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",stop=1,time=500,id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puhaa... he regresado a la vida.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que un pobretón como yo va a usar algo tan caro como una máquina\nexpendedora? Esta clase de detalles me alegran.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0002",head="rin_z2b",y=10,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000540",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué alivio. He escuchado que muchas personas no gustan mucho del té de cebada,\nasí que estaba insegura de qué hacer si no te llegara a gustar.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, para nada, el té de cebada es bueno. Y parece que también enfría el\ncuerpo como uno de sus efectos. Es perfecto para combatir los golpes de\ncalor.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0004",head="rin_z2b",y=10,lv=5,id=9,zoom=110},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000541",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, eso me alegra.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no tomas un poco también?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0012",head="rin_z2b",y=10,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000542",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, debes haberte acalorado mucho, ¿no? Deberías hidratarte un poco.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2b0300",face="b0008",head="rin_z2b",y=10,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000543",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿D-De verdad puedo?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que sí. Ah, ya veo, es porque ya puse mi boca sobre el vaso, ¿no? Déjame\nlimpiarlo con un pañuelo...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"se",file="se9010",id=1},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1d0300",face="d0014",head="rin_z1d",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000544",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah~, wah~”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Antes de limpiar el vaso, por alguna extraña razón Rin me lo arrebató.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0006j",head="rin_z1b",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000545",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No tienes por qué hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? ¿Pero por qué me quitaste el vaso tan alterada?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0018j",head="rin_z1b",y=10,lv=4,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0008j",head="rin_z1b",y=10,lv=4,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rnd_000546",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso es, porque, porque sería un despilfarro gastar un pañuelo nada más para\nesto. D-De verdad no tengo problema bebiendo de tu mismo vaso, Nao-kun.\nAdemás, hace tiempo bebíamos siempre sin problema de la misma botella\nplástica...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo dices, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0002",head="rin_z1b",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000547",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Bien, tomaré algo de té entonces.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0300",face="b0004",head="rin_z1b",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000548",ch="rnd"},
},
ja={
{
name={"Rin"},
"*kokukoku*... fuu.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se siente muy bien frío, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000549",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rnd_000550",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, sí, está muy frío y bueno. Y-Y, por cierto, ha hecho bastante calor\neste año, ¿no crees? No pensé que llegara a hacer tanto calor...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ha hecho más calor que los otros años, pero ¿no habrá sido más bien,\n'eso'? ¿Te pusiste a pensar en lo del beso indirecto y te dio calor, o algo\nasí?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0015j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000551",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhhh...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"La cara de Rin va sonrojándose rápidamente.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000552",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, n-n-no es eso. ¡Te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000553",ch="rnd"},
},
ja={
{
name={"Rin"},
"“H-Hicimos esto muchas veces cuando éramos niños, así que de verdad, ya a este\npunto no me siento feliz ni tampoco avergonzada. De verdad no es eso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quizás lo pensaste?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000554",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No es así... esto...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000555",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Lo siento mucho por haberte mostrado tan vergonzosa escena!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, espera, discúlpame a mí más bien.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por haberte exaltado tanto con mi chiste tan malo.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000556",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un chiste malo?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000557",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Dijiste de repente eso solo como un chiste malo?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000558",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Pero entonces quedo yo como una tonta por haberme alterado sola!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es que no pensé que llegaras a reaccionar así. De verdad pensé que simplemente\nevadirías el tema con algún comentario.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0017",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000559",ch="rnd"},
},
ja={
{
name={"Rin"},
"“K-Kusanagi-kun, realmente sigues igual que siempre... Me he puesto de mal\nhumor. Pui.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1c0300",face="c0001",head="rin_z1c",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
ja={
{
"Rin se enojó, y volteó su cabeza a un lado, apartando su vista de mí.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"No pensé que llegar a enojarse tanto, aunque, es un tanto nostálgico esto.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Desde que se mudó acá, Rin ha actuado como una persona muy refinada, de muy\nbuenos modales y ciertamente, también sociable, pero esa familiaridad que la\nhacía sentir tan cercana hace tiempo se había aplacado un poco.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Es muy raro ver a la aparentemente madura y reservada Rin así de enfurruñada.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z2",sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2c0300",face="c0001",head="rin_z2c",y=10,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000560",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Ciertamente hace tiempo lo hacíamos con bastante frecuencia, pero fue algo\ndistinto hacerlo ahora comparado a ese entonces. Fue algo distinto, y mi\npulso se aceleró un poco.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0008j",head="rin_z2a",y=10,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000561",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Solo... solo fue eso...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Las mejillas de Rin están más rojizas de lo normal. Su piel estaba algo\nhumedecida, y la zona de su nuca...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0310",face="a0008j",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"¡¿Pero es que acaso soy algún viejo frustrado?!",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"¡¿Cómo voy a ver a mi amiga de la infancia con estos ojos?!",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0001",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0008",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rnd_000562",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué sucede? ¿Por qué me ves tanto?... ¿Estás burlándote de mí?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"De ninguna forma soy capaz de decirle que estaba cautivado por su humedecida\npiel...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0002",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000563",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Por cierto, Kusanagi-kun, también tienes la cara roja...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Es porque hace calor, ¿no? Y, además está atardeciendo ya, simplemente da\nla impresión que me veo rojo.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0010",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000564",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uh... evadiste con mucha facilidad mi comentario.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, normalmente siempre evado las preguntas poco convenientes para mí de esta\nmanera, con calma y ligereza.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0001",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000565",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces, ¿eso quiere decir que esa pregunta fue inconveniente para ti,\nNao-kun?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... ehm, pues dejando eso de lado, no sabía que había un distrito comercial\npor este lugar, eh~”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000566",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esta vez claramente cambiaste el tema, y sin calma ni ligereza.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame en paz.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000567",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje, parece que a este lugar le llaman pueblo Namidagawa. Aunque también es\nla primera vez que vengo.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es tu primera vez también?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000568",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, investigué el mapa en Internet mientras estaba en mi casa y vine.\nÚltimamente se ha vuelto muy útil. Incluso se pueden observar fotos del lugar\nen un instante.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así parece.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000569",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que los smartphone tienen una función que te guía con rutas, pero mi\nteléfono es de los viejos, así que me traje el mapa impreso en papel.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",y=10,lv=4,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rnd_000570",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no importa, no importa. ¡Bien, comenzaré ahora con la navegación de\nKusanagi-kun!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"se",file="se9004",id=1},
{"bg",file="ev_uni_c26_01",path=":ev/ev_uni_c26/",set="ev_uni_c26"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000571",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Son 3 semáforos, así que creo que debemos girar a la derecha a unos 100 metros.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Rin susurro eso sin ver el mapa.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pareces el GPS de un vehículo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000572",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, hay que ver lo bien que te guías sin siquiera ver el mapa...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000573",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A veces me gusta ver los mapas, así que creo que por eso termino aprendiéndome\nlas distancias y las escalas sin darme cuenta.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te gustan los mapas?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000574",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, también me gusta ver mapas viejos. Es divertido compararlos con los mapas\nactuales.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso suena fastidioso...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000575",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo es. Por ejemplo, aquellos lugares con 'ike (池)', 'kawa (川)', 'sawa\n(沢)' o 'tani (谷)' en su nombre, hace tiempo realmente quedaban muy cerca de\ncuerpos de agua.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000576",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y por eso dicen que es bueno evitarlos al momento de comprar propiedades.\nEran lugares como dunas, deltas, mar robado, y también ríos, arrozales y\npozos, lugares con tierra poco firme.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000577",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al ver los mapas viejos te das cuenta de eso, y es divertido.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, aunque cada vez se me hace más fastidioso eso.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000578",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, pero, quizás mentí un poco.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos dices?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000579",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Digamos, más que ver mapas... creo que me gustaba ver el mapa de la ciudad\nYumihari. Todo el tiempo me la pasaba viéndolo desde que me alejé de esta\nciudad...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000580",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y fue en eso que también comencé a coleccionar mapas viejos... Así que más que\nver mapas, probablemente realmente me gusta es ver los mapas de esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, y por eso es que conoces tan bien el camino. La verdad es que no pensé\nque dieras con mi ubicación tan fácilmente por el teléfono.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000581",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, yo también quedé sorprendida de mí misma. Aunque supe en buena parte el\nlugar al escuchar tu explicación. Dónde estabas en ese momento...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000582",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cuando me quedo viendo el mapa por un largo, largo rato, comienzo a ver los\npaisajes que corresponden al mapa.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000583",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, aunque, de verdad creo que soy la única que puede hacer eso... Al ver el\nmapa, puedo usar mi imaginación para hacer como si estuviera en ese lugar.\nAsí que al escuchar tu voz, de cierta forma supe dónde estabas, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso parece un poder psíquico.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000584",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ya debemos ir girando a la derecha.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Giro a la derecha junto a Rin.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000585",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es algo tan exagerado como un poder psíquico. Aunque más que poder\nimaginativo, diría que se acerca más a un poder delirante. Aunque, bueno,\nsupongo que es una habilidad muy de mí...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Muy de ti?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000586",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, olvida eso, ajaja...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000587",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ¿de verdad nunca antes habré tomado en mis manos un pincel para óleo?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa pregunta fue algo repentina. ¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000588",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sé muy bien por qué, pero, sentí como el pincel se ajustaba a mis manos,\no... quizás, se sentía algo nostálgico...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que yo sé, se supone que tú nunca llegaste a pintar en óleo. Aunque no sé\nsi lo habrás hecho sin que yo lo supiera.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000589",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, por ese lado no hay problema. En mis memorias tampoco hay ningún recuerdo\nde haber pintado en óleo antes.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000590",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero la sensación de tomar el pincel se me hizo algo nostálgica. Aún teniendo\neste poder delirante tan fuerte, ¿de verdad no habré nunca tomado un pincel\nen mis manos?... Eso se me hace algo curioso.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ciertamente, usar la imaginación es sumamente importante al momento de\npintar. No sé si lo tuyo realmente es un poder delirante o no, pero esa clase\nde poderes sirven como motor principal para pintar.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque de igual forma, no tienes ningún recuerdo al respecto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000591",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así que tal vez pensé esto por haberte visto pintando hace tiempo,\nNao-kun... creo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000592",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre recordaba en mi mente tu figura pintando... De verdad, realmente es\ncomo un poder delirante.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Siempre has sido así de fantasiosa, Rin?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000593",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Lo soy bastante.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Ah, ahora que lo recuerdo, hace tiempo solíamos ir con frecuencia a\nbuscar entre los arbustos, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000594",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No tienes por qué recordar eso!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, aunque, ambos aún éramos niños para ese entonces... Y bueno, tampoco fue la\ngran cosa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000595",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A-Así lo crees?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, deja mucho que pensar que tú buscaras con más esmero que yo.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000596",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-Nunca puse esmero para ese tipo de cosas! A-Además, he cambiado ahora. ¡Ya\nno tengo interés en ese tipo de cosas!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues así será. Ahora no das más que la impresión de una refinada e\ninteligente dama.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000597",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo menos la gente del salón piensa eso. Aunque bueno, los del club de arte\ntambién parecen pensar igual.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000598",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, entiendo. Eso me alegra.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no eras así de niña.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000599",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esas son cosas del pasado. Ahora estoy más cercana a ser una refinada dama\ncomo todos los demás lo piensan.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? Joven damisela, ¿qué clase de delirios suele tener?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000600",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las damiselas no deliramos.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si acabas de decir que lo haces.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000601",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues sí. Es un secreto entonces.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000602",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace un rato me enseñaste la técnica para evadir preguntas inconvenientes,\nNao-kun, y la apliqué ahora.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... creo que hice algo innecesario.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000603",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-En fin, simplemente dejemos este asunto como el secreto de una dama. Ah,\nahora a la izquierda.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Al girar a la izquierda por la zona residencial que tan poco familiar se me\nhacía, de repente el escenario alrededor cambia a uno que sí se me hacía\nfamiliar.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, aquí. Así que ese camino llegaba hasta acá.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000604",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ya se te hace familiar el lugar, ¿verdad? ¿Quisieras terminar con la\nnavegación de ruta?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, creo que prefiero aprovechar la oportunidad. Guíame hasta el final.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000605",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entendido. Continuaré entonces con el servicio de navegación exclusivo de\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000606",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, al principio dije que serviría de navegación y eso, pero quizás fue una\npequeña recompensa para mí caminar los dos juntos de esta manera.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto, ¿una recompensa?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000607",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es una recompensa.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así lo piensas?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000608",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_rn02_2"},
{"text"},
linkback="block_00229",
},
label = {
top={block="block_00000",label=1},
},
}
