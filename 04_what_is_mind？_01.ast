astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"bg",file="ev_eye_c12_01",path=":ev/ev_eye_c12/",set="ev_eye_c12"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_com_g01_01",path=":ev/ev_com_g01/",set="ev_com_g01"},
{"bgm",file="bgm001"},
{"text"},
text={
vo={
{"vo",file="man_kid_000001",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Cómo lo ves?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_wkd_000048",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿A quién?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_kid_000002",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Naoya. ¿Cómo está Naoya?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_wkd_000049",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ah, ¿Naoya?... Parecía estar muy pensativo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000003",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me lo imagino...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wkd_000050",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Por qué le dio toda la fortuna a él?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000004",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por varias razones, mi amigo. Por varias razones.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_wkd_000051",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Varias razones...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_wkd_000052",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por cierto, Kusanagi-san, ¿cómo se llama la muchacha que se trajo con usted?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bg",file="ev_com_g01_03",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000005",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mm~, qué te puedo decir~”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_wkd_000053",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No estoy en posición alguna de decir mucho al respecto. Pero ¿no le parece algo\ncruel meter a Naoya en los problemas de la familia Natsume con la edad que él\ntiene?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000006",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No había forma de evitarlo. Naoya es un Kusanagi. Es nuestro destino meternos\nde fondo en grandes problemas.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_wkd_000054",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Qué clase de familia es esa...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000007",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué clase de familia? Vamos, ¿me vas a decir que no sabes?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_wkd_000055",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Es muy poco lo que en realidad sé. Usted era un héroe para nosotros en el\ncolegio, Kusanagi-san. Sobre todo por la fuga amorosa que tuvo con\nMizuna-san.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_kid_000008",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fuga amorosa, eh... Supongo que a los ojos de los demás se vio así...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_wkd_000056",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sea a los ojos de quien sea eso fue una fuga amorosa, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000009",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De verdad lo crees?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_wkd_000057",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Fue después que me enteré un poco de lo que pasó. Después de que Ai-chan\nentrara a trabajar a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000010",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo. Ahora que lo mencionas, Ai está ahora trabajando de profesora, eh... En\nYumihari...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000011",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que me estoy poniendo viejo yo también... Esa diminuta muchacha, ahora de\nprofesora... Lo pequeñita no se le ha quitado mucho, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_wkd_000058",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Si llega a decirle eso a la profesora Ai, lo matará. Es muy sensible a todo lo\nque tiene que ver con su altura.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000012",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Con lo absurdo que es preocuparse por eso, eh. Ai nació con una cara muy\nbonita. Lo pequeñita le da ventaja con hombres de 'esas' inclinaciones.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_wkd_000059",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Eso sería mucho peor que lo que yo dije.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000013",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí? Bueh, qué voy a hacer. Siempre estoy haciéndola enfadar...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_wkd_000060",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿De verdad? Aunque supongo que ya no tanto, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000014",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para nada, para nada. Hace muy poco se enojo terriblemente conmigo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_wkd_000061",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿En serio? ¿Qué hizo?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000015",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Al contrario. Se enfadó porque no hice nada.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_wkd_000062",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Porque no hizo nada?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000016",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me armó todo un escándalo. Que por qué no regresé sino hasta ahora que empeoró\ntanto mi enfermedad, y eso.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_wkd_000063",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pues, sí... Sinceramente, yo también pensé lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000017",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero tú no te enfadaste conmigo, ¿a que no?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_wkd_000064",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Por supuesto que no. Usted es un adulto hecho y derecho, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_g01_03",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000018",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso mismo me dijo ella. ¡¿Cómo es que un adulto hecho y derecho está haciendo\nesas cosas?!...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000019",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Siempre ha sido una muchacha muy peleona. Me dolió un poco verla llorando de\nesa forma por mi culpa.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_wkd_000065",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Y por qué entonces no fue al hospital? Ya llevaba un buen rato sintiéndose mal\nde salud, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000020",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aun siendo así quería decidir, por lo menos, la duración de mi propia vida.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_wkd_000066",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Y? ¿Logró alcanzar su precisamente calculada vida?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000021",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues la verdad... diría que, a duras penas, tal vez. Es algo extraño.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_wkd_000067",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿A duras penas?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_g01_03",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000022",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que hubiera sido toda una historia para contar si todo hubiese terminado\nahí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_kid_000023",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No en vano, alguien grabó ya mis epitafios estando yo todavía con vida...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_wkd_000068",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_wkd_000069",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Fiuu... Dios mío, es usted un hombre terrible, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000024",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_wkd_000070",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“La vez pasada le pregunté lo mismo y me dijo 'El cálculo me falló un poco'.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_kid_000025",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Dije eso?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_wkd_000071",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ya veo. Pues entonces Naoya logró resolverlo todo, supongo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000026",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo qué sé. Además, tampoco sé qué hará en última instancia con la herencia.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_wkd_000072",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ya veo. Bueno, no sé muy bien qué pasó en realidad, pero lo que sí es cierto es\nque usted está de buen humor.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000027",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Bastante, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_wkd_000073",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Demonios, vaya que es usted un hombre egoísta.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000028",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Soy la persona más egoísta que te vas a encontrar. Y disfruté toda mi\nvida siendo así.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_kid_000029",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue una emocionante y muy divertida vida.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_wkd_000074",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Emocionante y divertida, eh... Supongo que así lo fue.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000030",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta noche será mi última cena. ¿Te quedas a charlar?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_wkd_000075",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Su última cena?... No veo comida ni alcohol por ningún lado.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000031",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Alcohol tengo. De aperitivos solo tengo mis historias del pasado.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_wkd_000076",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Historias del pasado como aperitivo?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000032",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, aunque te advierto que es una copiosa cantidad. Vamos, quédate y\nescucha.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_wkd_000077",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Cómo puedo rechazarle si me pide que me quede?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000033",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No te estoy forzando de ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_wkd_000078",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Así no me esté forzando a nada no podría rechazar esa oferta. Así que bien,\n¿podría darme a escuchar un poco de esos aperitivos?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_wkd_000079",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Me siento algo triste de saber que morirá pronto, ¿sabe? Quizás esas historias\npuedan saciar un poco el hueco en mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000034",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí? Pues qué bueno. ¿Te acuerdas de cuando todavía trabajaba de profesor en\nYumihari?...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_wkd_000080",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, lo recuerdo. Justamente cuando yo todavía estudiaba ahí, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000035",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, recuerdo que eras del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_wkd_000081",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Y bien que venía con frecuencia al club, ¿no, Kusanagi-san?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_g01_03",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000036",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, no tenía a dónde más ir...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_kid_000037",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y ahora que hablamos del pasado... Aun desde aquel entonces Mizuna era toda una\npreciosura, sí señor.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_wkd_000082",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Yo tampoco puedo decir lo contrario. Era muy conocida en el colegio por su\nhermosura.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_g01_04",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
},
},
text={
vo={
{"vo",file="man_kid_000038",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya que sí. Aunque bueno, si no hubiese nacido con tal hermosura, quizás no\nhubiese pasado por tanto sufrimiento...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_wkd_000083",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“... ¿Está seguro de que puede contarme esta historia?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000039",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y preferiría contártelo, la verdad. Es mucho peso como para llevarlo todo\ndentro de mi pecho...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_wkd_000084",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Y por qué no contarle a Naoya?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_g01_05",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000040",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Alguien más se encargará de revelárselo todo...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_wkd_000085",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Alguien más?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_kid_000041",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, ella más que nadie sabe de lo que Mizuna y yo vivimos... Sé que llegará el\ndía en que le contará todo a Naoya...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_kid_000042",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por eso quiero que te quedes a escucharme...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_g01_02",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000043",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para poder beber esta noche del mejor licor que pueda haber...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_wkd_000086",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Licor?...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_kid_000044",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, uno muy gustoso que llaman felicidad...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_wkd_000087",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Felicidad...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_g01_01",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000045",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No me queda mucho por delante ya. Así que, kouhai mío de la vida, quisiera que\nescucharas lo que tengo para contar.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_kid_000046",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Una buena historia para degustar de la felicidad...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
