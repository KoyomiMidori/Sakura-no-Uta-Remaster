astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="bluesky_winter",id=1,lv=1,time=2000,sync=1,path=":cg/"},
{"bg",file="eveningsky_winter",id=2,lv=2,time=2000,sync=1,path=":cg/"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Vine a Quimera para buscar la taza de Usagiko-san que había reservado. Al\npararme frente a la tienda, contemplo el letrero del local, sin ningún\npropósito en particular.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Ya lo he visto varias veces, y no me deja parecer fabulosa la escritura\nempleada en el letrero.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Me doy cuenta de que hay un seudónimo escrito en una de las esquinas del\nletrero.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Siempre saltaba a mi vista, pero, supongo que nunca llegué a verlo con calma, y\npor eso no me di cuenta antes.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Kariyama, Aosagi? (狩山青鷺) No, Aosagi no, debe ser Seiro.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Si esto no lo escribió la dueña, entonces debe haber sido alguien relacionado a\nella.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"¿Será gracias a la presencia del mismo colegio Yumihari? Se pueden encontrar\nvarias cosas interesantes alrededor, aun en un simple letrero como este.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001167",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa? ¿Por qué andas parado frente al local?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, ¿quizás interferí con el negocio?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001168",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es para tanto, solo que me pareció algo raro que te quedaras aquí.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es por este letrero...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001169",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El letrero? Ah, ¿este letrero? Parece que, en conmemoración de la apertura del\nlocal, la dueña consiguió este letrero a la fuerza, o algo así había\nescuchado...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Me lo imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001170",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Hay algo que te llame la atención?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es que hay un seudónimo acá.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kariyama Seiro... Pensé que de tal vez tener más obras aparte de esta me\nencantaría verlas.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001171",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Seiro...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Toritani baja un poco la mirada, pensante, como si se le hubiera ocurrido algo.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces ese nombre?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001172",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No, no lo conozco.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Claramente no parecía ser un nombre desconocido para ella, pero, tampoco lucía\ncon muchas ganas de hablar al respecto. Si ese es el caso, entonces yo\ntampoco tengo por qué indagar tanto en el asunto.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001173",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No has tratado de preguntar al respecto.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, en realidad no tengo intención de preguntar. Aunque no te detendría en caso\nde que tú misma quisieras hablar del tema.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001174",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, ciertamente a veces te comportas así...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001175",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun con lo perspicaz que eres... sueles despistarte en las cosas más extrañas.\nEs realmente misterioso. Siento incluso como si lo estuvieras haciendo a\npropósito.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué andas hablando?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_bit_000007",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“¡Makoto-saaan! ¡¿Lo siento, podrías veniiir?!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001176",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, cierto, no es momento para andar perdiendo el tiempo aquí. Viniste a buscar\nla taza, ¿no? Entra cuando quedes satisfecho de contemplar el letrero.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"Toritani se da la vuelta, haciendo girar el borde de su vestido de maid, y\ndesaparece dentro del local.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Hasta que quede satisfecho, eh...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"cgdel",id=-1},
{"bg",file="zeveningsky_winter",id=3,lv=3,speed=280000,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Café Quimera...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La primera vez que vi este local, pensé que se trataba de un nombre bien raro.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Si hablamos de Chimera, o Quimera, lo primero que se me viene a la mente es la\nobra de Gustave Moreau...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Moreau fue un pintor que actuó como precursor del simbolismo, corriente que\ntomó las tendencias del romanticismo.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"El simbolismo fue una corriente de pensamiento artística que se extendió por\ntoda Europa en la segunda mitad del siglo XIX, y a diferencia del realismo,\nel cual buscaba dibujar de manera objetiva la realidad, este intentó expresar\nde manera simbólica, y a través de los estilos ornamentales, lo mental, lo\nreligioso y místico, además de los sueños y las visiones.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"La quimera de la mitología griega, era, según dicen, una bestia con cuerpo de\ncabra, cabeza de león y cola de serpiente que vomitaba fuego.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Sin embargo, la Quimera de Moreau tenía el cuerpo de un caballo y el torso de\nun humano, además de alas, así que más que una quimera, parecía más un\ncentauro o un pegaso.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Aunque tal vez el nombre del local no esté inspirado en la Quimera de Moreau,\nsino en alguna novela.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"cgdel",id=-1},
{"bg",file="eveningsky_winter",id=4,lv=4,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="man_tnh_000003",ch="tnh"},
},
ja={
{
name={"???"},
"“¡Disculpe!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_tnh_000004",ch="tnh"},
},
ja={
{
name={"Repartidor"},
"“Vengo con un paquete...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, yo solo soy un cliente, espere un momento-- ah, no, disculpe, yo lo\ntomaré.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Toritani parece estar bastante ocupada. No pasará nada malo si hago esto por\nella, supongo.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_tnh_000005",ch="tnh"},
},
ja={
{
name={"Repartidor"},
"“Ah, de ser así firme acá por favor.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Aunque hay que admitir que este repartidor también está incurriendo en\nproblemas, accediendo tan fácilmente a mi propuesta. ¿Qué rayos haría si yo\nllegara a llevarme el paquete?",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Aunque no lo haré, claramente.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Sin embargo, ¿qué habrá acá adentro? Este tamaño, y este grueso... ¿Será algún\ncatálogo o algo así?",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Tomo el bolígrafo para firmar, y pongo mis ojos sobre el recibo.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Observo la dirección. Y luego, el nombre... ¿Qué demonios?",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpa, el nombre del destinatario de este recibo...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_tnh_000006",ch="tnh"},
},
ja={
{
name={"Repartidor"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Pongo mi firma y recibo el paquete. Posteriormente, el repartidor se fue.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Acerco frenéticamente mi cara al paquete que acabo de recibir. No cabe duda\nalguna.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En el nombre del destinatario estaba escrito 'Hakushuu Usagiko'.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm006"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Esto es increíble!!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001177",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, de verdad no es para tanto.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001178",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aaaahhh, rayos... de verdad que no pudo equivocarse en peor momento... Y aun\ncuando le insistí en que lo enviara con mi verdadero nombre...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001179",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente, líos y más líos es lo único que me trae...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Sin pensarlo, me le pongo de cerca a Toritani, quien estaba ahora con un rostro\náspero, visiblemente aquejada.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"se",file="se9015",id=1},
{"cgact",stage="bg031",act="いいえ",lv=1},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0014h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001180",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--, estás cerca, estás demasiado cerca!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿es que quién diría que tú eras la Usagiko-san de 'Conejo de Luna'? Por\nsupuesto que es increíble, tus artículos llegaron a venderse incluso en esa\ntienda departamental.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001181",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es tampoco la gran cosa que los vendan en esa tienda departamental...\nAdemás, también invitan a fabricantes pequeños. Es todo por los gustos que\ntiene el encargado de los eventos...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso dices? Pero, realmente es asombroso. Tus tazas han sido vendidas en\npáginas relativamente famosas, y son tan populares que siempre se agotan\nrápidamente.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es lo mismo a simplemente vender cositas en una página web de manualidades,\n¡¿Y espera, no es todo como que distinto a lo que dijiste ayer?!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001182",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al principio comencé registrándome y vendiendo en sitios de manualidades y\naccesorios hechos a mano, en eso no te mentí... no mentí... solo, que no dije\ntoda la verdad...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, también tienes... un sitio, oficial, y lo actualizas\nconstantemente... y yo, estuve pegado a ese sitio... y compré...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"De repente, dejo caer mi cabeza hacia abajo.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001183",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué pasa? ¿Por qué estás tan desanimado de repente?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera un momento... ¿De verdad? ¿Realmente, realmente eres Usagiko-san?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0016",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001184",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Qué pena, ¿no? Disculpa que no sea ni madura, ni de buena edad, o de una\ncálida personalidad.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, olvida eso, te lo ruego...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Sin pensarlo ni un momento, me pongo las manos sobre la cabeza.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0011",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001185",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera, ¿qué sucede, Kusanagi? Es realmente raro verte así, y no sé de qué\nforma reaccionar o actuar ahora, así que deja de hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es que ayer halagué y exalté a Usagiko-san a más no poder frente a ti...\ny además, me puse a decir que tus piezas de alfarería podrían llegar lejos,\npero no tanto, y todo eso...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es demasiado vergonzoso...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001186",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no, bueno... vamos, no le prestes atención a eso... Discúlpame a mí\ntambién. Digo, no encontré el momento para decirlo, y me costaba revelarlo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001187",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sé que eres agudo, y percibes fácilmente cualquier cambio, y aun de la manera\ntan obvia con la que me agitaba, actuabas como si no te hubieras dado cuenta\npara nada, así que pensé que quizás estabas tratando de tomarme el pelo, y\nbueno, sospeché un poco...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001188",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah--, pero ahora que lo recuerdo, eres bien torpe en las cosas más raras,\nciertamente...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, estás dándote muchas falsas ideas. De verdad jamás llegué a creer que esa\nprofesional de la alfarería, que esa famosa artista de cerámica que está\nahora capturando de manera tan espectacular la fama con sus creaciones,\nestuviera tan cerca de mí...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="du",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001189",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo he dicho, no es nada tan espectacular. Y eso de 'profesional de\nalfarería' es también muy exagerado...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001190",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y además, para decir la verdad, comencé esto pensando que, quizás, me ayudaría\na cubrir un poco los gastos de matrícula del colegio y la manutención...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, espera, pero es que realmente eres popular. Busca nada más el\nnombre de la marca en Internet, y verás lo que te digo.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0018",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001191",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya está bien, no me importa... y además, tampoco me interesa mucho...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Realmente no sabías?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001192",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Ni tampoco que mis tazas recibían el nombre de 'blanco Usagiko'. Fue de ti\nque lo supe por primera vez...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pero entonces, ¿las tazas donde serviste la gelatina de café el otro día\npertenecen también a 'Conejo de Luna'?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001193",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmmm... Para ser precisos, no. Esas tazas son de mis verdaderos primeros\ntrabajos, cuando aún vendía en los sitios de manualidades.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001194",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al principio se me ocurrió vender bajo el nombre de 'pica-pica'. Pica pica es\nel nombre científico de la urraca (Kasasagi). Y por eso pensé en ponerme un\nnombre cualquiera, como 'Sagiko', por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001195",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cuando le mostré las tazas a la dueña y le expliqué la idea, me dijo, 'usa\nmejor un conejo en tu nombre'...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001196",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Debiste haberte dado cuenta allí...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Darme cuenta?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001197",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, disculpa, son solo cosas mías. Quiero decir que la dueña fue quien inventó\nesos dos nombres. Tanto 'Conejo de Luna' como 'Usagiko'.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001198",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Has leído el texto introductorio que sale en el sitio web de 'Conejo de Luna'?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo recuerdo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001199",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo. Respecto a eso, el nombre era tan tierno que me causaba vergüenza, así\nque le agregué cierto significado para mantener un tanto las apariencias...\naunque bueno, el significado que le di no lo puse por ponerlo y ya, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero entonces, la labor de empaquetado de ayer no fue de las tazas que se\nvenden en Quimera, sino...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001200",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es, eran de mis tazas. Son realmente pocas las tazas que la dueña envía, y\nsolamente se venden en el local.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, el contenido de las cajas estaba envuelto en embalaje,\nasí que no pude verlo. Y además, la escritura de las facturas la hicieron en\nel primer piso... En pocas palabras, no quisiste mostrarme nada.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0010",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001201",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo. Perdón por haberte engañado.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente eso no importa.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Al sentarme en la silla que tenía al lado, suelto un largo suspiro.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Todo esto fue verdaderamente impactante.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que tú eres Usagiko-san...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001202",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nmm, pues, sí... lo siento, ¿sí? Por haber acabado con toda la gran imagen que\ntenías de mí y la marca... Es su culpa, por haberse equivocado...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Su culpa? ¿Te refieres a la persona que mandó el paquete? ¿Que no fue la\ndueña? Ah, no, ciertamente no tenía el apellido Toritani.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001203",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, ¿cómo podría ponerlo?... es un comerciante de arte antiguo, o algo así, y\ntambién maneja un grupo de aficionados al arte. Me contactó para decirme que\nhabía incluido uno de mis trabajos en su catálogo, así que quería\nmostrármelo... Aun cuando le dije que lo enviara con mi verdadero nombre, ese\nidiota...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un comerciante de arte antiguo incluyó tus jarros en su catálogo?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"No voy a negar que las tazas de 'Conejo de Luna' son fantásticas, pero lo son\ncomo tazas para uso diario, y solo para eso. La verdad, no me parece la clase\nde artículos sobre los cuales un comerciante de arte antiguo pensaría poner\nsus manos...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001204",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, sí, bueno, hay toda una historia tras eso.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, toda una historia.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001205",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Está bien, bueno, ya creo que he entendido todo lo que sucede.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001206",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya pareces estar más calmado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo estoy.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Piensas seguir trabajando de artista de alfarería después de graduarte?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
},
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001207",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna manera. Hace un momento te lo dije, ¿no? Mi objetivo primordial es\npagar mi manutención. Y además, trabajo con alfarería porque se me hace\ninteresante por ahora, solo eso.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué desperdicio... Aun con tanto talento.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001208",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Y además, trabajo con alfarería porque se me hace interesante por ahora, solo\neso.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bgm",stop=1,time=1000},
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001209",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eres el menos indicado para decir eso.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Me hice el tonto.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
