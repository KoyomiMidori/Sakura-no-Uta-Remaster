astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"text"},
text={
ja={
{
"Unas horas después...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El sol comienza a ponerse y el cielo se torna de color naranja. Los colores del\nárbol de olivo dulce se mezclan con los del paisaje que lo rodea.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Seguí dibujando, hasta el último instante en que pude percibir el color del\nárbol.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... terminé.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toma... ¿Qué tal esto?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Le muestro a Nagayama el dibujo que había acabado de terminar.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000395",ch="knd"},
},
ja={
{
name={"Kana"},
"“E-Esta cosa...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000396",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿P-Por qué pintaste con tu mano izquierda?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres saber por qué? Aquí tienes la razón...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Comienzo a dibujar ahora con la mano derecha.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Sin embargo, mi mano derecha no me obedecía. Temblaba ligeramente, deformando\nmis líneas.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9046",vol=30,id=1},
{"text"},
text={
ja={
{
"Hasta que al final, el lápiz se resbaló de mis dedos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como me lo esperaba...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000397",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Qué quieres decir... con eso?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hace falta que te lo explique? Tu muy bien sabes distinguir lo auténtico de la\nbasura, ¿no es suficiente ya con esto?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000398",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad tengo que decirlo? No puedo controlar mi mano derecha. Tan simple\ncomo eso.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000399",ch="knd"},
},
ja={
{
name={"Kana"},
"“T-Tenía la idea... Ya me había dado cuenta de que has procurado no usar más tu\nmano derecha...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000400",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Pero cómo es que llegaste a este nivel de no poder pintar absolutamente\nnada?!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo qué sé. No puedo dibujar, punto.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000401",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahora que lo recuerdo... cuando éramos niños...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000402",ch="knd"},
},
ja={
{
name={"Kana"},
"“No, qué más da. No importa la razón...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000403",ch="knd"},
},
ja={
{
name={"Kana"},
"“La realidad es que... Naoya Kusanagi... ya no puede pintar...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000404",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aja.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000405",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ajajajajajajajajajaja...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Nagayama se río con una voz áspera.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000406",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eres chatarra ahora... Eso es lo único que sé en este momento...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_knd_000407",ch="knd"},
},
ja={
{
name={"Kana"},
"“Supongo entonces que esos cuadros no son tuyos.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_knd_000408",ch="knd"},
},
ja={
{
name={"Kana"},
"“Una chatarra como tú no podría haber pintado esos cuadros.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000409",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y-Ya veo. Entonces Sakura Nanasouzu no es obra de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000410",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Será qué sí es entonces de Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000411",ch="knd"},
},
ja={
{
name={"Kana"},
"“Bah, no importa. De igual forma, ya ninguno de los dos puede pintar.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000412",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Pues eres basura ahora!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000413",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡No eres más que una más de las tantas imitaciones que circulan por el mundo!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000414",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Naoya Kusanagi es solo una imitación barata!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin duda alguna.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_knd_000415",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Tu valor no llega ni al nivel de los desechos ahora!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En lo que concierne a la pintura, sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000416",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¡--!!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0007",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000417",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¡¿Q-Qué idioteces dices?!! ¡¡No me jodas!!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000418",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¡I-Intenta por lo menos defenderte!! ¡¿Por qué estás de acuerdo con todo lo\nque digo?! ¡No es normal!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De qué hablas?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_knd_000419",ch="knd"},
},
ja={
{
name={"Kana"},
"“Basura, imitación, chatarra... De escuchar eso, Naoya Kusanagi se...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Enfadaría?... Pero si es la verdad...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000420",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Verdad?... ¿Qué estás diciendo? Eso no puede ser verdad.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000421",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tienes a alguien como yo, diciéndote que eres una basura. ¡¡Y ni siquiera\nintentas defenderte!!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000422",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡No es posible semejante ridiculez! Eso no puede ser cierto...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tus ojos no te engañan. Así como lo dices, tienes el poder de distinguir lo\nauténtico de la basura. Qué bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000423",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Cómo es que puedes comportarte de esa manera tan frívola aún después de que\nhayan dicho todo eso?!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué mujer más extraña eres, eh. ¿Por qué me estás pidiendo que me enoje\ncontigo?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0010",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000424",ch="knd"},
},
ja={
{
name={"Kana"},
"“Enfádate, aunque sea un poco. Por favor, ¡o sino!... Ahora que no puedo vivir\nen mi propio mundo al ver tus pinturas... sería muy humillante.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no puedes vivir en tu propio mundo?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0010",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000425",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Así es! ¡Mi mundo era mi preferido hasta el día en que vi tus cuadros! ¡Era el\nmás resplandeciente entre todos! Pero cuando vi tus cuadros... los míos\nperdieron su brillo de inmediato...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Heeh...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Yo también llegué a observar muchos talentos en Nueva York.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Y ver a varios de esos genios me hizo sentir en carne viva, más de una vez, mi\npropio límite.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Y por eso es que――",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues estás bien equivocada entonces... En este enorme mundo hay de todo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun si no me hubieses conocido, en algún momento encontrarías a alguien con más\ntalento que tú, y te darías cuenta de tu propia pequeñez...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que alguien de mi nivel te haya hecho sentir así dice mucho de tu propio nivel.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como puedes ver, soy un mediocre más, como todos. Bueno, quizá si tengo suerte\npodría entrar en una universidad de artes, pero igualmente me sería difícil\nvivir como artista.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi habilidad para el dibujo y el diseño no es despreciable, pero... no tengo\nnada de expresividad.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como tú lo dices, soy solo una basura...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Defenderme? ¿Defenderme de qué? Es la verdad...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0007",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000426",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡N-No digas más nada! ¡Basura!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0020",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000427",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tú, tú solo... lo único que logras... es, que yo... que yo... me ponga más\ntriste...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?... Pues hasta nunca entonces. No vuelvas a buscarme.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0021",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000428",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Cállate! ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"se",file="se0744s",id=1},
{"fg",ch="香奈",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"¿Por qué tengo que escuchar a esa muchacha gritándome?...",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Sin siquiera saber cómo yo me siento...",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="eveningsky_spring01",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Las personas nunca se cansan de decir lo que les viene en gana.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"A veces te llaman genio, otras veces mediocre.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Te alaban, luego te desprecian, y al final, te olvidan...",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces el niño prodigio termina creciendo en un adulto cualquiera, idiotas...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Llegué a la casa de los Natsume cuando ya el sol se había puesto por completo.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"El sol casi imperceptible,era ya de noche.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Ya se acerca el invierno...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Se acerca la época por la que mi padre regresó el año pasado.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En dos meses ya habrá pasado un año...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Qué rápido ha pasado todo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Sin razón en particular, me acerqué al taller.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"El invierno pasado estuve pintando acá, a finales de año.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Se siente como si hubiera sido ayer.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"se",file="se2264",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tú...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="man_frd_000194",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tiempo sin vernos, Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué sorpresa encontrarnos en este taller, eh... ¿Qué viniste a hacer aquí?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000195",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Habiendo sido amigo de Kenichiro, ¿qué problema podría haber que visite su\nviejo taller?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Has ingresado ilegalmente a propiedad privada.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000196",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Te equivocas. Procuré pedirle permiso a la encargada de la casa.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Permiso? ¿A Ai?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_frd_000197",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“He visitado ya unas cuantas veces a la señorita Ai Natsume en mi labor como\nalbacea.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000198",ch="frd"},
},
ja={
{
name={"Fridmann"},
"He hablado con muchas más personas de las que te imaginas. Es mi trabajo...",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Fridmann camina lentamente por el taller.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000199",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Hay más cuadros que la vez pasada que vine... aunque, no parecen ser tuyos.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Yo dejé de pintar.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0003",head="fri_z1b",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うんうん",lv=4,id=9},
},
vl02={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000200",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Dejaste de pintar, eh... fufufu, sí. Lo había olvidado.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Fridmann camina lentamente mientras observa los lienzos esparcidos por el\ntaller.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Aun así, su expresión no cambia ni un poco.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_frd_000201",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“I dwell in Possibility―\nVivo en la posibilidad.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_frd_000202",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“A fairer House than Prose―\nUna casa mejor que la prosa.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="man_frd_000203",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“More numerous of Windows―\nQue tiene más ventanas.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_frd_000204",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Superior―for Doors―\nY puertas superiores.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_frd_000205",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Of Chambers as the Cedars―\nY con cedros en sus cámaras.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_frd_000206",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Impregnable of Eye―\nInexpugnables al ojo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_frd_000207",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“And for an Everlasting Roof\nThe Gambrels of the Sky―”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_frd_000208",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y que por techo eterno tiene, tejas del cielo――”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_frd_000209",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Of Visitors―the fairest―\nLa visitan solo los más hermosos.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="man_frd_000210",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“For Occupation―This―\nY mi trabajo es.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_frd_000211",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“The spreading wide of narrow Hands\nTo gather Paradise―”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_frd_000212",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Extender estas pequeñas manos, y tomar el paraíso.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De quién es ese poema?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000213",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nací en Amherst, Massachussetts. El lugar es famoso por haber sido la tierra\nnatal de una genio de la poesía americana.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000214",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y así como a los demás, de niño me solían cantar sus poemas al dormir.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La poeta genio de Amherst?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Emily Dickinson...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000215",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Emily publicó solo siete poemas mientras vivió.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="man_frd_000216",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nunca se casó, y al parecer siempre se quedaba encerrada en su casa...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_frd_000217",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Probablemente ella sabía.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_frd_000218",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Conocía la magnitud de su genialidad, y sabía que los comentarios de la gente\nordinaria no servían de nada...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_frd_000219",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Seguramente vio como idiotas a aquellos críticos literarios que intentaron\nconvertir su estilo de escritura en algo romántico al tratar de publicar su\nobra cuando aún seguía con vida...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000220",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Me lo puedo imaginar muy bien...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000221",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“A ver, a quién le sientan mejor estas palabras...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
{"fgact",ch="フリッドマン",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000222",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nada realmente profundo, olvídalo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Fridmann se detiene.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000223",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Así que Naoya Kusanagi no piensa presentar nada en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso tengo pensado.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000224",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Buena decisión. Sería una perdida de tiempo, después de todo...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? No me digas que has venido hasta acá solo para darme malos comentarios.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000225",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No hago nada que no me dé dinero. Por lo que obviamente no vine hasta acá para\nburlarme de ti.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estabas viendo los cuadros de Kei Natsume entonces?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000226",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, bueno. Digamos que como pintor es más interesante que tú.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_frd_000227",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque, jamás vendría a los extremos del oriente solo para ver a ese jovencito.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No estás acá porque te encargaron con la organización de la exposición en\nJapón?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000228",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, así es. Aunque, tenía la opción de ocuparme de un bloque distinto.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces――”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="フリッドマン",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="フリッドマン",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/fri/z2/",file="fri_z2a0000",face="a0007",head="fri_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0008",head="fri_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000229",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Japón es una tierra sin arte. Un terreno baldío.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir? ¿Para americanos como tú el arte no existe en Japón?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0007",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000230",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Vaya idiotez que dices. ¿Dónde más vas a encontrar a un país con una historia\nartística tan profunda como Japón?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0001",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000231",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es el país de la escritora de la primera novela del mundo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Genji Monogatari? Sí, bueno, eso dicen también...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0008",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000232",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En primer lugar, ningún curador americano sería capaz de tomar a la ligera la\npintura japonesa.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0002",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000233",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Estados Unidos posee más pinturas impresionistas japonesas que el mismo Japón.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_frd_000234",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En especial los ukiyo-e. Aun si quitas la enorme influencia que tuvieron sobre\nel movimiento impresionista, son únicos a nivel internacional.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_frd_000235",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El maniático de la pintura que dejó treinta mil obras durante toda su vida,\nHokusai Katsushika. Hiroshige Utagawa, reconocido como Hiroshige Blue. Ambos\npintores de fama internacional que inspiraron fuertemente a Europa.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_frd_000236",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y por supuesto, no solo ukiyo-e. Las sumi-e de Sessuu, la escuela Kanou de\nMuramachi, y la escuela Rinpa que tantos genios produjo. La escuela Maruyama,\nItou Jakuchuu, Rosetsu Nagasawa...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0003",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000237",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Este país está lleno de genios. La genialidad se desborda.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué dices entonces que es un terreno baldío?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0008",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000238",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es uno de los pocos países donde aún sin existir todavía el término de cultura\nde masas, el pueblo tomó las riendas de la cultura sin revolución alguna.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0001",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000239",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tanto Hokusai Katsushika como Hiroshige Utagawa no fueron pintores\nparticulares. Fueron artistas nacidos en la cultura Chonin, esa basada en\ntrabajos de producción masiva como los ukiyo-e.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_frd_000240",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué forma pudo haber tomado entonces el arte de este país ante esa\nmasificación traída por la modernización?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_frd_000241",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“La cultura popular acá ha vivido con fuerza aún antes de la entrada de la\ncultura de masas. ¿Qué podría significar entonces el arte para un país así?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_frd_000242",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Por qué Mishima tuvo que elegir la muerte?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_frd_000243",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Por qué Okamoto se refirió a su actividad artística posguerra como 'shadow\nbox'?...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Con Mishima se refiere a Yukio Mishima. Con Okamoto se refiere, seguramente, a\nTaro Okamoto.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_frd_000244",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sus actitudes eran completamente opuestas, pero eran en fin, la actitud de\nartistas que se vieron obligados a ver el supuestamente eterno y majestuoso\npalacio imperial caer.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_frd_000245",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El palacio cayó, dejando solo una montaña de arena.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que el actual mundo artístico japonés es solo una montaña de\narena?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fgact",ch="フリッドマン",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000246",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0002",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000247",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque a este país le basta con tener un enorme vacío.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_frd_000248",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Basta con un vacío en el centro, y así no necesitaría de núcleo alguno. Valores\nde la debida verdad. No hace falta ninguna sublime, majestuosa edificación.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué complicado todo eso, eh. No entendí nada.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0008",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000249",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En pocas palabras, es difícil negociar con arte en este país. Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="フリッドマン",size="z2",mode=3,path=":fg/fri/z2/",file="fri_z2a0000",face="a0007",head="fri_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000250",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es un terreno donde el arte no crece.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que consideraste entonces a Kenichiro Kusanagi como buen negocio?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000251",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Kenichiro no tardó en dejar Japón atrás y venir a los Estados Unidos.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces Kenichiro Kusanagi no tenía esencia japonesa?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000252",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Al contrario, su temática eran los cerezos, su esencia era muy japonesa.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que tuvo éxito entonces?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000253",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Su éxito se debió a su empeño en mantener su esencia japonesa.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_frd_000254",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Él tomó el peculiar vacío de este país y lo convirtió en un símbolo\ninternacional.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El vacío... como símbolo internacional...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_frd_000255",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Todos los países tienen su religión. Cada pueblo tiene un enorme templo en su\nnúcleo, cada cual con una larga historia.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="man_frd_000256",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pero en la cultura japonesa ese enorme, histórico templo ha estado ausente por\nun largo tiempo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_frd_000257",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En el centro de la enorme metrópolis de Tokyo está el palacio imperial, un\nespacio vacío, sin más que bosques a lo largo de su extensión.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_frd_000258",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y Kenichiro entendió muy bien ese factor.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="man_frd_000259",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Las obras de Kenichiro tomaban ese elemento en sí, produciendo un estilo\njaponés de vacío, muy único comparado al de las otras culturas.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_frd_000260",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Su visión de la vida y la muerte era hermosa, simple y básica como un Hakoniwa.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_frd_000261",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No es coincidencia que los cuadros de Kenichiro Kusanagi hayan sido fuertemente\ninspirados por Kenji Miyazawa.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="man_frd_000262",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En su vacío hay fineza y simplicidad. Una vez cautivados por ese arte,\ncualquier persona es capaz de entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="man_frd_000263",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El zen es famoso en Europa y América. El mismo Steve Jobs era un fanático\nempedernido.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_frd_000264",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El vacío y la nada. Él era, de cierta manera, un artista sencillo de\ncomprender.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="man_frd_000265",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y por eso sirvió como negocio.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000266",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pero él fue la excepción, y no la regla. Personajes como Kenichiro Kusanagi son\nmuy raros. No es la clase de talento que puedas reemplazar fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="man_frd_000267",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Este país tiene una cultura muy rica. Pero no es arte.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000268",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nada relacionado a mi trabajo...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No logro discernir si amas u odias a Japón, Fridmann...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000269",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Odio a Japón porque no da dinero. Pero si llegase a dar buenos negocios, podría\ndecir lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Has encontrado algo que te pueda producir dinero?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000270",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No lo sé, en realidad.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000271",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque procuraré dar unas cuantas vueltas y observar bastante hasta el día de\nla exposición.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_frd_000272",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“A lo cual decidiré. Como el curador de la Fundación Moore, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="フリッドマン",speed=2000,mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x2=0,x=500,lv=4,id=9},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Fridmann se dirigió a la salida del taller.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te enteraste?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000273",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... nada...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000274",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aun si Kenichiro Kusanagi no me dijera nada al respecto, si se trata de algo de\nvalor lo descubriré tarde o temprano.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que tienes poderes psíquicos o algo por el estilo?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="man_frd_000275",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No. Búsqueda de información y observación de personas, es todo...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="フリッドマン",mx=40,mode=-1,lv=4,id=9},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Fridmann terminó de salir y se fue.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Algo que dé dinero.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=300000,file="zbg009a",path=":bg/",x2=960,y2=-586,x=-960,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Camino por el taller siguiendo el mismo camino que Fridmann.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Allí estaban todos los nuevos cuadros que Kei había creado.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Todas eran obras de altísimo nivel.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ninguna de ellas...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Todos estos cuadros serán, probablemente, desechados.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Todos eran de alto nivel, pero eran restos.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Como cáscaras vacías.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Cáscaras rotas por esa cosa que vive y se retuerce dentro de Kei.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Correr adelante, eh...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"¿Qué tanto piensas correr?...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"¿De qué manera se supone que puedo alcanzarte?...",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bgm",stop=1,time=300},
{"text"},
text={
vo={
{"vo",file="man_ked_001219",ch="ked"},
},
ja={
{
name={"???"},
"“¿Oeh? ¿Naoya?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei?... ¿Ya habías vuelto?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"bgm",file="bgm029"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001220",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué pena. Apenas acabo de regresar. Nee-chan me llevó al hospital antes de\nvenir.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse. ¿Y? ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001221",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me diagnosticaron con una severa falta de sueño y malnutrición. Me inyectaron\nalgo de suero y me siento mucho mejor ahora.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El sueño no se quita con suero.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001222",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso no es de importancia ahora. Así que estabas en el taller eh, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí... solo, por casualidad.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001223",ch="ked"},
},
ja={
{
name={"Kei"},
"“Puedes usar el taller, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001224",ch="ked"},
},
ja={
{
name={"Kei"},
"“Este taller le perteneció a Kenichiro Kusanagi. Es lógico que seas tú quien lo\nuse.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, se supone que el taller es de los Natsume, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001225",ch="ked"},
},
ja={
{
name={"Kei"},
"“Da igual. Este almacén es genial, eh. Hace que te concentres.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... bueno, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001226",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Kei suelta una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Kei...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001227",ch="ked"},
},
ja={
{
name={"Kei"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees que yo voy a pintar algo?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001228",ch="ked"},
},
ja={
{
name={"Kei"},
"“No. No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001229",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tal vez pintes, tal vez no...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001230",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero como te dije ayer, si no corro con toda mis fuerzas no podré alcanzarte.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... ¿Sabes? Justo ahora acabo de encontrarme al curador de la Fundación\nMoore.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001231",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿En serio? ¿A qué vino?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Dijo que estaba buscando información.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001232",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No estará esperando que pintes algo?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería una perdida de tiempo que lo hiciera, me dijo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001233",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ese idiota no tiene ni idea de lo que habla. Para nada.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo creas, tiene muy buen ojo.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001234",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué estás diciendo? Si te tomas eso en serio y decides no pintar nada,\ncréeme que me enfadaré.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquilo, si bien tiene buen ojo, sus palabras no son de confiar.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001235",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un mentiroso. Nunca dice lo que realmente piensa...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Al ver los cuadros de Kei, seguramente pensó lo mismo que yo.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"De la posibilidad que hay de que Kei comience a transformarse en algo más\ngrande con esto...",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Y a pesar de eso, mantuvo su cara impasible.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="man_ked_001236",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues no da muy buena espina ese sujeto, eh.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muy mala espina diría yo...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Si vas a darme este taller dónde se supone que trabajarás tú?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001237",ch="ked"},
},
ja={
{
name={"Kei"},
"“En la sala de arte, supongo.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué vas a hacer en la noche? Planeas quedarte trabajando hasta tarde, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001238",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues no hay problema, creo. Siempre y cuando el vigilante no me pille.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa idea es ridícula, por Dios... De verdad que nunca piensas las cosas, eh...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toma esto.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"se",file="se9020",vol=50,id=1},
{"mwact",act="ジャンプ"},
{"text"},
text={
ja={
{
"Le lanzo a Kei un estuche de llaves.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"se",file="se1815",id=1},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001239",ch="ked"},
},
ja={
{
name={"Kei"},
"“Owah, oh, oh... ¿Eh? ¿Llaves?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son las llaves del apartamento en Sakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="man_ked_001240",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué me las das?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía quedan varias de las obras de Kenichiro Kusanagi. De cuando tenía\nnuestra edad, de su época pre-estrellato, antes y después de ser galardonado,\nmuchas.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, en cualquier momento las reunirán y se las llevaran del apartamento.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puesto que renuncié a la herencia...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque todavía quedan un gran número de cuadros.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="man_ked_001241",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que es buen momento de que veas los cuadros de alguien que realmente llegó\na ser galardonado en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y te conviene percibir esa transformación en carne propia.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001242",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Me dejarás usar el apartamento?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues si me vas a dar el taller a mí necesitarás algún lugar donde pintar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001243",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¡¿Eso significa, q-que también pintarás, Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No esperes mucho de mí. Haré lo posible, pero... no tengo la confianza de poder\npintar algo que te pueda satisfacer en esta etapa tuya.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="man_ked_001244",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Eso no es cierto! Tus cuadros son los mejores.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo tomaré como un cumplido. Me dan ganas de pintar cuando me dices eso.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0003",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001245",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Genial!”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Kei sonrío alegremente.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"¿Será que el talento de Kei podrá salir de la cascara y extender sus alas? ¿O\nmorirá sin salir de esa cascara?",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"En su estado actual, diría que las posibilidades son cincuenta-cincuenta.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Aun así, sabiendo que pintaré podría elevar las posibilidades de que Kei\nemprenda vuelo.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Sonará tonto, pero esa es una de sus fortalezas.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"No creo poder ganarle a Kei, pero si pintando logro hacer que su talento\nflorezca,",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"quisiera ofrecerme entonces a ayudarlo.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿será que preparo la comida ya?”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0017",head="kei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001246",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Aún no has preparado nada?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te dieron suero, ¿no? Me imagino que no necesitas comer entonces.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0003",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001247",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pero qué tontería dices? Jamás rechazaría un plato tuyo.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Santo cielo, realmente das asco cuando dices esas cosas, eh.”",
{"rt2"},
},
},
},
linkback="block_00292",
