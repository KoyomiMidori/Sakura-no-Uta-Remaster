vo={
{"vo",file="fem_szd_001268",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“U-Uhh... Naoya, realmente te gustan los juegos de humillación.”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me encantan.”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
vo={
{"vo",file="fem_szd_001269",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien... si así lo quieres, yo... me daré por vencido...”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, quiero ver tu vagina... quiero verla.”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"bg",file="ev_shz_h02_03",sync=0,face=1,time=400,path=":ev/ev_shz_h02/",set="ev_shz_h02"},
{"text"},
text={
ja={
{
"Despojo a Shizuku, quien no ofreció ahora resistencia alguna, de sus\npantis.",
