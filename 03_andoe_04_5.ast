vo={
{"vo",file="fem_szd_001352",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No lo sé... no lo sé, pero... se siente tan bien, al fondo... Tu pe*e está\nmoviéndose y tocándome en mi zona más profundaaa... Haaiihh... noo... lo\nsiento tan bien adentro...”",
