astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Ahora que lo recuerdo, al momento de organizar las negociaciones de\nlas Nanasouzu, el viejo me exigió que les arrebatara el Hakuki Kagurasuzu.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001100",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Tenerlo en nuestro poder era la llave definitiva para alcanzar mi libertad\nde los Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Así que de eso se trataba...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001101",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Y por eso estoy agradecida contigo. Por haber robado la campana de los\nNakamura.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, la verdad es que lo del juramento no me convencía mucho. Pero siendo así\nde importante esa campana Kagura, pues supongo que ya no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001102",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Ya no tienen manera de saber si soy o no Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Supongo que con esto ya se ha resuelto por completo este asunto...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001103",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, pero esta historia aún no termina.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aún no?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0009",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001104",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aún falta un pedazo de la historia... Del talento que le robé a Rin.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"El talento que Shizuku le robó a Rin...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Un poder artístico casi cercano a la materialización.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Ese descomunal, anormal poder.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Rin no tenía ya ese poder. Y Shizuku, quien se supone que había tragado el\npoder, tampoco lo tenía.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"De ser así, en algún otro lugar debería estar ese poder.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Así que después de haberte tragado todo el talento de Rin, ese talento\nse fue a algún lugar.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001105",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. No sería correcto decir que desapareció.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo. Pero no está en tus manos ahora.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001106",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese talento, ese poder, adquirió forma.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Un poder con forma concreta.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"En pocas palabras.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0003",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001107",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, mi otra amiga.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001108",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quiero hablar de ella ahora.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De Sui...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001109",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no... solo que, dudé un poco.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001110",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No quieres que te hable de Sui?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo que, ¿cómo podría decirlo?... Pensé que, quizás deberíamos pedirle permiso\nantes...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Digo, lo que me vas a contar es algo que ella también ha mantenido en secreto,\n¿no?...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001111",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Secreto... de Sui?...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001112",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo, jaja... sí. Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque tratándose de ella, probablemente diga 'no me importaría', o algo así.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001113",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero de igual manera tienes razón, es mejor pedir su permiso antes. No en vano,\nes una de mis pocas amigas...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"excall",label="yesextrascene",cond="s.scene==1",call=0},
{"excall",label="noextrascene",cond="s.scene==0",call=0},
{"bgm",file="bgm003"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9,sync=0},
{"extrans",time=1500},
{"text"},
text={
ja={
{
"Al terminar de hablar del tema con Shizuku, las agujas del reloj estaban ya\npuestas tras el mediodía.",
{"rt2"},
},
},
},
labelcount=9,
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya pasaron de las doce.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001114",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún no hemos almorzado, debes estar hambrienta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001115",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Iré a preparar algo entonces.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0016",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001116",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hace falta.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No hace falta? ---”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
delay={
[100]={
{"bgm",stop=1,time=500},
{"se",id=1,file="se3356"},
{"bg",time=300,sync=0,file="black",path=":bg/"},
},
},
text={
ja={
{
"Shizuku se arrima hacia mí.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_szd_001117",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*chuu*... *chu*...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ngh?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y me besó repentinamente. Con un beso caliente y pegajoso, enrollando las\nlenguas.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_szd_001118",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... *shppph*... *chu*... *puhaaa*.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009j",head="shz_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm103"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*puhaa*, ¡¿Q-Qué te pasó?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001119",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pensé en lo amable y bueno que eres... y no pude evitar besarte.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Amable y bueno? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001120",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es nada, solo que cuando vi la manera en que te preocupas por Sui... pensé,\nen lo bueno que eres... y no pude evitar besarte.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no me molesta que me beses, pero recuerdo haberte dicho que iría a\npreparar el almuerzo.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001121",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y ya te dije que no me hace falta. Me saciaré con tus sueños...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta, yo nunca tomo siestas en la tarde. Y deja ya de usar el poder de Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001122",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero... tus sueños se sienten tan rico...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo cuando se tratan de sueños eróticos, ¿no? En otro caso podría suceder algo\ngrave.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001123",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tienes razón. Es una decisión difícil.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaaa...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0015",head="shz_z2a",lv=5,id=9},
{"ex",time=0,func="wait"},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_001124",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Mm?!... *chu*... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Esta vez la beso yo a ella.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para qué tragar sueños eróticos? Si es por hacerte sentir bien, hay muchas\nmaneras...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",my=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0011j",head="shz_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0009j",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001125",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Ah, Naoya, tu pene está erecto.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Culpa tuya por decir cosas raras... Encendiste mi interruptor.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0016",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001126",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué bueno saber eso. Mi interruptor lleva ya un buen rato encendido.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estamos todavía a plena mitad del día, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001127",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ai nee-san está hoy en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé. Debe ser terrible tener que ir al colegio en vacaciones...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001128",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kei nii-san está encerrado en el taller.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y probablemente está dormido...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001129",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En pocas palabras, no hay problema alguno.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡U-Uwaaah!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0100",face="b0016",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",id=1,file="se3356"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Shizuku termina por tirarme al suelo.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Dime algo... ¿Había necesidad de que me echaras contra el suelo?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0003j",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001130",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estoy excitada.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no sirve como argumento.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0009j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001131",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No te gusta esto?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No seas tonta...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Cargo a Shizuku y la beso.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo podría desagradarme?...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0002",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001132",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Menos mal...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debes saber que de seguir, no habrá manera de parar.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0016",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001133",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hace falta que pares.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces toma responsabilidad por lo que me está sucediendo abajo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0013",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001134",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Responsabilidad?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, quiero decir... Una vez lo dijiste, ¿no? Lo de la paja... y eso...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001135",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah~, así que eso deseas. Personalmente, esa elección me atrae bastante.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto... ¿De verdad... lo harás?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0003",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001136",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bue, no...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_shz_h04_01",path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Shizuku abre la cremallera de mi pantalón y lo baja. Mi inflado miembro se\ndescubre con un fuerte movimiento.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"quake",size=4,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001137",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Oh--?!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sorprendida?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_szd_001138",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, salió con bastante fuerza.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí... está muy duro...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_szd_001139",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mmm, increíble... Así que esta enorme cosa entró en mí ayer...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En lo personal, no me parece tan grande.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_szd_001140",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eso crees? Para mí lo es bastante...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Sí, bueno, considerando la enorme diferencia de estatura entre los dos, es\nprobable que por escala se le haga grande...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_szd_001141",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Conque esta forma tiene... es impresionante. Es más fácil de ver a plena luz\ndel día.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me da algo de vergüenza que... te quedes mirándolo... así, en silencio...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_szd_001142",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Vergüenza? Ya veo. ¿Es esto a lo que llaman un juego sexual?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué vas a lograr haciendo juegos sexuales conmigo?...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_szd_001143",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Verte morirte de placer y vergüenza... Ahora que lo pienso, no suena nada mal.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que suena bien mal. Se supone que eres tú la que debe ser blanco de esos\njuegos, no yo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_szd_001144",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te parece? En mi opinión, se me haría muy moe ver tu cara sonrojada en\nvergüenza...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No aspiro a participar en ese tipo de actos eróticos.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_szd_001145",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No? A mí sí me gustaría verte disfrutar de algún acto degradante, como un\nfootjob, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues a mí no.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_szd_001146",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No? Yo creo que sí te gustaría bastante. ¡Bien, prepárate para disfrutar de\nmis pisadas!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, escucha. Pedir un footjob de un día para otro es demasiado... Apenas y\nes la primera vez que tengo a alguien mirándome tan fijamente mi miembro...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_szd_001147",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Disfrutas que lo vea fijamente?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Claro que no!... Ngh.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*pikun*",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_szd_001148",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mm?... Se acaba de mover... se movió.... ¿Reaccionó a mi mirada?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Te equivocas, ¡no es por vergüenza ni nada de eso!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Siento el aliento de Shizuku debajo. Mi miembro reaccionó sin querer ante esa\npenetrante mirada.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*pikun*",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_szd_001149",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Se volvió a mover. ¿No será que realmente sí te gustan los juegos de\nhumillación?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_szd_001150",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad? Me cuesta mucho creer eso...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡S-Shizuku, quítate la ropa interior tú también!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_szd_001151",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No es justo que sea yo el único desnudo y con la mirada sobre mis genitales!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_szd_001152",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y por qué no?... No pareces estar pasándola mal, además.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso no es ciert-- nghhh.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*pikun* *pikun*",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_szd_001153",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mira nada más, está dando saltitos... Y eso sin haberle puesto un dedo\nencima...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que... ngh, siento tu caliente aliento cerca, y... agh.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*pikun*!",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_shz_h04_02",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
ja={
{
"En ese pequeño salto, la punta de mi miembro tocó la mejilla de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_szd_001154",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah... ah, me tocó...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Un cálido aliento rodea mi miembro. Puedo sentir con mis genitales que la\nrespiración de Shizuku está ganando humedad.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_szd_001155",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“M-Me tocó la mejilla... y... soltó un hilo...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Llevas ya un buen rato estimulándolo con tu cálido aliento, ¿qué esperabas?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_szd_001156",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Está reaccionando a mi aliento? No puedo creer que te sientas excitado solo\npor tener a alguien viendo y soplando tu miembro... Eres realmente un pequeño\nun pervertido, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tu aliento está demasiado caliente, solo eso... A-Además, estarás tratando de\nhacerte la indiferente, pero tu cara también está roja.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_szd_001157",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Sí... tienes razón, mi rostro está caliente. Pero es por... verte disfrutando\nde esta manera...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién es el humillado aquí entonces?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_szd_001158",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tú. Eres un pequeño pervertido que le gusta ser humillado. Y te haré algo muy\nbueno ahora...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo muy bueno?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_szd_001159",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, solo déjate llevar y disfrútalo. Te convertirás en mi esclavo, en un\nesclavo del placer y la vergüenza.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No voy a convertirme en ningún esclavo!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_szd_001160",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Shizuku soltó una pequeña sonrisa, y acercó su nariz a mi miembro.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_shz_h04_03",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001161",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... *uuhh uuhh*.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_szd_001162",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estoy oliendo tu pene... Tiene un olor, ah, bastante sucio.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_szd_001163",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*uuhh uuhh*... sí, puedo sentir bastante de ese olor acá...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Si sigues oliendo con tanto empeño ahí, yo...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_szd_001164",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te da pena? Aunque, deberías darte por vencido. Este olor, no me desagrada...\nmás bien, me encanta... *uuhh uuhh*...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_szd_001165",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*uuhh uuhh*... ah... Creo que también me gusta el olor acá... *uuhh uuhh*...\na-auhh...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Shizuku olfatea mi miembro de la base hasta la punta. Y siento su respiración\nagitarse a medida que lo hace.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Entre cada olfateo, un cálido aliento sopla sobre mis genitales. Y no tengo\nmanera de describir cómo se siente.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_szd_001166",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*uuhh uuhh*... *uuhh uuhh*... auhhh...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Entre cada olfateo, Shizuku suelta un corto aliento.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku... me...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_szd_001167",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te da pena?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me da pena... y quiero decir, no sigas oliendo mi miembro.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_szd_001168",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No te preocupes, en un momento te haré algo aun mejor... Es regla básica de la\ncata oler antes de saborear...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cata? No es un vino, por Dios...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_szd_001169",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí lo es. Primero se disfruta del aroma, luego se mueve con la lengua... y\nfinalmente, se bebe...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ungh...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_szd_001170",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sentiste el corrientazo al imaginártelo?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por supuesto que n-- ugh...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"De repente, Shizuku acercó su cara a mi miembro y lo envolvió con su mano\nderecha.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="ev_shz_h04_04",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Auh...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_szd_001171",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No lo puedo creer... Así de caliente se pone...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agh...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Dejé escapar un fuerte gruñido. Al escuchar eso, Shizuku, alegre, comenzó a\nmover con entusiasmo su mano derecha.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Acariciando lentamente, pasa luego a cosquillear la corona de mi glande. Entre\ncada movimiento se me para la respiración y se me escapan pequeños gruñidos.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_szd_001172",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahh... Naoya, tu pe*e... está oliendo más fuerte que hace un rato... Tiene un\nolor más sucio aun ahora... Naoya, eres un pervertido.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... e-es que... tu mano, y...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_szd_001173",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mi mano, y...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De tanto acercarte, a veces también tu mejilla me toca...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_szd_001174",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te excita tocar mi cara?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, cómo no... es suave, lisa... y, además...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_szd_001175",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y... además?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La sola idea de que mi miembro toque tu preciosa cara...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_szd_001176",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hace que te excites?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikun*!",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Solo unos centímetros de distancia alejan mi miembro de su lisa y tierna\ncara... Apenas me imaginé eso, este dio un gran salto.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_szd_001177",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te lo imaginaste? ¿Fue por eso que saltó tan fuerte tu cosita, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_szd_001178",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De ser así...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡A-Auhhh!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_shz_h04_05",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
ja={
{
"Una tierna sensación me invade. Una tierna, suave sensación que jamás antes\nhabía experimentado.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Shizuku presiona mi miembro contra su mejilla.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahh... tu mejilla, y mi pene...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_szd_001179",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te gusta?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... se siente, muy bien... ugh...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_szd_001180",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tu pene está realmente caliente... Siento que mi mejilla se va a quemar...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que... Además, tu mejilla también está caliente...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_szd_001181",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_szd_001182",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo también estoy excitada, así que es probable... ¿Qué tal así?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ah... kuh...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Shizuku roza su mejilla contra mi miembro. Su carnosa sensación se sentía muy\nbien.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_szd_001183",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué tal? ¿Te gusta que roce mi mejilla contra tu pene?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... s-se siente, excelente...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Entre cada roce de mi miembro, la mejilla de Shizuku se va cubriendo con\nlíquido preseminal.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_szd_001184",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Llevas un buen rato soltando ese sucio y pervertido líquido... Naoya.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh... se siente muy bien... Frótalo más...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_szd_001185",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buen chico. Me gusta que seas honesto.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Augh... se siente muy bien... Estoy, por... venirme.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_szd_001186",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esos gemidos, me gustan. Te quedan muy bien, pequeño pervertido.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, hables de gemidos...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_szd_001187",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo haré. Quiero escuchar más de esos gemidos tuyos. Quiero que gimas más,\n¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... Yo no voy a, gemi... Kuhaah.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_szd_001188",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cómo te encanta que te humillen. Realmente eres un pequeño pervertido.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, a-ah, n-no aguanto más. E-Estoy por venirme, de verdad... n-no puedo,\naguantar má... s.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_szd_001189",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Puedes venirte si quieres, pero... te advierto que no terminará acá.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿P-Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_szd_001190",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ayer me corrí tres veces. Así que hoy me encargaré de que te corras más que\neso.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Yo, no podría...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_szd_001191",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hoy puedes correrte tanto como lo desees... Haré todo lo que quieras para\ncomplacerte.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... auh... s-si sigues frotando con tu mejilla, yo... a-ah, no puedo...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Shizuku frota mi miembro contra su mejilla.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"bg",file="ev_shz_h04_06",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001192",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mi cara está cada vez más sucia con tus jugos...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Perdóname... pero, no puedo contenerme...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_szd_001193",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso no importa. Quiero que mojes más mi cara con ellos... Quiero que dejes más\nde tus pervertidos jugos sobre mi cara...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"La mano de Shizuku se mueve de la base de mi miembro a la glande. Al instante\nen que apretó fuertemente la punta, una fuerte descarga eléctrica corrió por\nmi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_szd_001194",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, ¿en qué pensabas mientras frotabas tu pe*e contra mi mejilla?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pensar, en qué?...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_szd_001195",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hay una parte más tierna y suave que mis mejillas... ¿No pensaste en lo bien\nque se sentiría si pudieras tocarme ahí?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Yo no...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_szd_001196",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Los labios son más suaves que las mejillas.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Shizuku vuelve a frotar mi miembro contra su cara.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_szd_001197",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quieres frotarlo contra mis labios?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikun*!",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_szd_001198",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te lo imaginaste, ¿verdad?... Volvió a saltar fuertemente...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_szd_001199",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Comenzaré con un beso de saludo...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"bg",file="ev_shz_h04_07",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
ja={
{
"La boca de Shizuku se acerca lentamente a la cabeza de mi miembro... y\nentonces――.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_szd_001200",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*chu*...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_shz_h04_06",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
ja={
{
"Fue tan rápido que no supe bien lo que había pasado. Pero sí sentí una tierna,\nsuave sensación en mi miembro que jamás antes había experimentado.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Acabas... de besarlo?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_szd_001201",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No te diste cuenta?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí me di cuenta, pero fue solo un instante...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_szd_001202",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Tan rápido que no pudiste disfrutarlo?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_szd_001203",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Pero no tienes por qué preocuparte, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_szd_001204",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tu pene entrará una y otra vez acá adentro. Tu pe*e va a violarme acá, de donde\nsale mi cálido aliento...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-En tu, boca... yo...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_szd_001205",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, cógela tanto como quieras... Usa mi boca como si fuera una vagina...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quieres, que use tu boca como una... vagina...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_szd_001206",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así es. Puedes frotarlo contra mi boca tanto como lo desees.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"bg",file="ev_shz_h04_07",sync=0,face=1,time=400,path=":ev/ev_shz_h04/",set="ev_shz_h04"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001207",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*chu*...",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Auh...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_szd_001208",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*chu*... *chuu*... *chu*.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizukuuu.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_szd_001209",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, *chuu*, *chu*, *shrr*... Ahh, si sigues frotando de esa manera... podría\nacabar entrando en mi boca...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh, S-Shizuku... se siente muy bien...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_szd_001210",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tranquilo. Frótalo más con mis labios y disfruta, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Al decir eso, Shizuku tomó mi miembro y lo apretó más fuertemente contra sus\nlabios.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_szd_001211",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nfuh... *chuchu*... *chuuu*... *shrrr*... *shgrrr*, *rerureru*...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_szd_001212",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*chu*, *chu*... Hauuh, Naoya, huele... ahm... ngh, tan bien... *shrrr*...\n*chu*.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizukuu... Shizukuuu... Kuh... Kgwaah.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_szd_001213",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, *chu*, *chu*, *chuuu*... *chu*, *chuu*... ngh, Naoya, está saliendo\nbastante de tu jugo... Jaa, haahn... nggh...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"No voy a aguantar. Si sigo frotando mi miembro con los labios de Shizuku,\nterminaré acabando sobre su boca...",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ya, ya no pue--, kuh... Voy a correrme, sobre... t-tu, boca...”",
{"rt2"},
},
},
