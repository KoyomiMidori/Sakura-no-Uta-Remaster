block_00568={
{"text"},
text={
vo={
{"vo",file="fem_szd_001349",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... sí... y-yo también... me moverée... kufuuuh... hauuh, ngh, mmm, ah, no,\nahí nooo.”",
