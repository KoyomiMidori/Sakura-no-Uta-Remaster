linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_szd_001247",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, cuando lo tengo al fondo de mi garganta... mi vagina, se calienta bastante.\nEs como si estuvieran conectados...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya... ya veo...”",
{"rt2"},
},
},
