},
block_00511={
{"text"},
text={
vo={
{"vo",file="fem_szd_001326",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... no es justo que me tomes por sorpresa...”",
{"rt2"},
},
},
},
linkback="block_00510",
linknext="block_00512",
},
block_00512={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería lamerlo, ¿qué puedo hacer?”",
{"rt2"},
},
},
},
linkback="block_00511",
linknext="block_00513",
},
block_00513={
{"text"},
text={
vo={
{"vo",file="fem_szd_001327",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya no más de abrirlo. Me pone muy sensible cuando lo haces.”",
{"rt2"},
},
},
},
linkback="block_00512",
linknext="block_00514",
},
block_00514={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eras tú quien quería hacerlo, en primer lugar...”",
{"rt2"},
},
},
},
linkback="block_00513",
linknext="block_00515",
},
block_00515={
{"text"},
text={
vo={
{"vo",file="fem_szd_001328",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te equivocas. Quería abrirme solo para mostrarte. No para que te quedaras\nviendo y lamiendo.”",
{"rt2"},
},
},
},
linkback="block_00514",
linknext="block_00516",
},
block_00516={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero bien que te gustó...”",
{"rt2"},
},
},
},
linkback="block_00515",
linknext="block_00517",
},
block_00517={
{"text"},
text={
vo={
{"vo",file="fem_szd_001329",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Tanto que ya no quiero que lo sigas haciendo!”",
{"rt2"},
},
},
},
linkback="block_00516",
linknext="block_00518",
},
block_00518={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien... Por cierto, Shizuku.”",
