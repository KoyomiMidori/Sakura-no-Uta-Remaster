linkback="block_00541",
linknext="block_00543",
},
block_00543={
{"text"},
text={
vo={
{"vo",file="fem_szd_001339",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Cuando lo tengo en mi garganta mi cabeza se aturde, y de alguna forma actúa\nsobre mi vag*na... No sé por qué, pero... se siente muy bien...”",
{"rt2"},
},
},
},
linkback="block_00542",
linknext="block_00544",
},
block_00544={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. No puedo negar que me encantas así, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00543",
linknext="block_00545",
},
block_00545={
{"text"},
text={
vo={
{"vo",file="fem_szd_001340",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Qué bueno saberlo. Sinceramente, estaba ya algo preocupada de que quizás\nestuvieras asqueado de la facilidad que tengo para excitarme.”",
{"rt2"},
},
},
},
linkback="block_00544",
linknext="block_00546",
},
block_00546={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es tu cuerpo... No hay razón para asquearme.”",
{"rt2"},
},
},
},
linkback="block_00545",
linknext="block_00547",
},
block_00547={
{"text"},
text={
vo={
{"vo",file="fem_szd_001341",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad?... Creo que realmente soy una pervertida, excitándome con tanta\nfacilidad...”",
{"rt2"},
},
},
},
linkback="block_00546",
linknext="block_00548",
},
block_00548={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues puedes estar tranquila, yo también lo soy.”",
{"rt2"},
},
},
},
linkback="block_00547",
linknext="block_00549",
},
block_00549={
{"text"},
text={
vo={
{"vo",file="fem_szd_001342",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué bueno... Aunque, intentaré controlar mis perversiones a un nivel que no te\ncause asco...”",
{"rt2"},
},
},
},
linkback="block_00548",
linknext="block_00550",
},
block_00550={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me preocupo mucho por eso, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00549",
linknext="block_00551",
},
block_00551={
{"text"},
text={
vo={
{"vo",file="fem_szd_001343",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien entonces, supongo...”",
{"rt2"},
},
},
},
linkback="block_00550",
linknext="block_00552",
},
block_00552={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es para tanto, aún teniéndola adentro puedes hablar con normalidad.”",
{"rt2"},
},
},
},
linkback="block_00551",
linknext="block_00553",
},
block_00553={
{"text"},
text={
vo={
{"vo",file="fem_szd_001344",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Porque aún no me he movido... Cuando me mueva, probablemente mi cabeza se\npondrá en blanco de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00552",
linknext="block_00554",
},
block_00554={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no me importa que lo hagas... ¡Y bien, iré hasta el fondo, como\ntanto te gusta!”",
{"rt2"},
},
},
},
linkback="block_00553",
linknext="block_00555",
},
block_00555={
{"text"},
text={
ja={
{
"――¡*zum*!",
{"rt2"},
},
},
},
linkback="block_00554",
linknext="block_00556",
},
block_00556={
