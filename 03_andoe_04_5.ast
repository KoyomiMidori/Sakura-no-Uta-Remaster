linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahh... no puedo más... perdóname, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
