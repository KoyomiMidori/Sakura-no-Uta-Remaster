},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
vo={
{"vo",file="fem_szd_001263",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Pero se supone que hoy te...”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para ya con eso... Si vas a tocarte tu sola prefiero hacerte correr yo...”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
vo={
{"vo",file="fem_szd_001264",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“N-No... soy yo la que debe hacerte correr hoy...”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces hagamos una competencia. Ya me he corrido dos veces, tú una.\nLlevas la delantera.”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"se",file="se9010",id=1},
{"bg",file="ev_shz_h02_02",path=":ev/ev_shz_h02/",set="ev_shz_h02"},
{"text"},
text={
ja={
{
"Intenté tomar las ligas de las pantaletas de Shizuku y bajarlas, pero sus manos\nme detuvieron.",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
vo={
{"vo",file="fem_szd_001265",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... ¿Piensas bajar mis pantis así?”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
vo={
{"vo",file="fem_szd_001266",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vas a ver mi vagina...”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con toda esa intención voy.”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
vo={
{"vo",file="fem_szd_001267",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me da vergüenza que lo hagas con tanta luz alrededor.”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
