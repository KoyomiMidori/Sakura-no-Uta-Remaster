vo={
{"vo",file="fem_szd_001360",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El sexo de verdad, es tan sucio... y se siente tan bien... ¡¡Jaa, jaa, es\ncompletamente diferente a lo que leí en Internet, y se siente espectacular,\nincreíbleee!!”",
