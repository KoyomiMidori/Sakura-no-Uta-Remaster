},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_szd_001248",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Parece que mi boca realmente es una vagina. Quiero que me des más duro...\nasí como lo hiciste la noche pasada con mi vagina...”",
{"rt2"},
},
},
},
linkback="block_00345",
