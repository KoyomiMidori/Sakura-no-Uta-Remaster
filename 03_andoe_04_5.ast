},
block_00522={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00521",
linknext="block_00523",
},
block_00523={
{"text"},
text={
vo={
{"vo",file="fem_szd_001332",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hoy me encargaré de que lo disfrutes, así que me pondré arriba.”",
