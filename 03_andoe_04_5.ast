vo={
{"vo",file="fem_szd_001273",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“A-Ah... auhhh, puedo sentir tu respiración... a-ahh... no, está cerca, tan\ncerca... kuuhh.”",
