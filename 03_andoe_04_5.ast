text={
ja={
{
name={"Naoya"},
"“No lo haré.”",
{"rt2"},
},
},
},
linkback="block_00675",
linknext="block_00677",
},
block_00677={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0013",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001067",ch="ked"},
},
ja={
{
name={"Kei"},
"“Escucha... en primer lugar, tú... ¿tú? ¿¿Tú, tú??”",
{"rt2"},
},
},
},
linkback="block_00676",
linknext="block_00678",
},
block_00678={
{"text"},
text={
ja={
{
"Kei comienza a balbucear palabras sin sentido.",
{"rt2"},
},
},
},
linkback="block_00677",
linknext="block_00679",
},
block_00679={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00678",
linknext="block_00680",
},
block_00680={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0016",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001068",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿P-Por qué... no llevas ninguna camisa?”",
{"rt2"},
},
},
},
linkback="block_00679",
linknext="block_00681",
},
block_00681={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? A-Ah...”",
{"rt2"},
},
},
},
linkback="block_00680",
linknext="block_00682",
},
block_00682={
{"text"},
text={
ja={
{
"Demonios, no oculté los hombros.",
{"rt2"},
},
},
},
linkback="block_00681",
linknext="block_00683",
},
block_00683={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... pues... p-por lo general duermo desnudo.”",
{"rt2"},
},
},
},
linkback="block_00682",
linknext="block_00684",
},
block_00684={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0003",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001069",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿E-En serio? Vaya, ya veo, ajajaja. T-Típico de ti, supongo.”",
{"rt2"},
},
},
},
linkback="block_00683",
linknext="block_00685",
},
block_00685={
{"text"},
text={
ja={
{
"¿De verdad? ¿Parezco la clase de persona que haría eso?",
{"rt2"},
},
},
},
linkback="block_00684",
linknext="block_00686",
},
block_00686={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001070",ch="ked"},
},
ja={
{
name={"Kei"},
"“O-Oye, Naoya... ¿P-Por qué no... bajas un poco más la cobija...\ny muestras los pezones?”",
{"rt2"},
},
},
},
linkback="block_00685",
linknext="block_00687",
},
block_00687={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00686",
linknext="block_00688",
},
block_00688={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0002",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001071",ch="ked"},
},
ja={
{
name={"Kei"},
"“Solo, solo digo, tienes un cuerpo muy masculino, ¿sabes? Solo, quisiera ver un\npoco más de tu cuerpo... solo eso.”",
{"rt2"},
},
},
},
linkback="block_00687",
linknext="block_00689",
},
block_00689={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué, demonios, estás, diciendo?”",
{"rt2"},
},
},
},
linkback="block_00688",
linknext="block_00690",
},
block_00690={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_001072",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? Ah, no estoy pidiendo nada raro, no te confundas.”",
{"rt2"},
},
},
},
linkback="block_00689",
linknext="block_00691",
},
block_00691={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que nada raro? ¡¿Qué clase de hombre querría verle los pezones a su amigo?!”",
{"rt2"},
},
},
},
linkback="block_00690",
linknext="block_00692",
},
block_00692={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001073",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-No es que quiera ver solo los pezones. Lo que quiero es observar cómo te ves\ndesnudo del torso para arriba.”",
{"rt2"},
},
},
},
linkback="block_00691",
linknext="block_00693",
},
block_00693={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso ya es suficientemente raro!”",
{"rt2"},
},
},
},
linkback="block_00692",
linknext="block_00694",
},
block_00694={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0021",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0005",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001074",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-No es nada raro, te lo juro. Solo me interesa en el sentido estético\nmasculino, de la misma forma que la escultura de David, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00693",
linknext="block_00695",
},
block_00695={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Cierra de una buena vez la boca, toma el celular y búscate unas fotos de la\nescultura de David!! ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00694",
linknext="block_00696",
},
block_00696={
{"mwact",act="びっくり"},
{"se",id=1,file="se1712"},
{"text"},
text={
ja={
{
"Le lanzo la caja de pañuelos que tenía al lado.",
{"rt2"},
},
},
},
linkback="block_00695",
linknext="block_00697",
},
block_00697={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_001075",ch="ked"},
},
ja={
{
name={"Kei"},
"“Wah. ¡E-Espera, no me lances eso!”",
{"rt2"},
},
},
},
linkback="block_00696",
linknext="block_00698",
},
block_00698={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya cállate y vete! ¡En un rato preparo la comida y te la llevo al taller!”",
{"rt2"},
},
},
},
linkback="block_00697",
linknext="block_00699",
},
block_00699={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001076",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿De verdad? Si no es molestia preferiría que la trajeras vistiendo solo un\ndelantal.”",
{"rt2"},
},
},
},
linkback="block_00698",
linknext="block_00700",
},
block_00700={
{"mwact",act="びっくり"},
{"se",id=1,file="se1712"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Huhm!”",
{"rt2"},
},
},
},
linkback="block_00699",
linknext="block_00701",
},
block_00701={
{"se",id=1,file="se2192"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0021",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_001077",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Gyahn!”",
{"rt2"},
},
},
},
linkback="block_00700",
linknext="block_00702",
},
block_00702={
{"text"},
text={
ja={
{
"Le lancé el despertador.",
{"rt2"},
},
},
},
linkback="block_00701",
linknext="block_00703",
},
block_00703={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Salte ya!”",
{"rt2"},
},
},
},
linkback="block_00702",
linknext="block_00704",
},
block_00704={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001078",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaah, Naoya está agrediéndome y lanzándome cosas... Uwaan, uwaan.”",
{"rt2"},
},
},
},
linkback="block_00703",
linknext="block_00705",
},
block_00705={
{"se",file="se9008",id=1},
{"fg",ch="圭",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa... ¿Qué tan estúpido puede ser?”",
{"rt2"},
},
},
},
linkback="block_00704",
linknext="block_00706",
},
block_00706={
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0500",face="a0005",head="shz_z2a",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_001387",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Unuh... Ha surgido un nuevo rival.”",
{"rt2"},
},
},
},
linkback="block_00705",
linknext="block_00707",
},
block_00707={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Rival?”",
{"rt2"},
},
},
},
linkback="block_00706",
linknext="block_00708",
},
block_00708={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0510",face="a0006",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001388",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Kei nii-san quiere algo contigo!”",
{"rt2"},
},
},
},
linkback="block_00707",
linknext="block_00709",
},
block_00709={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no! ¡Los dos somos hombres!”",
{"rt2"},
},
},
},
linkback="block_00708",
linknext="block_00710",
},
block_00710={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0500",face="a0005",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001389",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Kei nii-san entra en la categoría de mujer, en varios sentidos.”",
{"rt2"},
},
},
},
linkback="block_00709",
linknext="block_00711",
},
block_00711={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Pero para mí no es nada más que un hombre!!”",
{"rt2"},
},
},
},
linkback="block_00710",
linknext="block_00712",
},
block_00712={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0500",face="a0006",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001390",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No dejaré que Nii-san me gane.”",
{"rt2"},
},
},
},
linkback="block_00711",
linknext="block_00713",
},
block_00713={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya, está bien. Solo ponte la ropa de una buena vez...”",
{"rt2"},
},
},
},
linkback="block_00712",
linknext="block_00714",
},
block_00714={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0500",face="a0011j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001391",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00713",
linknext="block_00715",
},
block_00715={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0500",face="a0010j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001392",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uguh.”",
{"rt2"},
},
},
},
linkback="block_00714",
linknext="block_00716",
},
block_00716={
{"text"},
text={
ja={
{
"No sé si habrá entrado en cuenta de lo que acaba de decir, pero Shizuku estaba\nahora roja como un tomate.",
{"rt2"},
},
},
},
linkback="block_00715",
linknext="block_00717",
},
block_00717={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0500",face="b0008",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001393",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“C-Creo que se me subieron mucho los humos...”",
{"rt2"},
},
},
},
linkback="block_00716",
linknext="block_00718",
},
block_00718={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... y por algo sin mucho sentido.”",
{"rt2"},
},
},
},
linkback="block_00717",
linknext="block_00719",
},
block_00719={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0500",face="b0015",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001394",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00718",
linknext="block_00720",
},
block_00720={
{"bg",file="black",path=":bg/"},
{"se",file="se0897s",id=1},
{"text"},
text={
ja={
{
"Shizuku se viste apresuradamente.",
{"rt2"},
},
},
},
linkback="block_00719",
linknext="block_00721",
},
block_00721={
{"text"},
text={
ja={
{
"Después de eso preparé el almuerzo, y le di de comer a Shizuku y a Kei.",
{"rt2"},
},
},
},
linkback="block_00720",
linknext="block_00722",
},
block_00722={
{"text"},
text={
ja={
{
"Por supuesto, no desnudo y con solo un delantal encima.",
{"rt2"},
},
},
},
linkback="block_00721",
linknext="block_00723",
},
block_00723={
{"text"},
text={
ja={
{
"¡Dios me salve!",
{"rt2"},
},
},
},
linkback="block_00722",
linknext="block_00724",
},
block_00724={
{"bgm",stop=1,time=2000},
