vo={
{"vo",file="fem_szd_001260",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero no he puesto un solo dedo en mi vagina, y estoy algo frustrada... Naoya,\n¿me permites tocarme?”",
