astver = 2.0
astname = "ast"
ast = {
block_00000={
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Uph*... Creo que comí demasiado...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Los gyuudon que Toritani me prepara vienen siempre en cantidades copiosas.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Supongo que esta será su manera de demostrar su amabilidad, sabiendo ella muy\nbien cómo es mi dieta usual.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay duda de que ella conoce muy bien mis circunstancias con la comida.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"A pesar de sus palabras un tanto venenosas, es muy atenta, y cuida muy bien de\nlos demás.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue bastante después que me di cuenta... De lo que implicaba para Toritani el\nhecho de que yo me llevara las cortezas de pan del restaurante...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Por eso es que realmente, es inevitable que tome esa actitud conmigo...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Una mujer con una o dos tantas peculiaridades. Makoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"No me refiero al significado usual que tiene esa palabra, de egoísta, absurdo y\nsin precedentes.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"La actitud de Toritani es así, pero por dentro es todo lo contrario.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, quisiera regresarle la deuda que tengo con ella de alguna manera\nconcreta, y no simplemente agradeciéndole...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que... supongo que son altas las posibilidades de que este año también me\nmande a hacer varias cosas en el club de arte.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Eso es bastante tedioso. Si pudiera pagarle de otra manera, preferiría hacerlo\nasí.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Y mientras quedaba satisfecho de haber consumido proteína animal después de un\nbuen tiempo sin hacerlo, emprendí el camino de vuelta a casa.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Al llegar al frente de la entrada de mi edificio, me encuentro con un muchacho\nque se me hace muy familiar. Nada de qué sorprenderse... Otra vez él.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bgm",file="bgm007"},
{"se",file="se9010",id=1},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000095",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Oh? Ah, pero si es Naoya.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, ¿por qué estás frente a la entrada de mi edificio?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0005",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000096",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué no estás tú dentro de tu apartamento?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaba comiendo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000097",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Oh! ¡Naoya, yo también tengo ganas de comer algo! ¡Vayamos a comer juntos!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, te estoy diciendo que acabo de regresar de comer. Ya comí.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0006",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000098",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué?! ¡¿Por qué estás comiendo antes que yo?!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tengo que pedirte permiso para hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000099",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, pídeme permiso.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0011",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000100",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Y bien? ¿Qué comiste?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un gyuudon grande de tamaño normal.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0010",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000101",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Un gyuudon grande de tamaño normal? ¿Qué demonios es eso?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, digamos que es uno de los ocasionales servicios especiales de Quimera.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000102",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Fuiste a Quimera? ¿Estaba entonces Makoto?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es raro que esté trabajando allá, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0018",head="kei_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000103",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, lo digo porque Makoto estuvo ayer hasta tarde en la sala del club de arte\nsacando el inventario de todos los instrumentos, y estaba susurrando 'Ahh, no\nterminaré nunca, no terminaré nunca', así que pensé que se tomaría un día\nlibre de trabajo hoy...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Inventario?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000104",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, parece que el jefe de club anterior lo hizo todo a las patadas, así que el\nnúmero de instrumentos y material no coincidía y las cosas estaban algo\ngraves.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El jefe anterior, eh... ya veo. Supongo que no había manera de que los números\ncoincidieran mientras él seguía de jefe. Así que Toritani debe estar pasando\nbastante trabajo ahora como la nueva jefa.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0018",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000105",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí. Aunque ella pareciera que viviera únicamente para el club de arte, así que\nno debe ser tan extenuante, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni lo digas, por supuesto que sí lo es. El jefe Akashi... o más bien, el\nex-jefe Akashi era alguien bastante irresponsable y descuidado. Imagína el\ntrabajo que debe tomarle a ella limpiar su desastre.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No están ustedes también realmente aliviados de que se va a graduar ya?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000106",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? Aún no se ha graduado.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese hombre, ¿repitió el año?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_ked_000107",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sé si tuvo que repetir o no, pero estuvo recibiendo lecciones\nsuplementarias.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh... ¿En estas épocas?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun cuando ya está a punto de comenzar el nuevo período...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0010",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000108",ch="ked"},
},
ja={
{
name={"Kei"},
"“Bueh, nuestro colegio es bastante permisivo con eso.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja, aun cuando pensaba que ya no tendría que aguantarme los ataques de ese\nhombre.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000109",ch="ked"},
},
ja={
{
name={"Kei"},
"“Volviendo al tema anterior. Naoya, siempre te la pasas comiendo afuera, eh.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde demonios? Llevaba ya un buen tiempo sin comer afuera.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000110",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sí? Según lo que he escuchado yo, comes siempre afuera.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame más bien preguntarte algo. ¿Has escuchado por lo menos una vez acerca de\ncómo son mis comidas?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0005",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000111",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sé mucho al respecto, pero es malo para la salud que no comas comida casera.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"No hay manera de entablar una conversación con sentido con idiotas.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000112",ch="ked"},
},
ja={
{
name={"Kei"},
"“En fin, la comida de los restaurantes no te aporta todos los nutrientes\nnecesarios, así que no puedes seguir comiendo tanto afuera.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, ¿por qué hablas como si supieras tanto? En primer lugar, aún diciendo todo\neso, ¿has cocinado alguna vez en tu vida?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0006",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000113",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, ¿te estás tratando de burlarte de mí, eh?... Voy a tomarme eso como un\nreto. ¡Tomaré eso como un reto por parte de Naoya Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tomaste esas palabras como un reto?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0005",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000114",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sabes! ¡En la casa Natsume no hay nadie que pueda cocinar algo decente aparte\nde mí! ¡Ejem!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿En serio? ¿Ai no es buena cocinando?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0008",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000115",ch="ked"},
},
ja={
{
name={"Kei"},
"“La comida de Aneki es infernal.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Es una profesora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000116",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué el hecho de que sea profesora implica que también deba ser buena\ncocinando? Hay algunos profesores que no saben cocinar.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues sí, pero... aun así, pensé que por lo menos sabía cocinar...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000117",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Las mujeres de la familia Natsume no pueden pararse frente a la cocina! ¡Esa\nes la regla tácita de nuestra casa!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué rayos va esa regla tácita?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0014",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0011",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000118",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jejeje. ¡Significa que morirán si cocinan algo!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué tratar de intimidar tanto con eso.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"se",file="se3130",vol=60,id=1},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0400",face="b0006",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000119",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Dejemos eso de lado y volvamos a nuestro reto, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a seguir insistiendo en eso?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0003",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0001",head="kei_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000120",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡A partir de ahora comienza nuestro duelo! Vamos a cocinar, así que vayamos al\nsupermercado. Voy a hacer que te comas mi shougayaki.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a comer eso.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0023",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000121",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaaan! ¡¿Vas a decir no tan rápidamente?! ¡¿Por qué dices cosas tan crueles\ncomo que no vas a comer de mi comida?!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás escuchando bien lo que te he estado diciendo? Acabo de comer una ración\ngrande de gyuudon.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0006",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000122",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No comas eso!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que comeré.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0019",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000123",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Naoya, tú comerás mi shougayaki!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a comerlo.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0004",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000124",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te estoy diciendo acaso que estoy lleno ya?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0009",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000125",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Entonces cuándo dejarás de estar lleno?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0006",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000126",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Cómo que no sabes?! ¿No eres capaz de preguntarle a tu propio cuerpo acerca\ndel estado de tu estómago?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",file="se3130",vol=60,id=1},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0400",face="b0006",head="kei_z1b",lv=4,id=9},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No puedo preguntarle! ¡Nos vemos!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0007",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000127",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Espera! ¿Qué tal esta noche entonces? Debería darte hambre en la noche.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás me dé hambre, pero... aunque me dé hambre no comeré tu shougayaki.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0022",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0006",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000128",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Kaah, no hay manera de hablar adecuadamente con este hombre! ¡Solo tienes que\ncallarte y comer!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000129",ch="ked"},
},
ja={
{
name={"Kei"},
"“Además, tus platillos son puras creaciones horrendas que no conservan ni un\npoquito la forma original de los ingredientes.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000130",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por ejemplo, ese que parecía arcilla...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Arcilla?... ¿Te refieres al paté de hígado de pollo?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000131",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Lo único que sabes cocinar son esos platillos tan raros y sospechosos!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Raros y sospechosos?... Pero si fuiste tú quien le untó ese paté a las\ncortezas de pan y se las comió diciendo 'delicioso, delicioso'...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000132",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí, estaba muy bueno! ¡Freíste las cortezas de pan con miso, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000133",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero escúchame bien, Naoya, que no se te suban los aires solo por andar\npreparando toda esa clase de platillos que no aprovechan al máximo los\ningredientes.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que llegaste a la conclusión de que mi platillo no aprovecha los\ningredientes?...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0006",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000134",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mi shougayaki se ve como carne a simple vista! ¡Pero en el caso de tus\nplatillos, no hay manera de saber qué rayos son!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque me da la impresión de que los bizcochos de ajo hechos con corteza de pan\nson como se ven...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0007",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000135",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, así que eran de sabor a ajo. Estaban de rechupete.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"¿Por qué tengo que recibir tantas críticas de un tipejo que no es ni capaz de\ndarse cuenta de eso?...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000136",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Y por eso mismo, esta noche haremos una competición de cocina, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por eso mismo? ¿Debido a qué se supone que debemos hacer una competición?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000137",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sabes, Naoya? Quisiera comer ese platillo. ¡Esa gruesa pizza que me preparaste\nhace unos días!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, el okonomiyaki hecho con cortezas de pan...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0007",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000138",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Era un okonomiyaki? Pensé que era una pizza. Espera, ¿preparaste eso con\ncortezas de pan? Ni me di cuenta.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo preparé para que pudiera servirse de ambas maneras. Si se le echa salsa y\nmayonesa se vuelve un okonomiyaki, y si se le echa queso derretido y salsa de\ntomate se vuelve una pizza.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000139",ch="ked"},
},
ja={
{
name={"Kei"},
"“Je... no sabía que se podía hacer eso con cortezas de pan. Y además, con una\nsola base puedes hacer pizza u okonomiyaki...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre uso los mismos ingredientes, así que quería sacar un sabor lo más\ndistinto posible. Con solo cambiar una salsa basta para disfrutar de un\nplatillo totalmente diferente. Digamos que son pedacitos de sabiduría para la\nvida diaria.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000140",ch="ked"},
},
ja={
{
name={"Kei"},
"“Y pensar que se puede hacer tanto con cortezas de pan... Naoya, no sé decir si\ntu comida es genial o si simplemente no lo es, eh.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cállate, no volveré a darte de comer más nunca.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0007",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000141",ch="ked"},
},
ja={
{
name={"Kei"},
"“Mentira, solo bromeaba, es genial, genial, tu comida es genial, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Unas palabras de rectificación a la ligera. ¿En qué parte del mundo hay alguien\na quien se le quite el mal humor con eso?",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000142",ch="ked"},
},
ja={
{
name={"Kei"},
"“En fin, esta noche a las 7 vendré a tu casa. Prepárate.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te voy a dejar entrar.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000143",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jajaja, ¿te acobardaste, Naoya? ¡Pero ya es demasiado tarde! Voy a hacer que te\ncomas mi shougayaki.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A hacer que yo coma? Por Dios, tú...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000144",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Nos vemos esta noche!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"msgoff"},
{"se",id=1,file="se0744s"},
{"fg",ch="圭",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, oye...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Kei se fue corriendo, sin preocuparse por prestarle atención a mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Aunque vengas esta noche no te voy a dejar entrar a mi casa! ¡Eh!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_ked_000145",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Estoy ansioso por comer tus platos esta noche, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ¿Por qué tengo que cocinar para él?...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna manera voy a preparar nada, qué ridiculez...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, llevaba rato sin preparar frituras...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Estoy friendo algo.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Es tonkatsu.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"se",file="se9000",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Le paso el cuchillo al tonkatsu ya listo.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Bueh, para este particular tonkatsu no tengo que preocuparme de si el interior\nestá crudo aún, pero cada vez que frío algo le meto siempre el cuchillo a la\nprimera pieza para ver qué tanto se ha cocinado.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Jum, este tonkatsu no está nada mal.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ahora...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"msgoff"},
{"se",id=1,file="se2554"},
{"ex",time=1500,func="wait"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"se",id=1,file="se2554_n"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, qué escándalo... Ya voy...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="gatya"},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000146",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! ¡Pero qué buen olor!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"se",file="se9001",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0002",head="kei_z1b",lv=4,id=9},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="man_ked_000147",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Lo preparaste! ¡Para mí!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué piensas que lo preparé para ti?...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
vl03={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000148",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, sí, está bien, está bien. A comer se ha dicho.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ja? Espera, ¿no se supone que ibas a preparar shougayaki?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0004",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000149",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Ahh, eh? No había carne de puerco en el super.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hay forma alguna de que no lo vendan!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0010",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000150",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Será por la recesión económica?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene que ver la recesión económica con que no puedas comprar carne de\npuerco?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0009",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000151",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, claro que sí, hay muchos factores, ¿no? Como la inflamación y las\nisoflavonas...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir inflación? ¿En esta época de deflación?...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000152",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Eso! ¡Inflación! ¡Por culpa de la inflación y la recesión, los puercos andan\nde vacaciones!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, se te olvidó...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0004",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000153",ch="ked"},
},
ja={
{
name={"Kei"},
"“Creo que en conclusión es eso, ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En conclusión, ¿sí es eso?...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000154",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0023",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0021",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000155",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Auch, Naoya me pegó!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí te pegué! ¡Por supuesto que te tenía que pegar! ¡Imbécil! ¡Fui el único que\nse tuvo que poner a preparar este plato que tanto tiempo toma hacer!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0002",head="kei_z1b",lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000156",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Entonces sí lo preparaste para mí? ¡Ah, esto! Es tonkatsu, ¿verdad? ¡Ah,\nya veo, ibas a competir con mi shougayaki, así que elegiste un platillo a\nbase de puerco! ¡¿Verdad?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000157",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡En fin, lo preparaste para mí, ¿cierto?! ¡Realmente eres un buen tipo!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué pones esa sonrisa de lado a lado?... Idiota.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",mode=-2,sync=0},
{"bg",zoom=120,speed=300,file="bg023c",path=":bg/",z2=100,ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z2",zoom=80,speed=300,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0300",face="b0021",head="kei_z2b",y2=-170,z2=69.1,y=-100,lv=5,id=9,sync=0},
{"extrans",time=0},
{"se",id=1,file="se2192"},
{"fgact",ch="圭",act="quake",lv=5,id=9},
{"quake",mode="mw"},
{"quake"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0016",head="kei_z2b",y=-100,lv=5,id=9,zoom=80},
},
},
text={
vo={
{"vo",file="man_ked_000158",ch="ked"},
},
ja={
{
name={"Kei"},
"“Auhhh... ¿En qué puedo ayudarte?...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Saca salchichas, zanahoria y repollo del refrigerador.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0013",head="kei_z2b",y=-100,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="man_ked_000159",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo estoy en contra de la violencia, eh...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Trabaja antes de ponerte a mover la boca! ¡Inútil!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0023",head="kei_z2b",y=-100,lv=5,id=9,zoom=80},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0021",head="kei_z2b",y=-100,lv=5,id=9,zoom=80},
},
},
text={
vo={
{"vo",file="man_ked_000160",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡Naoya, das miedo!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Haz silencio! ¡Trabaja!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0005",head="kei_z2b",y=-100,lv=5,id=9,zoom=80},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000161",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"msgoff"},
{"se",file="se9010",id=1},
{"fg",ch="圭",sync=1,mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0005",head="kei_z2b",x2=0,x=-345,y=-100,lv=5,id=9,zoom=80},
{"ex",time=300,func="wait"},
{"se",id=2,file="se2397"},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000162",ch="ked"},
},
ja={
{
name={"Kei"},
"“... ¿Oh?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0013",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="man_ked_000163",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hay shougayaki adentro.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, llegó hoy. Parece que es parte de la fortuna de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0013",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0017",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
},
},
text={
vo={
{"vo",file="man_ked_000164",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Fortuna? ¿No habías rechazado su fortuna?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así han llegado y están llegando varias cosas por error. Así como\neso...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0009",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="man_ked_000165",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero este envase plástico es de mi casa...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? No hay forma alguna de que parte de la fortuna de\nKenichiro Kusanagi sea enviada dentro de un contenedor plástico de tu casa.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0300",face="b0013",head="kei_z2b",x=-345,y=-100,lv=5,id=9,zoom=80},
{"text"},
text={
vo={
{"vo",file="man_ked_000166",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero si dices eso, ¿no te parece raro que parte de su fortuna sea shougayaki?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Entonces qué es eso?!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0013",head="kei_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000167",ch="ked"},
},
ja={
{
name={"Kei"},
"“Probablemente fue lo que envié yo ayer.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0005",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000168",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, cierto, se me había olvidado. Creo que había pensado decirte al mediodía.\n'¡Ayer te envié shougayaki a tu casa, así que hoy debería llegar!'.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaaa?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0004",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0018",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000169",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Es tu culpa, Naoya. ¡Por ponerte a decir cosas raras me confundí y el tema de\nla conversación cambió de eso a preparar shougayaki!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy yo el que está confundido. ¿Qué demonios significa todo esto?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000170",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, soy todo un genio. Lo preparé todo porque había previsto que pasaría\nesto.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Acabas de decir que se te había olvidado.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000171",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ajajaja, vamos, no hay problema! Preparemos esto.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que se trataba de esto. Ahora que me lo mencionas, me pareció que\nera un contenedor demasiado miserable como para ser parte de la fortuna de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0006",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000172",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No hace falta que lo digas!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿esto fue lo que tú preparaste?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000173",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Sí! Le puse bastante empeño y gasté 5 horas nada más en los preparativos\nprevios.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tuviste que gastar 5 horas nada más para los preparativos previos de\nun shougayaki?...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0014",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000174",ch="ked"},
},
ja={
{
name={"Kei"},
"“Fufufu, esa es una muestra de mi espíritu...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja, ya veo... Qué bien, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y mientras seguimos con esa triste conversación, logramos terminar de preparar\nla comida.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Aunque el shougayaki solo había que echarlo a la sartén, así que se preparó en\nun instante...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"excall",file="00_op_02_3"},
{"text"},
linkback="block_00192",
},
label = {
top={block="block_00000",label=1},
},
}
