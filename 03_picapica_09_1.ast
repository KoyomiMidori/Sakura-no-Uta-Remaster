astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm023"},
{"mwact",act="rlr",time=2000,size=50},
{"text"},
text={
vo={
{"vo",file="fem_bit_000024",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Sing, a song, of, sixpence～”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo tatarea una canción con una melodía fuera de compás\nmientras decora el interior de Quimera.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Quimera cerró temprano hoy con el fin de auspiciar otro evento.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003241",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“V-Vaya decoración que has puesto.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_bit_000025",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Ehhh, pero es una fiesta, ¿no? Para celebrar que algo salió bien, o algo así\nescuché. ¡No está de más entonces decorar el local!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo va decorando el interior del local con origamis y\nfiguras hechas con papel flexible, como estrellas, lunas, flores, aros,\ntrenzas, y pare usted de contar.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ahora que veo bien toda esta decoración... Más que una reunión de\ncelebración, parece un evento de guardería.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_bit_000026",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Ah, ¿te diste cuenta? La verdad es que estoy aspirando a convertirme en una\nprofesora de guardería～. Por eso es que siempre me pongo a hacer este tipo\nde decoraciones con los niños pequeños de mis familiares.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Toritani, ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003242",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Toritani suelta una sonrisa forzada y asiente, como si no le quedara otra\nopción. O al menos eso trata de fingir, pues también ella parece estar\ndivirtiéndose.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003243",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hoy le encargué a ella todos los preparativos.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_bit_000027",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Así es～. ¡Todas las muchachas de medio tiempo nos encargaremos de la fiesta de\nesta noche! ¡Desde la comida hasta decoración, todo!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Siguiendo el mando de la muchacha de medio tiempo, varias chicas vestidas en\natuendos de maid se encargan de organizar el lugar de la fiesta, preparar la\ncomida en la cocina, entre otras labores, todas moviéndose ajetreadas.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Las mesas son movidas rápida y precisamente de un lugar a otro. Parece que\nharán una fiesta tipo buffet.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_bit_000028",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Y por lo tanto, Makoto-san, puedes sentarte y hacer tuyo el lugar por hoy, como\nuna cliente más.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うんうん",time=200,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003244",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La canción que estabas tarareando la suelen aprender en las guarderías?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_bit_000029",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Ah, ¿la canción de hace un momento? Fue Makoto-san quien me la enseñó～”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_bit_000030",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Mi nombre es Tsugumi, que también significa mirlo. Y cuando Makoto-san me\nconoció, me enseñó esta canción. Me gusta, pero me cuesta aprendérmela.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_bit_000031",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Cantemos una canción de seis peniques～. Y, veinticuatro mirlos, cantan dentro\nde la torta horneada, y bromean, y el Rey, se... ¿sorprende?...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, más o menos así va.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003245",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, no está completamente desacertada.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_bit_000032",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Los seis peniques son parte de una tradición que supuestamente trae la\nprosperidad, ¿verdad? Dicen que en un casamiento, si la novia mete seis\npeniques en su zapato, entonces ni a ella ni a su marido les faltará dinero\njamás, ¿o algo así?...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, la tradición de los cuatro 'algos'.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003246",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je, así que tú también la conoces, Kusanagi. Pensé que estaba fuera de tu área\nde interés. La tradición dice que si la novia usa cuatro particulares\nprendas, será feliz para siempre.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003247",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Algo viejo, algo nuevo. Algo prestado y algo azul.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003248",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y finalmente, una moneda de seis peniques dentro del zapato.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_bit_000033",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Ah, eso, eso.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_bit_000034",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Mi onee-chan hizo eso en su boda～. ¡Y me dio los seis peniques de la felicidad\na mí!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_bit_000035",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Siempre lo guardo en mi billetera para no perderlo～. Se siente bien, me da el\npresentimiento de que la prosperidad y la felicidad vendrán a mí.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_bit_000036",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Oh, creo que ya hablé demasiado. Tengo que seguir con los preparativos, así que\nme iré ya. Háganse cómodos y pasen un buen rato los dos～”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"se",file="se9023",vol=50,id=1},
{"text"},
text={
ja={
{
"La muchacha de medio tiempo se marcha apresurada a la cocina.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003249",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los seis peniques...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Toritani se apoya de la pared con los brazos cruzados, y ve la luna por la\nventana.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Me siento en la silla y tomo café. El café estaba frío ya, pero estaba tan rico\ncomo siempre.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003250",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Suetake-san me contó lo que sucedió en la exhibición de la obra que Reika\npresentó.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003251",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El jarrón que Reika presentó fue señalado de falso por los expertos.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003252",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque parece que Reika no se amilanó en lo más mínimo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003253",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, los otros presentadores y los expertos en alfarería que estaban allí le\nexplicaron detalladamente a Reika la razón por la cual la obra era falsa,\nmencionando en primer lugar el esmalte cerámico usado, entre otras cosas.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003254",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, Reika reaccionó insultando y vejando a los otros miembros mientras\nse reía a carcajadas, diciendo que su jarrón era verdadero, y trató de\ndestruir las otras obras...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003255",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todos los presentes la agarraron y la sacaron a la fuerza de la exhibición\njunto a su jarrón. Terminó siendo expulsada de por vida de la agrupación.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003256",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te veo muy asombrado, Kusanagi. ¿Es que habías previsto que sucedería eso?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, para nada. Simplemente consideré la posibilidad de que ocurriera. En ese\nmundo no es tan raro ver a gente que termina quitándose la vida por, y junto\na sus propios delirios.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003257",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco es que todos terminan desquiciados--”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Si armó un escándalo y simplemente se enfadó porque la dejaran en ridículo al\nserle dicha que su obra era falsa, pues quizás no haya cruzado esa brecha\naún.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003258",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No soy como tú, Kusanagi. Yo sí me asombré. Y también admiré a Reika por\nprimera vez. Pensé que era solo una simple mujer que le gustaba lucirse.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003259",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La dueña no le dio el jarrón de la urraca a Reika, en primer lugar, para\nvengarse. Pero además, por compasión y consideración.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003260",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque tal vez... sí, tal vez, para Reika esa compasión no significaba nada.\nTal vez solo era un obstáculo para sus planes...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003261",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que, de cierta forma, quizás este fue el resultado que ella más deseaba...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te sucede algo hoy? Estás bastante sentimental, eh.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003262",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿es que no lo sabías? Soy una persona muy sentimental.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003263",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sobretodo en noches como estas.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"La fiesta comenzó con un brindis bastante simple. No hubieron palabras en\nparticular por parte de la directora.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Ya pasó una semana desde el encuentro entre Toritani y Reika. La negociación\nentre la directora y Reika respecto a los cuadros de Kei terminó sin\ninconveniente alguno.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Al haber logrado poner a la doctora Suetake de su lado, no hubo nada en los\ndocumentos que dejara en desventaja a la directora.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Al culminar la negociación, esta no se preocupó en llamar, y simplemente envió\nun mensaje al teléfono de Toritani diciendo 'Gané.'",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Hay 6 participantes en la fiesta. La directora, Toritani, Onda madre y Onda\nhija, la doctora Suetake y yo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Ninguno de los protagonistas de esta fiesta somos del tipo de persona capaz de\nhacer una fiesta de celebración de esto.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Si no fuese por la propuesta de la muchacha de medio tiempo, no se hubiera\nrealizado, ni menos aun planeado esta rara fiesta.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Kei tampoco está.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Antes de salir, le pregunté a Ai por él, y parece que ha estado encerrado en el\natelier pintando todo este tiempo.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Kirino-san tiene prohibido ver a Kei.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y además, Kei es ya Kei Natsume. No es ni Nakamura, ni Toritani, ni Onda.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Así que las cosas están bien así, supongo.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Pude notar cómo Toritani y Suetake hablaban a un rincón de mi vista.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_obs_000057",ch="obs"},
},
ja={
{
name={"Suetake"},
"“... Y entonces, cuando le dije que abandonaría mi cargo como abogada, la señora\nDirectora me ofreció trabajar con ella. Estoy ahora en período de prueba.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003264",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_obs_000058",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Ya las negociaciones culminaron, así que por fin podré negociar con usted\nrespecto a los jarrones de 'La Luna y las Estrellas'.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_obs_000059",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Sin embargo, hay algo más que quisiera hacer antes de entrar en esa otra\ndiscusión.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003265",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_obs_000060",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Estoy dispuesta a ayudarla a recuperar el jarrón de 'Luna' que le quitaron.\n¿Podría disponer de mis servicios como abogada cuando llegue el momento?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003266",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Déjeme, pensarlo un poco. Tengo una exposición acercándose, y quisiera\nconcentrarme ahora en ella.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_obs_000061",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Entiendo. Puede llamarme siempre que lo requiera.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Suetake se aleja de Toritani.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Estoy dispuesta a ayudarla a recuperarlo', eh. Seguramente Suetake está\nconvencida de que es ya la dueña de los 4 jarrones.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Después de que Suetake se retirara, Nei se acercó a Toritani, tomada de las\nmanos de Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_nei_000061",ch="nei"},
},
ja={
{
name={"Nei"},
"“Esto... Makoto-san.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003267",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nei-chan, ¿qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="table1",id=9,lv=9,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="chair1",id=1,lv=1,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
delay={
[800]={
{"fg",ch="寧",size="z2",zoom=70,time=500,my=-40,mode=3,resize=1,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",x=-240,y=120,lv=5,id=15},
{"se",file="se3214",vol=40,id=1},
},
[1500]={
{"fg",ch="真琴",size="z1",time=500,my=-40,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=345,y=300,lv=4,id=6},
{"se",file="se9010",id=2},
},
},
text={
ja={
{
"Nei se sienta algo nerviosa en la silla que Toritani le ofreció. Toritani se\npuso de rodillas, fijando su mirada a la misma altura que Nei.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Aun tratándose de un buffet, hay varias sillas pequeñas dispuestas alrededor\ndel local para el uso de Nei.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",x=-240,y=120,lv=5,id=15,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_nei_000062",ch="nei"},
},
ja={
{
name={"Nei"},
"“Esto, toma. Muchas gracias por prestármelo durante tanto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fgact",ch="寧",act="うなづく",lv=5,id=15},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Nei sacó un libro infantil con dibujos de la bolsa de papel que Kirino-san\nllevaba, y se lo ofreció a Toritani.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x=345,y=300,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=345,y=300,lv=4,id=6},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=345,y=300,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003268",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias. ¿Te gustó el libro? Si lo quieres te lo puedo dar. En un principio\npensaba donarlo al estante de libros de la escuela dominical.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0006",head="nei_z2i",x=-240,y=120,lv=5,id=15,zoom=70},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",x=-240,y=120,lv=5,id=15,zoom=70},
},
},
text={
vo={
{"vo",file="fem_nei_000063",ch="nei"},
},
ja={
{
name={"Nei"},
"“... ¿De verdad? Si este libro se queda en el estante de la escuela dominical,\nmuchos niños podrán leerlo. Pero si se queda conmigo, solo yo podré leerlo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=345,y=300,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003269",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No importa. Puedes quedártelo si lo quieres, Nei-chan.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",x=-240,y=120,lv=5,id=15,zoom=70},
{"text"},
text={
vo={
{"vo",file="fem_nei_000064",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Está bien. Quisiera quedarme con este libro.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x=345,y=300,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003270",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muy bien. De ahora en adelante es tuyo, Nei-chan.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_nei_000065",ch="nei"},
},
ja={
{
name={"Nei"},
"“Muchísimas... gracias.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fgact",ch="寧",act="おじぎ",lv=5,id=15},
{"text"},
text={
ja={
{
"Nei abraza fuertemente el libro y baja su cabeza en agradecimiento. Kirino- san\nbajó también su cabeza silenciosamente al lado de Nei.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fgact",ch="霧乃",act="いいえ",lv=4,id=6},
},
vl02={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0010",head="kir_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000102",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Saki-sama... disculpe, directora Toritani... Realmente, le agradezco todo lo\nque hizo por nosotras. No sé qué podría hacer por usted a cambio...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="紗希",act="いいえ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000272",ch="htd"},
},
ja={
{
name={"Directora"},
"“Si es por agradecimientos, ya recibí suficientes, así que no hacen falta.\nAdemás, lo más difícil viene ahora.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Los problemas con Reika se acabaron ya, pero de ahora en adelante Kirino-san y\nNei deberán enfrentar juntas los fuertes días de rehabilitación que le\nesperan a Nei.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Probablemente a eso se refiere la directora cuando dice eso.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000103",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí. Haremos todo lo mejor posible entre las dos, madre e hija.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="table1",id=9,lv=9,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="chair1",id=1,lv=1,path=":cg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="寧",size="z2",zoom=70,mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0001",head="nei_z2i",x=-240,y=120,lv=5,id=15,sync=0},
{"extrans",time=500},
{"fgact",ch="寧",act="おじぎ",lv=5,id=15},
{"text"},
text={
vo={
{"vo",file="fem_nei_000066",ch="nei"},
},
ja={
{
name={"Nei"},
"“Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="紗希",size="z2",zoom=73,mx=40,mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2b0000",face="b0001",head="sak_z2b",x=210,y=-120,lv=5,id=8},
{"se",file="se9010",id=1,vol=50},
{"text"},
text={
ja={
{
"Nei trató de pararse de la silla para bajar la cabeza junto a Kirino-san. Sin\nembargo, la directora la detuvo con su mano, y acarició suavemente su cabeza.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_htd_000273",ch="htd"},
},
ja={
{
name={"Directora"},
"“Seguramente será duro para ti... pero sé que podrás lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",x=-240,y=120,lv=5,id=15,zoom=70},
{"fgact",ch="寧",act="うなづく",lv=5,id=15},
{"text"},
text={
vo={
{"vo",file="fem_nei_000067",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Nei asintió mientras veía a la directora desde abajo.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fgact",ch="紗希",act="うなづく",lv=5,id=8},
{"text"},
delay={
[1000]={
{"fg",ch="紗希",mx=40,mode=-1,lv=5,id=8},
{"se",file="se2225",id=1},
},
},
text={
ja={
{
"La directora le dio un breve saludo a Kirino-san y salió del local para ir a\nfumar.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_nei_000068",ch="nei"},
},
ja={
{
name={"Nei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Mi mirada se cruzó con la de Nei. Me saludó moviendo ligeramente la mano.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Con un gesto de la mano le indiqué a Nei que se detuviera cuando trató de\npararse de la silla, y me acerco yo a ella.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"se",file="se9012",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=500,y=-150,zoom=90,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="zchair1",zoom=90,x=440,y=-100,id=4,lv=4,path=":cg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",y=100,lv=5,id=15,sync=0},
{"extrans",time=1000},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0003",head="nei_z2i",y=100,lv=5,id=15},
{"text"},
text={
vo={
{"vo",file="fem_nei_000069",ch="nei"},
},
ja={
{
name={"Nei"},
"“Makoto-san me dio este libro.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bien, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="寧",size="z2",mode=3,path=":fg/nei/z2/",file="nei_z2i0000",face="i0002",head="nei_z2i",y=100,lv=5,id=15},
{"fgact",ch="寧",act="うなづく",lv=5,id=15},
{"text"},
text={
vo={
{"vo",file="fem_nei_000070",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí. Así que, quisiera... leer este libro para ti, hasta el final. No por\nagradecerte por la vez pasada, ni nada de eso. ¿Podría?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"No tuve razón alguna para rechazar su oferta.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Traje una silla que había cerca y me senté, a lo que Nei abrió el libro y\ncomenzó a leer lentamente.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Fue así como Nei me leyó, de principio a fin, la historia de aquel conejo que\nintentó ir a la luna.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"cgdel",id=-1},
{"bgm",stop=1,time=1500},
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="nightsky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"se",id=1,file="se2225"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Hay humo de cigarro elevándose frente a Quimera. La directora me vio de reojo\ncuando salí del local.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg013c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=8,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenas.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=8},
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000274",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, vaya.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"El humo se menea en el aire junto al silencio que se cernió justo después.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_htd_000275",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿No estaba Nei leyéndote el libro?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya terminamos. Está ahora comiendo con los demás. La comida de este local es\nbuena.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0007",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000276",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿No habrá alcohol también?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues este local es una cafetería, así que bueno...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000277",ch="htd"},
},
ja={
{
name={"Directora"},
"“En un rato iré a comer algo.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Odia los libros infantiles?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Me pareció que había una razón por la cual la directora no entró al local al\nsaber que Nei había comenzado a leer su libro infantil.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0003",head="sak_z1b",lv=4,id=8},
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000278",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ahh... No, no los odio realmente.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000279",ch="htd"},
},
ja={
{
name={"Directora"},
"“Solo que no me gusta mucho esa historia en particular. La escuchaste hasta el\nfinal, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me la acaban de contar.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_htd_000280",ch="htd"},
},
ja={
{
name={"Directora"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"La directora toma una profunda bocanada de su cigarrillo. El humo blanco que\nsuelta de su boca cubre parcialmente el perfil de su rostro.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000281",ch="htd"},
},
ja={
{
name={"Directora"},
"“Si el conejo así lo deseaba, entonces lo mejor hubiera sido dejar que se fuera\na la luna. Y a pesar de eso, le vendaron los ojos y lo pusieron a dormir.\nPero qué cosa, eh.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así le parece?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
ja={
{
"La directora se vuelve hacia mí, volteando no solo su mirada sino su cuerpo\nentero.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_htd_000282",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Tienes una opinión distinta al respecto?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es realmente una opinión... ni una idea tan complicada...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás el conejo en realidad deseaba dormir.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000283",ch="htd"},
},
ja={
{
name={"Directora"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás el conejo solo estaba siendo tentado por la locura que inspiraba la\nluna, y en realidad solo deseaba dormir en brazos de esa persona a la que\ntanto quiere.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000284",ch="htd"},
},
ja={
{
name={"Directora"},
"“De verdad que tienes ideas interesantes, eh.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Usted cree? Solo es una simple ocurrencia.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
text={
ja={
{
"La directora bajó su mirada mientras aplastaba su ya acortado cigarrillo en su\ncenicero portátil.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_htd_000285",ch="htd"},
},
ja={
{
name={"Directora"},
"“Los humanos no pueden ni podrán jamás entender lo que sienten los conejos.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
ja={
{
"Y así como la directora alzó su cara, yo también me dispuse a ver hacia el\ncielo de la noche. No sé si es por el ángulo o por la hora, pero no se podía\nver la luna.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_htd_000286",ch="htd"},
},
ja={
{
name={"Directora"},
"“... ¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_htd_000287",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿De verdad viniste solo para hablar de esto conmigo?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani me contó varias cosas.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000288",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí... Me pareció que sería necesario para la negociación con Reika. Son cuentos\ndel pasado, de hace bastante tiempo ya.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Usted misma decidió imprimir todo ese artículo?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000289",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Para decir la verdad, fue un conocido quien me hizo la revista en su\nimprenta. Aún no existía la tecnología de autoedición para entonces, así que\ntodo fue a mano. Y gracias a eso, me gasté un jugoso monto de dinero.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suena a que se divirtió bastante.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000290",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, me divertí. Entré a la universidad, y luego a aquel club... Lo planeé desde\nel primer año, y lo ejecuté en el tercero.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Había alguien en su club a quien quería engañar?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000291",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, así es. Se me vino a la mente lo placentero que sería lograr engañarlo a\nél. No cabe duda de que fue esa infantil tentación lo que me llevó a comenzar\ntodo eso.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso fue capaz de llegar a hacer todo eso... De verdad que los Toritani\nson realmente hábiles para todo...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000292",ch="htd"},
},
ja={
{
name={"Directora"},
"“Nuestra familia se destaca en muchas cosas, pero no somos realmente expertos en\nnada. A primera vista, pareciera que pudiéramos hacer cualquier cosa, pero en\nrealidad no somos capaces de lograr nada por completo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000293_n",ch="htd"},
},
ja={
{
name={"Directora"},
"“Mi talento solo fue lo suficiente como para asombrar a un puñado de personas,\nnada más. Aunque, igualmente fue bastante divertido.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fabricar la libreta y el libro contable japonés, cortar el artículo, el ukiyo-e\ny la pintura en óleo... Ya vi los materiales que usó para su engaño, pero ¿de\nqué forma los usó?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000294",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues sí... no hice la gran cosa, aunque lo importante estaba en la fuente de\ninformación. En primer lugar, de ninguna manera debía ser yo la primera en\ndifundir la información.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000295",ch="htd"},
},
ja={
{
name={"Directora"},
"“Acoto que no lo soy aún, y para entonces no era tampoco del tipo de persona que\nse veía capaz de jactarse o presumir de algo, o soplar rumores, así que se\nvería poco natural.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaja...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000296",ch="htd"},
},
ja={
{
name={"Directora"},
"“Alguien que habla bastante sirve para estos casos. Por lo general siempre hay\nalguien así en cualquier lado. Una vez conseguimos a esa persona, la usamos\ncomo la fuente de información falsa.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000297",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para comenzar es mejor... sí, el comedor. Siéntate al lado de esa persona\nhabladora, y conversa con tus amigos.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000298",ch="htd"},
},
ja={
{
name={"Directora"},
"“No hace falta que hables en un tono tan alto. Una vez te des cuenta de que esa\nmuchacha está escuchando tu conversación, comienza a sacar el artículo y\nhabla al respecto.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_htd_000299",ch="htd"},
},
ja={
{
name={"Directora"},
"“Manipulé la información, poniéndolo todo tal como si esa exposición hubiera\nsido realizada mucho antes de nuestro ingreso a la universidad.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000300",ch="htd"},
},
ja={
{
name={"Directora"},
"“Recuerdas lo que había al final del artículo, ¿no? De que se esperaban\nresultados de investigaciones para saber si el jarrón había sido hecho por el\npropio Monet o no.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_htd_000301",ch="htd"},
},
ja={
{
name={"Directora"},
"“Le comenté a mi amiga que la investigación había culminado, y de que se había\ndemostrado que fue el propio Monet quien lo fabricó.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000302",ch="htd"},
},
ja={
{
name={"Directora"},
"“Los rumores se esparcieron más rápido de lo que esperaba, y gracias a eso un\nbuen número de personas mostró curiosidad por el tema. El hecho de que fuera\nuna universidad de artes propició a que los rumores resonaran.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000303",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me hice la dura al principio, y luego mostré el recorte del artículo a los\ndemás, fingiendo haber cedido ante la presión.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000304",ch="htd"},
},
ja={
{
name={"Directora"},
"“'El jarrón está aún en Francia. Sin embargo, el cuadro original de Monet que\nsirvió para el diseño está en el depósito de mi casa'. Le respondí eso a\ntodos, haciéndome mostrar como si la presión de todos preguntándome me\nhubiera obligado a revelar eso.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_htd_000305",ch="htd"},
},
ja={
{
name={"Directora"},
"Después de eso, los llevé a todos al depósito para que vieran la pintura en\nóleo y la ukiyo-e.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La oscuridad del depósito hacía más difícil discernir si eran verdaderas o no\nlas obras. De esa forma logró engañar a todos, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000306",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Exceptuando a Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000307",ch="htd"},
},
ja={
{
name={"Directora"},
"“No pude engañar a la persona que quería engañar, aún después de todo el trabajo\ny el tiempo que invertí. Me dijo que me había quedado muy buena la broma,\npero aun así fue todo un fracaso para mí.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000308",ch="htd"},
},
ja={
{
name={"Directora"},
"“No leyó el falso artículo que tanto me costó fabricar, ni tampoco llegó a\nescuchar lo que decían los rumores. Simplemente escuchó un resumen de la\nhistoria y vino a ver los cuadros.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000309",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y me dijo esto: 'Yo solo juzgué basándome en el cuadro, por eso no pudiste\nengañarme. Aunque los otros quedaron encantados con la historia que\ninventaste. No los culpo, tienen buen ojo. Y sobre todo, esta es una\nexcelente pintura'.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_htd_000310",ch="htd"},
},
ja={
{
name={"Directora"},
"“Supongo que habrá tratado de consolarme diciendo eso. Qué idiota... Aunque,\nsí... fue divertido. Fallé en mi cometido, pero lo disfruté. Puedo decirlo\ncon toda seguridad ahora.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué representó Kenichiro Kusanagi para usted, señora directora?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000311",ch="htd"},
},
ja={
{
name={"Directora"},
"“Qué representó, eh...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"La directora entrecerró sus ojos con nostalgia.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000312",ch="htd"},
},
ja={
{
name={"Directora"},
"“Alguien con quien compartí la misma edad, la misma universidad, y algunas\nclases.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"La directora responde lo mismo que me llegó a contar la vez pasada. Sin\nembargo, en el tono de su voz había una especie de singular apego y\nfamiliaridad que no parecía pretender ocultar.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000313",ch="htd"},
},
ja={
{
name={"Directora"},
"“De lo que puedo decir ahora, simplemente fuimos eso.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"Parpadeo dentro del local, con mis ojos todavía ajustados a la oscuridad de la\nnoche.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"El interior de Quimera se sentía más radiante que de lo normal. ¿Será por los\nornamentos que adornan ahora todo el local?",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000314",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, es el río Amanogawa. Y el puente de urracas.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Al alzar mi mirada tras escuchar el susurro de la directora, un río Amanogawa\nhecho de origami se cruzó a mi vista.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo recuerdo muy bien. ¿El puente de las urracas venía de la leyenda del\nTanabata?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000315",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Una vez al año, en la noche del Tanabata, las urracas despliegan sus\nalas y forman un puente para poder reunir a Orihime y Hikoboshi.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"El puente de las urracas. Recuerdo haber hablado respecto a algo parecido con\nToritani.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0003",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000316",ch="htd"},
},
ja={
{
name={"Directora"},
"“Te pareces a ellas, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000317",ch="htd"},
},
ja={
{
name={"Directora"},
"“No veo muy bien que te guste estar sirviendo de puente todo el tiempo para algo\no alguien. Eres muy joven.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... Lo hago por gusto...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000318",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"El río Amanogawa y el puente de las urracas hechas con papel de origami blanco.\nLas radiantes estrellas en color plata y dorado. Las revoloteantes flores, y\nuna luna de papel...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="寧",size="z1",mode=3,resize=1,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",lv=4,id=15},
{"text"},
text={
ja={
{
"Me di cuenta de que Nei estaba viéndola fijamente.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Justo cuando me acerqué a hablarle, Nei estaba observando la luna de papel\ndorada colgada.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres esa luna?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fgact",ch="寧",act="うなづく",lv=4,id=15},
{"text"},
text={
ja={
{
"Nei asintió.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, espera un momento.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Mientras buscaba a la muchacha de medio tiempo encargada de la decoración para\npedirle permiso, la directora se acercó.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_htd_000319",ch="htd"},
},
ja={
{
name={"Directora"},
"“Espera un segundo.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Justo después la directora regresó trayendo a Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo hizo un enorme círculo con sus brazos desde lejos.\nParece que no hay problema.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0001",head="nei_z1i",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000104",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Quieres esa, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0002",head="nei_z1i",x=-345,lv=4,id=5},
{"fgact",ch="寧",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_nei_000071",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo trajo una escalera bastante rígida y segura.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"se",file="se9010",vol=50,id=1},
{"fgact",ch="霧乃",act="おじぎ",lv=4,id=6},
{"text"},
text={
ja={
{
"Kirino-san se montó sobre la escalera con algo de miedo, retiró lentamente la\nluna de papel y se la dio a Nei.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Nei tomó la luna de papel, tocándola con mucho cuidado y cariño, y sonrió.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1i0000",face="i0003",head="nei_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_nei_000072",ch="nei"},
},
ja={
{
name={"Nei"},
"“Gracias, mamá.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=8},
{"text"},
text={
ja={
{
"La mirada de la directora hacia la familia Onda era cálida.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es usted muy detallista, directora Toritani.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fgact",ch="紗希",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000320",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí. Por tratarse de gente ajena a mí es que puedo ser observadora y hacer lo\nmás efectivo por ellos.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Por tratarse de gente ajena...",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"――'Yo misma perdí el derecho a hacerme llamar madre'. Recuerdo a la directora\ncuando dijo eso.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="紗希",mode=-1,lv=4,id=8},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Un tanto alejada de los demás estaba Toritani, observando a la directora\nmientras esta, a su vez, contemplaba a la familia Onda jugando con la luna de\npapel.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"No había ningún sentimiento de conflicto ni rencor en la mirada de Toritani\nhacia la directora. Era una mirada pacífica.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Sin embargo, la distancia entre las dos se mantuvo así hasta que terminó la\nfiesta, sin que ninguna de las dos se acercara a la otra.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y listo――”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Regreso la última mesa que faltaba a su lugar, y le doy un vistazo a todo el\ninterior de Quimera.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya terminamos?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003271",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, gracias por la ayuda.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"La fiesta culminó en un clima ameno, y ahora acabamos de terminar de recoger.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Las muchachas de medio tiempo se fueron ya también.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003272",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, lo siento, ¿podrías traerme eso?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Toritani y yo nos ocupamos ahora de llevar todas las cosas que se usaron para\nla fiesta a su habitación.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Toritani, ¿hablaste con la directora?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003273",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no lo hice, ni tengo razón para hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003274",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Estás preocupado por mí?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0029",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003275",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias. Pero, así como estamos, estamos bien. Creo que ya te lo dije antes,\npero el problema es solo de mi parte.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003276",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hasta ahora, nunca había podido poner en orden los sentimientos tan complicados\nque he tenido por la directora Toritani.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003277",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero eso se acabó ya.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003278",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Se podría decir que sí, o tal vez no... No tengo intención de pretender\nque no pasó nada y cambiar el tema. No soy tú.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003279",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero es algo muy ridículo. Cualquiera que escuchara lo que pasó pensaría eso.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, yo sí quisiera saber que fue lo que te sucedió.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003280",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003281",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Recuerdas lo que sucedió el día en que fuimos con Kirino-san a la oficina de\nla directora? Lo que la directora dijo en aquel momento...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003282",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Compartamos o no la misma sangre...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Yo también recordaba muy bien las palabras que Toritani susurraba ahora, como\nsi estuviera hablando consigo misma.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Toritani estuvo observando toda la conversación que transcurrió entre la\ndirectora y Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Olvidando incluso respirar y parpadear, para no pasar por alto ni una sola\npalabra――",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",lv=4,id=8,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_htd_000252",ch="htd"},
},
ja={
{
name={"Directora"},
"“Yo lo protegeré.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_htd_000253",ch="htd"},
},
ja={
{
name={"Directora"},
"“Compartamos o no la misma sangre, yo decidí hacerlo mi hijo, y por eso lo\nprotegeré. A mi manera.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"cgdel",id=-1},
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003283",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue ahí que sentí en mi pecho todo el amor que tiene ella por Kei. No fue la\nlógica ni la razón, sino mi propio corazón el que me convenció.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003284",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que ya no importa.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003285",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco voy a llamarla 'mamá' de un día para otro, ni tampoco pienso regresar a\ncasa. Simplemente lo he asumido como una independencia un tanto acelerada.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... se nota en tu cara que ya no cargas ese peso encima.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003286",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, más o menos así me siento ahora. Para ser sincera, me siento aliviada.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me sorprende, ahora que por fin se resolvió lo de Kirino-san y el asunto con\nReika.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003287",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Por lo demás, lo único que me queda ahora es avanzar con mi obra para la\nExposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003288",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, por cierto, ¿tienes algo de tiempo ahora?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Toritani me pregunta eso, tratando de aparentar casualidad.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto como quieras. Tengo la noche completa, si así lo requieres.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003289",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--! ¡¿P-Pero, qué andas diciendo?! No lo dije con esa intención en...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué intención te refieres? ¿No es que quieres hablar algo conmigo? Lo habías\ndicho antes, ¿no, Toritani? De que querías que escuchara todo lo que tenías\nque contarme cuando pasaran las cosas.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013h",head="mak_z1d",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003290",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí... a-así, es...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes la cara como un tomate.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003291",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No hace falta que lo digas! ¡Yo también me sonrojo cuando me apeno!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa en lo más mínimo que lo hagas. Me encanta cuando te muestras así,\ncomo verdaderamente eres.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009h",head="mak_z1b",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0007h",head="mak_z1b",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003292",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh... ¡C-Cambié de opinión, vete ya! ¡Vamos, se acabó la fiesta!”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh~, no quiero~”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0018h",head="mak_z1b",lv=4,id=6},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003293",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Que quieras o no es lo de menos, ya dije que no hablaría y no lo haré! ¡Se\nacabó todo por hoy!”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ya resolviste varios de los problemas que tenías encima, estás más\naliviada y compuesta ahora. Esta noche está perfecta para que hables todo lo\nque quieres contarme.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009h",head="mak_z1b",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003294",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003295",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tienes razón. Supongo que no sirve de nada ponerme terca ahora.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que terca...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003296",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Más que terca, qué?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“NO, NADA.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Más que terca, pareciera estar comportándose como una niña pequeña, pero mejor\nno digo eso ahora, o la conversación no avanzará nada.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me interesa saber qué es lo que quieres contarme. De verdad quiero saberlo.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008",head="mak_z1d",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003297",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003298",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Iré a servir algo de café.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003299",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Probablemente se torne un tanto larga la charla.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
