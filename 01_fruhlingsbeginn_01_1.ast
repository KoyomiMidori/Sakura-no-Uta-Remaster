astver = 2.0
astname = "ast"
ast = {
block_00000={
{"autoplay",speed=150,wait=250,auto=2500,autoflag="g.01_01_1"},
{"bgm",file="bgm036"},
{"bg",time=5000,file="ev_uni_c10_01",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=1000,func="wait"},
{"bg",time=3000,file="ev_uni_c10_02",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=2000,func="wait"},
{"bg",time=3000,file="ev_uni_c10_03",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=2400,func="wait"},
{"bg",time=3000,file="ev_uni_c10_04",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=2000,func="wait"},
{"bg",time=2000,file="ev_uni_c10_05",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=7000,func="wait"},
{"bgm",stop=1,time=5000},
{"se",stop=1,id=-1,time=5000},
{"vostop",stop=1,time=5000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=5000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=4000,func="wait"},
{"bg",file="ev_eye_c02_01",path=":ev/ev_eye_c02/",set="ev_eye_c02"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"autoplay",mode="stop"},
{"eval",exp="g.01_01_1=1"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg036a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm106"},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000008",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahh~ Nao-kun, otra vez estás diciendo esas cosas tristes.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cosas tristes?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000009",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Eso es algo triste.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pero esas palabras no las inventé yo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0010",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000010",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...\nPero tú también piensas lo mismo, ¿no, Nao-kun? Y por pensar eso es que――”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0006",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000011",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No puedes hacer eso. ¡Si haces eso, todos se irán!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se... irán...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000012",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, basta con no tener a nadie importante.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no hay nadie importante en la vida de uno, entonces no habrá necesidad de\nmorir... Quizás.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0021",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000013",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡T-Tonto! ¡Tonto, tonto, tonto! ¡¡Nao-kun, eres un tonto!!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0020",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000014",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si fuera así... ¡Si fuera así, entonces no habría sentido alguno en que todos\nvivieran compartiendo el mismo tiempo, en el mismo lugar!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0006",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000015",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ya no me importa nada! ¡Nao-kun, tonto, tonto, tonto!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"se",id=1,file="se0744"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"La figura de Rin yéndose corriendo.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Solo me quedé ahí, viendo su espalda.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No tenía una idea clara de lo que quería hacer con esas palabras.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Simplemente fueron impactantes, y resonaron en el aún infantil yo.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Aún sin entender el significado de ellas...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"colortone",style="reset"},
{"bg",sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En esos tiempos, yo no entendía nada.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"No, más bien era imposible que entendiera.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Ya veo, los sentimientos de servir al otro.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Ya veo, sin regocijarse ni entristecerse mucho.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Ahora sí los entiendo.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Ahora que pasó ese día, los entiendo.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Una fantasía de un día de primavera.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Una acogedora brisa.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Plácidamente, en la sombra de esos árboles.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Solo estuve observando la espalda de la entonces aún infantil Rin.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Ese cálido sol era casi como―",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Como si estuviera dentro de una piedra.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Un escenario duro y rígido.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Al cerrar los ojos, esa imagen se me aparece.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",time=5000,file="ev_uni_c10_06",path=":ev/ev_uni_c10/",set="ev_uni_c10"},
{"ex",time=4000,func="wait"},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Abrí la vieja puerta corrediza y dejé entrar el aire de la mañana.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"El jardín envuelto en la neblina de la mañana.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"El aire frío es algo agradable.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque no pude dormir nada.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"El frío aire de principios de primavera es agradable para mi cuerpo, caliente\npor la falta de sueño...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Se supone que eso no era ninguna razón como para quitarme el sueño.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Parece que después de todo sí me llama la atención...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a13_01",path=":ev/ev_com_a13/",set="ev_com_a13",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000007",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya regresé... Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Ya regresé...",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Ciertamente, ya regresó.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Aunque, esa común y bastante obvia palabra me causaba dolor.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Parece que no me tiene rencor alguno...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Aunque, ciertamente, así es ella...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Aun cuando no le llegué a responder ni una sola vez sus cartas.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aun así, me dijo 'Ya regresé' con una sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"De verdad que ahora sí parezco el malo de la historia...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El malo de la historia.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Aunque bueno, ciertamente soy malo.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Soy un gran mentiroso.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Aunque por otro lado...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se puso bastante preciosa.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Tal como lo había mencionado Kei.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El autodenominado 'Gran maestro de la belleza' le hace honor a su nombre.\nRealmente tiene un buen ojo para la belleza.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Aunque deja mucho que desear el hecho de que se haga llamar así solo por tener\nojo para la belleza de las mujeres.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero bueno...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Se puso bastante hermosa.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Tanto su estatura como su cabello crecieron bastante.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Por cierto...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="zev_com_a12_06",x=890,y=-390,time=500,path=":ev/ev_com_a12/",set="ev_com_a12",ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9007",id=1},
{"cgact",file="zev_com_a12_06",act="びっくり",time=500,x=890,y=-390},
{"ex",time=1300,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se ha desarrollado muy bien, eh...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera, no, no.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"No es eso.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Ha pasado bastante tiempo desde ese entonces...",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde ese entonces...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Se me escapa una sonrisa amarga.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"No me agradan mucho los asuntos deprimentes.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Se supone que fui yo mismo quien dijo eso.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Ya todo terminó. Esos sentimientos que me dicen que todo terminó――Debo dejar\nesos insignificantes sentimientos atrás...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",stop=1,time=1000},
{"se",file="se9008",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Salgo al pasillo para lavarme la cara.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Quiero aclarar mi acalorada cara y mi nublosa consciencia, producto de la falta\nde sueño, con algo de agua fría.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienen la casa tan llena de decoraciones como siempre, eh.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si les hace falta dinero entonces podrían vender esto y ya...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Al salir de la habitación al pasillo, se puede ver la enorme imagen de una\nmujer desnuda al fondo de la entrada.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Esa decoración, ya con bastante tiempo adornando la casa de los Natsume, es tan\ngrande que simplemente no encaja con la imagen de una casa japonesa. Está\ndibujada en un lienzo de 100 centímetros de ancho.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_uni_c11_01",path=":ev/ev_uni_c11/",set="ev_uni_c11"},
{"text"},
text={
ja={
{
"El nombre de la obra es 'Olympia'. Es la obra representativa del pintor francés\nÉdouard Manet.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Por supuesto, no es la original.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"No hay manera de que la versión original de la obra representativa de Édouard\nManet esté en esta casa. La 'Olympia' original está resguardada en el museo\nde Orsay.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"El tamaño de esta es apenas la mitad de la original que está en Orsay.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Aunque, no se trata de ninguna foto ni impresión. Es una pintura en óleo\ngenuina.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Está tan bien dibujada, que de verla de cerca da la ilusión de que el propio\nMonet la dibujó. Más que una simple reproducción, se podría decir que es casi\nuna falsificación.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Sin embargo, parece que se dañó una vez, así que se pueden ver, aunque en unas\nmuy pequeñas partes, los trazos de su restauración.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"El autor de esta 'Olympia' es Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Ese Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Parece que fue el primer regalo que le hizo a mamá cuando la conoció.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El primer regalo que le hizo a una mujer fue, nada más ni nada menos que una\npintura de un desnudo, y para más colmo, 'Olympia'...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Totalmente característico de él. Es una elección que solo él haría.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por Dios... Aún después de muerto tengo que ver sus sombras. Pero qué lata.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Por lo general solo la veo de reojo, pero es de mañana, y estoy solo, así que\ndisfruté del acabado de la copia de 'Olympia' de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué hombre tan hábil.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Me asombra aún más que cuando la vi de niño, o no, más bien es ahora que me veo\ntan asombrado por esta obra.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Muchos pintores famosos a lo largo de la historia han dejado varias\nreproducciones de obras, como forma para practicar.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Pero aun así, las reproducciones de esos históricos artistas no son siempre\ncompletamente fieles a las obras originales.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Más bien, a medida que observamos las reproducciones de esos artistas famosos,\npodemos ver que son realizadas a su propio estilo.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Sin embargo, esta 'Olympia' fue creada como una copia absolutamente fiel a la\noriginal.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"No conozco mucho acerca de todas las reproducciones de Kenichiro Kusanagi,\npero no conozco ninguna otra copia tan fiel como esta.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Aun así, hay unas pocas y diminutas partes que fueron cambiadas respecto a\nla obra original.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Por ejemplo, el hecho de que el color del cabello es más cercano al negro que\nla original.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"El hecho de que la modelo es más delgada que la original.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Aunque, de igual forma, solo es posible darse cuenta si buscas y comparas las\ndiferencias con la original.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Es imposible notar la diferencia para aquellos que no conocen bien la obra\noriginal.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"No conozco en detalle la razón por la cual Kenichiro Kusanagi hizo eso.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque de cierta manera me la puedo imaginar al ver esta cara.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"La mirada de la mujer que hace de modelo en 'Olympia' es retadora.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Entro a la ligeramente oscura sala, aún sin haber amanecido por completo.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Una sombra...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",size="z1",time=500,mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000037",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Era Shizuku.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"No pensé que alguno de los Natsume estaría ya despierto a estas tempranas\nhoras.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Según recuerdo, a todos los Natsume les cuesta levantarse en las mañanas... Por\nsupuesto, a Shizuku también.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy viniste temprano...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000038",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Temprano?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es temprano en la mañana, así que es normal que diga eso si te veo\ndespierta a esta hora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000039",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Temprano en la mañana?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Shizuku observa el cielo, del cual aún no ha salido por completo el sol, con\nojos ligeramente abiertos.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La tenue luz reflejada y dispersada por la neblina de la mañana resaltaban aún\nmás el blanco de su piel.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Y en ese momento, pensé algo bastante fuera de lugar: 'Ya veo'.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Ciertamente, es hermosa.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Esto me hace recordar nuevamente de que ella es una artista.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿no era que te costaba levantarte temprano?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0010",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",time=1000,size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000040",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me cuesta...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces hoy hiciste un esfuerzo para levantarte así de temprano?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000041",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000042",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No dormiste nada, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Será que tú tampoco pudiste dormir porque te preocupaba eso?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000043",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué el hecho de que no puedas dormir implica que yo tampoco pueda?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, ahora que lo dices...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000044",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Shizuku ya puede dormir normalmente... Creo que tú también lo sabes, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0015",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000045",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero sí viviendo debajo del mismo techo, existe la posibilidad de\nque me ataques en cualquier momento. *gokuri*.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ni en broma! ¡No hay manera de que haga eso con Ai y Kei acá!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000046",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Si no estuvieran lo harías?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Idiota! ¡Yo no soy la clase de persona que haría esas cosas!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000047",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Shizuku acaba de conocerte hace poco, así que no sé muy bien si eso es\nverdad...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh, q-quizás, pero...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000048",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y tú, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000049",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué estuviste toda la noche despierto?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? Pues, es que yo, ehm...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000050",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Es que?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es la gran cosa. ¡Solo pura casualidad! ¡Sí! Solo fue pura casualidad.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0017",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000051",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pura casualidad...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Shizuku me observa.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"O más bien, me está mirando con una mirada ligeramente intimidante.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0018",head="shz_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
},
vl03={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000052",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entonces yo también...\nAh, no es la gran cosa. ¡Solo pura casualidad! ¡Sí! Solo fue pura casualidad.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No trates de imitarme incluso en la manera de hablar...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0003",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000053",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aún sin ser la gran cosa, hay noches en las cuales resulta imposible dormir...\nAsí que, concluyendo con eso, los dos quedamos en buenos términos...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso de buenos términos?...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"msgoff"},
{"se",file="se9002",vol=30,id=1},
{"fg",ch="雫",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="雫",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0001",head="shz_z2b",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000054",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0015",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",time=500,size=10,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000055",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tengo hambre.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Estuvo despierta toda la noche. Si no ha comido nada desde la cena, es normal\nque tenga hambre...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres comer algo?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0017",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000056",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Comeré... bastante.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿no es extraño que respondas 'comeré bastante' cuando estoy\npreguntándote si quieres comer algo?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Por otro lado...",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Observo su cara.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0013",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000057",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Shizuku me observa de vuelta con una expresión extrañada.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Bueh, qué más da...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Shizuku es Shizuku.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Ella es Shizuku Natsume.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_01_2"},
{"text"},
linkback="block_00172",
},
