astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bgm",file="bgm043"},
{"text"},
text={
ja={
{
"Escucho música en mi habitación, solo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Se trataba de una canción que solía escuchar hace tiempo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Y hoy, después de varios años, vuelvo a escucharla.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"El nombre de esa canción es 'Sunflower'.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Hace muchos, muchos años, nació un gran cantante de rock en Gran Bretaña.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Fue tal la fama de su banda que llegó a ser calificada como la banda de la\népoca. Aunque lamentablemente esta se desintegró unos años después..",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Después de desintegrarse la banda, este músico incurrió en todo tipo de\ngéneros,casi como si buscase su propia identidad.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Este genio absorbió género tras género, perdiéndose en su propio camino.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"El avanzar lo hizo extraviarse en su propio recorrido.Y es que la regresión no\nes solo causada por holgazanería.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"A veces, o no, la mayoría de veces la gente retrocede por la misma fuerza que\nlos llevaba adelante.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Su nombre dejó de escucharse gradualmente en los círculos más populares.Ya\nnadie tenía ojos para el gran cantante.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Este intentó abandonar la música una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Pero era la misma música la que siempre estuvo a su lado.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Y por eso, se esforzó por permanecer junto a ella.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Comenzó a cantar en shows en locales pequeños, algo impensable para él hasta\nentonces.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Y entre tanto esfuerzo finalmente pudo escribir su primer álbum en solitario.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Sin embargo, su popularidad como artista en Gran Bretaña había caído por completo.\nNo pudo conseguir un contrato allí, así que firmó contrato con una discográfica en Japón.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"En Gran Bretaña había sido completamente olvidado.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Pero su música era todavía amada al otro lado del globo, en Oriente.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Y sin embargo, eso fue cambiando poco a poco.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Su transformación comenzó con este álbum.Con la misma canción que escucho\nahora.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Los artistas jóvenes comenzaron a respetarlo.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"El músico de la era.\nTodos comenzaron a llamarlo 'Modfather'.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0001",head="kei_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1500},
{"text"},
text={
ja={
{
"Fue Kei, obviamente, quien me habló de ella.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Y tal cual comentaba Kei, su música es genial, diferente a todo lo que había\nescuchado hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"'Sunflower'.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Es una canción algo anticuada, apegada a sus raíces. Pero cuando la escuché me\npareció novedosa, fresca.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Y eso no ha cambiado aún.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"En esos días que conocí esta canción yo era muy joven, y este cantante era ya\nmuy adulto.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Por eso esta canción retumba tanto en mi corazón.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Termina la canción.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"La nostálgica música se acaba.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Basta con reproducirla de nuevo para que regrese esa nostálgica melodía.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Sin embargo, el tiempo no regresará.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Hoy en día monto la motocicleta que él tanto amaba, y escucho la música que le\nencantaba.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¿Sentimentalismo, será?",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"¿De qué otra manera lo podría llamar?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces la misma fuerza para ir adelante nos hace retroceder...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces evolucionar nos hará extraviarnos en nuestro propio camino...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces extraviarnos también nos ayuda a salir adelante.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Verdad... Kei?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Miro el reloj.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pronto abrirán la tienda...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bgm",stop=1,time=1000},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de revisar el reloj, salí de casa.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"msgoff"},
{"bg",file="zbluesky_winter",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="man_tns_000034",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Eso es imposible.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_tns_000035",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿'Me lo imaginaba'? ¿Dónde quedó tu urgencia?\nTienes que hacer esto en tres días, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, quizá menos.\nEn el peor de los casos tendré que tenerlo listo para mañana.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_tns_000036",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Lo que me pides es completamente absurdo, una locura.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé muy bien.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_tns_000037",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Les he preguntado a todos mis conocidos artesanos, pero nada bueno. Es la\nprimera vez que alguien les pide fabricar tres enormes vitrales en menos de\ntres días.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_tns_000038",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Para qué necesitas vitrales?\nSe supone que fue el mural lo que rayaron, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_tns_000039",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Para qué más vitrales?... ¿Piensas cambiar los de Kenichiro Kusanagi con los\ntuyos? Si llegas a hacer eso ya no será más su obra.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el estado que está ya ha dejado de ser su obra, realmente.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tns_000040",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma necesito esos vitrales.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_tns_000041",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Umumumuh.... Naoya-kun, sé que debes tener alguna gran idea, pero...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me está sobreestimando.\nGran idea no hay.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_tns_000042",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Créeme que estoy dispuesto a hacer todo lo posible.\nPero respecto a eso, no puedo hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no se preocupe, solo quería confirmar.\nMuchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Salgo de la tienda de arte de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se2225"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sabía, no hay manera...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004076",ch="mkd"},
},
ja={
{
name={"???"},
"“Ahora que saliste de la tienda de arte, ¿a dónde piensas ir ahora?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Esa voz?!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",ch="真琴",size="z1",time=500,sync=1,mx=-40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tori... tani?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004077",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué viene la cara de sorpresa? ¿Quién más podría ser?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, digo, ¿cómo no sorprenderme? Tanto tiempo sin verte, además...\n¿Cuándo regresaste a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0009",head="mak_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",vol=70,id=1},
},
},
text={
vo={
{"vo",file="fem_mkd_004078",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que cuándo regresé? ¿De qué estás hablando?\nToma.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Toritani me extiende algo, apuntándolo hacia mi garganta.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una tarjeta?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0015",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004079",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Conociéndote, seguramente ni sabes en lo que trabajo ahora, ¿o me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"En la tarjeta de Toritani estaba escrito 'editora'.\nYa conocía el nombre de su revista... Incluso la he leído varias veces en la librería.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me llegaron rumores de que trabajabas como editora de una revista de arte,\npero...Quien diría que se trataba de ARTSCHOOL.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004080",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.\nHoy vine a Yumihari por un trabajillo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Trabajo? ¿Por qué la editora de una revista de arte tendría que venir a\nYumihari?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0006",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004081",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Te estás haciendo el tonto?! ¡Obviamente por lo de 'Las huellas de los\ncerezos'!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya se hizo oficial la publicación a los medios?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004082",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, todavía no.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces cómo es que sabías?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004083",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo mis conexiones. Y cuando se trata del colegio Yumihari, ninguna otra\nrevista de arte podría conseguir la primicia antes que yo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Sí, si llegan a reconocer esa cosa como obra las revistas de arte se\nmoverán...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0003",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004084",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Probé primero llamando al colegio, pero me dijeron que aún no saben si\nlo reportarán a la policía. Si no lo reportan se convertirá en obra, de lo\ncontrario en crimen, supongo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Preguntaste directamente al colegio? Qué agallas...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0023",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004085",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque el hecho que aun después de un día no sepan si reportarán o no es\nextraño.Ya sabes a lo que me refiero.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no sé. ¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004086",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que el colegio Yumihari no considera eso como un simple graffiti, sino como una\nobra. Y que además, están buscando el mejor momento para mostrarlo al\npúblico.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004087",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Otra fuente me indicó que la Fundación Moore está moviendo sus hilos...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0015",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004088",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si es por arte que genere dinero, esa fundación es capaz de meterse donde\nsea.Además, son ellos quienes administran la fortuna de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero esa es propiedad del colegio Yumihari, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0008",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004089",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El colegio Yumihari no es impenetrable. Te recuerdo que muchos aportaron dinero\npara expulsar a los Nakamura de ahí. Si no fuese así la información que tengo\nno se hubiese filtrado.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, tienes razón.Aunque supongo que ni tú sabrás quien pintó esa cosa,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0015",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004090",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo no? Solo los de Bourbagi podrían haber hecho eso.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Te subestimé... No pensé que supieras ya tanto.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0024",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004091",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No en vano trabajo haciendo esto... ¡Eh!¡Eso no importa ahora! ¡¿Dime, por qué\nacabas de salir de la tienda de arte?!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, probablemente no lo sabes, pero...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0018",head="mak_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0001",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004092",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Profesor de arte a tiempo parcial en el colegio Yumihari, suplente mientras se\nencuentra un profesor oficial... ¿Cierto?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que sabes bastante... Pues no hace falta explicar, ¿no? Vine acá como\nprofesor de arte.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0016",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004093",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hummm. No sabía que los profesores de arte de hoy en día fabricaban vitrales, y\nademás en cuestión de tres días.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Estuviste escuchando todo?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0015",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004094",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con esa voz tan fuerte...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Será el dueño de la tienda...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004095",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás tramando?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerca de?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0011",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004096",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La obra de Bourbagi será publicada en unos pocos días. Ya casi no queda tiempo.\nCualquiera diría que ya no se puede hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, cualquiera pensaría eso.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004097",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Pero te veo moviéndote.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ya escuchaste al dueño de la tienda, ¿no? No se puede hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0017",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004098",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jummm, ya veo. Por cierto, ¿no llegué a mencionarte esto hace tiempo?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0023",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004099",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las personas, cuando trabajan en una obra, hacen movimientos peculiares.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, como observar al vacío o mover los dedos como si fueran pinceles...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay contigo? ¿Estuviste siguiéndome y observándome a hurtadillas?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0017",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004100",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Es parte de mi trabajo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Por alguna razón, Toritani estaba ahora dando vueltas a mi alrededor, caminando\nlentamente.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Como un animal buscando intentando tomar a su presa por la espalda...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si viniste a Yumihari a reportar la obra de Bourbagi estás buscando en el lugar\nequivocado. Yo no tengo nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0010",face="f0018",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004101",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, eso pensaría cualquiera.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004102",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hablé con la directora, por cierto...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con la directora? ¿Tú?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0011",head="mak_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004103",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues claro, es mi trabajo. Siendo una de las involucradas, tenía que hablar con\nella también. Aunque fue por teléfono...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No fuiste a verla?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0018",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004104",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso no es parte de mi trabajo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Las Toritani no han cambiado nada. Ni la madre, ni la hija...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004105",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún no saben si aceptarán la obra de Bourbagi o no, así que han pintado con\npintura removible.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo supuse. Ese color no era de pintura permanente.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004106",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo cual quiere decir que todavía se puede remover esa obra.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tal vez se pueda.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0017",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004107",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ser así lo primero que deberías estar buscando es líquido removedor, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004108",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Acaso vas a decirme que has aceptado esa pintura?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acepte o no, yo no tengo derecho ni autoridad alguna en esto.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0018",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004109",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0006",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004110",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Naoya Kusanagi ya no es el muchacho salvaje e insensato de antes.Ahora tiene\nuna carrera, y una posición como educador.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0005",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004111",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por lo tanto, no tiene intención alguna de involucrarse con el mural esta vez.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0002",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004112",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno, supongo que si llegas a remover la pintura de Bourbagi te\nconvertirías en un criminal.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bueno que lo sabes. Así es.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0017",head="mak_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004113",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Así es', eh...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Toritani alcanzó mi espalda, y en ese instante.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"msgoff"},
{"se",file="se9031",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1f0000",face="f0004",head="mak_z1f",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"ex",time=800,func="wait"},
{"se",file="se9004",id=2},
{"fg",ch="真琴",size="z2",time=500,mx=-40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2f0000",face="f0004",head="mak_z2f",lv=5,id=9},
{"ex",time=1000,func="wait"},
{"se",stop=1,id=2,time=500},
{"fg",ch="真琴",size="z2",time=100,mode=3,path=":fg/mak/z2/",file="mak_z2f0000",face="f0006",head="mak_z2f",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",size=3,lv=5,id=9},
{"se",file="se1437",vol=50,id=3},
{"ex",time=1000,func="wait"},
{"se",stop=1,id=3,time=500},
{"quake"},
{"bg",file="ev_com_j06_01",id=9,lv=9,time=300,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"bgm",file="bgm012"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004114",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿De verdad pensaste que me iba a creer todo eso?!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",id=1,file="grigri"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwaah! ¡Espera, espera, me ahorcas, me estás ahorcando!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004115",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Dímelo todo! ¡Saca de esa boca todo lo que estás planeando!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya te dije que no voy a remover esa pintura!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004116",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pues entonces tienes que estar tramando algo más! ¡¿Para algo necesitas esos\nvitrales, o no?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, espera, aun si fuese así, ya te dije que obtener esos vitrales en tan\ncorto tiempo es imposible!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004117",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Alguien consciente de que algo es imposible no pondría esa mirada! ¡Tienes la\nmirada de alguien que planea algo!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Esas son falsas acusaciones! ¡¿Y qué mirada puede tener alguien que planea\nalgo, demonios?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004118",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿A dónde pensabas ir después de esto?!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué... piensas que iba a ir a algún lugar?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004119",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Saliste caminando en dirección contraria a la del colegio! ¡¿A dónde piensas\nir?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-A caminar un rato...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004120",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Y por qué ibas trotando?!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Corriendo un poco...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004121",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Mentiroso! ¡Confiesa! ¡Dilo! ¡Di lo que planeas!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Para, para, me rindo! ¡Y ya te dije que no estoy planeando nada!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_skr_000327",ch="skr"},
},
ja={
{
name={"???"},
"“¿Está planeando algo, profesor?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",file="se9010",id=1},
{"bg",file="ev_com_j06_08",path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004122",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bg",file="ev_com_j06_08",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004123",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_skr_000328",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Soy Sakurako Sakizaki, estudiante de segundo año del colegio Yumihari. He\nescuchado muchas de sus grandes historias, Toritani-senpai.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004124",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Quién te contó todo eso?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_skr_000329",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“El... profesor... Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_j06_05",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"quake",mode="mw"},
{"se",file="se1437",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004125",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Imbécil! ¡¿Grandes historias?! ¡Estuviste hablando pestes de mí con esta\nmuchachita! ¡¿Qué le contaste?!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gyaaahhh, me declaro inocente!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_skr_000330",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡El profesor nunca ha hablado mal de usted! ¡Siempre la elogiaba cuando me\ncontaba sus historias!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_j06_08",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004126",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000331",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, el profesor tiene mucho respeto por usted. ¡También dijo que usted es\nhermosa!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_j06_08",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004127",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Es eso cierto?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debo admitir, que lo de hermosa no lo he dicho...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_j06_05",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"se",id=1,file="grigri"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004128",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Eso no lo dijiste?! ¡¡¡TEN LA DECENCIA DE AL MENOS MENCIONÁRSELO!!!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gwaaaaahhh!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_skr_000332",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Qué está planeando, profesor?! ¡Dígame!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo normal no sería que me rescates antes? Están estrangulando a tu profesor,\n¿qué no ves?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_skr_000333",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Yo también estuve siguiéndolo todo este tiempo!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Tú también?!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_skr_000334",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Lo siento mucho! Pero, conociéndolo a usted imaginaba que de ninguna forma\ndejaría las cosas así.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué?! ¡¿Por qué tú también piensas lo mismo?!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_skr_000335",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Es que, viendo todas sus historias del pasado, cada vez más me pareció usted a\nun héroe, y...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es cosa de hace años. Y además, eso no es ningún héroe, solo un idiota que\nno puede ver más allá de su nariz.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_skr_000336",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pero gracias a esas acciones nació 'Las huellas de los cerezos'! ¡La pintura\nque tanto me encanta!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bg",file="ev_com_j06_06",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004129",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y ahora por qué te quedas callado?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pues qué debería decir?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004130",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás tramando algo, ¿verdad? Al menos cuéntale qué planeas.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo vuelvo a decir, no hay nada que pueda hacer en esta situación.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_skr_000337",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Según lo que escuché hace un momento, por lo menos se podría borrar la\npintura! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Pero si el colegio reconoce el mural de Bourbagi como obra y yo llego a\nborrarla, me convertiré en un criminal.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_skr_000338",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No es justo! ¡Ellos son los malos en esta historia!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004131",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lamentablemente Kusanagi tiene razón.Como editora de revista de arte, debo\nadmitir que Bourbagi es un grupo con innegable popularidad. Si llega a borrar\nla obra se armará un problema.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_skr_000339",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pero, pero!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo borrar esa pintura.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_skr_000340",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No es justo...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y ahora que lo sabes deja de estrangularme y suéltame, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_j06_07",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004132",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una obra genial siempre viene como una revelación divina.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004133",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En el arte moderno no hay nada innovador, ciertamente.Pero fuera de eso todavía\nes posible encontrar nuevas ideas. ¿Sabes por qué?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por el mismo avance de la tecnología, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004134",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En parte, pero no solo eso. Es porque hay obras destinadas para lugares y\ntiempos específicos.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_skr_000341",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Obras destinadas para lugares... y tiempos específicos.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004135",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, y las hay. Es de ahí que la obra deja de ser solo cuestión de talento. Y\nmás como una especie de revelación divina.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué idiotez. Además, lo que yo tengo en mente no es semejante producto de\ngenialidad, es... ¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bg",file="ev_com_j06_06",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004136",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Así que sí ocultabas algo!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Toritani me aprieta con más fuerza",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"quake"},
{"quake",mode="mw"},
{"se",file="se1437",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gwah, mi cuello, me ahorcas, me ahorcas.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004137",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Confiesa! ¡Revela tu plan!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco es la gran cosa como para llamarle plan.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004138",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, no hay un criterio claro para afirmar si una obra es genial o mediocre,\n¿o sí? ¡La verdad es que si es genial o no, eso lo deciden las generaciones\nfuturas!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pues entonces genio es quien logra ser recordado aún en el futuro!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004139",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No seas idiota. ¿El futuro? ¿Acaso vas a poder saber qué pasa después de que\nmueras? ¡Mientras no produzcas nada estando vivo, cero seguirá siendo cero!”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué intentas decir entonces?!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004140",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Que quizá no todos te vean como genio, pero yo sí!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004141",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y si para mí tu obra es genial, también serás un genio para mí!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no pasa de ser fantasía. El mejor arte es aquel reconocido por todos.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004142",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Serías capaz de decirle lo mismo a Gogh o Gauguin si estuvieran vivos?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Yo qué sé?!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004143",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No solo Gogh o Gauguin. ¿Acaso no han habido muchos genios que nunca fueron\nreconocidos estando vivos?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son excepciones, no la norma.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"bg",file="ev_com_j06_05",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004144",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Al demonio con las excepciones! ¡Lo que yo crea mejor es lo mejor! ¡¿Si así lo\nveo yo porque tendría que cambiar esa opinión?!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004145",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Naoya Kusanagi es, sin duda alguna, un genio!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué tonterías dices? Eso no es verdad. ¿Genios? Genios son personas\ncomo Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",file="ev_com_j06_06",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004146",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te equivocas. ¡Para mí tú eres más genio que Rin-chan!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y por qué?!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_j06_07",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004147",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo donde el genio es fino, puede verse el talento.\nGenio es lo que nos hace olvidar el talento.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004148",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso era lo que Kei solía decir.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y qué pasa con eso?!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a34_01",path=":ev/ev_com_a34/",set="ev_com_a34",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004149",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Justamente eso fue lo que pensé cuando terminamos de pintar el mural.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004150",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El concepto de genio desapareció por completo de mi cabeza cuando estuve\npintando contigo.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa obra fue de Akashi.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004151",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. ¡¿Pero acaso todos los miembros del club de arte que estuvieron ahí se\njuntaron por mera coincidencia?!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004152",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin Misakura, Rina Hikawa, Yuumi Kawachino, Kei Natsume. ¿Vas a decirme acaso\nque todos ellos se unieron al club y pintaron ese mural por pura casualidad?\n¿Y no por tu intervención?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eso no...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004153",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todos, incluso Akashi-senpai, entraron al club con tu última obra en mente.\n'Fantasía de un día de cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será porque su estilo era similar al de Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_j06_06",path=":ev/ev_com_j06/",set="ev_com_j06",sync=0},
{"extrans",time=500},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004154",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No entiendes absolutamente nada! ¡No se trata de eso!La apreciación que\nteníamos por esa obra fue lo que nos unió a todos.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004155",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todos nos juntamos gracias a tu obra, de alguna manera u otra.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"bg",file="ev_com_j06_07",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004156",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El mismo Akashi-senpai quedó inspirado por tus obras y decidió crear 'Las\nhuellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004157",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y tú, siempre persistiendo en tus obras por más heridas que sufras. Así como\ncerezos esparciendo sus bellos pétalos.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004158",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tu forma de vivir, tu vida en sí está directamente relacionada a tus obras.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004159",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todas tus obras han sido creadas para salvar a alguien.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en el caso de Rin... no creo que haya quedado cautivada con mi última\nobra.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004160",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? ¿Y si no quedó cautivada entonces que la llevó a abandonarnos a\ntodos e irse al exterior?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no tuve nada que ver en eso.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004161",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Dirías lo mismo si consideramos a Kei en el asunto?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Es verdad. Rin ha intentado seguir el camino que Kei quiso emprender conmigo,\nintentando redimirse.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"bg",file="ev_com_j06_05",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004162",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me importa un bledo si el mundo lo reconoce o no. ¡Para mí tú eres nuestro\nhéroe! ¡Un genio, que hace posible lo imposible!”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004163",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todos los del club se reunieron en un mismo lugar, atraídos por ti. ¿Y cómo no?\nEstar contigo es emocionante, divertido.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bg",file="ev_com_j06_06",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004164",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes por qué me empeñé en proteger el club?... Si bien tuve otra razón al\nprincipio, esa razón pasó poco a poco a convertirse en ganas de pintar\ncontigo y los demás.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004165",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El placer de pintar contigo solo lo podríamos entender quienes estuvimos ahí.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_skr_000342",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Eso no es verdad!”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"bg",file="ev_com_j06_08",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004166",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Ehm... ¿Sakizaki-san, era que te llamabas?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"bg",file="ev_com_j06_03",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"bg",file="ev_com_j06_08",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000343",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No hace falta estar ahí para saberlo.\nSolo con ver ese mural pude percibir mucha diversión y alegría.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_skr_000344",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Al verlo descubrí que una obra no es solo capaz de transmitir una temática,\nsino también las emociones de sus autores.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_skr_000345",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ese mural me hizo sentir emoción, adrenalina, y mucha alegría. ¡Por eso es que\nme encanta!”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_skr_000346",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Será acaso que solo son cosas mías?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"bg",file="ev_com_j06_04",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
ja={
{
"Toritani mueve su cabeza de un lado a otro con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004167",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No son solo cosas tuyas. La alegría y la emoción que hubo allí fue algo de otro\nmundo.¡Fue diversión pura!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004168",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todo lo que percibiste en esa obra está totalmente acertado.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000347",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Sakizaki-kun voltea a verme, con una expresión de alegría y satisfacción.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Ya antes había mencionado lo de que percibía alegría en la obra.Supongo que las\npalabras de Toritani dieron en el clavo.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, esa obra le pertenece a Akashi.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"bg",file="ev_com_j06_09",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004169",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahí también te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004170",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa obra fue creada por la promoción 89 del club de arte del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004171",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esa obra no es tuya, ni de Akashi!\n¡Es de todos nosotros!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000348",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Así es!”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué concuerdas tú también con ella?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_skr_000349",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Porque es verdad. Y eso es lo que hace tan maravillosa esa obra.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, ¿podrías soltarme ya?\nTus pechos están rozándome y debo admitir que se siente algo bien.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_j06_10",sync=0,face=1,time=400,path=":ev/ev_com_j06/",set="ev_com_j06"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004172",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000350",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Profesor!”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"se",id=1,file="se1879"},
{"quake"},
{"bg",rule=015,time=400,file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"excall",file="06_vl_05_2"},
{"text"},
linkback="block_00276",
},
label = {
top={block="block_00000",label=1},
},
}
