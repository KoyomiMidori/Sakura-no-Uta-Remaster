astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg054a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
"La plaza central después de las 12. A pesar de que normalmente está abarrotada\nde estudiantes, hoy está, como era de esperarse, bastante sola.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, disfrutaré de este pan gratinado antes de regresar a casa.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Golpeo suavemente la bolsa del pan con mis dos manos.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"La bolsa se rompe tras emitir un ruidoso sonido.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_cda_000001",ch="cda"},
},
ja={
{
name={"???"},
"“¡Me asusté! ¿Qué es eso, un cañón? Ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Una infantil voz, unas inocentes e ingenuas palabras. Son pocos los adultos\ncapaces de decir algo tan infantil como si nada.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, ¿viniste hoy?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_cdb_000001",ch="cdb"},
},
ja={
{
name={"???"},
"“Pero qué sonido. ¿Qué era eso, una bomba? Genial, genial, ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Se escucha de nuevo la voz desde un lugar distinto.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"¡¿Hay 2 Kei?!",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Obviamente, eso no es posible.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Niños?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Al darme la vuelta, la plaza central estaba llena con más de 10 niños.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué hay niños en este lugar?...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"¿Por qué habrán seres tan fuera de lugar como los son estos niños dentro del\nterreno del colegio Yumihari? Y además, a pesar de que hace rato no había\nninguno en el patio, de repente aparecieron de un lugar y otro, como si\nhubieran surgido de la nada.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_cda_000002",ch="cda"},
},
ja={
{
name={"Niño A"},
"“¿Qué? ¿No vas a volver a soltar ese sonido de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000051",ch="kmd"},
},
ja={
{
name={"???"},
"“Vamos, no debes molestar a las personas que están descansando.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_cda_000003",ch="cda"},
},
ja={
{
name={"Niño A"},
"“No estoy molestándolo, es que este tipo soltó un sonido totalmente increíble.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",lv=4,id=9},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000052",ch="kmd"},
},
ja={
{
name={"???"},
"“Siento mucho interrumpirle su comida...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Una monja aparece de entre la manada de niños.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Es que acaso había monjas de verdad trabajando en la falsa iglesia de este\ncolegio?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"No sé cómo era hace tiempo, pero juraba que ahora esta iglesia no era más que\nuna simple estructura ornamental...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000053",ch="kmd"},
},
ja={
{
name={"???"},
"“¿Vaya? Eres tú, ¿no? ¿Kusanagi-senpai, era?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que sabes mi nombre? No recuerdo tener ninguna conocida monja, de lo\nque yo--”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú eres... la hermanita de Akashi...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000054",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, soy Komaki Akashi. Tiempo sin vernos.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x2=0,x=345,lv=4,id=9},
{"fg",ch="小沙智",size="z1",mx=-40,mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000088",ch="ksd"},
},
ja={
{
name={"???"},
"“Solo problemas me causa el hecho de que muestres tu cara tan frecuentemente.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Las hermanitas de Akashi son gemelas, lo cual significa que...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000089",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ya es suficiente con verle la cara a este hombre cada vez que provoca algún\nproblema y es llamado a la sala del consejo estudiantil.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es tú hermano, yo no causo ni he causado ningún problema.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0006",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000090",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No solo él, Makoto también es igual. Y también todos sus compinches del club de\narte. Por supuesto, tú también eres igual.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"¿Cómo que compinches?... En primer lugar, yo ni siquiera pertenezco al club de\narte...",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_cdb_000002",ch="cdb"},
},
ja={
{
name={"Niño B"},
"“¿Este tipo es conocido tuyo, hermana?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000055",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, es el amigo de nuestro hermano. Y también es nuestro senpai.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que están trabajando de medio tiempo hoy?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000056",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Trabajo de medio tiempo?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo que las veo con un cosplay un tanto extraño, así que pensé que estaban\ntrabajando de eso...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0006",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000091",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡P-Pero qué descortés! ¡¿Cómo que cosplay?! ¡¿Es que acaso te estás refiriendo\na nuestros hábitos de monja?!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pues, es que acaso hay algo más a lo que pueda estar refiriéndome?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000057",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No es ningún trabajo de medio tiempo. Nosotras laboramos como profesoras de la\nescuela dominical.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Escuela dominical?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0018",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0016",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000092",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Es una actividad educativa impartida sobre niños que se reúnen en los domingos.\nAunque personas con tan poca fe religiosa como tú no deben saber ni qué es.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Suelto, inesperadamente, un respiro de admiración.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0013",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000093",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Q-Qué sucede?...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, simplemente que pensé que este colegio solo era un colegio religioso\npor moda... No sabía que hubieran creyentes de verdad.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000094",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Podrías dejar de llamarnos creyentes?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creyentes son creyentes, ¿no? ¿Si no es así entonces cómo me pides que los\nllame?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0002",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000095",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Llámanos seguidores, como debe ser.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Ambas significan lo mismo...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... ¿por qué andan trabajando de profesoras de la escuela dominical?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000058",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Hay una cierta razón en particular...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es acaso el padre o el pastor el que se encarga de hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000096",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Tú... padre, pastor, ¿el hecho de que no sepas cuál de los dos es significa que\nni siquiera sabes cuál es la corriente religiosa de este colegio?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así somos los estudiantes de acá. Dejando eso de lado, ¿ustedes están\ncapacitadas para impartirle clases a los niños?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000059",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí. Digamos que podemos encargarnos de todo lo relacionado a la escuela\ndominical. En lo que concierne a las adoraciones de los domingos, realmente\nno podemos hacer nada por nuestra cuenta.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmm. La verdad es que no tenía idea alguna de que hicieran eso en la iglesia\nde este colegio.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000060",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí. La gran mayoría de los estudiantes no lo saben. Son pocas las personas que\nentran a este colegio con verdadera fe religiosa.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en estos tiempos es difícil encontrar a alguien así... ¿Es que acaso la\nrazón por la cual ustedes eligieron este colegio fue esa?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000061",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, más o menos así fue.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es bastante raro... ¿Eh? Si ambas hermanas son cristianas, eso quiere decir\nque... ¡¿E-Es posible acaso que Akashi también sea cristiano?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000097",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“De ninguna manera... No hay forma de que ese hombre pueda tener tanta fe, ¿no\ncrees? Si la tuviera entonces no haría todas esas cosas que hace.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Me asusté... De ninguna forma pareciera ser un cristiano.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"En el supuesto caso de que tuviera algún tipo de fe religiosa, probablemente\nsolo sea de la religión 'YO ME AMO'.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000062",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Kosachi-chan y yo somos las únicas que hemos estado asistiendo a esta iglesia\ntodo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Asistiendo a esta iglesia todo este tiempo... ¿Será que se refieren también a\naún antes de que entraran a este colegio?",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Bueno, si el motivo por el cual ingresaron a este colegio fue por mera fe\nreligiosa, entonces supongo que así será...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_cdb_000003",ch="cdb"},
},
ja={
{
name={"Niño B"},
"“¡Hermanas! ¡Nosotros nos vamos ya!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000063",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Bien, bien, gracias por venir hoy, chicos.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_cda_000004",ch="cda"},
},
ja={
{
name={"Niño A"},
"“Nos vemos~”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0003",head="kos_z1b",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000098",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Tengan cuidado al regresar! ¡Vayan directo a casa sin desviarse del camino!\n¡¿Sí?!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_cda_000005",ch="cda"},
},
ja={
{
name={"Niño A"},
"“Sí~”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000064",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Bien, creo que nosotras también...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se van a casa ya?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=9},
{"fgact",ch="小牧",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000065",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No, tenemos varias cosas que hacer ahora, así que...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000099",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Además, no podemos regresar con esta ropa, ¿no te parece? Siempre nos cambiamos\nal uniforme antes de regresar.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="小沙智",mx=40,mode=-1,lv=4,id=5,sync=0},
{"fg",ch="小牧",mx=40,mode=-1,lv=4,id=9,sync=0},
{"extrans",time=1000,sync=1},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Así que se cambian de ropa al llegar al colegio...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Al escuchar nada más esa parte, de verdad pareciera que se tratara de un\ncosplay.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Aunque si llegara a decir eso, es más que seguro que terminará gritándome del\nenfado.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Le doy un mordisco al pan gratinado. El pan dentro de la bolsa estaba ya frío,\npero igual tiene su gusto.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Fue después del mediodía que dejé atrás el portón del colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"El sol de verano está bastante alto.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Aún queda tiempo antes de que el sol se ponga.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"La estación de trenes en una tarde de domingo.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Acabo de venir del colegio, así que pude haber ido a echarle un vistazo al\ncentro comercial de Sakuragahara...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"No, no soy del tipo de personalidad capaz de caminar solo un centro comercial\nen una tarde de un día feriado.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"se",file="se9004",id=1},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=240000,rule="083r",sync=1,vague=40,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será que voy a echarle un ojo a la casa...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Kei había inundado con agua mi apartamento hace un tiempo, pero ahora ya\nculminó por completo el cambio de suelo, y ya está en condiciones para vivir\nen ella.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Pensé en dejar la casa de los Natsume y regresar a la mía antes de que\nterminara el primer período, pero,",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Al darme cuenta, ya el primer período había terminado.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Fuera de lo esperado, la casa de los Natsume era realmente agradable. No pensé\nque me quedaría por tanto tiempo.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Más o menos una vez por semana me acerco a mi casa para revisar el buzón.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"No hay nada realmente importante adentro, pero a veces llegan documentos\nrelacionados a Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Debo revisarlo periódicamente.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"se",id=1,file="odoor"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... parece que construyeron algo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Hay un folleto de un supermercado que jamás había visto. Parece que\nconstruyeron un nuevo supermercado en el vecindario.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh? Tienen sashimi de pez volador. Y está bien barato...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Reviso el mapa.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Queda en un lugar al cual no he ido jamás particularmente, pero no parece\nquedar tan lejos.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será que voy después de terminar de limpiar la casa...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Una vez cada cuantas semanas limpio también la casa.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Las casas donde no vive ninguna persona se deterioran a un paso bastante\nacelerado.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Se acumula el polvo y también crece rápidamente moho.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Aunque a simple vista parezca estar organizada, puede pasar que en realidad\nesté llena de polvo y hediendo a moho.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Y por tal razón, a veces regreso a limpiar la casa.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que con esto está bien...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Termino de hacer una rápida limpieza sacudiendo y pasando trapo.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Y después, meto los libros y cosas que necesito en mi mochila.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"La verdad es que así como hago ahora, voy llevando poco a poco las cosas que\nnecesito a la casa de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Para andar haciendo esto, quizás hubiera sido mejor si lo mandaba todo el día\nen que me mudé...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque aun así, no podría meterlo todo en la habitación...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"La habitación en el cual me alojo en la casa de los Natsume es una de 6 tatami.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Este apartamento tiene 4 habitaciones, cocina, sala y comedor, y tiene\nalrededor de 100 metros cuadrados en área.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Si llegara a llevar todo lo que hay acá terminaría abriéndole un hueco al\ntatami.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Llevo unos cuantos libros que me gustaron y salgo de mi casa...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Mientras esperaba el elevador en el pasillo, observo las afueras por la\nventana.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Habrá terminado ya esa construcción?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Fue por abril que estaba puesto ese aviso de prohibición de entrada a personal\nno autorizado.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
