linknext="block_00016",
},
block_00016={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000640",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Vamos juntas al vestuario?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",x=0,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000369",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0022",head="yum_z1b",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="icon",lv=4,id=3,icon="icon16z1",x=0,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000641",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gaaah...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_rna_000416",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sueltas eso a nada de conocerla y te sorprende que te rechace?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0020",head="yum_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_yum_000642",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pensé que podía decirlo aprovechando el momento.”",
{"rt2"},
},
},
},
