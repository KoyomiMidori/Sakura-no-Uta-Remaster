{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000892",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Shizuku-chan?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000356",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",file="se9010",id=1},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x2=-345,x=-45,lv=4,id=5},
{"text"},
text={
ja={
{
"Shizuku corrió hacia Rin y tomó sus manos.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000357",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, ¿has estado bien?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000893",ch="rnd"},
},
ja={
{
name={"Rin"},
"“He estado muy bien.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000358",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me alegro.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001332",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Rin-chan, la conocías?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000894",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? P-Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001333",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero se supone que aquella vez, las dos no se conocían...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue después de eso. Por casualidad tuvieron el chance de encontrarse, y así\ncomo las ves, se llevaron muy bien.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000895",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Así sucedió todo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=-45,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000359",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así sucedió.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001334",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ya veo. Es increíble que incluso hayas podido hacer que esa Kusuka\nKusanagi se encariñara contigo. Rin-chan, tienes una especie de peculiar aura\nencima que atrae a los demás, ¿no creen?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000896",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para nada, para nada, eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x2=-45,x=0,lv=4,id=5},
