astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c04_01",path=":ev/ev_eye_c04/",set="ev_eye_c04"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Maldita sea con esa perra!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm011"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002689",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debes haber pasado un mal rato.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ojala hubiera sido solo un mal rato. Estuve a punto de terminar arrestado.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002690",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero... quizás si hubieras dicho lo que pasó con toda sinceridad, se hubiera\naclarado el malentendido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa no es la cuestión. Así se trate de una falsa acusación, parece que de ser\nagarrado y acusado por actos lascivos no hay forma de escapar a una\nsentencia.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002691",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, ¿de verdad? Me pregunto si de verdad alguien puede ser sentenciado aun\ncuando se desconoce la víctima. Kana-chan desapareció corriendo al instante,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, salió disparada como una bala apenas gritó...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002692",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Por cierto, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002693",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué terminaste envuelto en ese problema junto a Kana-chan? No es nada\nnormal que alguien se vea enrededado en un problema así en plena noche, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, es que... ehm, ya sabes que ella es una alborotadora, ¿no? Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002694",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmmm, ¿y ser una alborotadora hizo que ambos acabaran en medio de un caso\npolicial? Según pude ver al menos antes, Kana-chan no tenía malas intenciones\ncontigo, Nao-kun. Más bien diría que tenía afecto por ti.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002695",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es normal que alguien termine involucrando a la persona que le gusta en algo\ntan peligroso. Siento que hubo alguna gran razón detrás de todo.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, no, de verdad que no fue la gran cosa...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002696",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002697",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mumuh...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se puso de puntillas y observa detenidamente mi cara, como lo hizo hace un\ntiempo.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Espera... De verdad, no hice nada indebido...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002698",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay muchas cosas en esta historia que no me encajan...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Esto...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"La misma expresión lo decía. 'No le veo mucho sentido a esa historia'.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"De verdad que es bastante aguda.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Sin embargo, no puedo revelar tan ligeramente el hecho de que me encontré con\nsu padre... Y menos aún el hecho de que Nagayama parece haberlo escuchado\nabsolutamente todo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por otro lado, Rin, no tienes ningún recuerdo respecto al nombre 'Sui',\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002699",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muh. Estás cambiando el tema de forma muy repentina ahora.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, no tanto en realidad. Después de que pasó eso, estuve todo este tiempo\nmeditando acerca de la búsqueda de Sui.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002700",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿El nombre 'Sui'?... Creo que aparte de Sui-chan, no conozco a nadie más con\nese nombre...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? ¿No tienes alguna otra memoria respecto a ese nombre?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002701",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué... preguntas eso?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ya de por sí Sui tiene muchos aspectos misteriosos. Así que quería saber\nsi no recordabas su nombre de algún otro lado...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002702",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, me parece que no tengo ningún recuerdo al respecto.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg024c",path=":bg/",sync=0},
{"fg",ch="稟父親",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mtt/z1/",file="mtt_z1a0000",face="a0001",head="mtt_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"A pesar de eso, el padre de Rin sí conoce el nombre.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Al ver la expresión en el rostro del padre de Rin, confirmé por fin lo que\nestaba pensando.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Me da algo de pena admitirlo, pero no me di cuenta sino hasta entonces. Me\nresultó difícil aprenderme el primer nombre de una persona con la cual, en\nese entonces, no tuve mucha cercanía, aunque eso tampoco sirve de excusa.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay de Olympia entonces?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002703",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso fue lo que estuvimos investigando ayer, ¿no? Si de verdad conociera qué\nsignifica ese nombre no hubiéramos tenido que buscar tanto como ayer.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón... perdón, perdón.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Parece que de verdad no sabe.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Aunque era ya algo obvio, después de todo el tiempo que estuvimos buscando\nayer...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"No, espera un momento.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm016"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Cuál es esa palabra que te llama la atención?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000410",ch="sud"},
},
ja={
{
name={"Sui"},
"“Olympia.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002704",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Olympia?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000411",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. No sé por qué, pero... tengo ese nombre grabado en mi cabeza.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que lo tienes grabado en la cabeza? Pero si ese es el fabricante de tu ropa.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000412",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿El fabricante de mi ropa?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada de lo que tengas que preguntarme de nuevo, ¿no? Sin duda alguna, es\nel fabricante de tu ropa.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000413",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ahora que lo recuerdo, eso habías dicho antes, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002705",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, así que la ropa de marca Olympia es la pista para la búsqueda, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgdel",id=-1},
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Demonios, la he cagado.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Al principio, cuando apareció por primera vez el nombre de Olympia en el tema,\navancé la discusión asumiendo con toda seguridad que se trataba de una marca\nde ropa.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"En primer lugar, Rin nunca había escuchado la palabra 'Olympia' como tal antes.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"¿Sabrá ella algo respecto a esta palabra?",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando me dicen Olympia, lo primero que se me ocurre es una pintura. La obra\nrepresentativa de Édouard Manet.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002706",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... ¿No será eso lo que a la gran mayoría de las personas se le ocurre?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues acabo de recordar algo justo en este momento... Me da la impresión de que\nShizuku mencionó algo distinto el día en que le dije ese nombre.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002707",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Algo distinto?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué era lo que había dicho?... Si no mal recuerdo, era algo respecto a la\nópera, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002708",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ópera? Sí, ciertamente hay una obra de opera relacionada a ese nombre.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices? Shizuku me dijo que no había ninguna ópera llamada 'Olympia'.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002709",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es, no la hay. Olympia es un nombre que sale en 'Los cuentos de Hoffmann'.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Los cuentos de Hoffmann?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002710",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No la conoces? Es una ópera basada en la novela del poeta romántico germano\nHoffmann.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo conozco, o más bien, jamás había oído de esa obra...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002711",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Aún lo bien versado que eres en las artes, parece que no conoces mucho de\nla ópera, ¿no, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Fue papá quien me metió todos los conocimientos de\nhistoria del arte en la cabeza, como base teórica para poder pintar. En lo\nque a conocimiento general se refiere, soy todo un ignorante respecto a la\nhistoria de la música.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002712",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, es por eso entonces. Eres muy conocedor de la historia del arte\noccidental, así que pensé que también conocías a Hoffmann, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, me estás sobreestimando demasiado. No hay forma de que alguien tan pésimo\nen geografía como yo sea tan conocedor de la historia occidental.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002713",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se dice que Hoffmann, quien fue un poeta perteneciente a la corriente romántica\nde la literatura alemana, empleaba con mucha frecuencia en sus obras\ntemáticas un tanto fantásticas y tenebrosas como las de muñecos mecánicos y\nDoppelgängers.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Muñecos mecánicos?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002714",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Y en realidad, Olympia es el nombre de una muñeca mecánica que aparece en\nla ópera de Hoffmann.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Olympia era el nombre de una muñeca mecánica?... Entiendo, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Mierda, pero como me confundió las cosas... Ciertamente, no hay ninguna ópera\nllamada 'Olympia', pero esta resultó siendo el nombre de un personaje que\nprotagonizaba una de ellas.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de personaje es la Olympia que aparece en Los cuentos de Hoffmann?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002715",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo tampoco sé mucho al respecto, pero... Hace tiempo escuché la historia en\nalgún lado, así que lo recuerdo solo de forma muy general...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Escuchaste la historia en algún lado?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002716",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Si no mal recuerdo, Olympia era una muñeca mecánica idéntica a un humano,\ny...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una muñeca mecánica idéntica a un humano...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002717",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será posible que el Olympia que Sui-chan busca y la Olympia de Los cuentos de\nHoffmann tengan alguna relación entre sí?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Aunque, ¿quién te contó esa historia?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002718",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿T-Te refieres a mí?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Acabas de decirme 'escuché la historia en algún lado', ¿no?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002719",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo dije, pero... ¿Quieres saber quién me contó la historia? ¿P-Por qué\nquieres saberlo? Se supone que estamos hablando de la búsqueda de Sui-chan,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es, pero hay la posibilidad de que eso se convierta en una gran pista.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002720",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad?... Esto... esto... hmmm.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_sud_000414",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Pensando en algo, Rin?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="吹",size="z1",mx=40,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002721",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Sui-chan, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Estoy pidiéndole a Rin que recuerde algo que podría ayudar en la\nbúsqueda.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000415",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Búsqueda? ¿Qué están buscando?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que tú estás buscando.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000416",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Lo que yo estoy buscando?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así mismo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000417",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Y qué vientos te han soplado ahora? ¡Estás súbita y sorpresivamente proactivo\nahora! Aún después de haberte quejado tanto ayer...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000418",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ah! ¡¿Kusanagi-san, por fin has asimilado la idea de que tú y yo estamos\nunidos por el mismo destino?!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he asimilado nada parecido a eso.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002722",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque realmente lucías muy renuente a realizar la búsqueda ayer,\nciertamente...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La razón por la cual me volví tan cooperativo con la búsqueda de Sui hoy es por\nhaber hablado con el padre de Rin. Aunque por supuesto, no puedo decir eso\nahora.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Habían muchas circunstancias 'carnales' que me llevaron a actuar de esa forma\nayer. ¿No es así, Rin?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0022j",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002723",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿eh? ¿Ehh? Esto... p-pues...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Rin titubea al instante.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no estaba contrario a cooperar desde un principio. Pero\ncualquier hombre normal no aguantaría la frustración después de haber sido\nprovocado de esa manera. Así somos todos los hombres sanos...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002724",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... Mis disculpas, por haber hecho semejante maldad...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Rin se achiquita, haciendo difícil creer el ímpetu que mostró hace un rato.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Rin debe estar también algo arrepentida de lo que hizo ayer.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Esas provocaciones fueron también producto de las inconscientes inclinaciones\nsexuales de Rin, así que bueno, no es de sorprenderse que esté arrepentida\nahora.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Aunque en lo que a mi concierne, pude disfrutar el acto aún más gracias a esa\nprovocación (De hecho, lo hicimos varias veces), así que no me resultó para\nnada desagradable la experiencia, y después de todo, si eso logra distraer\nlas sospechas que Rin tiene acerca de mí, resulta más conveniente aún.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002725",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, respecto a eso, después de hacerlo pensé un poco y me arrepentí bastante de\nlo que hice. Perdóname, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, no tienes que arrepentirte tanto tampoco... Gracias a que me hiciste\nesperar tanto yo también pude disfrutarlo bastante al final...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002726",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000419",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡No entiendo nada!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002727",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿S-Sui-chan?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Sui se mete en la conversación.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000420",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué es lo que ha estado pasando en estos minutos? ¿Por qué Rin tiene que\ndisculparse con Kusanagi-san? De la manera como han fluido las cosas, no\nlogro entender eso.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002728",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, e-es que, ayer, le hice una maldad a Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000421",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Hiciste una maldad? Qué raro eso. No puedo creer que alguien con tan buena\npersonalidad como Rin sea capaz de hacer maldades. Aunque bueno, eso prueba\nlo bestia que es Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy ninguna bestia.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0004",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000422",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí lo eres. No encuentro ninguna otra explicación lógica factible. Rin, puedes\nseguir haciéndole aún muchas más maldades a Kusanagi-san. ¡Sui te apoya en\neso, Rin!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja de decir tonterías.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, Rin, ¿lograste recordar algo?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002729",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, lamento decirlo, pero no logré recordar quien me contó esa historia. Lo\nsiento...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, está bien.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Parece que las cosas no irán tan fácilmente después de todo...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... En fin, ahora sé que 'Olympia' tiene ese tipo de significado también,\naparte del que le da la obra de Manet.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000423",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué significado tiene?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, vamos a repasar ahora un poco respecto a lo que estás buscando Sui,\nincluyendo ese 'significado' también.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000424",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Repasar?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vamos a revisar de nuevo toda la información que tenemos. Es posible que\nhayamos dejado pasar algo por alto.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002730",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Además, no es tanta la información que tenemos tampoco...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Es posible que surja bastante de ella al revisar las cosas con\ncuidado.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002731",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, vamos a revisar primero. Sui.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=0,lv=4,id=6},
{"fgact",ch="吹",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000425",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, ¿qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olympia. Ese es el nombre que está escrito en la etiqueta de tu ropa. No sabes\ndónde la compraste.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=0,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000426",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí... ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y parece que ese atuendo fue un regalo de alguien.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por los momentos, debemos averiguar dónde se compró y se fabricó este atuendo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002732",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Podríamos buscar entonces por el fabricante en Internet, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Respecto a eso, ya lo hice. Y en conclusión, no hay ningún fabricante existente\ncon el mismo nombre que el de la etiqueta de su ropa.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002733",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En verdad?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, seguramente no aparece en los buscadores. Aunque hay otra forma más\nminuciosa de buscar.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002734",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Otra forma más minuciosa?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buscaremos en los registros de empresas y nombres de comercios de la Oficina de\nAsuntos Legales.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002735",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Ese método se escucha algo profesional.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los registros se pueden ver en el sitio web de la Oficina de Asuntos Legales.\nSe pueden revisar todos los registros de empresas en Japón, así que con eso\npodríamos encontrar aquellas compañías que no aparecen en los buscadores.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002736",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble. Con eso podríamos dar con ella rápido entonces, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque a final de cuentas este método tampoco es perfecto...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002737",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿No lo es?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo es, aunque igualmente es bastante útil el hecho de que podamos investigar\neso. En fin, es mejor movernos ya.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"No nos tomó tanto tiempo investigar el sitio.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Aunque, si vamos primero por los resultados, debo admitir que no encontramos\nningún registro existente de ese nombre que coincidiera con lo que buscamos.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Encontramos unas cuantas corporaciones con ese mismo nombre, pero sus áreas de\nnegocios eran distinta a lo que buscábamos.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002738",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué no saldrá en los registros?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Existe la posibilidad que el negocio no esté registrado.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002739",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Es posible eso?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las empresas individuales, de una sola persona, no están obligadas a\nregistrarse. Estás simplemente se registran si así lo desean.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002740",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso te dije que el método no era perfecto.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002741",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Realmente sabes bastante de eso, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, por ciertas circunstancias...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Suelto una sonrisa amarga.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002742",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quiere decir esto que volvimos a donde comenzamos?...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no volvimos. Se podría decir que el hecho de no haber encontrado ningún\nregistro representa una gran pista de por sí.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002743",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así como te dije hace un momento, los negocios individuales, que no son\ncompañías como tal, tienen la libertad de elegir registrarse o no.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienen ningún sitio en Internet, y tampoco están registrados en la Oficina\nde Asuntos Legales. Eso implica que las opciones de Olympia para vender su\nropa son muy limitadas, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002744",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, claro. Tienes razón. De no ser una compañía, entonces no tienen manera de\nrealizar ventas en gran escala. Y agregando el hecho de que tampoco tienen\nsitio web, son pocas las opciones que les quedan para vender.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. Probablemente son una pequeña tienda vendiendo al por menor, o tal\nvez se trata de alguna persona que manufactura los atuendos en forma de\npasatiempo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002745",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero si llegara a ser alguna tienda o persona fuera de la prefectura, la\nbúsqueda se hará bastante difícil.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa posibilidad es muy baja.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002746",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así, ya no habría razón para que Sui tenga que buscar algo que ni sabe\nqué es en esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002747",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sumado a eso, el uniforme del colegio Yumihari no tiene popularidad en los\notros distritos del país. Es lógico pensar que los únicos posibles\nfabricantes de esos uniformes estén solo acá, en la ciudad de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002748",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahora que lo pones de esa manera, ese argumento es bastante correcto...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La razón por la cual busqué en la Oficina de Asuntos Legales fue porque\nconsideré la posibilidad de que la tienda estuviera afuera de la prefectura.\nNo esperaba conseguir información más detallada allí. A final de cuentas, no\nnos quedará más opción que buscar a pie.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, vamos ahora a repasar todo de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que Olympia es un fabricante muy, muy pequeño, que no está registrado en\nla Oficina de Asuntos Legales.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tampoco expende sus artículos en Internet.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002749",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y además, lo que Sui-chan busca está acá, en la ciudad Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Se podría decir que volvimos a donde estábamos antes, pero ahora ya no\nestamos buscando en la penumbra.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si lo que Sui está buscando está relacionado con 'Olympia', entonces ese algo\ndebe estar dentro de esta ciudad. Dentro de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, si inspeccionamos con cuidado los lugares que de cierta forma le\nllaman la atención a Sui, al final seguramente se conectarán de alguna manera\ncon el nombre de Olympia.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Y probablemente también con la ópera de 'Los cuentos de Hoffmann'.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"No me parece coincidencia que tanto Rin como Shizuku conocieran el nombre de\nesa ópera.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Probablemente ese hecho también está conectado con el misterio de Olympia.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_sud_000427",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo... Qué espabilado estás, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo andas diciendo como si no tuvieras nada que ver en esto?... En fin,\nahora repasaremos lo de ayer.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002750",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Repasar lo de ayer?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comenzando desde el terreno del colegio Yumihari, caminamos por el parque\nSakuragahara, contiguo al río, y finalmente fuimos hacia el Parque Costero\nHinayumi. ¿Hay alguna relación en todo esto?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000428",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fumuh, una relación. ¿Habrá algo?...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ejemplo, ¿qué hay del hecho que todos los lugares que caminamos tenían\nárboles de cerezo?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"bgm",vol=0,file="bgm016"},
{"bg",time=200,file="black",path=":bg/"},
},
},
text={
vo={
{"vo",file="fem_rnd_002751",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Lugares con árboles de cerezo? Sí, todos los lugares que caminamos ayer...\n¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bgm",vol=0,file="bgm016"},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_com_c08_01",rule=7,time=50,path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000429",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bgm",vol=100,file="bgm016"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002752",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Se te vino algo a la mente?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002753",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no sucede nada. P-Probablemente no tiene nada que ver...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002754",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Por otro lado, ciertamente los lugares que visitamos ayer tenían todos\nárboles de cerezo, pero el lugar donde Sui-chan comenzó su búsqueda no tenía\nninguno.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ese lugar de construcción... Sí, ciertamente no había...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002755",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No implica eso que no necesariamente podemos reducirnos a lugares donde hayan\nárboles de cerezo?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez. Simplemente lo dije a manera de suposición.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_002756",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Tratándose de ti, pensé que lo habías dicho teniendo alguna idea en\nmente, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás enalteciendo demasiado, tampoco soy así de perspicaz.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002757",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, aún queda algo de tiempo por hoy.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui, ¿no hay algún otro lugar que capture tu atención como pasó ayer? Si\nvisitamos más lugares quizás podamos ver de qué manera se conectan.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_sud_000430",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues sí... Hmm. Si me atreviera a elegir un lugar, sería tal vez la colina de\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La colina de Yumihari, en pocas palabras, el colegio Yumihari... Sí, es el\nmismo lugar que has estado buscando con ahínco últimamente.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002758",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero en ese caso nunca llegamos a investigar el colegio todos juntos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Al parecer Sui estuvo buscando por su cuenta, pero... Quizás, no\ntenga mucho sentido que busque sola después de todo...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002759",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es realmente nada. Ahora que lo pienso bien, el solo hecho de que Sui\nlleve un uniforme imitación del colegio de Yumihari es un enigma, y se me\nvino de nuevo la idea que quizás el colegio es importante para esta búsqueda.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002760",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, entonces ahora vamos de aquí al colegio Yumihari, de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_olympia_06_2"},
{"text"},
linkback="block_00217",
},
label = {
top={block="block_00000",label=1},
},
}
