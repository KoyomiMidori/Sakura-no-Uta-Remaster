astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se2554"},
{"text"},
text={
vo={
{"vo",file="man_tnh_000001",ch="tnh"},
},
ja={
{
name={"Repartidor"},
"“Buenos días, traigo un paquete.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_aid_000480",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vaya, qué raro.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Ai trata de pararse, pero la detengo con un ligero movimiento de mi mano.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente es para mí.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_aid_000481",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Compraste algo? Eso es raro también.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Lo es. Por lo general no tengo dinero. Sin embargo, sea como fuera, quería eso.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm036"},
{"text"},
text={
vo={
{"vo",file="man_tnh_000002",ch="tnh"},
},
ja={
{
name={"Repartidor"},
"“Muchas gracias~”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Pongo mi sello y recibo el paquete.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ver entonces.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Despego rápidamente la cinta adhesiva, y al tratar de abrir el paquete, Ai se\nacerca y se sienta al otro lado.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Aquello que tanto estuve esperando estaba delicadamente empaquetado. Saco\ncuidadosamente el contenido de la caja.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000482",ch="aid"},
},
ja={
{
name={"Ai"},
"“Un jarro... ¿Una taza de café?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"La levanto, la volteo y la dejo reposar sobre mis manos. Disfruto y contemplo\ncuidadosamente la taza de café que acababa de comprar.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh... esta sensación de la taza acoplándose perfectamente a mis manos...\nSupera por completo mis expectativas...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_aid_000483",ch="aid"},
},
ja={
{
name={"Ai"},
"“Debe ser de muy buena calidad como para que digas eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la vi hace unos días en una exhibición especial de la tienda departamental.\nEn ese momento no me pude decidir, así que no la compré.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero luego me di cuenta que sí la quería, y la ordené por Internet. Y bueno, el\nenvío fue gratis, además que el precio de la taza como tal era cariñoso con\nmi billetera.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuesta lo mismo que un CD de música. Incluso un estudiante de secundaria podría\ncomprarlo, si así quisiera.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cada uno de sus elementos están hechos a mano. Y sin embargo, el creador no es\ninsistente en dejar su propio estilo en ella...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, digamos que no tiene un estilo tan fácilmente distinguible. Y a pesar de\neso, con ver y tocar puedes sentir y entender el concepto con el que esta\ntaza fue creada.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hecho de que no tenga un estilo tan distinguible implica que se adapta\nfácilmente a la vida diaria. Su énfasis está, más que nada, en la\ncotidianidad de las personas... Esta taza de café acompaña el día a día de la\npersona que la compra.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y eso no es algo que se pueda lograr tan fácilmente. Así como te digo esto, en\nel sitio web del creador hay algo parecido escrito.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000484",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué es lo que dice?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La marca de este jarro es 'Conejo de Luna'. En su sitio web tienen escrito este\ntexto de presentación.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuestro concepto de 'Conejo de Luna' es de 'ordinario, común'.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una taza toca los dedos, manos y labios de su usuario. Esta debe tener la\nsuavidad que tendría un conejo y la quietud de la luna.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuestro deseo es crear tazas ordinarias, pero preciosas, suaves y con un aura\nde quietud.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Al leer eso, sentí que realmente esas eran las palabras de alguien que crea\ncosas a las que verdaderamente se les puede dar buen uso.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000485",ch="aid"},
},
ja={
{
name={"Ai"},
"“Veo que admiras bastante a ese creador.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo admito. Me parece alguien impresionante.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000486",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"excall",file="02_abend_04_1"},
{"text"},
linkback="block_00031",
},
label = {
top={block="block_00000",label=1},
},
}
