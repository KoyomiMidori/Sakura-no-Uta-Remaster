{"cgdel",id=9,lv=9},
{"bg",file="ev_shz_h08_05",sync=1,time=1000,vague=100,path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001005",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aku, kuhh... ¡¡¿AAAaahhhh?!!”",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*throb* *throb*, *bhrrr*!",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"text"},
text={
ja={
{
"Eyaculé estando dentro de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
ja={
{
"Esta, por su parte, arqueaba su espalda mientras gemía del placer al alcanzar\nel orgasmo.",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*throb*, *throb*...!!",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"text"},
text={
vo={
{"vo",file="fem_szd_001006",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“A-Ah... está caliente. E-Esto es... Naoya, ¿estás, eyaculando?”",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... kuh, estoy... eyaculando... adentro...”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"text"},
text={
vo={
{"vo",file="fem_szd_001007",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, ahh... Naoya, Naoya está... eyaculando... dentro, de mí-- ¡¡¿---?!!”",
{"rt2"},
},
},
},
linkback="block_00428",
linknext="block_00430",
},
block_00430={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*tiembla*!",
{"rt2"},
},
},
},
linkback="block_00429",
linknext="block_00431",
},
block_00431={
{"text"},
text={
ja={
{
"Shizuku temblequeó fuertemente.",
{"rt2"},
},
},
},
linkback="block_00430",
linknext="block_00432",
},
block_00432={
{"text"},
text={
vo={
{"vo",file="fem_szd_001008",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00431",
linknext="block_00433",
},
block_00433={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00432",
linknext="block_00434",
},
block_00434={
{"bg",file="ev_shz_h08_06",sync=0,face=1,time=400,path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"text"},
text={
ja={
{
"Todavía con nuestros cuerpos unidos, nos abrazamos.",
{"rt2"},
},
},
},
linkback="block_00433",
linknext="block_00435",
},
block_00435={
{"text"},
text={
vo={
{"vo",file="fem_szd_001009",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00434",
linknext="block_00436",
},
block_00436={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00435",
linknext="block_00437",
},
block_00437={
{"text"},
text={
vo={
{"vo",file="fem_szd_001010",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me acabo de dar cuenta de algo...”",
{"rt2"},
},
},
},
linkback="block_00436",
linknext="block_00438",
},
block_00438={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00437",
linknext="block_00439",
},
block_00439={
{"text"},
text={
vo={
{"vo",file="fem_szd_001011",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así como estamos, probablemente el semen se deslice y se derrame hacia afuera.”",
{"rt2"},
},
},
},
linkback="block_00438",
linknext="block_00440",
},
block_00440={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es broma?”",
{"rt2"},
},
},
},
linkback="block_00439",
linknext="block_00441",
},
block_00441={
{"text"},
text={
vo={
{"vo",file="fem_szd_001012",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Y mi brazo no alcanza hacia las toallas.”",
{"rt2"},
},
},
},
linkback="block_00440",
linknext="block_00442",
},
block_00442={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00441",
linknext="block_00443",
},
block_00443={
{"text"},
text={
ja={
{
"Fue al escuchar eso que entré en cuenta de la situación...",
{"rt2"},
},
},
},
linkback="block_00442",
linknext="block_00444",
},
block_00444={
{"text"},
text={
vo={
{"vo",file="fem_szd_001013",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Movámonos un poco al lado, pero sin sacarlo.”",
{"rt2"},
},
},
},
linkback="block_00443",
linknext="block_00445",
},
block_00445={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno. Sí, no queda de otra...”",
{"rt2"},
},
},
},
linkback="block_00444",
linknext="block_00446",
},
block_00446={
{"bgm",stop=1,time=1000},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Todo era nuevo para nosotros.",
{"rt2"},
},
},
},
linkback="block_00445",
linknext="block_00447",
},
block_00447={
{"text"},
text={
ja={
{
"Hubieron muchas equivocaciones y errores, pero a pesar de eso, fue una noche\nmuy importante y especial para los dos.",
{"rt2"},
},
},
},
linkback="block_00446",
linknext="block_00448",
},
block_00448={
{"scene",file="scene10"},
{"msgoff"},
{"fg",mode=-2,sync=0},
