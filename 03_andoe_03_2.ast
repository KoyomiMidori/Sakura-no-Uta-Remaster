{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001014",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Regresaré a mi habitación, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00447",
linknext="block_00449",
},
block_00449={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien.”",
{"rt2"},
},
},
},
linkback="block_00448",
linknext="block_00450",
},
block_00450={
{"text"},
text={
ja={
{
"Hubiese preferido quedarnos juntos hasta el amanecer, pero aún no puedo hacer\neso.",
{"rt2"},
},
},
},
linkback="block_00449",
linknext="block_00451",
},
block_00451={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será algo tardío, pero tendré que darle la noticia... seguramente se enojará...”",
{"rt2"},
},
},
},
linkback="block_00450",
linknext="block_00452",
},
block_00452={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001i",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001015",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Algo tardío?”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cosas mías, no te preocupes...”",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"text"},
text={
ja={
{
"Sea lo que sea, debo hacer las cosas bien...",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
