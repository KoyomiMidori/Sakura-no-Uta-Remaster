astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003801",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estoy bien hasta acá.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? No te preocupes, te puedo llevar todo el camino.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003802",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien, no hace falta. Lo siento, ¿podrías dejarme regresar sola hoy?",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?... Pero...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"mwact",act="rl",size=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"*Gyuh*... Siento algo jalando de la manga de mi camisa.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0005",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000841",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Shizuku jaló de mi manga, moviendo la cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Rin vio la mano de Shizuku, y entonces...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0005",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003803",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, gracias...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Dijo eso.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000842",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Gracias a ti por hoy, Rin.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003804",ch="rnd"},
},
ja={
{
name={"Rin"},
"*Uhm*.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Rin contesto con una voz algo sobresaltada.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003805",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Adiós, muchachos. Gracias por hoy.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Somos nosotros los que deberíamos agradecerte. Gracias por tanto, Rin.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000843",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Adiós, Rin.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003806",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nos vemos, Shizuku-chan...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"se",file="se9004",id=1},
{"fg",ch="稟",mx=40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Y entonces, Rin se fue caminando.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se9008",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=6},
{"bgm",file="bgm103"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000844",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Con permiso.”",
{"rt2"},
},
},
},
labelcount=4,
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pasa...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Shizuku entra a mi habitación.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000845",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me dormí en medio de la sesión de estudio.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No habías dormido bien, es normal. Ya no eres Hakuki. Eres una persona normal,\ncomo todos los demás...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000846",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=6},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000847",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dejando eso a un lado, Naoya. Quiero un beso francés.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien. ¿Así?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Intento darle un pequeño beso a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="うなづく",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Pero entonces, sus dos manos tomaron mi cara, y...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh, nmm.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_szd_000848",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*chuu*... *chu*, *chuu*... *chu*... ngh, nmm...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Nmm?! Ngh, mmm... *smchh*...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001i",head="shz_z2a",lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002i",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000849",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Un beso francés.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, eso no fue un beso francés, fue un beso profundo, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001i",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000850",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Después de lo que me dijiste busqué lo que realmente significa un beso francés,\ny me di cuenta que es todo lo contrario a un beso ligero. Un verdadero beso\nfrancés es como este.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0002i",head="shz_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0016i",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000851",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, fuiste tú quien se equivocó esta mañana al dar esa definición. Así que\ndecidí darte un verdadero beso francés.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... ehm...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Fue algo súbito, pero la sensación de su lengua todavía quedaba en mi boca.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Nada que ver con un beso convencional.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"La sensación de nuestras lenguas enrollándose una con la otra, y esa peculiar\nsensación de euforia al sentir el calor del otro... Lo único que pude hacer\nante esas repentinas emociones fue tocar mis labios.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0001i",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000852",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Los besos franceses se sienten algo raro, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... tenía ya cierta imagen de como eran, pero en realidad fue mucho más...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0012i",head="shz_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0001i",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000853",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mucho más qué? ¿Cómo se sintió?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, quiero decir, fue mucho más placentero de lo que imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002i",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000854",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, yo también pensé lo mismo. Se sintió, muy bien...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001i",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000855",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Será por eso?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por eso, qué?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008i",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000856",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Que tienes esto tan duro...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Distraído por el beso, no me había dado cuenta de que mi miembro estaba\ncompletamente erecto.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001i",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000857",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué está así?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008i",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000858",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nunca, en las tantas veces que intenté tentarte, llegó a ponerse así.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, no podía evitarlo... después de besarme de esa forma, con la mujer que\namo...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011j",head="shz_z2b",lv=5,id=6},
{"fgact",ch="雫",act="いいえ",size=10,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0008j",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000859",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Jaa.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"De repente, Shizuku se puso roja como un tomate.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011j",head="shz_z2b",lv=5,id=6},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0008j",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000860",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“C-Cuando te refieres, a la mujer que amas, en este caso, ¿te refieres a\nShizuku?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién más?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0003j",head="shz_z2b",lv=5,id=6},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011j",head="shz_z2b",lv=5,id=6},
},
vl02={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0003j",head="shz_z2b",lv=5,id=6},
},
vl03={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0002j",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000861",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Entonces... e-esto... ¿S-Será que también podría tener el privilegio... de\nque me hagas tuya?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, claro que puedes, pero...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0008j",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000862",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Apenas ayer me confesé, y... pensé, que tal vez sería, algo rápido...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0013j",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000863",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? ¿Estás pensando en retrasarlo?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Retrasar? ¿Retrasar qué?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0011j",head="shz_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0010j",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000864",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Parecieras querer decir que aún es muy rápido para hacer cosas sucias... y\nhacerme esperar más.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001j",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000865",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quiero tener sexo contigo, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y-Yo tamb--!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011j",head="shz_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0010j",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000866",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero dices que aún no es el momento... ¿Cuánto más debería esperar?...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, no se trata de esperar o no, sino que...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0001j",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000867",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Shizuku quiere hacerlo, pero si tú todavía no, aguantaré.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera, las cosas no son exactamente como las ves...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010j",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002j",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000868",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No quisiera esperar más, pero si así me lo pides, yo... aguantaré, un poco más.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Shizuku sonríe. Parece estar algo abrumada.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Después de la manera en que me lo dijo, no hay manera... de que yo, pueda\naguantar...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",size=10,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000869",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien. Shizuku regresará a su habitación por hoy.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esp--!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000870",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Shizuku intenta pararse, pero tomo su brazo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000871",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... esto...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podemos... besarnos otra vez?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0002",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="うなづく",size=10,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000872",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tanto como quieras, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",id=1,file="se2580"},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sin mediar palabra, abracé amorosamente a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",file="se9035",id=1},
{"bg",file="ev_shz_h06_01",path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
ja={
{
"Acaricio su cabello y muevo mis manos hacia sus caderas.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_szd_000873",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_szd_000874",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... mmm...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Meto lentamente mi lengua en su boca.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_szd_000875",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haahn... ngh, mm, *chuu*... *chu*, *shrrp*... ngh.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Nuestras lenguas se cruzan una con la otra, produciendo obscenos sonidos.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"La excitación me hace perder el control...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Pongo mi mano sobre el lazo del uniforme de Shizuku y lo desamarro de una forma\nun tanto violenta.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_szd_000876",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... ¿Naoya?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Desabotono su vestido.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo... creo que realmente no puedo contenerme...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_szd_000877",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Shizuku me abraza fuertemente por la cabeza.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_szd_000878",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay necesidad de que lo hagas. Yo soy tuya, Naoya. Puedes hacer lo que\nquieras conmigo...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_szd_000879",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Porque te amo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Un abrazo, y un te amo.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Jamás pensé que esas dos cosas me podrían causar tanta felicidad...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_szd_000880",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haz lo que quieras conmigo.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_szd_000881",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, N-Naoyaaa, ngh.. mm, ngh... *chu*, *shrp*... *shrrr*...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"La respiración de Shizuku se agita mientras nos besamos.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"La sola acción de desabotonar me irritaba, y preferí meter mi mano directamente\na su falda y acariciar su trasero.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Su trasero envuelto en sus pantaletas era suave y carnoso.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_szd_000882",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... N-Naoyaa.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Perdóname... Te toqué sin mediar palabra...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Shizuku mueve su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_szd_000883",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Al contrario. Me gusta también cuando eres así de agresivo... haces que me\nexcite.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Termino de desabotonar su vestido. Pongo ahora las manos sobre su blusa.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Hasta finalmente descubrir su ropa interior.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"se",file="se9010",id=1},
{"bg",file="ev_shz_h06_02",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué ropa interior tan tierna...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_szd_000884",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... elegí la opción más popular entre los hombres según las encuestas de las\nrevistas... ¿Te gusta este conjunto, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me encanta...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_szd_000885",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De ser posible, ignora el hecho de que no tengo tanto pecho...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, ya te he dicho que eso no me importa...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Pongo mis manos sobre los muslos de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Eran suaves, y agradables al tacto.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Nunca me imagine que la piel de las chicas se sintiera de esta forma...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Subo con mis dedos, tocando sus genitales por encima de su ropa interior.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_shz_h06_03",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000886",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*Hii*",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Shizuku da un pequeño salto.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Y-Ya te mojaste?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Siento algo húmedo en la punta de mis dedos.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_shz_h06_02",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000887",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Probablemente. Solo con el beso de esta mañana me mojé bastante...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_szd_000888",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me encantas, Naoya. Solo un beso bastó para calentarme allí... Así que, no creo\nque sea nada raro que este así ahora...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero qué dices... ¿De dónde aprendiste esa frase tan sucia? ¿Otras de tus\nbúsquedas en el teléfono?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_szd_000889",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Solo digo la verdad...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Escucharla decir algo tan sucio, y con tanta facilidad... sinceramente, me pone\ndemasiado caliente...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_szd_000890",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esta mañana tuve que cambiar mi ropa interior... así que ahora quizás esté aún\npeor... Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te disculpas?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_szd_000891",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es que, pensé que tal vez quedarías repugnado de una muchacha tan sucia...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_szd_000892",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿En serio? Está bien entonces, supongo... aunque, probablemente ensucie\nbastante tus dedos.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes de qué preocuparte. Eso sería más bien una recompensa para mí.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_shz_h06_03",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000893",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿S-Sí?... Kuun.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――*biku*",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Con apenas rozar mi mano sobre sus genitales, los hombros de Shizuku volvieron\na temblar.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se siente bien?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_szd_000894",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Shizuku pareciera estar inexpresiva... pero de su expresión percibo vergüenza y\ndesconcierto.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Shizuku desengancha su sujetador.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",file="se9010",id=1},
{"bg",file="ev_shz_h06_04",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
ja={
{
"Envuelvo con mis manos sus pequeños pechos y los acaricio cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_szd_000895",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Haaan...?! Ah, ngh... *huh*...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"La respiración de Shizuku se agita.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se sienten bien tus pechos?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_shz_h06_05",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000896",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Son pequeños, pero... uhn... *ahaa*, ngh, mmm... se siente, muy bien...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Los pechos de Shizuku cabían justamente dentro de mi mano.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_shz_h06_04",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000897",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Auuhhh. *iyaa*, ah... me estás...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te duele?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_shz_h06_05",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000898",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No... e-en realidad... se siente, muy, muy bien... creo... ahn.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Shizuku se mueve, aquejada por el placer.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Disfruta que le acaricie sus pechos.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Muevo sus pezones con mis dedos.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_shz_h06_04",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000899",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, *huh*, ¡Ahaaa!...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――¡*biku*!",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Sus hombros volvieron a temblar fuertemente.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_szd_000900",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nm, ngh... mm, *huuuh*, Jaa, jaa... ¡Ahhh!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Shizuku sujeta firmemente las sábanas, y gira su cabeza a los lados viéndome.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_shz_h06_05",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000901",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... E-Esto... S-Siento, que... si sigues tocando mis pechos de esta forma, algo\nvendrá...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Shizuku dice eso, mezclando sus palabras con gestos que no me dejaban claro si\nquería que siguiera o que parara.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo vendrá?... ¿Quieres decir que te vienes?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_shz_h06_04",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000902",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Fuh*... no. N-No lo sé... pero, auhhh...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Con su cuerpo estirado y tenso, la pose que tomaba ahora hacía parecer que\nestuviera inflando sus pechos hacia afuera... realmente debe estar\ndisfrutándolo...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_szd_000903",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Aiih*, auh, ughn, ah, ngh... Jaa, jaa, i-increíble, algo, siento algo venir...\nah, no... algo, muy caliente... está, entrando en mi cabeza...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?... Pues, entonces...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_shz_h06_07",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000904",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haiiih, kuuhn... hauh... a-ahh... nghhh... ¡Jaa, jaa, jaa!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Le doy vueltas a los pezones de Shizuku con mi lengua.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bg",file="ev_shz_h06_06",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000905",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Auhhn, haauhn, ah, ahn, haaiih, ah, ah, ahh, ngh, ah, *huh*, Jaa, jaa, ngah,\n¡¿Aaahh?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_szd_000906",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“A-Algo, algo viene... Kyahii, a-ahnnn, n-no, si sigues, yo... ¡¡Haiiiiihnnn?!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, si se siente bien solo déjate ir... No te soltaré de mis brazos.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="ev_shz_h06_07",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000907",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Jaa, *huu*, *hyuh*?! A-Ah... a-ahí, no... ngh, n-nooo... ¡Jaa, jaa, jaa!\n¡Ngh, si sigues mordiéndome ahíiii---!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_szd_000908",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*Hih*...",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"El cuerpo de Shizuku se tornó rígido por un instante.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_shz_h06_06",sync=1,time=1000,vague=100,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000909",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nghhh... kuuhhh...... ¡¡¡¿Mm?!!!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Y entonces alzó fuertemente su voz mientras todo su cuerpo temblaba, como si\nbuscara expulsarlo todo por su boca.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_szd_000910",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡¡¿¿AAAAaaAaahhh??!!!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*bikubikubikun*!!",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_szd_000911",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, jaa, jaa, jaa, jaa... kuuuh.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――*biku*",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Parece que su cuerpo aún no deja de temblar.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te viniste?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_shz_h06_08",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000912",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? ¿A esto le llaman... venirse?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Creo...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_szd_000913",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y-Ya veo... se sintió... extraordinariamente bien...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alegro de eso...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_szd_000914",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque... se siente algo mal también...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué sucede? ¿Te sientes mareada, o algo así?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_szd_000915",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No... mis piernas...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tus piernas?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Toco los muslos de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_shz_h06_09",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000916",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡¿Hyaauhn?!!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Apenas mis dedos tocaron sus muslos, Shizuku arqueó violentamente su espalda.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué demonios es esto?... Toda la zona de tus muslos... está mojada.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_shz_h06_08",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000917",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Perdí el conocimiento por un instante con lo de hace un momento... Así que\nquizás, me oriné...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... espera...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"El líquido que había empapado sus muslos tenía algo de viscosidad. No era\nprecisamente orina.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es normal que alguien se moje tanto?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_szd_000918",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Que me moje tanto? ¿Eh? ¿Todo esto son... fluidos vaginales?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me parece.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_szd_000919",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_szd_000920",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ugh～”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Shizuku puso una expresión en su cara que jamás antes había visto.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_szd_000921",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Est-- e-esto es... eh...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_szd_000922",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“N-Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿por qué te pones así?...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_szd_000923",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Odiarás a Shizuku por ser así?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, tonta. Esto más bien me alegra.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Vuelvo a tocar sus muslos, y muevo mis dedos de ahí a la zona central de sus\ngenitales.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"bg",file="ev_shz_h06_09",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000924",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hauun... auh... no, si me tocas ahí... de verdad... ensuciaré aún más tus\nmanos.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Shizuku mueve sus caderas del placer.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No seas tonta, puedes ensuciarme todo lo que quieras.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_szd_000925",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, mm, Jaa... ¡Ya te dije que no y aun así no me prestas atención! N-No te\nquejes después... A-Acabaré... enloqueciendo...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto como gustes.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Rozo su entrepierna con mis dedos.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_szd_000926",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡Haaih?! ¡¿Haiiihn?! Ah, ahh, Jaa... Ahn, ah, ah, ahhn. T-Tus dedos, están\nrozándome... Iyaahhh... ¡¿Haaiin?!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikubiku*!",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Su cuerpo se estremece aún más fuertemente que hace un rato.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Sí así de sensibles son sus pechos... ¿Qué pasaría, si llego a tocarla\ndirectamente allí?...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_szd_000927",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haiih, kuun, hauuh, ah, ah, ah, ahh, ahn, ¡¿Haaiih?! ¡¿Hawaah?! N-No. S-Si\nsigues... rozándome así... ngh... no...Jaa, jaa.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Entre cada apretón que doy las pantaletas de Shizuku chorreaban fluidos\nvaginales, de la misma forma que una esponja suelta agua cuando la aprietas.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"El viscoso líquido se adhiere no solamente a mis dedos, sino también a toda mi\nmano.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku... ¿Puedo quitarte las pantaletas?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bg",file="ev_shz_h06_08",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000928",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eh, esto...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Shizuku aparta la vista.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_szd_000929",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Pues... ahora... estoy, muy, muy mojada... así que... no te asquees de mí,\n¿sí?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"No hace falta bajarte la ropa interior para saber eso...",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"se",file="se9010",id=1},
{"bg",file="ev_shz_h06_10",path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000930",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente tienes los genitales como una niña...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"bg",file="ev_shz_h06_11",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000931",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No te gusta?...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya sabes muy bien que tengo inclinaciones lolis.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_szd_000932",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo sé, solo que... ngh... me da pena...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Toco directamente sus partes.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"――*chuu*...",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_shz_h06_10",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000933",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh――”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Shizuku intenta mitigar su voz.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está... muy caliente...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Sus genitales estaban sorprendentemente calientes y mojados.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"――*chuu*, *chuu*...",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_szd_000934",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, ngh, haan, nm, ngh, *huh*... ah, ahh... ngh, nm, mmm...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Intenté estimular su clítoris. Puesto que había leído en un libro que era una\nzona sensible...",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_szd_000935",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, kuuhh~~ Jaa, jaa, ah, ahh, ngh, ahn, ah, ah, ah, ahh... mmm.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Pero sus genitales estaban tan mojados que solo con el tacto de mis dedos no\nsabía dónde estaba tocando.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Lo único que podían captar era una cálida, viscosa y agradable sensación.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_szd_000936",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hyuun...... ngh, mm... ngh, ahh...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Gemidos se escapan de la boca de Shizuku. Esa reacción me permitía saber si el\nlugar donde tocaba era una parte sensible.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que esto está tan mojado?...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"bg",file="ev_shz_h06_12",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000937",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Ahhhn?! Ah, ahh... ha, Jaa, ahn, ngh, mmm...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"El tono de su voz va haciéndose más fuerte. Parece que es sensible acá.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_szd_000938",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Haai*, N-Naoya, no. Jaa, jaa... Tus dedos... incre, íble... ngh, se siente,\ngenial... Ah, no... ah, auuhh, ¡¿haiiin?!”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*biku*, *biku*!!",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Las caderas de Shizuku tiemblan.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_szd_000939",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hyuuh, ¡¿a-ahhh?! Gen-- ngh, se siente increíble, tus dedos, donde me tocas, se\nsiente muy bien... ¡¡Ahn, auh, ah, ahhh!!”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Jugos vaginales chapotean y salen volando de la vag*na de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_szd_000940",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahhn, ah, ahh, ah, kuh... Jaa, jaa, ah, kuh, ah, ah, ahn, ah, ah, ¡¿akkuhhh?!”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Su cuerpo comienza a temblar cada vez más.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_szd_000941",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“N-Nooo... m-me... m-me, vengo, me vengo de nuevo... y es más intenso, que hace\nun rato... *ahiii*.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema... córrete...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_szd_000942",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, no, no, ya no puedoooo, me, me... ven, gooo....... ¡¡¡¿Mm?!!!”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Con todo su cuerpo temblando, Shizuku gritó.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_shz_h06_13",sync=1,time=1000,vague=100,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000943",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡¡¿¿Fwaaaaahhhhhhh??!!!”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_szd_000944",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... -- kuh... uhn.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Sus temblores no paraban aún.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"La abrazo.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo hice muy intenso?”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"bg",file="ev_shz_h06_15",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000945",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, no es eso... Aunque, por un momento pensé que no podría volver...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no podrías volver?”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="fem_szd_000946",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, entre tanto placer...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... aunque, lo que viene ahora no será solo placer...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_szd_000947",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Shizuku asiente con un pequeño movimiento.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_szd_000948",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero quiero unirme contigo en cuerpo... así que... me gustaría, que lo\nhicieras...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"bg",file="ev_shz_h06_14",sync=0,face=1,time=400,path=":ev/ev_shz_h06/",set="ev_shz_h06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000949",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Shizuku responde con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Y abrió sus piernas un poco, como dándome la bienvenida.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Me hago espacio entre esa abertura.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_szd_000950",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"bg",file="ev_shz_h08_01",path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"text"},
text={
ja={
{
"Sus piernas se abren aún más.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Y entre la pena, la cara de Shizuku se sonroja todavía más.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, voy a meterlo...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_szd_000951",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Tomo mi miembro y lo aprieto contra las partes privadas de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Eh.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"No sé dónde está la entrada.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Es común ver que mencionen en los libros el problema de equivocarse de entrada,\npero no pensé que fuera tan difícil encontrarla.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="fem_szd_000952",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Naoya?”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm... ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_szd_000953",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esto...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Shizuku toca mi miembro.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"Y lo guía con sus dedos.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="fem_szd_000954",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Creo... que es aquí. Si hundes tus caderas... entrará...”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
"Hundo la punta de mi miembro en la zona que Shizuku me indicó.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_szd_000955",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, nghhh...”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"Shizuku intenta controlar su voz.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"Los alrededores de la cabeza de mi miembro van sintiéndose cada vez más\ncálidos.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="fem_szd_000956",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Hiiinn*...”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"bg",file="ev_shz_h08_02",path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"text"},
text={
ja={
{
"Hasta que finalmente, una cálida y viscosa sensación la envuelve por completo.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_szd_000957",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Pudo... entrar un poco?”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sí. Aunque todavía necesito que aguantes un poco más.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
vo={
{"vo",file="fem_szd_000958",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, está bien...”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy...”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000959",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*Giii*... Ngh, ¡¡¿a-ahhh?!!”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Poco a poco el cuerpo de mi miembro va envolviéndose también en esa cálida\nsensación. Aunque al mismo tiempo, Shizuku soltaba unos adoloridos quejidos.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Estás bien, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_szd_000960",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡*B-Bi!",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"Por alguna razón, Shizuku estaba haciendo una seña de la paz.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé cómo tomar esa seña...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_szd_000961",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es que... me siento muy feliz. Así está bien...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Aun así no le veo mucho sentido a esa seña...",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"――*zppphh*...",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000962",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡¿Hyauun?!!”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"Mi miembro entró por completo dentro de ella.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"bg",file="ev_shz_h08_03",path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000963",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Ya entró todo?”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... todo...”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_szd_000964",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí?... Me alegro. Me alegro, de poder tenerte por completo, dentro de mí...”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se siente tan cálido, dentro de ti, Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_szd_000965",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto, estás dentro de mí... Naoya, tú también... ngh, está... tan\ncaliente.”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_szd_000966",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Está caliente, y bastante duro...”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
vo={
{"vo",file="fem_szd_000967",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así que, está bien ya... ya puedes moverte...”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="fem_szd_000968",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya viste lo mojada que me puse, no hay de qué preocuparse.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_szd_000969",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es más grande la felicidad de unirme en cuerpo contigo, Naoya. De hecho ya no\nduele tanto...”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Vaya que sabe decir cosas que me alegran.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, comenzaré a moverme lentamente...”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_szd_000970",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"Comencé a mover lentamente mi cadera.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_szd_000971",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kufuuh... ngh, ay, hauuh, kuh...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Entro y salgo lentamente de la vag*na de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
ja={
{
"――*nchhh*... *nchhh*...",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
"Y entre cada movimiento se escucha un erótico sonido.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este sonido... es, increíble cómo suena...”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="fem_szd_000972",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... kufuuh... ngh, suena así, porque estoy disfrutándolo...”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo. ¿Crees que pueda entonces mover un poco más mis caderas?”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="fem_szd_000973",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh... sí, está bien. Puedes moverte un poco más.”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Sin poder resistir a esas palabras, muevo aún más las caderas.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
"――¡*schhh*, *schhh*, *schhh*!",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
"Los lascivos, húmedos sonidos toman aún más fuerza.",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000974",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Haaiih?! Ah, ah, auhh, kufuh...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te duele?”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
vo={
{"vo",file="fem_szd_000975",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hii, ah, ahhh... e-estoy bien... Duele, pero... Jaa, uh, Jaa... ah, ah, ahnn,\nahn, ¡ahn, ahn, ah, ah, ahh!”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000976",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haiih, kufuuh... ngh, ahn, aahnn, aiiih, c-creo que, el placer es... haiih...\nmás fuerte...”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, se siente tan bien...”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
vo={
{"vo",file="fem_szd_000977",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿N-Naoya, se siente bien estar dentro de mí?”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... se siente, espectaculaaar... kuh.”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"――¡¡*nchh*, *nchh*, *nchh*...!!",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Entre cada movimiento de mi miembro chorrean viscosos fluidos de ella, soltando\nun particular sonido.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
vo={
{"vo",file="fem_szd_000978",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kufuh... auhh, N-Naoya, yo... a-auh, auhh, hiinh... y-yo también, me siento...\nbien...”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo dices en serio? No mientas, aún te duele, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_szd_000979",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No...”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"se",file="se9010",vol=80,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku me abrazó fuertemente.",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
"Nuestras pieles empapadas en sudor se adhieren una con la otra y se rozan.",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_szd_000980",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoyaaa... te, amoooo...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... agh...”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
vo={
{"vo",file="fem_szd_000981",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, puedo, sentirte bastante, dentro de mí...”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000982",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Auh, ah, ah, ah, ahh... ahn, ahn, ahn... ah, ahaa,fuh, jaa... ¡¿Aaahhh?!”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"Shizuku me abraza con aún más fuerza.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
vo={
{"vo",file="fem_szd_000983",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, mm, nghh... muy bien... se siente, muy bien... kufuhh... ngh, ahn, ahn,\nahhh, haiih... Tu pe*e, se siente bien adentro... tan bien...”",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
vo={
{"vo",file="fem_szd_000984",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Siento como entra y sale... siento todo... todo tu cuerpo... ngh... ¡¡Nggghhh!!”",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también estoy disfrutándote con todo mi cuerpo, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
vo={
{"vo",file="fem_szd_000985",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué feliz soy ahora...”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"Shizuku me sonríe. Sin siquiera pensarlo, la besé.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="fem_szd_000986",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, mmm...”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
"Unimos nuestros labios, y luego casi naturalmente abrimos nuestras bocas y\nenlazamos nuestras lenguas.",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="fem_szd_000987",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, ngh... *chuu*... ngh, *chu*, *chu*...”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
vo={
{"vo",file="fem_szd_000988",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Nm, ngh, nm, *chu*, *shpp*... ngh, *chu*!”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
vo={
{"vo",file="fem_szd_000989",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahn... ahn... a-ahh... ahn, ah, k-kufuh...! A-Ah, ahh... ahn, ahn... ¡¡Naoya,\nte amo, te amooo!!”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
ja={
{
"Shizuku me abraza y me toma no solo con los brazos, sino también poniendo sus\npiernas alrededor de mi cadera.",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
"Si no me falla la memoria, a esto le llamaban leg-lock...",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
"Debo admitir que se siente excepcionalmente bien...",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
ja={
{
"Es increíble lo mucho que se siente el calor del otro en esta posición.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuh, jaa, jaa!”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
vo={
{"vo",file="fem_szd_000990",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... más... adentro.”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Adentro? ¿No te duele?”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
vo={
{"vo",file="fem_szd_000991",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Al contrario, se siente genial cuando lo metes hasta el fondo... penétrame,\nhasta el fondo de mi vag*na... te lo ruegooo... ¡Ahhn!”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
vo={
{"vo",file="fem_szd_000992",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué será?... Se siente mucho mejor cuando lo metes hasta el fondo...”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quizás es porque es en ese instante que estamos más conectados?”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
vo={
{"vo",file="fem_szd_000993",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, te puedo tener más cerca de mí cuando lo metes hasta el fondo... Y por eso\nhe estado caliente adentro desde hace un rato...”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así está bien?”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000994",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngah, s-sí, así... estás tocando, mi zona más sensible... ¡¿Nghhh?!”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
ja={
{
"Embisto con mis caderas a Shizuku y la estimulo por el fondo de su vagina.",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
vo={
{"vo",file="fem_szd_000995",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngh, sí, ahí... ¡¿Ahhh?! ¡¡Se siente, increíble...!! ¡Naoya, tu pe*e llega,\nhasta lo más profundo!”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
vo={
{"vo",file="fem_szd_000996",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, ah, ahh, no, no puedo más, ¡¡e-estás llegando, a mi parte más sensible!!\nAuh, e-estás llegandooo, ah, ah, ah, ahh, nghh... ¡¡¿Ah, kuh?!!”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
"El rostro de Shizuku se contorsiona en placer. Ataco con fuerza sus partes\nsensibles.",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
vo={
{"vo",file="fem_szd_000997",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahn, ahn, ahn, ah, ah, ah, ah... no, no, si sigues dándome ahí... ¡¿Ahnnn?! Se\nsiente, tan bien...”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene, de malo, entonces?...”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
vo={
{"vo",file="fem_szd_000998",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Puede, que me venga, de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Sientes que te vienes por dentro?”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
vo={
{"vo",file="fem_szd_000999",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“N-No lo sé, pero... la sensación, se parece, a la de hace un rato...”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Seguiré entonces. Se siente tan bien dentro de ti, que en cualquier\nmomento, me podría correr...”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
vo={
{"vo",file="fem_szd_001000",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? ¡¿Hauuh?! Ahnn... ahn... ahn, ahn... ngh, lle, llega hasta el fondooo...\nngh, ¡¡Ahhnn!! ¡¡Ah, ah, ahh... akuh, kuh, nkuh!!”",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001001",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Higuh, hih, ah, ahk, ahh?! Viene, me vengo, no, no... Jaa, jaa, uh, uh...\nhii.”",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"――¡*schh*, *chu*, *chu*!",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila... yo tampoco, aguantaré mucho...”",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
ja={
{
"La sensación del interior de Shizuku superó toda mi imaginación, y estaba a\npunto de llegar a mi límite. Y por eso estaba ahora penetrando sus zonas más\nsensibles.",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
ja={
{
"Entre cada estocada de mi miembro Shizuku hacía temblar su pequeño cuerpo,\ndejando escapar extasiados gemidos.",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001002",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Ayhhh?! ¡¿Ahh?! Ahn, n-no... ngh, ngh, ngh... ¡¡Ah, ah, ahh...!! N-No puedo,\nmás... Jaa, jaa... m-me vengo... vengo.”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
ja={
{
"――¡*chhh*! ¡*chhh*! ¡*chhh*!",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001003",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡Ay, ah, ah, ah, ahh!! No, no puedo máaas... me vengo, vengo, ven--, ngh...\n¡¡¿Ahhh?!!”",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Agh, yo también!...”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_shz_h08_04",sync=1,time=1000,vague=100,path=":ev/ev_shz_h08/",set="ev_shz_h08"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001004",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¡¡¿¿KgwaaAAaaaHhhh~~~~~~~~~~~~~~~~~??!!!”",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
ja={
{
"――¡¡*biku* *biku*!!",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
ja={
{
"El cuerpo de Shizuku dio un gran salto.",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"text"},
text={
ja={
{
"Y justo en ese instante――",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya no... ¡¡Yo también... me vengo!!”",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"bg",id=9,lv=9,sync=1,time=500,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=500,alpha=0,file="white",path=":bg/"},
