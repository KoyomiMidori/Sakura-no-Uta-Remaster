astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg043c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, regresemos a casa.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000678",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me muero de hambre. No puedo esperar por regresar a casa.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más expectativas que tengas, mientras yo esté aquí nadie va a hacer los\npreparativos de la comida.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000679",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué?! ¡¿Aunque regrese a casa no habrá nada?!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no es obvio? ¿Quién crees que se encarga de preparar siempre la comida?...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg037c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ya no vives por Sakuragahara, eh...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000255",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Así es, pero ¿cómo es que sabes eso, Kusanagi-kun? No recuerdo haberte\ndicho aún...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? A-Ahh... tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000680",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sakuragahara queda por acá cerca, ¿no? Cerca del edificio de Naoya.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, así es... Por cierto, Rin, ¿dónde vives ahora?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000256",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, vivo ahora en Kootoha.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kootoha...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000257",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada. Ahora que lo recuerdo, hace bastante tiempo también viviste\npor Kootoha, eh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000258",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000681",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Si es Kootoha, entonces no estarás cerca de mi casa? ¿Eso quiere decir que tú\ntambién vas en tren, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000259",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000682",ch="ked"},
},
ja={
{
name={"Kei"},
"“Entonces puedes regresar con Naoya.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000260",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Pero, Kusanagi-kun no vivía en su apartamento de Sakuragahara?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000683",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahora está viviendo en mi casa por Kootoha.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000261",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad? Pero ¿por qué?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0019",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000684",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya es un hombre que vive solo, ¿no? Hay muchísimas cosas que no puede hacer\npor su cuenta, así que se está hospedando en mi casa.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿NO SON LOS NATSUME LOS QUE NO PUEDEN HACER NADA POR SU CUENTA?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000685",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Bien, yo me voy en motocicleta! Ustedes dos pueden regresar a casa mientras\nson suavemente bamboleados por el tren.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000262",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien. Gracias por hoy.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"msgoff"},
{"se",file="se1135",id=1},
{"fg",ch="圭",sync=1,mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Después de mostrar una radiante sonrisa, Kei se fue corriendo hacia el\nestacionamiento de bicicletas mientras se despedía de nosotros moviendo su\nmano hacia los lados.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Nosotros tomamos el camino opuesto a Kei y bajamos por la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="black",path=":bg/"},
{"se",vol=30,id=1,file="se1666"},
{"fg",mode=-2,sync=0},
{"bg",file="bg019c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000263",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento tanto por hoy...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000264",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es que, te obligué a que me enseñaras a pintar...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no te preocupes, además yo también me divertí. No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0010",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000265",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era broma lo de la deuda, no te lo tomes a pecho.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que casi nunca tengo oportunidades de involucrarme con pinturas,\nasí que me divertí.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"se",stop=1,time=500,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000266",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Si es así, entonces me alegro. Pero parece que realmente estás\ncansado, ¿no? Estuviste todo el tiempo pendiente de mí, ayudándome con varias\ncosas.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estabas en un entorno al cual no estás acostumbrada, es natural que te ayudara.\nPero aun así me divertí. Tal como Kei lo dijo, si no me divirtiera no te\nenseñaría.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué tal la pasaste tú?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000267",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Yo? Por supuesto, yo también me divertí. ¡No hay manera de que no me\ndivirtiera!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Para serte sincero, pensé que habías anunciado tu entrada al club por\nhaber leído la atmósfera alrededor...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000268",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por haber leído la atmósfera... alrededor?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pensé que te habías dado cuenta de lo que Toritani pretendía.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000269",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que no. Fui yo quien en principio le dijo que quería entrar al\nclub.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Si es así, pues, está bien... Hubiera sido lamentable que lo\nhubieras hecho por dejarte llevar por la corriente.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0005",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000270",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kusanagi-kun, esa es la imagen que tienes de mí en tus recuerdos? Pero, yo no\ntomo esa clase de decisiones dejándome llevar por los demás.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000271",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Desde que regresé a Yumihari siempre he querido pintar.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Desde que regresaste a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000272",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, no sé por qué, pero desde que me alejé de la ciudad siempre he querido\nhacerlo... He querido tomar el pincel en mano en esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Ha querido tomar el pincel en mano en esta ciudad... eh.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Los ojos que me ven son los mismos que hace tiempo.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Ella es cordial con todos, amable, y con una voluntad más fuerte que todos.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Así son los ojos de ella.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No has cambiado nada. Supongo que era de imaginarse...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000273",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"El tren está por llegar a la estación más cercana a Kootoha, Utaki.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bg",file="black",path=":bg/"},
{"se",file="se9012",id=1},
{"bg",y=80,x=-160,zoom=100,speed=300000,file="zbg030c",path=":bg/",z2=50,x2=0,y2=-20,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2c0200",face="c0001",head="rin_z2c",x=240,y=40,lv=5,id=6,sync=0},
{"extrans",time=300,sync=0},
{"cgact",stage="zbg030",y=100,act="びっくり",loop=-1,size=1,time=800},
{"fgact",ch="稟",act="びっくり",loop=-1,size=3,time=700,lv=5,id=6},
{"text"},
text={
ja={
{
"Caminamos juntos la vía de noche.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"No hay mucha conversación entre los dos. O más bien, no hay casi palabras.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Caminamos juntos la vía de noche.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y entonces, Rin se paró de repente.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="bg030c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000274",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000275",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé en... que este parque aún existe.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Parque?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000276",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, este parque de roble.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Parque de roble? Ahh, sí, hubo una época en que lo llamaban así.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000277",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ya no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Ese roble lo cortaron y ya no está.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000278",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahora que lo mencionas, ya no está ese árbol...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Apenas te fuiste de la ciudad lo cortaron.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000279",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sabía...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Observo la placa de la entrada que nunca me preocupé de ver hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"En la placa de la entrada del parque estaba escrito claramente 'Parque infantil\nKootoha'.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"se",file="se9004",id=1},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Entro al parque sin decir una sola palabra.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Y al instante, Rin me sigue.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000280",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los columpios...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000281",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Nos sentamos?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es mala idea.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Los dos nos sentamos en los columpios, bajo la noche.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_uni_c15_01",path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"bgm",file="bgm040"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000282",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se volvió hermoso, ¿no? Este parque.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Este parque, existente ya desde hace bastante tiempo, fue reformado ahora.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000283",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cambió por completo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque ya ha pasado bastante tiempo desde entonces.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000284",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es algo misterioso. A medida que pasa el tiempo, la ciudad va cambiando y\nreformándose.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es difícil ver los cambios cuando vives en ella, pero ahora que lo mencionas,\nes fácil darse cuenta de todas las cosas nuevas que hay alrededor.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000285",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de que yo o las personas que vivían allí o allá vamos envejeciendo, la\nciudad va reformándose cada vez más.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000286",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de que va cambiando, no cambia...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000287",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A veces deseo que no cambie... Pero igual lo va haciendo. A pesar de ser el\nmismo paisaje, es un paisaje distinto.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000288",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de ser un lugar distinto al de los recuerdos, uno sabe que se trata de\nese mismo lugar.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco ha cambiado tanto. Era obvio que te dieras cuenta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000289",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? En lo personal, me da la sensación de que ha cambiado por completo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000290",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre he pensado en esta ciudad... Quizás solo se trate de eso.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tus recuerdos fueron idealizándose?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000291",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es cierto. Yumihari es un lugar tan bueno que no es capaz de perder\nincluso ante mis recuerdos.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es capaz de perder incluso ante tus recuerdos...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Veo hacia arriba y contemplo el cielo nocturno desde el columpio.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Las estrellas que adornaban el cielo de la noche iluminado por la ciudad tenían\nun brillo tenue.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"¿Este escenario habrá cambiado también?",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"¿Será el mismo que aquellos tiempos?",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, te veías un tanto desconcertada en el instante que\ntomaste el carboncillo en tus manos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000292",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh ¿A-Así me vi? No me dio esa impresión, pero... ¿sí parecía estarlo?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te veías rara, o más bien, como si hubieras sentido algo al agarrar el\ncarboncillo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000293",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, tienes una percepción bastante aguda.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí sentiste algo?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000294",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad es que ni yo misma lo sé. Fue como si lo hubiera, o tal vez no\nhubiera algo. Solo que, de cierta manera, la textura del carboncillo al\ntomarlo era única y peculiar...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000295",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de que se supone que es la primera vez que tomo carboncillo en mis\nmanos.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, no importa entonces. De ahora en adelante usa lápiz. Parece que tienes\nbuena afinidad con los lápices, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000296",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es la primera vez que uso lápices 3B. Sentí como si de verdad estuviera\nhaciendo arte.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, lo máximo que se podría ver en la vida cotidiana son los HB, y si es\npor algo más oscuro, los B. Esa clase de lápices tan oscuros solo se usan\npara dibujar.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000297",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Sentí como si realmente estuviera dibujando de verdad.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te ves feliz.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000298",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, lo estoy, y es porque comenzar algo nuevo es divertido.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Comenzar algo nuevo es divertido, eh...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Quizás tenga razón.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Observo a Rin.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Nuestros dos columpios estaban inertes.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, hace tiempo no podías montar ese columpio, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000299",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Eso fue algo repentino.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recordé el pasado.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000300",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uh, esto... es, un secreto.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Secreto? ¿Qué rayos?...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000301",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ajajaja... Me da pena decirlo. Aún no puedo montarlo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000302",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, ¿aún no puedes montarlo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000303",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje... Es porque soy torpe.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Torpe? ¿O tal vez demasiado recta?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000304",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será realmente... así?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hubo una vez que me pediste que te enseñara a montar el columpio.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000305",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Lo recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por supuesto, lo dijiste mientras hacías un mohín.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Primero hay que patear el suelo, ¿no? Pero cuando lo hago se para. Por más\nfuerte que pise, se para'. Eso dijiste.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000306",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Así de tonta fui?... Ajajaja, eso es vergonzoso.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y yo te dije, 'Algún día te enseñaré'.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000307",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Dijiste que algún día me enseñarías...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estuviste esperando a que lo hiciera?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000308",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no es eso. Solo pensé, ah, podría esperar a que Nao-kun me enseñe a\nhacerlo algún día. Simplemente eso.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000309",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero fue una de las pocas promesas que quedaron entre nosotros dos... De esa\nmanera lo veía yo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque pareciera ser algo bastante fácil de entender para ti ahora.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000310",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no lo entiendo. Las cosas que se mueven de un lado a otro se detienen\nsiempre en algún momento, y aún todavía esa duda no ha cambiado mucho para\nmí.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si sigues aplicando fuerza seguirá moviéndose.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000311",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero en el cielo no hay suelo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene nada que ver que haya suelo o no. No importa que no haya nada en el\ncielo. Solo tienes que moverte sin pensar nada. La cuestión está en no pensar\nde manera tan complicada.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000312",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No pensar de manera complicada...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, muévelo como siempre lo haces...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000313",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Como siempre?... Pero, desde ese entonces no me he montado ni una sola vez en\nun columpio.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, como hace tiempo... Móntate en el columpio como lo hacías hace\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000314",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Rin comienza a dar la primera pisoteada. Se veía como...",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Como si estuviera comenzando a caminar, como si comenzara a correr, como si\ncomenzara a saltar.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"De esa manera, Rin patea el suelo...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000315",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Al unísono con mi voz, Rin pisotea fuertemente el suelo.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",id=1,file="se1038"},
{"mwact",act="うなづく",size=5},
{"text"},
text={
ja={
{
"Rin patea el suelo, soltando un sonido como *ton*.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"El columpio comienza a moverse con buen impulso.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"se",id=1,file="buranko"},
{"bg",file="ev_uni_c15_02",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"ex",time=100,func="wait"},
{"bg",file="ev_uni_c15_01",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"ex",time=700,func="wait"},
{"bg",file="ev_uni_c15_02",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"ex",time=200,func="wait"},
{"bg",file="ev_uni_c15_01",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"ex",time=700,func="wait"},
{"bg",file="ev_uni_c15_02",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"ex",time=200,func="wait"},
{"bg",file="ev_uni_c15_01",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"text"},
text={
ja={
{
"Y de ahí, va lentamente perdiendo el impulso... y poco a poco su movimiento\nva tornándose lento.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Después de moverse ligeramente de un lado a otro, vuelve a pararse en su\nposición original.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000316",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se paró...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000317",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sirvió de nada, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que sí. Vas siguiendo buen camino.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000318",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000319",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero se paró.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se paró, eh.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000320",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de que incluso un niño de preescolar puede mantener un columpio en\nmovimiento, aun siendo yo una adulta no soy capaz de ni siquiera moverlo.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acabas de decir que no puedes mover el columpio, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000321",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que no puedes moverlo. Simplemente no estás moviéndolo, Rin.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Rin creía que aunque pataleara en el aire, el columpio no se movería...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Ciertamente, es algo descabellado pensar que se puede acelerar pataleando en el\naire.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Pero, normalmente no se piensa.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Los niños normales se montan en los columpios sin pensar nada.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Sin realmente entender la dinámicas del columpio y como este adquiere impulso.\nSimplemente mueven sus cuerpos como lo sienten en el momento.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"'Si pataleo en el aire, podré acelerar con dirección hacia el cielo'",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Cualquiera acepta fácilmente ese extraño y misterioso fenómeno como un hecho.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazlo una vez más.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000322",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Las personas son impotentes en el aire.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Por eso es que el cuerpo sabe.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Sabe lo que tiene que hacer en ese momento.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ahí! ¡Patea ahora al aire!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000323",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, s-sí!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Rin patea al vacío.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="ev_uni_c15_02",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"text"},
text={
ja={
{
"Y con ese movimiento, comienza a acelerar.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000324",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La próxima hazlo justo en el mismo momento!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000325",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_uni_c15_01",time=1000,path=":ev/ev_uni_c15/",set="ev_uni_c15"},
{"text"},
text={
ja={
{
"Rin comenzó a mover el columpio.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Gracias a las patadas al aire, su cuerpo comenzó a acelerarse.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000326",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Genial! ¡Cada vez va más rápido!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo demás lo sabe tu cuerpo, ¿verdad? Así funcionan los columpios.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000327",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí! ¡Genial! ¡Es genial!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bien, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000328",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000329",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Gracias!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000330",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Por enseñarme a montar el columpio! ¡Por enseñarme a pintar!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"quake",size=4,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000331",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Gracias!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, estás hablando muy duro...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Debajo de la luz de la luna.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Rin monta el columpio, como el péndulo de un reloj que comenzó a moverse.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Acelera por el cielo de la noche, alegremente.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Con tanto impulso que en cualquier momento pareciera que podría salir volando\nhacia ese mismo cielo.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
