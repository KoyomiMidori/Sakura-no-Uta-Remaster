astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c01_01",path=":ev/ev_eye_c01/",set="ev_eye_c01"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, quizás debería limpiar un poco...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tenía la impresión de que era un apartamento relativamente amplio, pero...\nbasta con meter algunas cosas de papá para que se vuelva bastante angosto.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Dejo en la sala el caballete que traje ayer.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Por supuesto, es imposible que un simple caballete haga que la sala se sienta\nangosta.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Aparte del caballete, y por alguna razón, hay varias cosas relacionadas con\nKenichiro Kusanagi acumuladas en esta habitación.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"A pesar de que fui despojado de los derechos de herencia, me han enviado\nincluso cosas que parecen basura, aún sin mi consentimiento.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Probablemente personas relacionadas con papá han venido enviando todas estas\ncosas acá, sin saber que renuncié al derecho de herencia.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Qué molestia son.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"¡Si van a equivocarse enviando algo, que sea dinero!",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería tan bueno si fuera dinero...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Tomo en mis brazos un pequeño y misterioso paquete que llegó hace poco, y\nsusurro eso.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No he revisado lo que hay adentro del paquete misterioso, así que no sé qué\nhay, pero es seguro que no se trata de dinero.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Además, tiene escrito 'Necesita refrigeración'...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Necesita refrigeración, eh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Al abrirlo, por alguna razón, había una carne de puerco para shogayaki adentro.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿También estaba incluido esto dentro de la herencia de Kenichiro Kusanagi?...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"En fin, lanzo eso al refrigerador.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"No hay valor alguno en cosas que no sean dinero.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Bueno, no, por supuesto que también los alimentos son relativamente valiosos,\npero... Si hablamos de la fortuna de Kenichiro Kusanagi, el asunto es\ntotalmente distinto.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Después de soltar un largo suspiro, contemplo el caballete que traje ayer de la\nsala de arte.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Si vendo esto, seguramente podría hacer un buen monto de dinero, eh...",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Se ve además que tiene valor...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Y mientras pensaba eso, de repenté recordé lo de ayer.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Aquel momento en que tomé este caballete y bajé la colina del colegio.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Vi un panorama bastante enigmático.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Los árboles de cerezo crujieron y sonaron.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"En el instante en que pensé eso, una chica apareció, y luego desapareció junto\ncon el viento...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Como si hubiera sido secuestrada por los cerezos...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",id=1,file="se2340"},
{"bgm",vol=0,file="bgm004"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="ev_com_a07_02",path=":ev/ev_com_a07/",set="ev_com_a07",sync=0},
{"extrans",rule=179,time=200},
{"ex",time=200,func="wait"},
{"colortone",style="reset"},
{"bg",rule=179,time=200,file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",vol=100,file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe haber sido una ilusión, un fantasma o un extraterrestre.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Me da fastidio pensar más en eso, así que decidí arreglarlo todo con esa\nconclusión.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"El cerebro de los humanos tiene el mayor consumo calórico de entre todas las\nespecies animales.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Dicen que el cerebro humano solo ocupa un 2 % del peso total del cuerpo humano.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"¡Sin embargo, su consumo calórico es nada más ni nada menos que 10 veces su\npeso! ¡Cerca de un 20 %!",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"En pocas palabras, 'pensar' es algo que gasta una descabellada cantidad de\ncalorías.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Es decir, esa acción llamada 'pensar' hace que nos de hambre.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Por lo tanto, con usar un poco la cabeza me da hambre.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Tengo hambre.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya organicé bastante esto.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",file="se9002",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",rule="083r",vague=40,file="bg021a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",id=2,file="gatya"},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"se",stop=1,id=2,time=500},
{"bg",rule="083r",vague=40,file="bg020a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Tomo mi billetera y salgo de casa.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Hoy trabajé bastante.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Así que no debería haber problema con que me dé un lujo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"No tengo dinero, pero no está mal que me de mis lujos de vez en cuando.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy vamos a darnos un festín con algo de Gyuudon.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien... ¿Qué Gyuudon de qué restaurante debería comer?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Y aunque piense eso, mis pies apuntan, después de todo, hacia el mismo lugar.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Pongo mis manos sobre la puerta del café. Al lado hay un letrero parado,\nescrito con letras negras.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Café Quimera...",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Es un restaurante extraño, pero los platos son deliciosos, Encima, los\nprecios son bastante baratos. Y además, el repertorio es bastante amplio.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"El interior de la tienda está decorado de una manera bastante sobria y\nrelajante, y hay, además, un rincón de venta para los granos de café y tazas\nque se han reunido de todo el globo.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Debido a que el mismo maestro se encarga de buscar directamente los granos de\ncafé, parece que por lo general casi nunca está acá.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bgm",stop=1,time=500},
{"cgdel",id=-1},
{"se",id=1,file="se2225"},
{"bg",file="ev_com_a08_01",path=":ev/ev_com_a08/",set="ev_com_a08"},
{"bgm",file="bgm030"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a08_02",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
},
},
text={
vo={
{"vo",file="fem_mkd_000001",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienveni... ah, pero si es Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000002",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De nuevo acá? Por Dios, quisiera que me devolvieras el 'Bienveni', junto con\nel gesto de saludo que hice.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy un cliente. Aunque seas mi compañera de clases, trabajas aquí, así que es\nnatural que bajes la cabeza ante mí, ¿no? Y, por lo menos termina de decir\n'Bienvenido' antes de pedirme que te regrese el saludo.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000003",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cliente, eh...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Su actitud arrogante hace que no parezca la misma persona que me saludó con esa\nsonrisa laboral apenas entré. Esta mujer se llama Makoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Lleva un vestido tipo Maid, pero obviamente, no es una de verdad. Asiste, al\nigual que yo, al colegio Yumihari, y es mi compañera de clases. Trabaja de\nmedio tiempo en el Café Quimera.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"user",mode="conf",ch="真琴"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000004",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno, si de verdad pagas entonces no me importará otorgarte unos cuantos\ngestos encantadores y corteses de empleada. Pero no soy tan buena persona\ncomo para darle servicio a una persona que vino a mendigar.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-A mendigar?... H-Hoy no vine a mendigar por cortezas de pan. Hoy vine como\nun cliente de verdad, hecho y derecho.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000005",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿en verdad? Pensé que vendrías hoy también a pedir cortezas de pan.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Últimamente no he venido a pedir, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Ciertamente, en aquellos períodos durante los cuales se me hacía\nparticularmente difícil sobrevivir, varias veces vine a recibir alimento de\neste restaurante, pero.... tampoco fueron tantas veces... creo...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_a08_02",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000006",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En las panaderías normales la corteza de pan se vende como un producto más. Así\nque, básicamente, es más bien raro que pienses que debes recibirlas de\ngratis.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... bueno, no puedo negar eso...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Ciertamente, quizás fui demasiado confianzudo en ciertos aspectos solo porque\nse trata del lugar de trabajo de Toritani.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a08_01",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
},
},
text={
vo={
{"vo",file="fem_mkd_000007",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, bueno, hoy viniste como cliente, ¿no? Entonces te haré un servicio\nespecial. ¿Quieres que te lance una sonrisa? Una enorme y radiante sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No necesito ni un poco tus falsas sonrisas laborales.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000008",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No? Aunque también le pongo corazón a mis sonrisas laborales...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya desde el momento en que se trata de una sonrisa 'laboral', se vuelve\nfalsa...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a08_01",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
},
},
text={
vo={
{"vo",file="fem_mkd_000009",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque eso depende del cliente, eh... Pero bueno, no importa. Oye, oye,\nKusanagi, ¿qué servicio te gustaría recibir entonces de mí?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tus servicios no son la gran cosa. Dame el menú ya.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000010",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? Aunque pensé en levantarme la falda a manera de saludo...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"¿A manera de saludo? ¿Levantarse la falda?",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"¿Es en serio?",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000011",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, ¿como que cambió tu expresión facial?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es nada realmente, pero... ¿a qué te refieres con levantar?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000012",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso de levantarse uno mismo la falda. ¿No es acaso usual hacerlo con trajes de\nmaid?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿E-Este restaurante tenía esa clase de servicio?!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_a08_04",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000013",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué sucede? No pensé que reaccionarías inclinando el cuerpo hacia adelante\ncon tanto interés.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, realmente no es nada. Solo que no sabía que el dueño obligara a las\nchicas de medio tiempo a ofrecer esos servicios...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000014",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esos servicios no existen. Quimera es solo un café normal, y el dueño es muy\namable. Pero, bueno, ya te he causado varias molestias en otras ocasiones,\nasí que pensé que no estaría mal hacerte un servicio especial hoy.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh... y-ya veo...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Ciertamente, lo único que ha hecho Toritani es causarme molestias, pero... no\npensé que estuviera consciente de eso...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000015",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿Qué harás?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿H-Hacer de qué?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_a08_01",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000016",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El servicio especial.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿C-Con servicio especial te refieres a la levantada de falda?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000017",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, el servicio de levantada de falda.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese servicio de levantarse la falda es...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Levantarse la falda y mostrar las pantaletas, ¿no? Por más que se trate de\nalguien como yo, no hay manera de que le pida algo así a una compañera de\ncla――",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_a08_03",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000018",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no quieres, entonces no lo haré.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, espera, hazlo! ¡Sí, hashlo, pod favó'!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Me mordí la lengua.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Ah, digo, pues...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Si es un servicio entonces no hay problema con que lo acepte, ¿no? Después de\ntodo... es un servicio, ¿no es así?",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_a08_02",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000019",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... A-A pesar de que siempre te ves tan somnoliento y fastidiado, estás\nbastante animado ahora, ¿eh? Si tan solo tuvieras por lo menos la mitad de\nesos ánimos normalmente.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No me veo somnoliento y fastidiado todo el tiempo!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_a08_01",sync=0,face=1,time=400,path=":ev/ev_com_a08/",set="ev_com_a08"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000020",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me siento algo feliz de que reacciones tan animadamente a mi servicio. Bien, no\nhay ningún otro cliente alrededor, así que, prepárate para recibir un\nservicio único de todo el siglo...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vale...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Toritani toma el borde de su falda. Si sube un poco más el borde, saldrán a la\nvista sus piernas ocultas por la tela de la falda, y, si sube más y más, se\nverá esa tierra prohibida, esa zona triangular...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",time=450,file="white",path=":bg/"},
{"mwact",act="ジャンプ"},
{"text"},
delay={
[100]={
{"se",file="se9032",id=1},
},
},
text={
ja={
{
"Suavemente.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Ligeramente.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"El borde de la falda de Toritani se sube solo un poco, y luego me saluda con\nuna sonrisa.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000021",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienvenido, Naoya Kusanagi-sama.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Sin quererlo, pensé que se veía un poco linda.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Su actitud era completamente distinta a la arrogante y despectiva actitud que\ntenía hace un rato conmigo. Y su sonrisa era también ligeramente diferente a\nla sonrisa que tenía al principio.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Pero ese no es el problema.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡No lo es!",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000022",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no sé cómo responder a esa pregunta.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000023",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, lo hice con la intención de darte el servicio del siglo. ¿No te agradó?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, pues ciertamente sí fue bueno, pero... Pero eso de levantarse la\nfalda... ¿Por lo general a eso no le llaman 'reverencia'?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000024",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? ¿Le llaman reverencia?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, las reverencias son saludos originarios de Europa. Existen desde hace\nbastante tiempo...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000025",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces no hay ningún problema, ¿no? ¿O qué? ¿Fue distinto a lo que te estabas\nimaginando?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No... realmente no...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"En términos rigurosos de diccionario, 'levantar' o 'recoger algo hacia arriba'\nno implica levantar la tela hasta que se vea la ropa interior. El término\n'recogerse las mangas' lo explica todo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Y además, Toritani dijo que sería un 'saludo'. El uso de la palabra, al igual\nque sus acciones, fueron totalmente correctas.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000026",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto es un saludo formal, ¿no? Traté de darte el más formal trato posible como\ncliente.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, c-ciertamente, pero... me dijiste que te ibas a levantar la falda, así\nque...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0910",face="d0013h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",time=200,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000027",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te dije que me levantaría la falda? ¿Qué estás diciendo? ... ¡¡Espera, no\npuede ser que tú--!!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, no, no es eso!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0018h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000028",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Uhh.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Toritani jala rápidamente el borde de su falda hacia abajo. Y entonces echó la\ncabeza hacia abajo. No logro ver la expresión de su cara.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"¿Se habrá enfadado?",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0016",head="mak_z1d",lv=4,id=9},
{"ex",time=800,func="wait"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000029",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puh.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puh?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0004",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"fgact",ch="真琴",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000030",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajajaja, por Dios, aún dándotelas siempre del tipo frío y reservado se te\nocurren esas cosas tan estúpidas. Kusanagi, no me lo esperaba tanto esto.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Insultos y reproches...",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Estaba preparado mentalmente para recibir eso, pero...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Toritani se estaba riendo fuertemente.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0004",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"fgact",ch="真琴",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000031",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, me dio tanta risa que se me empezaron a salir las lágrimas. Llevaba tiempo\nsin reírme tanto.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000032",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me alegra que a alguien como tú que reacciona siempre como si estuviera medio\nmuerto se le llenen los ojos de expectativa, pero no pensé que estuvieras\npensando eso, ajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000033",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Levantarme la falda delante de ti, mostrar mis panties y saludarte? ¿Y-Y? ¿De\nqué manera esperabas que lo hiciera?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No es que esperaba que lo hicieras de una manera u otra, solo que...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
},
vl03={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0004",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000034",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Esperabas que me levantara la falda y dijera 'Mi amo, observe la ropa interior\nde Makoto, por favor' o algo así?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhh.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0001",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000035",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que esas palabras tuyas fueron... un poco eróticas.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"se",file="se3130",vol=50,id=1},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000036",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000037",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué quieres decir? ¿Será que te refieres a la parte de 'Mi amo, observe la\nropa interior de Makoto, por favor'?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000038",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿R-Reaccionaste aun con esa parte?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000039",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La verdad es que quisiera que usaras ese poder imaginativo tuyo en algo más\ncreativo, y no en esos ridículos delirios.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Toritani estaba tan en lo cierto que me daba vergüenza.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000040",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no me parece tan malo ese lado tuyo tampoco. Pero eso fue un tanto\ninesperado. No pensé que fueras capaz de esperar ese tipo de cosas de mí.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Kuh... No encuentro manera alguna de contestarle nada.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Sin duda alguna, y sin quererlo, malentendí las cosas pensando que 'Levantarse\nla falda = Mostrar las pantaletas'.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que tuve un malentendido un tanto vulgar... Lo siento, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0016",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000041",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De qué te estás disculpando? Vamos, no importa, eso demuestra que eres un\nmuchacho sano.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000042",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me divierte enterarme de que incluso alguien como tú es capaz de tener un\nmalentendido tan idiota. Realmente no estoy enojada por eso.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0004",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000043",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Más bien me pareció cómico ver cómo se te ponía la cara como un tomate. No\npensé que incluso tú podías poner esa cara.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No se me puso la cara tan roja así...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0016",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000044",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Piensas que no? ¿Quieres que te traiga un espejo? Está completamente roja.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No necesito eso!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000045",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajajaja... Aunque, bueno, es vergonzoso para los dos hacer cosas a las que no\nestamos acostumbrados, supongo.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para los dos?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Al escuchar eso, me pareció ver la cara de Toritani ligeramente coloreada de\nrojo.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008h",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000046",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por andar diciendo cosas tan raras yo también me puse nerviosa. Ah, bueno, da\nigual. Vamos, la orden, la orden. Ya te di mi servicio especial, así que\nordena algo rápido.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Orden? ¿Podrías darme el menú entonces?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000047",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El menú? Kusanagi, ¿necesitas el menú para algo?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo necesito.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000048",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0900",face="d0001",head="mak_z2d",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani me pasó el menú, con un rostro un tanto dudoso.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"se",file="se2497",vol=60,id=1},
{"text"},
delay={
[500]={
{"se",file="se2497",vol=60,id=2},
},
},
text={
ja={
{
"Ojeo todos los platos del menú, comenzando por la primera página. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un gyuudon, tamaño normal.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0910",face="d0006",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0910",face="d0005",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000049",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo sabía! ¿Ves que no necesitas menú? ¡Jamás has ordenado algo distinto a eso!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Cállate. Estoy disfrutando de mi salida ocasional a comer. Déjame por lo\nmenos disfrutar del menú. Incluso esto es una amenidad para mí.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000050",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, creo que entiendo un poco cómo te sientes. Pero, existe algo que llaman\n'grado' para las cosas, ¿no? ¿Por qué lees el menú tan detenidamente? Piensa\nen todo el tiempo que me haces esperar acá parada.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás tengas razón, pero...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000051",ch="mkd"},
},
ja={
{
name={"Makoto"},
