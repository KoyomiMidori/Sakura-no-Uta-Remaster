astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm108"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hables con esa mujer!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001877",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero es verdad lo de que Kana-chan es nuestra amiga de la infancia...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no la conozco. No tengo ningún recuerdo de ella.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001878",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Puedo entender un poco eso...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entender un poco? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001879",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A mí también me sucedió lo mismo. Al principio estuve un tanto conmocionada. No\npodía creer que esa Nagayama-san se había transformado de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con 'esa Nagayama'? ¿Cómo era ella antes?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001880",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me parece que era una muchacha muy tranquila y silenciosa. Y además, su aspecto\ncambió también respecto a ese entonces. Ah, aunque es natural, ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo era de aspecto antes?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001881",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm. ¿Cómo podría describirla en detalle?... Llevaba gafas, creo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué más?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001882",ch="rnd"},
},
ja={
{
name={"Rin"},
"“También solía dibujar con frecuencia... Parece que le gustaba mucho dibujar. Y\ntambién es verdad aquello de que te observaba desde ese entonces, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me observaba a mí?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Dibujaba con frecuencia...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Tengo leves recuerdos de eso.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaba mucho más gorda que ahora, ¿no? Se supone que la forma de su cuerpo era\ncompletamente distinta.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001883",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tiene muy buena figura ahora, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"No hay duda alguna... Así que se trata de esa mujer...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Sí, su nombre era Nagayama...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que es esa Nagayama...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001884",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, no cabe duda alguna.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg083b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Estuvo persiguiéndome por un tiempo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y lo hacía además sin decir una sola palabra, lo cual era terriblemente\nirritante.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Recuerdo que de tanta exasperación, terminé reclamándole.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Y al ella escuchar lo que le dije, comenzó a llorar en medio del camino...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"En verdad no tenía la intención de hacerla llorar. Simplemente le pregunté\n'¿Qué demonios pretendes?'...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"¿Pero qué rayos? ¿Será acaso que se acercó a mí con fines de venganza?",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg020b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001885",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿te pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no pasa nada...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001886",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pienso que no es tan mala chica. Así que no la trates de forma tan severa, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna forma, no puedo actuar a la ligera con ella. No sé por qué, pero\nsolo siento cosas malas de ella...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001887",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Aunque sí es un tanto impulsiva, pero...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero, qué?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001888",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de lo tranquila y taciturna que era antes, ahora es atrevida y osada.\nCreo que puedo simpatizar con ella en eso.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Le llamas a eso ser atrevida y osada? Simplemente no lee la atmósfera a su\nalrededor.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001889",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque no me desagrada esa postura que tiene ahora, de hacer lo que sea por\ncumplir su objetivo.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Es todo lo contrario a ti.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001890",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Ni yo misma lo entiendo muy bien, pero siento que hay muchas cosas\nen las que simpatizo con ella...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No simpatices con esa mujer.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001891",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y además, estoy agradecida con ella también.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bgm",stop=1,time=2000},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001892",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, gracias a ella, estuviste agarrando fuertemente de mi mano todo este\nrato.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"bgm",file="bgm023"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, waaah.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001893",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede? No te exaltes tanto, por favor.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que, estuve apretándote la mano con toda fuerza por más tiempo de lo que\npensé... y además, en público...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001894",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estuviste. Y por eso es que le doy gracias, y más gracias.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Gracias y gracias un bledo, diablos...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"msgoff"},
{"bg",file="eveningsky_summer",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="znightsky_summer",id=9,lv=9,sync=1,path=":cg/",ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Rin me ayuda a estudiar.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Rin me explica de forma concisa y fácil de entender, pero... sinceramente, no\nestoy captando nada.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Siento que las mejillas de Rin están más rojas de lo normal.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Hoy sucedieron muchas cosas.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Sobre todo, aquello en la azotea...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="ev_uni_c40_01",id=8,lv=8,path=":ev/ev_uni_c40/",set="ev_uni_c40",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Para, para. No debo recordar eso.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Después de eso, las cosas se pusieron un tanto incomodas entre los dos, así que\nla invité a mi casa para refrescar un poco el aire, pero... sí, ciertamente\nse calmó bastante la incomodidad, pero a cambio de eso.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Las cosas no andan muy bien por otro lado.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Todo un torbellino de sucesos en estos pocos días.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"De nuestro beso, a la confesión...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"No, incluso antes de eso estaba ya perdiendo más y más el control de mis\npropios sentimientos.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"En primer lugar, ¿en qué momento fue que empezamos a vernos a solas ya\nsintiéndome yo de esta manera?... Y además, vaya que sorprende que no\nsucediera nada entre los dos hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Contemplo el perfil de la cara de Rin.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Sus visiblemente suaves y blancas mejillas.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Sus muy suaves labios.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"No. Esto no está bien.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Mierda, ando peor ahora por haber agarrado tan fuertemente de su mano hace un\nrato.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"¿Será que le doy fin de una vez a la sesión de estudio de hoy y la mando de\nvuelta a su casa?...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Si no hago eso, no sé qué demonios podría ser capaz de terminar haciendo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Comenzamos a salir formalmente como pareja a partir de hoy.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Si llegara a pasar algo entre los dos, sería demasiado pronto, eso pensando en\nlas etapas que una pareja normal debe seguir.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nunuh...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001895",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada. Ehm, traeré algo de café, ¿lo quieres con azúcar?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001896",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí, con azúcar y leche, por favor.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... realmente esto me saca de ondaaa...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Y pensar que hasta ahora hemos estado los dos a solas incontables veces...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Pero, desde esta mañana comenzamos a salir formalmente. En pocas palabras,\nestamos en una relación totalmente distinta a la que hemos venido llevando\nhasta ahora...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"se",id=1,file="kettle_boiling"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, hierve, está hirviendo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Sirvo el café y se lo doy a Rin.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001897",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waa, huele muy bien.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, es café molido, aunque de los baratos. Últimamente han vendido a precio\nmódico los paquetitos de una sola taza.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001898",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, realmente huele bien.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Sea lo que sea, me alegro que te guste.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001899",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podríamos comenzar con las lecciones de pintura ya?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahh, claro, sí, habíamos quedado en que te enseñaría a pintar también.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001900",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. Apenas regresamos, comenzaste a abrir los libros de repente...\naunque, bueno, ciertamente es lo más correcto de hacer... supongo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me queda de otra, ¿no? Me falta aún muchísimo por estudiar.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001901",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay problema por eso. Tomaré toda la responsabilidad de ayudarte con los\nestudios hasta que presentes los exámenes de ingreso.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uwaah, no sé si sentirme feliz o no...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001902",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No te pone feliz eso?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, de que estoy feliz estoy feliz. Eres muy buena explicando además...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Pero, ella es la clase de persona que ha seguido un ritmo de vida en el cual\nlos estudios ocupan la gran mayoría de su día... No tengo mucha seguridad de\nque alguien tan perezoso como yo pueda mantenerse a la par con Rin.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001903",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, enséñame a pintar entonces, ¿sí? Basta con que lo hagas hasta que termine\nla Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también voy con esa intención... ¿Y bien? ¿Trajiste tu cuaderno de dibujos?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001904",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. Todos los días lo llevo conmigo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos entonces, por los momentos...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Observo el bloc de dibujos de Rin. Ha absorbido muy bien lo que le he enseñado.\nSus dibujos captan la estructura de su objeto.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Respecto a esta mano acá, no estás tomando en cuenta este tendón.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001905",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Dónde? ¿Eh, acá?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes tocar mi mano. Es difícil distinguir los músculos con la tuya, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001906",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Puedo?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema. Es más rápido así.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001907",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje... te tomaré la palabra entonces, y... ¡Ey!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vengas con 'Ey' ahora. Deja de andar jugando y toca bien.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001908",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Voy explicándole a Rin mientras hago que toque mi mano.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Mientras más desarrollados los músculos de los brazos, más fáciles son de\ndistinguir. Y por el caso contrario, no hay cosa más difícil que tratar de\ndescifrar la estructura de un brazo con músculos poco desarrollados.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"En ese sentido, mi cuerpo bien entrenado sirve muy bien de material didáctico.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, en la espalda tenemos el músculo dorsal ancho, el músculo redondo mayor y\nel músculo redondo menor. Tócalos.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001909",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿R-Realmente puedo? Es tu espalda, ¿puedo meter mi mano dentro de tu\ncamisa?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema. Voy a desabotonarme todos estos botones acá.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",loop=6,size=20,time=100,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001910",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿H-Hablas e-en se, se, se, serio?!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fgact",ch="稟",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso de se, se, se?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001911",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, no... *cof*, n-no es absolutamente nada...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, no entendí...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Desabotono mi camisa.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0022j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"fgact",ch="稟",act="icon",lv=5,id=9,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001912",ch="rnd"},
},
ja={
{
name={"Rin"},
"“------”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué cara es esa?...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001913",ch="rnd"},
},
ja={
{
name={"Rin"},
"*burun*, *burun*.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Lo único que hace es mover la cabeza a los lados mientras dice 'burun burun'.\n¿Qué rayos quiere decir?",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, listo...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001914",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... Con permi～so.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",mode=-2},
{"bg",file="ev_com_c06_01",path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Por qué me tocas rozándome con las manos?! ¡Me das cosquillas!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001915",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No, es solo un malentendido. Solo, no me pareció muy bueno tocarte tan\nmeticulosamente...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, se supone que estás tratando de identificar los músculos y órganos, de\nnada te sirve que toques solo rozando la superficie. Lo único que harás es\ndarme cosquillas.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001916",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Está bien... con permiso, entonces...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_c06_02",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001917",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah, genial, increíble.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pregunto solo por saber, puedes identificar cada uno de los músculos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001918",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, muy fácilmente...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este músculo acá rodea tanto el músculo pectoral mayor como las costillas, y le\nda esa forma de 'v' al cuerpo humano, pero, en la forma que tú dibujaste la\nespalda...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001919",ch="rnd"},
},
ja={
{
name={"Rin"},
"“W-Waah... qué, músculos...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿es que acaso estás escuchándome?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"quake",size=4,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001920",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Pe'dón!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué pareces estar dejándote llevar por pensamientos impuros?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_c06_03",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001921",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso es bastante obvio...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_c06_04",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001922",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Estoy diciendo que eso es bastante obvio! N-No hay nadie que pueda\npermanecer impasible al tocar el cuerpo de la persona que le gusta.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es simplemente porque te falta dedicación y pasión por la pintura. Y en\nprimer lugar, ¿qué tiene de divertido tocar el cuerpo de un hombre?...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_c06_05",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001923",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muh, lo que dices es ilógico.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001924",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo que estás diciendo no tiene sentido.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene de ilógico lo que digo? Ven acá, vamos ahora con el músculo pectoral\nmayor.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_c06_06",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001925",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿M-Me dejarás tocar tu pecho?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, hazlo con seriedad.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bg",file="ev_com_c06_05",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001926",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhh. Aunque no lo creas, estoy tratando de ser seria a mi manera...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Observa, la parte central del pecho es el cuerpo del esternón. ¿Lo ves?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_c06_06",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001927",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí. Sí. L-Lo veo. Puedo verlo.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres tocar y comprobarlo?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001928",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tocaré. Lo tocaré y lo comprobaré.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_c06_07",path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_c06_08",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001929",ch="rnd"},
},
ja={
{
name={"Rin"},
"“W-Wawah... Waaah...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tratándose de un hueso, ciertamente no hay necesidad de presionar tan fuerte,\npero... ¿Podrías dejar ya de tocar rozando por encima?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001930",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí, t-tienes razón. ¿P-Puedo sobar con más fuerza?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sobes mis huesos.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001931",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es eso. ¿P-Podría revisar la parte del músculo pectoral mayor?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001932",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Entonces... ¿Podría... descubrir un poco más la camisa?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no me importa...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se3130",vol=50,id=1},
{"text"},
text={
ja={
{
"Abro por completo la parte del pecho de mi camisa.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001933",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhhh.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tal? ¿Está bien así?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001934",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Guh!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Rin hace un gesto levantando su pulgar. ¿Qué está tratando de decir?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",mode=-2},
{"bg",file="ev_com_c06_09",path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001935",ch="rnd"},
},
ja={
{
name={"Rin"},
"“B-Bien entonces, con permiso de nuevo... O-Ohh.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Los sientes?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001936",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, de cierta forma los siento. Puedo sentirlos. Qué músculos tan increíbles.\nA mí me gustan los músculos y los huesos.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy hablando de eso.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_c06_10",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001937",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Lo siento!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedo entender que quizás te gusten los músculos, ¿pero, cómo es que te gustan\nlos huesos?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_c06_11",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001938",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, los huesos también tienen lo suyo. Los huesos son amor. Los huesos de\nlos hombres son moe.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Rin contesta eso, haciendo brillar fuertemente sus ojos.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bien, entiendo. De ser así, pon algo de ese amor por los huesos en los\ndibujos, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001939",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, con todo gusto pondré mi amor en los dibujos también. Uwaah... increíble.\nAsombrosooo... Esta parte de las costillas acá, está para comérsela...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Rin toca mi cuerpo, revisando con bastante ahínco cada uno de los músculos y\nhuesos.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Bueno, ciertamente lo está haciendo, pero... hay algo acá un tanto fuera de\nlugar.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bg",file="ev_com_c06_12",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001940",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, e-esto es irresistible. Qué maravilloso es aprender a dibujar. Estos\nson los pezones, ¿verdad? Nao-kun, son tus pezones, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bg",file="ev_com_c06_13",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"se",file="se9030",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001941",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nyan!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_c06_14",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001942",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué me hincas con el dedo?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque me pareció que tenías intenciones poco serias.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_c06_15",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001943",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Poco seria? En este momento estoy actuando seria. Soy la seriedad hecha\npersona. ¡Observa nada más, por favor, estos inmaculados ojos!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ciertamente están brillando... ¿Se te dilataron las pupilas o algo así?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001944",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, no es de sorprenderse que se me dilaten. ¡A los humanos se le dilatan las\npupilas al ver cosas de gran interés!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Es así?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001945",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Es lo básico y normal.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"¿Cómo que básico y normal?...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, los músculos y los pezones no tienen nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001946",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Los pezones también son muy importantes a la hora de dibujar! ¡¿Qué tiene de\nmalo?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, siento un aura impuro en ti, así que no más. Se acabó ya este método de\nenseñanza.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_c06_16",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001947",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿N-No habrá más?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, se acabó. Digo, ya pudiste revisar bastante, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"bg",file="ev_com_c06_11",sync=0,face=1,time=400,path=":ev/ev_com_c06/",set="ev_com_c06"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001948",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Solo por encima de la cintura!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, ya es suficiente con la parte superior del cuerpo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001949",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Falta ir debajo de la cintura!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por debajo de la cintura?... Bueno, si es hasta los muslos, supongo que no hay\nproblema, pero...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001950",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quiero entonces una orden de muslos de Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Umuh...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Pero qué está pasando...",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001951",ch="rnd"},
},
ja={
{
name={"Rin"},
"“B-Bien, voy a la carga.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“STOP. No. Para. Por ahora, toma en cuenta todo lo que te acabo de enseñar y\npractica dibujando de cintura para arriba.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001952",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siento algo impuro. El arte no puede crearse a partir de esas intenciones\nsucias.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001953",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tch... Thomas-san refutó ya ese argumento tuyo hace tiempo...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dijiste algo?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001954",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muuh, d-déjame preguntarte entonces algo, Nao-kun. ¿Serías capaz de hacer\nexactamente lo mismo sin ningún sentimiento impuro en tu corazón?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué debería sentir algo impuro al tocar el cuerpo de un hombre?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0007",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001955",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No! ¡Estás confundiendo las cosas de raíz! ¡Me refiero al sexo opuesto!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Al sexo opuesto? ¿Eh? ¿Q-Quieres decir, con una mujer?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001956",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Nao-kun, ¿eres capaz de tocar el cuerpo de una mujer sin ninguna idea\nimpura?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001957",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal como lo pensaba. A mi parecer, las cosas funcionan así.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero qué ridiculeces andas diciendo. Vamos, a dibujar, a dibujar.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001958",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muh, siento que estás evadiendo el tema. Aún después de que me regañaste,\ndiciendo que tengo muchas intenciones impuras...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no es mentira. Tienes muchísimas intenciones impuras.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0018",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001959",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es verdad. Sería más bien raro permanecer calmado al tocar el cuerpo de\nla persona que uno ama.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que eso te pasa por no tener suficiente dedicación y seriedad por\nlas artes.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001960",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Aún no me ha quedado muy claro la estructura de la parte superior del cuerpo!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún después de haber tocado tanto, ¿no entiendes cómo funciona?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001961",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quisiera repasar dónde se ubican cada una de las partes en el caso de las\nmujeres. ¡Así que Nao-kun, toca mi brazo, por favor!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿J-Jaa? ¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001962",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace un rato mencionaste que es difícil distinguir los lugares sin mucho\ndesarrollo muscular. Así que quiero que me enseñes aquellas partes difíciles\nde discernir usando mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, espera, eso...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001963",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te surgen pensamientos impuros?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No me subestimes... Durante un largo tiempo he estado entrenándome en esto. Y\nte repito que ya he dibujado desnudos incontables veces.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001964",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah, sí?... Comienza entonces, por favor.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Pero qué provocación tan absurda, diablos.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"No hay forma de que esa clase de ideas se crucen por mi mente solo tocando el\nbrazo de Rin...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, saca el brazo entonces.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001965",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, vamos con los dedos primero. Este tejido múscular de acá――”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Toco la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Y luego, su brazo.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Y luego...",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y, bueno, eso es todo.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001966",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso es todo?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001967",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aún no has revisado el músculo redondo mayor ni el músculo pectoral mayor.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y crees que soy capaz de hacerlo?! ¡Tocar uno de esos dos músculos implica\ntocar tus propios pechos!”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001968",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, pero, yo toqué tu músculo pectoral mayor, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"mwact",act="おじぎ",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guguh... S-Si es nada más el músculo redondo mayor de la espalda, y la parte\ndel músculo pectoral mayor de las axilas, entonces sí...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001969",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mufufun. No tienes por qué forzarte tanto. ¿No lo mencionó Thomas-san ya antes?\nY citando las palabras de Renoir. La verdad, a mi también me parece que el\narte y los pensamientos impuros pueden coexistir juntos.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo los más grandes pintores pueden decir eso, y...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001970",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Renoir tampoco fue un gran pintor al principio. Pero, la razón que lo motivó a\npintar fueron los senos y los traseros de las mujeres.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no me importa. Esa clase de pensamientos impuros no son para nada\nnecesarios a la hora de dibujar. Los pintores del Renacimiento no debieron\nhaber tenido esas ideas tan sucias. Empleando las disecciones, investigaron y\ndesarrollaron a más no poder las técnicas de dibujo. En esos actos no había\nimpureza alguna.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001971",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás, pero...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, este es el músculo redondo mayor.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001972",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hii.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y este es el músculo pectoral mayor. Fin.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Presiono con mis manos los músculos de esos dos lugares de Rin.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001973",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es de tramposos que lo hagas así de repente. Y además, por encima de mi ropa.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quítate la ropa entonces.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001974",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedes, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001975",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En tu caso solo te desabotonaste la camisa...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces desabotona la tuya...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001976",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿De... verdad?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien comenzó con todo esto, ¿no? De que si había o no intenciones\nimpuras y eso.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001977",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo hago yo por ti? Lo hice la vez pasada, así que sé cómo desabotonarla ya.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001978",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no hay problema. Puedo hacerlo yo sola...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001979",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... ¿Está bien así?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"... *traga saliva*.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Bien, acá. Esta parte central del pecho es el cuerpo del esternón.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"bg",file="ev_com_c07_02",path=":ev/ev_com_c07/",set="ev_com_c07"},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001980",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Y bien, de acá al brazo...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001981",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Toco los pechos de Rin.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Por supuesto, no lo hago directamente, y además mi objetivo no es llegar a sus\npechos como tal. Simplemente estoy moviendo mis manos, deslizándolas sobre el\nmúsculo redondo mayor y los músculos de su zona pectoral.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Sin ninguna idea impura...",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Con un verdadero y genuino sentido artístico...",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Examino, y me grabo la forma de su cuerpo de forma lógica, y precisa...",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Pues, obviamente estoy mintiendo.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"No puedo más con esto...",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin... realmente tienes la piel suave...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"bg",file="ev_com_c07_01",sync=0,face=1,time=400,path=":ev/ev_com_c07/",set="ev_com_c07"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001982",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y tus huesos son también delgados... siento que podría romperlos...”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001983",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Son pequeños, pero me he ejercitado bastante, así que no creo que se quiebren\nde forma tan sencilla.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será eso verdad?...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001984",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quieres presionar más fuerte?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Toco fuertemente sus costillas.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Sus cartílagos costales se hunden fácilmente.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"En ese momento, puedo sentir con fuerza la respiración de Rin.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Era como si todo este pequeño cuerpo latiera y palpitara fuertemente de por sí.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001985",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tu pecho no tiene grasa, pero el mío sí.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Toco también sus pechos.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"bg",file="ev_com_c07_03",sync=0,face=1,time=400,path=":ev/ev_com_c07/",set="ev_com_c07"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001986",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te dolió?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"bg",file="ev_com_c07_04",sync=0,face=1,time=400,path=":ev/ev_com_c07/",set="ev_com_c07"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001987",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay forma de que me duela mientras me toques simplemente rozando la mano.\nEsa forma de tocar me da cosquillas, igual que en tu caso, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tienes razón... lo siento...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001988",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, está bien. Si llegaras a presionar fuertemente mis pechos, me dolería...”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Trato de no tocar la punta de sus pechos. Esa fue, quizás, una última y\nlánguida muestra de resistencia de mi parte.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"El motivo por el cual hago esto es, nada más ni nada menos que enseñarle la\ncomposición muscular.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"En este momento, me daba la impresión que de llegar a tocar esa parte, ese\nmotivo inicial terminaría perdiéndose en el vacío por completo.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Por supuesto, en este jueguito nunca existió tal motivo desde un principio...",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, con esto terminamos la explicación para la parte superior del cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001989",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fuu... Y bien, Nao-kun, ¿no tuviste ningún pensamiento impuro?”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, estuve repleto de ellos durante todo este rato...”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001990",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mitad de plena explicación estuve tocando tus pechos con puras ideas sucias\nen mente.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001991",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, no importa, son los míos.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿puedo besarte?”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001992",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhmm, ahora no.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001993",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje... pues, cómo podría decirlo... es un tanto difícil de explicar, pero...\na mis piernas se les fue la fuerza después de lo que acabamos de hacer, y...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se te aflojaron las piernas?”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001994",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi pecho está latiendo tan fuerte ahora que siento que podría acabar cayendo al\nsuelo. Si llegaras a besarme en este estado, podría desmayarme.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto así?”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001995",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tanto que estaba preocupada de que escucharas mi pecho latir cuando me tocabas,\nNao-kun... Si llego a pararme ahora terminaré cayéndome...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001996",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que, ¿podrías darme un receso?”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, descansemos un poco.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rin pone sus manos sobre su pecho.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001997",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo, que ya estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"excall",file="03_olympia_04_4"},
{"text"},
linkback="block_00322",
},
label = {
top={block="block_00000",label=1},
},
}
