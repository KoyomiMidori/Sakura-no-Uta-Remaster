{"se",file="se9031",id=1},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000240",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, para! ¡¿Te das cuenta que solo tienes una toalla encima?! ¡Si llegas a\nhacer eso--!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000241",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Considerando que Kuzu no tiene vello púbico, creo que tendrás una muy buena\nvista si abro las piernas.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso no tiene nada de bueno!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0002",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000242",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No? Según lo que encontré en mi búsqueda en el teléfono, mis zonas genitales\nparecen ser de muy buen aspecto. Un co*o de niña.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",my=40,mode=-1,lv=5,id=9},
{"se",file="se9010",id=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No digas co*o! ¡Ah, espera! ¡¿Qué haces agachándote?!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000243",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No puedo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"se",file="se9033",id=1},
{"fg",ch="雫",size="z2",my=40,mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000244",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Quizás lo estés haciendo para producirme sueños pervertidos de mayor calidad,\npero si llegas a hacer eso no voy a aguantar hasta la noche! ¡Mi cuerpo me\nobligará a hacerlo ya!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0004",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000245",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eh? ¿A violarme? ¡¡Perfecto!!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Perfecto un carajo! Y obviamente que no voy a hacer eso. Me refería a que iré\nal baño a jalármela.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0002",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000246",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Al baño?... Naoya, realmente te gusta masturbarte.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No tiene nada que ver si me guste o no hacerlo, es cuestión de que no podré\naguantar teniendo tanta información de alta intensidad en mi cabeza!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000247",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ya veo. Es mejor hacer este tipo de cosas entonces en la noche, supongo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo haces y no podré dormir!”",
{"rt2"},
},
