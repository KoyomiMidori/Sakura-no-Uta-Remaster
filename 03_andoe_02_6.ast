},
},
text={
vo={
{"vo",file="fem_kzd_000239",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Piernas abiertas formando una M... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vengas ahora con un ya veo.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1501",face="a0005",head="shz_z2a",lv=5,id=9},
