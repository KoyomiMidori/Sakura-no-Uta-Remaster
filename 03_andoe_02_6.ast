astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Al regresar a casa, preparé la comida.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Pero aun así, Kuzu no intentó comer.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Parecía estar muy lamentada de no hacerlo, pero supongo que no puede dejar a un\nlado su convicción.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"No puedo simplemente ignorar esa convicción suya y obligarla a hacer lo que mi\npadre o yo deseemos.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Probablemente hará todo lo que pueda para no perder el poder tragasueños, al\nmenos hasta que todo esto se resuelva...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"El agua de la tina estaba caliente ya, así que dejé que Kuzu entrara primero.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo bien, ayer no la llevé a que se bañara.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Al parecer también limpió el baño, así que entró alegremente a bañarse en la\ntina limpia.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Tener a una muchacha en mi baño me inquieta.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-586,speed=120000,file="zbg023c",path=":bg/",x2=280,y2=-586,x=-100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo olvidaba. Kuzu anotó todo lo que movió y organizó cuando limpió.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Tomo el cuaderno.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues supongo que iré a revisar los lugares que limpió.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",file="se2497",vol=50,id=1},
{"text"},
text={
ja={
{
"Reviso el cuaderno.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"¿Será que esta acostumbrada a este tipo de labores? El cuaderno estaba\norganizado de una forma muy limpia y concisa.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, pasó un tiempo viviendo en Nueva York con el viejo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La mayoría de las cosas que hay en esta casa son de mi padre.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"El hombre está cargado de objetos y artilugios, y nunca ha sabido organizarse.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Aunque entre el caos de las habitaciones él tenía su orden, y cada vez que me\natrevía a limpiar me reprochaba.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Habiendo estado todo este tiempo con mi padre, es posible que ya esté\nacostumbrada a este tipo de limpiezas...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"se",file="se2497",id=1,vol=50},
{"text"},
text={
ja={
{
"Y mientras pensaba eso, paso las páginas.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"mwact",act="びっくり",size=8},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qué mierda?!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
"La página con la que había dado tenía escrito 'Lista de cosas de Naoya',\nrodeado por un círculo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Lo que me sorprendió fue el primer ítem.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"① Revistas de mangas eróticos, ② libros de mangas eróticos, ③ revistas\neróticas (con fotografías), ④ libros eróticos (con fotografías).",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Todo bien hasta acá.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"1. Revistas de tetonas, 2. Revistas de culonas, 3. Revistas de lolis.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"C-Condenada Kuzu... ¿Por qué tuvo que ponerse a organizar también esto?...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"No, bueno, la culpa la tengo yo también por no esconderlos. Pero viviendo solo\ntodo este tiempo no tenía sentido ocultarlos.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, quién diría que hasta mis revistas eróticas llegaría a organizar...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000196",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿E-Eh, Kuzu?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"se",file="se3130",vol=70,id=1},
{"bg",rule=101,time=200,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-30,file="zbg023c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9,sync=0},
{"quake"},
{"extrans",rule=101,time=200},
{"text"},
text={
ja={
{
"Al voltear me encuentro con Kuzu, envuelta solo en una toalla.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000197",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Solo vine a informarte que ya desocupé el baño...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues podías vestirte antes, no me importaba...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000198",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No tengo ropa para cambiarme.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000199",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“De lo que dijo Kenichiro, ya mis cosas deberían haber llegado de Nueva York...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De Nueva York? Dios santo, el viejo está preparando todo para dejarte viviendo\nacá.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0010",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000200",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Por alguna razón no han llegado aún.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Agh, ¿con qué compañía mandaron las cosas? Veré en internet qué sucedió.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000201",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Es eso posible?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hoy en día puedes ver en internet dónde están los paquetes que envías.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000202",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Con la información de la compañía que Kuzu me dio, busqué en internet y\naverigüe el estado del envío.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000203",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",file="se9032",id=1},
{"text"},
text={
ja={
{
"Siento una suave y particularmente elástica sensación.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Kuzu se pega a mi espalda.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"cgact",stage="bg023",stime="c",act="いいえ"},
{"se",file="se9031",id=1},
{"text"},
delay={
[200]={
{"se",file="se9031",id=1},
},
},
text={
ja={
{
name={"Naoya"},
"“¡E-Espera, no te pegues tanto!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000204",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha bien, si te arrimas tanto a mí en ese estado de semidesnudez--”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000205",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Intentarás hacerme algo?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"se",file="se3130",id=1},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, demonios!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaaa, rayos. Bien, ya las cosas llegaron hace un buen tiempo a la sucursal de\nYumihari. Solo que por alguna razón llevan días detenidas allá.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000206",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, mañana llamaré para ver. Seguramente se equivocaron en algo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000207",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000208",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Cambiando de tema, Naoya. Desde hace un buen rato no he podido sacarme esta\nduda.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000209",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Te gustan las tetonas? ¿O eres acaso un lolicon?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Buh*, p-pero q--, ¡¿Pero qué diablos preguntas?!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000210",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pues, es que justamente tienes el cuaderno abierto en esa página.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Diablos, olvidé que hasta hace poco estaba viendo el cuaderno.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000211",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Hay 60 volúmenes de tetonas y 26 de lolis. Viendo los números, cualquiera\npensaría que te encantan los pechos grandes. Pero ¿por qué también hay\nbastantes de lolis, siendo dos géneros totalmente opuestos entre sí?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que--”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000212",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Es que?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada, olvídalo, no importa.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000213",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Claro que sí importa. Se dice que la sacerdotisa tragasueños es capaz de tomar\nel aspecto físico que más desea un hombre en una mujer con solo tragar sus\nsueños.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000214",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eso es lo que Kuzu desearía.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me asustaste... Es solo una fantasía tuya...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Si eso fuera verdad, habría la posibilidad de que el cuerpo de Kuzu cambiara al\ntragar uno de mis sueños. Y eso no estaría nada bien.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000215",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Mis pechos son pequeños. Si los prefieres grandes, me entristece decir que solo\npuedo ofrecer este lamentable cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, no, no hace falta que ofrezcas tu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000216",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Pero si prefieres lolis! ¡Si lo que te gustan son lolis, entonces--!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha bien, te dije que no hace falta.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000217",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Mis pechos dejan mucho que desear. Pero a cambio de eso, Dios me otorgó otros\ndotes. Justo ahora me acabo de dar cuenta de eso.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Otros dotes?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1511",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000218",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Kuzu no tiene vello púbico! ¡Hum!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé para qué haces una seña de la paz...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0010",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000219",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Nada de pecho, nada de vello púbico. Muchos años pasé aterrada por la idea de\nque moriría siendo una infante.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000220",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Pero si realmente eres un lolicon, estos atributos podrían representar una\ngran oportunidad!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"msgoff"},
{"se",file="se9023",id=1},
{"fg",ch="雫",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="雫",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1501",face="a0005",head="shz_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000221",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya, ¿prefieres las tetonas? ¿O se te dan mejor las lolis?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé cómo debería responder a eso...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000222",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Prefieres entonces a las tetonas?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, ciertamente las tetonas son maravillosas, pero también siento\ninclinación por las lolis... ¡Espera! ¡¿Qué clase de cosas me estás haciendo\ndecir?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0005",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000223",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Se trata de algo importante!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000224",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Es el momento decisivo donde Kuzu sabrá si su cuerpo puede servirte de algo o\nno!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, eso no tiene nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000225",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Por supuesto que sí.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, yo soy fiel creyente del amor puro. Si la mujer de la que me enamore\nllega a ser tetona, pues eso me haría un fanático de las tetonas, y lo mismo\nsi llegara a ser una loli.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000226",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ya veo. Esa manera de interpretar las cosas es muy de ti...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0009",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000227",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Para ser sincera, temía que me dijeras que las lolis tetonas son las mejores.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, las lolis tetonas sí son las mejores...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"se",file="se9031",id=1},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000228",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Hii!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, escucha. Enamorarse de alguien no es solamente algo físico. No importa\nque no sea una loli tetona.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000229",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Sí? Por un momento pensé que tendría que hacer un aumento de busto acá y de\ninmediato, con algodón como relleno de ser necesario.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué clase de historia grotesca estás proponiendo.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Rayos, no tengo ni idea de qué tanto de lo que dice Kuzu es en serio, y qué\ntanto es en broma.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cambiando de tema, ¿piensas tragar mis sueños de nuevo esta noche?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000230",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, de poder quisiera hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad está bien que lo hagas? Lo digo por la carga que podría traer sobre\ntu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fgact",ch="雫",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000231",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No te preocupes. Tus sueños los trago por gusto.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por gusto? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000232",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pues, no sabría qué decir...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Según lo que me contaste esta mañana, mis sueños son más que todo eróticos,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000233",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Y de muy alta pureza.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Teniendo una muchacha como tú en la casa es difícil no tener sueños así.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000234",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Sí? Eso me alegra. ¡Kuzu se esforzará bastante!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esforzarte? ¿Esforzarte en qué?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0005",head="shz_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, ¿qué haces ahora buscando cosas en el navegador del teléfono?!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000235",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Qué tal esto?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Por alguna razón, Kuzu estaba ahora haciendo una seña de la paz en cada mano.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que qué tal?... Si lo haces con esa cara tan inexpresiva...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000236",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No es excitante?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Erótica la doble seña de la paz?! ¡Ese dato está muy parcializado!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000237",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Eh? ¿En serio? ¡Pero en esta página dice que la doble seña es muy erótica!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, la doble seña de la paz en sí no es erótica. Lo que es realmente\nexcitante es cuando se hace junto con una pose excitante.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fgact",ch="雫",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000238",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Una pose excitante...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, no te pongas a buscar de nuevo en el teléfono!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1501",face="a0018",head="shz_z1a",lv=4,id=9},
