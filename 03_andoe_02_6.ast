{"text"},
text={
vo={
{"vo",file="fem_kzd_000248",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Qué complicado todo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, ya no hace falta que sigas, creo que con esto ya me cargué bastante.\nHoy podrás ver toda una plétora de sueños eróticos.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
