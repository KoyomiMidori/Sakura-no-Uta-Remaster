},
block_00148={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1501",face="a0004",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000250",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No puedo esperar a que llegue la noche.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Kuzu suelta una gran sonrisa.",
{"rt2"},
