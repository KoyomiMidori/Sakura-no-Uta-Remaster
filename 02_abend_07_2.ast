astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",rule=139,vague=40,file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Recibo las lecciones suplementarias en el salón.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mis vacaciones de verano no comienzan aún. Me quedan 3 días de clases\nsuplementarias.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Hasta que no terminen, mis vacaciones de verano no empezarán.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Pero qué lata...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Veo una sombra caminando hacia la iglesia.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Unos hábitos de monja, de manga larga, muy atípicos de verano.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Komaki o Kosachi, alguna de las dos, supongo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Debe ser bien duro tener que encargarse no solo del consejo estudiantil, sino\ntambién de los quehaceres de la iglesia. Realmente les encantan los\nquehaceres, eh...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000530",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Viendo de nuevo afuera, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, l-lo siento...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000531",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué andas viendo tanto afuera?... ¿Mmm? Ahh, esa es Komaki.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esa es Komaki?...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Ahora que lo dice, su forma de actuar me da esa sensación. Los movimientos de\nKomaki son suaves, mientras que los de Kosachi tienen algo de irritabilidad y\nveneno en ellos.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"No, espera, no estoy hablando de movimientos, sino de sus maneras de actuar.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deben estar pasando bastante trabajo, la obligan a hacer eso en plenas\nvacaciones de verano...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000532",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nadie la está obligando, todo lo hace por su propio fuerte deseo. En principio,\nparece que es imposible que una estudiante normal pueda trabajar al mismo\ntiempo de monja.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000533",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, no sé realmente mucho de lo que pasa con la iglesia, pero parece que las\nhermanas Akashi son la excepción a la regla. Al parecer, el colegio les\npermitió hacerlo, de manera excepcional.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De manera excepcional?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000534",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, Komaki es una estudiante ejemplar, llegando incluso a ocupar el cargo de\npresidenta del consejo estudiantil, así que el colegio no tuvo más opción que\notorgarle permiso.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000535",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es que no sabes? Justo antes de las vacaciones de primavera, el padre se\ndesmayó.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El padre se desmayó? ¿El padre encargado de esa iglesia?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000536",ch="aid"},
},
ja={
{
name={"Ai"},
"“La directora lo mencionó en su saludo durante el inicio del período, ¿no lo\nrecuerdas?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Pues no es que no recuerde... es que simplemente no estuve escuchando...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000537",ch="aid"},
},
ja={
{
name={"Ai"},
"“El padre es la persona que más tiempo lleva en este colegio... Además goza de\nbastante popularidad, así que son muchas las personas que lamentan su retiro\ndel cargo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000538",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque... he escuchado que sus síntomas no están muy bien...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, ¿ellas están laborando como monjas en lugar del padre?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000539",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues sí. Normalmente, parece que el jefe diocesano debió haber enviado a un\nnuevo padre encargado, pero las hermanas Akashi suplicaron que esperaran\nhasta que los síntomas del padre mejoren.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Suplicaron?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000540",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fue bastante terrible, según parece. Al parecer, el cuerpo directivo quería\nrecibir de una vez a un nuevo padre, y se mostraron renuentes a aceptar esa\npropuesta.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000541",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y es de entender, pues una larga ausencia del padre también traería varios\nproblemas. Hay muchas personas que realizan sus ceremonias de matrimonio en\nla iglesia de Yumihari, comenzando por allí.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ceremonias de matrimonio aquí? ¿En serio? Digo, estamos en un colegio, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000542",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero igualmente no vas a encontrar una iglesia con una arquitectura tan\nimpresionante como esta, ¿no? Tanto el lugar como el anfiteatro tienen\nbastante finura. Nada que puedas ver en un colegio.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque personalmente, pienso que la combinación del estilo gótico con un\nanfiteatro romano es de lo peor. No hay ningún balance armónico.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000543",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esos detalles tan pequeños no importan. Parece que hay muchos pasos tediosos\nque realizar antes del casamiento, como la asistencia a la adoración\ndominical y otras cosas, pero aun así hay muchas parejas que se casan acá. Te\npodrás imaginar entonces lo encantador que resulta el lugar para ellos.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmm, pues supongo que sí...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000544",ch="aid"},
},
ja={
{
name={"Ai"},
"“Parece que despachan a padres de otras iglesias cada vez que hay una solicitud\nde ceremonia matrimonial, pero la junta directiva está, al parecer, ansiosa\nde recibir ya a un nuevo padre fijo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, ¿por qué las hermanas Akashi están tan deseosas de que el padre\nanterior se reincorpore?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000545",ch="aid"},
},
ja={
{
name={"Ai"},
"“No conozco sus verdaderas razones, pero considerando todo lo que han hecho,\ndebe ser alguien muy importante para ellas.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000546",ch="aid"},
},
ja={
{
name={"Ai"},
"“La junta directiva no mostró buena cara, pero al parecer, la directora se\ndispuso a convencerlos junto a ellas. Según dijo, las hermanas Akashi estaban\ncompletamente determinadas en su propuesta, y no pudo darle la espalda a esos\nfuertes sentimientos...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La directora dijo eso? Pues, por más estudiantes de honores que sean, me\nparece raro que se haya favorecido más la opinión de dos estudiantes a la de\nla misma junta directiva...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"¿Qué clase de persona era la directora de este lugar? No recuerdo...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, la parte interior de la iglesia fue reformada. La reforma la\nhicieron hace poco, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000547",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Reforma? No, no me he enterado de eso... ¿Fue reformada?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sabías nada de la reforma?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000548",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no he escuchado nada al respecto, y la verdad es que en el tiempo que llevo\ntrabajando acá, nunca me pareció haber visto ninguna construcción allí...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"¿No han reformado la iglesia? No, no puede ser, algún tipo de reforma debe\nhaber recibido.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Los diseños del exterior y el interior son demasiado diferentes entre sí.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Lo cual quiere decir que son altas las posibilidades de que haya sido reformada\nantes de que Ai comenzara a trabajar como profesora acá.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000549",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, ¿puedo seguir ya con la clase?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo siento. Te interrumpí por un buen rato...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",rule=139,vague=40,file="bg057a",path=":bg/"},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Vuelvo a pararme una vez más frente a la iglesia.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"No sé muy bien la historia que la rodea, pero debe ser una estructura bastante\nvieja. Sin duda alguna, la arquitectura empleada es aquella de antes de la\nguerra.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Pero aun así, no parece tener tampoco el estilo arquitectónico seudo-\noccidental que los artesanos japoneses llegaron a desarrollar tratando de\nreproducir las estructuras occidentales.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Sí, se pueden observar rastros de que ampliaron el marco de la ventana.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Ampliaron la ventana hasta alcanzar las columnas y agrandaron los vitrales,\nseguramente.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debió haber sido una construcción de relativamente gran escala...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay forma de que Ai, como profesora, no se diera cuenta de una remodelación\nde esta magnitud...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En conclusión, la reforma fue realizada mucho antes, casi sin duda alguna,\nantes de que Ai asumiera su cargo acá.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Cruzo la puerta de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"se",file="se1329",id=1},
{"bg",file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"bg",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La brecha es increíble...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Al volver a ver el interior después de observar cuidadosamente el exterior, me\nvuelvo a quedar asombrado ante la brecha de imagen de los dos diseños.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien con un profundo entendimiento de la historia del arte, y además con\nexcepcional técnica y buen gusto. Solo alguien así pudo haber realizado esta\nclase de reforma.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Vuelvo a acariciar las paredes.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Están pulidas. Y además, fueron limpiadas hace poco...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"La brecha entre el diseño interior y el exterior era tan grande que pensé que\nhabía sido reformada hace poco, pero parece que malinterpreté las cosas.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Todo está tan bien pulido que pareciera ser nuevo, pero al ver de cerca, el\ncolor de las piedras estaba algo desteñido.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este lugar fue reformado hace más tiempo... Estimaría, por lo menos, hace 10\naños o más...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue por el pulido que sentí que había sido reformada hace poco. Vaya tropiezo\nque me eché.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Esa sensación de 'todo está muy bien pulido' que recibí al entrar por primera\nvez.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Esa sensación era justamente la respuesta correcta a este dilema.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La reforma fue realizada hace bastante tiempo, y hace poco recibió una limpieza\nbastante minuciosa, junto a un detallado pulido...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Inspecciono con bastante atención el suelo y las paredes de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Y al seguir así, acabé llegando a la puerta que estaba en el pasillo de uno de\nlos lados.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que me acuerdo, ella me había dicho que detrás de esta puerta estaba el\nsalón de la escuela dominical...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"La escuela dominical. Un lugar sin absolutamente nada que ver con alguien sin\nfe religiosa como yo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"se",id=1,file="gatya"},
{"text"},
text={
ja={
{
"Abro la puerta y observo el pasillo que estaba detrás.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000081",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, Komaki...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0005",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0009",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000082",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Por qué observas tanto el pasillo?... ¿Te llama la atención esa mancha?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es por eso...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",x=0,lv=4,id=9},
},
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0009",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000083",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“De allí en adelante está prohibido el paso con zapatos, pero a veces los niños\nse emocionan mucho y salen hasta la capilla con los uwabaki puestos... Y como\nresultado, los pasillos de la escuela dominical terminan sucios también...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Me había concentrado tanto en el material de piedra usado que no me di cuenta,\npero al observar con cuidado, se podían ver las huellas de los uwabaki de los\nniños aquí y allá.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que me lo dices... hay bastantes huellas de uwabaki...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000084",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, ciertamente, esta enorme cantidad de huellas de los uwabaki de los niños es\nalgo bastante característico de esta iglesia, pero aun así termina\nensuciándose todo y eso nos da más trabajo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Según veo, han mantenido este lugar impecable, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000085",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pues lo hacemos porque el padre está ausente por los momentos. Pero, realmente\ncuesta bastante tenerlo todo limpio. Me di cuenta de eso al hacerlo con mis\npropias manos.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000086",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“De lo que puedo recordar, los pasillos siempre estaban muy limpios, así que el\npadre debió haber estado siempre limpiando con bastante esmero.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000087",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero también aprovechamos de pulir y embellecer el lugar para sorprender al\npadre cuando regrese, aunque...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pulir? ¿Puedes pulir también?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fgact",ch="小牧",act="びっくり",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0013",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="小牧",act="おじぎ",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0010",head="kom_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0011",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000088",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ah, lo siento... Me habían obligado a no decir nada, así que supone que no\npodía hablar más del asunto...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te obligaron a no decir nada?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fgact",ch="小牧",act="びっくり",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0014",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="小牧",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000089",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¡Ah, no, ignora eso! ¡Olvídalo, por favor!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Pulir el interior de esta iglesia no es algo que se pueda hacer a pura mano.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Es imposible hacerlo sin traer el equipo necesario para ello.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"No es algo que las hermanas Akashi puedan hacer.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Normalmente, alguna empresa especializada debería ocuparse de eso.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Sin embargo, el hecho de que venga una empresa no sirve de razón para que ella\ntenga que permanecer sin decir nada...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Ahora que lo recuerdo, había alguien que obtuvo un pulidor industrial\nen sus manos.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fgact",ch="小牧",act="びっくり",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="小牧",act="おじぎ",lv=4,id=9},
},
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0017",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000090",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“E-Estooo... Sin querer se me escapó eso de la boca, pero... mantenlo en\nsecreto, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por otro lado, el interior de esta iglesia ha recibido por lo menos una vez una\nreforma de gran magnitud, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000091",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, eso he escuchado.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que de verdad hubo alguien tan intrépido como para ser capaz de reformar\ncon este diseño a una iglesia construida tan fiel al estilo gótico...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="小牧",size="z2",mode=3,resize=1,path=":fg/kom/z2/",file="kom_z2b0000",face="b0002",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000092",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Parece que en ese entonces se armó un gran escándalo.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En ese entonces?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fgact",ch="小牧",act="うなづく",lv=5,id=9},
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0001",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000093",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, según he escuchado, fue hace unos 20 años.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace unos 20 años...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fgact",ch="小牧",act="おじぎ",lv=5,id=9},
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0006",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0018",head="kom_z2b",x=0,lv=5,id=9},
},
vl03={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0003",head="kom_z2b",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000094",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Se propuso reconstruir el interior de esta iglesia, y tanto el jefe diocesano\ncomo la junta directiva del colegio se opusieron rotundamente, así que el\nescándalo fue grande, supuestamente.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es de imaginarse...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0012",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0008",head="kom_z2b",x=0,lv=5,id=9},
},
vl02={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0001",head="kom_z2b",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000095",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿De verdad? La primera vez que escuche la historia no supe muy bien cuál era el\nproblema... ¿Así de laborioso es reformar una iglesia?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En lo que concierne a las iglesias no tengo idea, pero desde el punto de vista\narquitectónico, es lógico.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fgact",ch="小牧",act="おじぎ",lv=5,id=9},
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0008",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000096",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Desde el punto de vista arquitectónico?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. En principio, todo el conjunto de edificaciones del colegio\nYumihari adoptaron un estilo gótico reproducido muy fielmente, el estilo\nneogótico. Y esta iglesia destaca entre todas esas edificaciones.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es normal que los tercos y conservadores se hayan enojado con la persona que se\nencargó de remodelar el interior de este cuasi-símbolo del colegio Yumihari\nde su diseño original a este diseño tan apartado de esa corriente.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0012",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0008",head="kom_z2b",x=0,lv=5,id=9},
{"fgact",ch="小牧",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000097",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Así de apartado está el diseño de su imagen original? La verdad es que no\nsiento nada raro en ello...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es algo así como ponerle una fresa a un daifuku, o bueno, a un dorayaki.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0005",head="kom_z2b",x=0,lv=5,id=9},
{"fgact",ch="小牧",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000098",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿No es eso normal?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es ahora. Sin embargo, he escuchado que la sensación de rareza entre la\ngente cuando salieron esos productos al mercado no era nada normal.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Piénsatelo, ¿no te parece un experimento bastante ambicioso incluir fresas en\nun dulce tradicional japonés?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0012",head="kom_z2b",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0001",head="kom_z2b",x=0,lv=5,id=9},
{"fgact",ch="小牧",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000099",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ahora que lo dices, eso significaría incluir frutas en un dulce japonés\ntradicional. Creo que lo he entendido.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Frutas en un dulce tradicional japonés. Este diseño interior es un experimento\nigualmente de osado e innovador. Una fusión de la arquitectura del siglo XV\ncon el estilo artístico del siglo XX...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién habrá sido la persona que diseñó esto?... No debe haber sido nadie\nnormal.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000100",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Según dicen, parece que fue un profesor de este colegio quien dirigió la\nreforma.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un profesor? ¿Lo hizo un profesor de esta escuela?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puede ser, no hay manera de que un simple profesor tenga la autoridad para\ndirigir una reforma de gran escala de una edificación del plantel, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0009",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0011",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000101",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, así es... Creo que ese profesor no tenía ese poder en sus manos.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No tenía ese poder? ¿Entonces lo hizo por decisión propia? Se supone que lo\nnormal en esos casos es ser despedido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0010",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000102",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, y así mismo, parece que ese profesor fue despedido...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era de esperarse...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un simple profesor decidió arbitrariamente realizar una reforma de esta\nmagnitud... ¿Pero qué clase de loco era ese profesor?...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0006",head="kom_z1b",x=0,lv=4,id=9},
{"fgact",ch="小牧",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0005",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000103",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No, no fue así. También fue por pedido del padre, así que ese profesor no tuvo\nla culpa.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=0,lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000104",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Y así como puedes ver, el interior de esta iglesia es absolutamente\nesplendoroso. En especial, estos vitrales son maravillosos, y a mí me\nencantan.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Al decir eso, Komaki observó hacia arriba, a los vitrales.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te gustan estos vitrales?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=0,lv=4,id=9},
},
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000105",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, personalmente creo que no hay unos vitrales tan maravillosos como estos en\nninguna otra parte. ... Aunque, tampoco tengo tanto conocimiento en vitrales\ncomo para poder aseverar eso.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Aún para alguien que no esté especializándose en arte, estos vitrales son\nmaravillosos...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Pues sí, con toda razón...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"De ser así, entonces...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay forma de que la persona que haya alterado a este grado el interior de la\niglesia, no haya tratado de ponerle manos encima al exterior también...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fgact",ch="小牧",act="びっくり",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0013",head="kom_z1b",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000106",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Eh? ¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo hablaba solo. Lo siento, ignora lo que dije...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="小沙智",size="z1",mx=40,mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000100",ch="ksd"},
},
ja={
{
name={"???"},
"“¡Naoya Kusanagi! ¡¿Viniste de nuevo acá?!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, la gemela Akashi escandalosa...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fgact",ch="小沙智",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0018",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000101",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡¿Escandalosa?! ¡Eres tú quien me pone así!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0006",head="kom_z1b",x=-345,lv=4,id=9},
{"fgact",ch="小牧",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0005",head="kom_z1b",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000107",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Kosachi-chan, Kusanagi-san no ha hecho nada malo. Simplemente estábamos\nhablando de esta iglesia, de sus vitrales y todo eso.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0009",head="kos_z1b",x=345,lv=4,id=6},
},
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0018",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000102",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Los vitrales? ¿Jaa? ¿Es que acaso un tosco e ignorante como tú puede entender\nla genialidad de estos vitrales?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, un poco... Solo por si acaso, me estuve especializando en arte hasta\nhace un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0016",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000103",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Hmph, ¿entonces sabrás cuales fueron las corrientes que influyeron el diseño de\nestos vitrales?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los vitrales como tal fueron influencia de Chagall, las partes con volumen son\nde Gallé. Pero, las ideas implementadas en las secciones de luz que entran\npor ellos son del estilo de Matisse. A fin de cuentas, es una obra que en sí\nmarca una clara distinción entre ella misma y el arte tradicional cristiano.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fgact",ch="小沙智",act="びっくり",lv=4,id=6},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0013",head="kos_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000104",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0011",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000105",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“E-Esto, lo único que sé es que estos vitrales fueron creados inspirados en un\npintor bastante famoso...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Inspirados por un pintor bastante famoso...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fgact",ch="小沙智",act="びっくり",lv=4,id=6},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0013",head="kos_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000106",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡E-Es que, a nadie se le ocurriría normalmente que un vitral pueda ser creado\ninspirado por un artista! ¡¿No es así?!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quizás tengas razón...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Bueh, aún sin tener mucha cultura artística, es fácil darse cuenta de que estos\nvitrales, al no emplear de ninguna manera los principios de la geometría, no\nvienen de la mano de un artesano, sino que más bien se encuentran\ninfinitamente cercanos a la sensibilidad de un pintor.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000107",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Cambiando de tema, una muchacha del club de arte estaba buscándote. ¿Cómo era\nque se llamaba?... Era de primer año...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Seguramente estará enojada, diciéndome '¡No dejes sola a Rin!'.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Últimamente se enoja cuando desatiendo, no solo a Hikawa, sino también a Rin.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, pero qué lata. Bien, creo que me iré ya...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000108",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, ven de nuevo cuando quieras.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Kawachino da bastante miedo. Vayamos rápido de vuelta al club de arte...",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_07_3"},
{"text"},
linkback="block_00173",
},
label = {
top={block="block_00000",label=1},
},
}
