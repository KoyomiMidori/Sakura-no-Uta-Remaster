astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm024"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos... los mangas eróticos están... ah, ¿dónde era que estaban～?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001485",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, esas palabras son bastante descabelladas.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué puedo hacer? Estoy buscándolos para prestártelos a ti.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001486",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso, quiero decir que es descabellado haber propiciado esta situación...\nNormalmente, una amiga de la infancia no haría que su amigo busque mangas\nindecentes para poder tomarlos prestado.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Tanto hombres como mujeres tienen cierto deseo sexual, así que da\nigual, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001487",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-Deseo sexual? Y-Yo no hago e-esas cosas con estos mangas.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-A qué te refieres con esas cosas? Rayos...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0011",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001488",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Esto, cómo podría ponerlo... ehh... ¿Hacer, cosas pervertidas sola,\nquizás?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Idiota, no tenías por qué responder a esa pregunta.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001489",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, e-entiendo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Pero, vaya... Así que tú también sabes de eso.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001490",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Saber qué?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, lo de hacer cosas pervertidas uno mismo... o digamos, masturbarse...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001491",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues claro que sí, yo tampoco soy una niña ya, por supuesto que lo sé.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en los mangas y los juegos, los personajes así como tú no suelen saber\nnada de eso.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001492",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja. Hay más ternura así, ¿verdad? Que la chica no sepa nada de hacer cosas\npervertidas sola, ni nada de eso...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así lo piensas? A mí más bien me daría lástima que no lo supiera.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001493",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué, te daría lástima eso, Nao-kun?...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, el hecho de que no sepa, significa que nunca lo ha hecho, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001494",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah. Y-Ya entiendo...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001495",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En cambio, el hecho de que lo sepa... significa que quizás lo ha hecho,\n¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad, me parece más fantástica la segunda opción a la primera.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001496",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?... Es más tierno que la chica no sepa nada.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, además, pensándolo bien, no hay forma de que no sepas nada al\nrespecto habiendo buscado tantos mangas eróticos conmigo en el pasado.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si dijeras que no sabes, sería evidente que estás fingiendo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001497",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, claro, ahora que lo dices, tienes razón. Y además, hay varias escenas de\nese estilo dentro de los mangas...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tú no lo haces, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001498",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿P-Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues hace un rato dijiste que no lo hacías, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001499",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Q-Quise decir que no lo hacía mientras leía mangas pervertidos.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿En serio? ¿Eh? Eso quiere decir que...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0014j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001500",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?... Ah, ¡aahh!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"La cara de Rin se sonroja a más no poder.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001501",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Ahh... ¿A-Acabo de cavar mi propio hueco? Justo ahora...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, la verdad que no me parece así...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Si tan solo justamente ahora no hubieras puesto esa cara de '¿Qué acabo de\nhacer?', eso sí...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vamos, ¿cuál es el problema?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001502",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Q-Quizás lo digas de forma muy ligera, pero... para mí, fue un error fatal...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Rin dice eso, completamente sonrojada y algo enfurruñada.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes. A la gran mayoría de los hombres les gustan las chicas con un\nbuen líbido. Más aburridas son esas chicas que dicen '¡Yo no me masturbo!'.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001503",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso no es verdad... Las chicas que hacen eso no son tiernas...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Pretendes desaprobar a todas las chicas del mundo que se masturban?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001504",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no pretendo hacer eso, solo que... por lo menos, yo no me veo tan\ntierna haciéndolo...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú... haciéndolo... *traga saliva*”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001505",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... nada...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0017",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001506",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0300",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"fgact",ch="稟",act="icon",lv=5,id=9,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001507",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡--!!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001508",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿S-Será que... hice que te imaginaras cosas extrañas?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, no, no, para nada, no me imaginé nada! ¡De ninguna forma te imaginé\nmasturbándote con las piernas así de abiertas como hoy!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0007",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001509",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Q-Qué es eso?! ¡Te estás imaginando cosas que no son!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, lo siento, no es bueno que me ponga a imaginar eso, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001510",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. ¡Esa clase de cosas se hacen con más discreción!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001511",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Por supuesto... De ninguna forma lo haría abriendo las piernas como sucedió\nhoy. Nao-kun, has estado leyendo mucho mangas eróticos.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? ¿No es cierto eso de que las chicas se masturban de una forma más\nllamativa y desenfrenada?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0008j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001512",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Escucha! Quizás esté de más que lo diga ahora, pero quisiera que dejes de\nusar tanto la palabra 'masturbar'... Me da pena.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, l-lo siento...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001513",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No sé mucho al respecto, pero... ¿Cómo lo hacen los hombres?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿H-Hacer qué?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0008j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001514",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pues, me refiero al momento en que los hombres hacen 'eso' solos...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-En mi caso?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001515",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No solo tú. Digo, en general.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, normalmente uno solamente sabe cómo lo hace uno mismo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001516",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Entonces... N-Nao-kun, ¿tú también haces eso?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, como toda persona normal, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001517",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué te andas sorprendiendo?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001518",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no... n-no es nada...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001519",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*cof*, en fin, no sé a qué grado te refieres exactamente al decir 'como toda\npersona normal', pero... cuando, tú lo haces... no abres las piernas ni\nchillas en voz alta, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente que los hombres no lo hacen así. Lo hacemos en silencio.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001520",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me lo imagino. Igual nosotras, creo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Ya veo, ahora que lo dice, creo entender.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Y sí, ciertamente, cuando uno se masturba lo hace en silencio.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001521",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No levanto la voz al hacerlo, y además cierro las piernas...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo, así que de esa forma lo haces... sin alzar la voz, y con las piernas\ncerradas... Lo haces dentro del futón, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0014",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001522",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, muchas veces lo hago dentro de mi futón, pero a veces lo hago también\nsentada frente a mi escritorio, o... ¡¿Eh?! ¡S-STOP! ¡¿P-Pero qué me estás\nhaciendo decir?!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, l-lo siento... Mientras más información tenga, más fácil es\nimaginármelo en realidad como es...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001523",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-En realidad?... A-Así que tenías toda intención de imaginarlo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, soy un muchacho que goza de buena salud, yo también. Además, ya te diste\ncuenta al ver la forma como actué hoy, ¿no? Soy la clase de persona que se\ndeja dominar muy sencillamente por su deseo sexual.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0006",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001524",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡C-Contrólate entonces!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0010",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001525",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O bueno, no pienso pedirte eso, pero... imagina todo lo que quieras solo cuando\nyo no esté.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que puedo hacerlo entonces donde quiera que tú no estés?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001526",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo sé. Pero no lo hagas frente a mí.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No entiendo muy bien, pero... está bien...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001527",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hazlo así, por favor.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, e-en fin, los mangas eróticos...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001528",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"cgact",stage="bg023",act="うなづく"},
{"se",id=1,file="se3371"},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0013",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001529",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah, pero qué cantidad de cajas...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he podido tirar todas estas revistas eróticas, así que se me han acumulado.\nAunque aun así, he estado comprando ahora más libros en versión electrónica,\nasí que no se me han acumulado tanto ahora.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001530",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿S-Sí?...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Rin le echa un vistazo al interior de las cajas.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001531",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? ¿Por qué frunces el ceño?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001532",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto es una fotografía...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo es.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001533",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué tienes esto?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, es una revista erótica.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001534",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es una mujer desnuda.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues obviamente que lo es. Es una revista erótica.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",size=10,time=800,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001535",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmmm. Así que también lees esta clase de cosas, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué te estás poniendo de mal humor? No entiendo nada. Aun cuando te la\npasas leyendo mangas eróticos con tanto fervor.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0018",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001536",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo para que sepas, estas fotografías sirven también para practicar dibujando.\nAsí que sí, también tengo esta clase de cosas en mi posesión.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001537",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Para practicar dibujando?...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sirven para practicar dibujos al desnudo. Y, para darte un ejemplo...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Al decir eso, saco una revista de desnudos de hombres.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0013",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001538",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, ¿le vas a los dos lados?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy tratando de mostrarte que el hecho de que también hayan hombres incluidos\nsignifica que la gran mayoría de las fotografías las uso para practicar el\ndibujo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",size=10,time=800,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001539",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jee... Pues, también encontré esta revista... ¿Esto también lo usas para\npracticar tus dibujos, entonces?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Rin saca una revista de publicaciones de fotografías y capturas de video de\nparejas amateur teniendo sexo, y con DVD incluido.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wa, wawah, eso es para otra cosa!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0015",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0017",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001540",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No soy nadie para decir esto, pero... no le veo mucho propósito a dibujar a\notras parejas realizando distintos tipos de juegos íntimos.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, esto es... ehm...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0018",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001541",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Haré énfasis de nuevo en esto. No soy nadie para decirlo, así que puedes\nahorrarte cualquier excusa...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Pero estás como que de mal humor... Rin.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0005",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001542",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te parezco que estoy de mal humor?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"*escalofrío*",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Qué aguda, Rin.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0009",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001543",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento, de ser así la culpa la tengo yo. ¿Por qué me habré comportado de\nesta forma?...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues, es normal que te parezca asqueroso que un hombre lea esta clase de\ncosas.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0310",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001544",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que en realidad no se trata de eso... Fuu... realmente no tengo remedio.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0003",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001545",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es nada. Vamos, busquemos esos mangas eróticos.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0001",head="rin_z2a",lv=5,id=9},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z2/",file="rin_z2a0300",face="a0001",head="rin_z2a",x2=0,x=200,lv=5,id=9},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, en esa cajas hay unos doujinshi no muy apropiado para menores, no la\nabras!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2},
{"bg",file="eveningsky_winter",id=1,lv=1,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bg",file="nightsky_spring",id=2,lv=2,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"se",id=1,file="se1343"},
{"ex",time=1000,func="wait"},
{"se",stop=1,id=1,time=500},
{"se",id=2,file="se3434"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ai, ¿eres tú?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Llamo a la casa Natsume para informarles que regresaré tarde, y de que la cena\nde hoy será la comida preparada que Shizuku compró...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Y entonces...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_aid_000612",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya Shizuku me lo contó todo. Te quedarás hoy en tu apartamento, ¿no? Tienes que\nir allá de vez en cuando. Recuerda que esa también es la casa de Mizuna-san.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_aid_000613",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, procura ir a casa de vez en cuando y hacerle una reverencia con las\nmanos al altar de Mizuna-san antes de dormir.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_aid_000614",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, eso es todo, no te preocupes por nosotros, lo tenemos todo bajo contr--\n¡Ah! ¡Kei! ¡Eso está soltando fuego, apágalo!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Ehm, Ai?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000615",ch="aid"},
},
ja={
{
name={"Ai"},
"“T-Todo bien por acá, puedes quedarte tranquilo. ¡Y bien, me surgió una\nemergencia, así que hablamos después!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"se",id=2,vol=40,file="se3269_2"},
{"text"},
text={
ja={
{
"La llamada se cortó de repente.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",stop=1,id=2,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estarán bien?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001546",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No será buena idea que regreses?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, si regreso ahora Ai se molestará. Confiar en el otro es también una de las\nregla básicas a seguir entre la familia.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001547",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Familia...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, quizás en realidad solo sea de mentiritas, pero aun así, mientras siga en\nesa casa, pretendo comportarme como un miembro más de la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001548",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Es impresionante lo que haces.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nah, no lo es. Y es que la familia Natsume y yo no estamos tan alejados, en\nrealidad...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001549",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi madre, Mizuna Natsume, es la hermana mayor de Ai, Kei y Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001550",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Tanto los Natsume como los Kusanagi mantienen una profunda relación por muchos\notros aspectos también... Aunque, en lo que a esto respecta, hay toda una\ngran serie de hechos y una intrincada historia detrás, así que no puedo\ncontárselo a Rin...",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001551",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Puedo cocinar de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro. Pero ¿no te gustaría cocinar juntos esta vez?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001552",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esa idea me gusta. Sí, claro, con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y después de comer, te agradecería que me ayudaras a estudiar.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001553",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. Puedes estar tranquilo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"msgoff"},
{"bg",file="znightsky_spring",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Después de comer una gran y suntuosa cena, estudiamos juntos.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"No es la primera vez que estudiamos los dos a solas, pero de cierta forma no\npuedo calmarme.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Han sucedido demasiadas cosas hoy como para poder actuar como si nada...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Siento una especie de escozor correr ligeramente por todo mi cuerpo... Siento\nalgo de calor.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Rin también parecía estar en medio de una fiebre de comienzo a fin.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Nuestros cuerpos estaban ahí, pero nuestras mentes en otra parte.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Más o menos se sintió así.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de estudiar, le enseñé un poco más acerca de la pintura a Rin.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Siendo mi apartamento, puedo no solo enseñarle las técnicas de dibujo, sino\ntambién enseñarme acerca de las pinturas de óleo, con pintura de verdad.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Aunque, ya no había tanto tiempo como para poder enseñarle mucho, y el final\ndel día estaba acercándose.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya va a ser la hora del último tren.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001554",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es verdad...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Al darnos cuenta, ya era la hora del último tren.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Se hace relativamente largo ir de Sakuragahara a Kootoha caminando.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Y sobre todo, no puedo dejar regresar a una chica sola a plena medianoche.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Decidí apresurarme y llevar a Rin hasta la estación de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Habían una gran cantidad de mangas eróticos en mi casa, pero por supuesto, no\nera una cantidad que pudiese llevarse en un solo viaje.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Rin estuvo indecisa de cuáles elegir hasta el final, pero todo se resolvió con\nuna propuesta mía.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes venir a tomar otros más prestados después. Si es por eso, podrías venir\nmañana, si quieres.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001555",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mañana? Eso sería muy súbito, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, es solo un ejemplo. No tiene que ser mañana tampoco.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, si voy a seguir enseñándote a pintar hasta que termine la\nExposición Moore, entonces este apartamento es nuestra mejor opción. Tenemos\ntodos los materiales a la mano.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y con más razón ahora que no podemos usar el almacén de la casa Natsume.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001556",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, muchísimas gracias.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001557",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto. Solo, solo suponiendo, que termine de leerme todos los mangas antes de\nque amanezca mañana, ¿podría venir mañana en la mañana de nuevo a\nregresarlos?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001558",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás te sea de mucha molestia que lo haga, pero ¿puedo venir entonces mañana\ntemprano?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es la gran cosa, puedes venir sin tanto rollo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001559",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, no se me es tan fácil como para poder venir sin tanto rollo, pero\naprovecharé la oportunidad y vendré entonces.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Rin sonríe, con su misma sonrisa de siempre.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_olympia_03_1"},
{"text"},
linkback="block_00183",
},
label = {
top={block="block_00000",label=1},
},
}
