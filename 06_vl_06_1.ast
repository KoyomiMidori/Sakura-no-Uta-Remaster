astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bg045a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="man_hdj_000001",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Nos puede comentar qué piensa el colegio respecto a esto?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_hdj_000002",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Ciertos grupos han calificado esto como daño a la propiedad y herencia del\nseñor Kusanagi. ¿Qué podría comentarnos al respecto?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_kys_000043",ch="kys"},
},
ja={
{
name={"Profesor"},
"“¡Esperen, esperen un momento por favor,un representante responderá todas sus\npreguntas dentro de poco!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="bg058a",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_mym_000019",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Dios mío, mire nada más lo que está pasando ahora que se filtró la información.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000356",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No hay problema. Este tipo de situaciones suelen ser aprovechables.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_mym_000020",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Me encantaría que así fuese.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_frd_000357",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Para eso solicitó la opinión de la Fundación Moore, ¿no es así?\nUsted quiere que la Fundación declare que esto no representa daño alguno a la herencia de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_mym_000021",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Sí, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000358",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Entiendo. Pues, estamos dispuestos a colaborar siempre y cuando esto se\ntraduzca en ganancias para nosotros.\n¿Cierto, Naoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo soy un simple profesor... No tengo opinión alguna respecto a este caso.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000359",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“... Un simple profesor, eh.\nYa veo...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_mym_000022",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡¿Q-Que no es obvio?! ¡¿Qué hace un profesor de tiempo parcial acá?! ¡Si ya\nterminaron tus clases vete de una buena vez, muchacho!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000392",ch="htd"},
},
ja={
{
name={"Directora"},
"“Él es el único pariente de Kenichiro Kusanagi, y además quien culminó este\nmural.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_mym_000023",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡Pero sigue siendo un simple profesor! Y además, de tiempo parcial.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000360",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Es más inteligente tenerlo con nosotros acá.\nFue él quien culminó esta obra, y además llegó a ser sucesor legal de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000361",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Lo indicado sería que él certificara esta obra como auténtica.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_mym_000024",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿K-Kusanagi-kun, es que te llamabas? Vas a darle el visto bueno a la obra,\n¿verdad?\nNo irás a decir algo fuera de lugar al último momento, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se preocupe. A mí tampoco me parece que esa obra haya dañado la herencia del\nseñor Kusanagi. No diré nada que pueda ponerla en desventaja.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_mym_000025",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿En serio? No estás mintiendo, ¿verdad?\nSi llegas a estropear esto... Ya sabes qué te espera.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_htd_000393",ch="htd"},
},
ja={
{
name={"Directora"},
"“No hay ningún problema. Él no es ningún tonto.\nSabe muy bien lo que hace.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="フリッドマン",act="うんうん",size=3,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0002",head="fri_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000362",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fufufu, pareciera usted estar algo temeroso de este simple\nprofesor,consejero...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_mym_000026",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“P-Pero qué irrespeto de su parte. ¿Yo, temeroso de este muchacho?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_mym_000027",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Además, estoy seguro en caso de observarlo haciendo algo raro, los otros\nprofesores no se quedarían quietos. ¿Cierto, profesor?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_kys_000044",ch="kys"},
},
ja={
{
name={"Profesor"},
"“Ah, p-por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quiere, podría amarrarme mis propias manos.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_mym_000028",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡¿Qué crees que irán a decir los medios si te ven en ese estado?!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, disculpe. Era solo una broma...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_mym_000029",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Hazme un favor y ahórrame tus malos chistes.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Su actitud contra mí está mucho más agresiva que ayer.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Al parecer está muy vigilante de mí.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"¿Habrá sido Nagayama?\n¿Le habrá dicho que yo no me quedaría sin hacer nada?",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Entiendo muy bien sus razones.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Tengo historial en mi expediente.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La culminación del mural fue ejecutada de la misma forma que un ataque\nterrorista.\nNo me extraña que esté alerta ante mí.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Aunque, por otro lado...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"No pensé que llegaría a venir tanta gente de la prensa.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Cualquiera, y no solo el consejero Murayama, se estresaría ante tanta gente...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=50,file="zbg058a",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0000",face="a0008",head="kan_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_knd_000820",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Nagayama parecía estar temblando.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"¿Miedo de todo su público?...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bgm",stop=1,time=1000},
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",time=1500,sync=1,id=1,lv=5,path=":cg/"},
{"se",file="se0110",loop=1,id=1},
{"text"},
text={
vo={
{"vo",file="man_hdj_000003",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¡¿Cuánto tiempo más nos dejarán esperando?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_hdj_000004",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Por qué el mural está cubierto con lona?\n¡Retiren la lona y revelen lo que hay ahí!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_htd_000394",ch="htd"},
},
ja={
{
name={"Directora"},
"“Silencio, por favor. El señor Fridmann, curador de la Fundación Moore y\nadministrador del señor Kusanagi, dará unas palabras al respecto.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_hdj_000005",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Administrador? ¿Fundación Moore?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_hdj_000006",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Qué hace la Fundación Moore acá?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"cgdel",id=-1},
{"bg",file="ev_com_i07_03",path=":ev/ev_com_i07/",set="ev_com_i07"},
{"bgm",file="bgm027"},
{"text"},
text={
vo={
{"vo",file="man_frd_000363",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Mi nombre es Marty Fridmann, de la Fundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_hdj_000007",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Marty Fridmann? ¿No es usted uno de los curadores de más alto rango de\nMoore?\n¿Por qué se encuentra usted acá?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_frd_000364",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“He venido hoy por encargo del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_hdj_000008",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Por encargo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004218",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo.\nPues entonces tengo una preguntad para usted, señor administrador Fridmann, y además para la Fundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004219",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Podría explicarnos para qué están estas lonas? ¿Cuál es el empeño en intentar\nocultar las cosas? Da la impresión de que ocurrió un accidente, o en su\ndefecto un incidente...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_hdj_000009",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¡Eso nos preguntamos nosotros también!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"El tumulto se extiende entre el equipo de prensa.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Fridmann continúa hablando, sin ningún indicio de verse intimidado por los\nreporteros.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_frd_000365",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tal como indican los rumores, ha ocurrido un incidente pertinente a la herencia\ndel señor Kusanagi. Sin embargo, no se trata de ningún daño a la propiedad,\ncomo algunos han reportado.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_hdj_000010",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Muchos estudiantes han comentado haber visto una especie de graffiti.¿Para\nusted eso no es daño a la propiedad?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_frd_000366",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No se trata de ningún graffiti.\nTras esta lona se encuentra una creación que nosotros, Fundación Moore, hemos reconocido como nueva obra de Kenichiro\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_hdj_000011",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Una nueva obra de Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_mym_000030",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Eh? ¿Obra de Kenichiro Kusanagi? ¿No de Bourbagi?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_frd_000367",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Por supuesto, debo acotar que ha sido el grupo Bourbagi el encargado de su\nelaboración.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_hdj_000012",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Bourbagi? ¿El mismo grupo que ha venido publicando obras controvertidas\nalrededor del mundo?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_hdj_000013",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Espera, espera, ¿Bourbagi? ¿No es eso lo suficiente problemático ya?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_frd_000368",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Creo que sería buena idea pedir la opinión del colegio Yumihari y juzgar si\nrealmente representa un problema o no.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_mym_000031",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ehm, mi nombre es Murayama, trabajo como consejero en la directiva del colegio\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_mym_000032",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Quisiera ofrecer mis más sinceras disculpas por la confusión que ha causado\nnuestro colegio.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_mym_000033",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Sin embargo, debo aclarar que esto no es ningún graffiti, como algunos medios\nhan reportado. Es una obra legítima, tal cual nosotros también hemos\nreconocido.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_hdj_000014",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Está diciendo entonces que el colegio recibió notificación previa por parte de\nBourbagi?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="man_hdj_000015",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Déjeme recordarle que Bourbagi tiene fama por publicar obras sin notificación\nprevia.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_mym_000034",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Eh, respecto a dicha notificación, nosotros no...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_hdj_000016",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Qué razón han tenido entonces para aceptar esta obra?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_hdj_000017",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Este mural se puede ver incluso en los panfletos de la ciudad.Por más derecho\nde propiedad que tenga el colegio, no es apropiado modificarla sin\nautorización alguna. ¿Se consultó esto con la ciudadanía?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_hdj_000018",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Además, el señor Kusanagi ya falleció y no tiene manera alguna de dar\nréplica.\nPor más que el colegio certifique la obra, ¿no podría traer esto problemas?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="man_frd_000369",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Respecto a eso, quisiera presentar la opinión de alguien más.Naoya Kusanagi,\npor favor.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"se",file="se9004",id=1},
{"bg",file="ev_com_i07_04",path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenos días... Soy Naoya Kusanagi, profesor del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_hdj_000019",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Por qué han llamado a un profesor a declarar?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_hdj_000020",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Es usted representante del colegio?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_mym_000035",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Por Dios, obviamente él no es el representante.\nEs solo un profesor a tiempo parcial.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_hdj_000021",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Por qué llamar entonces a un profesor a tiempo parcial?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004220",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Naoya Kusanagi.\nTengo entendido que usted es hijo del señor Kenichiro Kusanagi,\ny además uno de los encargados de la culminación de 'Las huellas de los\ncerezos', ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, está usted en lo correcto...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Toritani pregunta con un tono intencionalmente profesional, y le sigo la\ncorriente.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_hdj_000022",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Ah, ahora que lo menciona...Recuerdo haber oído que fue el hijo del señor\nKusanagi quien culminó dicha obra.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_hdj_000023",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Así que ha estado de trabajando de profesor acá...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_hdj_000024",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Recuerdo que llegó a causar revuelo durante un tiempo.Juraba que hoy en día\nestaría trabajando de artista en el exterior.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Como hijo del señor Kusanagi y encargado de culminar este mural, qué opinión\ntiene usted respecto a este incidente?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no tengo opinión alguna al respecto... Yo solo soy un simple\nprofesor...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo nada que decir...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004222",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Toritani deja escapar débilmente mi nombre de su boca...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Toritani no sabe nada de lo que hicimos.No sabe si logramos nuestro cometido,\nsi fallamos, o si en realidad hicimos algo.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Seguramente fue por eso.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Giro mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy alguien en posición o con la inteligencia de entender algo tan\ncomplicado como el arte moderno.\nAsí que tal vez no pueda dar un comentario apropiado al respecto.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, debo mencionar que en estos días una estudiante me preguntó algo,\na lo cual respondí como profesor de arte.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'¿Es posible percibir diversión en una obra?', preguntó ella.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible sentir la respiración de los autores en su obra?, preguntó también.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí es posible, respondí yo.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que una pintura es como un poema.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegas a percibir a una obra como 'profunda' o 'majestuosa', esa obra ha\nmuerto...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En cambio, si llegas a sentir el aliento de su autor, esa obra está viva, y\nhabrás sido tú quien la revivió.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una pintura, de por sí, no significa nada.\nLas obras viven gracias a sus espectadores.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que ninguna obra está completa.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las obras solo se completan cuando alguien las ve...\nNo, quizá sea mejor decir actualizadas.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ese sentido, el cambio realizado por parte del grupo Bourbagi sobre esta\nobra se podría calificar de legítimo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al menos en el sentido de que una obra se verá siempre en constante\nactualización por parte de sus espectadores...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_mym_000036",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡L-Lo cual quiere decir que reconoces la obra de Bourbagi! ¡¿Cierto?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En base a lo que dije, sí.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_mym_000037",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¡Estás siendo muy poco claro! ¡¿Sí o no?!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_hdj_000025",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿No está usted intentando forzar al profesor a declarar?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_hdj_000026",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¡¿Es que acaso el colegio organizó todo esto?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="man_mym_000038",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Hii...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Bajo mi cabeza un momento, para luego alzarla de nuevo y contestar.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo reconozco esta obra! ¡Y la certifico como nueva obra y herencia de\nKenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="man_mym_000039",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“C-Como podrán ver, el propio hijo del señor Kusanagi acepta esta obra.\n¡Y el colegio Yumihari también!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Confusión y revuelo estallan en el equipo de prensa.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Todos los reporteros acá vinieron con la idea de que esto era un incidente.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Y ahora les acaban de decir que nunca hubo incidente alguno. Es normal que se\nalboroten.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Sin embargo, el colegio no llegó a acordar en ningún momento una rueda de\nprensa.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Fueron ellos quienes se agolparon acá, basándose en información filtrada.No\ntienen derecho a enfadarse.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Pero eso no cambia de ninguna manera la situación de molestia que hay entre\ntodos.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Nagayama estaba completamente pálida.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"La conmoción del equipo de prensa no se detiene.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"La situación no es nada buena.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Fridmann da unas palabras, intentando calmar el ambiente.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_frd_000370",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Silencio, por favor. Procederemos ahora a revelar la obra.\nQuisiera pedirle ahora unas palabras a la representante de Bourbagi, la señorita Kana Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_knd_000821",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"se",file="se9010",id=1},
{"bg",file="ev_com_i07_03",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
ja={
{
"Me bajo del estrado.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_frd_000371",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Llegó tu turno. Vamos.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_knd_000822",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"se",file="se9012",id=1},
{"bg",file="ev_com_i07_05",path=":ev/ev_com_i07/",set="ev_com_i07"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Nagayama se queda parada frente a la obra, sin decir absolutamente nada.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"La fiereza de ayer se había esfumado por completo... Sobre el estrado solo\nestaba una simple artista atemorizada del público.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_knd_000823",ch="knd"},
},
ja={
{
name={"Kana"},
"“A-Auh...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"se",file="se9010",id=1},
{"bg",file="zev_com_i07_05",x=-130,y=280,zoom=90,path=":ev/ev_com_i07/",set="ev_com_i07",ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Fridmann se acerca a Nagayama.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_frd_000372",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿No era este el escenario que tanto deseabas?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_frd_000373",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Vamos, que continúe el show.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_knd_000824",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Show?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="man_frd_000374",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“The show must go on.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_frd_000375",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El show ha comenzado. Ya no puede cancelarse.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="man_frd_000376",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿O es que acaso no eras tú la persona indicada para pararse aquí?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Fridmann le susurra algo en el oído a Nagayama.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_knd_000825",ch="knd"},
},
ja={
{
name={"Kana"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_i07_06",path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000826",ch="knd"},
},
ja={
{
name={"Kana"},
"“M-Mi nombre es Kana Nagayama, del grupo Bourbagi.\nEs un honor para mí tener la oportunidad de presentar esta obra ante todos ustedes.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Su voz estaba algo temblorosa.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Pero sus ojos no eran los mismos de hace un rato. Había en ellos un indudable\nespíritu de lucha.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Probablemente las palabras de Fridmann la azuzaron.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_knd_000827",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Les presento la obra del grupo en Bourbagi, realizada en conjunto con el\ndifunto señor Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",file="se9020",id=1},
{"text"},
text={
ja={
{
"Nagayama corta la cuerda.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Y la lona cayó al suelo como si fuese un telón.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"La prensa se agita.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"La presentación previa no fue nada buena.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Y sin embargo, Nagayama jaló el telón.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_hdj_000027",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿E-Esta es la dichosa obra?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_hdj_000028",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Qué tiene de diferente esto de un graffiti?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_hdj_000029",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Vaya agallas tiene el colegio de haber aceptado semejante modificación.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_hdj_000030",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Creo que sería mejor preguntar por qué demonios la Fundación Moore se ha metido\nen esto...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_i07_09",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
ja={
{
"Las opiniones negativas no se detienen.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Es como si intentaran descargar la furia de haber sido mostrados algo\ntotalmente distinto a lo que esperaban.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_htd_000395",ch="htd"},
},
ja={
{
name={"Directora"},
"“El ideal del grupo Bourbagi es el factor 'incidente', y por tal razón no\nrecibimos notificación alguna. Estuvimos discutiendo qué hacer respecto a la\npublicación, pero la noticia se esparció ayer, y...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="man_hdj_000031",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Ha habido un boom de arte gracias a Rin Misakura y su trabajo en Estados\nUnidos. Esto hubiese sido impensable hace unos años.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_hdj_000032",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¡¿Hubiese sido?! ¡Esto sigue siendo impensable!\n¡Es un simple graffiti!\n¡¿Los ciudadanos de Yumihari han aprobado esta modificación?!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_mym_000040",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Eh? No, respecto a eso...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_iue_000001",ch="iue"},
},
ja={
{
name={"???"},
"“Vamos, que es marzo todavía. A esta hora el sol todavía no alcanza la iglesia.\nCreo que en este estado los señores del equipo de prensa no pueden apreciar\nla obra en todo su esplendor.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_hdj_000033",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Quién es usted?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_iue_000002",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Mi nombre es Inoue, trabajo como consejero en la directiva del colegio.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_mym_000041",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“Ah, este es el consejero Inoue, del hospital general de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_iue_000003",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Disculpe por dejarle todo el trabajo a usted, consejero Murayama. Qué\nvergüenza, lo único que he podido hacer es darle el sí a todas sus\npropuestas...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="man_mym_000042",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿P-Podría mejor explicar qué hace acá, y en este momento?...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_iue_000004",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Ya se acerca el momento.\nSí, creo que ya es hora.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_mym_000043",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Ya es hora? ¿Hora de qué, si se puede saber?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_iue_000005",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“En este momento mi hospital está bloqueando el paso de la luz solar, impidiendo\nque la obra revele su verdadera forma. Pero el sol está a punto de alzarse\nsobre el edificio.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_hdj_000034",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“No hace falta que el sol le apunte para saber qué tan mala es esta obra.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_hdj_000035",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Así el colegio y la Fundación Moore hayan aprobado esto, ni los estudiantes o\nlos ciudadanos han dado su aprobación.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_iue_000006",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Vamos, vamos, esperemos un poco más... Para apreciar el buen arte se requiere\ncalma.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="man_hdj_000036",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¡Pues aquí lo menos que tenemos es calma! ¿Cuánto más deberíamos esperar? ¿Diez\nminutos? ¿Media hora? ¿Una hora?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_iue_000007",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Unos tres minutos con cuarenta y cinco segundos.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_hdj_000037",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿D-De dónde sacó esa cuenta tan minuciosa?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_iue_000008",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Esa cuenta minuciosa es muy importante.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"El consejero Inoue se vuelve hacia mí.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Asiento con fuerza.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"He estado calculando el movimiento del sol día a día, por un largo tiempo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Lamentablemente no tuvimos mucho tiempo para prepararlo todo.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Pero aun así debería salir bien.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Proezas de este tipo no se logran sin este nivel de agallas.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Así que――",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="man_iue_000009",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Oh, miren todos, ya va a aparecer el sol. Deberían ir preparando sus cámaras,\nles aseguro que saldrán muy buenas fotos.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="man_hdj_000038",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Por qué tendríamos que esperar por el sol? ¿Qué necesidad hay de preparar\nlas... ¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_knd_000828",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qué?!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_mym_000044",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿E-Esto es?...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Nadie supo lo que había sucedido.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Sin embargo, todos percibieron el color a su alrededor.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"bg",file="ev_uni_c65_01",style="raster",inter=1,ssize=2,ease="in",sfade=500,path=":ev/ev_uni_c65/",set="ev_uni_c65"},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="man_hdj_000039",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Q-Qué, qué es esto? ¿Colores?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Una gama de colores envuelve al equipo de prensa.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Y es que en este justo momento estábamos todos envueltos en un mar de\ntonalidades.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_knd_000829",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué significa esto? ¿Se están moviendo los colores?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_mym_000045",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿Y-Y esto? ¿Qué está pasando aquí?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_iue_000010",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Digamos que mi fijación por el arte es de la más fuerte entre toda la\ndirectiva.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="man_mym_000046",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“¿D-De qué está hablando?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_iue_000011",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Cuando escuché de usted lo de Bourbagi, supe que me habían embaucado.A mí me\ngustaba 'Las huellas de los cerezos', y estaba en contra de lo hecho.\nPero la información se filtró a los medios, y... ya no podía hacer nada.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_iue_000012",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“Me embaucaron, pensé... Aunque, parece que en lo que concierne a 'incidentes',\nla familia Kusanagi le hace muy buena competencia a Bourbagi...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_uni_c65_01",style="raster",inter=2,ssize=2,ease="in",sfade=60000,sync=0,face=1,time=400,path=":ev/ev_uni_c65/",set="ev_uni_c65"},
{"text"},
text={
ja={
{
"Los colores siguen moviéndose.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Y se desplazan desde nuestra posición, moviéndose justamente hacia...",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Y entonces――",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="man_hdj_000040",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Ohhh, ¿esto es--?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"La conmoción de ahora era distinta a la de hace un rato.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Había asombro.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Y admiración.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Y es que ahí había ahora una obra.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000154",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Kusanagiii! ¡Bastardooo!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Thomas grita.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Sin embargo, sus gritos no iban a lograr nada.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"La pintura sigue moviéndose.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Su movimiento, indetenible.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Para detenerlo habría que detener al mismo sol.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="man_iue_000013",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“¡Y aquí tienen, señores! ¡La verdadera obra realizada por el grupo Bourbagi, en\nconjunto con Kenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_knd_000830",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="man_mym_000047",ch="mym"},
},
ja={
{
name={"Consejero Murayama"},
"“E-Esto es--”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",style="raster",ease="out",file="ev_uni_c64_01",path=":ev/ev_uni_c64/",set="ev_uni_c64"},
{"ex",time=500,func="wait"},
{"se",file="se2340",vol=50,id=1},
{"bg",file="zev_uni_c66_01",id=2,lv=2,zoom=53,alpha=255,time=1000,path=":ev/ev_uni_c66/",z2=50,set="ev_uni_c66",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_uni_c66_02",id=3,lv=3,zoom=55,alpha=128,time=1000,path=":ev/ev_uni_c66/",z2=50,set="ev_uni_c66",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="zev_uni_c66_03",id=4,lv=4,zoom=60,alpha=128,time=1500,path=":ev/ev_uni_c66/",z2=50,set="ev_uni_c66",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=700},
{"ex",time=0,func="wait"},
{"bg",time=0,sync=0,file="ev_uni_c66_04",path=":ev/ev_uni_c66/",set="ev_uni_c66"},
{"cgdel",id=-1},
{"text"},
text={
ja={
{
"La luz se impone como pigmento sobre la pintura plasmada por Bourbagi.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Y la gama de colores fue, poco a poco, acercándose a la forma original del\nmural. A 'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_knd_000831",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Vitrales?!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="man_iue_000014",ch="iue"},
},
ja={
{
name={"Consejero Inoue"},
"“¡Así es! En la azotea de nuestra clínica hay un enorme soporte para cristales.\n¡Y el señor Kusanagi, todavía en vida, intentó usarlo para crear un mural!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_knd_000832",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿En vida?! ¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Las huellas de los cerezos' todavía no había sido culminada cuando el señor\nKusanagi seguía con vida.Aun estando internado en la clínica, él tenía el\ndeseo de terminarla.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, por su condición física no se le permitía salir del hospital.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que él mismo ideó un plan para completar el mural desde el hospital general\nde Yumihari, donde se encontraba internado. Sin tener que acercarse al\ncolegio.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="man_hdj_000041",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Sin acercarse al colegio? ¿Desde el hospital?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Él intentó plasmar color en la iglesia desde el hospital.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él ideó esta forma de hacerlo, y sin tener que acercarse a ella.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y este, este es el mural, la idea original que tuvo él y no pudo realizar en\nvida, la idea de usar vitrales para plasmar luz!”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esta es la forma final y original que él tenía en mente de 'Las huellas de los\ncerezos'!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",file="ev_com_i07_08",path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
vo={
{"vo",file="man_frd_000377",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡Y por esa razón la Fundación Moore certifica esta obra como nueva obra del\nseñor Kenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="man_frd_000378",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¡De no ser así, jamás nos hubiésemos atrevido a certificar la obra de un grupo\nsin relación alguna a él!”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="man_hdj_000042",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“¿Dice usted que el señor Kusanagi planificó todo esto en vida?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="man_hdj_000043",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Pero ese graffiti estaba basado en el gran terremoto. El señor Kusanagi no pudo\nhaber planificado eso...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_frd_000379",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El primer plan consistía simplemente en reflejar luz sobre una pared en\nblanco.\nLo cual terminaría como una simple proyección.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="man_frd_000380",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Era necesario una capa base, sí o sí.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="man_frd_000381",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y se podría decir, como no, que fue el señor Naoya Kusanagi quien elaboró esa\ncapa con 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="man_frd_000382",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sin embargo, la modificación realizada por Bourbagi le da un giro de corrupción\ny oscuridad a la obra al incorporar el gran terremoto.\nY es eso justamente lo\nque acentúa la belleza del trabajo original.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="man_hdj_000044",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Ciertamente.... Sí, la oscura temática del terremoto es lo que acentúa la luz\nen esta obra...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="man_hdj_000045",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Solo parecía ser un simple graffiti, pero al reflejar la obra original sobre\nella toma un sentido completamente distinto.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_hdj_000046",ch="hdj"},
},
ja={
{
name={"Prensa"},
"“Además, fue planificada por el señor Kusanagi... Y ahora que la Fundación\nMoore ha dado su visto bueno...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"La atmósfera del equipo de prensa había cambiado súbitamente.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"No hay que negar que la obra como tal tuvo impacto, aunque la explicación de\nFridmann también contribuyó bastante.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Obra planeada por Kenichiro Kusanagi en vida.Y ahora, certificada por la\nFundación Moore como nueva obra suya.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Era más que suficiente para persuadirlos a todos.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahí tienes tu explicación, Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bg",file="ev_com_i07_07",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000833",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿P-Pero cómo lograste fabricar tantos vitrales en tan poco tiempo?\nEspera, ¿no me digas que Kenichiro Kusanagi los tenía guardados?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada de eso.\nAdemás, si ese fuera el caso, la Fundación Moore lo habría anunciado hace años.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_knd_000834",ch="knd"},
},
ja={
{
name={"Kana"},
"“Entonces, ¿cómo?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿cómo harías tú para fabricar un vitral en una sola noche? Siéntate y\npiénsalo.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de todo tú eres la experta en este estilo de arte sorpresa, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000835",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Kuh!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Nagayama mira la obra con furia.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Las huellas de los cerezos brillaban ahora sobre la pared, mientras que la obra\nde Bourbagi se redujo a una simple capa inferior.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Esta versión de 'Las huellas de los cerezos' hecha en luz no iba a durar mucho,\npero era eso lo que le daba el toque interesante como obra.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Tiene suficiente presencia.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"El equipo de prensa no estaba convencido por completo, pero tuvieron que\naceptar parcialmente lo que había pasado.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Y esto de verse envuelto en una obra de luz es también una nueva experiencia\npara mí. Y una asombrosa, debo decir.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Su mera presencia basta para convencer a cualquiera.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Fue un éxito.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"bg",file="ev_com_i07_10",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000836",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jejeje...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nagayama...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_knd_000837",ch="knd"},
},
ja={
{
name={"Kana"},
"“Definitivamente sigues siendo el hombre que tanto me fascinaba, Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias, aunque esta es otra herencia más de Kenichiro Kusanagi. No es obra\nmía.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_knd_000838",ch="knd"},
},
ja={
{
name={"Kana"},
"“Te equivocas. ¡Es trabajo conjunto entre Kenichiro Kusanagi y nosotros, el\ngrupo Bourbagi!”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Nagayama se vuelve hacia el equipo de prensa.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"El temblor de hace rato había desaparecido por completo.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Y comienza a explicarle a los medios con un tono de voz fuerte y seguro.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"bg",file="ev_com_i07_11",sync=0,face=1,time=400,path=":ev/ev_com_i07/",set="ev_com_i07"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000839",ch="knd"},
},
ja={
{
name={"Kana"},
"“Esta es la verdadera forma de la nueva obra del señor Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_knd_000840",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Nuestra obra no fue nada más que una base, un lienzo para acentuar la suya!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_knd_000841",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Pero debemos recordar que nuestra hermosa cotidianidad fue manchada en\noscuridad tras el terremoto, tal cual lo describe nuestra pintura!”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_knd_000842",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Y eso le da significado al hermoso paisaje que el señor Kusanagi nos dejó!”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_knd_000843",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Nuestra pintura fue solo una base para resaltar aún más esta obra de luz!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Elogios, gritos, insultos, admiración.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Se cruzan todo tipo de palabras entre sí.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"A pesar de eso, Nagayama sigue explicando firmemente la obra.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Nagayama se ha convertido en toda una artista.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Eso pensé al verla.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
