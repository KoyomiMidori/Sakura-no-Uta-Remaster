astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_com_a01_07",time=1500,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"bgm",file="bgm005"},
{"text"},
text={
vo={
{"vo",file="man_ked_000090",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Bien, espero una buena respuesta tuya!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una buena respuesta?... ¿Qué se supone que es una buena respuesta para ti?...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_ked_000091",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No es obvio? ¡Que decidas vivir con nosotros!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas eso. Si sigues diciéndolo...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sinceramente me harás sentir náuseas de lo repugnante que te ves...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bg",file="ev_com_a01_05",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000092",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué dices?!”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_aid_000090",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por cierto, Kei, ya casi son las cinco.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",file="ev_com_a01_04",sync=0,face=1,time=400,path=":ev/ev_com_a01/",set="ev_com_a01"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000093",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Eehhh?! Awawawawa, ¡v-voy a buscar la moto!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás tan alterado?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_aid_000091",ch="aid"},
},
ja={
{
name={"Ai"},
"“Parece que esta funeraria está administrada por la alcaldía, así que el\nestacionamiento cierra a las cinco.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces deberías apresurarte... Va a cerrar en 5 minutos.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000094",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Hiii, esto no está bien!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bgm",stop=1,time=2000},
{"se",file="se0744s",id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Tras decir eso, Kei desapareció dentro del estacionamiento al lado de la\nfuneraria.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_com_a05_03",path=":ev/ev_com_a05/",set="ev_com_a05"},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000092",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, creo que yo también debería irme ya...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O-Oye... Ai.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000093",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Mm? ¿Qué pasa, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, esto--”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_aid_000094",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué sucede? Si tienes algo que decirme, dilo rápido...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias... por haber asistido a su funeral...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_a05_04",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000095",ch="aid"},
},
ja={
{
name={"Ai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000096",ch="aid"},
},
ja={
{
name={"Ai"},
"“Puh... ¿Qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa? Tal como lo ves, estoy dándote las gracias.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000097",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jeje, realmente no eres nada franco, eh...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué lo dices?!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_aid_000098",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Entonces por qué lo dices apartando la vista y con cara de malhumor?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_aid_000099",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi... No, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_aid_000100",ch="aid"},
},
ja={
{
name={"Ai"},
"“No has cambiado nada...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_uni_c08_01",path=":ev/ev_uni_c08/",set="ev_uni_c08"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000101",ch="aid"},
},
ja={
{
name={"Ai"},
"“Las flores de este bosque de cerezos han florecido completamente, ¿no crees?...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No cambies el tema...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_aid_000102",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por más que las veas, las flores de cerezo florecen siempre de la misma manera,\ny se dispersan también de la misma manera.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_aid_000103",ch="aid"},
},
ja={
{
name={"Ai"},
"“A pesar de que no son las mismas... las flores de cerezo de hace 10 años\nflorecen de la misma manera que las flores de ayer...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_aid_000104",ch="aid"},
},
ja={
{
name={"Ai"},
"“Te hace pensar, ¿acaso no serán las mismas?...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_aid_000105",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero, probablemente no sea así.",
{"rt2"},
"Seguramente las flores de cerezo han venido floreciendo de la misma manera, sea\nhace 100, 1000 o incluso 10000 años atrás...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_aid_000106",ch="aid"},
},
ja={
{
name={"Ai"},
"“A pesar de que nadie las vea, florecen de igual manera que la noche anterior...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_aid_000107",ch="aid"},
},
ja={
{
name={"Ai"},
"“Desde hace bastante, bastante tiempo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_aid_000108",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso, las flores de cerezo me parecen terroríficas...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_aid_000109",ch="aid"},
},
ja={
{
name={"Ai"},
"“El día en que nos vimos por primera vez, también... estaban floreciendo las\nflores de cerezo.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_aid_000110",ch="aid"},
},
ja={
{
name={"Ai"},
"“Como un bosque de cerezo completamente florecido...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... porque nací en abril.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_aid_000111",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me sentí feliz en aquel momento...",
{"rt2"},
"A pesar de que realmente debí haberme sentido frustrada,",
{"rt2"},
"la verdad es que me sentí realmente feliz...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Realmente debí haberme sentido frustrada.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"No entiendo lo que quiere decir con eso.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Pero, de cierta manera pude deducir ese significado al observar la expresión de\nsu cara.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"La razón por la cual se sintió frustrada, y también feliz respecto a mí...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="zev_uni_c09_01",speed=240000,path=":ev/ev_uni_c09/",set="ev_uni_c09",x2=310,y2=170,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_aid_000112",ch="aid"},
},
ja={
{
name={"Ai"},
"“Una ilusoria apariencia del color de primavera, recubriendo el cielo.",
{"rt2"},
"Solo alumbra, brillante, radiante, deslumbrante,",
{"rt2"},
"ciegamente, sin pensarlo, esa lámpara de causalidad enlazada.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_aid_000113",ch="aid"},
},
ja={
{
name={"Ai"},
"“Un magneto de sandía,",
{"rt2"},
"el punto de cruce del sonido y las palabras,",
{"rt2"},
"cada vez más dentro de un mundo excesivamente coloreado.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_aid_000114",ch="aid"},
},
ja={
{
name={"Ai"},
"“Los siete cerezos me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_aid_000115",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vinieron hacia mí y me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_aid_000116",ch="aid"},
},
ja={
{
name={"Ai"},
"“Más allá del paisaje, no estoy yo,",
{"rt2"},
"y más allá de mí, no está el paisaje.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_aid_000117",ch="aid"},
},
ja={
{
name={"Ai"},
"“Persiguen, sobrepasan, y desaparecen.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_aid_000118",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y este mundo suavemente envuelto va desapareciendo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_aid_000119",ch="aid"},
},
ja={
{
name={"Ai"},
"“El mundo resonó, dentro de ese suave bosque de cerezos.",
{"rt2"},
"El mundo resonó con un hermoso tono.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si eso es el vacío, entonces el mismo vacío es así,",
{"rt2"},
"y hasta cierto grado, es compartido por todos.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"(Y así como el todo son todos dentro de mí,",
{"rt2"},
"también así es el todo dentro de cada uno de todos)",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_uni_c09_01",path=":ev/ev_uni_c09/",set="ev_uni_c09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese poema termina con un extracto de la obra de Kenji Miyazawa, Haru to Shura\n- Prólogo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mejor conocido como “Sakura no Uta”. Dicen que hizo de su obra algo incluso aún\nmás indescifrable.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_aid_000120",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De qué manera percibes ese poema, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna... No hay razón por la cual yo deba pensar en las palabras que dejó\nese hombre...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo que, al escuchar ese poema, recuerdo la frase que él siempre solía usar.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_aid_000121",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿La frase que siempre usaba?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“What is mind? No matter.",
{"rt2"},
"What is matter? Never mind.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_aid_000122",ch="aid"},
},
ja={
{
name={"Ai"},
"“'What is mind?'... ¿Qué es la mente? 'No matter', no es materia. 'What is\nmatter?',",
{"rt2"},
"¿qué es la materia? 'Never mind', de ninguna manera es la mente. ¿Algo así?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es así. La versión correcta es――”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'What is mind?' ¿Qué es la mente?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'No matter'. No importa.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'What is matter?'. ¿Qué son las cosas?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Never mind'. No te preocupes por eso.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso significa.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_aid_000123",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué el poema anterior te recordó a esa frase?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea... no lo sé muy bien. Simplemente se me ocurrió...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_a05_03",path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000124",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo. Eso es muy de ti, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_aid_000125",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bastante jugó y aún juega con nosotros, eh...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Jugó con nosotros.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Sí...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Aunque trate de negarlo... esa es la realidad.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Esa es la única manera posible de describirlo...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, ese imbécil me manipuló bastante...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000126",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿A qué viene eso? Te tornaste sincero de repente.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No llegué a pasar mucho tiempo con Kenichiro Kusanagi, pero...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Había algo que pensaba hacer la próxima vez que lo viera...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000127",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Algo que pensabas hacer?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque ahora ya no puedo hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_aid_000128",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué querías hacerle a Kenichiro, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería darle una paliza. En fin, un buen golpe a la cara.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000129",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajajaja, ya veo, pero siendo como era él, si lo golpearas contraatacaría\nrápidamente.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ser así, lo golpearía tanto como él contraatacara.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si pudiera golpearlo más de lo que me golpeara él a mí, al final...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Aprieto mis puños.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Con bastante fuerza.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo con eso hubiera quedado satisfecho.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Ai sonríe suavemente.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_aid_000130",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me hubiera gustado verlo...",
{"rt2"},
"Una pelea entre Kenichiro-san y Naoya.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que deberías más bien pararnos, ¿no? Como profesora que eres.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000131",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajajaja, ciertamente. Si realmente sucediera, tendría que detenerlos a los\ndos...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si realmente... sucediera... eh.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_a05_01",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000132",ch="aid"},
},
ja={
{
name={"Ai"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque ya es imposible que suceda, por la eternidad.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_000133",ch="aid"},
},
ja={
{
name={"Ai"},
"“L-Lo siento. Creo que ensombrecí un poco la atmósfera al final.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, tranquila.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no había mas nada que me quedara por hacer con ese hombre...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque yo llegué a ponerle orden, de varias formas, y a mi manera... a mi\npropia relación con él...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, lo deprimente y sombrío eran las cosas que él más odiaba.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no pude disfrutar esto, pero por lo menos pude despedirlo sin dejar\ntantas sombras en mi corazón...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
ja={
{
"Ai asiente ligeramente ante mis palabras.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_000134",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_000135",ch="aid"},
},
ja={
{
name={"Ai"},
"“Has pasado por muchas cosas, ¿no, Naoya?...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_aid_000136",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajaja, bueno, creo que me iré ya...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_a05_02",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000137",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, cierto. Lo que hablamos hace un momento. Piénsatelo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... lo de comenzar a vivir en la mansión Natsume, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_a05_03",sync=0,face=1,time=400,path=":ev/ev_com_a05/",set="ev_com_a05"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000138",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estaré esperando una buena respuesta.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"se",file="se9004",id=1},
{"bg",file="zev_uni_c03_02",zoom=70,speed=240000,time=1500,path=":ev/ev_uni_c03/",set="ev_uni_c03",x2=-384,y2=-216,x=384,y=216,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"La silueta de Ai desapareció,",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Y la brisa resonó.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"A lo lejos, el viento está sonando.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Un ligero sonido de rugido, similar a un zumbido.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"No hay ningún hermoso tono que suene debajo de este bosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Simplemente los suaves pétalos blancos son dispersados por todos lados por el\nzumbador viento.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Un escenario ordinario.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_uni_c03_02",time=1500,path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... creo que yo también me iré...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bgm",stop=1,time=10000},
{"text"},
text={
ja={
{
"Susurro a manera de monólogo, sin dirigirme realmente a nadie.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Con un rugido de tono ligeramente sucio, vuelan soplados los pétalos de las\nflores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Le di el último adiós a mi padre, quien falleció en el día en que los cerezos\nflorecen.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"bg",file="ev_uni_c03_03",time=4000,path=":ev/ev_uni_c03/",set="ev_uni_c03"},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=1500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg037b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=2000},
{"bgm",file="bgm017"},
{"text"},
text={
ja={
{
"Pensaba en regresar directamente a casa, pero mis pies se dirigieron a este\nlugar.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Al darme cuenta, estaba caminando esa colina pavimentada con adoquín sobre la\ncual pongo mis pies todos los días, jadeando un poco.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Esta colina, que conecta hacia el colegio al cual asisto, estaba, al igual que\nel lugar del funeral de papá, cubierta de flores de cerezo.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"'Yumenouki-saka (La colina donde flotan los sueños)'",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Es un nombre que parece tener bastante historia por detrás, pero de la cual no\nconozco mucho.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Simplemente he escuchado que ese nombre surgió en base a una gran cantidad de\ntradiciones.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063f",path=":bg/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"A un lado de esta cuesta hay un pequeño santuario, de esos que podrías llegar a\nver en los terrenos de un templo.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Son de esos que llaman Sessha o santuarios auxiliares.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Aquí se guardan los emaki con las pinturas del Barco del Tesoro.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Aquellos que entiendan el significado de esa frase pueden, quizás, imaginarse\nun poco la historia del nombre del 'Yumenouki-saka'.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Al subir por la colina Yumenouki, los puntiagudos sombreros de la capilla que\nse ubica dentro del terreno del colegio se dejan ver.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg043b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Una única y característica silueta, construida mediante la intersección de\narcos apuntados.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Este colegio, construido sobre la cima de la colina de Yumihari, la cual está\natestada con árboles de cerezo, se llama colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Me cruzo con una persona al terminar de subir las escaleras.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"La sombra parada encima de esa colina con poca gente, iluminada por el sol del\natardecer, era impresionante.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El uniforme de esa chica no era del colegio Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Habrá venido a ver el colegio?...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Al estar en vacaciones de primavera, no hay casi presencia de personas en los\nalrededores de Yumihari. La gran mayoría de los clubes terminaron,\nprobablemente, sus actividades en el transcurso de la mañana.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Al atravesar la puerta principal andando con pasos largos, me apresuré hacia el\nlugar al cual me dirigía.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"El colegio Yumihari, el cual fue un colegio católico por un tiempo después de\nla guerra, era, para ese entonces, un colegio donde solo se impartía\nteología.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Era, según dicen, un colegio bendecido por Dios, al cual asistían los devotos\nhijos de familia.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Sin embargo, en la actualidad dejó de ser un colegio de teología y pasó a\nconvertirse en un colegio normal.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Antes de eso.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"La historia del terreno de este colegio antes de la guerra es bastante vieja.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Parece que el colegio como tal comenzó como un colegio de inglés fundado por\nextranjeros que llegaron durante la era Meiji, pero podemos remontarnos aún\nmás al pasado.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Por supuesto, antes de la era Meiji, no era ningún lugar moderno de educación.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Pero aun así, se dice que para la era Edo había una edificación educativa sobre\neste terreno.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Aunque las denomine como 'edificación educativa', parece que era algo con un\ntono mucho más religioso, distinto a los usuales 'Shuseki shinanjo'\nobservados en la era Edo.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Y aún mucho más antes... para los comienzos de la era Kamakura, se dice que\neste terreno sirvió a muchos practicantes del Shugendou para aislarse de la\ncivilización.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Por ser una tierra con bastante historia, posee una gran cantidad de\ntradiciones, lo cual la hace ver como una 'Yumenouki-saka' o colina donde\nflotan los sueños.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"El nombre de Yumihari proviene, según una cierta hipótesis, de una vieja\nleyenda.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Aunque, una leyenda ya olvidada.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"No es una leyenda de la que muchos sepan.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La colina donde flotan los sueños, en la tierra de Yumehari, eh...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Era como si los sonidos de mis propios pasos se escucharan en esa vieja\nedificación rodeada por los cerezos.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="black",path=":bg/"},
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Abro la un tanto averiada puerta y entro al salón.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"El característico olor de un atelier abrasado por la luz inclinada llenaba el\nsalón.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"El atelier, ubicado en el piso más alto, recibía en buena cantidad la luz\nexterior, y estaba pintado con el mismo color del cielo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Me abro lugar entre las desordenadamente dispuestas largas sillas y mesas del\nsalón, y camino hacia el final de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"msgoff"},
{"se",file="se9012",vol=60,id=1},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=470,y=-440,speed=5000,file="zbg049j",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=0},
{"cgact",stage="zbg049",act="びっくり",loop=3,size=4,time=500},
{"ex",time=2500,func="wait"},
{"text"},
text={
ja={
{
"Ahí estaban cada uno de los instrumentos y accesorios usados por los miembros\ndel club de arte, y también estaba enterrado lo que yo estaba buscando.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Aparto a un lado un caballete que tenía escrito con marcador, 'De Kei Natsume',\ny debajo de él apareció un viejo caballete, recubierto con varios tipos de\ndistintas pinturas.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Este caballete...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg036a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_rou_000001",ch="rou"},
},
ja={
{
name={"Anciano"},
"“Para esta primavera planeamos organizar una exhibición retrospectiva del\nmaestro Kenichiro Kusanagi, así que, de ser posible, ¿podría hacernos llegar\nuna de sus obras, así como algún instrumento usado por el señor?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Fue el mismo día del funeral de papá que el director de una galería de arte con\nel cual se la llevaba muy bien me pidió eso. Es decir, hoy.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"'De ser posible, quisiera que nos otorgara una de las posesiones del señor\nKusanagi para adornar un rincón preparado para él en la galería después de\nrealizar su exhibición retrospectiva'. Eso fue lo que me pidió.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"El anciano director, con cara de muy buena gente, enderezó su ya encorvada\ncintura y me propuso eso.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,x=470,y=-440,file="zbg049j",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"De ninguna manera me pidió que me apresurara.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Probablemente, no hay problema alguno con que lo mande dentro de unas\nsemanas...",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que con esto bastará, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Fue algo que papá me dio cuando era un niño.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Era un robusto y relativamente grande caballete que, la verdad, no era algo\npara que un niño usara, pero aun así, me esforcé y lo usé.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Junto a ese misterioso expansor...",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... solo con recordarlo me irrita...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Solo hay cosas irritantes dentro de todas mis memorias relacionadas con\nKenichiro.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo veo, no es tan grande, eh...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Está perfecto como para usarlo ahora.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"se",id=1,file="se1107"},
{"quake",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Al jalar el caballete y ponérmelo sobre el hombro, los otros caballetes\namontonados uno sobre el otro se desmoronaron al mismo tiempo.",
{"rt2"},
"La luz del sol que entraba por la ventana daba a ver el polvo que volaba\nalrededor.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja... demonios. Debí haberlo hecho después, cuando hubiera alguien del\nclub de arte adentro...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"La mayoría de las cosas que me piden se me olvidan en unos cuantos días.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Soy del tipo que no descansa hasta que termino de hacer lo que me piden los\ndemás...",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sirve de nada llorar por la leche derramada...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"La montaña ya desmoronada de caballetes no regresará a su estado original...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"'¡Por supuesto que sí!'",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"No hay nadie que diga eso, así que me retiraré rápidamente.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg037i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"A medida que la brisa acaricia mi piel.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Las filas de árboles de cerezos suenan silenciosamente, y esparcen los\nfragmentos de melocotón blanco alrededor.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí que es pesado...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Así como robusto, también pesado es este caballete.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuuh...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Mis pies se detienen naturalmente.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Como si los pétalos que caen revoloteando estuvieran bloqueándome el paso.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"En ese momento――",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"bgm",stop=1,time=500},
{"se",id=1,file="se2340"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg037j",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="106r",time=300,sync=1},
{"bg",time=100,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡――!",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Un repentino viento corrió por la colina Yumenouki, como si atravesara mi\ncuerpo",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Desde que nací en esta ciudad, he subido cientas, no, miles de veces esta\ncolina Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Y cada vez me daba una sensación distinta.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"La melodía de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Es como si todos los cerezos sonaran, resonando ante algo――",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Un solapamiento de extrañas reverberaciones.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Cubro mis ojos con mi brazo, como tratando de evitar las flores de cerezo que\nvuelan hacia arriba.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Y de repente――",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"El viento se detuvo.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"El crujido de los árboles se detuvo, y al instante, el silencio se apoderó del\nmundo.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Pero, justo después me di cuenta de que eso era solo una ilusión.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"El crujido de los majestuosos árboles, el bullicio de la ciudad que se\nescuchaba a lo lejos―― todo eso desaparece,",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"y fue como si se acentuara el color que caía ante mi vista.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Dentro del silencio que había dentro del sonido.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Como si algo me invitara a hacerlo, elevé mi cara.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Mi vista pintada de concreto se amplía.",
{"rt2"},
"Lenta, lentamente",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="zev_com_a07_01",speed=60000,time=3000,path=":ev/ev_com_a07/",set="ev_com_a07",x2=-160,y2=-110,x=-290,y=-110,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm038",time=500},
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"¿Una muchacha?",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_szd_000001",vol=10,ch="szd"},
},
ja={
{
name={"???"},
"...",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"¿Quién... es?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"¿Será que nos hemos visto en alguna otra parte?...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Una blanca piel que no reflejaba casi ningún otro color, y una bastante\nagraciada y bien formada nariz y ojos. Facciones visiblemente agraciadas aún\na la distancia.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Y unos labios fuertemente cerrados, como si estuviera conteniendo todo tipo de\nsentimiento.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Su expresión, con ojos bajos, me daba una impresión fría...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"La mirada de la muchacha estaba directamente dirigida hacia mí.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bg",file="ev_com_a07_01",time=2000,zoom=100,speed=2000,z2=103,path=":ev/ev_com_a07/",set="ev_com_a07"},
{"text"},
text={
ja={
{
"En el instante en que vi esos ojos...",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Estuve a punto de decir su nombre.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Pero――",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"se",id=1,file="se2340"},
{"bg",rule=088,time=150,file="white",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡――!",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"El sonido del viento.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"El balance del sonido se rompe, y mi vista se tiñe con el blanco de los\ncerezos.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"El viento que se eleva hacia arriba me hace perder la visión por un momento.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Y entonces――",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg037j",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bg",sync=1,file="bg037i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desapareció...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"La colina de Yumehari retoma el silencio de nuevo.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Como...",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Como si todo...",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Se lo hubiera llevado un sueño de cerezos.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="00_op_02_1"},
{"text"},
linkback="block_00246",
},
label = {
top={block="block_00000",label=1},
},
}
