astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Entre la mansión Natsume y mi apartamento solo hay una estación de distancia.\nNo llegué de inmediato, pero sí todavía durante la mañana.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Corrí hasta llegar cerca de la mansión, pero me detuve.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué hace eso ahí?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Cerca de la mansión estaba estacionado un vehículo negro que jamás había visto\nantes.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Es enorme.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué raro esto. ¿De quién es ese coche?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Ya varias veces he venido a donde los Natsume, pero nunca había visto ese\nvehículo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Y encima de eso, había un hombre parado frente al portón.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que fue buena idea no haber traído a Kuzu...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Fue entonces que me di cuenta que mi intuición no se había equivocado.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Esto no luce nada normal...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me alejo de la entrada principal y entro al terreno de la mansión por la\nentrada trasera...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Fue entonces que escuché la voz de alguien gritando.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Salgo corriendo hacia el lugar de donde se escuchó la voz.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=240000,file="zbg004a",path=":bg/",x2=960,y2=-586,x=0,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_syi_000001",ch="syi"},
},
ja={
{
name={"Hombre"},
"“¡Ya sé que Shizuku está acá!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_aid_000681",ch="aid"},
},
ja={
{
name={"Ai"},
"“Que no está. ¡Cuántas veces tengo que decírtelo para que entiendas!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_syi_000002",ch="syi"},
},
ja={
{
name={"Hombre"},
"“¡No me engañas, Kenichiro Kusanagi ha regresado! ¡Así que Shizuku debe estar\nacá!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Ahora que lo pienso, creo que Kenichiro había mencionado ya ese nombre...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se3130",id=1},
{"fg",ch="黒服",size="z1",mode=3,resize=1,path=":fg/bca/z1/",file="bca_z1a0000",face="a0002",head="bca_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kfa_000001",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡¿Qué haces tú acá?!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Uno de los hombres que hacía guardia en el pasillo me encontró.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Pero no corrí. Le pregunté de vuelta.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso le pregunto yo a ustedes! ¡Esta mansión es propiedad de los Natsume!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000682",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡N-Naoya!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000003",ch="syi"},
},
ja={
{
name={"Hombre"},
"“¿Naoya? ¿Qué no era Naoya el nombre del muchacho de Kenichiro Kusanagi? Eso\nquiere decir que tú...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. ¿Quiénes son ustedes?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000004",ch="syi"},
},
ja={
{
name={"Hombre"},
"“Tch, un Kusanagi... Qué fastidio.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Me importa un bledo lo que pienses, vejete! ¡Dí cómo te llamas!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000005",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿V-Vejete? ¿Osas llamarme vejete, a mí? ¡V-Vaya mocoso tan irrespetuoso! Soy\nShoichi Nakamura, director de la Farmaceútica Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nakamura? Ahh... ese Shoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000006",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡M-Mocoso imbécil! ¡¿Cómo que 'ese' Shoichi Nakamura?! ¡Usa los debidos\nhonoríficos!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_kfa_000002",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Acá no tienes lugar muchacho, lárgate de una vez.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="章一",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",ex03="a0097",head="syo_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=-345,lv=4,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Uno de los hombres en negro se acerca.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000683",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No le pongas la mano encima a Naoya!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000007",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ponerle la mano encima? Pero qué violentas ideas tienes. Llevo ya un buen rato\ndiciendo lo mismo, solo vine a que me paguen lo que me deben.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo que te deben?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=345,lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000008",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Sí. Tu padre huyó con un tesoro mío, se lo robó. Y ahora necesito que me paguen\nde vuelta.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Deuda? Eso es un maldito robo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000009",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“También se le puede llamar así.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué no vas entonces con la policía? ¿Podría preguntar también cómo es\nque permites que un criminal como Kenichiro Kusanagi se convirtiera en un\nhéroe nacional?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",stop=1,time=500},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=9},
{"fgact",ch="章一",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000010",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conociendo a los dos seguramente hicieron algún negocio sucio, y por eso no\npuedes decir nada ante la luz públ-- agh.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",mode=-2},
{"fg",ch="章一",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/syo/z2/",file="syo_z2a0000",face="a0006",head="syo_z2a",lv=5,id=9},
{"fgact",ch="章一",act="うなづく",lv=5,id=9},
{"se",id=1,file="se2191"},
{"quake"},
{"quake",mode="mw"},
{"bgm",file="bgm015"},
{"text"},
text={
ja={
{
"El bastón del Nakamura se hunde en mi hombro.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000011",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Ya bastante basura has sacado de esa boca, muchacho. Si no va a salir nada a la\nluz pública bien podría matarlos a todos ustedes, ¿no te parece? Les voy a\nrecordar el poder que los Nakamura tienen acá en Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000684",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Imbécil! ¡¿Cómo te atreves a ponerle la mano encima a Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="章一",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/syo/z2/",file="syo_z2a0000",face="a0002",head="syo_z2a",lv=5,id=9},
{"fgact",ch="章一",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000012",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Solo le di un pequeño golpe. Y quizás ya no tengamos el mismo furor de antes,\npero de que podemos hundir sus cadáveres en las aguas de Yumihari, podemos.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no me sorprende. Ya me han contado como una vez le torciste el brazo a mi\npadre.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000013",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Eso le pasó a tu padre por pasarse de chistoso.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues tienes al hijo frente a ti, vejete. Y me pasaré de chistoso igual que él.\n¿Qué vas a hacerme?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="章一",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/syo/z2/",file="syo_z2a0000",face="a0005",head="syo_z2a",lv=5,id=9},
{"fgact",ch="章一",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000014",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",mode=-2,sync=0},
{"bg",zoom=70,x=-380,speed=200,file="zbg004a",path=":bg/",x2=120,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="章一",size="z2",ex03="a0097",speed=200,mode=3,path=":fg/syo/z2/",file="syo_z2a0000",face="a0005",head="syo_z2a",x2=0,x=-500,lv=5,id=9,sync=0},
{"quake"},
{"quake",mode="mw"},
{"extrans",time=100},
{"se",file="se3130",id=1},
{"text"},
text={
ja={
{
"Nakamura volvió a lanzar su bastón contra mí, pero esta vez sí lo esquivé.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="藍",size="z2",mx=40,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0006",head="aix_z2e",x=500,y=100,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000685",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ni pienses en lastimar otra vez a Naoya!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Ai intenta ponerse frente a mí.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="藍",mx=40,mode=-1,lv=5,id=6},
{"fg",ch="黒服",size="z2",mx=-40,mode=3,resize=1,path=":fg/bca/z2/",file="bca_z2a0000",face="a0002",head="bca_z2a",x=345,lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Pero el hombre de negro con la cara fea reaccionó de inmediato.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ngh!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Al ponerse de espaldas, le propiné una patada con toda mi fuerza.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toma!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",time=100,file="black",path=":bg/"},
{"bg",file="閃光中",rule=014,time=50,id=8,lv=8,path=":cg/battle/",set="battle"},
{"bg",lv=9,id=9,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",file="se1743",id=1},
{"quake"},
{"ex",time=100,func="wait"},
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服",size="z2",mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0002",head="bca_z2a",lv=5,id=6,sync=0},
{"extrans",time=80},
{"fg",ch="黒服",size="z1",mode=3,resize=1,path=":fg/bca/z1/",file="bca_z1a0000",face="a0002",head="bca_z1a",lv=4,id=6},
{"fgact",ch="黒服",act="いいえ",lv=4,id=6},
{"se",file="se3130",id=2},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kfa_000003",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡Guh!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000686",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Tei!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"El hombre de negro, inclinado hacia adelante por la patada, fue recibido por un\npuñetazo de Ai.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"msgoff"},
{"se",file="se3130",id=1},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=1000,lv=4,id=10},
{"fg",ch="藍",speed=100,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x2=1000,x=200,lv=4,id=10},
{"ex",time=0,func="wait"},
{"bg",time=100,file="black",path=":bg/"},
{"bg",file="battle_005",rule=058,time=80,id=8,lv=8,path=":cg/battle/",set="battle"},
{"bg",lv=9,id=9,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=2,file="se1866"},
{"quake"},
{"ex",time=130,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0002",head="bca_z1a",lv=4,id=6,sync=0},
{"extrans",time=300},
{"quake"},
{"fgact",ch="黒服",act="いいえ",lv=4,id=6},
{"ex",time=500,func="wait"},
{"fg",ch="黒服",my=40,mode=-1,lv=4,id=6},
{"se",file="se2766",id=3},
{"ex",time=500,func="wait"},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000015",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡M-Malditos, llamaré a la policía!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué disparates dices?! ¡Fueron ustedes quienes comenzaron con los golpes!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_aid_000687",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Me tomé la molestia también de grabar toda esta conversación.\nIncluyendo la amenaza de muerte.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000016",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_kfa_000004",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“D-Director...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000017",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Kuh, inepto tenías que ser! ¡Todo es tu culpa!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"cgact",stage="bg004",act="いいえ",size=30,lv=5},
{"se",id=1,file="se2192"},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"Nakamura golpea al hombre de negro.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"La culpa la tienes tú, vejete. Por no medir tus palabras ahora quedaste en\ndesventaja...",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000018",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Traje un solo guardia por querer llevar las cosas de forma pacífica... pero\nparece que tendré que traer unos cuantos más de los jóvenes la próxima vez\nque venga.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pretendes hacer trayendo tanta gente?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000019",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Quién sabe? Lo que haga, o no haga, depende de ustedes.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000688",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuh, ya te dije que nosotros no sabemos nada. Además, ¿qué no se supone que\ntenían un pacto con los Natsume de que ya no volverían a poner ni un pie\nsobre el terreno de esta residencia?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_syi_000020",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“No hay pacto que valga si Shizuku está involucrada. Aún no he recibido pago\nalguno por ella.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000689",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pago alguno... Hablas como todo un traficante de humanos.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_syi_000021",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Traficante de humanos? ¡Jaa! ¿Olvidas que por ti también tuvieron que pagar\npara salvarte? Engendro de meretriz.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bgm",stop=1,time=300},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=10},
{"fgact",ch="藍",act="びっくり",size=5,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000690",ch="aid"},
},
ja={
{
name={"Ai"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Hijo de perra!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_aid_000691",ch="aid"},
},
ja={
{
name={"Ai"},
"“Espera, Naoya. Cálmate.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000022",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Te molesta que te llamen así? Vaya que duele la verdad.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué mierda dices, imbécil? ¿Que no fueron esas meretrices las que te hicieron\nganar todo ese dinero? ¿Quién fue el inepto que a pesar de eso terminó\nhundiendo su propia familia?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",size=4,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000023",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Guh?!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No vas a romper de nuevo la 'Olympia' de Kenichiro que está en la entrada, ah?\n¿Que no vas a hacerlo de nuevo, vejete?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000024",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“M-Mocoso de mierdaaa...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que no puedes, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás ya los Natsume se separaron por completo, pero los yakuza leales a\nKotoko Natsume todavía están vivitos y coleando.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si les vuelven a cobrar lo mismo que entonces esta vez sí se irán ustedes a la\nquiebra.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000025",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000026",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Más vale que dejes de dártela del astuto, mocoso impertinente. Estás bien\nequivocado si nos ves las caras de pendejos.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace un tiempo podían jugar a los delincuentes y salirse con la suya. ¿Pero\ncrees que podrán salir airosos ahora, en estos tiempos?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_aid_000692",ch="aid"},
},
ja={
{
name={"Ai"},
"“Definitivamente. Así como golpeaste a Naoya ahora, ¿no habrá sido esa\npersonalidad impulsiva tuya la que llevó a la ruina a la respetable familia\nNakamura?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000027",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Cállense, cállense los dos! ¡A la mierda con los Natsume y los Toritani,\nsiempre desobedeciendo y buscando desafiarme!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000028",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Esta vez los hundiré. Hundiré a toda la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_aid_000693",ch="aid"},
},
ja={
{
name={"Ai"},
"“Intentaré tomarlo en cuenta. Ah, qué miedo, qué miedo, ya sé lo que nos espera\nde enfrentarnos con la familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000029",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kfa_000005",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Entendido...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=500},
{"se",file="se9004",id=1},
{"fg",ch="章一",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"El viejo Nakamura se lleva al hombre de negro y sale de la mansión.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Esperé a ver que su coche se fuera para regresar con Ai.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=10},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien, Ai?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000694",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Estás tú bien, Naoya? ¿Te quedó alguna herida del golpe? Vayamos de una vez al\nhospital. Perdóname, todo es mi culpa.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy bien, estoy bien. Un bastonazo de ese viejito no me hace nada. Las cosas\nserían distintas si hubiese sido el hombre de negro, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me importa más saber por qué estaban los Nakamura acá.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000695",ch="aid"},
},
ja={
{
name={"Ai"},
"“Han pasado varias cosas. Aunque sí, todo comenzó desde que Kenichiro- san\nregresó...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no se van entonces con él?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000696",ch="aid"},
},
ja={
{
name={"Ai"},
"“Probablemente ya fueron. Y no consiguieron nada, así que decidieron venir acá.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no es excusa para tanta violencia...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000697",ch="aid"},
},
ja={
{
name={"Ai"},
"“Seguramente se morían por hacer desastre en la habitación de Kenichiro... Pero\nestán lidiando con una celebridad, no pueden sobrepasarse.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dudo mucho que ese vejete tenga la paciencia para aguantar tanta rabia...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000698",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Quién sabe? Aunque, me alegro de haber mandado a Kei afuera.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, más que seguro se habría lanzado contra el hombre de negro.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000699",ch="aid"},
},
ja={
{
name={"Ai"},
"“De haber dado el primer golpe estaríamos acabados. La ventaja en fuerza la\ntienen ellos por creces.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más problemático es que una anteriormente respetable familia esté ahora\nactuando como yakuzas.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=10},
{"fgact",ch="藍",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000700",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí. Pero parece que no les ha ido nada bien.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000701",ch="aid"},
},
ja={
{
name={"Ai"},
"“Han perdido muchas propiedades y compañías en estas últimas décadas.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Entre esas propiedades está esta residencia. La mansión Natsume...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000702",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, entre tantos enfrentamientos en el pasado han perdido bastante. Me imagino\nque querrán recuperar a esa muchacha de cualquier manera...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esa muchacha?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A quién te refieres con esa muchacha?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=10},
{"fgact",ch="藍",act="うなづく",size=5,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000703",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tenemos otra hermana en la familia Natsume. Si la memoria no me falla, nunca la\nhas conocido.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"(Ahora que lo recuerdo, tengo en casa a la muchacha que Kenichiro me encargó)",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Resisto las ganas de no mencionar eso.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000704",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero aún no he podido dar con ella. Probablemente Kenichiro-san la ha estado\nescondiendo muy bien...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"¿Debería contarle a Ai?",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Ai es una artista marcial, y me lleva varios años de vida y experiencia. Podría\nserme de ayuda.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Pero, al pensar en por qué Kenichiro Kusanagi me encargó a mí -y no a ella-,\nconcluí que no debía decirle nada.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Es probable que su relación con Kuzu sea mucho más fuerte que en mi caso. Pero\njustamente por eso quiero mantenerlo en secreto.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que Kenichiro Kusanagi te ha traído problemas con sus fechorías.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",lv=4,id=10},
{"fgact",ch="藍",act="いいえ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000705",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, en absoluto. Kenichiro-san solo piensa en ayudarnos.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, supongo que se podría decir que sí...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000706",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por cierto, ¿a qué viniste hoy acá?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ahh, no vine con nada concreto en mente, solo que... vine caminando sin\nrumbo alguno y al pasar cerca escuché los gritos.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_aid_000707",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Sin rumbo? Qué raro. Casi nunca vienes acá sin motivo alguno.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, vine caminando sin rumbo alguno.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"msgoff"},
{"se",file="se9002",vol=50,id=1},
{"fg",ch="藍",time=500,sync=1,mode=-1,lv=4,id=10},
{"fg",ch="藍",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2h0000",face="h0017",head="aix_z2h",lv=5,id=10},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_000708",ch="aid"},
},
ja={
{
name={"Ai"},
"“... ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué... mentiría?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0018",head="aix_z2f",lv=5,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000709",ch="aid"},
},
ja={
{
name={"Ai"},
"“... No importa, supongo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Después de verme por un rato con mucha desconfianza, Ai volteó su cabeza a un\nlado, malhumorada.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0009",head="aix_z2f",lv=5,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000710",ch="aid"},
},
ja={
{
name={"Ai"},
"“Padre e hijo, realmente se parecen los dos.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0002",head="aix_z2f",lv=5,id=10},
{"fgact",ch="藍",act="いいえ",lv=5,id=10},
{"text"},
text={
vo={
{"vo",file="fem_aid_000711",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nada, solo son cosas mías.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Lo único que pude hacer fue lanzar una forzada sonrisa.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000136",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Cómo te fue en la mansión Natsume?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, s-sí... ninguna novedad.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000137",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000138",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya, tengo el poder de tragar sueños. Es inútil que intentes ocultarme algo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Hum, t-tienes razón. Pero ¿podrías prometerme algo?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000139",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi padre me dejó la tarea de protegerte. Y por eso mismo no quiero hacerte\npasar por nada peligroso.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0006",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000140",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡¿Le sucedió algo a Ai nee-san?!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no sufrió ninguna herida o algo por el estilo. Solo que, vinieron a la\nresidencia Natsume...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000141",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Cuando dices que vinieron te refieres a Nakamura Shoichi y sus secuaces?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, el mismo.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000142",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No te hicieron nada malo? ¿Estás bien, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, estoy perfectamente bien como puedes ver.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000143",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Hubo una vez que hirieron fuertemente a Kenichiro. Y ahora quedó con un pequeño\ndaño en su mano izquierda.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno. Ya mi padre y la abuela Natsume me contaron acerca de la familia\nNakamura. Creo tener una buena idea de cómo son.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000144",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, pero aun así, es peligroso.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo voy a negar. Pero sea lo que sea, me encargaron de tu cuidado.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000145",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Te encargaron a mí?...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. El conflicto entre los Natsume y los Nakamura ha seguido desde los\naños de la abuela Natsume. Luego pasó a manos de mi padre, y ahora a las\nmías.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que debo cumplir con esto, como descendiente de esta familia.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000146",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ahora que sé eso, yo... creo que no puedo reclamar nada.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000147",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿qué pasa? ¿Por qué me ves con esa cara?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000148",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Es triste ser protegida y no poder hacer nada más...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te preocupas demasiado. Ya los Nakamura no pueden hacer tanto estrago como\nantes. No ocurrirá otra guerra de yakuza como sucedió en el pasado.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000149",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo sé, pero aun así... no tengo manera de pagar de vuelta todo lo que haces por\nmí.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, cuando todo esto termine y puedas vivir en paz, quiero que dejes de\ntragar sueños y vivas una vida normal. Eso me basta.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000150",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Eso no es nada suficiente.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no lo creas, sí lo es. Soy bueno cocinando, así que cuando todo esto\ntermine quiero que pruebes mi comida y me des una sonrisa mientras me dices\n'qué rico está'.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000151",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Uno debe sonreír cuando come algo delicioso?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que sí. Al menos alguna vez has comido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000152",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Sí, pero nunca he sonreído haciéndolo.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mis platos son tan buenos que te sacaran una sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000153",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“La forma en que lo dices, es un poco extraña. Pero... no sé por qué, pero ya\nquiero que llegue ese momento.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000154",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Bien, quisiera hablar ahora acerca de mi muestra de agradecimiento...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bgm",stop=1,time=300},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya te dije que no necesito que me devuelvas nada!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0003",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000155",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Si es contigo puedo hacerlo hasta con la boca, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué vas a hacer con tu boca?!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0008j",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0011j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000156",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Pues... pensé en hacer realidad, lo que había en los sueños de ayer. Llevarme\n'eso', directamente a...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué diablos?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0017j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0008j",head="shz_z2b",lv=5,id=9},
},
vl02={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000157",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Felación, es que le llaman? Estuve todo el rato investigando con mi teléfono\nmientras no estabas.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No te pongas a buscar esas cosas!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0002j",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0008j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000158",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Después de escuchar lo de la paja, comencé a buscar, y... ¿No debería hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es problema tuyo si buscas o no, no soy quien para no permitírtelo. ¡Pero si\nvas a hacerlo hazlo con alguien que te guste!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0001",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000159",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Puedo hacerlo, si es con la persona que me gusta?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro, siempre y cuando tengas el consentimiento de la otra persona.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0003",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000160",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0004",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000161",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me gustas. ¡Déjame chupar tu pene!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No entiendo nada de lo que dices!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000162",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué? Primero que nada, hay que confesarse, y de allí comienza todo. Eso\nhabía leído.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Estás comenzando todo muy rápido!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, Kuzu. Sé que quieres regresarme el favor. Pero no me gusta que\nintentes pagarme usando tu cuerpo con tanta facilidad.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0018",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0005",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000163",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No esperaba eso. Yo no haría eso tan fácilmente...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, digo, tienes razón. Pero no hay ningún motivo para que te enamores de mí,\n¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000164",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos acabamos de conocer, en primer lugar.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0008",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000165",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Mmm... ¿de verdad?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000166",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Si así lo dices, no puedo refutar nada.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0011",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000167",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Y ahora que lo pienso, creo que lo de devolver el favor es mentira.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mentira? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0001",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000168",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Si de verdad quisiera agradecerte, no debería tener sentimientos por ti...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no? Si realmente te gusta alguien no hay problema en que lo hagas. No\nentiendo nada ya.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0012",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000169",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Ah, está bien, olvídalo. Esta conversación se terminó.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ¿por qué te la pasas diciendo siempre esa clase de cosas, Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000170",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Creo haber dicho desde el primer día que me gustaban las conversaciones sucias.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo dices en serio? Juraba que lo que dijiste ayer era solo por rebeldía.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000171",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿No te gusta hablar de temas sucios, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, como un hombre en plena edad reproductiva, debo decir que no me\ndesagrada... pero, mi cuerpo no aguantaría hacerlo por mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000172",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Tu cuerpo no aguantaría?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justamente por ser un hombre en plena edad reproductiva es que de hablar tantas\ncosas sucias con una muchacha no me resistiría a querer más.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000173",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¡Si no puedes aguantar puedes descargarte con el cuerpo de Kuzu!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Idiota! ¡No se te ocurra volver a decir eso!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás no lo parezca, pero para mí los sentimientos son primero.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000174",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Para mí también.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una persona que se fija más en los sentimientos no diría eso.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000175",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No tengo como objetar a lo que dices. Y que me digas eso me pone algo triste.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento. Creo que me sobrepasé con mis palabras.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0018",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000176",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Está bien, ya no importa. Puedes ver a Kuzu como una perra. Eso resolvería\ntodo.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, decir eso sería exagerar demasiado...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000177",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Qué difícil es esto... Gracias al poder tragasueños puedo sentir directamente\nlo que otros sienten, pero no puedo comunicar mis propios sentimientos. Me\nmolesta eso.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, eso es completamente normal...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie puede comunicar lo que siente sin rodeo alguno, y por eso es que las\npersonas se toman tiempo para irse entendiendo.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justamente así funciona el amor, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kzd_000178",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿De verdad?... Es tan difícil...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Triste, Kuzu bajó la mirada.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Esperé a que fuese buena hora para irme al Hospital General de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Ya los exámenes de mi viejo deben haber terminado.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Vine a verlo junto con Kuzu.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"excall",file="03_andoe_02_5"},
{"text"},
linkback="block_00236",
},
label = {
top={block="block_00000",label=1},
},
}
