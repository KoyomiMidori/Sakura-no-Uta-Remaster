astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"se",id=1,file="se1532"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bwaaahhh...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Hoy también desperté muy bien. Seguramente Kuzu se tragó mis sueños eróticos.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Aunque, al parecer los sueños eróticos no le hacen tanto daño. Por mi parte, lo\nmenos que puedo hacer es cuidar de no tener alguna pesadilla...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A preparar el desayuno...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-70,x=580,file="zbg023a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"se",file="se2397",id=1},
{"text"},
text={
ja={
{
"Abro el refrigerador y tomo un paquete de 'jamón de pollo' de Toranoko.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"No es nada relevante esto, pero por lo general solo compro pechuga de pollo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"La razón es simple, es barata. Un paquete sellado al vacío de 2 kilos de\npechuga cuesta unos 800 yenes.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Como pechuga como si no hubiera un mañana.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Entre todas las variaciones, hay una que se gana el puesto número uno en\nplatillos con pollo, y es el 'jamón de pollo'.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Esta receta la encontré mientras buscaba en Internet.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Y debo admitir que mi repertorio evolucionó junto con la red.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"No teniendo a nadie que me pudiera enseñar, era la única herramienta que tenía\na mano (si bien antes de morir mi madre me cocinaba, nunca llegó a\nenseñarme).",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Pero el Internet es poderoso. El mundo virtual está repleto de solitarios como\nyo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Y fue así que aun siendo solo un principiante pude llevar mi técnica culinaria\nhasta este nivel.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Si no existiese el Internet probablemente hubiera muerto ya, incapaz de\npreparar algo más que un rámen instantáneo.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Tengo bastante que agradecerle a la modernidad.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuzu, supongo que no vas a comer.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000251",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este jamón de pollo está muy bueno, te lo digo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000252",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Algún día quisiera probarlo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algún día, eh... Preferiría que en lugar de mis sueños comieras esto, la\nverdad.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",size=6,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000253",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Lo sé, lo siento...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Kuzu asintió con un ligero movimiento.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"se",file="se1343",id=1},
{"text"},
text={
ja={
{
"Espero a que sea la hora y hago una llamada.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Quería preguntar por las cosas de Kuzu.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Al llamar, me dicen que habían cometido un 'error' en el envío, y que\ndespacharían las cosas de inmediato.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se2554"},
{"text"},
text={
ja={
{
"Pasan unos minutos y el timbre de la casa suena.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si es mi imaginación o llegaron algo rápido.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Reviso la pantalla del intercomunicador.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_kzd_000254",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"En medio de la pantalla estaba alguien que parecía ser el empleado postal.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Pulso el botón de llamada que comunica con el intercomunicador de la entrada.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_kfa_000006",ch="kfa"},
},
ja={
{
name={"Mensajero"},
"“Paquete de la oficina postaaal.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Pulso el botón del autolock.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás me estoy imaginando mucho...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"No pude evitar sospechar de tanta rápidez, pero no parecía ser alguien de los\nNakamura.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"se",id=1,file="se2554"},
{"text"},
text={
ja={
{
"Vuelve a sonar el timbre. Reviso la mirilla de la puerta y abro.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="黒服",size="z1",mx=40,mode=3,resize=1,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=-345,lv=4,id=5},
{"fg",ch="黒服Ｂ",size="z1",mx=40,mode=3,resize=1,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=345,lv=4,id=6},
{"se",file="se3130",id=1},
{"quake"},
{"mwact",act="びっくり",size=8},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Fue al abrir la puerta que me di cuenta de lo descuidado que fui.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Tras la puerta estaban los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"se",file="se9010",id=1},
{"fg",ch="黒服",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=9},
{"fg",ch="黒服Ｂ",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000030",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Está ahí, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Jamás pensé que llegarían a hacerse pasar por trabajadores postales para\nentrar.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000031",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Shizuku? ¿Quién es Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000032",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ah? ¿Vas a hacerte el tonto?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, realmente no sé de quién me habla...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000033",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Hmph, qué más da. Entren y búsquenla.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgact",stage="bg021",act="いいえ"},
{"se",file="se9023",id=1},
{"fg",ch="黒服",mx=-40,mode=-1,lv=4,id=5},
{"fg",ch="黒服Ｂ",mx=-40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ey, ey, el ingreso no autorizado a propiedad privada es un crimen.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"se",stop=1,time=500,id=1},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000034",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Y crees que me importa?! ¡Esa muchacha es una deuda con brazos y piernas de\n1500 millones! ¡¿O es que tú puedes pagar esos 1500 millones, ah?!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“1500 millones...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
"Ya veo, esa suma supera fácilmente a la que tiene el viejo en su libreta... Con\nrazón prefirió dejarme la libreta ahora que se está muriendo.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=9},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kfa_000007",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡La encontramos!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000255",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Me encontraron.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Atraparon a Kuzu, quien no parecía tener ni un rastro de nerviosismo.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000035",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿No que no estaba?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas, ella es Kuzu. No es la muchacha de la que estabas hablando.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000036",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ahhh? ¡Da igual si es Kuzu o Shizuku, me la llevo de vuelta conmigo!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, espera, ¿es que piensas llevártela a la fuerza?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kzd_000256",ch="kzd"},
},
ja={
{
name={"Kuzu"},
"“Naoya... no.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Kuzu me dirige la mirada.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Parecía estar más preocupada de que yo cometiera alguna estupidez que de ella\nmisma.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",mode=-2},
{"fg",ch="黒服Ｃ",size="z1",mode=3,resize=1,path=":fg/bcc/z1/",file="bcc_z1a0000",face="a0001",head="bcc_z1a",x=-500,lv=4,id=5},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=0,lv=4,id=9},
{"fg",ch="黒服Ｂ",size="z1",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=500,lv=4,id=6},
{"text"},
text={
ja={
{
"¿Qué debería hacer entonces? Según veo, lleva varios guardaespaldas consigo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Si fuese un agente secreto de algún cuerpo especial o algo así entonces esta\nsería la parte donde lo soluciono todo a golpes, pero obviamente no lo soy.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Pero no por eso puedo permitir que se la lleven como si nada.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Así que por ahora...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"No creo que sea muy efectivo, pero tendré que recurrir a un método muy\nortodoxo.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escuchen algo...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bgm",stop=1,time=300},
{"se",file="se3130",id=1},
{"fg",mode=-2},
{"bg",y=0,speed=200,sync=0,file="zbg023a",path=":bg/",x2=390,y2=0,x=800,ax=1920,ay=1126,bx=-960,by=-586},
{"quake"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000598",ch="wtd"},
},
ja={
{
name={"???"},
"“¡Wajajajajaja! ¡Vaya, pero es que los villanos andan como verdaderos villanos\nhoy, eh!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Justo cuando iba a hablar, repentinamente se escuchó la voz de alguien.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",y=0,zone="0x000000",speed=200,file="zbg023a",path=":bg/",x2=800,y2=0,x=-800,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="明石",size="z2",speed=500,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2e0000",face="e0001",head="aka_z2e",x2=-1000,x=1500,lv=5,id=9,sync=0},
{"quake"},
{"extrans",time=0},
{"se",id=1,file="se1059"},
{"ex",time=400,func="wait"},
{"se",file="se1879",id=2},
{"cgact",stage="bg023",act="quake",size=30},
{"fg",mode=-2},
{"bgm",file="bgm008"},
{"text"},
text={
ja={
{
"La ventana de la sala se rompe, y por ella entra alguien al apartamento.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dem--?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"No logro comprender la situación. ¿Qué rayos está pasando?",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="章一",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000037",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Q-Quién es ese?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Y al parecer el vejete Nakamura también estaba igual.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",mode=-2},
{"bg",zone="0x000000",sync=0,file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000599",ch="wtd"},
},
ja={
{
name={"???"},
"“¡Un esplendoroso cuerpo celestial! ¡O sea, yo!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"El desconocido comenzó a hacer unas poses.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",mode=-2},
{"bg",sync=0,file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"fg",ch="明石",size="z2",my=40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2e0000",face="e0002",head="aka_z2e",lv=5,id=9},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="man_wtd_000600",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wataaru, Akkashi! ¡Presente!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa voz...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Tenía un aspecto distinto, y más dudoso de lo normal, pero era, al parecer,\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000601",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fufufu, vi que unos hombres de mala pinta entraron a tu edificio, y les seguí\nel rastro muy sigilosamente.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida eso, solo dime por qué entraste por la ventana.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000602",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Porque soy una brillante estrella gigante!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es el décimo piso...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fgact",ch="明石",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000603",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Porque soy una estrella gigante!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Subiste hasta la azotea y bajaste por la escalera de emergencia, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000604",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eso no importa! ¡Bien, villanos, vengan! ¡Que ha llegado el héroe de todos a\nenfrentarlos!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué demonios tienes en la cabeza?...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Pero a pesar de lo que dije, estaba agradecido con Akashi por haber hecho\nsemejante aparición rompiendo la ventana.\nMe va a servir bastante para lo que haré ahora.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_syi_000038",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Tch, sáquenlo, no tiene nada que ver en esto. Y denle un pequeño recordatorio,\nsolo para que se lo piense dos veces antes de volver a hacer estupideces como\nesta...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",file="se9010",id=1},
{"fg",ch="黒服Ｂ",size="z1",mx=-40,mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=-570,lv=4,id=3},
{"fg",ch="黒服Ｃ",size="z1",mx=40,mode=3,path=":fg/bcc/z1/",file="bcc_z1a0000",face="a0001",head="bcc_z1a",x=570,lv=4,id=4},
{"text"},
text={
ja={
{
"Unos cuantos de los hombres de negro asintieron a la orden de Nakamura, y\nrodearon a Akashi.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Aprovecha huir y grita lo más que puedas!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000605",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fufufu... ¡Kusanagi-kun, dime algo!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="明石",size="z1",ex03="e0097",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0009",head="aka_z1e",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000606",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Quienes son estas personas? Ahora que las veo de cerca parecen ser muy, muy\nfuertes.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y acaso no es obvio que lo son?! ¡Imbécil, no me vengas a decir que te\nmetiste acá sin pensártelo bien!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000607",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, es que parecían ser malos.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Malos es poco, son los Nakamura! ¡Son yakuza, auténticos yakuza!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000608",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Yakuzaaa?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000039",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡No vuelvas a comparar a la familia Nakamura con esa gentuza! ¡Somos una\nfamilia con 1000 años de historia en Yumihari y mucho prestigio!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ahh? ¡¿Vas a negar que tu prestigiosa familia inició una guerra con la familia\nNatsume?! ¡¿Inicias una guerra con yakuzas y te atreves a decir que ustedes no\nlo son?!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000040",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Por supuesto! ¡Y en primer lugar, fue la vieja Natsume quien inició todo esto!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso no quita el hecho de que ustedes son yakuza!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000609",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y-Yakuza...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, son yakuza.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",lv=4,id=9},
{"fgact",ch="明石",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000610",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fu, fufufufu...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"No sé si es que entendió la situación en la que estaba y se le fueron las\ntuercas de la cabeza, pero Akashi comenzó a reírse súbitamente.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Akashi?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x2=0,x=-345,lv=4,id=9},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000611",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fufufu, parece usted estar malentendiendo algo, Nakamura-sama.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000041",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Aaahhh?!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"El vejete Nakamura respondió con un amenazador gruñido.\n¿Qué va a estar malentendiendo, idiota?...",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",x=-345,lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000612",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hiih, n-no es lo que cree, n-no soy ningún hombre sospechoso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000042",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Qué no podría tener de sospechoso alguien que entra a una casa rompiendo una\nventana?!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="明石",mode=-1,lv=4,id=9},
{"fg",ch="章一",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",ex03="a0097",head="syo_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que sea muy normal tampoco hacerse pasar por un trabajador postal y\nentrar a la fuerza a un apartamento.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000043",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Eso solo fue para venir a cobrar una deuda!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad crees que esa excusa te va a servir hoy en día? Voy a denunciarte\ncon la policía. Si piensas llevarte a Kuzu entonces estarás bajo sospecha de\nsecuestro también.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000044",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Q-Quizás no lo sepas, pero si esto sale a la luz pública tu padre tampoco\nsaldrá bien parado!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa, no me importa en absoluto.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mi no me concierne nada de lo que ustedes hayan hecho. Así ese viejo haya\ncometido algún crimen, eso no me concierne a mí.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000045",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡S-Se supone que es tu padre, ¿no?! ¡¿Es que no te preocupa?!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Qué intentas decir? Si un padre cometiera un crimen un buen hijo desearía\nque pagara por sus delitos, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué demonios hizo mi padre, pero acabas de ingresar ilegalmente a\npropiedad privada, y si te llevas a Kuzu también serás autor de secuestro.\nNada más ni nada menos que eso.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000046",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Fue Kenichiro Kusanagi quien la secuestró desde un principio!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, eso no me concierne a mí. ¿O preferirías explicar eso en la\nestación de policía?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000047",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Q-Qué dices?...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"La verdad es que desconozco los detalles de la situación.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Así como lo dijo Shoichi Nakamura, probablemente es cierto lo de que mi viejo\nsecuestró a Kuzu.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Y es también probable que ellos sean quienes tienen la paternidad de Kuzu.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Así que hay mucho que perder -en caso de fallar- en esta apuesta.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Pero hay una altísima probabilidad de que funcione.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"De no ser así, nada explicaría por qué aun después de que mi padre se llevara a\nKuzu pasaran tantos años sin reportar a la policía.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Ellos temen que todo esto salga al ojo público.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Fue de ahí que pretendí no saber nada, y ahora les digo que los 'reportaré con\nla policía'.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Evitar que todo salga a luz pública no es más que un acuerdo tácito entre los\nNakamura y Kenichiro Kusanagi. A mí no me concierne.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"O al menos eso le hago creer.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000048",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Nos ves la caras de tontos a los Nakamura, Naoya Kusanagi? Mocoso\nimpertinente, más te vale saber que no nos cuesta nada echar tu cadáver a la\nbahía de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me lo imagino. ¿Aprovecharás de echar el cadáver de él también? Ha sido\ntestigo de todo lo que pasó acá, no creo que vayas a dejarlo ir, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000613",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Eh? No puede ser, ¿yo? Yo solo vine a proporcionarle información de utilidad a\nNakamura-sama.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000049",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Sí, este también.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000614",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡No, por favor! ¡Se equivoca, yo no vine a perjudicarlo a usted!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"¿A qué vino este idiota?...",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que ustedes tengan tanto poder como para poder desaparecernos a los dos\ny salir airosos de esto, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000050",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Naoya. ¿Sabes cuántas personas han desaparecido hasta ahora en el país?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000051",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Cien mil personas. ¿Qué tendría de raro que los dos pasen a ser parte de esa\ncifra?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eres idiota? ¡¿De verdad crees que nadie sospechará después del escándalo y\nlos gritos, y además esta ventana rota?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Es aquí donde la aparición de Akashi trabaja a mi favor.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De verdad crees que nadie se dio cuenta de lo que está pasando?! Todo este\nescándalo, y las ventanas rotas. ¿Es que crees que los vecinos no estarán\nviendo que pasó?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000052",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, hay cámaras instaladas en la entrada. Después de ver a un tipo\ndisfrazado de empleado postal seguido por un montón de hombres en traje negro\ntodos van a sospechar.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si vas a eliminar a alguien tienes que tener todo calculado a la perfección,\nidiota. ¿De verdad crees que podrás hacerlo de un minuto a otro porque te da\nla gana?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000053",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡E-Este bastardo! ¡Acaben con los dos!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",mode=-2},
{"fg",ch="黒服Ｃ",size="z1",mode=3,path=":fg/bcc/z1/",file="bcc_z1a0000",face="a0001",head="bcc_z1a",x=-500,lv=4,id=5},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=0,lv=4,id=9},
{"fg",ch="黒服Ｂ",size="z1",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=500,lv=4,id=6},
{"text"},
text={
ja={
{
"Shoichi Nakamura le ordenó eso a los guardaespaldas.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Pero lo único que hicieron fue verse las caras.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Es lo obvio. Seguramente ninguno esperaba tener que asesinar a alguien, y menos\naun con tantas pruebas de la fechoría regadas alrededor.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Muy seguramente fueron los Nakamura quienes tenían retenido el equipaje de\nKuzu.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Donde llegue el equipaje es donde, con toda seguridad, estará ella, habrán\npensado.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Pero entre todo eso han quedado varias pruebas.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"A una persona común y corriente no se le ocurriría ensuciarse las manos en esas\ncircunstancias.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000054",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Es una orden! ¡Si no acaban con ellos serán ustedes los que terminarán\nflotando muertos en la bahía!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fgact",ch="黒服",act="びっくり",lv=4,id=9},
{"fgact",ch="黒服Ｂ",act="びっくり",lv=4,id=6},
{"fgact",ch="黒服Ｃ",act="びっくり",lv=4,id=5},
{"text"},
text={
ja={
{
"Los guardaespaldas se movieron nerviosamente.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Por más descabellado que sea, este tipo llegó a dominar a los yakuza de Kantou\nen el pasado. La posibilidad de que cumpla con su palabra no es completamente\nnula.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Pero en estas circunstancias, nadie acá es capaz de cometer semejante\nestupidez.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000615",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Se lo pido, tenga piedad! ¡Todo es un malentendido, un gran, gran\nmalentendido!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Akashi se postra sobre el suelo y se disculpa.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Idiota... solo piensa un poco, en estas circunstancias la probabilidad de que\nintenten matarnos es baja...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000055",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“A-Ah, claro. ¿Piensas meter a tu amigo en esto? Créeme que cuando digo que hago\nalgo lo haré.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Amigo? ¿Este tipejo?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Es mejor hacerle creer que entre Akashi y yo no hay ningún vínculo especial.\nAsí que decidí responder de esa manera.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",file="se3130",id=1},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-680,lv=4,id=1},
{"fg",ch="明石",speed=500,mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x2=-1500,x=-400,lv=4,id=1},
{"fg",ch="明石",speed=250,mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",y2="0,-20",x=-400,y=0,lv=4,id=1},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=6},
{"fg",ch="章一",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",ex03="a0097",head="syo_z1a",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000616",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Así es! ¡Este tipejo y yo no somos amigos, ni nada por el estilo!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Vaya que se adapta bien en estas situaciones.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-400,y=0,lv=4,id=1},
{"fg",ch="明石",speed=500,mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x2=-400,x=-200,y=0,lv=4,id=1},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="うなづく",lv=4,id=1},
},
},
text={
vo={
{"vo",file="man_wtd_000617",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por favor, Nakamura-sama, basta ya de los malentendidos. Deje que me presente.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Akashi, quien estaba postrado hasta ahora, se paró repentinamente frente a\nShoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=680,lv=4,id=2},
{"fg",ch="黒服",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x2=1500,x=0,lv=4,id=2},
{"fg",ch="明石",size="z1",ex03="e0097",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0009",head="aka_z1e",x=-200,y=0,lv=4,id=1},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0009",ex03="e0097",head="aka_z1e",x2=-200,x=-500,y=0,lv=4,id=1},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=1},
{"se",id=1,file="se2192"},
{"text"},
text={
ja={
{
"Y termina con un puñetazo encima.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="明石",size="z1",ex03="e0097",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0009",head="aka_z1e",x=-500,y=0,lv=4,id=1},
{"fgact",ch="明石",act="びっくり",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000618",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Gyawaan!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"¿Qué más esperaba? En ninguna parte del mundo hay un guardaespaldas que no\nreaccione al acercarse un desconocido a su jefe.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="黒服",mode=-1,lv=4,id=2},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0009",ex03="e0097",head="aka_z1e",x2=-500,x=-345,y=0,lv=4,id=1},
{"fgact",ch="明石",act="いいえ",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000619",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Se equivoca, todo es una equivocación. No tengo intención alguna de hacerle\ndaño. ¡Déjeme presentarme!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,y=0,lv=4,id=1},
{"fgact",ch="明石",act="うなづく",lv=4,id=1},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Postrado de nuevo en el suelo, Akashi le da una tarjeta a Nakamura.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000056",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Una tarjeta?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"El viejo Nakamura recibe la tarjeta.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000057",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“... El mundialmente reconocido, ... Wataaru, Akkashi...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,y=0,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000620",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El mismo.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x2=345,x=0,lv=4,id=6},
{"cgact",stage="bg023",act="quake",size=10},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"se",id=1,file="se2192"},
{"fg",ch="明石",my=40,mode=-1,lv=4,id=1},
{"text"},
text={
ja={
{
"Nakamura pisotea a Akashi.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000058",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Me ves la cara de idiota, pequeño imbécil?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000621",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“N-No creo que sea muy buena idea que haga esto.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000059",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ahhh? ¿Es que quieres morir?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="明石",size="z1",my=40,mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="章一",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",ex03="a0097",head="syo_z1a",x2=0,x=345,lv=4,id=6},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000622",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, para nada, no quiero morir. Vea usted, la tarjeta no miente respecto a\nquien soy yo...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000060",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿El mundialmente reconocido Wataaru Akkashi? ¿Mundialmente reconocido de qué?\n¿Quién diablos eres?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000623",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Mundialmente reconocido en lo que al arte se refiere, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000061",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ah? ¿Al arte?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000624",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vea usted, yo tengo una relación muy estrecha con esta persona...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Akashi saca una tarjeta diferente.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa tarjeta es...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000062",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Kenichiro... Kusanagi...?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La tarjeta de Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"¿Por qué Akashi tiene esa tarjeta?",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Que yo sepa mi viejo y él no se conocen.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000625",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, sepa usted que yo tengo una fuerte relación con ese mundialmente famoso\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000063",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Eres un conocido suyo?!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000626",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así mismo.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000064",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Te vas a la tumba entonces!”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"El viejo Nakamura alza su voz con enfado.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0007",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000627",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah, espere un momento, por favor. Déjeme aclarar que nuestra relación es\nsolamente de compañeros de negocios.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000065",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Compañeros de negocios?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000628",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, nuestro vínculo se limita a eso.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000066",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Hmph...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"El tipo que de repente entró por la ventana resultó ser el compañero de\nnegocios de Kenichiro... Hay que ser muy idiota como para creer algo de esa\nhistoria.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Pero parece que la tarjeta de Kenichiro Kusanagi convenció parcialmente a\nShoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000067",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Esta tarjeta, tiene marcado el emblema de la Fundación Moore... Tendría que\nhaberla conseguido en los Estados Unidos...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000068",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“El imbécil ese entró de emergencia en el hospital apenas llegó al país, no hay\nforma de que obtuviera esta tarjeta acá.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"¿Una tarjeta con el emblema de la Fundación Moore? ¿Por qué Akashi tiene esa\ntarjeta? Incluso en mi caso fue hace poco que obtuve una.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_wtd_000629",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Me cree ahora?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000069",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Y qué clase de negocios hacías con él como su compañero?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0006",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000630",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ehm... sí, bueno...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000631",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmmm.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Es más que obvio que está pensando.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0007",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",time=800,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000632",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eh, esto--”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Idiota, se nota a leguas que estás tratando de sacarte algo.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000070",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué tanto estás pensando? ¿No te salen rápido las mentiras?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Cualquiera pensaría que Akashi se pondría nervioso tras escuchar eso, pero en\nlugar de eso mostró una extraña sonrisa repleta de confianza.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000633",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No es eso, fíjese, justamente ahora tengo un trabajo multimillonario a cargo, y\nbueno, tengo el deber como profesional de mantenerlo en secreto...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000071",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ahh? Muchacho, podrías estar a unos pasos de morir, ¿es que crees que puedes\nguardarte secretitos acá?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000634",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sepa que sí, es parte de mi conducta como profesional.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Akashi contesta con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"¿Podrías decirme en qué se supone que eres un profesional?",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000072",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Parece que no temes por tu vida, eh...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000635",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues parece que no queda de otra, ciertamente. Aunque vaya que debo admitir lo\nmucho que me decepciona verlo haciendo esto, matando usted mismo la gallinita\nde los huevos de oro.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000073",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué intentas decir?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000636",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Creo que fui lo suficientemente claro. Viendo la manera en que se deja llevar\npor la situación y perdiendo la oportunidad de hacer gran dinero por una\ndecisión mediocre, me cuesta creer que realmente proviene usted de una\nfamilia privilegiada...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000074",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Me estás viendo la cara de idiota?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000637",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, para nada. Creo muy bien en que usted es un hombre de sabiduría,\nNakamura-sama. Y por eso mismo me cuesta creer que sea capaz de cometer esa\nridícula decisión.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"No sé qué tiene en mente, pero Akashi comenzó a negociar en una manera\ndescabellada.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000075",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Hasta hace un momento estabas rogando por tu vida, ¿a qué viene esa actitud\nimpertinente ahora?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000638",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah, no era por eso, créame. Simplemente no podía asimilar la frustración de que\na pesar de la buena propuesta que traje usted confundió todo y pensó en\nmatarme, y en eso no pude contener mis lágrimas.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"¡Y yo no puedo asimilar la manera en que tuviste que entrar por la ventana para\nhacerle una buena propuesta!",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000076",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Puedes entonces hablar de una buena vez de esa propuesta...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x2=-345,x=-210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000639",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Le pido entonces que firme este juramento escrito.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000077",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué demonios es esto?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Akashi le extiende una hoja de papel a Nakamura.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="man_wtd_000640",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Será que no se le da muy bien el inglés?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000078",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡H-Hay algo escrito aquí!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000641",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es solo un juramento escrito relacionado al deber de confidencialidad\npertinente en este caso.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"¿Inglés?",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"¿Por qué Akashi tiene un juramento escrito en inglés?",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000079",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡De ninguna forma voy a firmar un juramento escrito!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",x=-210,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000642",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Qué pena, realmente. Ahh, y pensar que es una oportunidad de cientos de\nmillones, un chance como ningún otro...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000080",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Cientos de millones?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"La expresión del vejete Nakamura cambia.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000081",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Me estás diciendo que podría ganarme unos cientos de millones?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000643",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tal cual. De darse las circunstancias, todo ese dinero podría ser suyo,\nNakamura-sama.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000082",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Circunstancias? ¿Qué circunstancias?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-210,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000644",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, para eso necesito que firme este juramento escrito, nyah.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000083",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“G-Guh...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"El rostro del viejo Nakamura toma un tinte de seriedad mucho más fuerte que\nhasta hace un momento.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Al principio no parecía confiar en lo que Akashi decía, pero la tarjeta de\nKenichiro y el juramento escrito en inglés parecieran estar alejando las\nsospechas de su cabeza.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Pero sobre todo eso, esos supuestos cientos de millones es lo que más parece\natraer su atención.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Solo lo había escuchado por rumores, pero vaya que los Nakamura se han hundido\nen lo más profundo.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"La expresión en su cara cambió por completo apenas salió el monto de dinero en\nla conversación.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000645",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Siendo culto y de buena familia, supongo que el inglés no es nada difícil para\nusted, ¿no? El contenido no es nada difícil de entender.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Akashi se para.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Los hombres de negro se alertan.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Pero esta vez Akashi permaneció firme.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Conociéndolo, seguramente ya analizó la situación. Está convencido de su\nvictoria.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000084",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Tú, muchacho, ¿cuál es tu nacionalidad? Viendo todo esto, llegaste a tratar con\nKusanagi cuando vivía en Nueva York, y además el juramento está escrito en\ninglés.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000646",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Soy italiano, pero de raíces árabes.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000085",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Italiano? ¿De raíces árabes?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Por el amor de Dios, si vas a mentir por lo menos di que eres de Asia.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000086",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Hmh... Ya veo, así que eres de Italia, pero de ascendencia árabe...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Parece que el viejo Nakamura no le dio mucha importancia a la mentira de Akashi\ny su nacionalidad. Vaya que no tiene nada en la cabeza este vejete.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Aunque no es tan carente de sentido, supongo. Akashi es alto, tiene unos\nfuertes rasgos faciales, y sobre todo, tiene esa forma tan extravagante de\nactuar siempre. Entre todo eso, no sería raro que pudiera hacerse pasar por\nalgo tan exótico como un italiano de raíces árabes.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Y la forma en que se viste es extraña también.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-210,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000647",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es casi un código de conducta en negocios tener que firmar un juramento escrito\nal momento de hablar de cuestiones multimillonarias, ¿no cree? Incluso la\npropia información que le voy a dar vale dinero.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000087",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"bgm",stop=1,time=500},
{"se",id=1,file="se2554_n"},
{"text"},
text={
ja={
{
"En ese momento, alguien comenzó a sonar repetidamente el timbre de la casa.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"¿Ahora quién?",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="man_syi_000088",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Quién es?!”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"se",id=1,file="gatya"},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Justo al voltear todos a ver hacia la puerta, un hombre de gran estatura la\nabrió y entró.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"msgoff"},
{"se",file="se9010",vol=40,id=1},
{"fg",ch="フリッドマン",size="z1",time=800,sync=1,mx=40,mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
{"bgm",file="bgm102"},
{"text"},
text={
vo={
{"vo",file="man_frd_000006",ch="frd"},
},
ja={
{
name={"???"},
"“Me pidieron que viniera y por eso entré, pero no sabía que en Japón recibían a\nla visita de semejante manera.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="man_syi_000089",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿U-Un extranjero?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"¿Quién es ese tipo? Es primera vez que lo veo. No tiene aspecto de japonés,\nparece caucásico.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Sin inmutarse ni un poco ante la situación alrededor, el hombre comenzó a\nhablar.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000007",ch="frd"},
},
ja={
{
name={"???"},
"“No tiene nada de extraño que la Fundación Moore venga a visitar a la familia\nKusanagi, ¿no le parece?”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Su japonés es muy bueno.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="man_syi_000090",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Fundación Moore?”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000008",ch="frd"},
},
ja={
{
name={"???"},
"“Tenga.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"se",file="se9010",id=1,vol=40},
{"text"},
text={
ja={
{
"El hombre caucásico caminó hacia Nakamura y le dio una tarjeta.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Ninguno de los guardaespaldas pudo reaccionar ante la firmeza en su andar.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000091",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Fundacion Moore, Curador, Marty Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"user",mode="conf",ch="フリッドマン"},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=-345,lv=4,id=9},
{"fgact",ch="フリッドマン",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000009",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El mismo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Fridmann... ¿Es aquel tipo que Kenichiro había mencionado?",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000092",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Es que tenemos un curador acá ahora?”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000010",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿No me crees acaso? Puedes buscarme entonces en Internet. Mi nombre está en el\nsitio de la Fundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000093",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡B-Búsquenlo!”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Al parecer los hombres habían comenzado a buscar antes de que Nakamura diera la\norden, y la respuesta fue inmediata.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="man_kfa_000008",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“N-No miente... es uno de los curadores de más alto nivel de la Fundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000011",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Creo que no tengo nada más que hablar con ustedes. Vine porque debía tratar un\nasunto con Naoya Kusanagi, aunque...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_frd_000012",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No pensé encontrarme con el mundialmente reconocido Wataaru Akkashi en este\nlugar.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="man_syi_000094",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0006",head="aka_z1e",lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000648",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="明石",size="z1",ex01="e0099",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"bgm",file="bgm008"},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000649",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Jaa? A-Ah, sí. C-Como les dije, soy el mundialmente reconocido Wataaru\nAkkashi.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x2=0,x=-345,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000095",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Quién es este tipo? ¿Lo conoces?”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="man_frd_000013",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ya él mismo te explico quién es, ¿no? Creo que no hacen falta más\nexplicaciones...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"¿Qué demonios le pasa a este gringo?...",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"Entra de repente y ahora está tomando la batuta de la conversación.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000096",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Es que en realidad eres de la Fundación Moore, Wataaru Akkashi?”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000650",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pueees, sí tengo relación con la Fundación Moore, pero quizás sería más\napropiado decir que soy un intermediario, nyah.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
vo={
{"vo",file="man_frd_000014",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“En pocas palabras, podría considerarlo como una especie de negociante.\n¿Necesita más explicación que eso?”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000097",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Negociante...”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000651",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“A eso me dedico, sí.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"¿Qué tiene en mente Fridmann?",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Nuestras miradas se cruzan.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"Pero su expresión no cambia en absoluto.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Buena voluntad... no parece ser, ciertamente.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000098",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Si este tipo realmente es un curador de alto nivel, eso quiere decir... ¿Que\neste también es de verdad?”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000652",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso es lo que llevo todo este tiempo intentando decirle, nyaaah.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"No, espera. Fridmann nunca llegó a decir explícitamente que Akashi es un\nnegociante.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Simplemente se limitó, después de que Akashi mencionara lo de intermediario, a\ndecir que podría considerarlo como 'una especie de negociante'.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"Pero el vejete Nakamura se tomó esa palabra en serio...",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Mi viejo tenía razón. Este gringo es bastante hábil.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000653",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Puede ver usted, mi señor Nakamura, yo solo vine para presentarle una gran,\ngran oportunidad, nyaaah.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000654",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por favor, le ruego que firme el juramento. Así podré hablarle de esta\nmaravillosa oportunidad multimillonaria.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000099",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000015",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No se preocupe por mí. Siendo el albacea de Kenichiro Kusanagi, solo vine acá a\nhablar con Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="man_frd_000016",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Aunque a mi parecer no tiene nada de raro firmar un juramento escrito cuando\nse trata de un asunto de tal magnitud.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000655",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. Solo es un juramento concerniente a la confidencialidad del asunto.\nPuedo ofrecerme a traducir el documento, si es que no se le da el inglés.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000100",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡No hace falta! ¡Dame eso!”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Fue entonces que por fin el vejete Nakamura se dispuso a firmar el juramento de\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000656",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Todo en orden, me parece...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000101",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Y bien? ¿De qué trata ese negocio multimillonario?”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000657",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, fíjese, hace un momento lo escuché hablando de la deuda que el señor\nKusanagi tiene con usted. Y pensé que quizás esa deuda podría ser devuelta\ncon cuadros.”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000102",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Con cuadros? ¿Quieres decir con cuadros de Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000658",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, tal cual.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000103",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Vaya estupidez. ¿Cientos de millones habías dicho, muchacho? Las pinturas de\nKusanagi llegan a las decenas de millones, como mucho. Exceptuando 'Cerezos\nrecostados', la cual vale unos cuantos cientos de millones, según dicen.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="man_wtd_000659",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Veo que conoce del tema.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000104",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Es imposible que haya tanto dinero en las pinturas de Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000660",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“La verdad es que sí lo es, mi señor.”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000105",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Dónde? ¿Es que acaso tiene una colección de cuadros de artistas famosos?”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="man_wtd_000661",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tal vez la tenga, pero su valor no cambiaría mucho con respecto a sus propias\npinturas, me parece.”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000106",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Entonces--”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000662",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Le pido que se detenga y piense un momento. ¿Nunca le ha parecido raro que el\nseñor Kusanagi haya publicado solo una obra relacionada a cerezos? Solo una.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000107",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Tengo entendido que fue pintada en memoria de Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0006",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000663",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000108",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Ah, no. Simplemente leí en una revista que el cuadro se culminó motivado\njustamente a la muerte de su mujer.”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000664",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, 'Cerezos recostados' fue, ciertamente, pintada en su memoria.”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000109",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Estás hablando para adelante y para atrás! ¡¿A qué quieres llegar?!”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="man_wtd_000665",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hay un poema que acompaña a 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000110",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Un poema?”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="man_wtd_000666",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿No lo conoce?”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000111",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Cómo dice el poema?”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0008",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="いいえ",time=800,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000667",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿C-Cómo dice? E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000017",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Una ilusoria apariencia del color de primavera, recubriendo el cielo, solo\nalumbra, brillante, radiante, deslumbrante, ciegamente, sin pensarlo, esa\nlámpara de causalidad enlazada.”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000018",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Un magneto de sandía, el punto de cruce del sonido y las palabras, cada vez más\ndentro de un mundo excesivamente coloreado.”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000019",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Los siete cerezos me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000020",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Vinieron hacia mí y me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000021",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Más allá del paisaje, no estoy yo, y más allá de mí, no está el paisaje.”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000022",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Persiguen, sobrepasan, y desaparecen.”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000023",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Y este mundo suavemente envuelto va desapareciendo.”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000024",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El mundo resonó, dentro de ese suave bosque de cerezos. El mundo resonó con un\nhermoso tono.”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="フリッドマン",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000668",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0011",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000025",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Muchos lo catalogan como un poema con un tono extremadamente filosófico, pero\nse dice que esa parte filosófica nació de la relación que tuvo con su esposa,\nMizuna.”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0001",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000026",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Muchas fueron las veces que en entrevistas el señor Kusanagi llegó a exponer su\nvisión del mundo, del cuerpo y el corazón citando el juego de palabras creado\npor cierto neurocientífico.”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0010",head="fri_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000027",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pero aun así, hay muchas partes envueltas en misterio.”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000669",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sí, así es, así mismo!”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000670",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Una de las partes que más intriga ha atraído es la de los siete cerezos!”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Eso no tiene nada de misterioso. Lo de los siete cerezos surgió de los siete\nescalones a la salvación de la religión cristiana, que en principio surgieron\nde la antigua Babilonia.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"Es una moraleja no muy conocida en Japón, pero sí en Occidente.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"El número siete apareció por primera vez en Zaratustra, donde cada uno de los\ndioses recibió un número distinto, costumbre que luego fue adoptada por el\ncristianismo. Lo de los siete pecados también viene de ahí.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"La expresión de los siete cerezos que mi viejo usó en el poema está basado en\nesos dos principios.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Los siete cerezos son los escalones a la verdad y la salvación, y a la vez\nsiete pecados.",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"Él mismo me lo ha explicado.",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000112",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Y cuál es ese misterio?! ¡Odio que hablen para atrás y para adelante, vayan\ndirecto al grano!”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"Siendo un cascarrabias desde que nació, el vejete Nakamura no tardó en comenzar\na irritarse.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
ja={
{
"Ahora que firmó el juramento, debe estar muriéndose por enterarse de la verdad\ndel asunto.",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
vo={
{"vo",file="man_wtd_000671",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pero existe una hipótesis que es capaz de resolver este misterio.”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="man_syi_000113",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Una hipótesis?”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000672",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Los siete cerezos existen.”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"fg",ch="明石",mode=-1,lv=4,id=5},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0003",head="fri_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_frd_000028",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Je.”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
ja={
{
"Fridmann lanzó una especie de soplido. ¿Se rió?",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000114",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Que le pasa, Fridmann-san? ¿Es todo mentira?”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",x=-345,lv=4,id=5},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0004",head="fri_z1a",x=-345,lv=4,id=5},
{"fgact",ch="フリッドマン",act="うなづく",time=100,size=5,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_frd_000029",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Para nada, solo que me sorprende que hablen de eso acá. Jejeje...”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000115",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué quiere decir?”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_frd_000030",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pues, suponiendo que las siete obras existan, con toda seguridad tendrán un\nvalor enorme.”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000116",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Eh? ¿Siete obras?”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_frd_000031",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Solo infiero de lo que él dijo. Si los siete cerezos realmente existen entonces\ndeberían ser como siete obras, ¿no cree? Es decir, Kenichiro Kusanagi ha\ncreado una serie de obras basada en los siete cerezos.”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"fg",ch="フリッドマン",mode=-1,lv=4,id=5},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000673",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000117",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“E-Eso quiere decir que, aparte de 'Cerezos recostados', hay seis obras más.”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000674",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Exactamente. Esa noticia está prevista ser publicada tras la muerte del señor\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000118",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000675",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Sí, es un hecho. El señor Kenichiro planea publicarlas después de su muerte.”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000119",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿P-Por qué después de morir?”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000676",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No lo sé, la verdad. O mejor dicho, no sabía. Fue hoy que me di cuenta.”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000120",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿D-De qué?”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000677",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así como usted, Nakamura-sama, el señor Kenichiro también estaba endeudado. Y\nestá convencido de que la muerte lo salvará.”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000121",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“C-Ciertamente... No hay ningún garante de por medio.”",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000678",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fue ahí que pensé esto, ¿no será que estará intentando dejar pasar esa deuda y\ndejar toda su fortuna a su hijo, Naoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000122",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Qué?! ¡Ese maldito! ¡No puedo creer que vaya a usar ese truco tan sucio!”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000679",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ciertamente, es imperdonable. ¡Como amigo del señor Kenichiro, yo también\nquisiera insistirle en que toda deuda debe pagarse!”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000123",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡P-Pues convéncelo de eso!”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000680",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es imposible. Teniendo la muerte ante sus ojos, se ha vuelto mucho más terco de\nlo normal. Aunque bueno, quizás sea una forma de redimirse por todo el tiempo\nque no pasó con su hijo. Y por eso mismo quiere pagar eso con dinero.”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
ja={
{
"Increíble. Esta historia no podía ser más ridícula.",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
"Y sin embargo, tiene sentido.",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000124",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000681",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Yo podría servirle de intermediario, si así usted lo desea.”",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000125",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Eh? ¿Qué acabas de decir?”",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000682",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Yo podría poner seis de esos siete cerezos en sus manos, Nakamura-sama.”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"fg",ch="章一",mode=-1,lv=4,id=6},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0006",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000032",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Planeaba hacer oídos sordos a esta conversación, pero ya no puedo más.”",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_syi_000126",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Q-Qué tienes que ver tú en esto?!”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000033",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“De realmente existir los siete cerezos, es el deber de la Fundación Moore,\nencargada de administrar los bienes del señor Kusanagi, de cuidar de esas\nobras.”",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000683",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Discúlpeme y perdóneme, pero tengo entendido que su deber como albacea se debe\ndar después de que el señor Kenichiro muera, ¿o me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0004",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_frd_000034",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ciertamente. Pero la Fundación Moore ha apoyado al señor Kenichiro en cada una\nde sus obras. No vamos a permitir que ninguno de sus cuadros sean vendidos\nsin permiso alguno. Esta condición es inquebrantable.”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0006",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000684",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya, vaya. Las cosas se tornan un poco más difíciles teniendo a la Fundación\nMoore en contra, eh.”",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"fg",ch="フリッドマン",mode=-1,lv=4,id=6},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000127",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿W-Wataaru Akkashi, eres mundialmente reconocido, es que no puedes hacer nada?”",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000685",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Algo puedo hacer, claro que sí. No en vano soy el mundialmente reconocido\nWataaru Akkashi, nyaaah.”",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"text"},
text={
ja={
{
"¿Es una broma, Nakamura? ¿De verdad le crees a Akashi, vejete?",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
ja={
{
"No. Es la forma en que Fridmann pretende alterarse lo que lo hace confiar en\nél.",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000128",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Si realmente puedes hacer algo, entonces--!”",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000686",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya que sí, nyah. Bien, señor Nakamura, ¿podría entonces firmar este\njuramento?”",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"se",file="se9010",id=1,vol=40},
{"text"},
text={
ja={
{
"El nuevo juramento era un bulto algo grande de papeles, sostenidos por cinta de\nencuadernación.",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
ja={
{
"Ni siquiera un contrato regular tiene ese bulto de páginas. ¿Qué tanto hay\nescrito en todas esas páginas?",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000129",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000687",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Es un juramento escrito para venta, respecto a lo que mencioné previamente.”",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000130",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿No es un contrato?”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000688",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Así es. Por lo general las ventas individuales de cuadros realizados en\nabsoluto secreto se ejecutan mediante juramentos escritos. También están\ndescritos todos los otros detalles del negocio.”",
{"rt2"},
},
},
},
linkback="block_00428",
linknext="block_00430",
},
block_00430={
{"text"},
text={
ja={
{
"Primera vez que escucho todo eso. Y obviamente, no tiene fundamento alguno.",
{"rt2"},
},
},
},
linkback="block_00429",
linknext="block_00431",
},
block_00431={
{"text"},
text={
ja={
{
"Es tanto el contenido que probablemente entra tanto en detalle como lo haría un\ncontrato. ¿Qué es lo que hay escrito adentro?",
{"rt2"},
},
},
},
linkback="block_00430",
linknext="block_00432",
},
block_00432={
{"fg",ch="章一",mode=-1,lv=4,id=6},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000035",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Wataaru Akkashi, si de verdad existen los otros seis cerezos, entonces exijo\nque firme de inmediato una petición a la Fundación Moore.”",
{"rt2"},
},
},
},
linkback="block_00431",
linknext="block_00433",
},
block_00433={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000689",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Preferiría que me diera algo más de tiempo, nyaaah.”",
{"rt2"},
},
},
},
linkback="block_00432",
linknext="block_00434",
},
block_00434={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0004",head="fri_z1b",x=345,lv=4,id=6},
{"fgact",ch="フリッドマン",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000036",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“De ninguna manera. Nosotros también tenemos nuestra línea de acción, y debemos\nseguirla.”",
{"rt2"},
},
},
},
linkback="block_00433",
linknext="block_00435",
},
block_00435={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0003",head="aka_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000690",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Nakamura-sama, le pido que se decida ahora mismo. De esperar mucho la Fundación\nMoore se interpondrá y no podré moverme con libertad para ayudarlo a usted.\nLe pido que firme ya, por favor.”",
{"rt2"},
},
},
},
linkback="block_00434",
linknext="block_00436",
},
block_00436={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000037",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No lo haga, Mr. Nakamura. No es buena idea que firme un juramento escrito con\nun tipo como este.”",
{"rt2"},
},
},
},
linkback="block_00435",
linknext="block_00437",
},
block_00437={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000131",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Qué pretendes, imbécil?! ¡Estás haciendo todo lo contrario a lo que dijiste\nhace un rato! ¿Qué se podía esperar de la Fundación Moore? Dinero es lo único\nque les importa.”",
{"rt2"},
},
},
},
linkback="block_00436",
linknext="block_00438",
},
block_00438={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000132",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Eeeih! ¡Dame mi bolígrafo y mi sello!”",
{"rt2"},
},
},
},
linkback="block_00437",
linknext="block_00439",
},
block_00439={
{"text"},
text={
vo={
{"vo",file="man_kfa_000009",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿D-De verdad cree que este bien hacerlo? Jamás había escuchado de algo así.”",
{"rt2"},
},
},
},
linkback="block_00438",
linknext="block_00440",
},
block_00440={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000133",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿No estás viendo la actitud que está tomando la gente de la Fundación Moore?!\n¡Es más que obvio que es verdad! ¡Dame eso rápido!”",
{"rt2"},
},
},
},
linkback="block_00439",
linknext="block_00441",
},
block_00441={
{"text"},
text={
vo={
{"vo",file="man_kfa_000010",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00440",
linknext="block_00442",
},
block_00442={
{"fg",mode=-2},
{"se",file="se9048",id=1},
{"text"},
text={
ja={
{
"Con el bolígrafo y el sello que el guardaespaldas le dio, el vejete Nakamura\nfirmó el juramento.",
{"rt2"},
},
},
},
linkback="block_00441",
linknext="block_00443",
},
block_00443={
{"text"},
text={
ja={
{
"Si bien procuró echar un pequeño vistazo con el primer juramento, esta vez no\nparece haber revisado nada.",
{"rt2"},
},
},
},
linkback="block_00442",
linknext="block_00444",
},
block_00444={
{"text"},
text={
ja={
{
"Aunque bueno, nadie querría ponerse a leer semejante cantidad de texto en\ninglés. Pero este juramento es mucho más grueso que el anterior.",
{"rt2"},
},
},
},
linkback="block_00443",
linknext="block_00445",
},
block_00445={
{"text"},
text={
ja={
{
"No cabe duda alguna, sea lo que sea que tenga adentro, es mucho peor que un\ncontrato.",
{"rt2"},
},
},
},
linkback="block_00444",
linknext="block_00446",
},
block_00446={
{"text"},
text={
ja={
{
"Es un acto de suicidio firmar sobre algo así sin siquiera echarle un ojo.",
{"rt2"},
},
},
},
linkback="block_00445",
linknext="block_00447",
},
block_00447={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=-345,lv=4,id=5},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_frd_000038",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Tch, así que decidió firmar el juramento. Personalmente, me parece una pena.”",
{"rt2"},
},
},
},
linkback="block_00446",
linknext="block_00448",
},
block_00448={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000134",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Más que seguro están ustedes emparejados con Kenichiro Kusanagi, maldita\nFundación Moore! ¡¿Pena?! ¡No me jodan!”",
{"rt2"},
},
},
},
linkback="block_00447",
linknext="block_00449",
},
block_00449={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_frd_000039",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Pues... la verdad es que no tengo manera de responder a ese comentario.”",
{"rt2"},
},
},
},
linkback="block_00448",
linknext="block_00450",
},
block_00450={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000135",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Bien, respecto a las pinturas...”",
{"rt2"},
},
},
},
linkback="block_00449",
linknext="block_00451",
},
block_00451={
{"fg",ch="フリッドマン",mode=-1,lv=4,id=5},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0002",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_wtd_000691",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Solo deme algo de tiempo, Nakamura-sama. Solo algo de tiempo, y verá que\nlograré convencer al señor Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00450",
linknext="block_00452",
},
block_00452={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=345,lv=4,id=6},
{"fgact",ch="章一",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_syi_000136",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Dejo todo esto en tus manos, famoso y mundial Akkashi-kun!”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"fg",ch="章一",mode=-1,lv=4,id=6},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0005",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000040",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No crea que me he dado ya por vencido. Si realmente esas obras existen, la\nFundación Moore no se detendrá para nada.”",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1e0000",face="e0001",head="aka_z1e",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000692",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jajajaaan, no deberías subestimar al mundialmente reconocido Wataaru Akkashi,\nMr. Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
block_00455={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0004",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000041",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Lo mismo digo yo.”",
{"rt2"},
},
},
},
linkback="block_00454",
linknext="block_00456",
},
block_00456={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_syi_000137",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡B-Bien, te encargo con esto! ¡N-No dejes que los de la Fundación te tomen la\ndelantera!”",
{"rt2"},
},
},
},
linkback="block_00455",
linknext="block_00457",
},
block_00457={
{"fgact",ch="明石",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000693",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Por supuesto! ¡Déjelo todo en mis manos!”",
{"rt2"},
},
},
},
linkback="block_00456",
linknext="block_00458",
},
block_00458={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00457",
linknext="block_00459",
},
block_00459={
{"text"},
text={
ja={
{
"Hasta ahora estuve contemplando todo lo que ha estado pasando, pero ya quisiera\nvolver al tema original.",
{"rt2"},
},
},
},
linkback="block_00458",
linknext="block_00460",
},
block_00460={
{"text"},
text={
ja={
{
"Alzo la voz y le hago una advertencia a todos.",
{"rt2"},
},
},
},
linkback="block_00459",
linknext="block_00461",
},
block_00461={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que me importa un comino lo que acaban de discutir, y les advierto\nque todos ustedes están entrando ilegalmente en propiedad privada. Llamaré a\nla policía.”",
{"rt2"},
},
},
},
linkback="block_00460",
linknext="block_00462",
},
block_00462={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1b0000",face="b0005",head="fri_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000042",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Yo soy de la Fundación Moore, por si no fui lo suficientemente claro.”",
{"rt2"},
},
},
},
linkback="block_00461",
linknext="block_00463",
},
block_00463={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Me da igual! Estás en Japón, ¿podrías al menos quitarte los zapatos al entrar?”",
{"rt2"},
},
},
},
linkback="block_00462",
linknext="block_00464",
},
block_00464={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0010",head="fri_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_frd_000043",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Oh, disculpa por eso.”",
{"rt2"},
},
},
},
linkback="block_00463",
linknext="block_00465",
},
block_00465={
{"text"},
text={
ja={
{
"Debo decirlo... la conversación tomó un rumbo que jamás me hubiese esperado.\nSimplemente increíble.",
{"rt2"},
},
},
},
linkback="block_00464",
linknext="block_00466",
},
block_00466={
{"text"},
text={
ja={
{
"¿Coincidencia?... O es que...",
{"rt2"},
},
},
},
linkback="block_00465",
linknext="block_00467",
},
block_00467={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
