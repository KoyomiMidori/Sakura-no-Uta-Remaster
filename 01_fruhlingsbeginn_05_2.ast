astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0002",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm037"},
{"se",id=1,file="se1789"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay bastantes, eh.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0012",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000084",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000130",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo también quiero participar en la sesión de dibujo. Quiero eyacular a Rin-\nsenpai.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No acabas de decir algo distinto? La parte que venía antes del '-ar'.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000131",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, dije dibujar. ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z2",mode=3,resize=1,path=":fg/tho/z2/",file="tho_z2a0200",face="a0001",head="tho_z2a",lv=5,id=9},
{"fgact",ch="トーマス",act="うんうん",time=800,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000030",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH, YES, eyacular... eyacular encima de la modelo...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",id=1,file="se1866"},
{"fg",mode=-2,sync=0},
{"bg",zoom=55,speed=300,file="zbg049k",path=":bg/",z2=50,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="トーマス",size="z2",zoom=110,speed=300,mode=3,path=":fg/tho/z2/",file="tho_z2a0200",face="a0006",head="tho_z2a",y2=0,z2=100,y=60,lv=5,id=9,sync=0},
{"extrans",time=0},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_tmd_000031",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡AUCH! ¿Pero qué haces? ¡Acabo de decir 'dibujar'!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, estás mintiendo. Estoy absolutamente seguro de que dijiste algo vulgar.\n¡Además, ¿cómo se supone que vas a dibujar encima de la modelo?!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0200",face="a0005",head="tho_z1a",y=60,lv=4,id=9,zoom=110},
{"fgact",ch="トーマス",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000032",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡¿En base a qué dices eso?! ¡Eso es un prejuicio!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa, vigila muy bien a este tipo. Me causa algo de ansiedad, en varios\nsentidos.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0016",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000085",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entendido. Yo me encargo. No dejaré que haga nada raro.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000132",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si llega a hacer algo problemático, le cortaré los ojos al instante con uno de\nlos cuchillos de mi posesión, así que no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no tienes por qué recurrir a esos ataques tan crudos... Espera,\n¿caminas a todos lados con tu propio cuchillo?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000721",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, es un alivio que la única persona problemática que parece haber\nalrededor hoy es Thomas.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿hoy no ha venido Akashi?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000722",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, vaya que no es momento para que esté viniendo al colegio.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, en este caso ya para esta época debería haberse confirmado la repetición\nde su año. Es todo un milagro por parte de este colegio que aún tenga\noportunidad para graduarse.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0029",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000723",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejando eso de lado, ¿será que comenzamos ya? Rin-chan, ¿todo listo?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0029",head="mak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000392",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, a la perfección. ¿Qué pose debería hacer?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000724",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Veamos, bueno, esta pose es bastante común...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Toritani le enseña la forma de posar como modelo a Rin.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Durante la sesión de dibujo de hoy no podrá moverse durante 1 hora.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"No hay muchas poses que resulten fáciles de dibujar para principiantes y que\ntambién sean cómodas para el modelo.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Una vez terminaron de discutir acerca de las poses, Toritani le da las órdenes\na las muchachas de primer año.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000725",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, préstenle a todos papel y tablas para dibujar, y también los lápices de\nsu preferencia.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000086",ch="rna"},
{"vo",file="fem_yum_000133",ch="yum"},
},
ja={
{
name={"Rina y Yuumi"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, tomaré mi pose yo también...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mm~”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000393",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo? ¿Por qué la cara complicada?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es que creo que de verdad hay algo raro con este esmoquin. Digamos que me\ninquieta un poco...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000394",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te inquieta?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000726",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000395",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Kusanagi-kun dice que la textura de su esmoquin es distinta a la de\nsiempre, y parece que le inquieta eso...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0008",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000727",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace rato dijiste lo mismo, ¿no? Pero, debería ser el mismo que te pusiste la\notra vez, puesto que lo colgué en el mismo sitio...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto lo colgaste en la sala de preparativos, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000728",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"La sala de preparativos... Cualquier integrante del club podría entrar\nfácilmente allí.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000729",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A qué te refieres exactamente con que te inquieta?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siento que a la tela le falta tensión, o algo así...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000730",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ehm, ¿será que se siente igual a esto?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"se",file="se9012",id=1,vol=60},
{"fg",time=500,sync=1,mode=-2},
{"fg",ch="真琴",size="z2",sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0910",face="a0012",head="mak_z2a",lv=5,id=5},
{"se",stop=1,id=1,time=500},
{"fgact",ch="真琴",act="うなづく",lv=5,id=5},
{"se",file="se9010",vol=80,id=2},
{"text"},
text={
ja={
{
"“Toritani me deja tocar los volantes de su vestido de maid.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000731",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal? Al ponérmelo también me pareció que la tela era algo rara...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es. Es exactamente la misma textura que este esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000732",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Hablas en serio? ¿Por qué tu esmoquin y los trajes de maid que Thomas me\ndio tienen la misma textura?”",
{"rt2"},
},
},
},
