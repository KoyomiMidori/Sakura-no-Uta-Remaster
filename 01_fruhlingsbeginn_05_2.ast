{"vo",file="fem_yum_000134_n",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Podemos comenzar ya?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_000087",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que todos están listos.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ten cuidado, probablemente reemplazó mi esmoquin con otro idéntico.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0013",head="mak_z2d",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000733",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Pero, seguramente lo hizo con algún propósito. Lo que más me preocupa\nahora es que el material de este esmoquin y los trajes de maid es el mismo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=5},
{"text"},
