vo={
{"vo",file="fem_mkd_000734",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto me da mala espina...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_rna_000088",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esto... ¿Podemos comenzar ya?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0006",head="mak_z2a",lv=5,id=5},
{"fgact",ch="真琴",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000735",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Queda suspendido el evento! Esto está demasiado raro.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es mejor suspenderlo temporalmente y...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000396",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Pero parece que todos están esperando...”",
{"rt2"},
},
},
},
