{"extrans",time=100},
{"se",id=2,file="se2500_z01"},
{"fg",ch="優美",size="z1",lv=9,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0022",head="yum_z1a",x=0,id=9},
{"fgact",ch="優美",act="びっくり",lv=9,id=9},
{"fgact",ch="優美",act="icon",lv=9,id=9,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000136",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"quake"},
{"se",file="se9056",vol=60,loop=1,id=1},
{"bg",file="mobu02",id=2,lv=2,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"bg",file="mobu05",id=5,lv=5,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"bg",file="mobu01",id=1,lv=1,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"bg",file="mobu04",id=4,lv=4,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"bg",file="mobu03",id=3,lv=3,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"bg",file="mobu06",id=6,lv=6,time=100,sync=1,path=":cg/mobu/",set="mobu",ax=960,ay=563,bx=0,by=-23},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Kawachino intentó acercarse a Thomas, pero se ve obstruida por la ráfaga de\ndisparos de las pistolas de agua.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Por supuesto, Kawachino anda en uniforme, así que su ropa no se disuelve. Sin\nembargo, estamos en los primeros días de abril, toda esa cantidad de agua es\nlo suficientemente fría como para detenerla.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",lv=8,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a1310",face="a0007",head="mak_z1a",x=-345,id=9},
{"fg",ch="圭",size="z1",lv=9,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,id=10},
{"fgact",ch="真琴",act="びっくり",lv=8,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000740",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--! ¡Todos ustedes, deténganse ya!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="圭",size="z1",lv=9,mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0014",head="kei_z1c",x=345,id=10},
{"fgact",ch="圭",act="いいえ",lv=9,id=10},
{"text"},
text={
vo={
{"vo",file="man_ked_000797",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwah! ¿Qué pasa, qué pasa? ¡Mi ropa está rara!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="man_nst_000021",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Yo entré a este colegio con mis ojos puestos en este 'otoko no ko'!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_itm_000020",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¡Yo vine por esa hermosa chica!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="man_ktg_000011",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“¡Fufufu, aprovecharé la ocasión y le dispararé a esta!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"cgdel",id=-1},
{"bg",speed=300,time=200,sync=0,file="zbg049a",path=":bg/",x2=-360,y2=-10,x=0,y=-10,ax=1920,ay=1126,bx=-960,by=-586},
{"quake",mode="mw"},
{"ex",time=50,func="wait"},
{"text"},
delay={
[900]={
{"bg",time=100,file="black",path=":bg/"},
},
[1000]={
{"bg",file="sp0200o_上からの打撃01",rule=104,time=100,id=9,lv=9,path=":cg/"},
{"se",id=1,file="se2500"},
},
},
text={
ja={
{
name={"Naoya"},
"“¡Paren ya! ¡Este evento no trata de esto! Uawaah, pero qué frío.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",time=200,file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_jka_000006",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“La ropa de este muchacho también se disuelve, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Es verdad, mi esmoquin está comenzando a derretirse.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero q--! ¡¿Por qué hiciste que mi ropa también se pudiera disolver, Thomas?!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0002",head="tho_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000036",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Mi amor por el arte es puro DESU. Amo los desnudos, sin importar el género.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No me jodas!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"se",id=1,file="se2500_z01"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000009",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¡Eh!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwah!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Todo el fuego de las mujeres se concentra sobre mí, pero...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Acaso creyeron que un hombre como yo se echaría hacia atrás solo porque mi\nropa se disuelve?!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"se",file="se9015",id=1},
{"fg",mode=-2},
{"bg",speed=300,sync=0,file="zbg049a",path=":bg/",x2=390,y2=30,x=590,y=30,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="真琴",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a1300",face="a0010",head="mak_z2a",x=-345,lv=5,id=5},
{"fg",ch="稟",size="z2",speed=300,sync=0,mode=3,path=":fg/rin/z2/",file="rin_z2a1300",face="a0010",head="rin_z2a",x=345,lv=5,id=6},
{"text"},
text={
ja={
{
"Me acerco corriendo rápidamente hacia el lado de Toritani y Rin.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Están bien? ¡Por ahora cúbranse detrás de mi espalda!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1310",face="a0006",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000741",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Sí! ¡Rín-chan! ¡Cúbrete ahora detrás de mí!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a1300",face="a0006",head="rin_z2a",x=345,lv=5,id=6},
{"fgact",ch="稟",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000402",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si hago eso te tomarán como blanco, Toritani-san. ¡No puedo hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="man_nst_000022",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Rodéenlos!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Toda una fuerza completa contra tres personas indefensas. Ahora que incluso yo\nsirvo de blanco, no puedo proteger por completo a las dos.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1300",face="a0007",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000742",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah! ¡¿Crees que voy a dejar que pongas tus manos sobre Rin-chan?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Uno de los alumnos escurrió mi guardia y dio la vuelta hacia la retaguardia de\nlas dos.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_ktg_000012",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“¡Te tengo! ¡Con esta pistola de agua que puede disparar en ráfaga podré hacer\nnada sus trajes en un instante!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No voy a dejar que lo hagas!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a1300",face="a0005",head="rin_z2a",x=345,lv=5,id=6},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1300",face="a0024",head="mak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000403",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",file="se3130",vol=80,id=1},
{"fg",ch="稟",mx=40,mode=-1,lv=5,id=6},
{"text"},
text={
ja={
{
"Rin desaparece por un instante de mi campo de visión.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Ninguno de los que estaban ahí lograron entender lo que había sucedido.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_ktg_000013",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“¡¿Jaa?!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",time=100,sync=1,file="black",path=":bg/"},
{"se",file="se2271",id=1},
{"bg",file="battle_003",id=8,lv=8,rule=071,time=100,sync=0,path=":cg/battle/",set="battle"},
{"quake"},
{"ex",time=50,func="wait"},
{"bg",file="閃光中",id=9,lv=9,rule=105,time=100,sync=0,path=":cg/battle/",set="battle"},
{"se",id=2,file="se1780"},
{"quake"},
{"ex",time=100,func="wait"},
{"cgdel",id=-1},
{"bg",time=100,sync=1,file="black",path=":bg/"},
{"bg",time=100,speed=300,x=-1340,y=-810,zoom=120,sync=0,file="zbg049k",path=":bg/",y2=-400,ax=1920,ay=1126,bx=-960,by=-586},
{"se",file="se_attack08",id=3},
{"quake",size=20},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"En el próximo instante, el hombre de hace un momento estaba ahora desmayado a\nlos pies de Rin.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a1300",face="a0013",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a1300",face="a0005",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000743",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“R-Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a1300",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000404",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lamentablemente, con mi ropa en este estado no puedo controlar muy bien mi\nfuerza.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Es ya la segunda vez que veo a Rin lanzando a un hombre, pero aun así no pude\nde ninguna manera seguir ese movimiento con mis ojos.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"La palabra 'rápido' se queda corta para describir esto.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"No hay casi ningún fallo ni desperdicio de tiempo en sus movimientos.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a1300",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000405",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si es por mí, no tienen de qué preocuparse. Puedo defenderme sola.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a1300",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Todos los hombres que iban por Rin quedaron atemorizados al instante con ese\nataque.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Aunque aun así, por más rápida que sea, es imposible esquivar todos los\ndisparos de las pistolas de agua.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Pero si demuestra que tiene voluntad para atacar tal como lo acaba de hacer,\nlos oponentes también vacilarán.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Aquellos que están apuntando a Rin no pueden atacarla tan fácilmente ahora.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",id=1,file="se2500"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a1300",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000744",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toritani!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a1300",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000406",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Toritani-san!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a1310",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000745",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Estoy bien!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Toritani, quien realmente no tiene mucha habilidad física, se había convertido\nahora en el blanco.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",lv=4,id=10},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=10},
},
},
text={
vo={
{"vo",file="man_ked_000798",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mierdaaa! ¡No sé qué demonios está pasando, pero dispárenme a mí! ¡Vinieron\npor mí, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Kei lanza una fuerte voz.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",id=1,file="se2500_z01"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0010",head="kei_z1c",lv=4,id=10},
{"fgact",ch="圭",act="びっくり",lv=4,id=10},
{"fgact",ch="圭",act="icon",lv=4,id=10,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000799",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Gyawawawah! ¡Está bastante frío!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"No hacía falta que dijera eso para que los hombres que vinieron por Kei le\ndispararan.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Ahora en este momento, ya parecían haberse separado por completo los grupos que\nvinieron por Kei, y los que vinieron por Rin y Toritani.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"se",id=1,file="se2500"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000007",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Eh! ¡Eh!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Y además, un grupo de chicas estaba ahora disparándome a mí también.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"No me importa terminar mojado, pero el agua que fue disparada hacia mí podría\ncaerle a Toritani y a Rin.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Quisiera cubrirlas a las dos, pero si no tomo en cuenta la posición física,\nterminaré más bien metiéndolas a todas ellas en más lío.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a1300",face="a0014",head="mak_z2a",lv=5,id=5,sync=0},
{"extrans",time=500,sync=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1400",face="a0014",head="mak_z2a",lv=5,id=5,sync=0},
{"extrans",time=1000,sync=1},
{"fgact",ch="真琴",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000746",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡U-Uwah, m-mi ropa va disolviéndose cada vez más!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Rin y yo usamos nuestras manos para evitar, en la medida de lo posible, que\nnuestros cuerpos se mojen, pero Toritani no puede hacer eso.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Todos están disparando a mansalva a ese blanco casi inerte.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mierda, estos imbéciles! ¡Toritani! ¡Ya no puedo contenerme más! ¡Voy a\ngolpearlos!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1410",face="a0017",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000747",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué pretendes hacer recurriendo a la violencia en este lugar?!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hay manera de detenerlos!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1400",face="a0006",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000748",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Hay que persuadirlos!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"se",id=1,file="se2500"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1400",face="a0010",head="mak_z2a",lv=5,id=5},
{"fgact",ch="真琴",act="びっくり",lv=5,id=5},
{"fgact",ch="真琴",act="icon",lv=5,id=5,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000749",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Crees poder persuadirlos en esta situación?! ¡La única forma de detenerlos es\nmoliéndolos a golpes!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a1410",face="a0006",head="mak_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000750",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vas con todas las ganas de golpearlos a todos, ¿no? ¡Si llegas a ir en serio\nesto terminará muy mal! ¡Además, también hay chicas adentro!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Crees que eso me importa ahora?!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_wtd_000179",ch="wtd"},
},
ja={
{
name={"???"},
"“Hou~, ¿jugando a las pistolas de agua~? Luce divertido, nya~”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Se escucha una voz desde encima.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"El segundo piso de la sala de arte está parcialmente expuesto al exterior para\nque pase el sol, y por eso hay casi el doble de techo. Pero aun así, se\nsupone que ahí no hay ningún lugar donde pueda pararse nadie...",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esa voz? ¡¿Akashi?! ¿Dónde estás?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000180",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wajajaja! ¡Qué envidia me da ver cómo se divierten tanto sin mí!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Olvida eso, ¿dónde estás?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000181",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wajajaja! ¡Estoy acá!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bgm",stop=1,time=100},
{"msgoff"},
{"bg",zoom=100,y=580,speed=300,time=0,sync=1,file="zbg049k",path=":bg/",z2=50,y2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"ex",time=500,func="wait"},
{"quake",size=50},
{"bg",y=580,time=200,sync=0,file="zbg049i",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586},
{"bgm",file="bgm008"},
{"text"},
delay={
[70]={
{"se",id=1,file="se1059"},
},
},
text={
ja={
{
"El vidrio de una de las ventanas del techo expuesto al exterior se rompe. Y de\nallí aparece Akashi.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000751",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿P-Pero de qué clase de lugar andas apareciendo?! ¡Y en primer lugar, ¿por qué\nrompes la ventana?!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_wtd_000182",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, juraba que la ventana de arriba se podría abrir, pero no se puede, nya~\nSe me hacía tedioso seguir así, así que la rompí.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En fin, Akashi, haz algo respecto a esto!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_wtd_000183",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Algo, ehh. No sé cómo resultará esto, pero me permitiré participar yo también\nen este pequeño juego. Pero, antes de eso, tomen esto.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"se",file="se9020",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Akashi nos lanzó algo desde arriba.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"se",file="se9018",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué diablos es esto?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000752",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Estas son máscaras de seguridad para construcción?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000407",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué tienes máscaras de seguridad para construcción?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="man_wtd_000184",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Me las cogí discretamente cuando trabajaba de medio tiempo en una compañía de\ndesmantelamiento de casas. Esas máscaras sirven para varias situaciones, así\nque las estoy coleccionando.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_wtd_000185",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Tomen! ¡También hay gafas!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",file="se9020",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Akashi nos lanzó unas gafas protectoras contra polvo.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Máscaras y gafas protectoras contra polvo?! ¡¿Qué demonios piensas hacer?!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000186",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wajajaja! ¡Soy toda una autoridad en lo que a estos problemas se refiere! ¡No\nhay manera de que se lleven a cabo sin mi asistencia!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000187",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Eh, intento de extranjero! ¡Debo reconocer que no estuvo mal tu plan, pero,\ndigamos que para un estratega de primera clase como yo, esto aún no pasa de\nser de segunda clase!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_wtd_000188",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Creíste que aún después de comentar con tanta libertad en ese video no me\ndaría cuenta?! ¡Zopenco! ¿Qué tal, se te mojaron los pantalones? ¿Estás\ntemblando del miedo ahora?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_tmd_000037",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡Ouh! ¡Desnudo, dibujo al desnudo!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Thomas está totalmente concentrado en su boceto.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te están ignorando.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_wtd_000189",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ehh! ¡¿Y piensa seguir mofándose de mí?!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_wtd_000190",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Bien, démosle inicio al plan! ¡Integrantes del club de arte, pónganse sus\nmáscaras! ¡Activen protección anti-shock, anti-lacrimógena! ¡Prepárense para\nel ataque!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Protección anti-lacrimógena?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="man_wtd_000191",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡SWITCH ON!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bg",file="bg049i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",id=1,file="se1349"},
{"bg",file="smoke",id=8,lv=8,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=9,lv=9,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=10,lv=10,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=11,lv=11,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"cgact",file="smoke",id=8,lv=8,act="いいえ",time=100000,size=500,loop=-1},
{"cgact",file="smoke",id=9,lv=9,act="浮遊",time=5000,size=100,loop=-1,zoom=150},
{"cgact",file="smoke",id=10,lv=10,act="ウゴウゴ",time=5000,size=10000,loop=-1,zoom=150},
{"cgact",file="smoke",id=11,lv=11,act="ゆらゆら",time=8000,size=3,loop=-1,zoom=150},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿QU--?!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a1400",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1400",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000753",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Eso es?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"De las manos de Akashi es despedido un humo blanco junto a un estruendoso\nsonido. Más que humo, pareciera que estuviera saliendo una sustancia blanca.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese humo es...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000408",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un extintor de fuego?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000192",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wajajaja! ¡Este extintor está en un nivel totalmente distinto a sus patéticas\npistolitas de agua! ¡Es un instrumento excepcional que cumple con las\nreformas de estándares y especificaciones para extintores establecidos por el\ngobierno en el 2011!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_itm_000021",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“U-Uwah, ¿qué pasa? ¿Qué es ese vapor? ¡No puedo ver nada!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="man_nst_000023",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“G-Guhaa, m-me pican los ojos, gehoo, gehoo.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="man_wtd_000193",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Wajajaja! ¡Los extintores causan bastante picazón en los ojos, y también\nprovocan una tos indetenible!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"En un abrir y cerrar de ojos, la sala de arte estaba ahora cubierta de humo\nblanco.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"La concentración del vapor va incrementándose cada vez más. Parece que Akashi\nusó más de un extintor.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin duda alguna, sería todo un lío estar metido acá sin máscara ni gafas.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000409",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los ataques de todos los demás cesaron.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000754",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Ciertamente, con todo este vapor adentro quizás queden inmovilizados todas las\npersonas que llevan pistolas de agua consigo. Sin embargo, nuestro campo de\nvisión también está muy limitado y no podemos movernos descuidadamente.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000755",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Akashi-senpai! ¡En este estado nosotros tampoco podemos movernos!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esta estrategia falló! Hay tanto vapor en el lugar que no podemos fijar la\nvista.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="man_wtd_000194",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Cóooomo que falló?! ¡¿Me crees capaz de cometer un error así de básico?!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",ex03="a0097",mode=3,path=":fg/mak/z1/",file="mak_z1a1400",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1400",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000195",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kusanagi! ¡Agarra a las dos y muévete más o menos 1 metro hacia la izquierda!\n¡Hay una pared allí, así que pon las manos adelante y cuando detectes la\npared, camina agarrándote de ella hacia la izquierda! ¡Una vez gires la\nesquina que está tres metros adelante tendrás la salida justo al lado!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",ex03="d0097",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0001",head="rna_z1d",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",ex03="a0097",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_wtd_000196",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kawachino y Hikawa, retrocedan lentamente! Detrás de ustedes está la puerta\ndel cuarto de preparativos de la sala de arte. ¡Apenas entren adentro pasen\nla cerradura de la puerta y esperen allí!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",ex03="c0097",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0001",head="kei_z1c",lv=4,id=10},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="man_ked_000800",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Q-Qué hago yo, Akashi-senpai?!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="man_wtd_000197",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Kei, tú muévete 1 metro hacia la derecha!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"cgdel",id=-1},
{"se",file="se9023",id=1},
{"fg",mode=-2},
{"bg",x=-960,speed=1000,time=0,sync=0,file="zbg049a",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="圭",size="z2",ex03="c0097",speed=1000,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",x2=-1000,x=0,lv=5,id=10},
{"bg",file="smoke",id=8,lv=8,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=9,lv=9,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=10,lv=10,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=11,lv=11,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"cgact",file="smoke",id=8,lv=8,act="いいえ",time=100000,size=500,loop=-1},
{"cgact",file="smoke",id=9,lv=9,act="浮遊",time=5000,size=100,loop=-1,zoom=150},
{"cgact",file="smoke",id=10,lv=10,act="ウゴウゴ",time=5000,size=10000,loop=-1,zoom=150},
{"cgact",file="smoke",id=11,lv=11,act="ゆらゆら",time=8000,size=3,loop=-1,zoom=150},
{"text"},
text={
vo={
{"vo",file="man_ked_000801",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡1 metro hacia la derecha, entendido!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000198",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Allí es donde está la mayor concentración de enemigos, así que toma toda la\nráfaga de fuego de ellos y actúa como señuelo!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fgact",ch="圭",act="びっくり",lv=5,id=10},
{"fgact",ch="圭",act="icon",lv=5,id=10,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000802",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué solo yo tengo que actuar de señuelo?!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="man_wtd_000199",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Les daré nuevas órdenes tan pronto detecte un cambio en el estado actual de\nlas cosas! ¡Comiencen con la ejecución del plan ya!”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fgact",ch="圭",act="いいえ",size=5,time=500,lv=5,id=10},
{"fgact",ch="圭",act="icon",lv=5,id=10,icon="icon04z2",x=65,y=-525},
{"text"},
text={
vo={
{"vo",file="man_ked_000803",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿D-De verdad seré el anzuelo?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"cgdel",id=-1},
{"fg",mode=-2},
{"bg",sync=0,file="bg049i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bg",file="smoke",id=8,lv=8,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=9,lv=9,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=10,lv=10,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=11,lv=11,zoom=150,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"cgact",file="smoke",id=8,lv=8,act="いいえ",time=100000,size=500,loop=-1},
{"cgact",file="smoke",id=9,lv=9,act="浮遊",time=5000,size=100,loop=-1,zoom=150},
{"cgact",file="smoke",id=10,lv=10,act="ウゴウゴ",time=5000,size=10000,loop=-1,zoom=150},
{"cgact",file="smoke",id=11,lv=11,act="ゆらゆら",time=8000,size=3,loop=-1,zoom=150},
{"text"},
text={
ja={
{
"Nuestros ojos perciben toda la sala de arte repleta de humo. Sin embargo,\nparece que Akashi, estando arriba, no se ve casi afectado.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Evaluó de manera precisa el estado actual, y nos ordenó hacer eso.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ciertamente, las partículas del extintor son más pesadas que el aire.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Incluso eso tomó en cuenta al realizar los cálculos de su plan.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",ex03="a0097",mode=3,path=":fg/mak/z1/",file="mak_z1a1400",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1400",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Toritani! ¡Rin! ¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000410",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Tomo las manos de las dos y corro hacia la puerta, guiándome por la pared.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Y entonces――",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se1822"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000756",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"bgm",file="bgm015"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La puerta está cerrada con llave.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000757",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_wtd_000200",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Qué pasa?! ¡¿Por qué no salen?!”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La puerta está cerrada por fuera!”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000758",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se supone que esta puerta no se puede cerrar de afuera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente pusieron algo afuera en la puerta para atascarla.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000759",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es ese algo?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe ser el palo que Thomas llevaba hace un rato. Dijo que lo necesitaría para\ndibujar, pero parece que era para esto...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000760",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Atascar la puerta con un palo desde adentro? Eso es imposible.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, es simple. Basta con colgar el palo del extremo más cercano, darle un\npequeño golpe al momento de cerrar la puerta y hacer que caiga del lado de la\nmisma. Después solo necesita cerrar la puerta lentamente para que el palo\nencaje en la hendidura.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000761",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pero entonces él tampoco podría salir!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Crees que alguien que piense de verdad en lo que le vendrá después de cometer\nesto se pondría a hacer estas cosas? En el peor de los casos podrían\nexpulsarlos.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"cgdel",id=-1},
{"bg",file="smoke",id=8,lv=8,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"bg",file="smoke",id=9,lv=9,path=":cg/",ax=1728,ay=540,bx=-768,by=0},
{"text"},
text={
ja={
{
"El vapor va aclarándose.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000411",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="man_nst_000024",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“¡Encontramos a las muchachas de hace rato!”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="man_ktg_000014",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“*gehoo*, *gehoo*, al fin comenzó a desaparecer el humo...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="man_itm_000022",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“Oh sí, aquí comienza el verdadero juego.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000038",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YE~S.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A como están las cosas, parece que tendré que ir en serio...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",ex03="a0097",mode=3,path=":fg/mak/z1/",file="mak_z1a1410",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1400",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000762",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡De ninguna manera puedes ir en serio y violentar a los demás! ¡Si llegas a\nhacer eso te expulsarán a ti!”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1410",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000412",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun. Yo puedo inmovilizar a los demás sin herirlos.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no funcionará. Observa nada más eso. El tipo que lanzaste hace un rato está\nya levantándose.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="稟",size="z1",ex03="a0097",mode=3,path=":fg/rin/z1/",file="rin_z1a1400",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000413",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De no ir con toda intención de herirlos no habrá forma de detenerlos.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_wtd_000201",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya, vaya... ¿pero qué estará pasando?... Ya deberían estar por llegar...\nAunque se está tardando, eh.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
