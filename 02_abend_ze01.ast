astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=0},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, bueno, supongo que no está nada mal regresar juntos de vez en cuando.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000236",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Sí lo es!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué vienes a decir eso tú?!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000237",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué? Pues lo dije por decir, sí.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No taches algo de mal con tanta ligereza...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000238",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo dije con ligereza, sí... ¡Pero me parece detestable que Rina y yo tengamos\nque regresar contigo! ¡No, diría que es más bien inaceptable!... Con esa\nligereza lo dije.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tan tajante?...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000239",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién sabe? ¿No será que es porque te odio, senpai?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué se supone que debo ser tan odiado por ti, Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000417",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajaja, senpai, hay ciertas cosas en las que no tienes arreglo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cosas en las que no tengo arreglo?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000240",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Rina!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Por cosa extraña, Kawachino llamó a Hikawa con un tono relativamente alto.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Hikawa respondió a ese llamado con una sonrisa forzada.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000418",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien, está bien, no hace falta que alces tanto la voz...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm, ¿qué se supone que fue eso?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000419",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa realmente, sí. Volviendo al tema original, no está de más que\nregreses con nosotras de vez en cuando, ¿no crees? Puede ser incluso otro\ndía, si así quieres.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000420",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto, incluyendo a Yuumi también.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000241",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Y-Yo?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000421",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Preferiría que vinieras con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000242",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh... Me alegra bastante esa propuesta, pero la idea de regresar junto a\nKusanagi no me gusta...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000422",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vamos, tampoco es para que pongas tan mala cara.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, tampoco es para que pongas tan mala cara.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000243",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*mirada punzante*.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhh...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Esa mirada me atravesó...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000244",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Kawachino se quedó viéndome con una mirada penetrante.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Me siento como una ranita siendo acechada por una serpiente...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000245",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uhhhn. Sí, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000246",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quizás no está tan mal irnos todos juntos de vez en cuando...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Esa reacción fue inesperadamente pacífica.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000247",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Además, si Kusanagi intentara hacerle algo raro a Rina, sería la oportunidad\nperfecta para matarlo a puñaladas...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Hombre, ¿pero qué clase de razón es esa?",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=6},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000423",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, ¿nos vamos los tres juntos hoy entonces?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",size=30,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000248",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*burun*, *burun*.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Yuumi gira fuertemente la cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000424",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Hoy no quieres?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000249",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Umuh. No quiero.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000425",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-senpai... realmente te odian.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000250",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo odio.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué demonios me lo tienen que recalcar tanto?!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000426",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué será?... Parece que tienes un largo historial de asuntos por los que\npodrías hacerte responsable, así que es inevitable que suceda esta clase de\ncosas, ¿quizás?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres... con eso?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000427",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pueees, ¿quién sabe? Pero vamos, eso no importa ahora. En fin, no te molesta\nque regresemos juntos un día de estos, ¿no? Cuando tengas tiempo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, por eso no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000428",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi vendrá con nosotros también en esa oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000251",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Le daré bastante filo al señor Bob Kramer para la ocasión!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",file="se9010",id=1},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
ja={
{
"Kawachino saca un cuchillo de cocina.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esp--¿pero qué clase de cuchillo es ese? Tiene incluso un patrón de\ndamasquinado... ¿De verdad es eso un simple cuchillo de cocina?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000252",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo es. Bob Kramer es conocido como uno de los cuchillos de cocina de mejor\ncalidad del mundo. ¡Y así como su filo, su agarre es irresistible! ¡El mango\nestá hecho del mismo material Micarta que se emplean en los cuchillos de\nmayor calibre!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"se",id=1,file="se2271_n"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",size=30,lv=4,id=6},
{"text"},
text={
ja={
{
"Al decir eso, Kawachino comienza a blandir y mover el cuchillo de un lado a\notro.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Cuida donde mueves ese cuchillo!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000253",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hasta hace un tiempo me la pasaba con un cuchillo convencional a todos lados,\npero sería un lío que la policía me cogiera con uno encima, así que ahora\nllevo uno de cocina.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso un cuchillo de cocina te traerá un buen lío, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000254",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hay problema, solo basta con que diga que pertenezco al club de cocina del\ncolegio, y que por ende llevo mi propio cuchillo de cocina.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Problemas es lo único que te traerá eso.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",time=300,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000429",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vamos, dejemos las cosas así. Alejar a Yuumi de cualquier tipo de objeto\ncortante es prácticamente imposible.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos quieres decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000255",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Que soy una damisela penetrante y filosa como una hoja de acero.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
delay={
[500]={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
ja={
{
name={"Naoya"},
"“¿No te da vergüenza andar diciendo eso? ¡E-Espera, no blandas esa cosa frente a\nmí!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"excall",file="02_abend_02_1"},
{"text"},
linkback="block_00061",
},
label = {
top={block="block_00000",label=1},
},
}
