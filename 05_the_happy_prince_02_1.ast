astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Pasan los días.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"A una velocidad que poco a poco va rebasando a aquella de la infancia.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"He escuchado que los veinte son el punto medio de nuestras vidas.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"¿Eso quiere decir que mi vida llegara a su punto medio en unos años?",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Recuerdo haber conversado con el viejo acerca de eso cuando todavía estaba\nvivo.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"El paso del tiempo siempre cambia con el entorno. No hay tiempos iguales.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Por eso es que existen los relojes, y por eso es que compartimos todos un mismo\ntiempo, decía él.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Compartimos todos un mismo tiempo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Relojes, días, calendarios.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Agujas se mueven, calendarios se hojean, y nuestros días avanzan hacia un punto\ndistinto al presente.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"cgdel",id=-1},
{"msgoff"},
{"bg",speed=300000,file="zbg052a",path=":bg/",x2=960,y2=-586,x=960,y=586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Estaba ahora cara a cara con el libro de texto, como de costumbre.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Tapé las respuestas del libro con cinta de celofán rojo, aprendiéndome de\nmemoria varias cosas.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Y no está mal, siento que mi conocimiento está agrandándose.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Mientras más palabras en inglés me aprendo, más fácil me entra la gramática.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"El tiempo que estuve en Nueva York era capaz de sostener conversaciones\ncotidianas. Lo cual significa que mientras más vocabulario acumulo, mis\ncalificaciones en inglés suben.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Me gusta también la matemática, pero llega un momento en el cual el talento\ninfluye.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Hay quienes pueden moverse libremente por la dimensión matemática sin mayor\nproblema, pero hasta ese nivel no llego.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Y no hace falta. Me basta con poder resolver la cantidad mínima de problemas\nnecesarios para no reprobar.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"En lo que respecta a lenguaje moderno, la verdad es que lo odio. Suele pasar\nque no estoy de acuerdo con ninguna de las respuestas. ¿Será que no tengo\nsensibilidad literaria? A veces me dan ganas de romper el papel.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"También estoy viendo ética. Se me da bien, y la tengo como pasatiempo.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Pero hay pocas universidades donde sirva de algo. Por lo general entran también\npolítica y economía en los estudios.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Aun sin entendimiento geográfico alguno, puedo moverme sin tanta dificultad por\nestas asignaturas.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"También me gusta la física. Siento una indescriptible emoción al ver la\nmatemática aplicada al mundo real.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y bueno, así es como van mis estudios para los exámenes de la universidad.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"msgoff"},
{"bg",file="bg052a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_itm_000023",ch="itm"},
},
ja={
{
name={"???"},
"“¿Eh? Kusanagi, ¿has estado estudiando acá?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="中里",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/nst/z1/",file="nst_z1a0000",face="a0001",head="nst_z1a",x=-345,lv=4,id=5},
{"fg",ch="一宮",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Allí estaban mis compañeros de clase... A y B.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="中里",size="z1",ex04="a0096",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0003",head="nst_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_nst_000026",ch="nst"},
},
ja={
{
name={"Alumno A"},
"Espera, ¿no se te estará pasando algo muy ofensivo por la cabeza o sí?",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como qué?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_nst_000027",ch="nst"},
},
ja={
{
name={"Alumno A"},
"“Alumno A, y eso...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, si es por eso no te preocupes. No es algo ofensivo.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="一宮",size="z1",ex04="a0096",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0002",head="itm_z1a",x=345,lv=4,id=6},
{"fgact",ch="一宮",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_itm_000024",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“¡Lo es! ¡Apréndete de una buena vez los nombres de tus compañeros de clase, por\nlo menos!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, tampoco hace tanta falta saberse los nombres. Basta con poder\ndiferenciarlos.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="一宮",size="z1",ex04="a0096",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_itm_000025",ch="itm"},
},
ja={
{
name={"Alumno B"},
"“Pues no nos diferencies como A y B. Vamos, qué agallas...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0001",head="nst_z1a",x=-345,lv=4,id=5},
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_itm_000026",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Pues no se cuántas veces lo he dicho ya, pero mi nombre es Ichinomiya. Y este\nacá es Nakasato.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_itm_000027",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“De verdad que no pareces tener interés alguno...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿En qué andan ustedes?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_nst_000028",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Somos de tercer año, ¿qué más podríamos estar haciendo? Estudiar, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"El tema del cual más se habla en esta época es, obviamente, los exámenes de\ningreso a la universidad.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Estando con la gente del club de arte me hace sentir fuera de sintonía con eso.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"¿Por qué? Pues, han dejado los estudios a un lado para poder pintar...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0003",head="itm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_itm_000028",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"¿Dónde piensas aplicar, Kusanagi?",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo dinero, así que a alguna pública o nacional. De ser posible, por la\ncapital.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_itm_000029",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿Por la capital? Todas las universidades allá son del nivel más alto.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso dije, de ser posible. Quisiera ir allá.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_nst_000029",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“¿Qué puntuación has obtenido en los problemas pasados?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En los de seis asignaturas, 7.5, por ahí...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_nst_000030",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“¿En serio? Vaya cerebro que te gastas, eh.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Eso jamás lo escucharía estando con Rin y Toritani.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Siempre se burlan de mí, diciéndome tonto, idiota.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, debo decir que no se me da mal inglés y matemática. Y bueno, ya podrás\nver el resultado, ja, ja, ja.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0001",head="itm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_itm_000030",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Ah, demonios, de verdad que no se te da mal nada, eh... 7.5 en seis materias...\nYo apenas llego al 70 % con solo tres materias.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja ja ja, no me molestan los elogios.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="一宮",mode=-1,lv=4,id=6},
{"fg",ch="東浪見",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=345,lv=4,id=6},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000009",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“¿Oh? Qué raro verlos juntos, eh. ¿Estaban hablando con Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fgact",ch="中里",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_nst_000031",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Sí, le estaba preguntando dónde iba a aplicar.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_trm_000010",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“Ya veo. Yo pienso ir a una escuela vocacional. Mis calificaciones han bajado\nmucho desde que entré a Yumihari, pero la mayor razón es porque quiero\nconvertirme en seiyuu.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Seiyuu? ¿Los que hacen las voces de doblaje y de los anime?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fgact",ch="東浪見",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000011",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“Así es. Por eso planeo ir a una escuela vocacional.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, así que tienen escuelas vocacionales para eso también.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="東浪見",size="z1",ex04="a0096",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0003",head="trm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000012",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“Obvio que las hay, ¿de qué otra manera podría convertirse alguien en seiyuu?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo pensaba que ese tipo de personas recibían algún tipo de educación especial\ndesde niños, o algo así.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="東浪見",size="z1",ex04="a0096",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=345,lv=4,id=6},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000013",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“¿Eh? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si aplica para seiyuu, pero en mi tiempo en Nueva York todas las personas\nque llegué a ver persiguiendo profesiones especiales como canto o baile\nmarcaban la diferencia ya de niños...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_itm_000031",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Tienen a la meca allá, no es de sorprenderse. Broadway, y eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Mi viejo era algo peculiar, y tuve la oportunidad de ver a mucha\ngente excepcional en esos caminos.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="東浪見",size="z1",ex04="a0096",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0003",head="trm_z1a",x=345,lv=4,id=6},
{"fgact",ch="東浪見",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000014",ch="trm"},
},
ja={
{
name={"Alumno D"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Alumno D perdió los ánimos. Diablos, debo consolarlo.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pero eso es así en los Estados Unidos. Los seiyuu en Japón son distintos,\n¿no? Supongo, aunque no sé realmente.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0003",head="nst_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_nst_000032",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Pero sí, las personas excepcionales son excepcionales desde niños.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay muchos que siendo excepcionales de niños, dejan de serlo de adultos...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo mismo he visto a muchos así...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Entre ellos yo mismo...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así que no abandones tus sueños, Alumno D-kun!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0002",head="trm_z1a",x=345,lv=4,id=6},
{"fgact",ch="東浪見",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000015",ch="trm"},
},
ja={
{
name={"Torami"},
"“¡Que no soy Alumno D! ¡Soy Torami!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",mode=-2},
{"fg",ch="片貝",size="z1",ex04="a0096",mode=3,resize=1,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ktg_000015",ch="ktg"},
},
ja={
{
name={"Alumno C"},
"“Viendo cómo van las cosas, probablemente tampoco recuerdes nada de mí.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Alumno C!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",lv=4,id=9},
{"fgact",ch="片貝",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ktg_000016",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Es Katakai.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya es hora de que me aprenda sus nombres. Eh, comencemos por... ¿cómo es\nque era?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ktg_000017",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“No importa, puedes llamarme Alumno C si quieres.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_ktg_000018",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Volviendo al tema, pensé que te irías por una universidad de artes, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las universidades de arte son difíciles también. Tienes que tener una\npreparación especializada para ellas.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="man_ktg_000019",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¿Y no la tienes ya? Te criaste en un garaje taller en Chelsea, Nueva York, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo estuve un año allá.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por otro lado, me sorprende que sepas que viví en Chelsea.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_ktg_000020",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Lo leí en una revista. Definitivamente tipos como tú se crían de manera\ndistinta a los demás. Eso pensé cuando vi el artículo.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, solo fue un tiempo. La gran mayoría de mi vida la he pasado en\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="片貝",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_trm_000016",ch="trm"},
},
ja={
{
name={"Torami"},
"“¿Y tú qué piensas hacer, Katakai?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_ktg_000021",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Ni idea, no me he puesto a pensar.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_trm_000017",ch="trm"},
},
ja={
{
name={"Torami"},
"“Pero si tienes mejores calificaciones que todos nosotros.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="東浪見",mode=-1,lv=4,id=6},
{"fg",ch="片貝",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x2=-345,x=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_ktg_000022",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Tampoco son tan buenas.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cuánto has sacado en el nacional?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_ktg_000023",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Al terminar las vacaciones de verano logré un 7.8 para seis asignaturas. No\nllegué al 80 %.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"¡¿Mm?! T-Tiene... calificaciones, mucho mejores que las mías...",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡T-Tú! ¡A partir de hoy serás mi enemigo imaginario!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_ktg_000024",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Pues entonces por lo menos apréndete mi nombre...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Eh... ¿Cómo es que era?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0002",head="kat_z1a",x=0,lv=4,id=9},
{"fgact",ch="片貝",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ktg_000025",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“Es Katakai.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Seguimos hablando un rato más acerca del rumbo que tomaría cada uno.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Intercambiamos información de cuáles eran los mejores libros, o quiénes son los\nmejores profesores en la escuela preparatoria.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"No es algo que experimente con frecuencia, pero me hizo sentir la plenitud de\nla vida escolar.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg052a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003976",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Disculpa, llegué algo tarde!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",mode=-2},
{"fg",ch="東浪見",size="z1",mode=3,path=":fg/trm/z1/",file="trm_z1a0000",face="a0001",head="trm_z1a",x=-680,lv=4,id=1},
{"fg",ch="中里",size="z1",mode=3,path=":fg/nst/z1/",file="nst_z1a0000",face="a0003",head="nst_z1a",x=-210,lv=4,id=7},
{"fg",ch="一宮",size="z1",mode=3,path=":fg/itm/z1/",file="itm_z1a0000",face="a0003",head="itm_z1a",x=310,lv=4,id=8},
{"fg",ch="片貝",size="z1",mode=3,path=":fg/kat/z1/",file="kat_z1a0000",face="a0001",head="kat_z1a",x=680,lv=4,id=2},
{"fgact",ch="一宮",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="man_itm_000032",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fgact",ch="東浪見",act="びっくり",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="man_trm_000018",ch="trm"},
},
ja={
{
name={"Torami"},
"“M-Misakura-san.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="man_nst_000033",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“¿Por qué--?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fgact",ch="片貝",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_ktg_000026",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¿Está, aquí?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003977",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, hola, a todos. Vine a ayudar a Nao... ah, K-Kusanagi-kun, con sus estudios.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fgact",ch="一宮",act="びっくり",lv=4,id=8},
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=1},
{"fgact",ch="片貝",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_itm_000033",ch="itm"},
{"vo",file="man_nst_000034",ch="nst"},
{"vo",file="man_trm_000019",ch="trm"},
{"vo",file="man_ktg_000027",ch="ktg"},
},
ja={
{
name={"Todos"},
"“¡¿Y por qué?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque yo la he ayudado a aprender a pintar. Favor con favor se paga.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fgact",ch="一宮",act="びっくり",lv=4,id=8},
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=1},
{"fgact",ch="片貝",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_itm_000034",ch="itm"},
{"vo",file="man_nst_000035",ch="nst"},
{"vo",file="man_trm_000020",ch="trm"},
{"vo",file="man_ktg_000028",ch="ktg"},
},
ja={
{
name={"Todos"},
"“¡Lo sabíamos, no eres uno de los nuestros!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué les pasa ahora?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003978",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Ehh... ¿dije, algo malo?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_trm_000021",ch="trm"},
},
ja={
{
name={"Torami"},
"“N-No, por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_itm_000035",ch="itm"},
},
ja={
{
name={"Ichinomiya"},
"“Nos marcharemos ya, así que--”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_nst_000036",ch="nst"},
},
ja={
{
name={"Nakasato"},
"“Siéntanse cómodos en la biblioteca y--”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_ktg_000029",ch="ktg"},
},
ja={
{
name={"Katakai"},
"“¡Estudien bastante, sí!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fgact",ch="一宮",act="びっくり",lv=4,id=8},
{"fgact",ch="中里",act="びっくり",lv=4,id=7},
{"fgact",ch="東浪見",act="びっくり",lv=4,id=1},
{"fgact",ch="片貝",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="man_itm_000036",ch="itm"},
{"vo",file="man_nst_000037",ch="nst"},
{"vo",file="man_trm_000022",ch="trm"},
{"vo",file="man_ktg_000030",ch="ktg"},
},
ja={
{
name={"Todos"},
"“¡Hasta luego--!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"se",file="se9023",id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Por alguna razón decidieron irse.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"No sé qué clase de malentendido tendrán... Rin también los podría ayudar a\nestudiar, si tan solo le pidieran el favor...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"se",stop=1,time=500,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003979",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se fueron todos...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ni idea por qué.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003980",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los vi muy entretenidos hablando... ¿Será que los interrumpí?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tranquila. Justamente estaba con un problema que no sabía hacer, llegaste\nen buen momento. Es este...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"A veces Rin me ayudaba con los estudios, y a veces la ayudaba yo con su\npintura.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"La verdad es que si no fuese por ella mis calificaciones no habrían subido\ntanto. Un buen maestro es vital para todo.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Y entre el paso de esos días, la obra de Rin llegó al punto de culminación, y\nme pidió que la viera.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"El cuadro de Rin...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi llegó a hablarme bastante de ese talento cuando seguía aún\ncon vida.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Aunque he estado viendo cómo su obra ha progresado, así que no esperaba un\ncambio muy dramático.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Pero a pesar de eso, muy en el fondo estaba a la expectativa de ver la pintura\nde Rin Misakura, la genio aclamada por el mismísimo Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bgm",stop=1,time=1000},
{"excall",file="05_the_happy_prince_02_2"},
{"text"},
linkback="block_00132",
},
label = {
top={block="block_00000",label=1},
},
}
