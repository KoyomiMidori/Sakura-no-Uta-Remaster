astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c01_01",path=":ev/ev_eye_c01/",set="ev_eye_c01"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm023"},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000216",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ushh, esto es ya todo tu equipaje, ¿no?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000217",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aunque realmente trajiste muy poco equipaje, eh...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, no es que me voy a mudar...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_ked_000218",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero vas a vivir por un tiempo en esta casa.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí... ¡Hasta que se logre restaurar mi apartamento que TÚ inundaste!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000219",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, no digas esooo.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios, juraba que el seguro para daños causados por agua se usaba para\ninundaciones de verdad o tifones, pero no pensé que tendría que usarlo para\neso...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000220",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero es una inundación, ¿no? En cierta forma.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Una inundación provocada por ti!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000221",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya te dije que lo siento... Trabajaré de medio tiempo y te indemnizaré todo...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que el seguro para daños causados por agua lo resolvió todo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000222",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh, Naoya, estás enfadado, ¿verdad? ¿Qué puedo hacer para que se te mejore el\nhumor?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hables.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000223",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uuuu... Está bien.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="圭",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="圭",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",lv=5,id=9},
{"se",stop=1,id=1,time=500},
{"se",id=2,file="se1597"},
{"cgact",stage="bg001",act="いいえ"},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0007",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000224",ch="ked"},
},
ja={
{
name={"Kei"},
"“Geh, esto está pesado.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te acabo de decir que no hables?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0022",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000225",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pesa, esto pesa!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, pero qué escandaloso. Hay una sola caja totalmente repleta de libros.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000226",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esto pesa～”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000227",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esto pesa bastante, así que mejora un poco el ánimo cuando termine de llevarlo,\n¿sí?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se te ocurre que debería hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"msgoff"},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"se",file="se2016",id=1},
{"fgact",ch="圭",act="うんうん",time=750,size=12,lv=4,id=9},
{"fg",ch="圭",time=1500,mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x2="0,100",x=200,lv=4,id=9},
{"ex",time=1500,func="wait"},
{"msgon"},
{"se",file="se1279",id=2},
{"fg",ch="圭",time=500,mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Con un andar bastante inestable, Kei se dirigió al interior de la casa Natsume,\ncargando la caja.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Independientemente del motivo, tuve que aceptar la propuesta de Kei.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Por supuesto, no tenía ninguna intención de quedarme con los Natsume, así que\nno planeo quedarme mucho tiempo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Tan pronto termine de cambiarse el piso de mi apartamento que Kei inundó con\nagua, planeo regresar allá.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Y aun así...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="ev_com_a10_01",rule=139,vague=40,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="man_ked_000228",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero qué increíble, ¿así que lees esta clase de libros?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_ked_000229",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero si son puros libros parecidos a los textos de lengua.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="ev_com_a10_02",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000230",ch="ked"},
},
ja={
{
name={"Kei"},
"“Este tipo, Butaboku Ishikawa, salía también en los libros de texto.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Como pueden ver, su entusiasmo no es nada normal...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",file="ev_com_a10_01",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000231",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no es buta... ¿Cómo se lee este kanji? El que se parece a buta.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0010",face="h0010",head="aix_z1h",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0011",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000139",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo siento mucho... Ese idiota...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Ai pone sus ojos sobre Kei, quien estaba abriendo mi equipaje.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_ked_000232",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya me acordé, Naoya, me había equivocado. ¡Es Takuboku Ishikawa! Las letras son\nbastante pequeñitas, así que se me pareció al kanji de buta, ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, es un idiota...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0010",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000140",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uh, no tengo manera de contraargumentar eso...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en todo caso, me conseguiste un lugar para vivir hasta que terminen las\nreparaciones de la casa, así que estoy agradecido contigo por eso, Ai.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0015",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000141",ch="aid"},
},
ja={
{
name={"Ai"},
"“No pensé que sería de esta forma...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por otro lado, veo que la casa Natsume está tan grande como siempre.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000142",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es. Parece que la residencia ha estado aquí desde tiempos antiguos.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Vuelvo a echarle un ojo a la residencia.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"La mansión propiedad de la familia Natsume.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Sería normal pensar que son adinerados.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Pero las cosas no son así de simples.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Los hermanos viven solos, sin padres, en este amplio terreno...",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Hay razones muy particulares para esa estructura familiar tan extraña.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"De ninguna manera la actual familia Natsume es adinerada.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Viven sobriamente en esta enorme residencia.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000143",ch="aid"},
},
ja={
{
name={"Ai"},
"“Dejando eso de lado, tenemos un nuevo integrante en la familia ahora. Me alegra\nmucho esto. Se siente un poco solitario vivir solo nosotros en esta casa tan\ngrande.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya son 3, ¿qué piensas hacer metiendo a más gente a la familia?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000144",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, de verdad me hace sentir feliz. El hecho de que mi familia se agrande...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Pero si es por agrandar la familia, tú misma podrías embarazarte y\nagrandarla, ¿no, Ai?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"msgoff"},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2f0000",face="f0018",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"quake",size=10},
{"se",id=1,file="se2192"},
{"ex",time=400,func="wait"},
{"text"},
text={
ja={
{
"Me golpeó. A pesar de que pensé que se trataba de una broma que podía quedar\nfácilmente ignorada...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0009",head="aix_z2f",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0011",head="aix_z2f",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000145",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡O-Odio esa c-clase de bromas!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te alteras?...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0017h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000146",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡P-Porque dices cosas vulgares!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vulgar? ¿Eso piensas? Pero si no eres ninguna niña, ¿de qué te estás?...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0007",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000147",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No me llames de esa manera tan irrespetuosa!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Unuhh, ¿entonces debería llamarte muchacha pura, o algo así?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0006",head="aix_z2h",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0018",head="aix_z2f",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000148",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ese no es el problema! ¡T-Te advierto que esas vulgaridades están prohibidas\nen esta casa!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te estás enfadando tan seriamente? ¿No me digas que aun con esa edad\nsigues siendo virgen?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0023",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000149",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0006h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000150",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿'No me digas'?! ¡¿'Aun con esa edad'?! ¡Eso es bastante irrespetuoso! ¡Y está\nprohibido que lo digas! ¡Naoya, te voy a golpear!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Ai se enoja conmigo con una cara que de ninguna manera me permite siquiera\ndecirle 'Ya me golpeaste'.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"O más bien, tiene la cara llorosa...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Creo que, lo siento...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fgact",ch="藍",act="ジャンプ",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000151",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Cómo que 'creo'?!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, lo siento muchísimo.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Parece que es un tema del cual no se puede hablar.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Virgen, muchacha pura, niña... A ese tema me refiero...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000152",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, lo que quiero decir es que siento como si tuviera un hermanito más\nahora, ¿te quedó claro?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ja...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Ciertamente, no hay manera de dar a luz a hermanitos, eh...' Quería decirle\neso, pero creo que si sigo así me matará de verdad.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si es por agrandar la familia, ¿no te parece que tienes ya suficiente con\nun solo hermano?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000153",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ajaja, quizás tengas razón. Pero, Kusanagi, ¿sabes cómo nos solían llamar los\nvecinos a nosotros, los 3 hermanos, cuando salíamos a caminar juntos afuera?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ni idea...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0016",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000154",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nos llamaban 'las tres preciosas hermanas de la familia Natsume'.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0016",head="aix_z1e",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000233",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, vamos, Aneki, no digas esa clase de cosas que podrían producir\nmalentendidos. Lo único que pasa es que esa señora está mal de la cabeza.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0016",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000155",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no fue solo una vez, recuerdo que la empleada del supermercado también nos\ndijo lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000234",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, esa señora de la caja también está mal de la cabeza.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000156",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hace poco Isazaka-san se refirió a ti como 'la muchacha del medio'...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000235",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo, así que hasta Isazaka-san está mal de la cabeza...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000157",ch="aid"},
},
ja={
{
name={"Ai"},
"“No solo eso...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, Ai, Kei, no hay final en esta batalla, así que démosle fin.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000236",ch="ked"},
},
ja={
{
name={"Kei"},
"“Escucha, Aneki, todos dicen eso solo por bromear, la verdad es que nadie piensa\nrealmente que yo soy una mujer.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0016",head="aix_z1h",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000158",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero hace poco vino un hombre joven a confesarte su amor...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000237",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡E-Eso es porque ese hombre era homosexual!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No está justamente dentro de tu zona entonces?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000238",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué dices eso?! ¡Me estás sacando de mis casillas!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no sabía que había pasado eso... No podía esperar menos de ti, Kei.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0016",head="aix_z1e",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000159",ch="aid"},
},
ja={
{
name={"Ai"},
"“Creo que era un estudiante de un colegio técnico, y según dijo, se enamoró a\nprimera vista y por eso vino hasta la casa para confesársele...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Amor a primera vista, eh...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000160",ch="aid"},
},
ja={
{
name={"Ai"},
"“Parece que quedó bastante desanimado al enterarse de que era un hombre y se\nfue.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no es homosexual, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0016",head="aix_z1e",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000161",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso, lo confundió con una mujer y se enamoró.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000239",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ahhh, cállense! ¡Les prohíbo que sigan hablando de este tema!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0004",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000240",ch="ked"},
},
ja={
{
name={"Kei"},
"“Demonios, pero si hasta monto motocicleta. ¡¿No hay manera de que yo parezca\nuna mujer?! ¡Y además, siempre voy vestido con gakuran al colegio!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0017",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000162",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero siempre vas con casco y uniforme encima. Nadie se da cuenta de que eres\ntú.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000241",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso no puede ser, es ridículo...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto... Me acordé por lo de las 'tres hermanas', pero ¿qué hay de la\notra?...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000242",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ya te dije que no somos 'tres hermanas'! ¡Me voy a enojar, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000163",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, jamás has visto a Shizuku, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, bueno, no la he visto.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000243",ch="ked"},
},
ja={
{
name={"Kei"},
"“Entonces hoy la conocerás por primera vez. Te vas a sorprender.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espero que no se sorprenda ella... Con un repentino huésped al cual no conoce\npara nada.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000164",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hay problema. Por cierto, ¿Shizuku sigue aún en el trabajo? Había dicho que\nno llegaría tan tarde.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000244",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, dijo que no tardaría mucho en regresar.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Trabajo?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué trabaja? Había escuchado que era menor que ustedes, así que pensé que\nera una estudiante...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000245",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, Naoya, ¿no sabes quién es Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te dije hace un momento que no lo sé?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000247",ch="ked"},
},
ja={
{
name={"Kei"},
"“No me refiero a eso, sino acerca de quién es en la TV.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000165",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, Kei, Shizuku apenas acaba de incursionar en esa industria, así que no es\nnada raro que no la conozca.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000248",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De verdad? Hace poco hizo un debut bastante sensacional, así que me parece que\nes bastante famosa.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Debut hace poco?\nDijiste también algo de la TV, ¿qué clase de trabajo hace?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000166",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku es una artista de televisión.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"No sabía que la hermanita menor de la familia Natsume era una artista de\ntelevisión.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Realmente es la primera vez que escucho eso.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es eso como que algo problemático?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000249",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es problemático que en la casa de una personalidad de televisión viva un\nhombre joven totalmente ajeno y desconocido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000250",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hay problema con eso. Su agencia no sabe nada de esto. No hay ningún fallo\nen el plan.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es eso algo bastante grave?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000167",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues, creo que no hay problema. Si Shizuku y tú vivieran solos debajo de un\nmismo techo entonces eso sería comida para los periodistas, pero también\nestamos Kei y yo, que soy una profesora...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?... Sinceramente no me parece nada bien...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000251",ch="ked"},
},
ja={
{
name={"Kei"},
"“Bueh, no te preocupes tanto por eso.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umm, si eso dicen ustedes...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000168",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, dejando todo eso de lado, hay que terminar de mover todo el equipaje de\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000252",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, sí, revelemos rápido todo el equipaje de Naoya y hagamos su fiesta\nde bienvenida.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, respecto a eso, no toques más mi equipaje. Cada vez que lo toques te\ngolpearé.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000253",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡Pero si te estoy ayudando!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se le puede decir a alguien que está 'ayudando' cuando escupe cosas como\n'revelar' el equipaje de los demás!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="00_op_03_2"},
{"text"},
linkback="block_00134",
},
label = {
top={block="block_00000",label=1},
},
}
