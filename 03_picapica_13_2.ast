},
block_00131={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_mak_h03_08",path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
ja={
{
"La mano de Makoto se posa lentamente sobre la punta de mi miembro. Esta va\nacariciando poco a poco la cabeza, dándole un suave y tierno estímulo a mi\nprepucio.",
{"rt2"},
},
},
},
