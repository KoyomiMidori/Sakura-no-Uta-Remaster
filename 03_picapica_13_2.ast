},
block_00112={
{"bg",file="ev_mak_h03_04",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003871",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y cuando lo acaricio con cariño así como ahora... empieza a salir, tu espeso\njugo.”",
