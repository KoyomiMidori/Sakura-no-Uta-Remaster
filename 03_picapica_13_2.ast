},
block_00108={
{"bg",file="ev_mak_h03_03",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003868",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues en algún momento tenía que hacerlo... Al principio me costaba bastante\nsolo verlo, y... la verdad, me da pena decirlo de esta forma, pero no era\nnada parecido a cualquier cosa que hubiera visto antes...”",
{"rt2"},
