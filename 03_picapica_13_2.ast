linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Me da algo de pena que lo señale con tanta alegría.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo va contigo. A duras penas puedes hablar cuando juego con tu vagina, ¿o\nno?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
