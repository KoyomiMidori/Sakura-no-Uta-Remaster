{"vo",file="fem_mkd_003877",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tiene también, el olor acumulado dentro de tus pantalones... y eso, hace que\nme vaya calentando cada vez más... ¿Te has dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
