linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Lanzo sin querer un extraño chillido ante la fuerte corriente de placer que\ncorrió por mi miembro tras el fuerte agarre de Toritani.",
{"rt2"},
