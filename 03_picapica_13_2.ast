linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003879",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh... Jaa... ngh... está, saliendo bastante... Realmente, que los hombres...\nsueltan, bastante de este sucio líquido... cuando se excitan...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Mientras acaricia suavemente la cabeza de mi pene formando círculos, Makoto\ntoma firmemente mi pene y lo frota hacia arriba y abajo, yendo desde la base\nhasta el frenillo.",
{"rt2"},
