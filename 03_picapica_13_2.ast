linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada más de verlo es repugnante, ¿no te dio miedo?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003869",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“U-Uhmmm... Creo que es demasiado referirme de esa forma a él, pero... a fin de\ncuentas, es una parte más de tu cuerpo. No le tomé asco ni miedo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_mak_h03_01",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003870",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡P-Pero! ¡No creas que sigo siendo la misma de aquel entonces! Así como te lo\ndije hace un momento, ahora que me acostumbré a él, se me hace incluso tierna\nesta extraña forma que tiene... y, además... solo con darle un toquecito, se\nmueve...”",
