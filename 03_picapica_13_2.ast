},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003873",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que eso sirvió para demostrar quien lleva las riendas aquí, ¿o acaso\nnecesitas más?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Sintiendo la fuerte presión de su mano sobre mis genitales, me resigno y\nasiento rápidamente.",
