astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm009"},
{"msgoff"},
{"bg",y=260,file="zbg032c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003819",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien... ahí voy.”",
{"rt2"},
},
},
},
labelcount=2,
linknext="block_00001",
},
block_00001={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Aquí estoy!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0007",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003820",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Espera! ¡Sé que dije que me pongo nerviosa cuando te pones muy atento a lo que\nhago, y por eso te pedí que te controlaras, pero esa forma en que lo dices\nahora hace que me de miedo!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nunca te cansas de quejarte, eh!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003821",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Siento que esta vez sí podré hacerlo, así que solo siéntate tranquilo y\nobserva!!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Estaré observando, observando bastante.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003822",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... quédate quieto, así como estás. No me veas tan fijamente.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Así?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003823",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“R-Retrocede un poco más...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"se",file="se9010",id=1},
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Está bien así?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003824",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, sí. Creo que... así está bien.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003825",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, comenzaré entonces.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Siento que si llego a decir algo podría ocurrir algún problema, así que asiento\nen silencio.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bg",y=-580,speed=120000,file="zbg032c",path=":bg/",x2=-960,y2=-300,x=-960,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",speed=120000,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026h",head="mak_z2a",y2=-500,y=-780,lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Makoto pone sus manos suavemente sobre su pecho y respira profundamente. Lleva\nahora puesto el vestido de maid que todos estos años ha venido usando.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fgact",ch="真琴",act="いいえ",size=5,lv=5,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Esta toma ahora el borde de su falda.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Agarró justamente... la parte frontal de la misma.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Esto es claramente distinto a lo que ha venido haciendo hasta ahora. Las veces\nanteriores siempre la ha agarrado por los lados... Eso es una muestra de la\ndeterminación con la que está haciéndolo hoy.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Quisiera tragar saliva en este momento, pero no quiero romper con la\nconcentración de Makoto. Me quedo tranquilo, observándola fijamente.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Los movimientos de sus dedos son fluidos, y la manera en que su falda va\nsubiéndose era casi como algo de ensueño.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bgm",file="bgm103"},
{"fgact",ch="真琴",act="ジャンプ",time=1000,lv=5,id=9},
{"se",file="se9010",id=1,vol=50},
{"ex",time=200,func="wait"},
{"bg",rule="313r",time=600,file="white",path=":bg/"},
{"text"},
text={
ja={
{
"Suavemente.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Ligeramente.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Con la luz de la luna como panorama, y junto a su expresión de vergüenza, las\npantaletas comienzan a aparecer de por debajo de su falda.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Fue solo un pequeño e ínfimo instante. Y a pesar de eso, ese momento se quedó\ngrabado en mis ojos, como un panorama para la eternidad.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Eran de un llano blanco. No son de esas pantaletas que usan las mujeres para\nlucirse en la cama, y menos aún algún traje de baño escolar blanco.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"De la infinidad de posibilidades que existen, la probabilidad de que las\npantaletas ocultas tras la falda de Makoto son de un puro e inocente color\nblanco pasa a ser un hecho gracias a mi presencia como observador.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003826",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"La falda de Makoto cae suavemente de sus dedos, dándole fin a ese eterno\ninstante.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003827",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pudiste... verlas?...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las vi.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Con el corazón lleno de mil emociones, asentí. Sin querer, se me vienen las\nlágrimas a los ojos.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003828",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Espera, ¿por qué estás llorando?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada. Solo que, desde aquel incidente en Quimera en la primavera\npasada... vinieron y pasaron las estaciones, y ahora es primavera de nuevo...\nY ahora, que tuve el honor de poder ver con mis propios ojos tus\npantaletas... he quedado completamente conmovido.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Me sumo en mi emoción mientras me seco las lágrimas que se me habían acumulado\nen los rabillos de los ojos.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003829",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estás exagerando demasiado...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Makoto dice eso, volteando su cabeza y apartando la mirada a un lado,\navergonzada.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿cómo es que pudiste hacerlo tan fácilmente esta vez cuando las\nveces pasadas te costaba tanto?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003830",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, es que...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003831",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003832",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De verdad, no quisiera decirlo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es eso cierto?! Te lo ruego, dímelo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0024",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003833",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“F-Fuiste rápido en reaccionar.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En la mayoría de las casos que te pones así es porque ocultas una respuesta\nmaravillosa! ¡¡Sé exactamente lo que estuviste por decir!!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003834",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Makoto retrocede un paso, frustrada. En su expresión se podía ver que se había\ndado cuenta de que yo sabía, exactamente, lo que ella estaba pensando.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Venga, vamos, dilo sin pena.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0010",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0007",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003835",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Solo en estos momentos es que te quitas la pereza que llevas encima siempre!!\n¡¡Demonio erótico!! ¡¡Personificación de la erocontaminación!!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Di lo que quieras! ¡¡Mi novia es la mujer más linda que hay sobre la faz de la\ntierra!! ¡¿Qué problema hay en que este tan ansioso por escuchar una\nrespuesta pervertida venir de su hermosa boca?!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003836",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡E-Es que tú----!!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a decir algo sucio, ¿verdad? ¿¿O es que acaso me equivoco??”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003837",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No lo sé... Encárgate tú de decidir si lo es o no...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, excelente, es algo sucio entonces.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0006",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003838",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Otra vez con tus tonterías! ¿Quieres o no saber?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quiero saberlo.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003839",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace falta que te sientes de manera formal.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003840",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco tienes que pararte erguido como un militar... Vamos, solo compórtate\ncomo siempre lo haces.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003841",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, mejor.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003842",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por otra parte... Si pones tantas expectativas sobre mí, más bien me sentiré\nmás insegura... Te lo digo de una vez, no es la gran cosa, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Me trago mis palabras de expectativa y me dispongo a esperar tranquilamente.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003843",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Emh, en... en resumen, cambié de premisa.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De premisa?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003844",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. La razón original por la cual quería levantar mi falda, y... uhm, mostrarte\nmis pantaletas, es porque quería que te contentaras.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003845",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero pensé que tal vez, si lo hago de esa manera, me dejaré llevar tanto por\ntu mirada y tus gestos que me costará mucho hacerlo... así que...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así que?...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003846",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que... ugh... cambie mi manera de verlo, de esta forma.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003847",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si quiero... mostrarte mis pantaletas, es... porque, me emociona... c- cuando\nme ves así, y por eso...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Makoto.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003848",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿¿No te parece que esa alternativa es mucho más vergonzosa??”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"quake",mode="mw"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0007h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003849",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Lo es!! ¡¡¡¿No es acaso obvio?!!!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003850",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero es más proactivo mostrar por placer propio que para alegrar a alguien,\n¿no? Creo que... se me da mejor de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003851",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y además, funcionó...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003852",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero, pensé que me vería como toda una chica pervertida de solo pensar en\nrealmente querer mostrártelas... y, temía que si llegara a decírtelo... te\nquedarías repugnado de mí...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003853",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah-- aunque, acabo de darme cuenta que me estaba preocupando demasiado...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad que sí. Solo basta con que veas esta estúpida cara sonriente que\ntengo en este momento.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0007h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0009h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003854",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Tampoco hagas tantas muecas! Vas a estropear lo único bueno que tienes, tu\ncara.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo mi cara?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003855",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Qué? ¿Pretendes obligarme a decirlo todo?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De poder, sería fabuloso.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0015h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003856",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tienes remedio alguno...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"se",stop=1,id=1,time=500},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"se",file="se9010",id=2},
{"text"},
text={
ja={
{
"Makoto se me acerca, y me da un pequeño beso en la frente.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003857",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mi novio es el hombre más apuesto sobre la faz de la tierra, y el más\nfantástico de todos en todos los aspectos.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0029",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003858",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te amo.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también a ti.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003859",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Acercamos nuestras caras de manera espontanea, y comenzamos a darnos cortos y\nsuperficiales besos.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003860",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nm... *chu*, *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Toritani empuja ligeramente mi pecho mientras me besa.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Al retroceder unos pasos, mis piernas tocan repentinamente con algo. Me dejo\ncaer sin más allí. Sobre la cama.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003861",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No todos los días tenemos la oportunidad de hacerlo con mi traje de maid, así\nque quisiera aprovechar hoy para dejarme llevar un poco más por ese papel...\nNo te importa, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace ni falta que lo preguntes. Me muero porque lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003862",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*Uhm*...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Me mata de ternura la manera en que mi novia se vuelve una pervertida en la\ncama cuando estamos los dos solos. Me muero por ella, y no hace falta decir\nque ella por mí también.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_mak_h03_01",path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003863",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nm... apenas abro la cremallera y me encuentro con esta enorme sorpresa...\nNunca se cansa de recibirme de esta forma tan pervertida.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Makoto toma delicadamente mi erecto y duro miembro con su mano, y se queda\nobservando fijamente la punta.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_mak_h03_02",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003864",ch="mkd"},
},
ja={
{
name={"Makoto"},
"*sopla*--",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uguh.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Makoto sopla las partes más sensibles de mi punta.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_mak_h03_01",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
delay={
vl01={
{"bg",file="ev_mak_h03_02",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
},
},
text={
vo={
{"vo",file="fem_mkd_003865",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje, está palpitando un poquito... *sopla*, *sopla*.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Esta sopla una y otra vez, visiblemente entretenida. El delicado aliento de\nMakoto estimula exquisitamente el glande de mi miembro.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh, oh, fuh... ¡Makoto, deja de usarlo como si fuera un juguete!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_mak_h03_01",sync=0,face=1,time=400,path=":ev/ev_mak_h03/",set="ev_mak_h03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003866",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te parece tierna la manera en que reacciona? Mira, mira nada más.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un pene, ¿qué puede tener de tierno un pene?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003867",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero sigue siendo parte de tu cuerpo, ¿no? Y es lindo... muy bien, buen chico.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Sus blancos y delgados dedos se deslizan a lo largo de mi pene, acariciándolo\namorosamente. Makoto repite el movimiento, sobando mi pene en una lenta y\nsuave masturbación.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Quizás está de más que diga esto, pero has terminado acostumbrándote por\ncompleto, Makoto... Y pensar que la primera vez te alterabas solo viéndolo...”",
{"rt2"},
},
},
