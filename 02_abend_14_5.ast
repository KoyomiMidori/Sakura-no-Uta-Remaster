astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="小沙智",size="z1",mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0100",face="a0004",head="kos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm036"},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0003",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000176",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Puha~, comí bastante~ Estuvo muy bueno.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000188",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“De verdad que sí. Aunque sabe distinto al curry de nuestra casa.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001007",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. El curry de Kusanagi-kun sabe muy bueno~”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Mientras decía eso, Rin se disponía a servirse más curry.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Ya llevaba un buen rato pensando en esto, la verdad, y tomando en cuenta además\ntambién esa enorme caja doble de obentou que trae siempre, es posible que\nesta muchacha sea una gran comilona.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0002",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000422",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso es porque Naoya cocina muy bien.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0016",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="du",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000177",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Es justo que alguien como tú sin ninguna habilidad ni fuerte sepa por lo\nmenos cocinar.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0016",head="kos_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_001008",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso no es cierto. Kusanagi-kun también es muy bueno en muchas otras cosas.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=0,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000423",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, y sus logros más representativos van por el aspecto erótico...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="いいえ",lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000603",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Kusanagiii! ¡Bastardo! ¡¿Qué le hiciste a Shizuku?!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y-Ya te lo dije una vez, Ai! ¡Deja de alterarte por ese tema de una buena vez!\n¡Eso nunca ha pasado!”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0019",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_001015",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues sí, Naoya es como mi maestro en lo que lo erótico se refiere. Realmente no\nle puedo ganar ni una en eso.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000595",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, yo también debo admitir su gran potencial y habilidad en ese campo...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se inventen cosas que no son! ¡¿En qué momento me convertí en esa clase de\npersonaje?!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-680,lv=4,id=1},
{"fgact",ch="稟",act="おじぎ",lv=4,id=1},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-210,lv=4,id=7},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=210,lv=4,id=8},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-680,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_rnd_001009",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos~, vamos~, ¿por qué no nos cambiamos ya?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rna_000383",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿ya se puede entrar a la piscina?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001558",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, para eso es que llenamos de agua la piscina. Si de verdad solo hubiera\nsido una limpieza la hubiéramos dejado secar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=680,lv=4,id=2},
{"fgact",ch="優美",act="びっくり",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000765",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Entonces podremos entrar, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000596",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Bien! ¡¿Vamos ya?!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",lv=4,id=6},
{"fgact",ch="圭",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_001016",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos entonces...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",file="se9010",id=1},
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Traté de pararme, pero algo me jala hacia atrás.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Al observar bien, Toritani estaba tomando el borde de mi uniforme.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás haciendo? Se me va a estirar la ropa.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001559",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay forma de que el uniforme se te estire. Y dejando eso de lado, ¿no lo\nhabías prometido ya?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Prometer qué?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001560",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que estudiarías.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001561",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún queda más de 1 hora para los fuegos artificiales. Hasta ese entonces te\nquedarás estudiando.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001562",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Acaso no lo prometiste hace un rato? De que estudiarías después de comer.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nadie me dijo que iríamos a la piscina!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=7},
{"fgact",ch="真琴",act="うんうん",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001563",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso mismo dije que en el intermedio habría un momento de descanso. Vamos,\nvamos, a estudiar.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=7},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x2=0,x=-345,lv=4,id=7},
{"fg",ch="里奈",size="z1",mx=40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000384",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-senpai, ¿no vas a venir?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=-345,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001564",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te preocupes. Saldremos antes de que comiencen los fuegos artificiales.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=0,lv=4,id=9},
},
vl01={
{"fgact",ch="明石",act="du",lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000597",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Si quieres estudiar pues hazlo. Dicen por ahí, ¿de no aprovechar la juventud\npara estudiar, cuándo entonces? Estudia bastante, eh.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esp-- ¿De verdad, solo yo?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001565",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te preocupes... Te acompañaré...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"¿Acompañarme? ¿Crees que estudiaría si no hubiera nadie?...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",rule=139,vague=40,file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Toritani...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001566",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué solo yo?... También estaba Kei, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001567",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei irá a una universidad de arte, ¿no? Nada más con su técnica podrá ingresar\nfácilmente en algún lugar. Pero en tu caso, piensas ir a universidad normal,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pero... mis calificaciones tampoco son tan malas.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001568",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La diferencia que llevas entre las materias en las que eres bueno y en las que\nno es abismal. ¿Qué clase de método de estudiar se supone que usas?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estudio mucho como tal... Simplemente, rindo bien en las materias que se me\nhacen fácil y ya...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001569",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun así, de una forma u otra eres bueno en los estudios, ¿no? Si fuera por una\nsola materia, entonces quizás más que yo.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",lv=4,id=7},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001570",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero si tus calificaciones de matemáticas son mejores a las mías. Aunque quizás\nno lo parezca, mis calificaciones son de las mejores. Eso si, tal vez no\ntanto como Hirose del club de astronomía o Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso también es pura casualidad. No siempre tengo tan buenas calificaciones.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001571",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces con mayor razón, hay que estabilizar esas calificaciones...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Umuh.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Toritani también está estudiando conmigo.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Según me dijo, me pidió que le preguntara cualquier cosa que no entendiera.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Cualquier cosa que no entiendo, eh...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Y mientras abría la guía de problemas repleto de partes incomprensibles para\nmí, comencé a buscar aquellas cosas que no entiendo y que debería\npreguntarle.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto... Toritani.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001572",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué... siempre estás tan pendiente de mí?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001573",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es nada... Yo también tengo por pasatiempo meter mis narices en los\nproblemas de los demás...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es eso?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=7},
{"fgact",ch="真琴",act="うなづく",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001574",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quién sabe... Vamos, no estás haciendo nada.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001575",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001576",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero... gracias, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001577",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por lo de Akashi-senpai...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué... eres tú quien está agradeciendo?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001578",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Soy amiga de las hermanas Akashi... y bueno, Akashi-senpai también fue el jefe\nanterior, además...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así, esa no es razón para que tú tengas que dar las gracias.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001579",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Estuviste todo el tiempo atento junto a mí, de la duda que yo tenía, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De la duda que tenías? No, simplemente investigué a Akashi por interés propio.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001580",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, supongo que sí... pero, fui yo quien al principio dijo algo que propició\nque te metieras en el tema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya me había parecido algo sospechoso desde antes. Más bien, perdona por\nhaberles echado a perder el campamento, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001581",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tooonto. Si es por eso, ya todos entienden lo que sucedió.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
},
vl03={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0029",head="mak_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_mkd_001582",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En primer lugar, realmente fue divertido. Esa clase de experiencias no se viven\ntodos los días. Ciertamente, era bastante encantador lo de ir al campo de\ncampamento, pero culminar con nuestras propias manos la obra póstuma de un\nartista de renombre internacional es bastante romántico como para un recuerdo\nde verano, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, será...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001583",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Andas ahora con esa actitud fría y desinteresada, pero soy lo suficientemente\nobservadora como para saber que tú también estabas bastante emocionado en\naquel momento.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues yo también me puedo emocionar de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=7},
{"fgact",ch="真琴",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001584",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, lo admitiste fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué clase de malentendido tienes, pero yo realmente no odio a Kenichiro\nKusanagi. Simplemente, no teníamos tantos puntos en común que nos pudiera\nunir como padre e hijo. Me gustan sus obras, y bueno, en lo que respecta a su\nhabilidad, estoy más consciente que cualquier otra persona de su magnitud.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001585",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, tal vez, supongo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"se",file="se1279",id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x2=0,x=-345,lv=4,id=7},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001010",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ¿les molesta si entro?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="びっくり",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001586",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Rin-chan, ¿no habías ido a la piscina?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001011",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es que pensé en estudiar yo también. Además que por lo general siempre\nestudio a esta hora.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001587",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fgact",ch="稟",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001012",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Puedo sentarme?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001588",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡STOP! ¡Quédate allí!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001013",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",x=-345,lv=4,id=7},
{"fgact",ch="真琴",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001589",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te muevas...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=7},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
"Al pararse lentamente, se deslizó rápidamente detrás de Rin, y...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bgm",stop=1,time=500},
{"se",id=1,file="se3130"},
{"bgm",file="bgm007"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001014",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Le levanta la falda a Rin.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Y entonces, el traje de baño de Rin se mostró.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ohh!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0007",head="rin_z1b",x=0,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001015",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Qué estás haciendo?!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0016",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0007",head="rin_z1b",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001590",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh~, ¿no fue para esto que fuiste a ponerte el traje de baño~?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001016",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Por supuesto que no. Y además, no sé qué quieres decir con eso.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001591",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, es que hace un rato Shizuku-chan lo hizo, y Kusanagi puso una cara de\nbastante alegría~”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo no puse ninguna cara alegre!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001592",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué andas tratando de aseverar? A los ojos de los demás, te veías muy\nfeliz en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿En serio? Me estás mintiendo, ¿no? ¿No, Rin?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001017",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Rin aparta la vista y mueve su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puede ser. ¿De verdad me veía tan feliz?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001593",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No será por eso que Rina vino también?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",file="se9010",id=1},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018j",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="里奈",size="z1",mx=40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=570,lv=4,id=4},
{"fgact",ch="里奈",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rna_000385",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no vine por esa razón, así que no hace falta que trates de aplicar ese\njuego erótico de levantar la falda sobre mí también, y agradecería que no lo\nolvidaras.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="優美",size="z1",mx=40,mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=800,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000766",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Entonces, qué tal esto--”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="優美",my=40,mode=-1,lv=4,id=2},
{"se",id=1,file="se3130"},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0013j",head="rna_z1d",x=570,lv=4,id=4},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",x=-570,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000386",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Gyawah!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Justo en el instante en que me di cuenta que Kawachino se había parado detrás\nde Hikawa, la falda de Hikawa cayó al suelo.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",mode=-2},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0100",face="b0014j",head="rna_z2b",lv=5,id=4},
{"fgact",ch="里奈",act="うなづく",lv=5,id=4},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0006j",head="rna_z2b",lv=5,id=4},
{"fgact",ch="里奈",act="うなづく",lv=5,id=4},
},
},
text={
vo={
{"vo",file="fem_rna_000387",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Q-Qué haces, Yuumi?! ¡Y regrésame mi falda!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_000767",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes. Asumiré toda la responsabilidad del hecho y cuidaré de tu\nfalda, Rina.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0007j",head="rna_z2b",lv=5,id=4},
{"fgact",ch="里奈",act="びっくり",lv=5,id=4},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0006j",head="rna_z2b",lv=5,id=4},
{"fgact",ch="里奈",act="rlr",lv=5,id=4},
},
},
text={
vo={
{"vo",file="fem_rna_000388",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Cómo quieres que no me preocupe?! ¡Regrésamela!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Hikawa tomó de vuelta su falda de las manos de Kawachino y volvió a ponérsela.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Es un poco lamentable eso.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000768",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"cgact",stage="bg049",act="いいえ"},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0005",head="yum_z2a",lv=5,id=2},
{"fgact",ch="優美",act="うなづく",lv=5,id=2},
{"se",id=1,file="se2500"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gyah!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",lv=5,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000769",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué haces viendo tan fijamente? Voy a aplastarte los ojos.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué estás diciendo? ¡Fueron ustedes quienes entraron como nada mientras\nyo estudiaba y se pusieron a hacer eso!...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=210,lv=4,id=8},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001594",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ustedes dos, ¿qué vinieron a hacer acá? Puedo entender a Rin-chan, siendo\naspirante de ingreso también, ¿pero qué razón se les ocurrió a ustedes para\nvenir acá?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=210,lv=4,id=8},
{"fgact",ch="里奈",act="びっくり",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rna_000389",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No es que buscamos ninguna razón ni nada, solo que...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=680,lv=4,id=2},
{"fgact",ch="優美",act="うなづく",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_yum_000770",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Simplemente, nos desagradaba mostrarnos en traje de baño en el mismo lugar que\nThomas.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001595",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, pero al final del día tendrán que estar junto a Thomas.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=680,lv=4,id=2},
{"fgact",ch="優美",act="うなづく",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_yum_000771",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hay problema. Ya lo amarré a la malla metálica de la valla.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x2=-570,x=-210,lv=4,id=3},
{"fg",ch="稟",size="z1",mx=-40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-680,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001018",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que no hacía falta hacer tanto...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018",head="mak_z1d",x=-210,lv=4,id=3},
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=-210,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001596",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, es verdad, no sabemos que puede hacer en caso de despistarnos. Puede que\nincluso te quite tu traje de baño y te desnude, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-680,lv=4,id=1},
{"fgact",ch="稟",act="おじぎ",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-680,lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_rnd_001019",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay de qué preocuparse. Antes de que pueda hacer eso, lo recibiré con un\ndeashi-barai para luego provocarle una fractura conminuta sobre su brazo con\nun ude-hishigi-juji-gatame.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Con una sonrisa, Rin dijo algo bastante macabro.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001597",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm, ¿entonces vinieron a estudiar?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl02={
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000390",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Pueees... Pensé en lavar... ese plato.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001598",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está en remojo, así que no hace falta.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000391",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero ¿no crees que ya estuvo suficiente tiempo en remojo? Y además, si llevo\ntraje de baño no hay problema con que me moje lavando...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001599",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo... ahora que lo mencionas, tienes razón... ¿Entonces quieres decir que\nlavarás los platos en traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000392",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Pues, eso mismo significaría.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001600",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces no hay ningún problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000393",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, ¿fregamos entonces, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000772",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fumuh... La verdad es que no estoy muy motivada para hacerlo, pero bueno, si\naceptas llevar un delantal encima del traje de baño, entonces podría\nayudarte, Rina.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"quake",size=5,mode="mw"},
{"se",file="se2790",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Delantal encima de un traje de baño?!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001601",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Reaccionaste de forma muy honesta... Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Te equivocas. Es, eso. Ehm, ese tipo de sorpresa que te da cuando algo te\nparece raro.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000773",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tch, si Kusanagi se alegra por eso entonces supongo que habrá que impedirlo...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000394",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vamos, vamos, no digas eso y vayamos a lavar.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000774",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, no olvides el delantal entonces.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000395",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001602",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yuumi, por supuesto que tú también llevaras traje de baño y delantal, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000775",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, de ninguna forma, ni siquiera traje mi traje de baño conmigo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001603",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000776",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vine a ver a las chicas en trajes de baño, así que realmente no hay necesidad\nde que yo lleve ninguno, ¿no? Por eso vine sin traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000396",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad no lo trajiste?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000777",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De verdad no lo traje.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000397",ch="rna"},
},
ja={
{
name={"Rina"},
"“Deberías aprovechar la ocasión y entrar con todos nosotros. ¿Quieres que te\npreste uno de mis trajes de baño?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="du",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000778",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Un traje de baño tuyo, Rina? ¿Para mí?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000398",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera. Te lo prestaré. No creas que te lo daré.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000779",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo. Qué pena. Pensé que me lo darías, y terminé alegrándome en vano.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000399",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa sonrisa que mostraste por un instante... ¿era de alegría en vano?...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000780",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Fue una alegría en vano. Pues sería maravilloso recibir un traje de baño\ntuyo.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000400",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No sirve con que te lo preste?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000781",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si no te molesta que no me lo ponga, y además me dejas sola por eso de 1 hora,\nentonces me alegraría bastante. No me busques mientras tanto, aunque muy\nseguramente estaré en los baños.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000401",ch="rna"},
},
ja={
{
name={"Rina"},
"“Wah~, sinceramente, eso fue bastante desagradable~”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000782",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sí? Si eso te desagrada entonces no lo haré, Rina.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001604",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, espera, aunque solo lo expreses en palabras de igual forma desagrada, y\nbastante, a pesar de que no hagas lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000402",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no hay problema por eso. Yuumi siempre ha sido así desde hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000783",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Desde hace tiempo me robo la ropa interior de Rina y me encierro en los baños.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0006",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000403",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gya~, ¿estuviste haciendo esto~?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000784",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tranquila. Es solo una mentirita. Aunque no completamente pura.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000404",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué tanta verdad habrá dentro de esas mentiras impuras?...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000785",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Guárdate la verdad en tu corazón, Rina.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000405",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No se supone que debería ser en tu pecho?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001605",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios, dejen ya el show de Manzai. Están interrumpiendo la sesión de\nestudio.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000406",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, Rina Hikawa y--”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000786",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yuumi Kawachino quisieran--”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000407",ch="rna"},
{"vo",file="fem_yum_000787",ch="yum"},
},
ja={
{
name={"Rina&Yuumi"},
"“Comenzar a lavar los platos.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001606",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y... Rin-chan!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001020",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001607",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal como lo acabo de decir, todas en delantal y traje de baño, ¿bien?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001021",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero yo vine a estudiar...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001608",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya dos de tus kouhai irán en traje de baño y delantal, así que tú también\npodrías ir igual, ¿no, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001022",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De verdad no es necesario. Además, tampoco hay tantos delantales.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000408",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, es verdad. Solo hay un delantal.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000788",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡De ser así! ¡Ese delantal es para ti, Rina!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000409",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, ahora que lo pienso muy bien, ya estaríamos en traje de baño, así que no es\nnecesario el delantal.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
