astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_i08_02",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, todo fue un error.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_aid_001356",ch="aid"},
},
ja={
{
name={"Ai"},
"“Te entiendo... Perdóname, por haberte hecho pasar por tanto dolor...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hacerme pasar por tanto dolor?...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Pero qué dices?... Tú también...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bg",file="ev_com_i08_03",sync=0,face=1,time=400,path=":ev/ev_com_i08/",set="ev_com_i08"},
{"bgm",file="bgm033"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001357",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, tienes razón... Perdí a Kei.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_aid_001358",ch="aid"},
},
ja={
{
name={"Ai"},
"Es enorme la tristeza, sí...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_aid_001359",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero, también me duele bastante haberte hecho pasar por tanta tristeza a ti...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_aid_001360",ch="aid"},
},
ja={
{
name={"Ai"},
"Nuestra salvación vino, probablemente, a costa de muchas perdidas para ti...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_aid_001361",ch="aid"},
},
ja={
{
name={"Ai"},
"Por eso... quisiera, calmar tu tristeza...Si es por algo que yo pueda darte...\nHaré lo que sea...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"No seas tonta... Perder, dar...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"No se trata de eso...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9010",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-410,speed=1000,file="zbg004d",path=":bg/",y2=-580,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Intento ponerme de pie.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿--?!",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_aid_001362",ch="aid"},
},
ja={
{
name={"Ai"},
"¡Ah, cuidado!",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",y=-580,speed=500,time=0,file="zbg004d",path=":bg/",y2=-410,ax=1920,ay=1126,bx=-960,by=-586},
{"se",file="se_bafu",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Mis pies se desploman.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z2",my=-40,mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0008",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001363",ch="aid"},
},
ja={
{
name={"Ai"},
"Tan borracho te pusiste que perdiste el conocimiento hace un rato, ten cuidado.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"Uh, *ugh*...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0012",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001364",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Te sientes mal?",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Asiento.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_aid_001365",ch="aid"},
},
ja={
{
name={"Ai"},
"Aguanta un poco, te llevaré al baño.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Vomité como si no hubiera un mañana.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Jamás había bebido alcohol. No podía imaginarme lo que sucedería.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Al recuperar el conocimiento, me encontré con un techo desconocido ante mí.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esta es...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_aid_001366",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Despertaste? Qué bueno.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Tu habitación?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_i12_01",path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001367",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, te quedaste dormido en el baño después de vomitar.Te traje hasta acá.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo... Lo siento.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_aid_001368",ch="aid"},
},
ja={
{
name={"Ai"},
"No tienes por qué disculparte.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",file="se9010",vol=40,id=1},
{"bg",file="ev_com_i12_02",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
ja={
{
"Ai acaricia mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Usualmente me daría vergüenza, pero...el calor de su mano se me hacía ahora\nirresistible.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_aid_001369",ch="aid"},
},
ja={
{
name={"Ai"},
"Hoy sí te dejas acariciar, eh.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"......",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"No contesto.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_aid_001370",ch="aid"},
},
ja={
{
name={"Ai"},
"Jeje... me pone feliz hacer esto...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_aid_001371",ch="aid"},
},
ja={
{
name={"Ai"},
"Me recuerda a cuando eras un niño.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_aid_001372",ch="aid"},
},
ja={
{
name={"Ai"},
"Acariciaba tu cabecita así como ahora.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí... lo recuerdo...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_aid_001373",ch="aid"},
},
ja={
{
name={"Ai"},
"Y siempre que pasaba eso me abrazabas.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_aid_001374",ch="aid"},
},
ja={
{
name={"Ai"},
"Nadie lo creería viéndote ahora, pero de pequeño eras muy meloso.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"Inimaginable no lo es, la verdad...",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_aid_001375",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues entonces, déjate dar algo de cariño ahora...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"se",file="se9010",vol=60,id=1},
{"bg",file="ev_com_i12_03",path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
ja={
{
"Ai me abraza.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Su calor se extiende por mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Mis hombros tiemblan, y mis ojos se acaloran.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Sin poder aguantar más, abracé fuertemente a Ai, casi aferrándome a ella.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"A-Aiii...",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_aid_001376",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo... yo...",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"No debería decir que todo fue un error, y aun así...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"Perdóname, Ai... Perdóname, por decir semejante cosa...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo... realmente soy...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"Maldita sea... Qué débil soy. Qué tipejo tan débil soy...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"Decir que todo fue un error... Debería saber como se sentirían los demás de\nescuchar eso...",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"Debería, saberlo. Pero aun así...",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"Soy... soy, tan débil, y...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_aid_001377",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso no es cierto.Más bien has vivido con mucha fuerza hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_aid_001378",ch="aid"},
},
ja={
{
name={"Ai"},
"Todos llegaron a pensar que tenías un corazón de acero.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_aid_001379",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero fue por eso que pudieron dejarse salvar con tranquilidad...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_aid_001380",ch="aid"},
},
ja={
{
name={"Ai"},
"Porque siempre has sido fuerte...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_aid_001381",ch="aid"},
},
ja={
{
name={"Ai"},
"Fuerte, más que cualquiera...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_aid_001382",ch="aid"},
},
ja={
{
name={"Ai"},
"Jamás te has mostrado débil...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_aid_001383",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Pero sabes, Naoya? Nadie tiene por qué permanecer siempre fuerte.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_aid_001384",ch="aid"},
},
ja={
{
name={"Ai"},
"Esa fuerza tuya ha salvado a muchos, pero esa no es razón para no dejarte\nsalvar a ti mismo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_aid_001385",ch="aid"},
},
ja={
{
name={"Ai"},
"Puedes ser débil también.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_aid_001386",ch="aid"},
},
ja={
{
name={"Ai"},
"No tienes por qué mostrarte fuerte ante todos.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_aid_001387",ch="aid"},
},
ja={
{
name={"Ai"},
"Puedes ser débil, al menos con alguien... Naoya.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Alguien?... ¿Quién es ese alguien?...",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_aid_001388",ch="aid"},
},
ja={
{
name={"Ai"},
"Pues, eso lo decides tú.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_aid_001389",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero, desde hace un buen tiempo, desde el día en que naciste...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_aid_001390",ch="aid"},
},
ja={
{
name={"Ai"},
"Nunca has tenido que comportarte fuerte ante mí, ¿no, Naoya?",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh...",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Me aferro a Ai.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Ella reacciona acariciándome cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_aid_001391",ch="aid"},
},
ja={
{
name={"Ai"},
"Aquel día estaba muy feliz...Debí haber estado frustrada,pero realmente estaba\nfeliz...",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_aid_001392",ch="aid"},
},
ja={
{
name={"Ai"},
"A pesar de que eras el niño que me había arrebatado a las dos personas que\ntanto quería... Es extraño.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"Qué bueno que no me gané tu odio...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_aid_001393",ch="aid"},
},
ja={
{
name={"Ai"},
"Yo jamás te odiaría...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues... qué bueno saberlo...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya no está mamá... ni papá... y ahora Kei tampoco...",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"Todo aquel que ha caminado conmigo en el pasado se ha muerto...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Ai me abraza con más fuerza.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_i12_04",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001394",ch="aid"},
},
ja={
{
name={"Ai"},
"Yo no moriré. Estaré siempre contigo.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_aid_001395",ch="aid"},
},
ja={
{
name={"Ai"},
"Y te protegeré siempre que te sientas débil.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ajaja... Realmente eres como una hermana mayor.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_aid_001396",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, así es.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero, ningún hombre le lloraría a su hermana teniendo esta edad.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_aid_001397",ch="aid"},
},
ja={
{
name={"Ai"},
"Eso no es cierto... Tienes derecho a llorar cuando te sientas triste.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_aid_001398",ch="aid"},
},
ja={
{
name={"Ai"},
"Además, no tengo que ser tu hermana...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_aid_001399",ch="aid"},
},
ja={
{
name={"Ai"},
"Si así lo deseas, me convertiré en tu madre... o en tu mujer, si así lo\nquieres.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Madre? Vamos, eso es imposible...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_aid_001400",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Te parece? Bueno, ciertamente Mizuna nee-sama era una mujer excepcional...\nQuizá se notaría mucho la diferencia si tomo su lugar.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y... no digas tampoco eso... de volverte mi mujer...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_aid_001401",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Por qué no? ¿Te da asco la idea?",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"Al contrario... Harás que te vea solo de esa forma...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_aid_001402",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Podrías verme de esa forma?",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y-Ya llevo tiempo diciéndotelo...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_aid_001403",ch="aid"},
},
ja={
{
name={"Ai"},
"La tristeza... nos hace buscar el calor de otro... Probablemente, esto sea lo\nmismo.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_aid_001404",ch="aid"},
},
ja={
{
name={"Ai"},
"Y no soy la excepción. Estando contigo de esta manera, me tranquilizo...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_aid_001405",ch="aid"},
},
ja={
{
name={"Ai"},
"El calor que recibo abrazándote, me sana...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero, no es exactamente lo mismo esto a verte como mujer...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_001406",ch="aid"},
},
ja={
{
name={"Ai"},
"Es lo mismo... Rozar piel con piel implica eso...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_aid_001407",ch="aid"},
},
ja={
{
name={"Ai"},
"Los humanos son mamíferos, siempre buscan el calor del otro.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_aid_001408",ch="aid"},
},
ja={
{
name={"Ai"},
"Si un perrito y un gatito temblando de frío se encontraran, es seguro que se\nacurrucarán el uno con el otro...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_aid_001409",ch="aid"},
},
ja={
{
name={"Ai"},
"Es normal para un mamífero buscar calor en medio del frío.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_aid_001410",ch="aid"},
},
ja={
{
name={"Ai"},
"Y aunque eso pase a convertirse en lujuria y el deseo de contacto más íntimo...\nSu origen seguirá siendo el mismo, creo yo.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_aid_001411",ch="aid"},
},
ja={
{
name={"Ai"},
"La soledad de las personas es, probablemente, lo que causa eso...",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_aid_001412",ch="aid"},
},
ja={
{
name={"Ai"},
"Nacemos solos, y morimos solos.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_001413",ch="aid"},
},
ja={
{
name={"Ai"},
"No es extraño pensar que quizá simplemente queremos evitar esa soledad, al\nmenos entre esos dos procesos.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_001414",ch="aid"},
},
ja={
{
name={"Ai"},
"Quizá, eso es lo que significa amar... pienso yo.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_aid_001415",ch="aid"},
},
ja={
{
name={"Ai"},
"Los humanos no pueden aguantar el frío solos, y por eso aman.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_aid_001416",ch="aid"},
},
ja={
{
name={"Ai"},
"Si pudiéramos resistirlo, tal vez no necesitaríamos amor.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Es así de pasivo el amor?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_aid_001417",ch="aid"},
},
ja={
{
name={"Ai"},
"Ni idea, la verdad es que no lo sé.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_aid_001418",ch="aid"},
},
ja={
{
name={"Ai"},
"No tengo casi experiencia con él...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_aid_001419",ch="aid"},
},
ja={
{
name={"Ai"},
"No he experimentado tanto el amor como para poder hablar de él.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_aid_001420",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Qué piensas tú del amor, Naoya?",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo qué sé. Es enamorarse, y querer pasar el resto de tu vida con alguien... Es\nlo único que sé.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_aid_001421",ch="aid"},
},
ja={
{
name={"Ai"},
"Muy de ti...",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_aid_001422",ch="aid"},
},
ja={
{
name={"Ai"},
"Una descripción propia de ti, me gusta...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Hundo mi cara en el pecho de Ai.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"Eso quiere decir que puedo verte como mujer, ¿no?",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_001423",ch="aid"},
},
ja={
{
name={"Ai"},
"Claro.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"Me lo tomaré en serio, te lo advierto.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_001424",ch="aid"},
},
ja={
{
name={"Ai"},
"Está bien.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Y-Yo lo diré primero! ¡¿Bien?!",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_i12_03",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001425",ch="aid"},
},
ja={
{
name={"Ai"},
"No te lo puedo permitir.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_aid_001426",ch="aid"},
},
ja={
{
name={"Ai"},
"No quiero que vengas con un 'para siempre' ni nada por el estilo.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Pero qué dices?... ¿Es porque somos alumno y maestra?",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_aid_001427",ch="aid"},
},
ja={
{
name={"Ai"},
"No es eso. Si realmente me amas, yo también te amaré con fuerza.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_aid_001428",ch="aid"},
},
ja={
{
name={"Ai"},
"Estaré siempre a tu lado. Si realmente me necesitas, eso sí.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Por eso es que yo--",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_aid_001429",ch="aid"},
},
ja={
{
name={"Ai"},
"Tu mismo lo dijiste, eso no fue más que un lavado de cerebro por parte de la\nabuela, ¿no? Lo de estar juntos por la eternidad y eso...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ugh...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_aid_001430",ch="aid"},
},
ja={
{
name={"Ai"},
"No hacen falta palabras.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_aid_001431",ch="aid"},
},
ja={
{
name={"Ai"},
"Si me deseas, haré lo que sea.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_aid_001432",ch="aid"},
},
ja={
{
name={"Ai"},
"Si estar juntos como maestra y alumno no está bien, dejaré mi trabajo como\nprofesora.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pero, ser profesora ha sido tu sueño desde pequeña, y ahora que finalmente...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_001433",ch="aid"},
},
ja={
{
name={"Ai"},
"Así es, mi sueño siempre ha sido ser profesora.Pero, tú eres más importante que\nese sueño.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_aid_001434",ch="aid"},
},
ja={
{
name={"Ai"},
"No debemos temer perder para ganar algo.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_aid_001435",ch="aid"},
},
ja={
{
name={"Ai"},
"Si es por corresponder tu amor, me desprenderé de todo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Eso es...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_aid_001436",ch="aid"},
},
ja={
{
name={"Ai"},
"Fufufu, pero qué cara estás haciendo ahora.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_aid_001437",ch="aid"},
},
ja={
{
name={"Ai"},
"Estás acostumbrado a perder para salvar a los demás, pero no a que los otros\npierdan algo por ti.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Es que...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_aid_001438",ch="aid"},
},
ja={
{
name={"Ai"},
"Además, no estoy intentando salvarte ni nada por el estilo. Si me amas, yo\ntambién te daré mi amor. Nada más ni nada menos.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_aid_001439",ch="aid"},
},
ja={
{
name={"Ai"},
"No es la gran cosa, perder algo para mantener lo más importante para uno.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ai...",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_001440",ch="aid"},
},
ja={
{
name={"Ai"},
"¿O es que prefieres no seguir con esto?",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"......",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_i12_04",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001441",ch="aid"},
},
ja={
{
name={"Ai"},
"Solo bromeaba, tranquilo.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_aid_001442",ch="aid"},
},
ja={
{
name={"Ai"},
"Lo que quise decir es que si así lo quieres, dejaré mi trabajo como\nprofesora.De lo contrario, seguiré.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_aid_001443",ch="aid"},
},
ja={
{
name={"Ai"},
"No te preocupes.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_aid_001444",ch="aid"},
},
ja={
{
name={"Ai"},
"No hay razón para sentir miedo.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_aid_001445",ch="aid"},
},
ja={
{
name={"Ai"},
"No hay razón para temblar.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_aid_001446",ch="aid"},
},
ja={
{
name={"Ai"},
"Solo apóyate en mí.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_aid_001447",ch="aid"},
},
ja={
{
name={"Ai"},
"Haré todo lo que sea necesario por ti...",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ai...",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_aid_001448",ch="aid"},
},
ja={
{
name={"Ai"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_i12_05",path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
ja={
{
"Nos dimos un breve beso.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_i12_04",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001449",ch="aid"},
},
ja={
{
name={"Ai"},
"... Jaaa.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"Nos... besamos.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_aid_001450",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, y fue mi primera vez.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues yo también.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_aid_001451",ch="aid"},
},
ja={
{
name={"Ai"},
"Entonces, otro más...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_i12_05",path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001452",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngh...",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Nuestros labios vuelven a tocarse...El calor invade mi boca.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_aid_001453",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngh... fuh... mm, ngh... *chu*...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"A diferencia del primer beso, esta vez pude sentirlo todo. La textura, el\ncalor, la respiración de Ai y sus ligeros gemidos.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_aid_001454",ch="aid"},
},
ja={
{
name={"Ai"},
"Mm... fuh...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Ai.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_i12_04",sync=0,face=1,time=400,path=":ev/ev_com_i12/",set="ev_com_i12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001455",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Mm? ¿Qué quieres que haga?",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ehm...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Te quiero más cerca'.Creo que eso quería decir.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_aid_001456",ch="aid"},
},
ja={
{
name={"Ai"},
"¡Ah, claro! Me meteré yo también en el futon.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=1000},
{"se",file="se0897s",id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Antes de poder decir algo, Ai se había metido junto a mí en el futon.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"excall",file="05_the_happy_prince_08b_2"},
{"text"},
linkback="block_00179",
},
label = {
top={block="block_00000",label=1},
},
}
