astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="eveningsky_winter",id=1,lv=1,time=2000,sync=1,path=":cg/"},
{"ex",time=600,func="wait"},
{"bg",file="nightsky_spring",id=2,lv=2,time=2000,sync=1,path=":cg/"},
{"ex",time=600,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000705",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ya está lista la comida!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Se escucha la voz de Rin venir de la cocina de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Rin vino a la casa de los Natsume a ayudarme a mí y a Kei a estudiar.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Hasta el día de hoy siempre estuvo nada más ayudando con la cocina, pero hoy\nRin se ha encargado de prepararlo todo. Simplemente, lo único que puedo decir\nes que me ha sido de muchísima ayuda.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja que te ayude a servir.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000706",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, yo lo haré todo.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000550",ch="aid"},
},
ja={
{
name={"Ai"},
"“No puedo permitir eso. En primer lugar, ya es extraño que un invitado venga y\nnos prepare toda la comida.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
},
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000707",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay problema. Después de todo, al regresar a casa siempre tengo que cocinar\npara mí. Más bien me siento yo alegre de poder estar con todos.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000551",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ahora que lo recuerdo, Misakura, vivías sola, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000708",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, por eso es que me pone feliz poder estar aquí con todos.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000552",ch="aid"},
},
ja={
{
name={"Ai"},
"“Misakura, si no te molesta, podrías venir a comer cuando quieras con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0100",face="d0003",head="rin_z1d",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0100",face="d0004",head="rin_z1d",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000709",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Profesora, de decirme eso probablemente termine aferrándome a esas palabras y\nmolestándola.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000553",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Molestarnos? Para nada, si incluso vienes a cocinar para todos.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000710",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, pero no es la gran cosa. Es incluso posible que terminen decepcionándose\nal probar mi comida.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso no hay de qué preocuparse. No hay forma de que salga algún mal\nplatillo de ese movimiento de manos tuyo tan hábil.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000711",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues... eso, espero...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_spring",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000950",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¡BUENÍSIMOOOO!!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000712",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El sabor no es tan bueno como para gritar así.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000554",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para nada, para nada, esto es increíble, Misakura... Ya esto supera el nivel de\nsimplemente delicioso.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000713",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente no es para tanto, pero muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000272",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000714",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué pasa, Shizuku-chan?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0019",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000273",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*poroporo*...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0019",head="shz_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000715",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿P-Por qué? ¿Por qué lloras? ¿No te gustó? ¿Sabe mal? ¿Había algo picante\nadentro?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tranquila, es una costumbre suya.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000716",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Costumbre?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando Shizuku come algo delicioso, se le salen las lágrimas.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000717",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿L-Las lágrimas?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, ya cuando se acostumbra simplemente se le humedecen los ojos, pero\ncuando es una persona distinta quien cocina, se le salen las lágrimas como\nahora.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0009",head="shz_z1a",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000274",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. La comida de Naoya y Rin es especial.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Eso es porque probablemente también está en juego el 'corazón'.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Para esta muchacha, es posible que llevarse algo a la boca tenga otro\nsignificado aparte de simplemente comer...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000275",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Las lágrimas que derramé al comer por primera vez la comida que preparaban las\notras personas en esta casa tenían un significado totalmente distinto...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0009",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0008",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000951",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, me lo imagino... Yo también lloraba todos los días.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000555",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué quieres decir con eso, Kei?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000952",ch="ked"},
},
ja={
{
name={"Kei"},
"“No es nadaaa~”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¿Un significado distinto?",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Ahora que recuerdo, Ai había dicho que ella prepararía la comida en la fiesta\nde bienvenida, pero... aunque, el arroz frito que comí hace poco estaba\nbueno...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000276",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, eres increíble.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000718",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es cierto. Aunque, estoy feliz de que estés contenta, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente está todo muy bueno. Pensaba secretamente que yo era bueno cocinando,\npero comparado contigo, me doy cuenta que mis platillos no son la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000719",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí lo es, de verdad que hace la diferencia tener a alguien que te enseñe.\nTienes que agradecerle a tu abuela del campo.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000720",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿no se sentirá triste tu abuela de que la nieta que estuvo tanto\ntiempo a su lado se viniera acá?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000721",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Respecto a eso, fue mi abuela quien arregló todo para que yo viviera acá.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000722",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi papá se opuso a la idea. Por eso es que aún no nos llevamos muy bien, y\nvivimos separados.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000723",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero mi abuela dijo, '¡Si tienes algo pesando en tu corazón aún, entonces ve y\narréglalo todo tú misma!'”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000724",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dijo que, aún independientemente de cómo resultara todo, era mucho mejor a no\nhacer nada y llevar ese peso por toda la vida.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000725",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Que... debía aceptar de verdad mi pasado...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0011",head="kei_z1a",x=-345,lv=4,id=5},
},
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000953",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Pesos en el corazón? Eso de arreglar y todo lo demás... ¿Es que sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000726",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es realmente la gran cosa, pero... cómo podría ponerlo...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="lr",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000556",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei, esa clase de cosas no se preguntan tan a la ligera.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0009",head="kei_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0010",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000954",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Entiendo... Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, gracias a esa abuela es que ahora podemos comer todas estas cosas tan\nsabrosas, así que todo bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_szd_000277",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y de esa forma, todo en buenos términos.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000955",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí... Supongo... que sí.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Por un instante, la expresión de Kei se ensombreció. O, justo cuando pensé\neso...",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000956",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ahh, hoy también estuvo bien divertido el colegio! ¡¿Verdad, Naoya?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué y cómo fue tan divertido?...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="ジャンプ",time=500,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000957",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahh, realmente me parecí a Lupiiin.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué... rayos... quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000557",ch="aid"},
},
ja={
{
name={"Ai"},
"“Parece que la persecución de hoy estuvo terrible...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Huíste?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0016",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000958",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pero entré a clases normalmente cuando Naoya llegó.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0018",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000558",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por Dios, me voy a resolver un trabajo que no podía quitarme de encima, le\nencargo a otro profesor sus clases suplementarias, y me vino con eso. No\nsabes todo lo que tuve que disculparme después...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000959",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajaja, es culpa del profesor por ser tan lento y torpe.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",x=345,lv=4,id=6},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",x2=345,x=295,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0021",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="いいえ",loop=-1,size=2,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",x=295,lv=4,id=6},
},
vl03={
{"fgact",ch="藍",act="du",lv=4,id=6},
},
vl04={
{"fgact",ch="圭",act="停止",lv=4,id=5},
},
vl02={
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0021",head="kei_z1a",x2=-345,x=-365,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0023",head="kei_z1a",x=-365,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000960_n",vol=50,ch="ked"},
{"vo",file="fem_aid_000559",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Esta boca? ¿Es esta boca la que está diciendo eso? No necesito una boca que\ndiga esa clase de cosas. ¡No y no la necesito!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000727",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te saltaste las clases? Kei-kun, no vas a poder graduarte.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0013",head="kei_z1a",x=-365,lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000961",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero a mitad del día entré de forma normal a mis clases.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="圭",mode=-1,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=295,lv=4,id=6},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x2=295,x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000560",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es cuestión de que entres a mitad de día. Y además, Kusanagi, tú también\nestuviste muy absorto durante las clases, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh, no tengo excusa alguna...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000561",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por Dios, ustedes dos, si no se ponen serios realmente no podrán graduarse. Y\nnuestro colegio es más severo de lo que creen.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así luce, eh. Parece que Akashi también repitió el año.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0012",head="aix_z1f",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000562",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Akashi? Ah, él no repitió el año.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Pero no se ha graduado aún, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000563",ch="aid"},
},
ja={
{
name={"Ai"},
"“No conozco muy bien los detalles, pero parece que está en ausencia justificada\npor un tiempo, así que al consumir todas las lecciones de ese período y\nterminar con los exámenes, podrá graduarse, según.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ausencia justificada? ¿Estuvo haciendo eso? Pero parece haber estado viniendo\ntodo este tiempo al colegio...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000564",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fumuh, no sé mucho al respecto. No soy su profesora encargada, así que...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"¿Akashi estaba en ausencia justificada?",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Es la primera vez que escucho eso...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"¿Hay alguna razón por la cual tenga que ausentarse de clases?",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000565",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué sucede? ¿Pensando de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, lo siento. No es gran cosa...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0005",head="shz_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000278",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, últimamente has estado bastante pensativo... Me recuerda a aquella vez...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A aquella vez?... Tú...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000279",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No medí mis palabras...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0002",head="shz_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0017",head="shz_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000280",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque meter tus narices en todo tipo de cosas es también uno de tus buenos\npuntos. Pero...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"¿Es que no vas a decir más nada después de ese 'Pero'? Shizuku se me queda\nviendo.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000282",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Akashi-san está tramando algo de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000728",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_ked_000962",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_000566",ch="aid"},
},
ja={
{
name={"Ai"},
"“Shizuku, ¿conoces a Akashi? Aun cuando son de colegios distintos.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011",head="shz_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000283",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“'Shizuku' no conoce a Akashi-san.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001",head="shz_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000284",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo que surgió el nombre de una persona llamada Akashi-san, y Naoya se puso\npensativo, así que de cierta forma deduje que se trataba de eso...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000963",ch="ked"},
},
ja={
{
name={"Kei"},
"“Se me paró el corazón por un momento. Pensé, ¿por qué Shizuku conoce a\nAkashi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000729",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que ambos se conocían.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Ya ha escuchado varias veces el nombre de Akashi, así que 'Shizuku'\nsimplemente repitió ese nombre, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fgact",ch="圭",act="du",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000964",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo. Pero, solo pensaba, tratándose de Akashi-senpai no sería nada raro que\nsu nombre y mala reputación también se hiciera eco por el colegio San Ruan.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000285",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dejando a un lado a Akashi-san... Naoya.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000286",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tienes un pétalo de cerezo sobre tu hombro.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Al posar mi mano sobre mi hombro, un pétalo de cerezo se adhirió de verdad a\nella.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000965",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es verdad. ¿Pero qué rayos es esto?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000567",ch="aid"},
},
ja={
{
name={"Ai"},
"“De verdad que estas cosas pueden pasar. ¿Por qué un pétalo de cerezo?...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está seco...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000568",ch="aid"},
},
ja={
{
name={"Ai"},
"“Obviamente que lo está, ya estamos en verano, seguramente se te pegó algún\npétalo de cerezo que quedaba por allí.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Que quedaba por allí...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0001",head="shz_z1b",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Shizuku observa de reojo a Rin.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000288",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cerezos milenarios?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0012",head="shz_z1b",x2=0,x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000966",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué? ¿Qué pasa? ¿Por qué mencionas a los cerezos milenarios? ¿Es que acaso eso\nes un pétalo de cerezo milenario?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente que no... Sea cual sea el ángulo por el cual lo veas, es simplemente\nun pétalo seco. Es como dice Ai, seguramente es un pétalo de flor que quedaba\npor allí.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Aunque no sé en qué momento se me pegó...",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0004",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うんうん",time=367,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000289",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*musha*, *musha*...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Shizuku comenzó, así como lo hace siempre, a comer sin prestarle mayor atención\na los demás.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cerezos... eh...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"En ese momento, algo totalmente distinto se cruzó por mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Me dio la sensación de que aquello en lo que estuve todo este tiempo pensando\ncomenzó, por fin, a encajar.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Un pálido color rosado...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Un tenue color escarlata...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Awabenifuji... Y además, hisuiiro...",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Toritani había dicho antes que se trataban de tonos desteñidos, pero... ¿Es\nrealmente así?",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
