astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="びっくり",lv=4,id=9},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000114",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿T-Tan tarde ya?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_kid_000258",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“S-Sí. Me he pasado de la hora de costumbre, ya que lo mencionas.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_kid_000259",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque sí, también es porque Ai no está hoy...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Al parecer Ai fue a ver a su familia por el día.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Parece que el problema de su patria potestad no se ha resuelto aún, y por eso\nuna que otra vez va a visitar a sus padres.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bgm",stop=1,time=2000},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000115",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡¿Pero qué estoy haciendo?! ¡Profesor, váyase ya!”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_kid_000260",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Que me vaya ya? No es que me pueda irme así como sí y ya...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000116",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Simplemente váyase ya, por favor.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"El largo período de paz hizo que incluso Mizuna olvidara la realidad.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Así tan serenos y llenos de paz fueron esos días.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Pero esa frágil paz llegaría pronto a su fin.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
"Sin sonido alguno del timbre, se escuchó la puerta de la entrada abriéndose.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000117",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"El rostro de Mizuna se palideció.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_kid_000261",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",id=1,file="se0791_s"},
{"text"},
text={
ja={
{
"Se escuchan pasos viniendo del pasillo.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"No uno. Son dos... no, tres.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"El primer hombre entró de inmediato a la sala de estar.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="man_syi_000138",ch="syi"},
},
ja={
{
name={"???"},
"“¿Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"El hombre preguntó con voz molesta.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000262",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“S-Soy profesor del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000139",ch="syi"},
},
ja={
{
name={"???"},
"“¿Yumihari? Así que eres uno de mis empleados. ¿Y bien? ¿Qué hace un empleado\nacá?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000263",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Empleado?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000140",ch="syi"},
},
ja={
{
name={"???"},
"“Por supuesto. Trabajas en el colegio Yumihari, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000264",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vine porque me sentí preocupado por las muchachas que viven en esta casa.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000141",ch="syi"},
},
ja={
{
name={"???"},
"“Preocupado, eh...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000142",ch="syi"},
},
ja={
{
name={"???"},
"“¡Pues nadie necesita de tu preocupación, vete ya! Te largas ya de esta casa.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_kid_000265",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“P-Pero, señor...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"quake",mode="mw"},
{"fg",mode=-2},
{"se",file="se3130",vol=50,id=1},
{"fg",ch="黒服",size="z2",mx=40,mode=3,resize=1,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kfa_000011",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡Vete te han dicho, lagartija! ¡Si no quieres pasar un mal rato, haz lo que te\ndicen y lárgate ya!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Un hombre vestido en un traje negro con todo el porte de guardaespaldas se paró\nfrente a mí.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_kid_000266",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y a ti qué te pasa, imbécil? Estoy en medio de una conversación.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_kfa_000012",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Estás sordo? ¡Si no quieres pasarla mal vete ya!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",mode=-2},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007",head="miz_z1a",lv=4,id=9},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000118",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Profesor! ¡Váyase ya, por favor!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_kid_000267",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000119",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡¿Me lo prometió, recuerda?! ¡Que si llegara a verse en peligro huiría!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_kid_000268",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y ciertamente dije que huiría de verme en peligro...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000120",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Pues entonces...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"fg",ch="黒服",size="z2",mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",lv=5,id=9},
{"fg",mode=-2},
{"bg",zoom=130,speed=200,sync=0,file="zbg004c",path=":bg/",x2=-1330,y2=250,x=-1530,y=250,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="黒服",size="z2",speed=200,sync=0,mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",x2=200,x=0,lv=5,id=9},
{"quake"},
{"text"},
text={
ja={
{
"Me puse de cara contra el hombre de traje negro.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_kid_000269",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Hacerme pasar un mal rato tú? ¡Vamos, inténtalo, maldita sea!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"msgoff"},
{"se",file="se3130",id=1},
{"quake"},
{"fg",ch="黒服",size="z2",zoom=150,speed=200,sync=1,mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",y2=0,z2=100,x=0,y=270,lv=5,id=9},
{"bg",time=50,sync=0,file="black",path=":bg/"},
{"ex",time=100,func="wait"},
{"se",id=2,file="se3462"},
{"bg",file="battle_007",rule="106l",id=9,lv=9,time=100,path=":cg/battle/",set="battle"},
{"quake"},
{"ex",time=200,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"bg",zoom=130,x=-1530,y=270,speed=300,file="zbg004c",path=":bg/",z2=150,x2=-1780,y2=580,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="黒服",size="z2",zoom=100,speed=300,mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",y2=270,z2=150,y=0,lv=5,id=9,sync=0},
{"extrans",time=100},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kid_000270",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Gweh...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"se",file="se3130",id=1},
{"bg",zoom=130,y=-580,speed=300,file="zbg004c",path=":bg/",y2=270,ax=1920,ay=1126,bx=-960,by=-586,sync=0,x=-1530},
{"fg",ch="黒服",size="z2",zoom=100,speed=300,mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",y2=0,y=-1200,lv=5,id=9,sync=0},
{"quake"},
{"extrans",time=0},
{"text"},
text={
ja={
{
"El hombre de negro no duró ni un segundo apenas terminé de hablar para propinar\nun fuerte golpe sobre mi estómago. No pude aguantar el dolor y caí de\nrodillas al suelo.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000121",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Profesor Kusanagi! ¡No puedo creerlo! ¡¿Cómo puedes golpear a alguien sin\naviso alguno?!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服",size="z1",mode=3,resize=1,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",lv=4,id=9,sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="man_kfa_000013",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Bien se lo advertí. Te doy tres segundos. Si no sales para cuando termine de\ncontar, haré que no puedas mostrar esa cara afuera por un buen tiempo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kid_000271",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Tres, segundos?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_kfa_000014",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Uuuno.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000122",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Profesor, huya ya!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"El hombre de negro comienza a contar lentamente.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Pero me moví antes de que llegara al dos.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bgm",file="bgm015"},
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",zoom=240,y=-730,speed=300,file="zbg004c",path=":bg/",z2=100,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="黒服",size="z1",zoom=200,speed=200,mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",y2=0,z2=100,y=-780,lv=4,id=9,sync=0},
{"quake"},
{"extrans",time=0},
{"ex",time=0,func="wait"},
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=200,func="wait"},
{"se",file="se_attack06",id=2},
{"bg",file="閃光小",id=9,lv=9,rule=105,time=100,path=":cg/battle/",set="battle"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kfa_000015",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡¿Nuh?! ¡Uogh!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Todavía golpeado y tumbado sobre el suelo, tumbé al hombre por las piernas.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Sus piernas eran gruesas y robustas.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Probablemente practica algún arte marcial.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Tenía el típico cuerpo de un guardaespaldas.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Pero, por más entrenamiento que pueda tener una persona, tumbarla en medio de\nun descuido no es nada difícil.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Es bastante común en peleas callejeras aprovechar de tumbar al oponente cuando\neste está distraído por la sensación de victoria.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"cgdel",id=-1},
{"bg",time=100,file="black",path=":bg/"},
{"ex",time=100,func="wait"},
{"se",file="se_attack08",id=1},
{"bg",file="battle_004",id=9,lv=9,rule="106l",time=100,path=":cg/battle/",set="battle"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kfa_000016",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¡Gwah!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="黒服",my=40,mode=-1,lv=4,id=9},
{"se",id=1,file="se3356"},
{"text"},
text={
ja={
{
"El hombre cayó boca arriba sobre el suelo, sin poder controlar su caída.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bg",time=100,rule="216r",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Podrá haber caído sobre tatami, pero debe haberse golpeado fuertemente la\ncabeza y tardará unos segundos en levantarse. Aprovecho la oportunidad y me\nmonto sobre él.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Sin perder tiempo alguno, logré montarme encima de él. En una pelea callejera,\nesto es ya señal de victoria.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000272",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡A ver quién regresa con la cara hinchada a casa, ¿eh?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Montado sobre el hombre, lancé un puñetazo contra su cara.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Y justo antes de impactar.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",rule=215,time=100,file="white",path=":bg/"},
{"se",id=1,file="se_punch2"},
{"se",file="se_attack10",id=2},
{"bg",zoom=200,x=-2800,y=-1100,speed=300,file="zbg004c",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=0},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000273",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Gwah!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Algo me patea de un lado.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Salí disparado contra la pared.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000274",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“G-Gwooh...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"fg",ch="黒服Ｂ",size="z1",mode=3,resize=1,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kfb_000001",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¿Qué demonios haces, idiota?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"se",file="se9010",id=1},
{"fg",ch="黒服Ｂ",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="黒服",size="z1",my=40,mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfa_000017",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“M-Me descuidé...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fgact",ch="黒服Ｂ",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kfb_000002",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¿Te descuidaste? ¿Pero qué clase de guardaespaldas se deja montar encima por un\nnovato?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fgact",ch="黒服",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfa_000018",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"bg",blur=10,file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服Ｂ",size="z1",blur=5,mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="黒服",size="z1",blur=5,mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服Ｂ",size="z1",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",blur=10,file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服Ｂ",size="z1",blur=5,mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="黒服",size="z1",blur=5,mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_kid_000275",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Guh... guh...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"¿Acaso me golpeé la cabeza contra la pared?",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Mi visión está borrosa.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Qué patada tan fuerte...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Conque esta es la fuerza de un profesional...",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Me paro cojeando.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="黒服Ｂ",size="z1",mode=3,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000276",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Analizo nuevamente la situación.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Al parecer había más de un guardaespaldas.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Si bien escuché los pasos de tres personas, solo llegué a ver a dos...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Por eso creí que solo estaban el viejo y el guardaespaldas que tengo\nenfrente...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Pero había otro.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Y estaba ocultándose, deliberadamente...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"¿Sabía que yo intentaría contraatacar? ¿Estaba inspeccionando la situación?",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Si es así... va a ser realmente difícil subyugarlo.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_kfb_000003",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“Señor Nakamura, ¿qué hacemos con él?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_syi_000143",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Déjenlo moribundo, pero tampoco lo maten.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",file="se3130",id=1},
{"fg",mode=-2},
{"cgact",stage="bg004",act="いいえ"},
{"fg",ch="黒服Ｂ",size="z2",my=40,mode=3,resize=1,path=":fg/bcb/z2/",file="bcb_z2a0000",face="a0001",head="bcb_z2a",x=-500,lv=5,id=5},
{"fg",ch="黒服",size="z2",my=40,mode=3,resize=1,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfb_000004",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_kid_000277",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡¿Creen que me voy a dejar solo porque trajeron a uno más?!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"cgact",stage="bg004",act="いいえ"},
{"fg",ch="黒服Ｂ",size="z2",zoom=150,speed=200,mode=3,path=":fg/bcb/z2/",file="bcb_z2a0000",face="a0001",head="bcb_z2a",y2=0,z2=100,x=-500,y=270,lv=5,id=5},
{"fg",ch="黒服",size="z2",zoom=150,speed=200,mode=3,path=":fg/bca/z2/",file="bca_z2a0000",face="a0001",head="bca_z2a",y2=0,z2=100,x=500,y=270,lv=5,id=6},
{"fgact",ch="黒服Ｂ",act="うんうん",lv=5,id=5},
{"fgact",ch="黒服",act="うんうん",lv=5,id=6},
{"se",id=1,file="se3462"},
{"quake"},
{"flash",time=500,alpha=50,loop=1,color="ff0000"},
{"se",id=2,file="se_blood2"},
{"bg",sync=0,time=250,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000273",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Gwah!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"se",id=1,file="bokoboko"},
{"text"},
text={
ja={
{
"La diferencia era absoluta.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Es poco lo que un novato podría hacer contra un guardaespaldas, después de\ntodo. Y más aún tratándose de dos.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"se",id=1,file="bokoboko"},
{"text"},
text={
ja={
{
"Prácticamente me convertí en un saco de arena.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"se",id=2,file="bokoboko"},
{"bg",file="ev_uni_c58_02",sync=0,face=1,time=400,path=":ev/ev_uni_c58/",set="ev_uni_c58"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kid_000278",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Uwooooh! ¡Gwah!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"A pesar de eso, logré de una u otra forma estirar mis puños contra ellos.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Si bien pude acertar unos cuantos puñetazos, no fue suficiente para dominarlos.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000123",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡No más! ¡Profesor! ¡Por favor, deténganse!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Escucho la voz de Mizuna.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"se",id=1,file="se3462"},
{"bg",file="ev_uni_c58_01",sync=0,face=1,time=400,path=":ev/ev_uni_c58/",set="ev_uni_c58"},
{"quake"},
{"text"},
text={
ja={
{
"Mi visión se tornó roja.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Probablemente mis párpados, hinchados, se rompieron.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Parece que me entró sangre a los ojos.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"se",id=1,file="bokoboko"},
{"quake"},
{"text"},
text={
ja={
{
"¿Qué tan golpeado estaré?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"No sentía mucho dolor, solo la calidez de la sangre.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_kid_000279",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mierdaaa...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",id=1,file="se3462"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kid_000280",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Agh...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"se",id=1,file="se3356"},
{"quake"},
{"text"},
text={
ja={
{
"Sentí que mi cuerpo no se movía. Pero justo entonces, por alguna razón estaba\nviendo el techo.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"¿Caí tumbado sobre el suelo?",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"De inmediato me cubrí la cara.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",id=1,file="bokoboko"},
{"quake"},
{"text"},
text={
ja={
{
"No tuvieron piedad alguna. Tal como lo imaginaba, no esperaron para reventarme\na golpes mientras estaba tumbado.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Tienen toda la intención de dejarme medio muerto.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bgm",stop=1,time=10000},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="bokoboko"},
{"quake"},
{"text"},
text={
ja={
{
"Siento que voy perdiendo el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"A pesar de que siguen golpeándome, todo va tornándose cada vez más silencioso.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Y cada vez más voy hundiéndome en ese silencio...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Hasta que...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bgm",stop=1,time=500},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000124",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡No más, por favor!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Escucho la voz de Mizuna cerca de mis oídos y recobro el conocimiento.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",blur=10,file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="水菜",size="z2",blur=3,mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0200",face="a0021",head="miz_z2a",lv=5,id=9,sync=0},
{"extrans",rule="008b",time=800},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0021",head="miz_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="man_kid_000281",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿M-Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000125",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Estúpido profesor! ¡Me prometió que huiría!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kfa_000019",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"*Tch*",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Al parecer Mizuna se puso sobre mí.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Probablemente intentó protegerme de los golpes.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kfb_000005",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¡Hmph!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"flash",time=500},
{"se",id=1,file="se3462"},
{"quake"},
{"ex",time=100,func="wait"},
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"ex",time=0,func="wait"},
{"fgact",ch="水菜",act="びっくり",size=25,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000126",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"El hombre en negro no dudó en patearla a un lado.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_kid_000282",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“B-Basta... no le pongan las manos encima a ella...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000144",ch="syi"},
},
ja={
{
name={"???"},
"“Y qué derecho tienes tú para pedir eso, ¿eh? Soy yo quien tiene la tutela de\nesta muchacha.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_kid_000283",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué dices?...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000145",ch="syi"},
},
ja={
{
name={"???"},
"“Se supone que Ai iría hoy a ver a su familia, así que después de tanto tiempo\nse me ocurrió venir a verla a ella. Y mira nada más, la encuentro con un\nhombre desconocido.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000127",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Perdóneme, por favor, fui yo quien lo trajo acá! ¡Él no tiene la culpa de\nnada, así que perdónelo, por favor!”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000146",ch="syi"},
},
ja={
{
name={"???"},
"“Hmph, hija de meretriz tenías que ser. ¿Has estando seduciendo a otros hombres\ny trayéndolos acá?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000284",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ah? ¿Qué, acabas, de decir?",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000147",ch="syi"},
},
ja={
{
name={"???"},
"¿Todavía te sirve la boca como para decir tonterías?",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000128",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Ya no más, por favor!",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_kid_000285",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No te preocupes, no me pasará nada. Esto es pelea de niños...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000148",ch="syi"},
},
ja={
{
name={"???"},
"Ohhh... pelea de niños, eh. ¿Escucharon? Se está burlando de ustedes.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_kfb_000006",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"¿Nos permite silenciarlo?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000149",ch="syi"},
},
ja={
{
name={"???"},
"Claro. Cállenle esa boca.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000129",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Pero qué, qué piensan hacer?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000150",ch="syi"},
},
ja={
{
name={"???"},
"Trae a Mizuna acá.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_kfa_000020",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"Sí señor.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"se",file="se3130",id=1},
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000130",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡No, déjame!",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Uno de los hombres de negro aparta a Mizuna de mí y se la lleva.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000151",ch="syi"},
},
ja={
{
name={"???"},
"Vamos, Mizuna, ven para que observes conmigo como terminan las 'peleas de\nniños'...",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kfb_000007",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"¿Derecho o izquierdo?",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000152",ch="syi"},
},
ja={
{
name={"???"},
"Quitarle el derecho podría afectarle su vida diaria. Llévate solo el izquierdo.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kfb_000008",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"Entendido.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",file="se0897s",id=1},
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000286",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Gwah!",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"De repente, el hombre de negro tomó mi brazo.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"quake",size=5,mode="mw"},
{"se",id=1,file="se2691_l"},
{"text"},
text={
ja={
{
"Y entonces, fue poniendo cada vez más presión sobre este.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"A medida que aumentaba la presión sobre mi brazo, un dolor como nunca había\nsentido me invadía. Y entonces――",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000287",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡¡¿¡¿---?!?!!",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",id=1,file="se2685"},
{"quake"},
{"bg",time=80,rule=105,file="white",path=":bg/"},
{"bg",time=80,rule=105,file="black",path=":bg/"},
{"bg",time=80,rule=105,file="white",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000288",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡GWAAAAAaaaahhhh!",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Mis dedos alcanzaron a tocar una parte de mi espalda que normalmente jamás\ndeberían alcanzar.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Mi brazo estaba doblado de una manera impensable.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000131",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Profesor! ¡Profesor! ¡Profesor Kusanagi!",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_syi_000153",ch="syi"},
},
ja={
{
name={"???"},
"¿Kusanagi? Ah, ahora que lo recuerdo...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_syi_000154",ch="syi"},
},
ja={
{
name={"???"},
"Kusanagi, sí, es el tipo que metí por ser conocido de Saki... Santo cielo, vaya\nque Saki me jode las pelotas también.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000289",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Gi, giiiiiii...",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="man_syi_000155",ch="syi"},
},
ja={
{
name={"???"},
"Apenas acaba de entrar a la familia, supongo que aún no está consciente de que\nes una Nakamura ahora... Tendré que darle un pequeño castigo...",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_kid_000290",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"S-Saki, Saki, qué...",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_syi_000156",ch="syi"},
},
ja={
{
name={"???"},
"¿Ahhhn? ¿Todavía puedes hablar?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kid_000291",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tanto con Saki, y Saki, ¿qué es Saki, de ti?",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000157",ch="syi"},
},
ja={
{
name={"???"},
"Saki es mi esposa.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_kid_000292",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Esposa?",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000158",ch="syi"},
},
ja={
{
name={"Nakamura"},
"Ya que lo mencionas, se me había olvidado presentarme. Soy Shoichi Nakamura.\nPróximo sucesor de la familia Nakamura y presidente de la directiva del\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kid_000293",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Shoichi, Nakamura... ¿tú?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000159",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Así es, que no se te olvide. Aunque bueno, de igual manera tu contrato allí se\ntermina hoy.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000160",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"No hace falta que vengas más.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000294",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Mejor así!",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_syi_000161",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Qué rebelde, eh. ¡Tú! Tuércele el otro brazo también.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_kfb_000009",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"Entendido.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",mode=-2},
{"se",file="se3130",id=1},
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0021",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000132",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Basta, no más, por favor!",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Mizuna intenta parar el brazo del hombre de negro con todo su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kfb_000010",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"Kuh, suelta.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000162",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"¡Eh, tú! No vuelvas a herir a la muchacha. ¿Quién te ha dado permiso para\ngolpearla?. Su cuerpo es muy valioso, no dejaré que nadie que no sea yo le\nhaga daño.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_kfa_000021",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"L-Lo siento señor...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Los movimientos del hombre de negro se ralentizan ante el aviso de que no podía\nhacerle daño a Mizuna.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"El mismo esfuerzo de Mizuna ayudó a mantener a salvo, a duras penas, el hueso\nde mi otro brazo.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000133",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Ya está bien por hoy, vete ya!",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="man_syi_000163",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Tú no eres quien para decidir eso.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000134",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Te lo ruego, por favor, vete ya...",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="man_syi_000164",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Me niego, no voy a dejar que se salga con esta. ¡Tú! ¡Termina de romperle el\nbrazo!",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0021",head="miz_z2a",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000135",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡No, para!",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="水菜",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000136",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Haré lo que quieras! ¡Haré todo lo que me pidas, por favor! Solo... vete ya...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="man_syi_000165",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Ohhh...",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000295",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡No, maldita sea! ¡Rómpeme el brazo!",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000137",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"No le hagas más daño, por favor. Haré... lo que desees.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="man_syi_000166",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Lo que yo quiera, eh...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000296",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Rómpelo, rómpelo! ¡Rómpeme el maldito brazo!",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_syi_000167",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"¿Si lo dejo ir harás cualquier cosa que yo te pida, verdad, Mizuna?",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000297",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡No, Mizuna, no lo hagas!",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000138",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_syi_000168",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Huhuhuh, sí, va a ser divertido.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_syi_000169",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Muy pasiva has sido hasta ahora, mostrando solo repulsión. Pero supongo que de\nahora en adelante me complacerás con gusto, ¿eh, Mizuna?",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000139",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"S-- í.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000298",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡¡Shoichi Nakamura, maldito imbéciiil!!",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000170",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Qué bueno, ¿no? La muchacha te salvó, Kusanagi-kun. ¿Cómo se siente que una de\ntus alumnas te salve con su propio cuerpo?",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000299",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Bastardooo!",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000171",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Siléncialo.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"se",id=1,file="se3352"},
{"flash",time=500,alpha=100,loop=1,color="ff0000"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="man_kid_000300",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"G-Gwaah...",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"El hombre de negro comenzó a pisar mi brazo. El brazo que me habían torcido.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000140",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡¿Qué tan cruel puedes ser?! ¡Dijiste que ya no lo harías!",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0009",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000172",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Solo prometí que no le torcería el brazo derecho. Jamás dije que no le\npisotearía el brazo que ya tiene torcido.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000141",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡¿Profesor, está bien?! ¡Profesor! ¡Está sangrando bastante!",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000173",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Hmm, sí, qué feo se ve eso... Mira nada más, el hueso se salió y cortó la piel.\nDebe doler. ¿Fractura compuesta es que le llaman a esto?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="man_kfa_000022",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"Sí, le llaman también fractura expuesta, o abierta.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000174",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"¿Se puede sanar?",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_kfa_000023",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"De tomarse las medidas adecuadas, sí.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000175",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"¿Lo cual quiere decir que de no tomarse esas medidas quedarían secuelas?",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="man_kfa_000024",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"Ciertamente.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",mode=-2},
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0021",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000142",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Hay que llevar al profesor a un hospital! ¡Déjame llevarlo, por favor! ¡No\ndejes que sufra más!",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="man_syi_000176",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Pues sí, si no lo llevamos a un hospital pronto quedará con una herida\nincurable de por vida. ¿Pero sabes, Mizuna? Quisiera que me dieras las\ngracias antes.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000143",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"B-Bueno...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="man_syi_000177",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"¿Ahhhn? ¡No se te entiende nada! ¿Qué dijiste?",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000144",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Estoy muy agradecida con usted, Shoichi-san. Mizuna está muy agradecida con su\npiedad y benevolencia.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000178",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Vaya, ya veo, ya veo. Lo dejaré ir entonces. Después de todo ya me diste tu\npalabra. ¿No es así, Mizunaaa?",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000145",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"S-- í.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="man_syi_000179",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Espero que no se te olvide lo que dijiste cuando venga de nuevo, Mizuna.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Shoichi Nakamura muestra una sucia sonrisa.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0019",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000146",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Está bien...",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000180",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"Nos vamos.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="man_kfa_000025",ch="kfa"},
{"vo",file="man_kfb_000011",ch="kfb"},
},
ja={
{
name={"Hombres de negro A & B"},
"Sí señor.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",mode=-2},
{"se",id=1,file="se0791_s"},
{"text"},
text={
ja={
{
"Shoichi Nakamura y los guardaespaldas salen de la habitación.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000301",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Guh...",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000147",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"No se mueva, por favor. Su hueso se fracturó y atravesó la piel. Llamaré a una\nambulancia de inmediato, espere solo un momento.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="man_kid_000302",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"M-Mizuna...",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0008",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000148",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿S-Sí? ¿Le duele algo?",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_kid_000303",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ese viejo... te violó?",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000149",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="man_kid_000304",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Eso me pareció después de lo que escuché...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000150",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Eso, yo...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000305",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Dime, por favor!",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000151",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Aquí conviven las hijas ilegítimas de los Nakamura... Y esas hijas, a su vez,\nestán destinadas a convertirse en sus próximas amantes...",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000152",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"La relación consanguínea es tan cercana que es imposible consumar el\nmatrimonio... Las hijas de las amantes pasan a ser amantes, hasta la\nmuerte...",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_kid_000306",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Para mantener la sangre de los Nakamura?",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0008",head="miz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000153",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Eso dicen, pero en realidad no sé si eso es verdad. Todos ellos han estado\nabusando de las mujeres en esta residencia, por puro placer...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000154",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Y en mi caso es lo mismo. Más que un vientre para dar a luz, me han usado como\nun simple juguete...",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000307",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"*Tch*...",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Después de escuchar lo que Saki me dijo, tenia cierta idea de lo que me\nesperaba.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Pero no es lo mismo a escucharlo directamente de la boca de Mizuna.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_kid_000308",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Voy a preguntarte algo que quizás suene muy cruel. ¿No te importa?",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000155",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Pregunte lo que quiera, se lo ruego. Fue mi culpa que usted pasara por esto,\naceptaré todo lo que me pida...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="man_kid_000309",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ese hombre te ha estado violando una y otra vez como si fueras una prostituta?",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000156",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Sí... así es. Aunque, sería una falta de respeto para las verdaderas\nprostitutas decir eso...",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="man_kid_000310",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"En pocas palabras, este lugar es como un prostíbulo para ellos, ¿cierto?",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000157",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"A-Así es... sí, esta residencia es como un prostíbulo de y para los Nakamura...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000158",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"De hecho, he escuchado que varias de las mujeres que residieron anteriormente\nacá fueron usadas como juguetes sexuales por varias personas de poder...",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="man_kid_000311",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Son de la peor calaña, definitivamente...",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0006",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000159",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"P-Por eso mismo estoy pensando en liberar a Ai-chan algún día, y evitar que\ntermine como yo.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000160",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Estoy estudiando ahora para eso. Quiero conseguir el título de abogado mientras\nvoy al colegio. Pensé que esa sería la mejor opción, por lo menos.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000161",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"P-Por ahora no puedo hacer nada. Absolutamente nada. Ni siquiera pude oponerme\na él... Soy totalmente impotente...",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000162",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Así que estudio, porque por lo menos el estudio se puede lograr con esfuerzo,\npor eso es que me concentro tanto en eso ahora.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0006",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000163",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Si llego a convertirme en una experta de las leyes podré resolver esta\nsituación.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="man_kid_000312",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"De ninguna manera van a quedarse quietos sabiendo que te convertirás en\nabogada.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0005",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000164",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Lo haré a escondidas. Si es por el dinero estudiaré tanto como sea necesario\npara obtener becas.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="man_kid_000313",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ese no es el problema. Ellos harán lo que sea para evitarse problemas. Aun si\nlogras convertirte en abogada las cosas no se solucionarán tan fácilmente.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="man_kid_000314",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Nakamura no es solo un nombre de prestigio en esta región, es también una\nfamilia con fuertes conexiones con la delincuencia. Hace unos años hubo un\nconflicto entre Yakuzas donde los Nakamura se involucraron en gran parte.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="man_kid_000315",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Nada de esto se va a solucionar mágicamente convirtiéndote en abogada.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0006",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000165",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Lo sé, ¿pero qué debería hacer entonces? ¿Es que acaso conoce alguna otra\nalternativa?",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000166",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Si fuese más inteligente quizás podría dar con más alternativas. Quizás se me\npodría ocurrir algo mejor... pero, esto es lo único que pude idear por ahora.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="man_kid_000316",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ya veo, creo que ya he entendido un poco más de tu situación.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="man_kid_000317",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"La razón por la cual has mantenido esas calificaciones... y el porqué de tanta\nlectura... Mantienes la mirada fría sobre la verdad, pero a la vez deseas\nfervientemente una verdad capaz de salvarte.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000167",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"De nada sirve leer tanto... lo sé... pero, aun así no puedo quitarme la\nesperanza de encima...",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_kid_000318",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí sirve, y esa voluntad que tienes es valiosa. El proceso de obtener la verdad\nes más importante que el resultado en sí.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0008",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000168",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Saber eso solo me sirve de consuelo.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="man_kid_000319",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sea lo que sea, el punto es que has estado esforzándote demasiado tú sola.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0006",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000169",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Esforzarme yo sola? ¿Si no soy yo quién más lo hará? Solo nos tenemos a\nnosotras mismas para sobrevivir.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="man_kid_000320",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ahí es donde te equivocas. Una niña como tú no debería cargar con tanto peso.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0007",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000170",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡A veces una niña también tiene que cargar con muchas cosas!",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_000321",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Pues esa niña debería cargar con algo más conforme a su estatura.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="man_kid_000322",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Lo que llevas sobre tu espalda no es algo que una niña como tú debería cargar,\nMizuna.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000171",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Quién lo hará por mí entonces?",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="man_kid_000323",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Que quién? Vamos, no seas tonta. Yo, por supuesto.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0012",head="miz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0008",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000172",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Eh? ¿U-Usted?",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="man_kid_000324",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tienes un adulto acá dispuesto a salvarlas a ustedes dos. No estaría mal tener\nalgo de fe, ¿no?",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000173",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿A nosotras? ¿Usted, profesor?",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="man_kid_000325",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0002",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000174",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"--",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Una expresión de alegría surgió por un momento en la cara de Mizuna, pero esta\ncambió de inmediato a una de tristeza.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0011",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000175",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Creo, que en algún momento llegué a poner mi fe en usted... Pensé que, tal vez\nusted podría salvarnos... Creo que, en un rincón de mi corazón hubo algo de\nesa fe.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0010",head="miz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000176",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Y por eso terminé metiéndolo a usted en esto. Lo hice pasar por tan horrible\nsituación.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0020",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000177",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Si hubiese elegido seguir sola usted no estaría sufriendo esto!",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="man_kid_000326",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Te equivocas.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="man_kid_000327",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Si terminé así fue por haberme metido con los guardaespaldas. Tú me detuviste y\na pesar de eso me dejé llevar.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="man_kid_000328",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tú no tienes la culpa de nada.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0009",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="いいえ",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000178",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Pero, aun así usted luchó por protegerme...",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="man_kid_000329",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Si de esa manera lo ves, pues entonces deja que siga hasta el final.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0008",head="miz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000179",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Hasta el final?",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"bgm",file="bgm028"},
{"text"},
text={
vo={
{"vo",file="man_kid_000330",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí, no voy a dejar que me jodan y se vayan como si nada. ¡Esta ira que tengo no\nse va a calmar hasta que los haga pagar!",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000180",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"No es buena idea que se precipite. Ellos, ellos no son normales...",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000181",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Acaso no lo mencionó usted mismo hace un momento? Ellos estuvieron implicados\nen un conflicto de Yakuzas...",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="man_kid_000331",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí, lo sé. Pero yo tampoco soy normal.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000182",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Es completamente diferente. El peligro de esa gente está en otro nivel,\nprofesor.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="man_kid_000332",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Vamos, ¿es que tienes fe en el poder de ellos pero no en el mío?",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0019",head="miz_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000183",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Por supuesto. Mire nada más el estado en que está ahora, solo por intentar\nprotegerme... Y su brazo, hay que llevarlo ya al hospital...",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="man_kid_000333",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí, está hecho mierda. Pero no hay nada más temible que un lobo herido.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="man_kid_000334",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Y se los haré entender pronto. Y de tal manera que los volveré locos.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000184",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Hacerles entender?... ¿Cómo?",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="man_kid_000335",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Las explicaciones después, ¿puedes prestarme el teléfono un momento?",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000185",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿El teléfono? Si necesita llamar a una ambulancia yo me puedo encargar de eso.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="man_kid_000336",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No hay tiempo para andar llamando ambulancias.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000186",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Eh? ¿No es para la ambulancia? ¿A quién va a llamar entonces?",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
vo={
{"vo",file="man_kid_000337",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"A una vieja conocida... bueno, solo conocida no es... En fin, es indispensable\npara vengarnos.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000187",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Vengarnos?",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
vo={
{"vo",file="man_kid_000338",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí, así mismo. Venganza, o si quieres le puedes llamar contraataque también.\nHaré que los Nakamura pasen por algo cien veces peor.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0005",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000188",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Pero qué está diciendo usted? Más importante que eso es atenderlo--",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
vo={
{"vo",file="man_kid_000339",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No tengo tiempo para recibir atención medica, no hasta que termine esto.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000189",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Pero, no es tan fácil hacerlo como decirlo. Y menos aun con los Nakamura, la\nmisma gente que controla a Yumihari.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="man_kid_000340",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Los Nakamura no son los únicos que mueven los bajos fondos de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000190",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Tal vez, pero...",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="man_kid_000341",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Pero, yo solo no podré lograr esta venganza. Necesito también tu ayuda.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000191",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Mi ayuda?",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="man_kid_000342",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es. Mi plan de venganza te necesita a ti.",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
vo={
{"vo",file="man_kid_000343",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Aunque, necesitaré que te prepares mentalmente. Y por supuesto, necesito tu\nabsoluta confianza en mí.",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000192",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Absoluta confianza en usted?",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="man_kid_000344",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Crees que puedas?",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000193",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Que si puedo?... Sería más difícil no confiar en alguien que tanto ha hecho\npor nosotras.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="man_kid_000345",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ya veo... pues entonces, perdona que te pida esto pero, ¿podrías desnudarte ya?",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000194",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿D-Desnudarme? ¿Quitarme la ropa?",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="man_kid_000346",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tal cual.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012h",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011h",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000195",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Eh? E-Esto... ¿Acaso, e-está usted, pidiéndome 'eso'? E-En ese caso, sería\nmejor ir al hospital antes, y luego...",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
vo={
{"vo",file="man_kid_000347",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿'Eso'?",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001h",head="miz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010h",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000196",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Ah, quiero, decir...",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
vo={
{"vo",file="man_kid_000348",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Te lo repito una vez más, no hay tiempo para ir al hospital. Ai volverá mañana\nen la noche.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0017h",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000197",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Ah, si es por eso, creo que en el hospital tendremos algo de tiempo para estar\nsolos...",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
vo={
{"vo",file="man_kid_000349",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No hay manera de hacerlo en el hospital. Y no habrá más tiempo para mañana.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013h",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000198",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Jaa? ¿H-Hacerlo?",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
vo={
{"vo",file="man_kid_000350",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es, hacerlo. Hay que culminar antes de que acabe la noche.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000199",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Culmi... nar?",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
vo={
{"vo",file="man_kid_000351",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es. Te lo pregunto una vez más, ¿confías en mí?",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0005",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000200",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡Y-Ya se lo dije! ¿Confiar? Jamás había tenido a alguien que hiciera tanto por\nmí, y en quien pudiera confiar tanto.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006h",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000201",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"A-Así que, sea lo que usted considere necesario, yo... lo haré.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="man_kid_000352",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Qué bueno saber eso. En fin, necesito hacer una llamada.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mzd_000202",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"E-Está bien, pero su brazo...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="man_kid_000353",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ya te lo dije, no hay tiempo.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Mizuna me llevó al lugar donde estaba el teléfono.",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
"Un viejo, clásico teléfono negro.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"Mi plan comienza con esta llamada.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="man_kid_000354",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Vamos, atiende...",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"msgoff"},
{"se",sync=1,id=1,file="se1343"},
{"se",id=1,file="se_phone_gacha"},
{"text"},
text={
vo={
{"vo",file="man_kid_000355",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Yasu-san? Soy yo, Kenichiro. Kenichiro Kusanagi. Déjame hablar con la abuela,\npor favor.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="man_kid_000356",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Dormida? ¡No importa, despiértala!",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="man_kid_000357",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Qué? ¿Que no es tu problema si me matan? Eso no importa ahora, de igual forma\nya estoy medio muerto.",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000203",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿A quién está llamando? Un hospital... no es, supongo.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="man_kid_000358",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No...",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Unos minutos después se escucha una voz diferente del otro lado del teléfono.\nUna nostálgica voz que llevaba tiempo sin escuchar.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="man_kid_000359",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ah? Soy yo, Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
vo={
{"vo",file="man_kid_000360",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Te tengo una buena propuesta, abuela.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="man_kid_000361",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Qué? ¿Qué otra buena propuesta podría haber?",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="man_kid_000362",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡Un trabajillo! ¡Te tengo un trabajillo!",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000204",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿'Trabajillo'? ¿Eh? ¿C-Con quién está hablando?",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="man_kid_000363",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ahhh? ¿Cuánto dinero? Pues sí, un billón de yenes, ¿qué tal?",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000205",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¡¿Un billón?!",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="man_kid_000364",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Eso sí, no es en metálico. Probablemente venga en terreno y propiedades.",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
vo={
{"vo",file="man_kid_000365",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ah, por cierto, la mitad de la recompensa me la llevaré yo.",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000366",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Ahh? ¿Solo diez por ciento? ¡¿Crees que me voy a quedar conforme solo con\neso?!",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000367",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¡¿Ahh?! ¿En una negociación todo sirve siendo ambas partes iguales? Escucha,\nabuela, te recuerdo que soy tu nieto.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000368",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ugh... en negocios no hay hijo ni nieto que valga, sí, tienes razón...",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000369",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tch, qué dura eres, viejita.",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
vo={
{"vo",file="man_kid_000370",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Está bien, sí. Haremos como tú digas. Diez por ciento para mí, está bien. Pero\na cambio de eso, quiero que ganes esa negociación como sea...",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
vo={
{"vo",file="man_kid_000371",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Tráeme algunos hombres mañana, apenas salga el sol. Tengo que darles algunas\ninstrucciones.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
vo={
{"vo",file="man_kid_000372",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Cada segundo cuenta.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"se",id=1,file="se2516"},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000206",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Q-Qué quiere decir?",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
vo={
{"vo",file="man_kid_000373",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Bien, ¿comenzamos? Menos mal que traje todo mi equipo...",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
"Saco mi equipo parte por parte.",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
"He estado llevando mi equipo de pintura conmigo todo el tiempo para poder\ndibujarle a Ai.",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
"Obviamente también tengo todos mis instrumentos de pintura en óleo.",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
vo={
{"vo",file="man_kid_000374",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Hay madera cuadrada en esta casa, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000207",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Sí, ¿por qué?...",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="man_kid_000375",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Trae toda la madera que consigas. Por cierto, en el almacén había una cortina\nbeige, ¿cierto? Tráela también.",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000208",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Está bien.",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Tenía ahora varias piezas de madera cuadrada frente a mí.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"Tomo las piezas más grandes y construyo un marco. Posteriormente, estiro la\ntela sobre el mismo.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000209",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"Esto es...",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
vo={
{"vo",file="man_kid_000376",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Solo falta imprimar y listo.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000210",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Es un lienzo para óleo?",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
vo={
{"vo",file="man_kid_000377",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es. Construir un lienzo es muy fácil.",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"Al terminar de construir el lienzo saco un libro de mi mochila.",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000211",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Esto es?",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="man_kid_000378",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Una colección de imágenes de obras de artistas impresionistas.",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000212",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Impresionistas?",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="man_kid_000379",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Haz la misma pose que en esta pintura, por favor.",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012",head="miz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000213",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"¿Cuando decía 'culminar' se refería a...?",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
vo={
{"vo",file="man_kid_000380",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Exactamente.",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Impresionismo. Su origen vino de un artista prodigio.",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
"El mismo artista que encabeza la historia del arte occidental moderno. Su\nnombre, Édouard Manet.",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
"Se dice que el eliminar la perspectiva y volumen, elementos base de la pintura\noccidental, marcó la llegada de la pintura moderna.",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
ja={
{
"La obra que comenzó su popularidad fue 'Almuerzo sobre la hierba'.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
"Manet rompió con la regla sagrada de usar el desnudo femenino solo en temáticas\nmitológicas o legendarias, dibujando a una mujer real.",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
ja={
{
"Pintó a una mujer completamente desnuda en un parque, al mediodía.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
"Como cosa obvia, esto devino en un escándalo.",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
"Y sin embargo, poco tiempo después este genio presentó una obra aún más fuerte.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
ja={
{
"Su nombre, 'Olympia'.",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
"Cuadro que se convertiría en el punto de inflexión de la pintura occidental.",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"excall",file="04_what_is_mind？_02_5"},
{"text"},
linkback="block_00393",
},
label = {
top={block="block_00000",label=1},
},
}
