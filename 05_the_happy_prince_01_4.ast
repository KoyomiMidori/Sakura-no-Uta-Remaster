},
block_00078={
{"bg",file="ev_com_i03_04",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001029",ch="aid"},
},
ja={
{
name={"Ai"},
"“Auh, auh, auuuh...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_i03_07",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Uso mi otro brazo para tomar el brazo de Ai.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001030",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Hyah!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_i03_08",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
ja={
{
"No puso resistencia alguna.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Veo fijamente a Ai...",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_aid_001031",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-Naoya...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Me quedo en completo silencio, incitándola a cerrar los ojos.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_aid_001032",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Auhh... ¿Tengo que... cerrar los ojos?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_aid_001033",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿De verdad debo hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_i03_09",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001034",ch="aid"},
},
ja={
{
name={"Ai"},
"“No me veas tantooo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_aid_001035",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me da pena... que me veas tanto.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías cerrar los ojos entonces.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_i03_08",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001036",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ese no es el problema... creo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí lo es.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_001037",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio tengo que... cerrar los ojos?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_001038",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhh...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Muevo un poco mi brazo, a manera de acariciar el suyo.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_i03_07",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001039",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hyaah.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_i03_09",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001040",ch="aid"},
},
ja={
{
name={"Ai"},
"“Auuh...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_001041",ch="aid"},
},
ja={
{
name={"Ai"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_i03_10",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001042",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bgm",stop=1,time=500},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Ai cierra sus ojos.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"se",id=1,file="se_pechi"},
{"bg",rule=105,time=150,file="white",path=":bg/"},
{"bg",file="ev_com_i03_11",time=150,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001043",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Auch!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Le propino un capirotazo en la frente.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0019h",head="aix_z2e",lv=5,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y así como ves, los hombres pueden transformarse de un momento a otro. Parece\nque has estado vigilante conmigo y Shizuku, pero no tienes ni una pizca de\nprecaución cuando se trata de ti misma.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0021h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0023h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001044",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Q--?! ¡A-Así que estabas jugando conmigo! ¡Naoya! ¡H-Hay cosas que\nsimplemente no se deben hacer!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0023h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うんうん",lv=5,id=9},
{"se",file="se9031",id=1},
{"text"},
delay={
[30]={
{"se",file="se9031",id=2},
},
[1000]={
{"fgact",ch="藍",act="うんうん",lv=5,id=9},
{"se",file="se9031",id=3},
},
[1200]={
{"se",file="se9031",id=4},
},
},
text={
ja={
{
"Ai se enfurece. No suelo verla con la cara tan roja... Parece estar al borde de\nlas lágrimas.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Esta muchacha... Son estos gestos los que la hacen tan tierna...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"No, debo controlarme.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No estoy jugando contigo! Y no es justo que te enojes ahora.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0006h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001045",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿C-Cómo no enfurecerme después de que me hicieras eso?!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sucede que eres muy desprevenida! ¡¿Cuántas veces te he cargado ya?!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Dos hasta ahora!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0013h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0009h",head="aix_z2h",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0011h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001046",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? Ah, ugh... s-sucede que...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Tienes algo que decir?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0007h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0008h",head="aix_z2h",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0009h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001047",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Eso no es lo que tú crees. No.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0008h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001048",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esto... Naoya, llevo viéndote desde que eras un bebé. Así que eres, sí, eres\ncomo un hermano menor para mí.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puede que pienses eso, pero no estás considerando que quizá yo pueda\ntransformarme. En plena pubertad los hombres somos bombas de carga sexual.\nPodría explotar en cualquier momento.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0005h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001049",ch="aid"},
},
ja={
{
name={"Ai"},
"“L-Lo sé. Por eso procuré que Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo va para ti, Ai. Eres como una hermana mayor para mí, pero también\ntienes ese aire de vecina de al lado. Y el tiempo que llevamos conociéndonos\nlo hace peor.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_aid_001050",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tanto tiempo que llevamos conociéndonos, problema no debería haber, ¿no? Hasta\nahora no ha sucedido nada.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hasta ahora. Nada puedo decir de ahora en adelante. En fin, no me abraces por\nla cabeza con tanta ligereza.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0008h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001051",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Está bien... Tomaré más cuidado para la próxima.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0010",face="h0011h",head="aix_z2h",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001052",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿P-Pero de verdad te vinieron esos pensamientos cuando te abracé?...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿quieres probar? Podría tocar tus pechos y comprobar si me excito o no.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0020",face="h0022h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001053",ch="aid"},
},
ja={
{
name={"Ai"},
"¡D-De ninguna manera te dejaría hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excelente, así es como debes reaccionar. Más cuidado de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0013h",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0009h",head="aix_z2h",lv=5,id=9},
},
vl02={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
},
vl03={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0010h",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001054",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, s-sí. Está bien. He estado tan enfrascada en mi papel de tutora que me he\ndescuidado de mi propia seguridad...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_szd_001931",ch="szd"},
},
ja={
{
name={"???"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0013",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001055",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Hiih!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=500},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al sentir esa mirada nos apartamos rápidamente uno del otro.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="雫",size="z1",mx=-40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0017",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",x2=0,x=345,lv=4,id=9},
{"bgm",file="bgm011"},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0015",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_001932",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Kabedon... qué envidia~”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0017",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_001933",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque no me parece muy prudente hacerlo en esta casa de madera~ Se escuchó\ncasi todo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? A-Ah.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0014",head="aix_z1e",x=345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001056",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-No, Shizuku, no es lo que crees--”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0018",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_001934",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No me interesa tanto la intención de ese kabedon. Pero deberían cuidar mejor el\nlugar y la hora.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001057",ch="aid"},
},
ja={
{
name={"Ai"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_001935",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Qué bueno que estés consciente de ello...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0018",head="shz_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_001936",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues bueno, me retiro... Cielos, Ai nee-san, deberías reconsiderar muy bien...\ncuál de las dos está en más peligro de perder la pureza...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",file="se9002",vol=50,id=1},
{"fg",ch="雫",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Shizuku regresó a su habitación, murmurando.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que Shizuku se molestó...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001058",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí... y algo mencionó de mi pureza...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debes cuidarte, quiso decir.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001059",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y de esa manera transcurrió la cotidianidad de siempre.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Comenzó el segundo período.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Y queda poco tiempo. No solo para la Exposición Moore, sino también para los\nexámenes de la universidad y la graduación.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Nos encaminamos hacia las últimas horas.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
