astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Oh?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0001",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000992",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Cómo estaba Kei?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo vi relativamente bien.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0015",head="aix_z1h",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0011",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000993",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo. Solo espero que no se presione demasiado. Siempre que se inmersa en\nalgo, pierde la noción de sus alrededores.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me extraña. Cada vez que se concentra en algo se olvida de todo lo demás.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000994",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san también era así, ahora que lo recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_aid_000995",ch="aid"},
},
ja={
{
name={"Ai"},
"“Antes de mudarse al apartamento en Sakuragahara, siempre que venía a Japón,\npintaba en ese taller.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0004",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000996",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo solía llevarle la comida que Mizuna nee-sama le preparaba.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que en ese entonces el viejo pintaba en el taller, pero no sabía que tú le\nllevabas la comida... Es algo raro.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0012",head="aix_z1h",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000997",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tú también viviste acá. Aunque apenas acababas de nacer.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo recuerdo, sí. Estuve acá hasta los cuatro años, cuando la abuela Natsume\nseguía con vida.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0003",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0004",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000998",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que lo recuerdas. Esos tiempos estuvieron llenos de bullicio y de\ndiversión. Te tenía a ti, a Mizuna nee-sama y a la abuela Kotoko. Y de vez en\ncuando venía Kenichiro también.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, en ese entonces a la casa no le faltaba gente.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000999",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y por eso no pude contener la alegría cuando regresaste.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Aunque bueno, el detonante en primer lugar fue la inundación en casa...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001000",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhhh... de verdad que me da pena lo que hizo Kei, créeme.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo bromeaba, no lo tomes a mal. De no tener ese pretexto a mano, no hubiese\nregresado.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001001",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pretexto?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pretexto. Son muchos recuerdos los que tengo de esta casa... Me pareció que\nsi regresaba, me sentiría tan a gusto que no querría después volver al\napartamento...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso fue que dudé un poco de venir.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001002",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ese apartamento es igual de preciado como esta casa. Es tu lugar y el de Mizuna\nnee-sama... no, tuyo, y de Mizuna-san.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001003",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque el día que te invité a venir, la idea de que viviríamos juntos de nuevo\nse me cruzo por la cabeza, y me alegré.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y aún sabiendo que no soy un niño me tomaste de la cabeza y me abrazaste.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001004",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Eso fue porque... esto... fue, de imprevisto.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no soy un niño pequeño, no vuelvas a hacer eso. Sentí en carne viva tus\npechos.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0006",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001005",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿C-Cómo que en carne viva?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá no te hayas dado cuenta, pero has crecido. Recuerdo que de niña eras una\ntabla.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0007",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0011",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001006",ch="aid"},
},
ja={
{
name={"Ai"},
"“T-Tabla no. A-Algo tengo.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso lo digo, ahora sí tienes. A eso me refiero cuando digo que sentí en\ncarne viva.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0013",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0012",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001007",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿M-Mis pechos crecieron? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Me alegré de sentir algo ahí.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0013",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001008",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿T-Te alegraste?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Y ahora soy un hombre joven, así que deberías tener cuidado.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0011h",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0008",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001009",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-No vengas con cosas raras... Nadie se sentiría alegre de tocar los pechos de\nsu hermana. Te refieres al contacto físico entre hermanos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería así si realmente compartiéramos la misma sangre. Pero no la compartimos,\nasí que no.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más que hayas sido como mi hermana en el pasado, no tenemos conexión\nconsanguínea alguna.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y como resultado, lo único que la sensación de esos pechos despierta en mí es\nlujuria.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001010",ch="aid"},
},
ja={
{
name={"Ai"},
"“V-Vamos... es absurdo pensar que te excites conmigo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",stop=1,time=1000},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0004",head="aix_z2e",lv=5,id=9},
{"se",file="se9015",vol=50,id=1},
{"text"},
text={
ja={
{
"Sin decir nada, me acerco a Ai.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0012",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001011",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"msgoff"},
{"se",file="se9010",id=1},
{"fg",ch="藍",time=300,sync=1,mode=-1,lv=5,id=9},
{"fg",ch="藍",size="z1",time=300,sync=1,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
"Ai retrocede ante mis sospechosos movimientos.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0001",head="aix_z2e",lv=5,id=9},
{"se",file="se9015",vol=50,id=1},
{"text"},
text={
ja={
{
"Sin embargo, no tardo nada en alcanzarla.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0014",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001012",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? N-Naoya... ehh...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Ai choca contra la pared, sin escapatoria alguna.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_i03_01",path=":ev/ev_com_i03/",set="ev_com_i03"},
{"quake",size=5,mode="mw"},
{"se",id=1,file="se1038"},
{"bgm",file="bgm103"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001013",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hii--”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Me pongo entre Ai y la pared y ejecuto el popularmente conocido 'Kabedon'.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_aid_001014",ch="aid"},
},
ja={
{
name={"Ai"},
"E-Esto... N-Naoya...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_i03_02",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001015",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? Esto... ¿Qué, significa esto?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres tan tierna que no pude evitar perseguirte.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_i03_03",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001016",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Je?! ¡¿T-Tierna, yo?! Vamos, déjate de bromas ya.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres probar a ver si estoy bromeando o no?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_i03_01",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001017",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿P-Probar?!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, cierra los ojos...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_i03_04",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001018",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿Eh? ¿Ehh? ¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo diré de nuevo. Cierra los ojos.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_i03_05",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001019",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Ehh...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_i03_01",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001020",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cierra los ojos, por favor...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_i03_05",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001021",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Escucha, yo soy tu profesora, tú mi alumno.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Cierra los ojos.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_aid_001022",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, espera, por eso insisto, esto no está bien.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé. Cierra los ojos.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_i03_04",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001023",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Escucha, no... N-Naoyaaa, ¿podrías escucharme?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si cierras los ojos.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_aid_001024",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Estoy tratando de decirte...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_i03_05",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001025",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esto...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_aid_001026",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Q-Qué harás... si cierro los ojos?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién sabe?... Ciérralos.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_i03_04",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001027",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Escucha... Naoyaa, y-yoo...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_i03_06",sync=0,face=1,time=400,path=":ev/ev_com_i03/",set="ev_com_i03"},
